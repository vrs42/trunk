5159 076500*       
5160 076500*               APTROUT=.                       /APT ROUTINE LOADS HERE
5161 076500*       
5162 076520*               RELOC   .+20                    /EMPTY SPACE
5163 076520*       
5164 076520*               APTRO2= .                       /SECONDARY APT ADDRESS HERE
5165 076520*       
5166 077360                RELOC                           /UN-FOOL THE ASSEMBLER
