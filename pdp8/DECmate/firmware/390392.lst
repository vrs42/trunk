  94 000000                VSF=    VIDINT^10+6001          /SKIP ON, CLEAR VIDEO INTERRUPT FLAG
  95 000000                VCL=    VIDINT^10+6002          /NOP (CLEAR THE AC?)
  96 000000                VNOP1=  VIDINT^10+6003          /(NOP?)
  97 000000                VDUMM1= VIDINT^10+6004          /(NOP?)
  98 000000                VIE=    VIDINT^10+6005          /WRITE INTERRUPT ENABLE PER AC[11]
