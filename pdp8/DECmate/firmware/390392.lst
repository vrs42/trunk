1460 071617* 6211          CDF     10                      /GOTO BUFFER FIELD
1461 071620* 1612          TAD I   L3705/(3705)            /GET CURRENT CONTENTS OF 13705
1462 071621* 0215          AND     L77/(77)                /JUST KEEP LOW-ORDER HALF
1463 071622* 3612          DCA I   L3705/(3705)            /STORE BACK
1464 071623* 1613          TAD I   L3707/(3707)            /GET CURRENT CONTENTS OF 13707
1465 071624* 0215          AND     L77/(77)                /JUST KEEP LOW-ORDER HALF
1466 071625* 3613          DCA I   L3707/(3707)            /STORE BACK
1467 071626* 6271          CDF     70                      /BACK TO OUR FIELD
1468 071627* 5616          JMP I   CLR2                    /RETURN
