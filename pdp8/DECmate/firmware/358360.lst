2308 072766* 6211          CDF     10                      /GOTO BUFFER FIELD
2309 072767* 1761          TAD I   L3705/(3705)            /GET CURRENT CONTENTS OF 13705
2310 072770* 0364          AND     L77/(77)                /JUST KEEP LOW-ORDER HALF
2311 072771* 3761          DCA I   L3705/(3705)            /STORE BACK
2312 072772* 1762          TAD I   L3707/(3707)            /GET CURRENT CONTENTS OF 13707
2313 072773* 0364          AND     L77/(77)                /JUST KEEP LOW-ORDER HALF
2314 072774* 3762          DCA I   L3707/(3707)            /STORE BACK
2315 072775* 6271          CDF     70                      /BACK TO OUR FIELD
2316 072776* 5765          JMP I   CLR2                    /RETURN
