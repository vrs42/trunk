  71                       GCF=    6256                    /GET CURRENT FIELDS
  72                       PEX=    6004                    /EXIT FROM CP TO MAIN MEMORY
  73                       PG0=    6003                    /RESET HLTFLG FLIP-FLOP
  74                       PRQ3=   6236                    /TYPE 3 PANEL REQUEST
  75                       PRS=    6000                    /READ PANEL STATUS
  76                       RSP1=   6207                    /READ FIRST STACK POINTER
  77                       RSP2=   6227                    /READ SECOND STACK POINTER
  78                       SPD=    6276                    /FORCE DF TO REFER TO CP MEMORY
  79                       WSR=    6246                    /WRITE SWITCH REGISTER (ROM CONTROL), CLEAR AC
