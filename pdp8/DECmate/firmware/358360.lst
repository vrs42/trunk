2284               /       SUBROUTINE  TO  SET HIGH-ORDER BITS IN CP 13705 AND 13707.  BIT[4] IS  SET  IN
2285               /       13705;   BITS[4-5] ARE SET IN 13707.  THIS MAKES THE LINES INTO DOUBLE-HEIGHT,
2286               /       DOUBLE WIDTH UPPER AND LOWER HALVES RESPECTIVELY.  THIS ROUTINE DEPENDS ON THE
2287               /       PREVIOUS CONTENTS OF THE BITS BEING ZERO.
2288               
2289 072747* 0000  SET2,   .-.                             /SET HIGH BITS IN 2 WORDS ROUTINE
2290 072750* 6211          CDF     10                      /GOTO BUFFER FIELD
2291 072751* 1761          TAD I   L3705/(3705)            /GET CURRENT CONTENTS OF 13705
2292 072752* 1112          TAD     Z200/[200]              /ADD ON A HIGH-ORDER BIT
2293 072753* 3761          DCA I   L3705/(3705)            /STORE BACK
2294 072754* 1762          TAD I   L3707/(3707)            /GET CURRENT CONTENTS OF 13707
2295 072755* 1363          TAD     L300/(300)              /ADD ON HIGH-ORDER BITS
2296 072756* 3762          DCA I   L3707/(3707)            /STORE BACK
2297 072757* 6271          CDF     70                      /BACK TO OUR FIELD
2298 072760* 5747          JMP I   SET2                    /RETURN
