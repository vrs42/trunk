  79               /       RX8B DEFINITIONS.
  80               
  81                       DEVCODE=75^10+6000      /SKELETON IOT CODE OF DISK
  82               
  83                       SEL=    DEVCODE+0       /LOAD DRIVE PAIR PER AC[11]
  84                       LCD=    DEVCODE+1       /LOAD COMMAND REGISTER
  85                       XDR=    DEVCODE+2       /TRANSFER DATA REGISTER
  86                       STR=    DEVCODE+3       /SKIP ON, CLEAR TRANSFER FLAG
  87                       SER=    DEVCODE+4       /SKIP ON, CLEAR ERROR FLAG
  88                       SDN=    DEVCODE+5       /SKIP ON, CLEAR DONE FLAG
  89                       INTR=   DEVCODE+6       /INTERRUPT ENABLE/DISABLE PER AC[11]
  90                       INIT=   DEVCODE+7       /INITIALIZE CONTROLLER, RECALIBRATE DRIVES
