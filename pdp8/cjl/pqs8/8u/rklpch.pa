/	P?S/8 PATCH TO RKLFMT

/	PATCH TO DEC'S RKLFMT TO MAKE IT WORK ON P?S/8 SYSTEMS.

/	LAST EDIT:	15-JAN-1983	12:00:00	CJL

/	MAY BE ASSEMBLED WITH '/J' SWITCH SET.

/	DEFINITIONS:

	BGN=	0200		/START OF MAIN FORMATTER PROGRAM
	CNTRLC=	3347		/<^C> ROUTINE
	NL0100=	CLA IAC BSW	/LOAD AC WITH 0100
	XC8CKP=	3641		/CONSOLE PACKAGE CHECK
	XC8CNT=	3200		/CONSOLE PACKAGE CONTROL CHECK
	XC8ERR=	4007		/C8ERR ROUTINE
	*2200			/NEW SYSTEM STARTING ADDRESS

	IFNZRO	.&177	<ERROR	.>

	RK4MAT=	.		/RK4MAT SYSTEM STARTS HERE

RK4MAT,	NOP			/HERE IN CASE CHAINED TO
	NL0100			/TEST FOR PDP-8/E
	TAD	(7700)		/COMPARE TO EXPECTED VALUE
	SZA CLA			/SKIP IF ACTUALLY PDP-8/E OR BETTER
	JMP	NOT8E		/JUMP IF NOT
	CAF			/CLEAN UP THE BUS
	JMP I	(BGN)		/GO START IT UP

NOT8E,	TAD	(RAR)		/GET REPLACEMENT INSTRUCTION
	DCA I	(XC8CNT+6)	/PREVENT PROBLEMS
	TAD	(RAR)		/LIKEWISE
	DCA I	(XC8CKP+2)	/PREVENT PROBLEMS
	TAD	(RAR)		/YET AGAIN
	DCA I	(XC8ERR+3)	/PREVENT PROBLEMS
	TAD	(NOP)		/PREVENT THE
	DCA I	(CNTRLC+3)	/CLEAR PROBLEM
	JMP I	(BGN)		/GO START IT UP

	PAGE
