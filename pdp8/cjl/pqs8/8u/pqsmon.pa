LAST,	TAD I	BUFEND/[FILBEG+3775]	/\
	CMA				/ \IF NULL FILE
	SNA CLA				/ /THEN DO NOTHING
	JMP	LASTCR			//
	NL0002				/\
	TAD I	FIZZ2/[FILBEG+3777]	/ >POINT TO LAST ENTRY
