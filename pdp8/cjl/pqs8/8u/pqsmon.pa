	TAD	L7757/[-"Q!300]	/CHECK FOR LOOSE <^Q>
	SNA			/SKIP IF OTHER
	JMP	TCLEAR		/IGNORE <^Q> WITHOUT <^S>
	TAD	L2/[-"O+"Q]	/CHECK FOR <^O>
	SNA			/SKIP IF OTHER
