TABNO,	STL				/ENTRY FOR NOFILL
TAB35,	NL0001				/ENTRY FOR MOD35
TABOFF,	RTR				/ENTRY FOR <HT> OFF
TABSET,	DCA	TABSW			/SET <HT> SWITCH
