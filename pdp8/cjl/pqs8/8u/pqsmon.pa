SEQ,	JMS	NUMNUM			/SCAN ARGUMENTS
	JMP I	PBEGIN/[BEGIN]		/NOW GO USE THEM
	
RESEQ,	JMS	NUMNUM			/SCAN ARGUMENTS
	TAD	BUFEND/[FILBEG+3775]	/START WITH FIRST LINE NUMBER
RESLUP,	DCA	TPTR1			/SAVE POINTER TO LINE NUMBER
	TAD I	TPTR1			/FETCH NEXT LINE NUMBER
	CMA				/\
	SZA CLA				/ \
