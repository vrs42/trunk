	SYSLEN+EXTLEN+RUNLEN^100	/INTO FILE AREA
	SYSCAT				/STARTING FROM SYSTEMS CATALOGUE
	JMP I	.+1/(RSTART)		/GO START IT UP
	RSTART				/THROUGH HERE
PUNCH,	NL7777				/INDICATE PUNCH MODE
LIST,	DCA	TEMP2			/SAVE MODE
