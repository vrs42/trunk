	JMP I	PBEGIN/[BEGIN]		/NO... FORGET IT
LISLUP,	TAD I	LOWLIM			/\
	DCA	LISTPT			/ >FETCH POINTER TO LINE
	ISZ	LOWLIM			//
	TAD	TEMP2			/\
	SZA CLA				/ >BYPASS IF IN PUNCH MODE
	JMP	NOLNUM			//
	TAD I	LOWLIM			/ELSE FETCH LINE NUMBER
	JMS I	LNOPRT/[XLNOPRT]	/AND PRINT IT
NOLNUM,	JMS I	SCRIBE/[XSCRIBE]	/NOW PRINT
LISTPT,	.-.				/THE LINE
	NL7775				/\
	TAD	LOWLIM			/ >BUMP POINTER
	DCA	LOWLIM			//
