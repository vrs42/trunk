L101,	101			/CONSTANT 0101
PCHTBL,	CHTBL-2			/POINTER TO CHARACTER TABLE
PNEXT,	GOTCR			/POINTER TO NEXT ROUTINE; MODIFIED BY EDIT MODE
CHTBL,	-177;	BACKSP		/<RO>
	-137;	BACKSP		/<BACK ARROW>
	-33;	GOTESC		/<ESC>
	-"Z!300;EOSEQ		/<^Z>
	-"U!300;DELETL		/<^U>
	-"T!300;REW		/<^T>
	-"R!300;REW		/<^R>
