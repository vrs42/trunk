FINDENT,DCA I	(FNDFLG)		/INDICATE "FIND"
	TAD I	(LINGO)			/INITIALIZE THE
	DCA I	(XGLIN2)		/GLINE ROUTINE
	TAD	RST			/GET EXECUTION BREAKPOINT POINTER
