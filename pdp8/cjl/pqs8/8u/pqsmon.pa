	JMP I	TCHECK		/RETURN IF SOMETHING ELSE
	JMS	CCHECK		/CHECK FOR <^C> AND GET A CHARACTER
	TAD	L7757/[-"Q!300]	/CHECK FOR <^Q>
	SZA CLA			/SKIP IF <^Q>
	JMP	.-3		/GO BACK IF ANYTHING ELSE (INCLUDING NOTHING)
TCLEAR,	DCA	INCHAR		/OBLITERATE HIDDEN CHARACTERS
	JMP I	TCHECK		/RETURN

OFLIP,	JMS I	PCTRLPR/[CTRLPR]/PRINT "^O"
