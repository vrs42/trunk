NOPRMPT,TAD	SLINUM		/GET LINE NUMBER
	JMS I	LNOPRT/[XLNOPRT]/PRINT IT
CTLKREM,TAD	PUTNDX		/SAVE FOR THE
	DCA	EDLIN		/<^K> COMMAND
CHLOOP,	JMS I	INPUT		/FETCH SEVEN-BIT ASCII CHARACTER
	DCA	TEMP1		/PRESERVE CHARACTER
	TAD	PCHTBL/(CHTBL-2)/TABLE POINTER
