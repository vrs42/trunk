	SNA			/SKIP IF NOT
	JMP	GOTEQ		/JUMP IF SO
	IAC/TAD	(-"<"+=)	/IS IT "<"?
	SNA			/SKIP IF NOT
	JMP	GOTLT		/JUMP IF SO
	TAD	L15/[-"/+"<]	/IS IT "/"?
	SNA			/SKIP IF NOT
	JMP	GOTSLSH		/JUMP IF SO
	TAD	L7/[-"(+"/]	/IS IT "("?
	SZA CLA			/SKIP IF SO
	JMP	SCNFILE		/JUMP IF NOT
	ISZ	GETNDX		/BUMP PAST "("
MORESW,	JMS I	(SWITCH)	/PROCESS NEXT AS SWITCH
