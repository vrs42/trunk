	ISZ	OVRPTR		/BUMP TO NEXT
	ISZ	OVRCNT		/CHECKED ENOUGH?
	JMP	.-3		/NO, KEEP GOING
	CDF	00		/BACK TO OUR FIELD
	TAD	OVRSUM		/COMPARE TO MAGIC VALUE
	SNA CLA			/SKIP IF WRONG
	JMP	OVRLOADED	/JUMP IF APPARENTLY OK
	JMS I	SSYSIO/[SYSIO]	/CALL I/O ROUTINES
	0000			/RELOAD ADDRESS
OVRFUN,	.-.			/READ FUNCTION FOR OVERLAY
OVRBLK,	.-.			/BLOCK NUMBER FOR OVERLAY
OVRLOAD,CIF	10		/WILL BE CIF OVERLAY FIELD
	JMS	XIOMON		/INITIALIZE MONITOR AND GET <^C> INDICATOR
/	JMP	OVRCOMMON	/CONTINUE THERE

