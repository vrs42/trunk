  71                       KSFIOT= CI^10+6001              /SKIP ON KEYBOARD FLAG
  72                       KTIIOT= CI^10+6003              /KEYBOARD TEST INSTRUCTION
  73                       LLSIOT= LP^10+6006              /OUTPUT LPT: CHARACTER, CLEAR FLAG
  74                       LSFIOT= LP^10+6001              /SKIP ON (CLEAR IF 6120) LPT: FLAG
  75                       TCFIOT= CO^10+6002              /CLEAR TTY: FLAG
  76                       TIEIOT= CO^10+6005              /OUTPUT INTERRUPT ENABLE PER AC[11] FOR 6120
  77                       TLSIOT= CO^10+6006              /OUTPUT CHARACTER, CLEAR FLAG
  78                       TSFIOT= CO^10+6001              /SKIP ON (CLEAR IF 6120) OUTPUT FLAG
