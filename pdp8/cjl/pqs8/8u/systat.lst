  63                       INCON=  0031                    /EQUATED FROM CONSOLE!
  64                       JMSC=   JMS     .               /CURRENT PAGE JMS INSTRUCTION
  65                       LINC=   6141                    /GOTO LINC MODE
  66                       LPT=    0066                    /SYSTEM LPT: DEVICE CODE
  67                       MUY=    7405                    /MULTIPLY
  68                       NL0001= CLA IAC                 /LOAD AC WITH 0001
  69                       NL0002= CLA CLL CML RTL         /LOAD AC WITH 0002
  70                       NL0010= CLA IAC RAL RAR         /LOAD AC WITH 0010
