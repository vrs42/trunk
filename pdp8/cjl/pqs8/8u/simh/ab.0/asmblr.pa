L7700,	7700			/CONSTANT 7700
PAGCNT,	2^100			/**** 8K **** 14-OPTIONS^100
PEOF,	EOF			/POINTER TO <EOF> ROUTINE
PLSTBF,	LSTBUF			/BUFFER HEAD
