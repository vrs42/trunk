	DCA I	POVZP2/(OVFZP2)	/OVERFLOW PAGES
PRSTB2,	NL0001			/INITIALIZE TABLE
PRSTB3,	JMS I	GETSYM/[GETSM]	/GET A SYMBOL
	JMP	LINEXT		/NO MORE THIS GO-AROUND
	JMS I	PRTSYM/[XPRTSM]	/PRINT THE SYMBOL NAME
	TAD	NMFLGS		/GET SYMBOL FLAGS
	CLL RAL			/MOVE OVER
	SPA SZL			/UNDEFINED SYMBOL?
	JMP	TRYRST		/NO, TRY OTHERS
	TAD	L7774/[-4]	/\
	DCA	NM1		/ \
	JMS I	P6CH/[XP6CH]	/  \
	TAD	LSTAR/("*&77)	/   \PRINT " **** " IN
	JMS I	P6CH/[XP6CH]	/   /PLACE OF THE VALUE
