PSTCMN,	TAD	PR7711/(-67)	/SET UP TO
	JMS I	PTHRWSM/(THRWSM)/THROW AWAY 54 SYMBOLS
	JMP	LINEXT		/NO MORE TO THROW AWAY!
	TAD	COLCT		/GET CURRENT COLUMN
	TAD	COLIMT		/TOO FAR?
	SMA CLA			/SKIP IF NOT
	JMP	LINEXT		/JUMP IF SO
	JMS I	P45CH/[XP45CH]	/PRINT 2 <BLANK>S
	JMS I	P6CH/[XP6CH]	/**** LPT: OR /P **** JMS I P45CH/[XP45CH]
	JMP	PRSTB3		/GO BACK
LINEXT,	NL0001			/RESET
