	JMS I	P6CH/[XP6CH]	//
	JMP	PSTCMN		/BRANCH AROUND

TRYRST,	SNL			/SKIP IF MRI OR PSEUDO-OP
	JMP	TRYPRM		/EITHER PERMANENT OR USER
	SMA CLA			/SKIP IF PSEUDO-OP
	TAD	PR7711/("M-"D)	/GOOD AS 6-BIT "M-"D!
	TAD	L4/["D&77]	/USE AT LEAST "D"
	JMP	SAVRCH		/FINISH THERE

TRYPRM,	AND	NM2		/AND OFF FIXTAB BIT
	SPA CLA			/SKIP IF USER SYMBOL
	TAD	L20/("P&77)	/USE "P"
SAVRCH,	DCA	RCHAR		/SETUP REAR CHARACTER
	TAD	NM2		/GET PERMANENT WORD
	RAL			/FIXTAB BIT TO LINK
	CLA			/CLEAN UP
	TAD	NM3		/GET DEFINED BY COMMA WORD
