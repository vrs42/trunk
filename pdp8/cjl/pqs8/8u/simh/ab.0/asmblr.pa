	DCA I	PUTWD			/IF NECESSARY
	TAD	TPE2			/RESTORE OLD PUTWD ARGUMENT
	DCA I	ORSYM/[XORSYM]		/IF NECESSARY
TESTXT,	TAD	LOCNTR			/CURRENT LOCATION COUNTER
	DCA	OLDLOC			/IS OLD LOCATION COUNTER ALSO
	JMP I	TESTPE			/RETURN

ZPORG,	TAD I	PZPLPTR			/\
