BLUSE2,	TAD	BL7765/(-12-1)	/SETUP
	DCA I	PTITLEN/(TITLEN)/LENGTH WORD IN TITLE
	TAD I	BLSM0/(BLSMSG)	/GET A WORD
	DCA I	BLADR/(BLURB)	/PUT A WORD
