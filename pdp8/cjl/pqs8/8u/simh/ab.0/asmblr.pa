	NL2000			/SEE IF
	TAD	NMFLGS		/IT'S A
	AND	L6000/[6000]	/PSEUDO-OP
	SNA CLA			/SKIP IF NOT
	JMP	XPUNG2+1	/JUMP IF SO
	NL7775			/BACKUP SYMBOL
	TAD	SXR		/TABLE POINTER
	DCA	TMP		/SAVE IT
	JMS I	SETFLD/[XSTFLD]	/SETUP FIELD
	DCA I	TMP		/WIPE OUT SYMBOL
	CDF	00		/MAKE SURE
	JMP	XPUNG2+1	/BACK FOR MORE

XFXT2,	NL0001			/GET INITIAL VALUE
	JMS I	GETSYM/[GETSM]	/GET A SYMBOL
	JMP I	PSDRET/[XPSDRET]/NO MORE SYMBOLS, RETURN
	NL7776			/BACKUP SYMBOL
	TAD	SXR		/TABLE POINTER
	DCA	TMP		/SAVE IT
	JMS I	SETFLD/[XSTFLD]	/SETUP FIELD
	TAD I	TMP		/GET SECOND SYMBOL WORD
	RAL			/SHIFT PFLAG INTO LINK
	STL RAR			/SET PFLAG
	DCA I	TMP		/STORE IT BACK
	CDF	00		/MAKE SURE IN CASE LAST
	JMP	XFXT2+1		/GO DO NEXT
