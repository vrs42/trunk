	VERSIO%12^66+VERSIO+6060/VERSION NUMBER
	REVISION^100+" -200	/<REVISION NUMBER><BLANK>
	TEXT	"  "		/<BLANK><BLANK>
DAYBLB,	TEXT	" MON  UN-DAT-ED  PAGE S-"
TITMAX,	BLURB-TITND		/MAXIMUM LENGTH OF USER BLURB

BLURB,	TEXT	"NO INPUT!"	/DEFAULT TITLE

	TITND=	.+177&7600	/END OF USER BLURB AREA

	RELOC			/RESTORE REAL ORIGIN

