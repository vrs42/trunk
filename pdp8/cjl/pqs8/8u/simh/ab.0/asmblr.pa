	SNA CLA			/SKIP IF SET
	JMP	GTEST		/JUMP IF NOT
	NL7775			/ALLOW TWO
	DCA I	(OUTCNT)	/OUTPUT FILES
	TAD I	(BDFLST)	/GET %:[BOOTSTRAP UNIT (XOR ONE IF /U)]
	TAD	(DOLBLK-BINADR)	/UPDATE TO $:[BOOTSTRAP UNIT (XOR ONE IF /U)]
	DCA I	(BDFLST+1)	/STORE INTO DEFAULT LIST
OUTIN,	JMS I	(SETB)		/FORCE /B
GTEST,	TAD I	(SPARM)		/GET EQUALS PARAMETER
	IAC			/ADD ONE
	SZA CLA			/SKIP IF NONE PASSED
	JMP	GSET		/ELSE SET /G
	TAD I	NM1/[SWAL]	/GET SWITCHES /A-/L
