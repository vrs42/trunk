TPE2,	.-.				/TEMPORARY FOR TESTPE

	IFNZRO	OLDLOC-LITEND&177	<ERROR	.>

LIT2,	.-.				/PUTWD INTERCEPT ROUTINE
LT2ZAP,	JMS	TESTPE			/JMP LIT2XT IF ZAPPED BY TESTPE
	TAD	LOCNTR			/\
L47,	AND	L177/[177]		/ \SAVE INVERTED PAGE
	CIA				/ /BITS IN TMP
	DCA	TMP			//
	TAD	LOCNTR			/\
	AND	L7600/[7600]		/ \CHECK FOR PAGE ZERO
	SNA CLA				/ /AND BRANCH TO ZPORG IF SO
	JMP	ZPORG			//
	TAD I	PCPLPTR			/\
	TAD	PAGEND/(-CPLBEG+177)	/ \
	TAD	TMP			/  \
	SMA CLA				/   >CHECK IF THIS WORD OVERFLOWS LITERALS
	JMP	.+3			/  /
	JMS I	ERR/[XERR]		/ /
	PE				//
	TAD I	PCPLEND			/\
	CIA				/ \
	TAD	PAGEND/(-CPLBEG+177)	/  \
	TAD	TMP			/   \
	SMA CLA				/    \IF WORD IS HIGHER THAN
NOTEST,	JMP	LIT2XT			/    /CPLEND, THEN UPDATE CPLEND
	TAD	PAGEND			/   /
