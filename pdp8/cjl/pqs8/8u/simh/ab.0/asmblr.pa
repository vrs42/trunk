	DCA	LBLSWT		/CLEAR LABEL FLAG
	DCA	EQUSW		/CLEAR EQUALS SWITCH
	TAD	PUSHPT/(XPDLADR)/RESET
	DCA	PDLPTR		/PUSHDOWN
	NL7777			/RESET THE
	DCA	ASIGN		/ARITHMETIC SIGN
	DCA	MRISW		/CLEAR MRI STATE
	DCA	MRINDS		/CLEAR MRI (I) BITS
	JMS I	EXPR/[XEXPR]	/TRY TO EVALUATE
