	JMP I	(TESTSW)	/ON TO NEXT TEST

STEAL,	OFPCNT			/CORE STEAL ROUTINE; INITIALIZED FOR ONCE-ONLY CODE
	TAD I	STEAL		/GET AGAIN
	TAD I	PCHEND		/ADD ON TO INPUT LIMIT
	DCA I	PCHEND		/STORE IT BACK
/	TAD I	PCHROOM		/RECOVER MAGIC NUMBER
/	CLL			/CLEAR LINK FOR TEST
/	TAD	SLIMIT		/COMPARE TO MAGIC LIMIT
/	SNL CLA			/SKIP IF STILL ROOM
/	JMP	NOCORE		/GO ABEND (SYSTEM 80A)
	TAD I	STEAL		/GET NUMBER OF PAGES
	STL RAR			/SIGNED HALVE IT
	TAD I	PPAGCNT		/ADD ON PAGE COUNTER
	DCA I	PPAGCNT		/SAVE NEW PAGE COUNT
	TAD I	PPAGCNT		/GET PAGE COUNT BACK
	JMS I	ROR6/[XROR6]	/MAKE IT BLOCK COUNT
	DCA I	PBLKCNT		/STORE IT
	TAD I	STEAL		/\
	CIA			/ \UPDATE
