	TAD	VERCNT		/GET IT BACK
	IACS			/LOAD LINC-8 "S" REGISTER
	CLA			/CLEAN UP
	LINC			/GOT L...MODE IF PDP-12, STOP THE TAPES IF LINC-8
	LDA;	VERCNT		/GET THE PASSED VALUE AGAIN
	SCR	14		/PUT INTO MQ
	PDP			/BACK TO GOODY MODE
	CLA			/CLEAN UP
	TAD	VERCNT		/GET IT AGAIN
	MQL			/LOAD MQ DIRECTLY IF EAE OR PDP-8/E OR BETTER
	CLA			/CLEAN UP IF PDP-8/L OR WORSE
	JMP I	DISPLAY		/RETURN

IOCHK,	.-.			/I/O MODE CHECK ROUTINE
	CLA			/CLEAN UP
	TAD	IOSW		/GET CURRENT MODE
	SZA CLA			/SKIP IF NORMAL MODE NOW
	JMP I	IOCHK		/RETURN IF ALREADY IN ONE-AT-A-TIME MODE
