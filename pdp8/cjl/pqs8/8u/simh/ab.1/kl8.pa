	4000			/ERROR GOES HERE
	4000			/ERROR GOES HERE
	4000			/ERROR GOES HERE
	4000			/ERROR GOES HERE
	4000			/ERROR GOES HERE
ERRBLB,	" &177			/ERROR BLURB STARTS HERE
	"E&177
	"R&177
	"R&177
	"O&177
	"R&177
	" &177
	"W&177+40
	"H&177+40
	"I&177+40
	"L&177+40
