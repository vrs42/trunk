/	P?S/8 PATCH TO DTCOPY

/	PATCH TO DEC'S DTCOPY TO MAKE IT WORK ON P?S/8 SYSTEMS.

/	LAST EDIT:	23-APR-1986	18:00:00	CJL

/	MAY BE ASSEMBLED WITH '/J' SWITCH SET.

/	DEFINITIONS:

	BEGIN=	0200		/START OF DTCOPY PROGRAM
	DTLB=	6774		/LOAD DECTAPE "B" REGISTER
	MESS0=	1200		/ANNOUNCEMENT MESSAGE

	*0			/START AT THE BEGINNING

	IFNZRO	.&177	<ERROR	.>

	DTCOPY=	.		/DTCOPY SYSTEM STARTS HERE

DTCOPY,	NOP			/HERE IN CASE CHAINED TO
	TFL			/SET TTY: FLAG SILENTLY
	JMP I	.+1/(BEGIN)	/GO START IT UP
	BEGIN			/THROUGH HERE

	PAGE			/OVER ORIGINAL STARTING ADDRESS

IBEGIN,	DTLB			/ENSURE FIELD ZERO TRANSFERS
	TSF			/ONLY OUTPUT IF NECESSARY

	*MESS0+7		/OVER VERSION, REVISION

	"1^100+"0-200		/VERSION 10
	"B^100+" -200		/REVISION B <BLANK>

	$			/THAT'S ALL FOLK!
