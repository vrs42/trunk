	LDA=	1000		/LINC MODE LOAD AC
	LINC=	6141		/ENTER LINC (SUPER) MODE
	LMR=	6151		/LOAD MAINTANENCE REGISTER
	NL0001=	CLA IAC		/SET AC TO ONE
	NL0002=	CLA CLL CML RTL	/SET AC TO TWO
	NL0004=	CLA CLL IAC RTL	/SET AC TO FOUR (FOR PDP-12 ONLY)
	NL2000=	CLA CLL CML RTR	/SET AC TO TWO THOUSAND
	NL3777=	CLA CLL CMA RAR	/SET AC TO THREE SEVEN SEVEN SEVEN
	NL4000=	CLA CLL CML RAR	/SET AC TO FOUR THOUSAND
	NL7775=	CLA CLL CMA RTL	/SET AC TO SEVEN SEVEN SEVEN FIVE
	NL7776=	CLA CLL CMA RAL	/SET AC TO SEVEN SEVEN SEVEN SIX
	PDP=	0002		/GOTO PDP-8 (GOODY) MODE
	PRINTS=	4000		/PRINT OVERLAY ORIGIN
	RDC=	0700		/READ AND CHECK A BLOCK
	RDE=	0702		/READ A BLOCK
	SWAPIN=	1200		/ADDRESS TO SWAP CODE INTO
	SWPLEN=	2		/NUMBER OF BLOCKS(PAGES) TO SWAP
	SWPMON=	6		/EQUALS [SWAPIN/(2^7)]+1
	SWPSYS=	16		/BLOCK# OF SYSTEMS CATALOG
	TAC=	0003		/TAPE AC TO REAL AC
	TMA=	0023		/AC TO TAPE MEMORY ADDRESS
	UMCBLK=	102		/USER'S MONITOR COMMAND BLOCK




	VERSION=02		/VERSION # OF SYSTEM
/	SYSGEN PARAMETER AREA
/SETTING	DECTAPE=1	GENERATES A DECTAPE SYSTEM (TC01-TC08)
/SETTING	DF32=	1	GENERATES A DF32 SYSTEM (1-4 PLATTERS)
/SETTING	LINCTAPE=1	GENERATES A LINCTAPE SYSTEM (TC12)
/FOR THE PDP-12 (128 OR 129 WORDS/BLOCK REQUIRED)
/THE TC12-F OPTION CAN BE USED TO TRANSFER DATA BETWEEN TAPE SYSTEMS 
/EITHER LINCTAPE TO DECTAPE OR VICE VERSA
/(SEE DOCUMENTATION OF THE PRTC12-F PROGRAM ELSEWHERE)
/
/
/	INSERT SYSGEN PARAMETER HERE
/
/
	DECTAPE=1		/GENERATE A DECTAPE SYSTEM
/
/
	IFNDEF	DF32		<DF32=	0>
	IFNDEF	LINCTAPE	<LINCTAPE=0>
	IFNDEF	DECTAPE		<DECTAPE=0>
/
/
	IFZERO	DECTAPE+LINCTAPE+DF32	<DECTAPE=1>
	IFNZRO	DECTAPE+LINCTAPE+DF32-1	<
/COMPLAIN ABOUT BOTCHED SYSGEN
	**** ERROR **** INCOMPATIBLE SYSGEN PARAMETERS
/	$			/TERMINATE ASSEMBLY>



/MONITOR INITIALIZATION PARAMETER
/
/
/	BITS<0-1>	INITIAL TTY MODE
/			00 IS TTY 3
/			01 IS TTY 0
/			10 IS TTY 5
/			11 TABS PRINT AS ONE TAB WITH NO TIMEOUT
/	BITS<2-3>	PUNCH STATUS
/			00 IS TTY 3
/			01 IS TTY 0
/			10 IS TTY 5
/			11 TABS PUNCH AS ONE TAB WITHOUT NULL
/	BIT <4>		INITIAL LOADING STATUS
/			0 = NO LOAD
/			1 = LOAD $
/	BIT <5>		INITIAL SAVING STATUS
/			0 = NO SAVE
/			1 = SAVE $
/	BIT <10>	INITIAL RADIX
/			0 = DECIMAL
/			1 = OCTAL
/	BIT <11>	INITIAL ECHO STATUS
/			0 = ECHO ON
/			1 = ECHO OFF
	*0
	VERSION			/INTERNAL VERSION NUMBER OF MONITOR

	*3
INITSW,	1400			/CHANGE THIS TO FIT YOUR INSTALLATION
				/USED WHEN BOOTSTRAPPING
				/AFTER THAT IT CAN BE USED AS A TEMPORARY
	*4
