	DCA	XLINENO		/SAVE NUMBER
	TAD	BEGLIN		/\
	DCA	PUTBASE		/ >POINT TO INPUT BUFFER
	DCA	PUTNDX		//
	TAD	L7774		/INITIALIZE COUNT TO
	DCA	TEMCNT		/PRINT FOUR DIGITS
	TAD	L7440		/INITIALIZE ZERO SWITCH
	DCA	ZEROSW		/TO A SZA
DIVLUP,	TAD	TEMCNT		/COPY THE
	DCA	TEMP1		/COUNT
	CMA			/ASSUME RADIX^0
	DCA	TSTINT		/SAVE IT
	ISZ	TEMP1		/DO WE RAISE IT TO A HIGHER POWER?
	SKP			/YES...
	JMP	PRTDIG		/NO...NOW USE IT
	TAD	RADXSW		/\
	DCA	NEWCAT		/ \
	TAD	TSTINT		/  >MULTIPLY BY RADIX
	ISZ	NEWCAT		/ /
	JMP	.-2		//
	JMP	DIVLUP+3	/SEE IF WE RAISE AGAIN
PRTDIG,	TAD	XLINENO		/GET NUMBER
	CLL			/CLEAR MAGIC LINK
	TAD	TSTINT		/\
	SNL			/ \
	JMP	.+3		/  >DIVIDE BY RADIX^N
	ISZ	TEMP1		/ /
	JMP	.-5		//
	CIA			/\
	TAD	TSTINT		/ >RESTORE REMAINDER
	CIA			//
	DCA	XLINENO		/SAVE AS NEW NUMBER
	TAD	TEMP1		/GET QUOTNT
ZEROSW,	SZA			/TEST FOR LEADING ZEROS
	JMP	.+4		/JUMP IF SIGNIFIGANT DIGIT
	TAD	L40		/\
	JMS I	PRINT		/ >BLANK LEADING ZEROS
	JMP	.+5		//
	TAD	L60		/ADD "0-200
	JMS I	PINSERT		/NOW INSERT INTO BUFFER
	TAD	NOP1		/TURN OFF LEADING
	DCA	ZEROSW		/ZERO TESTER
	ISZ	TEMCNT		/ANY DIGITS LEFT?
	JMP	DIVLUP		/YES...GO GET EM
	TAD	L37		/TAKE A TAB AND
	JMS I	PINSERT		/INSERT IT
	JMP I	XLNOPRT		/RETURN
XLINENO,GENASYS			/FOR GENASYS PURPOSES ONLY
	JMS	TSTINT		/GO FIND A DIGIT
	JMP I	XLINENO		/NONE FOUND JUST RETURN
LINUM1,	DCA	XLNOPRT		/SAVE IT
	ISZ	GETNDX		/BUMP INDEX
	JMS	TSTINT		/TRY TO FIND ANOTHER
	JMP	LINUM2		/NO CAN DO
	DCA	TEMP1		/SAVE TEMPORARILY
	TAD	RADXSW		/SETUP TO MULTIPLY
	DCA	TEMCNT		/BY RADIX
	CLL			/CLEAR MAGIC LINK
	TAD	XLNOPRT		/\
	SZL			/ \
	JMP I	WHAT		/  >MULTIPLY BY RADIX & TEST FOR OVERFLOW
	ISZ	TEMCNT		/ /
	JMP	.-4		//
	TAD	TEMP1		/ADD DIGIT
	SNL			/TEST FOR OVERFLOW
	JMP	LINUM1		/IF NONE THEN GET NEXT DIGIT
	JMP I	WHAT		/ERROR IF OVERFLOWED
LINUM2,	JMS I	TSPACE		/IS CHAR A BLANK OR TAB
	TAD	XLNOPRT		/GET NUMBER
	CMA			/TEST FOR 7777
	SNA			/SKIP IF NOT
	JMP I	WHAT		/ERROR IF IT IS
	STL CMA			/RESTORE NUMBER   SET LINK=1
	ISZ	XLINENO		/BUMP RETURN ADDRESSS TO DO A
	JMP I	XLINENO		/SKIP RETURN
	
TSTINT,	0
	JMS I	GETHAF		/GET THE CHARACTER
	TAD	L7720		/TEST LOWER BOUND
	SPA			/PASSES
	JMP	.+4		/FAILS
	TAD	RADXSW		/TEST UPPER BOUND
	SPA			/FAILS
	JMP	.+3		/PASSES
	CLA CLL			/ZERO AC & LINK
	JMP I	TSTINT		/FAIL RETURN
	CIA			/\
	TAD	RADXSW		/ >RESTORE DIGIT
	CIA			//
	ISZ	TSTINT		/BUMP FOR
	JMP I	TSTINT		/SKIP RETURN
