	*7400
	ENPUNCH

VLINK,	TAD I	VVLOC		/GET OFFENDING PAGE
	CIA			/COMPARE
	TAD	VLOW		/TO CURRENT BUFFER LOWER LIMIT
	SMA SZA			/IN RANGE ?
	JMP	VFIX		/NO
	TAD	V377		/CHECK UPPER LIMIT
	SPA			/STILL IN RANGE ?
	JMP	VFIX		/NO
	CIA			/CALCULATE
	TAD	V6577		/OFFSET
	DCA	VPUT		/SAVE PTR
	TAD I	VVGETWD		/GET LOAD WORD
	DCA I	VPUT		/PUT IN BUFFER
	JMP I	VVOK2		/RETURN

VFIX,	CLA			/REMOVE GARBAGE
	TAD I	VUNIT		/GET CURRENT UNIT
	DCA	VPUT		/SAVE IT
	DCA I	VUNIT		/0 TO UNIT #
	JMS	VCCC		/CHECK FOR ABORT
	JMS I	VWRITE		/WRITE SOME BLOCKS
	VOUTBF			/FROM OUTPUT BUFFER
	-2			/2 BLOCKS
VBLOC,	SVAREA			/ASSUME 60 AT FIRST
	TAD I	VVLOC		/GET LOCATION COUNTER
	TAD	V7600		/-200
	AND	V7400		/AND OFF MAJOR PAGE BITS
	TAD	V200		/SET TO MINOR PAGE
	DCA	VLOW		/SET AS NEW LOWER LIMIT
	TAD	VLOW		/GET IT BACK
	CLL RTL			/ROL
	RTL			/AROUND
	RTL			/TO GOOD BITS
	TAD	V27		/ADD ON CORRECT OFFSET
	DCA	VBLOC		/SAVE IN CALL
	TAD	VBLOC		/GET AGAIN
	DCA	VBLOC2		/SAVE IN OTHER CALL
	JMS I	VREED		/READ SOME BLOCKS
	VOUTBF			/INTO 6200
	-2			/2 BLOCKS WORTH
VBLOC2,	SVAREA			/UPDATED BLOCK #
	JMS	VCCC		/CHECK FOR AN ABORTION AGAIN
	TAD	VPUT		/GET OLD UNIT #
	DCA I	VUNIT		/RESTORE IT
	JMP	VLINK		/TRY AGAIN,IT SHOULD WORK THIS TIME !

VCCC,	0			/V CONTROL C CHECK
	TAD	V200		/FORCE PARITY BIT ON
	KRS			/READ KEYBOARD STATIC
	TAD	VM203		/WAS IT
	SZA CLA			/ ^C ?
	JMP I	VCCC		/NO, CARRY ON
	JMP I	V7600		/YES,BOOTSTRAP (UNIT ALL READY ZERO)

VREED,	SZA CLA			/SYSIO READ ENTRY
VWRITE,	SZA CLA+6		/SYSIO WRITE ENTRY
VUNIT,	SUNIT			/SYSIO UNIT NUMBER PARAMETER
VPUT,	0			/ADDRESS STORAGE
VVGETWD,VGETWD			/POINTER TO VGETWD WHERE DATA WORD IS STORED
VVLOC,	VLOC			/POINTER TO LOCATION COUNTER
VVOK2,	VOK2			/PROPER RETURN ADDRESS
VLOW,	VOUTBF			/LOWER LIMIT VALUE
V6200,	6200			/COMPARATOR VALUE INITIALLY 6200
V200,	200
V27,	27
V377,	377
V6577,	6577
V7400,	7400
VM203,	-203
V7600,	7600
