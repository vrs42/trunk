	*BINAD1+200&7600+THEBIN	/GO TO NEXT PAGE!
	STRSLV=	.-THEBIN
/V OPTION CORE IMAGE BINARY LOADER


/THE /V OPTION ALLOWS DEVICE-INDEPENDENT BINARY LOADING
/BY CREATING A CORE IMAGE ON TAPE (OR DISC) OF THE CODE CORRESPONDING
/TO THE AREAS OF CORE FORBIDDEN TO DIRECT LOADING DUE TO
/BOOTSTRAP CONVENTIONS AND THE LOADER ITSELF;ALL OTHER LOCATIONS
/ARE DIRECTLY LOADABLE INCLUDING ALL OF FIELD 1-7 (SOME SYSTEMS
/RESTRICT LOADING INTO FIELD 1-7 7600-7777)


/THE ONLY RESTRICTION ON LOADING WITH /V IS THAT FIELD 0 7600-7777
/WILL NOT BE LOADED,HOWEVER THE CODE WILL
/BE AVAILABLE ON THE SYSTEM DEVICE (UNIT 0 BLOCK 66) AS A RELIC FOR
/FURTHER LOADING IF DESIRED;USE THE FOLLOWING CODING TO LOAD IT




/	LOADIT,	JMS I	(7640		/SYSTEM READ ENTRY
/	CORE,	UCORE			/USER'S 1 PAGE BUFFER
/	NMBLKS,	-1			/READ 1 BLOCK
/	BLKNO,	66			/WHERE CODE IS
/		TAD	(7600		/-200
/		DCA	NMBLKS		/USE AS A COUNTER
/		TAD I	CORE		/GET A WORD
/		DCA I	NMBLKS		/PUT IT
/		ISZ	CORE		/BUMP POINTER
/		ISZ	NMBLKS		/BUMP IT AND COUNT
/		JMP	.-4		/GO BACK AND DO IT AGAIN 'TIL DONE
/
/THIS COMPLETES LOADING OF 7600 FIELD 0
/NOTICE THAT THIS REQUIRES A 1 PAGE BUFFER ANYWHERE IN CORE
/(APPROPRIATE CHANGES FOR OTHER FIELDS CAN BE MADE)
/THE SYSTEM I/O ROUTINES ARE DESTROYED IN THE PROCESS AS THEY
/ARE THE FORMER OCCUPANTS OF 7600 FIELD 0 !
/
/NOTE: IT IS POSSIBLE TO OVERLAY THE SYSTEM I/O ROUTINES DIRECTLY
/BUT THIS IS TO BE DISCOURAGED BY ANYONE OTHER THAN A 
/P?S SYSTEMS PROGRAMMER THOROUGHLY FAMILIAR WITH THE PARTICULAR COPY
/OF THE SYSTEM I/O ROUTINES IN USE AT THE TIME AS ANY OTHER ATTEMPT
/TO DO THIS WILL MOST CERTAINLY FAIL.(THIS DOES NOT IMPLY THAT A
/P?S SYSTEMS PROGRAMMER WILL NECESSARILY SUCCEED ! (MARIO'S NOTE,ED.))










/V OPTION CORE LAYOUT


/	0-6177				FREE FOR NORMAL LOADING

/	6200-6377	BLOCK	60	FIRST HALF OF OUTPUT BUFFER
/	6400-6577	BLOCK	61	SECOND HALF OF OUTPUT BUFFER
/	6600-6777	BLOCK	62	FIRST HALF OF INPUT BUFFER
/	7000-7177	BLOCK	63	SECOND HALF OF INPUT BUFFER
/	7200-7377	BLOCK	64	FIRST PAGE OF /V LOADER
/	7400-7577	BLOCK	65	SECOND PAGE OF /V LOADER
/	7600-7577	BLOCK	66	SYSTEM I/O ROUTINES
/	---------	BLOCK	67	SYSTEM RELICS
/
/	BLOCK NUMBERS REFER TO THE BLOCK WHERE THE CORE IMAGE FOR
/	THAT PART OF CORE WILL BE STORED UNTIL CORE IMAGE LOADING
/


	
	NOPUNCH			/ESTABLISH LOADING ORIGIN
	*7200			/WHERE THIS LOADS
	ENPUNCH			/START BINARY OUTPUT AGAIN
VREAD,	NL4000			/ENTER WITH HIBIT ON
	AND I	VILPTR		/GET UNIT BIT
	CLL RTR			/TO CORRECT BIT
	DCA I	VSUNIT		/PUT IN UNIT PARAMETER
	NL3777			/BLOCK NUMBER MASK
	AND I	VILPTR		/GET BLOCK NUMBER
	DCA	VBLOCK		/PUT IT IN CALL
VNWBUF,	JMS I	VEREAD		/READ SOME BLOCKS
VBUFF,	VINBUF			/INTO INPUT BUFFER
	-2			/2 BLOCKS WORTH
VBLOCK,	20			/ASSUME THE BIN
	ISZ	VBLOCK		/INCREMENT
	ISZ	VBLOCK		/AGAIN
	NL7776			/-2
	DCA	VRECCT		/TO RECORD COUNT
	TAD	VBUFF		/GET BUFFER POINTER
	DCA	VINPTR		/TO WORKING POINTER
VNWREC,	TAD	V7756		/-22
	DCA	VGRPCT		/TO GROUP COUNT
VNWGRP,	TAD	V7772		/-6
	DCA	VWDCT		/TO WORD COUNTER
	JMS	VGETWD		/GET A WORD TO AC
	SKP			/ONLY ONE FIRST TIME
VGRPLP,	TAD	VRLBTS		/GET FLAG WORD
	CLL RTL			/ROL IT
	DCA	VRLBTS		/PUT IT BACK
	NL0001	CML		/SET UP MASK AND LINK
	AND	VRLBTS		/NOW WE HAVE THE FLAGS
	SNL			/SKIP IF NOT FIELD OR EOF
	JMP	VEOF		/CHECK FOR EOF OR FIELD
VEREAD,	SZA CLA			/SKIP IF LOAD WORD
	JMP	VORGIN		/DO NEW ORIGIN SETTING
VWORD,	JMS	VGETWD		/GET A WORD TO LOAD
VCDF,	JMP	VCHECK		/OR CDF N (N=10-70)
VOK,	DCA I	VLOC		/LOAD IT
VOK2,	CDF	00		/FIELD 0
	ISZ	VLOC		/BUMP LOCATION COUNTER
V70,	70			/FIELD MASK	(ALSO NOP)
VNXTWD,	ISZ	VWDCT		/END OF GROUP ?
	JMP	VGRPLP		/NO
	ISZ	VGRPCT		/END OF BLOCK ?
	JMP	VNWGRP		/NO
	JMS	VGETWD		/THROW AWAY
	JMS	VGETWD		/2 WORDS
	ISZ	VRECCT		/END OF RECORD?
	JMP	VNWREC		/NO,JUST END OF BLOCK
	JMP	VNWBUF		/YES,RELOAD INPUT BUFFER

VORGIN,	JMS	VGETWD		/GET ORIGIN WORD
	DCA	VLOC		/SAVE AS LOCATION COUNTER
	JMP	VNXTWD		/GO DO NEXT
VEOF,	SNA CLA			/EOF ?
	JMP	VEOLOD		/YES
VFIELD,	JMS	VGETWD		/GET FIELD SETTING
	DCA	VGETWD		/SAVE TEMPORARILY
	TAD	VGETWD		/GET IT BACK
	AND	V70		/CHECK WHICH FIELD
	SNA			/NOT FIELD 0 ?
	TAD	VFUDGE		/NO,FIELD 0
	TAD	VOK2		/GET ORIGINAL FIELD SETTING
/NOTE THAT IF FIELD 0 IS IN EFFECT,THE AC LOOKS LIKE:
/JMP	VCHECK NOT CDF 00 !
	DCA	VCDF		/PUT IN FIELD CHANGE WORD
	JMP	VNXTWD		/DO NEXT
VEOLOD,	ISZ	VILPTR		/BUMP FILE POINTER
	TAD I	VILPTR		/GET NEXT FILE
	SZA CLA			/EOL ?
	JMP	VREAD		/NO,DO ANOTHER
	DCA I	VSUNIT		/UNIT 0
	TAD I	PVCURB
	DCA	VEOLBL
	JMS I	VRIGHT
	VOUTBF
	-2
VEOLBL,	SVAREA
	TAD	V1		/GET USER FIELD
	DCA I	V2		/TO A GOOD PLACE
	TAD	V3		/STARTING JMP INSTRUCTION
	DCA I	V4		/TO ANOTHER GOOD PLACE
	JMP I	V5		/START USER PROGRAM

VGETWD,	0			/GET A WORD FROM BUFFER
	TAD I	VINPTR		/1 WORD
	ISZ	VINPTR		/BUMP POINTER FOR NEXT TIME
	JMP I	VGETWD		/RETURN

VCHECK,	DCA	VGETWD		/SAVE WORD
	TAD	VLOC		/CHECK LOCATION COUNTER
	TAD	V1600		/AGAINST LIMIT (6200)
	SNL CLA			/OK ?
	JMP I	VULGAR		/NO,FIXUP
	TAD	VGETWD		/RESTORE WORD
	JMP	VOK		/STORE IT
	VOUTBF=	6200		/OUTPUT BUFFER
	VINBUF=	VOUTBF+400	/INPUT BUFFER

VILPTR,	7757			/FILE POINTER
VSUNIT,	SUNIT			/SYSIO UNIT #
VINPTR,	VINBUF			/INPUT POINTER CONSTANT
VRECCT,	0			/RECORD COUNT (-1 OR -2)
VGRPCT,	0			/GROUP COUNT (-22)
VWDCT,	0			/WORD COUNTER (-6)
VRLBTS,	0			/FLAG WORD
VLOC,	0200			/LOCATION COUNTER
VFUDGE,	VCHECK&177+5200-CDF	/INSTRUCTION CHANGE CONSTANT
V1,	CIF CDF	00		/USER FIELD,UPDATED BY BIN LOADER INITIALIZE
V2,	7757			/FIRST WORD OF USER START MOVE
V3,	BJMP&177+5600		/JMP I	BJMP
V4,	7760			/LAST WORD OF USER START MOVE
V5,	SLOAD			/GO READ IN WHEN DONE
V7756,	-22			/GROUP COUNT CONSTANT
V7772,	-6			/6 BLOCKS WORTH
VULGAR,	VLINK			/POINTER TO FIXUP ROUTINE
V1600,	-VOUTBF			/LIMIT CONSTANT
PVCURB,	VBLOC
VRIGHT,	SWRITE
