	JMP I	BGETWD		/RETURN	
	ZBLOCK	7640-.		/FILL IN ROOM(IF ANY)
BERR,	HLT			/FOR BADNESSES
BREAD,	TAD I	BFLPTR		/GET NEXT UNIT
	SPA CLA			/UNIT EINE?
	TAD	B10		/JA VOL
	TAD	BRDINS		/RDE
	DCA	BFUN		/PUT IN LINE
	NL3777			/FILE BLOCK MASK
	AND I	BFLPTR		/GET NEXT BLOCK
	DCA	BLOCK		/PUT IN LINE
BLINC,	LINC			/GO TO L...MODE
	LDA	II		/LOAD AC IMMEDIATE
	30			/EXTENDED ADDRESSING + NOPAUSE
	AXO			/TO EXTENDED OPERATIONS BUFFER
	LDA	II		/LDA I
B7400,	7400			/BINARY BUFFER
	TMA			/SET UP TRANSFER
BFUN,	RDE			/RDE OR RDE U
BLOCK,	20			/ASSUMED BINARY BLOCK
	PDP			/RETURN TO PEYTON PLACE MODE
	CLA			/CLEAR AC OUT
	JMS	BWAIT		/NOW GET A BUFFER'S FULL
/END OF LINCTAPE STUFF FOR NOW		>
	IFNZRO	DF32	<
/ENTER DF32 BOOTSTRAP + ROUTINES
BINBOOT,CLA CLL			/JUST IN CASE
	DEAL			/CLEAR OUT EXTENED ADDRESSING
	TAD	BOOTAD		/BINBOOT-1
	DCA	BCA		/TO CURRENT ADDRESS
	DCA	BWC		/KEEP IT GOING
	DMAR			/READ IT IN
	JMP	BWAIT+1		/DFSC OF SYSTEM BLK
BOOTAD,	BINBOOT-1		/BOOT ADDRESS-1
B3700,	3700			/EXTENDED ADDRESS MASK
	ZBLOCK	7613-.		/WASTED SPACE
BWAIT,	SERR-1			/ADDRESS TO RETURN TO LATER
	DFSE			/NO ERRORS?
	JMP	.+4		/NO THERE ARE ERRORS
	DFSC			/COMPLETION OF TRANSFER?
	JMP	.-3		/NO,WAIT
	SKP			/YES,TAKE NORMAL RETURN
	ISZ	BWAIT		/TAKE SKIP RETURN ON ERRORS
	JMP I	BWAIT		/RETURN
	ZBLOCK	7640-.		/WASTED SPACE
BERR,	HLT			/DEFAULT STARTING ADDRESS
BREAD,	CLA			/JUST IN CASE
	DCA	BWC		/TO KEEP IT GOING
	TAD I	BFLPTR		/GET NEXT FILE
	RAL			/SHIFT TO RIGHT BITS
	AND	B3700		/ONLY EXTENDED BITS
	DEAL			/LOAD EXTENDED ADDRESS REGISTER
B7600,	7600			/CLA
	TAD I	BFLPTR		/GET AGAIN
	CLL RTR			/MOVE
	RTR			/TO RIGHT
	RTR			/BITS
	AND	B7600		/MAKE SURE
	DMAR			/START READING
/END OF DF32 STUFF FOR NOW		>
/BINARY LOADER ROUTINE FOR ALL DEVICES
BNWREC,	TAD	B7756		/22 GROUPS
	DCA	BGRPCT		/INTO GROUP COUNTER
BNWGRP,	TAD	B7772		/6 WORDS
	DCA	BWDCT		/INTO WORD COUNTER
	JMS	BGETWD		/GET A WORD
	SKP			/DONT GET FLAG THIS TIME
BGRPLP,	TAD	BRLBTS		/GET FLAG
	CLL RTL			/ROTATE TO NEXT
	DCA	BRLBTS		/PUT IT BACK
	NL0001 CML		/SET AC 11 AND MAYBE LINK ON
	AND	BRLBTS		/CHECK FOR CONDITIONS
	SNL			/EOF OR FIELD SETTING ?
	JMP	BEOF		/YES (NOTE LINK IS OFF HERE)
	SZA CLA			/WORD OF CODE?
	JMP	BORGIN		/NO
	JMS	BGETWD		/GET ANOTHER
BCDF,	CDF	00		/GETS CHANGED
	DCA I	BLOC		/STORE CODE
	ISZ	BLOC		/BUMP CORE POINTER
	CDF	00		/RESTORE FIELD
BNXTWD,	ISZ	BWDCT		/DONE SIX YET ?
	JMP	BGRPLP		/NO DO ANOTHER
	ISZ	BGRPCT		/DONE 22 GROUPS YET ?
	JMP	BNWGRP		/NO DO ANOTHER
	IFNZRO	DECTAPE+DF32	<
	JMS	BGETWD		/THROW 1 AWAY
	JMS	BGETWD		/THROW 2 AWAY
	IFNZRO	DECTAPE	<
	JMS	BGETWD		/THROW 3 AWAY	>
	CLA			/GET RID OF LAST ONE
	JMP	BNWREC		/START AGAIN >
	IFNZRO	LINCTAPE<
	JMP	BLEOB		>

BORGIN,	JMS	BGETWD		/GET A NEW WORD
	DCA	BLOC		/MAKE IT THE NEW LOCATION COUNTER
	JMP	BNXTWD		/GO DO NEXT ONE
BEOF,	SNA CLA			/FIELD SETTING ?
	JMP	BEOLOD		/NO
	JMS	BGETWD		/GET A NEW WORD
	DCA	BCDF		/MAKE IT THE NEW FIELD SETTING
	JMP	BNXTWD		/GO DO NEXT ONE
	IFNZRO	DECTAPE+DF32	<
BGETWD,	0			/GET A WORD AS IT COMES IN
	NL0001			/CURRENT ADDRESS MASK
	AND	BCA		/ODD OR EVEN
	SNA CLA			/SKIP IF ODD
	JMP	.-3		/WAIT
	NL7776			/RESET
	DCA	BCA		/CURRENT ADDRESS
	TAD	BWD		/GET NEW WORD
	JMP I	BGETWD		/RETURN>
BEOLOD,	ISZ	BFLPTR		/BUMP FILE POINTER
	TAD I	BFLPTR		/GET NEXT FILE
	SZA CLA			/END OF LIST ?
	JMP	BREAD		/NO,DO ANOTHER
	IFNZRO	DECTAPE	<
	DTLA			/COME TO REST 	>


	IFNZRO	LINCTAPE<
	TAD	B7600		/STOP CONSTANT
	LCR			/LOAD SPECIAL HARDWARE STATUS REGISTER
B10,	10			/AND
	CLA CLL			/TO BE SURE	>


	IFNZRO	DF32	<
	STA			/RESET
	DCA	BWC		/WORD COUNT TO STOP TRANSFER
	NL7776			/FOR CURRENT ADDRESS
	DCA	BCA		/DISC IS NOW ASLEEP	>


	IFNZRO	7743-.&4000	<
	**** ERROR **** BINARY LOADER CANNOT ASSEMBLE !!>


	IFNZRO	7743-.		<
	JMP	BCIF		/TRAVERSE EMPTY SPACE IF ANY
	ZBLOCK	7743-.		/START FILLING IN	>


BCIF,	CIF CDF	00		/CHANGED TO APPROPRIATE FIELD
	JMP I	BJMP		/START USER PROGRAM
BLOC,	0			/LOCATION CNTR
BRLBTS,	0			/FLAG WORD
BGRPCT,	0			/GROUP COUNT
	IFNZRO	DF32		<
BWC,	0			/WORD COUNT REGISTER
BCA,	0			/CURRENT ADDRESS REGISTER
/THESE TWO ARE FOR THE DISC ONLY>
BWDCT,	0			/WORD COUNT
B7772,	7772			/-6 FOR WORD COUNT
B7756,	7756			/-22 FOR GROUP COUNT
BFLPTR,	BFILES			/POINTER TO PASSED FILES

	NOPUNCH			/NOTHING BEYOND THIS POINT IS REAL
	IFNZRO	DECTAPE	<
	ZBLOCK	7754-.		/SHOULD BE NULL	
BWC,	0			/WORD COUNT REGISTER
BCA,	0			/CURRENT ADDRESS REGISTER
/THESE TWO ARE FOR DECTAPE ONLY>


	ZBLOCK	7756-.
BJMP,	BERR			/DEFAULT ADDRESS TO START AT
BFILES,	ZBLOCK	17		/PASSED FILES
	IFNZRO	DECTAP+DF32	<
BLKNO,	0			/WHERE BLOCK NUMBERS GO
BWD,	0			/THE WORD BUFFER	>

	IFNZRO	LINCTAPE	<
	ZBLOCK	-.		/EMPTY SPACE FOR LINCTAPE	>
	ZROW=	.		/PIECE DE RESISTANCE (10 OHMS)
	ENPUNCH
	NOPUNCH
	*BFLPTR+1&177+LDRBEG
	ENPUNCH
/P?S MONITOR SYSTEM I/O ROUTINE LOADER

/CORE IMAGE OF BINARY FORMAT FILE
/THIS PAGE IS A GOOD EXAMPLE OF THE SIMILARITY
/TO CORE IMAGE OF THE P?S BINARY FORMAT
/THIS CODE IS LOADED VIA /I OPTION TO
/BINARY LOADER TO ALLOW DEVICE-INDEPENDENT
/SOFTWARE TO BE WRITTEN
/THE P?S FORMAT CONSISTS OF 22 GROUPS OF 7 WORDS
/PLUS 2 OR 3 WORDS (DEPENDING ON HARDWARE) FOR A 
/TOTAL OF 200 OR 201 WORDS PER BLOCK (STANDARD)
/EACH BLOCK IS INDEPENDENT OF THE OTHER BLOCKS
/LOGICALLY CONTAINED IN A FILE,SO THEORETICALLY
/THEY COULD BE DISASSOCIATED.THIS /I BLOCK
/SIMULATES THIS SITUATION AND CONSISTS OF A
/ONE BLOCK LONG FILE INTERNAL TO THE BINARY LOADER
/ITSELF,I. E. THE BINARY LOADER LOADS THIS BLOCK OVER ITSELF
/CAUSING THE CODE TO READ IN THE SYSTEM I/O ROUTINES
/AND THEN DISAPPEAR
/	BIT CONVENTIONS FOR BINARY FILES
/THE 7 WORD LONG GROUPS CONSIST OF 1 CONTROL WORD AFFECTING
/THE NEXT 6 WORDS,THE CONTROL WORD BEING DIVIDED INTO
/6 BIT PAIRS,EACH ONE OF WHICH AFFECTS THE ASSOCIATED 
/WORD IN THE 6 WORDS IN THE FOLLOWING MANNER:
/00	-	WORD OF CODE;LOAD IT AND ADVANCE ORIGIN
/01	-	END OF FILE;DON'T LOAD THIS WORD
/10	-	ORIGIN SETTING;USE THIS WORD FOR NEW ORIGIN
/11	-	FIELD SETTING;WORD IS A CDF INSTRUCTION;EXECUTE IT
/
/TYPICAL FILES HAVE A DEFAULT ORIGIN SETTING OF 200
/FOLLOWED BY ANYTHING AT ALL,USUALLY JUST STRAIGHT CODE
/SO THE FIRST WORD IS 4000 TO INDICATE THAT THERE IS ONLY AN
/ORIGIN SETTING FOLLOWED BY 5 WORDS OF CODE
/FURTHER LOADING OF THE SAME PAGE WOULD HAVE CONTROL WORDS OF 
/0000 IN THE NORMAL CASE,THEREFORE THE TYPICAL FILE IS 
/SOMEWHAT LESS THAN 6/7 OF THE EQUIVALENT CORE IMAGE FILE
/HOWEVER THE FILE HAS NEITHER A CHECKSUM NOR IS BLOCK ORIENTED
/ALLOWING MUCH LATITUDE IN PROGRAMMING OF PATCHES TO OTHER PROGRAMS
/INDEED THIS /I OPTION IS A PATCH TO THE BINARY LOADER
/AND COULD BE IMPLEMENTED BY A USER PROGRAM

/RESTRICTIONS OF THE /I OPTION
/ALL VERSIONS LIMIT THE FILE INDEX TO 14
/THAT IS ,ONLY 14 BINARY FILES MAY BE PASSED TO THE BINARY 
/LOADER IF THE /I OPTION IS USED;NORMALLY THE
/LIMIT IS 15.USING /I CAUSES THE 
/15TH FILE TO BE IGNORED
	*7400			/GENERATE ALL /I OPTIONS HERE
	IKNT=	1

	IFNZRO	DECTAPE+DF32	<


	4000+1400+200+40	/CONTROL WORD
	200			/*200 (DEFAULT)
	CDF	00		/FIELD 0
	200			/FIELD SETTING GENERATES *200
	IHDR=	.
	BFILES			/*BFILES
	NOPUNCH			/ESTABLISH
	*BFILES			/TRUE
	ENPUNCH			/ORIGIN >

	IFNZRO	DECTAPE		<
/GENERATE THE DECTAPE /I OPTION

BILOAD,	TAD	BCIF		/GET STARTING FIELD
	DCA	BICIF		/SAVE IT FOR LATER
	0000			/NEW CONTROL WORD
	NOPUNCH			/FOOL
	*.-1			/THE
	IKNT=	IKNT+1		/COUNT BACKUPS
	ENPUNCH			/ASSEMBLER
	TAD	B600		/REVERSE MOVE
	JMS	BWAIT		/REWIND THE TAPE
	TAD	B2577		/END ZONE ERROR + 2577 + 1 = SBOOT
	DCA	BCA		/TO CURRENT ADDRESS
	TAD	BAMT		/JUST RIGHT CONSTANT
	DCA	BWC		/TO WORD COUNT
	0000			/NEW CONTROL WORD
	NOPUNCH			/FOOL
	*.-1			/THE
	IKNT=	IKNT+1		/COUNT BACKUPS
	ENPUNCH			/ASSEMBLER
	TAD	B220		/READ FORWARD CONSTANT
	DTLA			/READ BLOCK ZERO
	DTSF			/WAIT
	JMP	.-1		/UNTIL DONE
BICIF,	CIF CDF	00		/USER FIELD GOES HERE
	JMP I	BJMP		/START AT USER ADDRESS
	1000+20+4+1		/NEW CONTROL WORD
	NOPUNCH			/WE WON'T
	*.-1			/GET FOOLED
	IKNT=	IKNT+1		/ONE,TWO THREE, FOUR ,FIVE,SIX,SEVEN,ALL GOOD CHILDREN GO TH HEVEN
	ENPUNCH			/AGAIN
BAMT,	BINBOOT-BWC		/DON'T OVERLAY WC + CA
	BEOF+1			/*BEOF+1
	JMP	BILOAD		/START OVERLAY
				/EOF HERE
	*.-BILOAD+IHDR+IKNT	/RESTORE ORIGIN
	ZBLOCK	. 177+1-.	/ZERO REST OF PAGE
/END OF DECTAPE VERSION		>
	IFNZRO	DF32		<

/GENERATE THE DF32 /I OPTION
BILOAD,	TAD	BOOTAD		/GET SYSIO-1
	DCA	BCA		/TO CURRENT ADDRESS
	0000			/NEW CONTROL WORD
	NOPUNCH			/FOOL
	*.-1			/THE
	IKNT=	IKNT+1
	ENPUNCH			/ASSEMBLER
	TAD	BAMT		/JUST RIGHT CONSTANT
	DCA	BWC		/TO WORD COUNT
	DEAL			/CLEAR EXTENDED BITS
	DMAR			/READ
	DFSC			/WAIT
	JMP	.-1		/'TIL DONE
	200+4+1			/NEW CONTROL WORD
	NOPUNCH			/WHO
	*.-1			/IS
	IKNT=	IKNT+1
	ENPUNCH			/NEXT
	JMP	BCIF		/START USER PROGRAM
BAMT,	BINBOOT-SCNVRT-7-1	/MAGIC CONSTANT
	BEOF+1			/*BEOF+1
	JMP	BILOAD		/START OVERLAY
	*.-BILOAD+IHDR+IKNT	/EOF HERE
	ZBLOCK	. 177+1-.	/ZERO REST OF PAGE
/END OF DF32 VERSION		>
	IFNZRO	LINCTAPE	<
/GENERATE THE LINCTAPE /I OPTION

	4000+1400+200+40	/CONTROL WORD
	200			/DEFAULT *200
	CDF	00		/FIELD 0
	200			/FIELD SETTINGS GENERATE *200
	7400			/*7400
	IHDR=	.		/SAVE . FOR LATER
	NOPUNCH			/ESTABLISH
	*7400			/TRUE
	ENPUNCH			/ORIGIN
BITEMP,	TAD I	BIJMP		/GET STARTING ADDRESS
	DCA	BIJMP		/SAVE IT OVER PTR TO IT
	0000			/NEW CONTROL WORD
	NOPUNCH			/FOOL
	*.-1			/THE
	IKNT=	IKNT+1
	ENPUNCH			/ASSEMBLER
	TAD I	BICIF		/GET STARTING FIELD
	DCA	BICIF		/SAVE THAT OVER IT'S OWN PTR
	LINC			/GOTO L...MODE
	LDA II			/LOAD AC IMMEDIATELY
	30			/AXO BITS FOR NOPAUSE,EXT. ADDRESSING
	AXO			/WATCH THAT AXO,EUGENE
	0000			/NEW CONTROL WORD
	NOPUNCH			/FOOL
	*.-1			/THE
	IKNT=	IKNT+1
	ENPUNCH			/ASSEMBLER
	LDA II			/IF NOT SOONER
	7600			/SYSIO
	TMA			/TO TAPE ADDRESS REGISTER
	RDC			/READ + CHECK
	0000			/BLOCK ZERO
	CLR			/CLEAR AC,LINK,MQ
	0000			/NEW CONTROL WORD
	NOPUNCH			/FOOL
	*.-1			/THE
	IKNT=	IKNT+1
	ENPUNCH			/ASSEMBLER
	PDP			/TO GOODY MODE (JB)
	TAD	0		/GET WORD BEFORE IT'S DESTROYED
	DCA	BITEMP		/SAVE IT
	TAD	BI100		/DONE FLAG BIT
	LMR			/WAIT FOR COMPLETION
	JMP	.-1		/'TIL DONE
	0000			/NEW CONTROL WORD
	NOPUNCH			/FOOL
	*.-1			/THE
	IKNT=	IKNT+1
	ENPUNCH			/ASSEMBLER
	CLA			/GET RID OF DONE BIT
	TAD	BITEMP		/RESTORE
	DCA	0		/LOST WORD
BICIF,	BCIF			/WILL BE CIF CDF INSTRUCTION
	JMP I	BIJMP		/START USER PROGRAM
BIJMP,	BJMP			/WILL BE STARTING ADDRESS
	1000+40+1		/NEW CONTROL WORD
	NOPUNCH
	*.-1
	IKNT=	IKNT+1
	ENPUNCH
BI100,	0100			/STD CONSTANT
	BWAIT			/*BWAIT
	NOPUNCH			/WE DIDN'T
	*BWAIT			/GET FOOLED
	ENPUNCH			/AGAIN !!
	BITEMP			/PTR TO /I
	BEOF+1			/*BEOF+1
	JMP I	BWAIT		/START /I
	*.-BITEMP+IHDR+IKNT	/EOF HERE
	ZBLOCK	. 177+1-.	/ZERO REST OF PAGE
/END OF LINCTAPE /I OPTION	>
