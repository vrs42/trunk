DPRINT, 0                       /DUMP A BLOCK ROUTINE
        JMS I   FOURLF          /CLOVER
        JMS I   DSCRIBE         /TELL THEM
        DMSG3                   /BLOCK =
        TAD I   DBLK            /GET WHICH ONE
        JMS I   DUNPAK          /PRINT IT
        JMS I   DCRLF           /DO A CR,LF
        TAD     DL12            /DO AN
        JMS     DTYPE           /EXTRA LF
        LAS                     /GET SWITCHES
        AND     DL170           /JUST ADDRESS BITS
        DCA     DADDR           /SAVE IT
DNXTLN, TAD     DL7770          /SET UP
        DCA     DLOOP           /LINE COUNT
DAZAP1, NOP                     /LAS IF /A
        AND     DL7600          /JUST PAGE BITS
        TAD     DADDR           /PLUS ADDRESS BITS
        JMS I   DUNPAK          /PRINT IT
        JMS I   DSCRIBE         /PRINT
        DBLANKS                 /SOME BLANKS
        TAD     DADDR           /\
        TAD I   DBUFF           / >NOW SETUP POINTER TO DUMP LINE
        DCA     DWORD           //
DAGAIN, KSF                     /SKIP ON KEY STRUCK
        JMP     DODUMP          /JUMP ON NO SUCH THING
        TAD     DPRINT          /SET UP
        DCA I   DTTYIN          /RETURN ADDRESS
