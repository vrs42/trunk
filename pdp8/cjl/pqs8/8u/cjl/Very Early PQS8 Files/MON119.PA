        IFNZRO  200-.   <
        /COMPLAIN ABOUT BOTCHED ASSEMBLY
        **** ERROR **** UNABLE TO ASSEMBLE
        /       $       >
XLNOPRT,JMP I   XLINENO         /FOR GENASYS
        DCA     XLINENO         /SAVE NUMBER
        TAD     BEGLIN          /\
        DCA     PUTBASE         / >POINT TO INPUT BUFFER
        DCA     PUTNDX          //
        TAD     L7774           /INITIALIZE COUNT TO
        DCA     TEMCNT          /PRINT FOUR DIGITS
        TAD     L7440           /INITIALIZE ZERO SWITCH
        DCA     ZEROSW          /TO A SZA
DIVLUP, TAD     TEMCNT          /COPY THE
        DCA     TEMP1           /COUNT
        CMA                     /ASSUME RADIX^0
        DCA     TSTINT          /SAVE IT
        ISZ     TEMP1           /DO WE RAISE IT TO A HIGHER POWER?
        SKP                     /YES...
        JMP     PRTDIG          /NO...NOW USE IT
        TAD     RADXSW          /\
        DCA     NEWCAT          / \
        TAD     TSTINT          /  >MULTIPLY BY RADIX
        ISZ     NEWCAT          / /
        JMP     .-2             //
        JMP     DIVLUP+3        /SEE IF WE RAISE AGAIN
PRTDIG, TAD     XLINENO         /GET NUMBER
        CLL                     /CLEAR MAGIC LINK
        TAD     TSTINT          /\
        SNL                     / \
        JMP     .+3             /  >DIVIDE BY RADIX^N
        ISZ     TEMP1           / /
        JMP     .-5             //
        CIA                     /\
        TAD     TSTINT          / >RESTORE REMAINDER
        CIA                     //
        DCA     XLINENO         /SAVE AS NEW NUMBER
        TAD     TEMP1           /GET QUOTIENT
ZEROSW, SZA                     /TEST FOR LEADING ZEROS
        JMP     .+4             /JUMP IF SIGNIFIGANT DIGIT
        TAD     L40             /\
        JMS I   PRINT           / >BLANK LEADING ZEROS
        JMP     .+5             //
        TAD     L60             /ADD "0-200
        JMS I   PINSERT         /NOW INSERT INTO BUFFER
        TAD     NOPCON          /TURN OFF LEADING
        DCA     ZEROSW          /ZERO TESTER
        ISZ     TEMCNT          /ANY DIGITS LEFT?
        JMP     DIVLUP          /YES...GO GET EM
        TAD     L37             /TAKE A TAB AND
        JMS I   PINSERT         /INSERT IT
        JMP I   XLNOPRT         /RETURN
XLINENO,GENASYS                 /FOR GENASYS PURPOSES ONLY
        JMS     TSTINT          /GO FIND A DIGIT
        JMP I   XLINENO         /NONE FOUND JUST RETURN
LINUM1, DCA     XLNOPRT         /SAVE IT
        ISZ     GETNDX          /BUMP INDEX
        JMS     TSTINT          /TRY TO FIND ANOTHER
        JMP     LINUM2          /NO CAN DO
        DCA     TEMP1           /SAVE TEMPORARILY
        TAD     RADXSW          /SETUP TO MULTIPLY
        DCA     TEMCNT          /BY RADIX
        CLL                     /CLEAR MAGIC LINK
        TAD     XLNOPRT         /\
        SZL                     / \
        JMP I   WHAT            /  >MULTIPLY BY RADIX & TEST FOR OVERFLOW
        ISZ     TEMCNT          / /
        JMP     .-4             //
        TAD     TEMP1           /ADD DIGIT
        SNL                     /TEST FOR OVERFLOW
        JMP     LINUM1          /IF NONE THEN GET NEXT DIGIT
        JMP I   WHAT            /ERROR IF OVERFLOWED
LINUM2, JMS I   TSPACE          /IS CHAR A BLANK OR TAB
        TAD     XLNOPRT         /GET NUMBER
        CMA                     /TEST FOR 7777
        SNA                     /SKIP IF NOT
        JMP I   WHAT            /ERROR IF IT IS
        STL CMA                 /RESTORE NUMBER   SET LINK=1
        ISZ     XLINENO         /BUMP RETURN ADDRESSS TO DO A
        JMP I   XLINENO         /SKIP RETURN
        
TSTINT, 0
        JMS I   GETHAF          /GET THE CHARACTER
        TAD     L7720           /TEST LOWER BOUND
        SPA                     /PASSES
        JMP     .+4             /FAILS
        TAD     RADXSW          /TEST UPPER BOUND
        SPA                     /FAILS
        JMP     .+3             /PASSES
        CLA CLL                 /ZERO AC & LINK
        JMP I   TSTINT          /FAIL RETURN
        CIA                     /\
        TAD     RADXSW          / >RESTORE DIGIT
        CIA                     //
        ISZ     TSTINT          /BUMP FOR
        JMP I   TSTINT          /SKIP RETURN
RUN,    JMS I   NAME            /LOOK FOR NAME
        JMP I   WHAT            /BADNESS IF NONE FOUND
RUNGO,  TAD I   PSUNIT          /SAVE PRESENT
        DCA     OLDUNIT         /TAPE UNIT
        JMS I   TUNIT           /LOOK FOR :UNIT
NOPCON, NOP                     /NOP
        TAD     RADXSW          /SAVE OLD
        DCA     OLDRAD          /RADIX SWITCH
        STA                     /TURN ON 
        DCA     SWAPSW          /RELOAD FLAG
        JMS I   SYSIN           /\
RUNPTR, SWAPIN                  / \READ SYSTEM CATALOG
        -SWPLEN                 / /INTO CORE
        SYSCAT                  //
        TAD     L7              /SET BUMP FACTOR
        DCA     TCNT1           /TO SEVEN WORDS
        DCA     LOOKSW          /ZERO LOOK SWITCH
        TAD     RUNPTR          /POINT TO SYSTEMS CATALOG
        JMS I   LOOKUP          /LOOK FOR NAME
        CLA                     /IGNORE BLOCK NUMBER
        TAD I   XR1             /FETCH STARTING BLOCK NUMBER
        DCA I   PSBLOK          /STORE IT
        TAD I   XR1             /GET GLOP WORD
        DCA     TEMP1           /SAVE IT
        TAD     TEMP1           /\
        AND     L77             / \EXTRACT LENGTH &
        CIA                     / /STORE IT
        DCA I   PSNUM           //
        TAD     TEMP1           /\
L60,    AND     L7700           / >DO SAME FOR CORE ADDRESS
        DCA I   PSCORE          //
RUNSAV, SKP CLA                 /JUMP TO SECOND PART OF RUN COMMAND
        3000                    /\
        -20                     / \WILL DO A SAVE $ IF
        40                      / /ACTIVATED BY INITSW
        JMP I   .+1             //
RUNST,  XGLINE
        PAGE
EDITOR, DCA     TEMP1           /SAVE INITIALIZE MODE
        TLS                     /SET TTY FLAG
        JMS I   PR6BIT          /DO A CRLF FOR NEATNESS
        ISZ     TEMP1           /SKIP IF SCRATCH ONLY MODE
        JMP     SYS+4           /ELSE DO A SYS
        
NEWBUF, TAD     BUFBEG          /\
        DCA I   FIZZ1           / \RESET THE TWO
        TAD     BUFINFO         / /FILE POINTERS
        DCA I   FIZZ2           //
        TAD     BUFBEG          /\
        DCA I   BUFINFO         / \CREATE AN INITIAL
        CMA                     / /LINE INFO ENTRY
        DCA I   BUFEND          //
        JMS     CLEAR           /CLEAR BUFFER
PLRTN,  TAD     L7              /DING-DONG
        JMS I   PRINT           /AVON CALLING
        JMP I   PBEGIN          /BEGIN TO DO SOME WORK
        
SCRATCH,JMS I   GETHAF          /\
        SNA CLA                 / >IF NO PARMS THEN WHOLE SCRATCH
        JMP     NEWBUF          //
        JMS I   LIMITS          /ELSE LOOK FOR VALID LIMITS
        JMP I   WHAT            /BARF IF INVALID
        JMS     REMOVE          /DELETE SPECIFIED LINES
        JMP I   PBEGIN          /NOW RETURN
        
SYS,    JMS I   TUNIT           /CHECK FOR A :UNIT
        NOP                     /NOP
        STA                     /FUDGE TO PREVENT A
        DCA     TEMP1           /SCRATCH FROM OCCURING
        JMS I   PLODCAT         /READ CATALOG INTO USER CATALOG AREA
        ISZ     TEMP1           /SKIP IF NOT TO DO A SCRATCH
        JMP     NEWBUF          /ELSE GO DO A SCRATCH
        JMP I   PBEGIN          /RETURN

SWAPIT, TAD     OLDUNIT         /RESTORE
        DCA I   PSUNIT          /TAPE UNIT
        TAD     OLDRAD          /RESTORE
        DCA     RADXSW          /RADIX
        JMS I   SYSIN           /\
        SWAPIN                  / \RESTORE SWAPPED
        -SWPLEN                 / /PART OF MONITOR
        SWPMON                  //
        DCA     SWAPSW          /CLEAR SWAP SWITCH
        JMP     SYS+2           /DO A SYS

MOVE,   0
        DCA     TCNT1           /SAVE NUMBER OF WORDS TO MOVE
        STA                     /\
        TAD I   MOVE            / \SETUP AUTO-INDEXED
        ISZ     MOVE            / /FROM POINTER
        DCA     XR1             //
        STA                     /\
        TAD I   MOVE            / \SETUP AUTO-INDEXED
        ISZ     MOVE            / /TO POINTER
        DCA     XR2             //
        TAD I   XR1             /FETCH
        DCA I   XR2             /STORE
        ISZ     TCNT1           /TEST
        JMP     .-3             /LOOP
        JMP I   MOVE            /RETURN
        
CLEAR,  0
        TAD I   FIZZ2           /\
        CIA                     / \
        TAD I   FIZZ1           /  \COMPUTE AND TEST LENGTH
        SNA                     /  /OF UNUSED SECTION
        JMP I   CLEAR           / /
        DCA     TCNT1           //
        CMA                     /\
        TAD I   FIZZ1           / >SETUP POINTER
        DCA     XR1             //
        DCA I   XR1             /\
        ISZ     TCNT1           / >CLEAR IT
        JMP     .-2             //
        JMP I   CLEAR           /RETURN
REMOVE, 0
        NL7776                  /\
        TAD     UPLIM           / >POINTER TO LINE INFO AFTER UPPER LIMIT
        DCA     TPTR1           //
        TAD I   TPTR1           /\
        DCA     REMOVP          / \SET UP POINTERS TO
        TAD I   LOWLIM          / /FROM AND TO POINTERS
        DCA     REMOVP+1        //
        TAD I   FIZZ1           /\
        CMA                     / >COMPUTE LENGTH OF MOVE
        TAD I   TPTR1           //
        JMS     MOVE            /\
REMOVP, 0                       / >MOVE THE TEXT DOWN
        0                       //
        TAD     XR2             /RESET FILES NEXT
        DCA I   FIZZ1           /LINE POINTER
        TAD     UPLIM           /\
        CIA                     / \
        TAD I   FIZZ2           /  >LINE INFO MOVE COUNT
        STL RAR                 / /
        DCA     TCNT1           //
        TAD I   TPTR1           /\
        CIA                     / \COMPUTE RELOCATION
        TAD I   LOWLIM          / /FACTOR FOR INFOS
        DCA     TEMP1           //
REMOV1, TAD I   TPTR1           /FETCH POINTER TO LINE
        TAD     TEMP1           /ADD RELOCATION FACTOR
        DCA I   LOWLIM          /RESTORE POINTER TO LINE
        ISZ     TPTR1           /BUMP FROM POINTER
        ISZ     LOWLIM          /BUMP TO POINTER
        TAD I   TPTR1           /FETCH LINE NUMBER
        DCA I   LOWLIM          /RESTORE LINE NUMBER
        NL7775                  /\
        TAD     TPTR1           / >ADJUST FROM POINTER
        DCA     TPTR1           //
        NL7775                  /\
        TAD     LOWLIM          / >ADJUST TO POINTER
        DCA     LOWLIM          //
        ISZ     TCNT1           /TEST FOR COMPLETION AND
        JMP     REMOV1          /JUMP BACK
        NL0002                  /\
        TAD     LOWLIM          / >RESET FILES NEXT INFO POINTER
        DCA I   FIZZ2           //
        JMS     CLEAR           /CLEAR UNUSED SECTION
        JMP I   REMOVE          /RETURN

EDIT,   JMS I   SYSIN           /\
        EDITIT                  / \SWAP IN EDIT COMMAND
        -1                      / /FIRST TIME ONLY
        14                      /
        JMP I   .-3             /USE IT TO FIX ITSELF UP
/
RRUN,   JMS I   SYSIN           /\
BUFBEG, 3000                    / \
        -2                      /  >SWAP IN "RUN" COMMAND AND BRANCH TO IT
        RUNBLK                  / /
        JMP I   BUFBEG          //
        PAGE
HALT,   HLT                     /HALT
        
BEGIN,  7600                    /CLEAR AC
        TAD     SWAPSW          /\
        SZA CLA                 / >BYPASS IF SWAP SWITCH IS OFF
        JMP I   PSWAP           //
        JMS I   GLINE           /GET A LINE OF INPUT
BEGIN1, JMS I   LINENO          /IS THERE A LINE NUMBER?
        JMP     COMAND          /NOPE... ITS A COMMAND
        DCA     LNO             /YES... SAVE LINE NUMBER
        TAD     SLINUM          /\
        TAD     SEQSW           / >INCREMENT LINE NUMBER
        DCA     SLINUM          //
        TAD     LNO             /GET LINE NUMBER
        JMS I   LNSRCH          /DOES IT EXIST?
        JMP     NEWLIN          /NO... CREATE IT
        DCA     LOWLIM          /\
        TAD     LOWLIM          / >YES... SETUP DELETION LIMITS
        DCA     UPLIM           //
        JMS I   PREMOV          /DELETE LINE
        SKP                     /SKIP
NEWLIN, DCA     UPLIM           /SET UPLIM
        TAD     GETNDX          /\
        CIA                     / >COMPUTE LENGTH OF TEXT
        TAD     PUTNDX          //
        SNA                     /SKIP IF SOMETHING THERE
        JMP     BEGIN           /IF NULL THEN IGNORE
        TAD     L2              /FUDGE FOR CR
        CLL RAR                 /DIVIDE BY TWO TO GET
        DCA     TEMP1           /LENGTH IN WORDS
        NL0002                  /TWO INFO WORDS
        TAD     TEMP1           /PLUS LENGTH
        TAD I   FIZZ1           /\
        CMA CLL                 / >TEST IF IT WILL FIT
        TAD I   FIZZ2           //
        SZL CLA                 /SKIP IF NO ROOM
