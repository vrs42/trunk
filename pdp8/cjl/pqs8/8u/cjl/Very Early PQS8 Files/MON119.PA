/THE NEW IMPROVED P?S MONITOR





/THIS SYSTEM IS DEDICATED TO THE DECTAPE VERSION OF THE DECDISK MONITOR SYSTEM
/WITHOUT WHICH IT DOES NOW AND ALWAYS HAS RUN
        
        
/       EQUATED SYMBOLS
        
        
        AXO=    0001            /AC TO EXTENDED OPERATIONS BUFFER
        BCO=    1640            /BIT COMPLEMENT
        BFILES= 7757            /FIRST FILE PASSED TO BINARY LOADER HERE
        BINADR= 20              /DEFAULT BINARY SCRATCH AREA
        BINBLK= 110             /BLOCK NUMBER OF BIN SYSTEM
        BINLEN= 12              /TOTAL BINARY LOADER LENGTH 
        CATADR= 7000            /USER CATALOG ADDRESS
        CLR=    0011            /CLEAR AC,LINK,MQ
        DIR=    15              /FIRST OF TWO USER DIRECTORY BLOCKS
        DTLA=   DTCA DTXA       /SOME ASSEMBLERS DON'T HAVE THIS
        DUMBLK= 102             /DUMP SYSTEM BLOCK
        DUMLEN= 3               /DUMP SYSTEM LENGTH
        EDBLK=  74              /BATCH EDIT SYSTEM BLOCK
        EDLEN=  6               /TOTAL EDIT LENGTH
        EDSLEN= 2               /EDIT SYSTEM LENGTH
        ERLEN=  1               /EDIT RECOVERY LENGTH
        FILBEG= 3000            /FILE BUFFER
        FILSIZ= 20              /LENGTH OF FILE
        II=     20              /LINC MODE I
        IOB=    0500            /I/O BUS CONTROL
        LCR=    6152            /LOAD LINCTAPE HARDWARE CONTROL REGISTER
        LDA=    1000            /LINC MODE LOAD AC
        LINC=   6141            /ENTER LINC (SUPER) MODE
        LMR=    6151            /LOAD MAINTANENCE REGISTER
        LZE=    0452            /SKIP IF LINK ZERO
        NL0001= CLA IAC         /SET AC TO ONE
        NL0002= CLA CLL CML RTL /SET AC TO TWO
        NL0004= CLA CLL IAC RTL /SET AC TO FOUR (FOR PDP-12 ONLY)
        NL2000= CLA CLL CML RTR /SET AC TO TWO THOUSAND
        NL3777= CLA CLL CMA RAR /SET AC TO THREE SEVEN SEVEN SEVEN
        NL4000= CLA CLL CML RAR /SET AC TO FOUR THOUSAND
        NL7775= CLA CLL CMA RTL /SET AC TO SEVEN SEVEN SEVEN FIVE
        NL7776= CLA CLL CMA RAL /SET AC TO SEVEN SEVEN SEVEN SIX
        PDP=    0002            /GOTO PDP-8 (GOODY) MODE
        RCC=    RFC RRB         /NEW-FANGLED READER DEFINITION
        RDC=    0700            /READ AND CHECK A BLOCK
        RDE=    0702            /READ A BLOCK
        RUNBLK= 72              /RUN COMMAND BLOCK
        RUNCOR= 3600            /RUN COMMAND GENERATION ADDRESS
        SWAPIN= 1200            /ADDRESS TO SWAP CODE INTO
        SWPLEN= 2               /NUMBER OF BLOCKS(PAGES) TO SWAP
        SWPMON= 6               /EQUALS [SWAPIN/(2^7)]+1
        SYSCAT= 70              /SYSTEM CATALOG BLOCK
        TAC=    0003            /TAPE AC TO REAL AC
        TMA=    0023            /AC TO TAPE MEMORY ADDRESS

        VERSION=05              /VERSION # OF SYSTEM
/       SYSGEN PARAMETER AREA
/SETTING        DECTAPE=1       GENERATES A DECTAPE SYSTEM (TC01-TC08)
/SETTING        FLOPPY= 1       GENERATES A FLOPPY DISC SYSTEM (1-4 UNITS)
/SETTING        DF32=   1       GENERATES A DF32 SYSTEM (1-4 PLATTERS)
/SETTING        LINCTAPE=1      GENERATES A LINCTAPE SYSTEM (TC12)
/FOR THE PDP-12 (128 OR 129 WORDS/BLOCK REQUIRED)
/THE TC12-F OPTION CAN BE USED TO TRANSFER DATA BETWEEN TAPE SYSTEMS 
/EITHER LINCTAPE TO DECTAPE OR VICE VERSA
/(SEE DOCUMENTATION OF THE PRTC12-F PROGRAM ELSEWHERE)
/
/
/       INSERT SYSGEN PARAMETER HERE
/
/
        DECTAPE=1               /GENERATE A DECTAPE SYSTEM
/
/
        IFNDEF  DF32            <DF32=  0>
        IFNDEF  FLOPPY          <FLOPPY=0>
        IFNDEF  LINCTAPE        <LINCTAPE=0>
        IFNDEF  DECTAPE         <DECTAPE=0>
/
/
        IFZERO  DECTAPE+LINCTAPE+DF32+FLOPPY    <
        DECTAPE=1               /DEFAULT TO DECTAPE>
        IFNZRO  DECTAPE+FLOPPY+LINCTAPE+DF32-1  <
        /COMPLAIN ABOUT BOTCHED SYSGEN
        **** ERROR **** INCOMPATIBLE SYSGEN PARAMETERS
        /       $               /TERMINATE ASSEMBLY>
/       USER FILE SPECIFICATION
/GIVE THE NUMBER OF USER FILES DESIRED
/MAXIMUM IS 84 (NOT INCLUDING "$" FILES
/ALL PHYSICAL SPACE REMAINING AFTER USER CATALOG
/WILL BE USED FOR THE EXTENDED CATALOG
        DECIMAL
/       INSERT # OF USER FILES HERE
/
/
        UFILES= 84              /GENERATE MAXIMUM SIZE USER CATALOG
/
/
        OCTAL
        IFNDEF  UFILES  <UFILES=124     /MAXIMUM>
        IFNZRO  124-UFILES&4000 <
        /COMPLAIN ABOUT BOTCHED SYSGEN
        **** ERROR **** TOO MANY USER FILES
        /       $               /TERMINATE ASSEMBLY>





/       BLOCK LAYOUT OF THE  P ? S  STARTER SYSTEM



/       BLOCK   GENERATION CORE LOADING CORE    MAJOR FUNCTION
/       -----   --------------- ------------    ----- --------


/       0       6600-6777       7600-7777       BOOTSTRAP, SYSTEM I/O, ETC.
/       1-13    0000-2577       0000-2577       IN CORE MONITOR
/       14      2600-2777       2600-2777       THE "EDIT" COMMAND
/       15-16   1000-1377       7000-7377       USER CATALOG
/                              (3000-3377)
/       17         N.A.         3400-3577       RESERVED I/O BLOCK FOR THE TD8/E SYSTEM
/       20-37   1000-1777 (4X)     N.A.         DEFAULT BINARY FILE
/       40-57   1000-1777 (4X)     N.A.         "$" SOURCE FILE
/       60-67      N.A.            N.A.         SYSTEM SCRATCH AREA
/       70      3000-3127       1200-1377       SYSTEM CATALOG
/              (1000-1127)
/       71      3400-3577       1400-1577       THE "R" COMMAND
/       72      3600-3777       3000-3177       THE "RUN" COMMAND
/       73      1000-1177       3200-3377       EXTENDED USER'S (SYSTEMS PROGRAMMER'S) CATALOG
/       74      2400-2527       2400-2577       MODIFIED COMMAND TABLE + BATCH
/              (3000-3127)
/              +3130-3177
/       75      3200-3377       2600-2777       EDIT/BATCH SYSTEM
/       76         N.A.         2600-2777       ACTIVE BATCH SAVE AREA
/       77      6314-6377       3000-3063       BATCH RECOVERY ROUTINE
/                              (3064-3177 N.A.)
/       100-101    N.A.         3200-3577       SAVE AREA FOR ACTIVE COPY OF SYSIO,PAGE ZERO ETC.
/       102-104 7000-7577       0000-0577       THE DUMP SYSTEM
/       105        N.A.         0600-0777       RESERVED FOR EXTENDED DUMP OVERLAY
/       106-107    N.A.            N.A.         RESERVED FOR PRINT COMMAND OVERLAY
/       110-121 4200-6577       0000-2577       BINARY LOADER
/       122-127    N.A.            N.A.         FIRST FREE BLOCKS FOR NEW SYSTEMS
/       130        N.A.            N.A.         FIRST FREE BLOCK FOR USER CATALOG
        *0
        VERSION                 /INTERNAL VERSION NUMBER OF MONITOR

        *3



/MONITOR INITIALIZATION PARAMETER (INITSW)
/
/
/       BITS<0-1>       INITIAL TTY MODE
/                       00 IS TTY 3
/                       01 IS TTY 0
/                       10 IS TTY 5
/                       11 TABS PRINT AS ONE TAB WITH NO TIMEOUT
/       BITS<2-3>       PUNCH STATUS
/                       00 IS TTY 3
/                       01 IS TTY 0
/                       10 IS TTY 5
/                       11 TABS PUNCH AS ONE TAB WITHOUT NULL
/       BIT <4>         INITIAL LOADING STATUS
/                       0 = NO LOAD
/                       1 = LOAD $
/       BIT <5>         INITIAL SAVING STATUS
/                       0 = NO SAVE
/                       1 = SAVE $
/       BIT <10>        INITIAL RADIX
/                       0 = DECIMAL
/                       1 = OCTAL
/       BIT <11>        INITIAL ECHO STATUS
/                       0 = ECHO ON
/                       1 = ECHO OFF

INITSW, 1400                    /CHANGE THIS TO FIT YOUR INSTALLATION
                                /USED WHEN BOOTSTRAPPING

/       DEFAULT FILE NAME
FNAME,  7777                    /??
        7777                    /??
        7777                    /??


L3,     3                       /USED TO TERMINATE FNAME;MUST BE 77 OR LESS
