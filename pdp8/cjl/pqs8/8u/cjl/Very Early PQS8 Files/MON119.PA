        TAD     DADDR           /\
        TAD     DL7600          / \
        SZA CLA                 /  >RETURN IF DONE,ELSE DO NEXT LINE
        JMP     DNXTLN          / /
        JMP I   DPRINT          //
        ZBLOCK  .+177&7600-.
DSTART, KCC                     /CLEAR TO START
        TSF                     /KERCHUNK IF
        TLS                     /NECESSARY
        JMS I   FOURLF          /CLOVER
        JMS I   DSCRIBE         /ASK FOR
        DMSG1                   /MODE ?
        JMS I   DTTYIN          /GET A CHAR
        TLS                     /ECHO IT
        AND     DL77            /MASK TO 6-BIT
        CLL RTL                 /\
        RTL                     / >SHIFT TO LEFT HALF
        RTL                     //
        DCA     DREWND          /SAVE IT
        JMS I   DTTYIN          /GET ANOTHER CHAR
        TLS                     /ECHO IT
        AND     DL77            /TRIM IT
        TAD     DREWND          /ADD PREVIOUS
        CIA                     /INVERT FOR TESTING
        DCA     DREWND          /SAVE FOR LATER
        JMS I   DTTYIN          /\
        TLS                     / \
        TAD     DL7763          /  >THROW AWAY CHAR'S 'TIL CR
        SZA CLA                 / /
        JMP     .-4             //
        TAD     DL7774          /\
        DCA     GETPUT          / \SET UP FOR
        TAD     MODES           / /COMMAND SEARCH
        DCA     CXR             //
        TAD I   CXR             /\
        TAD     DREWND          / \
        SNA CLA                 /  \
        JMP     FNDCOM          /   >SEARCH FOR COMMAND
        ISZ     CXR             /  /
        ISZ     GETPUT          / /
        JMP     .-6             //
        JMP     DSTART          /RESTART ON BAD COMMAND
 
FNDCOM, TAD I   CXR             /\
        DCA     DREWND          / >BRANCH TO COMMAND
        JMP I   DREWND          //
DUMP,   JMS     GETBLK          /ASK FOR A BLOCK
        JMS     GETNUM          /GET A NUMBER
        CIA                     /NEGATE FOR COUNT
        SMA                     /ONLY 1-3777 BLOCKS AT A TIME
        JMP     DUMP+1          /JUMP BACK IF 0 OR 4000 OR GREATER
        DCA     GETNUM          /SAVE AS COUNTER
        STA CLL                 /1 BLOCK ONLY,INDICATE READ IN LINK
        JMS     GETPUT          /GET A BLOCK
        JMS     DPRINT          /PRINT IT
        ISZ     DBLOCK          /BUMP BLOCK NUMBER
        ISZ     GETNUM          /GO BACK
        JMP     .-5             /'TIL ALL IS DUMPED
        JMP     DSTART          /GET NEXT COMMAND
/
TRANS,  JMS     GETBLK          /ASK FOR FIRST BLOCK
        JMS     GETNUM          /GET A NUMBER
        SPA SNA                 /1-3777 ONLY
        JMP     .-2             /BAD ARG,GET ANOTHER
        TAD     DLIMIT          /-(MAXBLKS+1)
        SMA                     /SKIP IF 1-MAXBLKS
        JMP     .-5             /BAD ARG,GET ANOTHER
        CLL CIA                 /CLEAR LINK AND INVERT
        TAD     DLIMIT          /RESTORE ARG,LINK IS STILL CLEAR
        JMS     GETPUT          /GET SOME BLOCKS
        JMS     DREWND          /REWIND THE TAPE
        JMS I   DSCRIBE         /TELL THEM
        DMSG2                   /TO SWITCH
        JMS     GETBLK          /GET TO: BLOCK
        STL                     /INDICATE WRITE
        JMS     GETPUT          /WRITE SAME NUMBER OF BLOCKS
        JMP     DSTART          /RESTART
/
GETPUT, 0                       /GET OR PUT ROUTINE
        SZL                     /LINK ON = WRITE
        JMP     PUTIT           /SO WRITE ON
        DCA     DNMBLKS         /SAVE NUMBER OF BLOCKS IF READ
        IAC                     /INCREMENT INSTRUCTION
PUTIT,  TAD     DJMSIW          /GET A JMS I DWRITE INSTRUCTION
        DCA     .+1             /PUT IN LINE
        HLT                     /EXEC SYSIO CALL
DMPBUF, DBUFFR                  /CORE ARG
DNMBLKS,-1                      /NUMBER OF BLOCKS
DBLOCK, 0                       /PUT IN BY GETBLK
        JMP I   GETPUT          /RETURN
ZAP,    JMS     GETBLK          /GET BLOCK NUMBER
        STA CLL                 /1 BLOCK READ
        JMS     GETPUT          /INTO BUFFER
        JMS     DPRINT          /DISPLAY STUFF IN IT
ZAPIN,  JMS     GETNUM          /GET A POTENTIAL ADDRESS
        SPA                     /DO IT IF POSITIVE
        JMP     ZAPDUN          /TERMINATE IF NEGATIVE
        TAD     DL7600          /CHECK FOR BAD POSITIVE ADDRESS
        SMA                     /SKIP IF NOT
        JMP     .-5             /GO GET ANOTHER
        TAD     DL200           /RESTORE OFFSET
        TAD I   DBUFF           /ADD ON BASE
        DCA     GETBLK          /SAVE IT
        TAD     DL40            /PRINT
        JMS     DTYPE           /A BLANK
        JMS I   DINPUT          /GET A NUMBER
        JMP     ZAPIN           /BAD INPUT
        DCA I   GETBLK          /ZAP IT
        TAD I   DFUDGE          /WAS IT
        TAD     DL7763          /TERMINATED BY A C. R. ?
        SNA CLA                 /SKIP IF NO
        JMP     ZAPIN           /DO ANOTHER
        ISZ     GETBLK          /BUMP UP ZAP ADDRESS
        TAD     GETBLK          /GET IT
        AND     DL177           /JUST ADDR BITS
        JMP     ZAPIN+1         /GET NEXT
ZAPDUN, CLA STL                 /INDICATE WRITE
        JMS     GETPUT          /WRITE IT OUT
        JMP     DSTART          /NEXT COMMAND
/
GETBLK, 0                       /GET A BLOCK NUMBER
        JMS I   DCRLF           /NEATLY PLEASE
        JMS I   DSCRIBE         /TELL THEM
        DMSG3                   /BLOCK =
        JMS I   DINPUT          /GET A NUMBER
        JMP     .-4             /BAD INPUT, RETRY
        SPA                     /SKIP IF GOOD
        JMP     .-6             /0-3777 ONLY
        DCA     DBLOCK          /PUT IN GETPUT CALL
        JMP I   GETBLK          /RETURN
/
GETNUM, 0                       /GET A NUMBER ROUTINE
        CLA                     /JUST IN CASE
        JMS I   DCRLF           /NEATLY
        JMS I   DSCRIBE         /TELL THEM
        DMSG4                   /NUMBER =
        JMS I   DINPUT          /GET AN INPUT NUMBER
        JMP     .-4             /BAD INPUT, RETRY
        JMP I   GETNUM          /RETURN
        ZBLOCK  .+177&7600-.
XDSCRIBE,0                      /PRINT A MESSAGE ROUTINE
        TAD I   XDSCRIBE        /GET ARG
        DCA     DWORD           /SAVE IT
        TAD I   DWORD           /GET PAIR
        AND     DL7700          /JUST LEFT HALF
        SNA CLA                 /RETURN ON
        JMP I   XDSCRIBE        /ZERO WORD
        JMS     DP2CH           /PRINT GOOD WORD
        JMP     XDSCRIBE+3      /TRY TO PRINT AGAIN
/
DP6CH,  0                       /PRINT 6-BIT ROUTINE
        TAD     DL40            /ADD ON CONTROL BIT
        AND     DL77            /THROW AWAY EXCESS
        TAD     DL40            /CONVERT TO 7-BIT
        JMS     DTYPE           /PRINT IT
        JMP I   DP6CH           /RETURN
/
XFORLF, 0                       /SPACE DOWN ROUTINE
        TAD     DL7774          /SETUP FOR
        DCA     DP6CH           /4 LINES
        TAD     DL15            /C. R.
        JMS     DTYPE           /PRINT THAT FIRST
        TAD     DL12            /L. F.
        JMS     DTYPE           /PRINT IT
        ISZ     DP6CH           /DONE YET ?
        JMP     .-3             /NO,GO BACK
        JMP I   XFORLF          /YES,RETURN
/
XDCRLF, 0                       /CR LF ROUTINE
        TAD     DL15            /C. R.
        JMS     DTYPE           /PRINT IT
        TAD     DL12            /L. F.
        JMS     DTYPE           /PRINT IT
        JMP I   XDCRLF          /RETURN
DP2CH,  0                       /PRINT TWO
        TAD I   DWORD           /GET FIRST WORD
        RTR                     /\
        RTR                     / >MOVE DOWN PASSED PAIR
        RTR                     //
        JMS     DP6CH           /PRINT 6-BIT
        TAD I   DWORD           /GET IT AGAIN
        JMS     DP6CH           /PRINT OTHER HALF
        ISZ     DWORD           /FOR NEXT TIME
        JMP I   DP2CH           /RETURN
/
XDFUDGE,0                       /ASCII OUTPUT ROUTINE
        TAD     DADDR           /GET REL OFFSET
        TAD I   DBUFF           /PLUS BUFFER ADDRESS
        DCA     DWORD           /SAVE IT
        TAD     DL7770          /-10
        DCA     DLOOP           /TO COUNT
DFUDG1, JMS     DP2CH           /PRINT PAIR AND ADVANCE
        ISZ     DADDR           /BUMP ADDRESS
        ISZ     DLOOP           /DONE 10 YET ?
        JMP     DFUDG1          /NO,GO BACK
        JMP I   XDFUDGE         /YES,RETURN
/
DKBD,   0                       /TTY IN
        KSF                     /\
        JMP     .-1             / >READ IN TTY CHAR AFTER WAITING
        KRB                     //
        AND     DL177           /TRIM TO 7-BIT
        DCA     XDFUDGE         /SAVE IT
        TAD     XDFUDGE         /RESTORE
        TAD     DL7774          /BRK,^A,^B,^C ?
DL7700, SMA CLA                 /SKIP ON ABORT CHAR
        JMP     DOGCHK          /JUMP ON OTHER
BOOT,   DCA I   DSUNIT          /CLEAR UNIT BITS
        JMP I   DL7600          /BOOTSTRAP
DOGCHK, TAD     XDFUDGE         /RESTORE AGAIN
        TAD     DL7771          /^G ?
        SNA                     /SKIP IF NO
        JMP I   DL200           /JUMP IF YES
        TAD     DL7765          /^R ?
        SZA CLA                 /SKIP IF YES
        JMP     .+3             /JUMP IF NO
        JMS     DREWND          /REWIND A TAPE
        JMP     DKBD+1          /AGAIN
        TAD     XDFUDGE         /GET CHAR AGAIN
        JMP I   DKBD            /RETURN
XINPUT, 0                       /NUMERIC INPUT ROUTINE
        DCA     XFORLF          /ZERO REGISTER
DINMOR, JMS I   DTTYIN          /GRAB A CHAR
        TAD     DL7710          /CHECK UPPER LIMIT
        SMA                     /SKIP IF <"8"
        JMP     DALT1           /JUMP IF POTENTIAL ALTMODE,ETC
        TAD     DL10            /CHECK LOWER LIMIT
        SPA                     /SKIP IF >"/"
        JMP     DALT2           /CHECK FOR ALT 33 ^[,ETC
        DCA     DP6CH           /SAVE VALUE OF CURR CHAR
        TAD     XFORLF          /GET REGISTER
        CLL RAL                 /\
        CLL RAL                 / >ROTATE CLEANLY
        CLL RAL                 //
        TAD     DP6CH           /ADD ON CURR CHAR
        DCA     XFORLF          /STORE IT
        TAD     XDFUDGE         /GET CHAR AGAIN
        JMS     DTYPE           /PRINT IT
        JMP     DINMOR          /GET ANOTHER
DALT1,  TAD     DL7673          /ALT 175,176 OR RUBOUT ?
DL7710, SPA CLA                 /SKIP IF YES
        JMP     DINMOR          /JUMP IF NO
        JMP I   XINPUT          /RETURN WITH NOTHING
DALT2,  TAD     DL25            /^[ ?
        SNA                     /SKIP IF NOT ALT 33
        JMP I   XINPUT          /RETURN WITH NOTHING ON ALTMODES
        TAD     DL16            /C. R. ?
        SZA                     /DON'T CHECK COMMA IF YES
        TAD     DL7741          /, ?
        SZA CLA                 /SKIP IF C. R. OR ,
        JMP     DINMOR          /JUMP BACK FOR BETTER CHAR
        ISZ     XINPUT          /SKIP RETURN
        TAD     XFORLF          /GET NUMBER
        JMP I   XINPUT          /EXIT
/
XUNPK,  0                       /NUMBER UNPACK
        CLL RAL                 /INITIAL FIXUP
        DCA     DKBD            /SAVE IT
        TAD     DL7774          /SETUP
        DCA     XINPUT          /FOR 4
DUNLOP, TAD     DKBD            /\
        RAL                     / \ROLL AROUND
        RTL                     / /TO NEXT DIGIT
        DCA     DKBD            //
        TAD     DKBD            /GET IT BACK
        AND     DL7             /JUST ONE DIGIT
        TAD     DL60            /ASCII IT
        JMS     DTYPE           /PRINT IT
        ISZ     XINPUT          /DONE 4 ?
        JMP     DUNLOP          /NO,GO BACK
        TAD     DL40            /PRINT
        JMS     DTYPE           /A BLANK
        JMP I   XUNPK           /EXIT
