	JMS	DIVIDE		/DIVIDE
	144			/BY 100
	CLA			/THROW AWAY QUOTIENT
	TAD	REM		/GET THE REMAINDER 60-99 OR 00-59
	JMS	DIVIDE		/DIVIDE BY 10 TO GET
	12			/THE TEN'S DIGIT
	TAD	("-^100+"0-200)	/GET "-" AND MAKE IT ASCII
	DCA I	XR2		/STORE INTO MESSAGE
	TAD	REM		/GET THE UNIT'S DIGIT
	CLL RTL;RTL;RTL		/MOVE UP
