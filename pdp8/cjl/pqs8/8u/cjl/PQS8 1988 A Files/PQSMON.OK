2887   001252* 3753          DCA I   PLINDEX/(LINDEX)        /SAVE FOR LATER
2888   001253* 1756          TAD I   PSCANF/(SCANF)          /GET LOAD-LENGTH WORD
2889   001254* 0006          AND     L100/[NOSCAN]           /JUST FILE-SCAN BIT
2890   001255* 7640          SZA CLA                         /SKIP IF OFF
2891   001256* 5367          JMP     NOFILES                 /PREVENT ANY FILE PRESCAN AND SCAN
2892   
2893                 /       IF FILES ARE ALLOWED, A PRESCAN MUST BE MADE TO ESTABLISH THE
2894                 /       ORDER OF FILE NAME SCANNING. THE SCAN CAN BE EITHER:
2895   
2896                 /       A)      OUTPUT<INPUT
2897                 /       B)      INPUT>OUTPUT
2898   
2899                 /       IF A) IS CHOSEN, THEN OUTPUT FILE CREATION IS ASSUMED FIRST AND
2900                 /       SCANNING IS LEFT TO RIGHT ENDING ON <EOL>.
2901   
2902                 /       IF B) IS CHOSEN, THEN OUTPUT FILE CREATION IS ASSUMED FIRST BUT
2903                 /       SCANNING STARTS JUST RIGHT OF THE ">". WHEN <EOL> IS REACHED, THE
2904                 /       SCAN POINTER IS RESET TO THE LEFT AND SCANNING OCCURS LEFT TO RIGHT
2905                 /       UNTIL THE ">" IS REACHED.
2906   
2907                 /       IF NEITHER SCANNING CHARACTER IS FOUND, THEN NO OUTPUT FILE LIST EXISTS AND
2908                 /       EXISTENT INPUT FILE NAMES ARE ASSUMED. SCANNING WILL OCCUR LEFT TO RIGHT.
2909   
2910   001257* 4504  PRSCNLP,JMS I   GETHAF/[XGETHAF]        /GET A CHARACTER
2911   001260* 7450          SNA                             /<EOL>?
2912   001261* 5360          JMP     ENDPRSCAN               /YES, WE'RE DONE
2913   001262* 1276          TAD     SWITCH/(-">!200)        /IS IT ">"?
2914   001263* 7440          SZA                             /SKIP IF SO
2915   001264* 5271          JMP     TRYLFT                  /JUMP IF NOT
2916   001265* 2346          ISZ     RSCAN                   /INDICATE ">" FOUND
2917   001266* 1026          TAD     GETNDX                  /GET CURRENT INDEX
2918   001267* 7001          IAC                             /PLACE IT PAST THE ">"
2919   001270* 3755          DCA I   PRINDEX/(RINDEX)        /THIS WILL INDICATE RIGHT-TO-LEFT SCANNING LATER
2920   001271* 1010  TRYLFT, TAD     L2/[-"<+">]             /IS IT "<"?
2921   001272* 7650          SNA CLA                         /SKIP IF NOT
2922   001273* 2342          ISZ     LSCAN                   /INDICATE ">" FOUND
2923   001274* 2026          ISZ     GETNDX                  /BUMP TO NEXT CHARACTER
2924   001275* 5257          JMP     PRSCNLP                 /GO BACK FOR MORE

