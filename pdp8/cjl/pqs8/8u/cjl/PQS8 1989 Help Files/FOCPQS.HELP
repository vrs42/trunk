1438                 /       COMES HERE TO ATTEMPT TO CLEAR OR DISABLE ALL ACTIVE (NON-REFERENCED)
1439                 /       INTERRUPTS BY EXECUTIVE SEVERAL IOT'S TO THE DEVICE. THE LIST MAY BE
1440                 /       PATCHED FOR INSTALLATION ANOMALIES.
1441   
1442   004031  1377  INTKILL,TAD     (TESTLST)       /POINT TO
1443   004032  3344          DCA     LSTPTR          /MASTER LIST
1444   004033  7326          NL0002                  /SETUP "C" BIT MASK
1445   004034  0775          AND I   (SCRSIZE)       /GET THE "C" BIT
1446   004035  7650          SNA CLA                 /SKIP IF OVERLAY PRESENT
1447   004036  7203          NL0100                  /WILL BE 0100 ON 8/E OR BETTER
1448   004037  1101          TAD     P7700/[-100]    /COMPARE TO EXPECTED VALUE
1449   004040  7650          SNA CLA                 /SKIP IF DIFFERENT
1450   004041  6007          CAF                     /CLEAN UP BUSS NOW
1451   004042  1744  INTKLUP,TAD I   LSTPTR          /GET AN ENTRY
1452   004043  7450          SNA                     /END OF LIST?
1453   004044  5303          JMP     INTDONE         /YES
1454   004045  7040          CMA                     /CHECK FOR 7777 ENTRY
1455   004046  7450          SNA                     /SKIP IF NOT 7777
1456   004047  5301          JMP     NOKILL          /JUMP IF 7777
1457   004050  7040          CMA                     /INVERT BACK
1458   004051  0376          AND     (7770)          /REMOVE IOP BITS
1459   004052  3333          DCA     IOTINLINE       /STORE IN TEST INSTRUCTION
