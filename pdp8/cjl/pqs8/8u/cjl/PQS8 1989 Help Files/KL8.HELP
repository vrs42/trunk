 111                         IFNDEF  LIN     <LIN=   40>                     /LPT: INPUT CODE
 112                         IFNDEF  LPT     <LPT=   41>                     /LPT: OUTPUT CODE
 113                         IFNDEF  NMCH1   <NMCH1= "K^100+"L-300>          /FIRST NAME PAIR
 114                         IFNDEF  NMCH2   <NMCH2= "8^100+"S-300>          /SECOND NAME PAIR
 115                         IFNDEF  NMCH3   <NMCH3= "P^100>                 /THIRD NAME PAIR
 116                         IFNDEF  ONEWAY  <ONEWAY=0>                      /TWO-WAY LPT: HANDLING
 117                         IFNDEF  OUT     <OUT=   04>                     /CONSOLE OUTPUT CODE
 118                         IFNDEF  VT8LPT  <VT8LPT=0>                      /NO VT-8/E LPT: INTERRUPTS
 119   
 120                 /       LPT: INTERRUPT ENABLE DEFINITIONS.
 121   
 122                         IFNDEF  NOLIE   <NOLIE= ONEWAY>                 /LIEIOT DOES/DOES NOT EXIST
 123                         IFNDEF  NOLOE   <NOLOE= ONEWAY-1&1>             /LPEIOT DOES/DOES NOT EXIST
 124   
 125                                                                         >

