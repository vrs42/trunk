/OS/8 COMPARE PROGRAM.

/	FIXED BY CJL!

/	LAST EDIT:	07-DEC-1984	17:00:00	CJL

/	MAY BE ASSEMBLED WITH '/J' (PAL8 '/F') SWITCH SET.
 
/	EXTENDED OPCODES:

	AC1=	CLA IAC
	SA7775=	STA CLL RTL
	FIXMRI	INC=	ISZ
 
/	COMMAND DECODER FUNCTION DEFINITIONS:

	FETCH=	1
	LOOK=	2
	ENTER=	3
	CLOSE=	4
	DECODE=	5
	USRIN=	10
	RESET=	13
 
/	ADDRESSES OF FILE SPECS IN FIELD 0:

	CSPEC=	CDATA
	ASPEC=	CSPEC+5
	BSPEC=	ASPEC+5
	LOSPEC=	BSPEC+5
	HISPEC=	LOSPEC+5
	OPTION=	CDATA+43
	PARAM=	CDATA+46
 
/	HANDLER LOAD ADDRESSES:

	AHNDLR=	2000
	BHNDLR=	2400
	CHNDLR=	3000
/	AUTO-INDEX REGISTERS.

	*10

XR10,	 0!0
XR11,	 0!0
OUTPTR,	 0!0
 
/	CONSTANTS.

	*20

K77,	 77
K7700,	 7700
K7400,	 7400
K7577,	 7577
K17,	 17
K200,	 200
K177,	 177
K7,	 7
K400,	 400
K377,	 377
 
/	POINTERS TO CODE.

WRITEP,	 WRITE
OCTGTP,	 OCTGET
KBDP,	 KBD
STRNGP,	 STRING
STARTP,	 START
OUTP,	 OUTPUT
CHKNLP,	 CHKNUL 

/	REGISTERS - PARAMETERS.

LOWER,	 0!0
UPPER,	 0!0
MABBLB,	 0!0		/*) -A&B BUFF LEN, BLKS.
MDBLWR,	 0!0		/*) -2*OUTPUT BUFF LEN, WRDS.
AFNBAS,	 0!0		/*) BUILDER FOR PHYS A-READ
			 /OS/8 HANDLER ARG.
BFNBAS,	 0!0		/*) DITTO, FOR B-FILE.
CFNBAS,	 0!0		/*) DITTO, FOR C (OUT) FILE.
INTRNF,	 0!0		/-1: INTERNAL HANDLER.
			/0: OS/8 HANDLER
CTR1,	 0!0		/GEN PURP COUNTER.
CMPLEN,	 0!0		/-# WRDS TO CMPR/BLK.
HDRFLG,	 0!0		/-1: PRINT HEADER.
OUTLEN,	 0!0		/OUTPUT FILE LENGTH.
OUTCTR,	 0!0		/COUNT DOUBLE WRDS OUT.
TEMP,	 0!0		/TEMP STORAGE.
RELBLK,	 0!0		/REL BLK# OF CMPR.
MATCH,	 0!0		/FLAG FOR FILES MATCH.
ABLOK1,	 0!0		/BLK 1 OF A-FILE.
BBLOK1,	 0!0		/BLK 1 OF B-FILE.
AINCTR,	 0!0		/COUNT INPUT BLKS.
BINCTR,	 0!0		/ONE FOR EA. INP FILE.
ACTR,	 0!0		/COUNT CMPR BLKS.
BCTR,	 0!0		/FOR B-FILE TOO.
ABASE,	 0!0
BBASE,	 0!0
/	POINTERS TO FILE SPECS.

ASPECP,	 ASPEC		/POINTS TO DEVICE.
BSPECP,	 BSPEC
CSPECP,	 CSPEC
ASPC1P,	 ASPEC+1	/POINTS TO NAME.
BSPC1P,	 BSPEC+1
CNAMEP,	 CSPEC+1
LOSPCA,	 LOSPEC		/POINTS TO 1 LESS THAN
			 /NAME (OCTAL NUMBER).
HISPCA,	 HISPEC
OPTNP,	 OPTION
PARAMP,	 PARAM
ERRNUM,	 0!0		/ERROR NUMBER.
 
/	CR-LF ROUTINE.

CRLF,	 0!0
	JMS I	STRNGP
	 15
	 12+4000
	JMP I	CRLF
 
AIO,	 0!0		/PHYSICAL A-READ.
	JMS I	AHANDE	/CALL HANDLR.
AFUNCT,	 0!0		/FUNCTION WORD.
ABUFFP,	 0!0		/*) A-FILE BUFF ADR.
ABLOCK,	 0!0		/BLK FOR TRANSFER.
	JMP	ERR1	/???
	JMP I	AIO	/EXIT SUCCESSFULY.
 
AHANDE,	 0!0		/A-FILE HANDLR ENTRY ADR.
 
BIO,	 0!0		/PHYSICAL B-READ.
	JMS I	BHANDE	/CALL.
BFUNCT,	 0!0
BBUFFP,	 0!0		/*) BUFFER ADDRESS.
BBLOCK,	 0!0
	JMP	ERR2	/???
	JMP I	BIO	/EXIT.
 
BHANDE,	 0!0		/B-FILE HNDLR ENTRY ADR.
 
CIO,	 0!0		/SAME THING FOR OUTPUT.
	JMS I	CHANDE
CFUNCT,	 0!0
CBUFFP,	 0!0		/*) OUTPUT BUFF ADR.
CBLOCK,	 0!0
	JMP	ERR3	/???
	JMP I	CIO
 
CHANDE,	 0!0
CENTER,	 0!0		/ENTER TENT OUT-FILE.
	TAD I	CSPECP	/GET DEV# & [LEN].
	CIF	10	/CALL
	JMS I	K200	/USR.
	 ENTER
CBLOK1,	 0!0		/PTR TO NAME, THEN BLK 1.
CMAX,	 0!0		/-MAX BLKS IN SLOT.
	JMP	ERR4	/???
	JMP I	CENTER	/EXIT.
 
ERR15,	INC	ERRNUM
ERR14,	INC	ERRNUM
ERR13,	INC	ERRNUM
ERR12,	INC	ERRNUM
ERR11,	INC	ERRNUM
ERR10,	INC	ERRNUM
ERR7,	INC	ERRNUM
ERR6,	INC	ERRNUM
ERR5,	INC	ERRNUM
ERR4,	INC	ERRNUM
ERR3,	INC	ERRNUM
ERR2,	INC	ERRNUM
ERR1,	INC	ERRNUM
	JMP I	ERRHNP
ERRHNP,	ERRHAN
*200
 
START,	JMP I	ONCEP!0	/EVALUATE CORE LIMS.
			 /(REPLACED WITH A TLS.)
	CIF	10	/BRING IN USR,
	JMS I	K7700
	 USRIN		/AND KEEP IN CORE.
	CIF	10	/FORGET LAST
	JMS I	K200	/RUN OF THIS
	 RESET		/PROGRAM.
	CIF	10	/USE
	JMS I	K200	/THE
	 DECODE		/SPECIAL
	 5200		/MODE OF
	 0		/THE COMMAND DECODER.
	STA		/USE THE DEFAULT HANDLER.
	DCA	INTRNF	/DO A CRLF SO ALTMODE
	JMS	CRLF	 /WILL NOT SCREW OUTPUT.
	DCA	ERRNUM	/CLEAR ERROR NUMBER FOR CHAIN.
	TAD	M47	/MOVE
	DCA	CTR1	/COMMAND
	TAD	K7577	/DECODER
	DCA	XR10	/DATA
	TAD	CDATAA	/INTO
	DCA	XR11	/FIELD
MVCDLP,	CDF	10	/0
	TAD I	XR10	/STARTING
	CDF	00	/AT
	DCA I	XR11	/CDATA.
	ISZ	CTR1
	JMP	MVCDLP
	TAD	KCHAND	/RESET ARG TO LOAD ADDRESS.
	DCA	CHNDP1	/THIS IS WHERE  OS/8 WANTS IT.
	JMP I	CHKNLP	/CHECK FOR NULL INPUT.
NULLOK,	TAD I	CSPECP	/PROC OUT-HANDLER.
	AND	K17	/DEV #.
	SNA		/NONE?
	JMP	INTERN	/NONE! USE INTERNAL.
	CIF	10	/ALWAYS IN FIELD 1.
	JMS I	K200	/CALL USR AGAIN.
	 FETCH		/GO GET IT, BOY!
CHNDP1,	 0!0		/BRING IT HERE.
	JMP	ERR5	/BAD DOG, YOU CANT FIND IT!
	TAD	CHNDP1	/NOW MOVE THE ENTRY ADDRESS TO
	DCA	CHANDE	/WHERE WE CAN USE IT.
	DCA	INTRNF	/FLAG OS/8 HANDLER IN USE.
	TAD	CNAMEP	/RESET PTR TO NAME
	DCA	CBLOK1	/ENTRY OF OUTPUT FILE.
	JMS	CENTER	/ENTER THE OUTPUT FILE.
	TAD	CBLOK1	/WITHOUT THESE TWO
	DCA	CBLOCK	/WORDS, WE'D WIPE OUT DIR.
PROCIN,	TAD	KAHAND	/PROCESS INP HNDLRS,
	DCA	AHNDP1	/MUST RESET DUMB LOAD ADR.
	TAD I	ASPECP	/DEV #.
	CIF	10
	JMS I	K200
	 FETCH
AHNDP1,	 0!0
	JMP	ERR6	/???
	TAD	AHNDP1	/PUT IN A USEFUL (W/RESPECT TO
	DCA	AHANDE	/OS/8) PLACE.
	TAD	KBHAND	/RESET DEVICE
	DCA	BHNDP1	/LOAD ADDRESS.
	TAD I	BSPECP	/DEV #.
	CIF	10
	JMS I	K200
	 FETCH
BHNDP1,	 0!0
	JMP	ERR7	/???
	TAD	BHNDP1	/MOVE THE STUPID ARG.
	DCA	BHANDE
	STA		/SET A-LENGTH TO -1 IN CASE
	DCA	AINCTR	/A&B ARE BLK#'S AND USER FORGETS
			 /=PARAMETER. AINCTR WILL BE USED
			 /TO SET THE OTHER INPUT-FILE LENGTH
			 /COUNTERS FOR CONSISTENCY.
	TAD I	OPTNP	/GET SWITCHES.
	AND	K1000	/C?
	SZA CLA
	JMP	AISBLK	/A-FILE IS A BLK#.
	TAD	ASPC1P	/STUPID ARGUMENT
	DCA	AB1	/RESET (PTR TO A-NAME).
	TAD I	ASPECP	/A-DEV#.
	CIF	10	/A MACRO TO CALL USR?
	JMS I	K200	/OR MAYBE CALL IT INTO FIELD 0?
	 LOOK		/LOOK UP FILE NAME.
AB1,	 0!0		/PTR TO NAME, THEN BLK 1.
ACT,	 0!0		/-LEN.
	JMP	ERR10	/???
	TAD	AB1	/PUT FIRST BLOCK OF FILE
	DCA	ABLOK1	/PARAMETER ON PAGE 0.
	TAD	ACT	/A-LENGTH USED FOR SETTING
	DCA	AINCTR	/INP FILE LENTGH COUNTERS.
GETB,	TAD I	OPTNP	/DO B-FILE SAME WAY.
	AND	K3000	/B OR C?
	SZA CLA
	JMP	BISBLK	/B IS BLK# RATHER THAN FILE NAME.
	TAD	BSPC1P	/RESET PTR TO FILE NAME.
	DCA	BB1
	TAD I	BSPECP
	CIF	10
	JMS I	K200
	 LOOK
BB1,	 0!0
BCT,	 0!0
	JMP	ERR11	/???
	TAD	BCT	/B IS A FILE, SO SET
	DCA	BINCTR	/BINCTR TO THE PROPER LENGTH.
	TAD	BB1	/GET BLOCK1 OF C-FILE FROM USR.
	DCA	BBLOK1	/SET  BLOCK1 OF FILE.
	JMP I	K400	/EXIT TO NEXT PAGE OF CODE.
AISBLK,	TAD	ASPECP	/PROCESS A AS BLK#.
	JMS I	OCTGTP	/ROUTINE GETS AN OCTAL #.
	ERR12	/HE TOLD US THAT ITS A BLK#,
			 /BUT HE GAVE US NO GOOD ONE.
	DCA	ABLOK1	/STORE BLOCK 1 OF A-FILE.
	JMP	GETB	/AND GET B-FILE LENGTH.
BISBLK,	TAD	BSPECP	/B IS GIVEN AS BLK#.
	JMS I	OCTGTP
	JMP	ERR13	/BAD #.
	DCA	BBLOK1	/SET BLOCK1 OF B-FILE.
	TAD	AINCTR	/USE A-LENGTH FOR
	DCA	BINCTR	/B-LENGTH (BOTH RESET ON '=').
	JMP I	K400	/EXIT TO NEXT PAGE OF CODE.
INTERN,	STA		/FLAG INTERNAL
	DCA	INTRNF	/HANDLR IN USE.
	JMP	PROCIN	/PROCESS INPUT HNDLRS.
 
 
ONCEP,	 ONCE
K1000,	 1000
K3000,	 3000
M47,	 -47
CDATAA,	 CDATA-1
KAHAND,	 AHNDLR+1	/+1 FOR 2 PAGES.
KBHAND,	 BHNDLR+1
KCHAND,	 CHNDLR+1
*400
	TAD I	PARAMP	/=PARAMETER.
	SNA		/0: NONE.
	JMP	NOPARA
	CIA		/USE FOR LENGTH FROM
	DCA	AINCTR	/NOW ON.
	TAD	AINCTR	/SET B-FILE LENGTH FROM
	DCA	BINCTR	/'=' PARAMETER ALSO.
NOPARA,	TAD	LOSPCA	/GET LOWER LIMIT.
	JMS I	OCTGTP	/OCTAL #.
	CLA		/DEFAULT: 0
	AND	K377	/AVOID STUPIDITY.
	DCA	LOWER	/SAVE.
	TAD	HISPCA	/GET UPPER LIMIT.
	JMS I	OCTGTP
	TAD	K377	/DEFAULT: 377
	AND	K377
	DCA	UPPER
	TAD	UPPER	/CALC # WRDS
	CMA		/TO COMPARE
	TAD	LOWER	/PER BLOCK.
	DCA	CMPLEN
	TAD	AINCTR	/SET ACTR FROM AINCTR.
	DCA	ACTR
	TAD	BINCTR	/SET BCTR FROM BINCTR.
	DCA	BCTR
	TAD	MDBLWR	/RESET OUTPUT
	DCA	OUTCTR	/COUNTER.
	STA		/INITIALIZE FILES
	DCA	MATCH	/MATCH FLAG.
	STA
	TAD	CBUFFP	/RESET OUTPUT PTR.
	DCA	OUTPTR
	TAD	ABLOK1	/SET BLOCK ARGUMENT
	DCA	ABLOCK	/FOR DEVICE HANDLER.
	TAD	BBLOK1	/SAME WITH
	DCA	BBLOCK	/B-FILE.
	DCA	OUTLEN	/0-> OUTPUT FILE LENGTH.
	TAD	CHAR1P	/INIT OUTPUT
	DCA I	P3FOR2	/CO-ROUTINE.
	DCA	RELBLK	/RESET REL BLK #.
 
CMPRLP,	JMS	AREAD	/READ A BUFFER OF A-FILE.
	JMS	BREAD	/READ A BUFFER OF B-FILE.
	JMS I	CMPRP	/COMPARE THE TWO.
	JMS	BREAD	/NICE TAPE MOTION!
	JMS	AREAD
	JMS I	CMPRP
	JMP	CMPRLP	/DO IT AGAIN.
 
AREAD,	 0!0		/LOGICAL A-READ.
	TAD	MABBLB	/-# BLKS/BUFF.
	CLL CIA		/+# BLKS/BUFF.
	TAD	AINCTR	/INCREMENT BY
	DCA	AINCTR	/BUFFER SIZE.
	TAD	AINCTR	/FIGURE # OF BLKS TO READ.
	SNL		/>0: LESS THAN FULL BUFFER.
	CLA		/<=0: FULL BUFFER.
	TAD	MABBLB	/AC: -NUM BLKS TO READ.
	CIA		/OS/8 WANTS POSITIVE.
	CLL RAL		/WHERE OS/8 WANTS
	RTL		/THE
	RTL		/BITS.
	RTL		/EFF: MOVE INTO UPPER BYTE
			 /AND MULTIPLY BY 2.
			 /(WE'RE WORKING IN BLKS,
			 /THE HANDLER IN PAGES.)
	TAD	AFNBAS	/CREATE FUNCTION
	DCA	AFUNCT	/WORD FOR HNDLR.
	JMS	AIO	/READ SOME BLOCKS.
	TAD	MABBLB	/UPDATE BLOCK-TO-READ #.
	CIA
	TAD	ABLOCK
	DCA	ABLOCK
	JMP I	AREAD	/EXIT.
BREAD,	 0!0		/SAME THING.
	TAD	MABBLB
	CLL CIA
	TAD	BINCTR
	DCA	BINCTR
	TAD	BINCTR
	SNL
	CLA
	TAD	MABBLB
	CIA
	CLL RAL
	RTL
	RTL
	RTL
	TAD	BFNBAS
	DCA	BFUNCT
	JMS	BIO
	TAD	MABBLB
	CIA
	TAD	BBLOCK
	DCA	BBLOCK
	JMP I	BREAD
 
STRING,	 0!0		/TYPE STRING ROUTINE.
STRLP,	TAD I	STRING
	JMS I	OUTP	/SEND CHAR.
	TAD I	STRING	/GET LAST CHAR SENT.
	INC	STRING	/BUMP.
	SMA CLA		/<0: END-OF-STRING.
	JMP	STRLP
	JMP I	STRING	/EXIT.
 
CHKNUL,	TAD I	ANAMEP	/GET FIRST WORD OF NAME OF
	SNA CLA		 /FILE A, SKIP IF NOT NULL.
	JMP	ERR10	/NULL:  ERROR.
	TAD I	BNAMEP	/GET FIRST WORD OF NAME OF
	SNA CLA		 /FILE B, SEE IF NULL.
	JMP	ERR11	/NULL:  ERROR.
	JMP I	NULOKP	/OK:  GO BACK.
 
K2000,	 2000
CHAR1P,	 CHAR1
P3FOR2,	 S3FOR2
CMPRP,	 CMPR
ANAMEP,	 ASPEC+1
BNAMEP,	 BSPEC+1
NULOKP,	 NULLOK
*600
 
CMPR,	 0!0		/COMPARE TWO BUFFERS.
	STA		/SETUP FETCH PTRS.
	TAD	ABUFFP	/A INPUT COMES
	TAD	LOWER	/OFFSET POINTER.
	DCA	ABASE	/FROM XR10.
	STA		/B INPUT
	TAD	BBUFFP	/COMES FROM
	TAD	LOWER	/OFFSET POINTER.
	DCA	BBASE	/XR11.
	TAD	MABBLB	/COMPARE BUFFER'S WORTH
			 /OF BLOCKS.
	DCA	BLKCTR	/COUNT OFF BLOCKS.
CMPBLK,	TAD	CMPLEN	/DO SO MANY WORDS.
	DCA	CMPCTR
	STA		/-1: PRINT
	DCA	HDRFLG	/HEADER.
	TAD	ABASE	/RESET X-REG TO BEG OF BLK.
	DCA	XR10
	TAD	BBASE	/RESET PTR TO BEG OF BLK.
	DCA	XR11
CMPWRD,	 0!0		/*) CDF TO ABUFF FIELD.
	TAD I	XR10	/A-FILE WORD
	CIA		/SETUP TO COMPARE
CMFLDB,	 0!0		/*) WITH WORD FROM B-BUFFER.
	TAD I	XR11	/GET THE WORD FROM B.
	CDF	00	/COME BACK TO EARTH.
	SZA CLA		/SAME?
	JMS I	DIFFP	/NO;SEND DIFFERENCE.
	ISZ	CMPCTR	/DONE W/BLK?
	JMP	CMPWRD	/NO; DO ANOTHER WORD.
BLKEND,	TAD	ABASE	/BUMP PTR TO BEG OF BLK.
	TAD	K400
	DCA	ABASE
	TAD	BBASE
	TAD	K400
	DCA	BBASE
	JMS I	KBDP	/CHK OPERATOR FITS.
	SKP
	CLA
	INC	RELBLK	/BUMP REL BLK #.
	NOP		/JUST IN CASE!
	ISZ	ACTR	/PROGRAM DONE WITH A-FILE?
	SKP		/NO.
	JMP	AEND	/YES; CHK B-FILE.
	ISZ	BCTR	/JUST B-FILE?
	SKP		/NO.
	JMP	EOFB	/YES; EOF-B.
	ISZ	BLKCTR	/DONE W/BUFFER?
	JMP	CMPBLK	/NO; COMPARE ANOTHER BLK.
	JMP I	CMPR	/EDIT 12 DIDN'T HAVE THIS.
AEND,	ISZ	BCTR	/B DONE TOO?
	JMP	EOFA	/NO; EOF-A.
	ISZ	MATCH	/FILES MATCH?
	JMP	EOFALL	/NO; EOF.
	JMS	ENDMES	/FILES MATCH!
	"M+4000
EOFA,	JMS	ENDMES
	"A+4000
EOFB,	JMS	ENDMES
	"B+4000
EOFALL,	JMS	ENDMES
	" +4000
 
ENDMES,	 0!0		/SEND CLOSING MESSAGE AND CLOSE
			 /OUTPUT FILE.
	TAD I	ENDMES	/LAST CHAR IN MESS.
	DCA	ENDCHR	/INSERT INTO STRING.
	JMS I	STRNGP	/SEND STRING.
	 "E
	 "O
	 "F
	 " 
ENDCHR,	 0!0		/ARGUMENT TO ENDMES.
	JMS	CRLF	/ENDLINE.
	ISZ	INTRNF	/INTERNAL HANDLER?
	SKP		/NO.
	JMP	CHKALT	/CHECK FOR ALT MODE.
	TAD	KCTRLZ	/SEND CTRL/Z TO OS/8 HNDLR.
	JMS I	OUTP
	JMS I	WRITEP	/FLUSH BUFFER.
	TAD	OUTLEN	/OUTPUT FILE LENGTH.
	DCA	OUTLN1	/ARG TO OS/8 CLOSE.
	TAD I	CSPECP	/DEV #.
	AND	K17	/JUST DEV #.
	CIF	10
	JMS I	K7700	/NOT IN CORE RIGHT NOW!
	 CLOSE		/DONE WITH IT!
	 CSPEC+1	/POINTS TO OUT-FILE NAME.
OUTLN1,	 0!0		/OUTPUT LENGTH IN BLKS.
	JMP	ERR14	/???
 
CHKALT,	TAD I	ALTMDP	/GET WORD W/ ALT MODE FLAG.
	SMA CLA		/SET?
	JMP I	STARTP	/NO; RESTART PROGRAM.
	JMP I	KK7600	/YES; BACK TO OS/8.
 
DIFFP,	 DIFF
BLKCTR,	 0!0
CMPCTR,	 0!0
KCTRLZ,	 232
KK7600,	 7600
ALTMDP,	 CDATA+42
*1000
DIFF,	 0!0		/PRINT DIFFERENCE FOUND BY CMPR.
	DCA	MATCH	/KILL MATCH FLAG.
	ISZ	HDRFLG	/WE SUPPOSED TO PRINT HDR?
	JMP	NOHDR	/NO; SKIP AROUND.
	JMS I	STRNGP	/PRINT HEADER.
	 12
	 "B
	 "L
	 "K
	 " 
	 " +4000
	TAD	ABLOK1	/PRINT ABS
	TAD	RELBLK	/BLOCK NUM
	JMS	OCT4	/FOR A-FILE.
	JMS I	STRNGP	/SPACE OVER.
	 " +4000
	TAD	BBLOK1	/PRINT ABS
	TAD 	RELBLK	/BLK NUM
	JMS	OCT4	/FOR B-FILE.
	JMS I	STRNGP	/' ('
	 " 
	 "(+4000
	TAD	RELBLK	/PRINT RELATIVE
	JMS	OCT4	/BLOCK NUMBER.
	JMS I	STRNGP	/CLOSE W/ ')',
	 ")+4000
	JMS	CRLF	/AND CR-LF.
NOHDR,	TAD I	OPTNP	/SEE IF FAST MODE.
	AND	K100	/'F'-BIT.
	SZA CLA		/SET?
	JMP I	BLKNDP	/YES; FAST MODE.
	TAD	XR10	/FIGURE WORD # OF BLK.
	AND	K377
	JMS	OCT3	/PRINT IT.
	JMS I	STRNGP	/PRINT '/' AND
	 "/		 /SPACE OVER.
	 " !4000
	TAD	XR10	/POINTS TO WORD OF A-FILE.
	DCA	TEMP	/GET WORD W/OUT KILLING
			 /INDEX REGISTER.
DFFLDA,	 0!0		/*) GET WORD FROM FILE A.
	TAD I	TEMP
	CDF	00
	JMS	OCT4	/PRINT IT.
	JMS I	STRNGP	/SPACE OVER.
	 " +4000
	TAD	XR11	/DO SAME
	DCA	TEMP	/WITH
DFFLDB,	 0!0		/*) WORD FROM
	TAD I	TEMP	/B-FILE.
	CDF	00
	JMS	OCT4	/PRINT IT.
	JMS	CRLF	/END LINE.
	JMS I	KBDP	/CHK OPERATOR.
	JMP I	DIFF	/NOTHING; GO HOME.
	TAD	M16	/CHK ^N.
	SZA CLA
	JMP I	DIFF	/NOPE.
	JMS I	STRNGP	/'*'.
	 "*+4000
	JMS	CRLF	/CR-LF.
	JMP I	BLKNDP	/PRETEND BLOCK IS ENDED.
KBD,	 0!0		/EXIT TO P+1 ON NOTHING.
			 /EXIT TO +2 W/CHAR IN AC.
	KSF		/ANYTHING?
	JMP I	KBD	/NO.
	KRB		/GET IT.
	AND	K177	/MASK PARITY.
	DCA	CHAR	/SAVE TEMPORARILY.
	TAD	CHAR	/GET IT BACK.
	TAD	MCTRLC	/^C?
	SNA
	JMP I	K7600	/YES; BACK TO MOTHER OS/8.
	TAD	MCTRLP	/^P?
	SNA CLA
	JMP I	STARTP	/RESTART PROGRAM.
	TAD	CHAR	/RECOVER CHAR.
	INC	KBD	/BUMP TO APPROPRIATE EXIT.
	JMP I	KBD	/EXIT.
 
OCT,	 0!0		/PRINT OCTAL NUM.
	DCA	CTR1	/-# DIGITS.
OCTLP,	TAD	TEMP	/GET THE NUM.
	CLL RTL		/ROTATE
	RAL		/TO NEXT DIG.
	DCA	TEMP	/REPLACE.
	TAD	TEMP	/<10:11>,L HAVE DIGIT.
	RAL		/<9:11> HAVE DIGIT.
	AND	K7	/I FORGOT THIS ON EDIT 10.
	TAD	K260	/BUILD ASCII.
	JMS I	OUTP	/SEND IT.
	ISZ	CTR1	/DONE W/NUMBER?
	JMP	OCTLP	/NO; NEXT DIGIT.
	JMP I	OCT	/YES; EXIT.
 
OCT4,	 0!0
	DCA	TEMP	/SAVE # FOR OCT.
	TAD	M4	/DO 4 DIGIT.
	JMS	OCT	/SEND 'EM.
	JMP I	OCT4	/EXIT.
 
OCT3,	 0!0
	CLL RAL		/THROW HIGHEST
	RTL		/DIGIT.
	DCA	TEMP
	SA7775
	JMS	OCT
	JMP I	OCT3
MCTRLC,	 -3
MCTRLP,	 3-20
CHAR,	 0!0		/TEMP STORAGE (KBD).
M16,	 -16
M4,	 -4
K260,	 260
BLKNDP,	 BLKEND
K7600,	 7600
K100,	 100
*1200
 
OUTPUT,	 0!0		/OUTPUT 1 CHAR.
	ISZ	INTRNF	/INTERNAL?
	JMP	OS8OUT	/NO; USE OS/8 HNDLR.
	TLS
	TSF		/YES; WAIT FOR FLAG.
	JMP	.-1
	STA		/SET FLAG BACK TO -1.
	DCA	INTRNF
	JMP I	OUTPUT	/EXIT.
OS8OUT,	AND	K377	/PREVENT MESS.
OUTFLD,	0!0		/CHANGE TO OUTPUT BUFF FLD.
	JMP I	S3FOR2	/NEXT PART FO CO-ROUTINE.
S3FOR2,	 0!0		/CO-ROUTINE PTR.
	CDF	00	/BACK TO FIELD 0.
	DCA	INTRNF	/RESET FLAG FOR OS/8 HNDLR.
	JMP I	OUTPUT	/EXIT.
CHAR1,	DCA I	OUTPTR	/STORE 1ST 8-BIT CHAR.
	TAD	OUTPTR	/SAVE PTR FOR 3RD CHAR.
	DCA	OUTPR2	/PTR FOR 3RD CHAR.
	JMS	S3FOR2	/CO-ROUTINE EXIT.
	DCA I	OUTPTR	/STORE 2ND CHAR.
	JMS	S3FOR2	/CO-ROUTINE EXIT.
	CLL RTL		/HI 4 BITS TO AC<0:3>.
	RTL
	DCA	OUTTEM	/SAVE TO STORE LO 4 BITS.
	TAD	OUTTEM	/HI 4 BITS WHERE THEY BELONG.
	AND	K7400	/MASK THE 4 BITS.
	TAD I	OUTPR2	/ADD IN 1ST CHAR.
	DCA I	OUTPR2	/STORE 1ST& HALF OF 3RD.
	INC	OUTPR2	/BUMP TO WORD 2.
	TAD	OUTTEM	/LO 4BITS IN AC<4:7>.
	CLL RTL		/MOVE TO AC<0:3>.
	RTL
	AND	K7400	/MASK THE 4 BITS.
	TAD I	OUTPR2	/ADD IN 2ND CHAR.
	DCA I	OUTPR2	/STORE 2ND& LO HALF OF 3RD.
	CDF	00	/BACK TO FIELD 0 FOR WRITE.
	ISZ	OUTCTR	/STORED BUFFER FULL OF
			 /DOUBLE-WORDS?
	JMP	NX3FR2	/NO; EXIT.
	JMS I	WRITEP	/YES; WRITE BUFFER.
NX3FR2,	JMS	S3FOR2	/CO-ROUTINE EXIT THEN
	JMP	CHAR1	 /JUMP BACK TO BEGINNING.
OCTGET,	 0!0		/BUILD OCTAL NUMBER
			 /FROM FILE NAME ENTRY.
	DCA	OCTPTR	/POINTS TO NAME-1 (TO THE
			 /BEGINNING OF THE SPEC).
	DCA	OCTNUM	/CLEAR BUILDER.
	INC	OCTPTR	/POINT TO NAME.
	TAD I	OCTPTR	/CHK ANY AT ALL.
	SNA CLA
	JMP I	OCTGET	/NO OCTAL ENTRY.
NXTOCT,	TAD I	OCTPTR	/GET WORD.
	RTR		/MOVE
	RTR		/LEFT TO
	RTR		/RIGHT.
	JMS	OCTSR	/PROCESS LEFT HALF.
	TAD I	OCTPTR	/NOW DO RIGHT HALF.
	JMS	OCTSR
	INC	OCTPTR	/BUMP TO NEXT WORD.
	JMP	NXTOCT	/PROCESS NEXT CHAR.
 
OCTSR,	 0!0		/WORK ON ASCII CHAR IN
			 /AC<6:11>.
	AND	K77	/6 BIT ASCII.
	SNA		/0?
	JMP	DONE	/YES; DONE W/CONVERSION.
	TAD	M70	/-HIGHEST VAL-1.
	SMA		/<70?
	JMP	NOTOCT	/NO; NOT OCTAL DIG.
	TAD	K10	/>=0?
	SPA
	JMP	NOTOCT	/NO; NOT OCTAL DIGIT.
	DCA	OUTTEM	/SAVE TEMPORARILY.
	TAD	OCTNUM	/GET BUILDER.
	CLL RTL		/MULTIPLY
	RAL		/BY 10.
	TAD	OUTTEM	/ADD IN DIGIT.
	DCA	OCTNUM	/SAVE NEW VALUE.
	JMP I	OCTSR	/NEXT DIGIT.
NOTOCT,	CLA		/CLEAR AC ANCD
	JMP I	OCTGET	/TAKE FAILURE EXIT.
DONE,	INC	OCTGET	/BUMP TO GOOD EXIT.
	TAD	OCTNUM	/OCTAL NUMBER IN AC.
	JMP I	OCTGET	/EXIT.
 
OCTNUM,	 0!0		/BUILDER.
OCTPTR,	 0!0		/PTR TO NAME ENTRY.
M70,	 -70
K10,	 10
OUTPR2,	 0!0		/SECONDARY OUTPUT PTR.
OUTTEM,	 0!0		/OUTPUT & OCTAL BUILD TEMPORARY.
ERRHAN,	CLA
	JMS I	STRNGP	/SEND A
	 "?+4000		/"?".
	STA		/FORCE INTERNAL
	DCA	INTRNF	/HANDLER.
	TAD	ERRNUM	/ERROR NUMBER.
	JMS I	OCT3P	/PRINT IT.
	JMS	CRLF	/DO A CR/LF.
	JMP I	STARTP	/START OVER AGAIN.
OCT3P,	 OCT3
 
*1400
WRITE,	 0!0		/WRITE USED PORTION OF OUTPUT
			 /BUFFER TO OS/8 DEVICE.
	TAD	CBUFFP	/CALC RECORDS TO WRITE.
	CIA		/-BASE.
	TAD	OUTPTR	/LAST WORD WRITTEN INTO.
	SPA		/-1: NONE IN BUFFER.
	JMP	WREXIT	/NOTHING TO WRITE!
	AND	K7400	/BLOCK BITS OF HIEST BLK USED.
	TAD	K400	/N BLKS USED.
			 /(RECORD BITS BUT ROUNDED
			 /TO NEAREST BLOCK.)
	CLL RAR		/MOVE RECORD BITS OVER ONE.
	DCA	WTEMP	/SAVE FOR BUMPING BLOCK #.
	TAD	WTEMP	/CREATE
	TAD	CFNBAS	/FUNCTION WORD
	DCA	CFUNCT	/FOR OS/8 HANDLER.
	TAD	WTEMP	/BLKS TO WRITE IN HI BITS.
	CLL RAR		/MOVE RECORD BITS TO
	RTR		/LOW ORDER BYTE AND
	RTR		/DIV BY 2 TO GET BLOCKS.
	RTR
	DCA	WTEMP	/SAVE AGAIN!
	TAD	OUTLEN	/UPDATE OUTPUT FILE
	TAD	WTEMP	/LENGTH.
	DCA	OUTLEN	/UPDATED.
	TAD	OUTLEN	/CHK DEVICE OVERFLOW.
	STL		/LINK CHKS SLOT OVERFLOW.
	TAD	CMAX	/-MAX BLKS.
	SZA SNL		/LINK=0: OUT>=MAX.
	JMP	ERR15	/TOO BIG!
	JMS	CIO	/OK, DO THE WRITE.
	TAD	WTEMP	/UPDATE
	TAD	CBLOCK	/BLOCK
	DCA	CBLOCK	/NUMBER.
WREXIT,	CLA		/CLEAR AC.
	TAD	MDBLWR	/RESET OUTPUT COUNTER.
	DCA	OUTCTR
	STA
	TAD	CBUFFP
	DCA	OUTPTR	/RESET OUTPUT PTR.
	JMP I	WRITE	/EXIT.
 
WTEMP,	 0!0
 
CDATA=.
*3400
/ONCE-ONLY CODE RESIDING IN I/O BUFFER CORE.
 
ONCE,	DCA	0	/0-> 00000.
	CDF	20	/TRY FIELD 2.
	TAD	(7000	/TEST VAL TO STORE.
	DCA I	(0	/STORE IN 20000.
	TAD I	(0	/TRY TO RETRIEVE.
	TAD	(-7000	/SEE IF WE GOT IT
	SNA		/BACK.
	TAD	0	/HIT 00000?
	SZA CLA
	TAD	(TABL8-1-TABL12+1	/8K MACHINE.
	TAD	(TABL12-1		/12K MACHINE.
	CDF	00	/BACK TO FIELD 0.
	DCA	XR10	/PTR TO ADJUSTMENT TABLE.
	TAD I	XR10	/-BLKS/ CMPR-BUFF.
	DCA	MABBLB
	TAD I	XR10	/-DOUBLE WORDS IN
	DCA	MDBLWR	/OUTPUT BUFFER.
	TAD I	XR10	/FUNCTION BUILDER-A.
	DCA	AFNBAS	/REALLY JUST THE FIELD OF
			 /A-BUFFER.
	TAD I	XR10	/B-FUNCTION (FIELD).
	DCA	BFNBAS
	TAD I	XR10	/C-FUNCTION (FIELD+WRITE).
	DCA	CFNBAS
	TAD I	XR10	/A-BUFFER ADRESS.
	DCA	ABUFFP
	TAD I	XR10	/B-BUFFER ADDRESS.
	DCA	BBUFFP
	TAD I	XR10	/C-BUFFER ADDRESS.
	DCA	CBUFFP
	TAD I	XR10	/CDF TO A-BUFF FIELD.
	DCA I	(CMPWRD
	TAD I	(CMPWRD
	DCA I	(DFFLDA
	TAD I	XR10	/CDF TO B-BUFFER FIELD.
	DCA I	(CMFLDB
	TAD I	(CMFLDB
	DCA I	(DFFLDB
	TAD I	XR10	/CDF TO C-BUFFER FIELD.
	DCA I	(OUTFLD
	TAD	(TLS	/MODIFY PROGRAM SO IT
	DCA I	STARTP	/NEVER COMES BACK HERE.
	STA		/SET FLAG FOR INTERNAL TTY
	DCA	INTRNF	/HNDLR TO PRINT BANNER.
	JMS	CRLF
	JMS I	STRNGP	/DO A NICE BANNER.
	 "C
	 "M
	 "P
	 "A
	 "R
	 "E
	 " 
	 "3
	 "0+4000
	JMS	CRLF
	JMP I	STARTP	/START PROGRAM.
TABL8,	 -10	/-BLKS/ COMPARISON BUFFER.
	 -1600	/3400 OUT WRDS STARTING AT 14000.
	   00	/FUNCTION BASE:  FIELD 0 FOR A.
	   10	/FUNCTION BASE:  FIELD 1 FOR B.
	 4010	/FUNCTION BASE:  FIELD 1 FOR OUTPUT.
	 3400	/A:  03400 TO 07377.
	 0000	/B:  10000 TO 13777.
	 4000	/C:  14000 TO 17377.
	 CDF 00	/A:  FIELD 0.
	 CDF 10	/B:  FIELD 1.
	 CDF 10	/C:  FIELD 1.
 
TABL12,	 -17	/FROM 0-7400  IN EACH FIELD.
	 -2000	/FROM 3400-7400 IN FLD 0 (OUTPUT).
	   10	/FUNCTION BASE:  FIELD 1 FOR A.
	 20	/FUNCTION BASE:  FIELD 2 FOR B.
	 4000	/FUNCTION BASE:  FIELD 0 FOR OUTPUT.
	 0000	/A:  10000 TO 17377.
	 0000	/B:  20000 TO 27377.
	 3400	/C:  03400 TO 07377.
	 CDF 10	/A:  FIELD 1.
	 CDF 20	/B:  FIELD 2.
	 CDF 00	/C:  FIELD 0.
