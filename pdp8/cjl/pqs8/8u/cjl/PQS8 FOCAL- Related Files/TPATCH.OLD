/	PDP-12 FOCAL TRAINING PATCH

/	PDP-12 TRAINING PROGRAM IMPLEMENTED AS A PATCH TO P?S/8 FOCAL.

/	LAST EDIT:	23-JUL-1987	11:00:00	CJL

/	CAN BE ASSEMBLED WITH '/J' SWITCH SET.

/	MUST BE ASSEMBLED WITH '/8' SWITCH SET.

/	(OBVIOUSLY RUNS ON PDP-12 ONLY.)
	XLIST	OFF
	IFNDEF	OFF	<OFF=	1>
	IFNDEF	ON	<ON=	0>
	XLIST	ON

/	THIS IS A COLLECTION OF PATCHES TO P?S/8 FOCAL TO IMPLEMENT THREE FUNCTIONS:

/	1):	FGO(INITIALIZE-INDICATOR)
/	2):	FWRD(ADDRESS[,REPLACEMENT VALUE])
/	3):	FIO(ARGUMENT)

/	DESCRIPTION OF FUNCTIONS:

/	FUNCTION "FGO" RUNS THE TRAINING ROUTINE AS LONG AS SNS[0] IS SET OR THE
/	COUNT-DOWN TIMER VARIABLE DOESN'T OVERFLOW. WHEN THE SENSE SWITCH CLEARS,
/	THE FUNCTION RETURNS (VALUE UNIMPORTANT). SETTING SNS[1], THEN CLEARING
/	IT, CAUSES SIMULATED REWARDS. VARIOUS OTHER SENSE SWITCH SETTINGS PROVIDE
/	FOR OPTIONAL DISPLAYS. VARIOUS ADDRESSES (WHICH CAN BE REFERENCED BY "FWRD")
/	ARE USED AS PARAMETERS OR VARIABLES. IF THE PASSED ARGUMENT IS ZERO, ALL
/	VARIABLES (RUNNING TIME, ETC.) ARE CLEARED. IF THE PASSED ARGUMENT IS
/	NON-ZERO, THE VARIABLES WILL BE PRESERVED TO ACCUMULATE TOTAL TIMES, ETC.
/	SEE SENSE SWITCH TABLE FOR ADDITIONAL FEATURES.

/	FUNCTION "FWRD" RETURNS THE CONTENTS OF THE SPECIFIED MEMORY ADDRESS EVALUATED
/	FROM THE FIRST ARGUMENT. IF A SECOND ARGUMENT IS PASSED, THEN ITS EVALUATION
/	BECOMES THE REPLACEMENT VALUE AT THE SPECIFIED ADDRESS. THE FIRST ARGUMENT
/	IS AN ELEVEN BIT ADDRESS OF A TWENTY-FOUR BIT NUMBER. THE BASE ADDRESS IS
/	THAT OF THE VARIABLE TABLES TO ALLOW FOR COMPATIBILITY IN CASE OF REASSEMBLY
/	OF THE PROGRAM.

/	FUNCTION "FIO" PERFORMS INPUT OR OUTPUT OF A SINGLE CHARACTER DEPENDING
/	ON THE PASSED ARGUMENT. IF THE ARGUMENT IS >2047 OR NEGATIVE THEN THE
/	FUNCTION RETURNS THE NUMERICAL VALUE (MODULO 128) OF THE NEXT ASCII
/	CHARACTER TYPED INTO P?S/8 FOCAL. THE FUNCTION WILL HANG IF NECESSARY UNTIL
/	A CHARACTER IS TYPED. IF THE ARGUMENT IS <2048 THEN THE VALUE PASSED MODULO
/	256 WILL BE OUTPUT TO THE PREVAILING TERMINAL OUTPUT DEVICE.
/	DESCRIPTION OF SENSE SWITCH SETTINGS FOR "FGO":

/	SENSE SWITCH			USAGE

/	0				1=TRAIN ANIMAL
/					0=RETURN TO FOCAL

/	1				0=NO SIMULATED REWARD
/					1=INITIATE SIMULATED REWARD
/					NOTE: THIS SWITCH MUST BE RETURNED TO ZERO
/					TO COMMENCE REWARD!

/	2				1=DISPLAY WINDOW BORDER

/	3				1=DISPLAY CURRENT GALVO POSITION

/	4				1=DISPLAY CURRENT ANIMAL POSITION

/	5				1=DISPLAY RELATIVE ANIMAL POSITION (FROM GALVO)


/	RELAY USAGE.

/	0				PROGRAM RUN INDICATOR

/	1				NOT USED

/	2				NOT USED

/	3				TARGET LIGHT (LASER)

/	4				AUDIBLE REWARD

/	5				LIQUID REWARD
/	DESCRIPTION OF VARIABLES TO BE ACCESSED BY "FWRD":

/	FWRD FIRST ARGUMENT VALUE	USAGE

/	0				TOTAL RUNNING TIME

/	1				IN-WINDOW RUNNING TIME

/	2				INTO-WINDOW TRANSITION COUNT

/	3				OUT-OF-WINDOW TRANSITION COUNT

/	4				LEFT-HAND WINDOW LIMIT

/	5				RIGHT-HAND WINDOW LIMIT

/	6				UPPER WINDOW LIMIT

/	7				LOWER WINDOW LIMIT

/	8				MAJOR/MINOR REWARD RATIO

/	9				MINOR REWARD DURATION

/	10				MAJOR REWARD DURATION

/	11				LATEST REWARD TIME (VALID ONLY WHEN PAUSED)

/	12				COUNT OF REWARD TIMES IN THE REWARD TIME
/					LIST, OR RANDOM ACCESS INDICATOR IF ZERO

/	13				COUNT-DOWN TIMER (NEGATIVE)

/	14				MINOR REWARD COUNT

/	15				MAJOR REWARD COUNT

/	16				SEED VARIABLE FOR RANDOM NUMBER GENERATOR

/	17				RELAY 3 TIME-OUT COUNTER (MAXIMUM TRIAL DURATION)

/	18				RELAY 3 HOLD-OFF COUNTER (INTER-TRIAL INTERVAL)

/	19-63				RESERVED FOR FUTURE VARIABLES

/	64-				REWARD TIMES STORED HERE. IF RANDOM ACCESS
/					CHOSEN, THEN UNUSED ENTRIES MUST BE ZERO.

/	ASSEMBLY INSTRUCTIONS:

/	SET "PCHFLD" TO THE PROPER FIELD FOR "FGO", "FWRD" (DEFAULT IS 20).

/	PCHFLD=	20			/TRAINING ROUTINE, ETC. FIELD
	PMODE				/ENSURE DEFINITION MODE

	IFNDEF	PCHFLD	<PCHFLD=20>	/TRAINING ROUTINE FIELD

	FIELD	PCHFLD%10		/START IN TRAINING FIELD

	*200				/ENSURE PROPER ORIGIN FOR DEFINITIONS

/	DEFINITIONS FROM FOCAL, 1969 (ORIGINAL PAPER-TAPE VERSION).

	BOTTOM=	0035			/FOCAL PUSHDOWN LIMIT
	CHAR=	0066			/FOCAL'S INPUT BUFFER
	EFUN3I=	0136			/FUNCTION RETURN POINTER
	EVAL=	1613			/EVALUATOR ENTRY POINT
	FLAC=	0044			/FLOATING ACCUMULATOR HERE
	FNTABF=	0374			/FUNCTION ADDRESS TABLE
	FNTABL=	2165			/HASHED FUNCTION NAME TABLE
	INDEV=	0064			/INPUT ROUTINE POINTER
	INTEGER=0053			/FLOATING TO FIXED CONVERSION POINTER
	OUTDEV=	0063			/OUTPUT POINTER
	POPA=	TAD I	13		/REMOVE WORD FROM STACK
	POPJ=	JMP I	141		/REMOVE AND RETURN FROM STACK
	PUSHA=	JMS I	142		/PUSH WORD ONTO STACK
	PUSHJ=	JMS I	140		/CALL WITH RETURN ON STACK
	P7600=	0104			/CONSTANT 7600
	RETURN=	JMP I	EFUN3I		/FUNCTION RETURN INSTRUCTION

/	DEFINITIONS FROM P?S/8 FOCAL OVERLAY.

	BEOFZAP=7505			/BINARY LOADER ZAP WORD
	BONCE=	3600			/OVERLAY ONCE-ONLY ADDRESS
	PCSAVE=	0000			/PC SAVED HERE ON INTERRUPT
	PINTHND=0002			/INTERRUPT HANDLER POINTER
	SYSIO=	7640			/SYSTEM I/O ENTRY POINT

/	KW12A CLOCK DEFINITIONS.

	CLSK=	6131			/SKIP ON CLOCK INTERRUPT
	CLLR=	6132			/LOAD CLOCK CONTROL REGISTER
	CLAB=	6133			/AC TO CLOCK BUFFER
	CLEN=	6134			/AC TO ENABLE REGISTER
	CLSA=	6135			/OR STATUS INTO AC, CLEAR STATUS PER AC BITS
	CLBA=	6136			/CLOCK BUFFER TO AC
	CLCA=	6137			/CLOCK COUNTER TO CLOCK BUFFER,
					/CLOCK BUFFER TO AC
/	EXTENDED ARITHMETIC DEFINITIONS.

	XLIST	OFF
	IFNDEF	DAD	<DAD=	0>
	IFNDEF	DCM	<DCM=	0>
	IFNDEF	DLD	<DLD=	0>
	IFNDEF	DST	<DST=	0>
	IFNDEF	DVI	<DVI=	0>
	XLIST	ON
	CAM=	CLA MQL			/CLEAR AC, MQ
	DAD=	JMS I	[DADD]		/DOUBLE-PRECISION ADD
	DCM=	JMS I	[DCOM]		/DOUBLE-PRECISION COMPLEMENT
	DLD=	JMS I	[DLOAD]		/DOUBLE-PRECISION LOAD
	DST=	JMS I	[DSTORE]	/DOUBLE-PRECISION STORE
	MQA=	7501			/OR MQ INTO AC
	MQL=	7421			/LOAD AC INTO MQ, CLEAR MQ
	SWP=	MQA MQL			/SWAP AC, MQ

/	MISCELLANEOUS DEFINITIONS.

	JMPC=	JMP	.		/CURRENT PAGE JUMP INSTRUCTION
	NL0001=	CLA IAC			/LOAD AC WITH 0001
	NL0002=	CLA CLL CML RTL		/LOAD AC WITH 0002
	NL0004=	CLA CLL IAC RTL		/LOAD AC WITH 0004
	NL4000=	CLA CLL CML RAR		/LOAD AC WITH 4000
	NSTART=	4106			/PATCH ASSEMBLY ADDRESS

	FIELD	0			/ENSURE FIELD ZERO

	*FNTABL+14			/PUT IN HASHED NAMES

	"G^2+"O				/GO
	"W^2+"R^2+"D			/WRD
	"I^2+"O				/IO
	*NSTART			/START PATCH HERE FOR DIRECT LOADING

/	TRAINING ROUTINE FUNCTION:	FGO(INITIALIZE-INDICATOR)

XGO,	JMS I	INTEGER		/GET THE INDICATOR ARGUMENT
	CIF CDF	PCHFLD		/GOTO PATCH FIELD
	JMP I	(TRINIT)	/CONTINUE THERE

/	MEMORY REFERENCE FUNCTION:	FWRD(ADDRESS[,NEWVALUE]).

XWRD,	JMS I	INTEGER		/GET ADDRESS ARGUMENT
	CLL RAL			/ADJUST TO DOUBLE-WORD ADDRESS
	TAD	(VARS)		/ADD ON TABLE BASE
	PUSHA			/SAVE IT
	PUSHJ			/EVALUATE SECOND IF ANY
LARG,	ARG			/**** RELOCATE ****
	JMP	GET		/NONE, JUST GET VALUE
	POPA			/RESTORE ADDRESS
	DCA	WRDTMP		/SAVE AS POINTER
	JMS I	INTEGER		/GET REPLACEMENT VALUE
	CDF	PCHFLD		/GOTO BUFFER FIELD
	DCA I	WRDTMP		/STORE LOW-ORDER
	TAD	WRDTMP		/GET THE POINTER
	IAC			/BUMP TO NEXT
	DCA	WRDTM2		/STASH THE POINTER TO HIGH-ORDER
	TAD	FLAC+1		/GET HIGH-ORDER VALUE
	DCA I	WRDTM2		/STORE IT
	JMP	GET2		/FINISH IT THERE

GET,	POPA			/GET BACK ADDRESS
	DCA	WRDTMP		/SAVE IT
GET2,	CDF	PCHFLD		/GOTO BUFFER FIELD
	TAD I	WRDTMP		/GET LOW-ORDER
	DCA	FLAC+2		/STASH IT
	ISZ	WRDTMP		/BUMP TO HIGH-ORDER
	TAD I	WRDTMP		/GET HIGH-ORDER
FINFINI,DCA	FLAC+1		/STASH IT
	TAD	(27)		/GET NEW EXPONENT
	DCA	FLAC		/STASH IT
	CDF	00		/ENSURE FIELD ZERO
	RETURN			/RETURN TO FOCAL

/	CHARACTER I/O FUNCTION:		FIO(ARGUMENT)

XIO,	JMS I	INTEGER		/GET THE ARGUMENT
	SMA CLA			/SKIP IF INPUT REQUESTED
	JMP	XOUT		/JUMP IF OUTPUT REQUESTED
	JMS I	INDEV		/GET A CHARACTER
	AND	(177)		/JUST SEVEN-BIT ASCII
	DCA	FLAC+2		/STORE IN LOW-ORDER
	JMP	FINFINISH	/FINISH IT THERE

XOUT,	TAD	FLAC+2		/GET LOW-ORDER BACK
	JMS I	OUTDEV		/OUTPUT IT
	JMP	FINFINISH	/FINISH IT THERE
/	ARGUMENT EVALUATOR.

ARG,	TAD	CHAR		/ARGUMENT EVALUATOR
	TAD	(-",)		/GOOD TERMINATOR?
	SZA CLA			/SKIP IF SO
	POPJ			/RETURN IF NOT
	PUSHJ;	EVAL-1		/EVALUATE SECOND ARGUMENT
	IAC			/INDICATE SKIP RETURN
	POPJ			/RETURN

WRDTMP,	.-.			/TEMPORARY
WRDTM2,	.-.			/TEMPORARY

	PAGE

	NEND=	.		/END OF RELOCATABLE PATCH CODE
/	ONCE-ONLY CODE STARTS HERE.

	*BONCE				/OVER DEFAULT ONCE-ONLY AREA

PBASE,	TAD	BOTTOM			/\
	TAD	(-200+1)		/ \ESTABLISH
	AND	P7600/[7600]		/ /BASE ADDRESS
	DCA	PBASE			//
	TAD	PBASE			/\
	TAD	(NSTART&177-1)		/ >ESTABLISH NEW LIMIT
	DCA	BOTTOM			//
	TAD	PBASE			/\
	TAD	(XGO&177)		/ >INSERT FGO
	DCA I	(FNTABF+14)		//
	TAD	PBASE			/\
	TAD	(XWRD&177)		/ >INSERT FWRD
	DCA I	(FNTABF+15)		//
	TAD	PBASE			/\
	TAD	(XIO&177)		/ >INSERT FIO
	DCA I	(FNTABF+16)		//
	TAD	PBASE			/\
	TAD	(ARG&177)		/ >FIXUP ADDRESS CONSTANT
	DCA I	(LARG)			//
	TAD	BOTTOM			/\
	IAC				/ >SETUP MOVE BASE
	DCA	PBASE			//
	TAD I	LNSTART			/\
	DCA I	PBASE			/ \
	ISZ	LNSTART			/  \MOVE DOWN PATCH TO
	ISZ	PBASE			/  /WHERE IT BELONGS
	ISZ	MOVCNT			/ /
	JMP	.-5			//
	CDF	PCHFLD			/GOTO TRAINING CODE FIELD
	TAD	PINTHND			/GET INTERRUPT POINTER
	DCA I	(INTRETURN)		/STORE IN OUR INTERRUPT HANDLER
	CDF	00			/BACK TO FIELD ZERO
	TAD	(CIF CDF PCHFLD)	/GET FIELD CHANGE INSTRUCTION
	DCA	PCSAVE+1		/ZAP FOCAL'S INTERRUPT HANDLER
	TAD	(EXTINT&177+JMPC)	/GET JUMP INSTRUCTION
	DCA	PINTHND			/MAKE FOCAL COME TO US
	DCA I	(BEOFZAP)		/REPAIR LOADER
	JMP I	(BEOFZAP)		/RESUME LOADING

LNSTART,NSTART				/POINTER TO NSTART
MOVCNT,	NSTART-NEND			/CODE MOVE COUNTER
	PAGE
	FIELD	PCHFLD%10	/DEFINE LOADING FIELD

	*0			/START AT THE BEGINNING

EXTINT,	JMP I	.+1/[INTER]	/GO HANDLER INTERRUPTS
	INTER			/THROUGH HERE

DALPHA,	.-.			/DISPLAY ALPHA REGISTER
FOO,	.-.			/TEMPORARY
RANCNT,	.-.			/RANDOM COUNTER
WCHDOG,	.-.			/WATCH-DOG SWITCH

	*20			/GET PAST AUTO-INDEX AREA

AC,	.-.			/SAVED AC ON INTERRUPT
BEEPCNT,.-.			/LIQUID REWARD DELAY COUNTER
BEEPLS,	.-.			/AUDIBLE REWARD PULSE TIMER
HR3CNT,	ZBLOCK	2		/RELAY[3] HOLD-OFF COUNTER
IWFLAG,	.-.			/IN-WINDOW FLAG
LINK,	.-.			/SAVED LINK ON INTERRUPT
RELAY,	.-.			/IMAGE OF RELAYS
REWCNT,	ZBLOCK	2		/REWARD TIME COUNTER
REWPLS,	.-.			/LIQUID REWARD PULSE TIMER
RTPTR,	REWARDS			/REWARD TIME LIST POINTER
R3CNT,	ZBLOCK	2		/RELAY[3] TIME-OUT COUNTER
XGPOS,	.-.			/X GALVO POSITION
XPOS,	.-.			/UNSIGNED X POSITION
YGPOS,	.-.			/Y GALVO POSITION
YPOS,	.-.			/UNSIGNED Y POSITION

/	SMOOTHED X DATA.

X0,	.-.			/LATEST X VALUE
X1,	.-.			/PREVIOUS X VALUE
X2,	.-.			/PREVIOUS X VALUE
X3,	.-.			/PREVIOUS X VALUE

/	SMOOTHED Y DATA.

Y0,	.-.			/LATEST Y VALUE
Y1,	.-.			/PREVIOUS Y VALUE
Y2,	.-.			/PREVIOUS Y VALUE
Y3,	.-.			/PREVIOUS Y VALUE
/	SMOOTHED X GALVO DATA.

XG0,	.-.			/LATEST X GALVO VALUE
XG1,	.-.			/PREVIOUS X GALVO VALUE
XG2,	.-.			/PREVIOUS X GALVO VALUE
XG3,	.-.			/PREVIOUS X GALVO VALUE

/	SMOOTHED Y GALVO DATA.

YG0,	.-.			/LATEST Y GALVO VALUE
YG1,	.-.			/PREVIOUS Y GALVO VALUE
YG2,	.-.			/PREVIOUS Y GALVO VALUE
YG3,	.-.			/PEVIOUS Y GALVO VALUE

/	DISPLAY TEMPORARIES.

DSTEMP,	.-.			/DISPLAY ROUTINE TEMPORARY
DX,	.-.			/X-POSITION FOR SOME CALLERS
DY,	.-.			/Y-POSITION FOR SOME CALLERS

/	WINDOW LIMIT TEMPORARIES.

DLIMIT,	.-.			/LOWER LIMIT
LLIMIT,	.-.			/LEFT-HAND LIMIT
RLIMIT,	.-.			/RIGHT-HAND LIMIT
ULIMIT,	.-.			/UPPER LIMIT

/	SIGNED DIVIDE BY FOUR ROUTINE.

DIV4,	.-.			/DIVIDE BY FOUR ROUTINE
	CLL			/CLEAR LINK
	SPA			/SKIP IF POSITIVE
	CML			/ELSE REVERSE IT
	RAR			/MOVE IT DOWN
	CLL			/CLEAR LINK
	SPA			/SKIP IF POSITIVE
	CML			/ELSE REVERSE IT
	RAR			/MOVE IT DOWN
	JMP I	DIV4		/RETURN
	PAGE

/	COMES HERE WITH ARGUMENT IN AC FROM FGO.

TRINIT,	IOF			/JUST IN CASE
	SNA CLA			/SKIP IF VARIABLES SHOULD BE PRESERVED
	JMS I	(CLRVARIABLES)	/CLEAR OUT VARIABLES
	JMS I	(CLKINIT)	/SETUP THE KW-12 CLOCK
	TAD I	(BEEPAMT)	/GET DELAY COUNT
	CIA			/WANT NEGATIVE FORM
	DCA	BEEPCNT		/STASH THE COUNTER
	DCA	BEEPLS		/NOT BEEPING NOW
	DCA	REWPLS		/NOT GUSHING NOW
	DCA	IWFLAG		/NOT IN WINDOW NOW
	TAD	(44)		/GET INITIAL RELAY VALUE
	LINC			/GOTO L...MODE

	LMODE			/TELL THE ASSEMBLER ABOUT IT

	ATR			/SET AND CLEAR THE RELAYS THEMSELVES

	PDP			/BACK TO GOODY MODE

	PMODE			/TELL THE ASSEMBLER ABOUT IT

	DCA	RELAY		/STORE IMAGE OF RELAYS ALSO
	DLD;	HR3TIME		/GET RELAY[3] HOLD-OFF VALUE
	DCM			/WANT NEGATIVE FORM
	DST;	HR3CNT		/SETUP HOLD-OFF COUNTER
	DLD;	R3TIME		/GET RELAY[3] TIME-OUT VALUE
	DCM			/WANT NEGATIVE FORM
	DST;	R3CNT		/SETUP TIME-OUT COUNTER
	DLD;	REWARDS		/GET FIRST REWARD TIME
	DST;	REWTIME		/SETUP BUFFER
	DCM			/WANT NEGATIVE FORM
	DST;	REWCNT		/SETUP REWARD TIME COUNTER
	NL0001			/SET THE
	DCA	WCHDOG		/WATCH-DOG SWITCH
	TAD	(REWARDS)	/POINT TO
	DCA	RTPTR		/REWARD TIMES LIST
	TAD	(SKP)		/SETUP OUR
	DCA I	(INTZAP)	/CLOCK HANDLER
	ION			/HERE WE GO!
NULJOB,	LAS			/GET THE SWITCHES
	DCA	FOO		/STASH THEM
	TAD I	FOO		/GET THE CORRESPONDING CONTENTS
	MQL			/DISPLAY THEM
	TAD	WCHDOG		/GET WATCH-DOG SWITCH
	SNA CLA			/SKIP IF STILL SET
	JMP	ENDIT		/JUMP IF NO LONGER SET
	CIF	PCHFLD		/PREVENT LINC INTERRUPTS
	LINC			/GOTO L...MODE

	LMODE			/TELL THE ASSEMBLER ABOUT IT

	SNS I	0		/SKIP IF SWITCH NOT THROWN
	COM			/ELSE COMPLEMENT AC
	PDP			/BACK TO GOODY MODE EITHER WAY

	PMODE			/TELL THE ASSEMBLER ABOUT IT

	SZA CLA			/SKIP IF SWITCH IS NOW OFF
	JMP	TEST2		/ELSE JUST KEEP GOING
ENDIT,	TAD	(NOP)		/DISABLE OUR
	DCA I	(INTZAP)	/CLOCK HANDLER
	CIF	PCHFLD		/PREVENT LINC INTERRUPTS
	LINC			/GOTO L...MODE

	LMODE			/TELL THE ASSEMBLER ABOUT IT

	ATR			/CLEAR THE RELAYS NOW
	PDP			/BACK TO GOODY MODE

	PMODE			/TELL THE ASSEMBLER ABOUT IT

	CLEN			/CLEAR CLOCK ENABLE
	CIF CDF	00		/GOING TO FIELD ZERO
	JMP I	(FINFINISH)	/FINISH UP THERE
/	COMES HERE IF WE'RE STILL RUNNING.

TEST2,	CIF	PCHFLD		/PREVENT LINC INTERRUPTS
	LINC			/GOTO L...MODE

	LMODE			/TELL THE ASSEMBLER ABOUT IT

	SNS I	2		/SKIP IF SWITCH NOT THROWN
	COM			/ELSE COMPLEMENT AC
	PDP			/BACK TO GOODY MODE EITHER WAY

	PMODE			/TELL THE ASSEMBLER ABOUT IT

	SZA CLA			/SKIP IF SWITCH NOT THROWN
	JMS I	(DISPWINDOW)	/DISPLAY WINDOW BORDER IF SWITCH THROWN
TEST3,	CIF	PCHFLD		/PREVENT LINC INTERRUPTS
	LINC			/GOTO L...MODE

	LMODE			/TELL THE ASSEMBLER ABOUT IT

	SNS I	3		/SKIP IF SWITCH NOT THROWN
	COM			/ELSE COMPLEMENT AC
	PDP			/BACK TO GOODY MODE EITHER WAY

	PMODE			/TELL THE ASSEMBLER ABOUT IT

	SNA CLA			/SKIP IF SWITCH IS NOW ON
	JMP	TEST4		/JUMP IF SWITCH NOT ON
	JMS I	(DISPLAY)	/CALL DISPLAY ROUTINE
	XGPOS			/GALVO X POSITION
	YGPOS			/GALVO Y POSITION
TEST4,	CIF	PCHFLD		/PREVENT LINC INTERRUPTS
	LINC			/GOTO L...MODE

	LMODE			/TELL THE ASSEMBLER ABOUT IT

	SNS I	4		/SKIP IT SWITCH NOT THROWN
	COM			/ELSE COMPLEMENT AC
	PDP			/BACK TO GOODY MODE EITHER WAY

	PMODE			/TELL THE ASSEMBLER ABOUT IT

	SNA CLA			/SKIP IF SWITCH IS ON
	JMP	TEST5		/JUMP IF SWITCH IS OFF
	NL4000			/SET INVERSION BIT
	TAD	XPOS		/NOW HAVE SIGNED X-POSITION
	DCA	DX		/STASH IT
	NL4000			/SET INVERSION BIT
	TAD	YPOS		/NOW HAVE UNSIGNED Y-POSITION
	DCA	DY		/STASH IT
	JMS I	(DISPLAY)	/DISPLAY
	DX			/X-POSITION
	DY			/Y-POSITION
TEST5,	CIF	PCHFLD		/PREVENT LINC INTERRUPTS
	LINC			/GOTO L...MODE

	LMODE			/TELL THE ASSEMBLER ABOUT IT

	SNS I	5		/SKIP IF SWITCH NOT THROWN
	COM			/ELSE COMPLEMENT AC
	PDP			/BACK TO GOODY MODE EITHER WAY

	PMODE			/TELL THE ASSEMBLER ABOUT IT

	SZA CLA			/SKIP IF SWITCH IS OFF
	JMS I	(DISPRELATIVE)	/DISPLAY RELATIVE POSITION IF ON
	JMP	NULJOB		/KEEP GOING

	PAGE
/	INTERRUPTS COME HERE.

INTER,	CLSK			/CLOCK INTERRUPT?
	JMP I	(FOCINT)	/NO, NOT ONE OF OURS
	DCA	AC		/SAVE INTERRUPT AC
	RAL			/GET THE LINK
	DCA	LINK		/SAVE IT
	CLSA			/YES, GET STATUS
	SMA CLA			/SKIP IF CLOCK OVERFLOWED
	HLT			/**** ERROR ****
INTZAP,	NOP/SKP			/SKIP IF CLOCK HANDLING ALLOWED
	JMP I	(INTOUT)	/JUMP IF NO CLOCK TICKS ALLOWED
	ISZ I	(TIMLO)		/COUNT THIS TICK
	SKP			/SKIP IF IT DIDN'T OVERFLOW
	ISZ I	(TIMHI)		/ELSE COUNT MAJOR TICK
	ISZ I	(WATCHLO)	/LOWER WATCH-DOG OVERFLOW?
	JMP	DMOVE/SKP	/JUMP IF NOT
	ISZ I	(WATCHHI)	/HIGHER WATCH-DOG OVERFLOW?
	SKP			/SKIP IF NOT
	DCA	WCHDOG		/TELL BACKGROUND ABOUT IT IF SO

/	MOVE DOWN THE SMOOTHED DATA ONE NOTCH IN PREPARATION FOR THE LATEST SET.

DMOVE,	TAD	X2		/\
	DCA	X3		/ \
	TAD	X1		/  \MOVE DOWN THE
	DCA	X2		/  /X POSITION DATA
	TAD	X0		/ /
	DCA	X1		//
	TAD	Y2		/\
	DCA	Y3		/ \
	TAD	Y1		/  \MOVE DOWN THE
	DCA	Y2		/  /Y POSITION DATA
	TAD	Y0		/ /
	DCA	Y1		//
	TAD	XG2		/\
	DCA	XG3		/ \
	TAD	XG1		/  \MOVE DOWN THE
	DCA	XG2		/  /X GALVO DATA
	TAD	XG0		/ /
	DCA	XG1		//
	TAD	YG2		/\
	DCA	YG3		/ \
	TAD	YG1		/  \MOVE DOWN THE
	DCA	YG2		/  /Y GALVO DATA
	TAD	YG0		/ /
	DCA	YG1		//
/	NOW GET THE LATEST DATA VALUES.

	LINC			/GOTO L...MODE

	LMODE			/TELL THE ASSEMBLER ABOUT IT

	SAM	10		/GET X DATA
	STC	X0		/STASH IT
	SAM	11		/GET Y DATA
	STC	Y0		/STASH IT
	SAM	12		/GET X GALVO DATA
	STC	XG0		/STASH IT
	SAM	13		/GET Y GALVO DATA
	STC	YG0		/STASH IT
	PDP			/BACK TO GOODY MODE

	PMODE			/TELL THE ASSEMBLER ABOUT IT

/	FORM THE (UNSIGNED) X POSITION.

	TAD	X0		/\
	TAD	X1		/ \SUM THE
	TAD	X2		/ /X VALUES
	TAD	X3		//
	JMS	DIV4		/TAKE AVERAGE
	TAD	(4000)		/MAKE IT UNSIGNED
	DCA	XPOS		/STORE X POSITION

/	FORM THE (UNSIGNED) Y POSITION.

	TAD	Y0		/\
	TAD	Y1		/ \SUM THE
	TAD	Y2		/ /Y VALUES
	TAD	Y3		//
	JMS	DIV4		/TAKE AVERAGE
	TAD	(4000)		/MAKE IT UNSIGNED
	DCA	YPOS		/STORE Y POSITION

/	FORM THE X GALVO POSITION.

	TAD	XG0		/\
	TAD	XG1		/ \SUM THE X GALVO
	TAD	XG2		/ /DATA VALUES
	TAD	XG3		//
	JMS	DIV4		/TAKE AVERAGE
	DCA	XGPOS		/STORE X GALVO POSITION

/	FORM THE Y GALVO POSITION.

	TAD	YG0		/\
	TAD	YG1		/ \SUM THE Y GALVO
	TAD	YG2		/ /DATA VALUES
	TAD	YG3		//
	JMS	DIV4		/TAKE AVERAGE
	DCA	YGPOS		/STORE Y GALVO POSITION
/	FORM THE UNSIGNED WINDOW LIMIT VALUES.

	NL4000			/SET INVERSION BIT
	TAD	XGPOS		/GET X GALVO POSITION
	TAD I	(LEFT)		/ADD ON LEFT-HAND PARAMETER
	DCA	LLIMIT		/SAVE AS LEFT-HAND LIMIT
	NL4000			/SET INVERSION BIT
	TAD	XGPOS		/GET X GALVO POSITION
	TAD I	(RIGHT)		/ADD ON RIGHT-HAND PARAMETER
	DCA	RLIMIT		/SAVE AS RIGHT-HAND LIMIT
	NL4000			/SET INVERSION BIT
	TAD	YGPOS		/GET Y GALVO POSITION
	TAD I	(UP)		/ADD ON UPPER PARAMETER
	DCA	ULIMIT		/SAVE AS UPPER LIMIT
	NL4000			/SET INVERSION BIT
	TAD	YGPOS		/GET Y GALVO POSITION
	TAD I	(DOWN)		/ADD ON LOWER PARAMETER
	DCA	DLIMIT		/SAVE AS LOWER LIMIT

/	COMPARE CURRENT POSITION TO WINDOW EDGES.

	TAD	LLIMIT		/GET LEFT-HAND LIMIT
	CLL CIA			/INVERT IT
	TAD	XPOS		/COMPARE TO X POSITION
	SNL CLA			/SKIP IF POSSIBLE
	JMP I	(NOTIN)		/FORGET IT
	TAD	RLIMIT		/GET RIGHT-HAND LIMIT
	CLL CIA			/INVERT IT
	TAD	XPOS		/COMPARE TO X POSITION
	SZL CLA			/SKIP IF POSSIBLE
	JMP I	(NOTIN)		/FORGET IT

/	HORIZONTALLY (AT LEAST) THE POSITION IS OK.

	TAD	ULIMIT		/GET UPPER LIMIT
	CLL CIA			/INVERT IT
	TAD	YPOS		/COMPARE TO Y POSITION
	SZL CLA			/SKIP IF POSSIBLE
	JMP I	(NOTIN)		/FORGET IT
	TAD	DLIMIT		/GET LOWER LIMIT
	CLL CIA			/INVERT IT
	TAD	YPOS		/COMPARE TO Y POSITION
	SNL CLA			/SKIP IF IN THE WINDOW
	JMP I	(NOTIN)		/FORGET IT

/	WE'RE DEFINITELY IN THE WINDOW.

	JMP I	(INTCONTINUE)	/CONTINUE THERE
	PAGE
/	WE ARE IN THE WINDOW, SO CHECK FURTHER.

INTCONT,ISZ I	(INTMLO)	/COUNT THIS TICK AS IN THE WINDOW
	SKP			/SKIP IF IT DIDN'T TURN OVER
	ISZ I	(INTMHI)	/ELSE BUMP HIGH-ORDER
	TAD	IWFLAG		/ARE WE ALREADY IN THE WINDOW?
	SZA CLA			/SKIP IF NOT
	JMP	INALREADY	/JUMP IF SO
	ISZ	IWFLAG		/SET THE FLAG NOW
	DLD;	REWTIME		/GET THE LATEST REWARD TIME
	DCM			/INVERT IT
	DST;	REWCNT		/SAVE FOR COUNTING
	CAM			/CLEAN UP
	TAD I	(BEEPAMT)	/GET DELAY COUNT
	CIA			/WANT NEGATIVE FORM
	DCA	BEEPCNT		/RESET THE COUNTER FOR NEXT TIME
	ISZ I	(INCLO)		/COUNT THIS TRANSITION
	SKP			/SKIP IF IT DIDN'T TURN OVER
	ISZ I	(INCHI)		/ELSE BUMP HIGH-ORDER
	JMP I	(REWCHK)	/CHECK FOR REWARDS, ETC.

/	COMES HERE IF THE WINDOW IS BEING MAINTAINED.

INALREA,ISZ	REWCNT		/DONE ENOUGH?
	SKP			/SKIP IF NOT
	ISZ	REWCNT+1	/DONE ENOUGH?
	JMP I	(REWCHK)	/NO, FORGET IT
	JMS I	(GETNEXT)	/GET NEXT REWARD TIME

/	WE OWE HIM A REWARD, SO DETERMINE WHICH KIND(S).

	ISZ	BEEPCNT		/DO WE JUST BEEP HIM?
	JMP	SETBEEP		/YES, FORGET BETTER REWARD
GIVREWA,TAD I	(BEEPAMT)	/GET DELAY COUNT
	CIA			/WANT NEGATIVE FORM
	DCA	BEEPCNT		/RESET THE COUNTER FOR NEXT TIME
	TAD I	(REWLENGTH)	/GET REWARD TIME LENGTH
	CIA			/WANT NEGATIVE FORM
	DCA	REWPLS		/SETUP REWARD PULSER
	NL0001			/SET RELAY[5] BIT
	JMS I	(SETRELAY)	/TURN THE RELAY ON FOR REWARD
	ISZ I	(LREWLO)	/BUMP LOW-ORDER LIQUID REWARD COUNTER
	SKP			/SKIP IF IT DIDN'T OVERFLOW
	ISZ I	(LREWHI)	/ELSE BUMP HIGH-ORDER LIQUID REWARD COUNTER
	NL0004			/SET RELAY[3] VALUE
	JMS I	(CLRELAY)	/CLEAR THE RELAY
SETBEEP,DLD;	REWTIME		/GET THE LATEST REWARD TIME
	DCM			/INVERT IT
	DST;	REWCNT		/SAVE FOR COUNTING
	TAD I	(BEEPLENGTH)	/GET BEEP TIME LENGTH
	CIA			/WANT NEGATIVE FORM
	DCA	BEEPLS		/SETUP BEEPER PULSER
	NL0002			/SET RELAY[4] BIT
	JMS I	(SETRELAY)	/TURN THE RELAY ON FOR AUDIBLE REWARD
	ISZ I	(AREWLO)	/BUMP LOW-ORDER AUDIBLE REWARD COUNTER
	SKP			/SKIP IF IT DIDN'T OVERFLOW
	ISZ I	(AREWHI)	/ELSE BUMP HIGH-ORDER AUDIBLE REWARD COUNTER
	JMP I	(REWCHK)	/FINISH IT THERE

/	COMES HERE IF NOT IN THE WINDOW.

NOTIN,	LINC			/GOTO L...MODE

	LMODE			/TELL THE ASSEMBLER ABOUT IT

	SNS I	1		/SKIP IF SWITCH NOT THROWN
	COM			/ELSE COMPLEMENT THE AC
	PDP			/BACK TO GOODY MODE EITHER WAY

	PMODE			/TELL THE ASSEMBLER ABOUT IT

	SZA CLA			/SKIP IF SWITCH WAS NOT THROWN
	JMP	GIVREWARD	/ELSE JUST GIVE HIM A REWARD FOR FREE
	TAD	IWFLAG		/GET PRIOR VALUE
	SNA CLA			/SKIP IF WE JUST FELL OUT OF THE WINDOW
	JMP I	(REWCHK)	/JUMP IF WE HAVE BEEN OUT A LONG TIME
	DCA	IWFLAG		/INDICATE FALLEN CONDITION
	ISZ I	(OUTCLO)	/COUNT THIS FAILURE
	SKP			/SKIP IF IT DIDN'T TURN OVER
	ISZ I	(OUTCHI)	/ELSE BUMP HIGH-ORDER
	JMP I	(REWCHK)	/CONTINUE THERE
	PAGE
REWCHK,	TAD	REWPLS		/ARE WE REWARDING?
	SZA CLA			/SKIP IF NOT
	ISZ	REWPLS		/ELSE ARE WE DONE WITH IT?
	JMP	BEEPCHK		/NO, JUST KEEP GOING
	NL0001			/SET RELAY[5] BIT
	JMS I	(CLRELAY)	/TURN THE REWARD OFF
BEEPCHK,TAD	BEEPLS		/ARE WE BEEPING?
	SZA CLA			/SKIP IF NOT
	ISZ	BEEPLS		/ELSE ARE WE DONE WITH IT?
	JMP	R3CHK		/JUMP IF NOT
	NL0002			/SET RELAY[4] BIT
	JMS I	(CLRELAY)	/TURN THE BEEPER OFF
R3CHK,	NL0004			/SET RELAY[3] MASK
	AND	RELAY		/GET THE BIT
	SNA CLA			/SKIP IF RELAY[3] IS ON
	JMP	R3OFF		/JUMP IF RELAY[3] IS OFF
	ISZ	R3CNT		/BUMP LOW-ORDER COUNTER
	SKP			/SKIP IF NO OVERFLOW
	ISZ	R3CNT+1		/ELSE BUMP HIGH-ORDER COUNTER
	JMP	INTXIT		/JUMP IF NO OVERFLOW
	NL0004			/SET RELAY[3] VALUE
	JMS I	(CLRELAY)	/CLEAR THE RELAY
R3OFF,	TAD	HR3CNT		/GET LOW-ORDER COUNT
	SNA			/SKIP IF SIGNIFICANT
	TAD	HR3CNT+1	/ELSE GET HIGH-ORDER
	SNA CLA			/SKIP IF SIGNIFICANT
	JMP	SETR3		/ELSE JUST SET IT
	ISZ	HR3CNT		/BUMP LOW-ORDER COUNTER
	SKP			/SKIP IF NO OVERFLOW
	ISZ	HR3CNT+1	/ELSE BUMP HIGH-ORDER COUNTER
	JMP	INTXIT		/NO CHANGE YET
	DLD;	HR3TIME		/GET HOLD-OFF VARIABLE
	DCM			/WANT NEGATIVE FORM
	DST;	HR3CNT		/SETUP THE HOLD-OFF COUNTER FOR NEXT TIME
SETR3,	DLD;	R3TIME		/GET TIME-OUT VARIABLE
	DCM			/WANT NEGATIVE FORM
	DST;	R3CNT		/SETUP THE TIME-OUT COUNTER
	NL0004			/SET RELAY[3] VALUE
	JMS I	(SETRELAY)	/SET THE RELAY
INTXIT,	CLA			/CLEAN UP

/	COMES HERE WHEN CLOCK INTERRUPTS ARE LOGICALLY DISABLED.

INTOUT,	TAD	LINK		/GET SAVED LINK
	CLL RAR			/RESTORE IT
	TAD	AC		/RESTORE AC

/	COMES HERE WHEN INTERRUPTS COME FROM OTHER THAN THE CLOCK.

FOCINT,	CIF CDF	00		/GOING TO FIELD ZERO
	JMP I	INTRETURN	/REJOIN FOCAL'S INTERRUPT HANDLER

INTRETU,.-.			/WILL BE INTERRUPT ROUTINE POINTER

	PAGE
DISPWIN,.-.			/DISPLAY WINDOW BORDER ROUTINE
DTOP,	TAD I	(LEFT)		/GET LEFT EDGE VALUE
	DCA	DX		/USE FOR INITIAL X-POSITION
	TAD I	(UP)		/GET UPPER EDGE VALUE
	DCA	DY		/USE FOR Y-POSITION
DLP1,	JMS I	(DISPLAY)	/DISPLAY
	DX			/X-POSITION
	DY			/Y-POSITION
	TAD	DX		/GET CURRENT X-POSITION
	CIA			/INVERT FOR TESTING
	TAD I	(RIGHT)		/COMPARE TO RIGHT-HAND LIMIT
	SNA CLA			/SKIP IF NOT AT EDGE YET
	JMP	DBOT		/JUMP IF AT END OF THIS LINE
	ISZ	DX		/BUMP TO NEXT X-POSITION
	JMP	DLP1		/KEEP GOING
	JMP	DLP1		/JUST IN CASE

DBOT,	TAD I	(LEFT)		/GET LEFT EDGE VALUE
	DCA	DX		/USE FOR INITIAL X-POSITION
	TAD I	(DOWN)		/GET LOWER EDGE VALUE
	DCA	DY		/USE FOR Y-POSITION
DLP2,	JMS I	(DISPLAY)	/DISPLAY
	DX			/X-POSITION
	DY			/Y-POSITION
	TAD	DX		/GET CURRENT X-POSITION
	CIA			/INVERT FOR TESTING
	TAD I	(RIGHT)		/COMPARE TO RIGHT-HAND LIMIT
	SNA CLA			/SKIP IF NOT AT EDGE YET
	JMP	DLEFT		/JUMP IF AT END OF THIS LINE
	ISZ	DX		/BUMP TO NEXT X-POSITION
	JMP	DLP2		/KEEP GOING
	JMP	DLP2		/JUST IN CASE

DLEFT,	TAD I	(LEFT)		/GET LEFT EDGE VALUE
	DCA	DX		/USE FOR X-POSITION
	TAD I	(DOWN)		/GET LOWER EDGE VALUE
	DCA	DY		/USE FOR INITIAL Y-POSITION
DLP3,	JMS I	(DISPLAY)	/DISPLAY
	DX			/X-POSITION
	DY			/Y-POSITION
	TAD	DY		/GET CURRENT Y-POSITION
	CIA			/INVERT FOR TESTING
	TAD I	(UP)		/COMPARE TO UPPER LIMIT
	SNA CLA			/SKIP IF NOT AT END OF THIS LINE
	JMP	DRIGHT		/JUMP IF AT END OF THIS LINE
	ISZ	DY		/BUMP TO NEXT Y-POSITION
	JMP	DLP3		/KEEP GOING
	JMP	DLP3		/JUST IN CASE
DRIGHT,	TAD I	(RIGHT)		/GET RIGHT EDGE VALUE
	DCA	DX		/USE FOR X-POSITION
	TAD I	(DOWN)		/GET LOWER EDGE VALUE
	DCA	DY		/USE FOR INITIAL Y-POSITION
DLP4,	JMS I	(DISPLAY)	/DISPLAY
	DX			/X-POSITION
	DY			/Y-POSITION
	TAD	DY		/GET CURRENT Y-POSITION
	CIA			/INVERT FOR TESTING
	TAD I	(UP)		/COMPARE TO UPPER LIMIT
	SNA CLA			/SKIP IF NOT AT END OF THIS LINE
	JMP I	DISPWINDOW	/RETURN IF AT END OF THIS LINE
	ISZ	DY		/BUMP TO NEXT Y-POSITION
	JMP	DLP4		/KEEP GOING
	JMP	DLP4		/JUST IN CASE

/	DISPLAY RELATIVE ANIMAL POSITION ROUTINE.

DISPRE,.-.			/DISPLAY RELATIVE POSITION ROUTINE
	NL4000			/SET SIGN BIT
	TAD	XGPOS		/GET GALVO X-POSITION
	CIA			/INVERT IT
	TAD	XPOS		/ADD ON ANIMAL X-POSITION
	DCA	DX		/SAVE AS RELATIVE X VALUE
	TAD	DX		/GET IT BACK
	TAD	(1000)		/BIAS IT UP
	AND	(6000)		/JUST RANGE BITS
	SNA			/SKIP IF PROBLEMATIC
	JMP	DXOK		/JUMP IF NOT
	SPA CLA			/SKIP IF TOO HIGH
	TAD	(7000-777)	/ELSE USE NEGATIVE VALUE
	TAD	(777)		/GET POSITIVE VALUE
	DCA	DX		/STORE NEW X VALUE
DXOK,	NL4000			/SET SIGN BIT
	TAD	YGPOS		/GET GALVO Y-POSITION
	CIA			/INVERT IT
	TAD	YPOS		/ADD ON ANIMAL Y-POSITION
	DCA	DY		/SAVE ASRELATIVE Y VALUE
	TAD	DY		/GET IT BACK
	TAD	(1000)		/BIAS IT UP
	AND	(6000)		/JUST RANGE BITS
	SNA			/SKIP IF PROBLEMATIC
	JMP	DYOK		/JUMP IF NOT
	SPA CLA			/SKIP IF TOO HIGH
	TAD	(7000-777)	/ELSE USE NEGATIVE VALUE
	TAD	(777)		/GET POSITIVE VALUE
	DCA	DY		/STORE NEW Y VALUE
DYOK,	JMS I	(DISPLAY)	/DISPLAY
	DX			/X-POSITION
	DY			/Y-POSITION
	JMP I	DISPRELATIVE	/RETURN
	PAGE
/	CLEAR RELAYS ROUTINE.

CLRELAY,.-.			/CLEAR RELAYS ROUTINE
	DCA	BCLOP		/STORE IN-LINE
	TAD	RELAY		/GET RELAYS IMAGE
	LINC			/GOTO L...MODE

	LMODE			/TELL THE ASSEMBLER ABOUT IT

	BCL I;	BCLOP,	.-.	/CLEAR PASSED BIT
	ATR			/LOAD THE RELAYS
	PDP			/BACK TO GOODY MODE

	PMODE			/TELL THE ASSEMBLER ABOUT IT

	DCA	RELAY		/SAVE NEW VALUE
	JMP I	CLRELAY		/RETURN

/	SET RELAYS ROUTINE.

SETRELA,.-.			/SET RELAYS ROUTINE
	DCA	BSEOP		/STORE IN-LINE
	TAD	RELAY		/GET RELAYS IMAGE
	LINC			/GOTO L...MODE

	LMODE			/TELL THE ASSEMBLER ABOUT IT

	BSE I;	BSEOP,	.-.	/SET PASSED BIT
	ATR			/LOAD THE RELAYS
	PDP			/BACK TO GOODY MODE

	PMODE			/TELL THE ASSEMBLER ABOUT IT

	DCA	RELAY		/SAVE NEW VALUE
	JMP I	SETRELAY	/RETURN
/	DOUBLE-PRECISION SIMULATOR ROUTINES.

DCOM,	.-.			/COMPLEMENT ROUTINE
	SWP			/GET LOW-ORDER FIRST
	CLL CIA			/INVERT IT
	SWP			/PUT IT BACK
	CMA			/INVERT HIGH-ORDER
	SZL			/CARRY?
	IAC			/YES, SO INCREMENT
	JMP I	DCOM		/RETURN

DLOAD,	.-.			/LOAD ROUTINE
	CAM			/CLEAN UP
	TAD	DLOAD		/GET OUR CALLER
	DCA	DADD		/MAKE IT THEIRS
	SKP			/AND DON'T EXECUTE ADDRESS!
DADD,	.-.			/ADD ROUTINE
	DCA	DCOM		/SAVE HIGH-ORDER
	TAD I	DADD		/GET ARGUMENT
	DCA	DLOAD		/STASH IT
	MQA			/GET LOW-ORDER
	CLL			/INITIALIZE CARRY
	TAD I	DLOAD		/ADD ON LOW-ORDER ARGUMENT
	MQL			/PUT INTO MQ
	ISZ	DADD		/BUMP PAST ARGUMENT
	ISZ	DLOAD		/BUMP TO HIGH-ORDER
	RAL			/GET CARRY
	TAD	DCOM		/RESTORE AC
	TAD I	DLOAD		/ADD ON HIGH-ORDER ARGUMENT
	JMP I	DADD		/RETURN

DSTORE,	.-.			/STORE ROUTINE
	DCA	DCOM		/SAVE AC
	TAD I	DSTORE		/GET ARGUMENT
	DCA	DLOAD		/STASH IT
	MQA			/GET LOW-ORDER
	DCA I	DLOAD		/STORE IT
	ISZ	DSTORE		/BUMP PAST ARGUMENT
	ISZ	DLOAD		/BUMP TO HIGH-ORDER
	TAD	DCOM		/RESTORE AC
	DCA I	DLOAD		/STORE IT
	TAD	DCOM		/RESTORE AC AGAIN
	JMP I	DSTORE		/RETURN
DISPLAY,.-.			/DISPLAY ROUTINE
	TAD I	DISPLAY		/GET X ADDRESS
	DCA	DSTEMP		/STASH IT
	ISZ	DISPLAY		/BUMP TO NEXT
	TAD I	DSTEMP		/GET THE VALUE
	TAD	(1000)		/MAKE IT UNSIGNED
	CLL RAR			/MOVE OVER
	DCA	DALPHA		/STASH X-POSITION
	TAD I	DISPLAY		/GET Y ADDRESS
	DCA	DSTEMP		/STASH IT
	ISZ	DISPLAY		/BUMP PAST ARGUMENT
	TAD I	DSTEMP		/GET THE VALUE
	CLL RAR			/MOVE OVER
	CIF	PCHFLD		/PREVENT LINC INTERRUPTS
	LINC			/GOTO L...MODE

	LMODE			/TELL THE ASSEMBLER ABOUT IT

	DIS	DALPHA		/DISPLAY THE POINT
	PDP			/BACK TO GOODY MODE

	PMODE			/TELL THE ASSEMBLER ALSO

	CLA			/CLEAN UP
	JMP I	DISPLAY		/RETURN

CLKINIT,.-.			/CLOCK INITIALIZE ROUTINE
	TAD	(2100)		/GET 100 KHZ RATE AND MODE 01
	CLLR			/LOAD CONTROL REGISTER
	CLA			/CLEAN UP
	TAD	(0100)		/SET CLOCK OVERFLOW INTERRUPT ENABLE
	CLEN			/LOAD ENABLE REGISTER
	CLA			/CLEAN UP
	TAD	(-1750)		/SETUP THE
	CLAB			/BUFFER/PRESET REGISTER
	CLA			/CLEAN UP
	JMP I	CLKINIT		/RETURN

CLRVARI,.-.			/CLEAR VARIABLES ROUTINE
	CAM			/CLEAN UP
	DST;	TIMLO		/CLEAR CLOCK TIME
	DST;	INTMLO		/CLEAR IN-WINDOW TIME
	DST;	INCLO		/CLEAR INTO-WINDOW TRANSITION COUNTER
	DST;	OUTCLO		/CLEAR OUT-OF-WINDOW TRANSITION COUNTER
	DST;	AREWLO		/CLEAR AUDIBLE REWARD COUNT
	DST;	LREWLO		/CLEAR LIQUID REWARD COUNT
	JMP I	CLRVARIABLES	/RETURN
	PAGE
/	GET NEXT REWARD TIME ROUTINE.

GETNEXT,.-.			/GET NEXT REWARD
	TAD I	(RTNUM)		/GET COUNT OF REWARD TIMES
	SZA CLA			/SKIP IF RANDOM METHOD CHOSEN
	JMP	SEQNEXT		/JUMP IF SEQUENTIAL METHOD CHOSEN
GETRAN,	NL0001			/SET INCREMENT VALUE
	MQL			/LOAD INITIAL INCREMENT
	TAD	(-5)		/SETUP THE
	DCA	RANCNT		/MULTIPLICATION COUNT
RANLUP,	CLL			/CLEAR LINK NOW
	SWP			/GET LOW-ORDER
	TAD I	(SEEDLO)	/ADD ON LOW-ORDER
	SWP			/PUT IT BACK
	SZL			/CARRY?
	IAC			/YES
	TAD I	(SEEDHI)	/ADD ON HIGH-ORDER
	ISZ	RANCNT		/DONE ENOUGH?
	JMP	RANLUP		/NO, KEEP GOING
	DCA I	(SEEDHI)	/YES, STORE NEW HIGH-ORDER
	MQA			/GET LOW-ORDER
	DCA I	(SEEDLO)	/STORE IT
	TAD I	(SEEDLO)	/GET LOW-ORDER
	AND	(376)		/JUST MASK BITS
	TAD	(REWARDS)	/POINT TO MEMBER OF LIST
	DCA	RTPTR		/STASH THE POINTER
	TAD	RTPTR		/GET THE POINTER BACK
	IAC			/POINT TO HIGH-ORDER
	DCA	RANCNT		/STASH HIGH-ORDER POINTER ALSO
	TAD I	RTPTR		/GET LOW-ORDER VARIABLE
	SNA			/SKIP IF SET ALREADY
	TAD I	RANCNT		/ELSE GET HIGH-ORDER VARIABLE
	SNA CLA			/SKIP IF VALID VARIABLE
	JMP	GETRAN		/ELSE GO DO IT AGAIN
	TAD I	RTPTR		/GET LOW-ORDER
	DCA I	(REWTIME)	/STORE IT
	TAD I	RANCNT		/GET HIGH-ORDER
	DCA I	(REWTIME+1)	/STORE IT
	JMP I	GETNEXT		/RETURN
SEQNEXT,TAD I	RTPTR		/GET A LOW-ORDER VALUE
	DCA I	(REWTIME)	/STASH IT
	ISZ	RTPTR		/BUMP TO NEXT
	TAD I	RTPTR		/GET A HIGH-ORDER VALUE
	DCA I	(REWTIME+1)	/STASH IT
	ISZ	RTPTR		/BUMP TO NEXT
	TAD I	(RTNUM)		/GET COUNT OF REWARD TIMES
	CLL RAL			/*2 FOR PAIRS
	TAD	(REWARDS)	/POINT AT END OF LIST
	CIA			/INVERT FOR TEST
	TAD	RTPTR		/COMPARE TO CURRENT POINTER
	SPA CLA			/SKIP IF AT END OF LIST
	JMP I	GETNEXT		/ELSE JUST RETURN
	TAD	(REWARDS)	/RESET THE POINTER
	DCA	RTPTR		/FOR NEXT TIME
	JMP I	GETNEXT		/RETURN

	PAGE
/	VARIABLES AND OTHER PARAMETERS.

	VARS=	.		/VARIABLES, ETC. HERE

/	EXPERIMENT RUNNING TIME.

TIMLO,	.-.			/RUNNING TIME - LOW-ORDER
TIMHI,	.-.			/RUNNING TIME - HIGH-ORDER

/	IN-WINDOW TIME.

INTMLO,	.-.			/IN-THE-WINDOW TIME - LOW-ORDER
INTMHI,	.-.			/IN-THE-WINDOW TIME - HIGH-ORDER

/	TRANSITION COUNTERS.

INCLO,	.-.			/INTO-WINDOW TRANSITION COUNT - LOW-ORDER
