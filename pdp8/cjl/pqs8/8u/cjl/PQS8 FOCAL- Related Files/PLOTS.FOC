C	P?S/8 FOCAL DISPLAY DEMO PROGRAM
C	DISPLAYS SINE(X)/X   [PRACTICAL INPUTS BETWEEN -20 AND +20]
C	LAST EDIT:	03-DEC-1985	11:00:00	CJL
1.10	ERASE
C	VALUES FOR VT-8/E VERSION:
1.20	S MX=-94;S GX=94;S MY=-100;S GY=99;S HOM=29;S EOS=31
C	VALUES FOR VC12, AX08 VERSION:
C 1.20	S MX=-256;S GX=255;S MY=-256;S GY=255
C	SET X AND Y RANGES FROM VERSION-DEPENDENT PARAMETERS
1.25	S XR=GX-MX;S YR=GY-MY
C	INITIALIZE SCREEN AND SCALE LIMITS; GIVE INITIAL BLURB
1.30	S D=FDIS();S MA=-1E40;S MI=-MA;T "P?S/8 FOCAL DISPLAY SINE(X)/X DEMO
1.30	S D=FDIS();S MA=-1E40;S MI=-MA
1.35	T "P?S/8 FOCAL DISPLAY SINE(X)/X DEMONSTRATION PROGRAM"
1.37	T !,"ENTER LIMITS"
C	GET LOWER AND UPPER LIMITS FOR DISPLAY
1.40	A !,?LOWER? ?UPPER? "# OF " ?POINTS?
C	CALCULATE ALL POINTS ONCE TO ESTABLISH DISPLAY BOUNDS
1.50	S IN=(UP-LO)/PO;F X=LO,IN,UP;D 2
C	HAVING FOUND ALL POINTS, NOW DISPLAY THEIR SCALED REPRESENTATIONS
1.60	S YS=MA-MI;S J=-1;F X=LO,IN,UP;D 4
C	FINAL DISPLAY LINES FOR VT-8/E VERSION:
1.70	O F;S D=FIO(HOM)+FIO(EOS)
1.75	T !!!!!,"PLOT OF SINE(X)/X";S D=FIO(-1);O O
C	FINAL DISPLAY LINE FOR VC12, AX08 VERSION:
C 1.70	T !!,"PLOT OF SINE(X)/X"
1.80	QUIT
C	ROUTINE TO FIND THE EXTREME VALUES
2.10	D 3;I (MA-RE)2.6,2.3
2.20	I (RE-MI)2.4
2.30	R
2.40	S MI=RE
2.50	R
2.60	S MA=RE
C	FUNCTION CALCULATION ROUTINE
3.10	S RE=FSIN(X)/X
C	DISPLAY ROUTINE
4.10	S J=J+1;D 3
4.20	S D=FDIS(((J/PO)*XR)+MX,(((RE-MI)/YS)*YR)+MY)
C	"GROWING DISPLAY" LINE FOR VC12, AX08 VERSION
C 4.30	S D=FDIS(1)
