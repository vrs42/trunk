	JMS I	[PRCH		/ :no -- display name
	TAD	(ASCII&"=
	JMS I	[PRCH
	ISZ	TEMP		/ display reg lo wd in data size
	ISZ	TEMP
	TAD I	TEMP
	JMS I	[DYDAT
	ISZ	TEMP		/ bump to next entry
	JMP	DYSHLP		/ do next entry

/ run the Z80 APU and monitor it for a halt or failure
