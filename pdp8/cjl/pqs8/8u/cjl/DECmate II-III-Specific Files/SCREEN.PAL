	260
	138

CIR8,	4
	540
	138

CIR9,	4
	540
	343

CIR10,	4
	260
	343

CIR11,	4
	260
	138

CIR12,	1
	356
	200

CIR13,	12
	280
	0

CIR14,	4
	444
	200

CIR15,	13
OCTAL

CIRCLE,	CIR1
	CIR2
	CIR3
	CIR4
	CIR5
	CIR6
	CIR7
	CIR8
	CIR9
	CIR10
	CIR11
	CIR12
	CIR13
	CIR14
	CIR15
	-1


SCREEN,	FILENAME SCREEN.IN
ALLIGN,	FILENAME ALIGN.MU
COLOR,	FILENAME COLOR.MU

RIS,	33; 143; 0
ALIGN,	33; 133; 77; 65; 150; 33; "#&177; 70; 0
CUROFF,	33; 133; 77; 62; 65; 154; 33; 133; 77; 65; 154; 33; 133; 62; "J&177; 0

CLRTAB,	0
	DARK
	BLUE
	RED
	MAGENT
	GREEN
	CYAN
	YELLOW
	WHITE
	COLBAR		/COLOR BARS.

	ENDCLR		/ALL DONE


