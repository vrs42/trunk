        TAD GRVTP1
        SPA
        CMA
        DCA GRVTP1
        CLA CLL CMA     /EXCLUDE PNTS
        TAD GRVTP1      /WITHIN 20 DOTS
        SPA SNA CLA     /OF CENTR
        JMP I GRAVTY
        TAD GRVTP1
        JMS I SQRT0     /CALCULATE
        LINC            /(X^2+Y^2)^3/2
         LMODE
        MUL
        GRVTP1&1777!4000 /ADDR OF GRVTP1
        ROL 6
        BCL I
        0077
        STA
        GRVTP2&1777
        QAC
        ROR 5
        BCL I
        7700
        PDP
         PMODE
        TAD GRVTP2      /CALCULATE
        JMS I RECIP0    /1/(X^2+Y^2)^3/2
        CLL RAR
        SZL
        CLL IAC
        SPA
        CMA
        DCA GRVTP1
        TAD I XFCPTR    /CALCULATE
        SPA             /X/(X^2+Y^2)^3/2
        TAD MINUS1
        LINC
         LMODE
        MUL
        GRVTP1&1777!4000
        SCR I 1
        PDP
         PMODE
        SZL
        CLL IAC         /ROUND UP
        CIA
        TAD XACCEL
        DCA XACCEL
        TAD I YFCPTR    /CALCULATE
        SPA             /Y/(X^2+Y^2)^3/2
        TAD MINUS1
        LINC




