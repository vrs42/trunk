WBTLP2,	NL7775				/SETUP THE
	DCA	RETRYCT			/RETRY COUNTER
WBTLUP,	JMS I	[CHKUP]			/CHECK FOR <^P>, ETC.
	JMS I	[IOHAND]		/CALL I/O HANDLER
	BTBUFFER			/TRANSFER ADDRESS
WBTFUN,	4^100+WRITE+TBLFLD+.-.		/UNIT BITS WILL BE FILLED IN
	FLWBLK				/RECORD POINTER
	SKP				/SKIP IF BAD
	JMP	WBTOK			/JUMP IF IT WROTE OK
WBTBAD,	ISZ	RETRYCT			/TOO MANY ERRORS?
	JMP	WBTLUP			/NO, TRY AGAIN
	DLD;	FLWBLK			/GET CURRENT BLOCK
	DAD;	FTUPDATE		/UPDATE TO NEXT POSITION
	DST;	FLWBLK			/STORE IT BACK
	CDF	PRGFLD			/GOTO MAIN FIELD
	DST;	FBLK			/SAVE FOR ERROR ROUTINE
	CDF	PR1FLD			/BACK TO OUR FIELD
	DCM				/INVERT IT
	DAD;	FTLBLK			/COMPARE TO LIMIT BLOCK
	MQA				/OR IN LOW-ORDER
	SZA CLA				/SKIP IF AT END
	JMP	WBTLP2			/ELSE TRY AGAIN
	TAD I	(CSTATUS)		/GET I/O STATUS
	SNA				/SKIP IF ANY PROBLEM CURRENTLY
	NL7776				/ELSE MANUFACTURE COMPARE ERROR
	JMS I	[ERRPREXTRA]		/GO COMPLAIN
	WBTMSG				/WITH THIS ERROR BLURB
	JMS I	[ASKRETRY]		/TRY AGAIN?
