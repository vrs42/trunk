	JMS I	(SEEKTRK)	/STARTUP THE SEEK
	SNA CLA			/SKIP IF ERRORS
	JMP	STRTOK		/JUMP IF NONE
SEKERR,	TAD	UNIT		/GET UNIT
	CLL RAL			/*2
	TAD	UNIT		/*3
	RAL			/*6
	TAD	(W0ERRLO-1)	/POINT AT WRITE ERROR
	DCA	XR1		/STASH THE POINTER
	CDF	PR1FLD		/GOTO TABLE FIELD
	ISZ I	XR1		/BUMP LOW-ORDER
	SKP			/SKIP IF NO OVERFLOW
	ISZ I	XR1		/ELSE BUMP HIGH-ORDER
	CDF	PRGFLD		/BACK TO OUR FIELD
SETIDLE,NL0001			/SETUP IDLE VALUE
	DCA I	JOBPTR		/STASH THE VALUE
	JMP I	(COMEXEXIT)	/LEAVE THROUGH HERE

STRTOK,	ISZ I	JOBPTR		/BUMP TO NEXT STATE
	JMP	NXTDRV		/GIVE SOMEONE ELSE A CHANCE

/	TEST IF SEEK IS DONE HERE.

TSTSEK,	CIF	PR1FLD		/GOTO CODE FIELD
	JMS I	(TREADY)	/TEST IF READY
	SNA			/SKIP IF ERRORS
	JMP	STRTOK		/JUMP IF NONE AND READY
	TAD	(-SIPVAL)	/COMPARE TO SEEK IN PROGRESS VALUE
	SNA CLA			/SKIP IF OTHER PROBLEMS
	JMP	NXTDRV		/ELSE GIVE SOMEONE ELSE A CHANCE
	JMP	SEKERR		/COMPLAIN THERE

DRVRDY,	CIF	PR1FLD		/GOTO CODE FIELD
	JMS I	(EXRWCHK)	/GO WRITE AND READ THIS DRIVE
	JMP	SETIDLE		/CONTINUE THERE
