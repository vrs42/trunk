QBTEST,	.-.			/QUICK DRIVE ENABLE TEST ROUTINE
	NL0004			/SET OFFSET
	TAD	QTSTCT		/GET CURRENT COUNT
	DCA	UNIT		/SAVE AS LATEST UNIT
	TAD	QTSTCT		/GET CURRENT COUNT
	DCA	TEMP		/STASH IT
	TAD	(20)		/GET INITIAL BIT VALUE
	CLL RAR			/MOVE OVER
	ISZ	TEMP		/DONE YET?
	JMP	.-2		/NO, KEEP GOING
	AND	EXWORD		/YES, TEST CORRESPONDING ENABLE BIT
	JMP I	QBTEST		/RETURN

ANNMSG,	.-.			/ANNOUNCEMENT ROUTINE
	DCA	ANNMTMP		/SAVE PASSED VALUE
	TAD I	ANNMSG		/GET THE IN-LINE ARGUMENT
	DCA	ANNARG		/STORE IN-LINE
	ISZ	ANNMSG		/BUMP PAST IT
	TAD	ANNSW		/GET ANNOUNCEMENT SWITCH
	SZA CLA			/SKIP IF OFF
	JMP	ANNCIT		/JUMP IF ON
	TAD	ADVSW		/GET ADVANCEMENT SWITCH
	SZA CLA			/SKIP IF OFF
	JMP I	ANNMSG		/FORGET IT
	TAD I	FRSTPTR		/IS THIS THE FIRST TIME FOR THIS DRIVE?
	SNA CLA			/SKIP IF SO
	JMP I	ANNMSG		/ELSE FORGET IT
ANNCIT,	JMS I	[MESSAGE]	/PRINT
ANNARG,	.-.			/THEIR MESSAGE
	ISZ	ANNMTMP		/DO MORE?
	SKP			/SKIP IF SO
	JMP I	ANNMSG		/RETURN IF NOT
	CIF	PR1FLD		/GOTO CODE FIELD
	JMS I	[UNITPRINT]	/PRINT OUT CURRENT UNIT
	CIF	PR1FLD		/GOTO CODE FIELD
	JMS I	[CRLF]		/DO A <CR>, <LF>
	JMP I	ANNMSG		/RETURN

ANNMTMP,.-.			/TEMPORARY
QWTCNT,	.-.			/COUNTER
COMPLAI,.-.				/ERROR REPORTING ROUTINE
	SZA CLA				/SKIP IF NORMAL CASE
