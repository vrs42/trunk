	JMP	DADD+1		/CONTINUE THERE

/	DIVIDE.

DIVIDE,	.-.			/DIVIDE ROUTINE
	DCA	DIVAC		/SAVE PASSED AC
	RDF			/GET PREVAILING FIELD
	TAD	[CDF]		/TURN INTO CDF INSTRUCTION
	DCA	DIVCDF		/SET IT UP
	CDF	PR1FLD		/GOTO OUR FIELD
	TAD I	DIVIDE		/GET ARGUMENT POINTER
	DCA	MDIVSOR		/STASH IT
	ISZ	DIVIDE		/BUMP PAST ARGUMENT
DIVCDF,	.-.			/RESTORE PREVAILING FIELD
	TAD I	MDIVSOR		/GET DIVISOR
	CIA			/WANT NEGATIVE FORM
	DCA	MDIVSOR		/STORE IT
	MQA			/GET LOW-ORDER
	DCA	DIVMQ		/STORE IT
	TAD	(-14)		/SETUP THE
	DCA	DSHIFT		/SHIFT COUNTER
DIVLUP,	TAD	DIVMQ		/GET LOW-ORDER
	CLL RAL			/MOVE UP
	DCA	DIVMQ		/STORE BACK
	TAD	DIVAC		/GET HIGH-ORDER
	RAL			/MOVE UP
	DCA	DIVAC		/STORE BACK
	TAD	DIVAC		/GET IT BACK
	TAD	MDIVSOR		/COMPARE TO DIVISOR
	SZL			/CARRY?
	DCA	DIVAC		/YES, STORE BACK
	SZL CLA			/CARRY?
	ISZ	DIVMQ		/YES, BUMP QUOTIENT
	ISZ	DSHIFT		/DONE ALL YET?
	JMP	DIVLUP		/NO, GO BACK
	TAD	DIVMQ		/GET LOW-ORDER
	MQL			/RESTORE IT
	TAD	DIVAC		/GET REMAINDER
	JMP I	DIVIDE		/RETURN
/	DOUBLE-PRECISION COMPLEMENT.

DCOM,	.-.			/COMPLEMENT ROUTINE
	SWP			/GET LOW-ORDER FIRST
	CLL CIA			/INVERT IT
	SWP			/PUT IT BACK
	CMA			/INVERT HIGH-ORDER
	SZL			/CARRY?
	IAC			/YES, SO INCREMENT
	JMP I	DCOM		/RETURN

/	STORAGE DEFINITIONS FOR DIVIDE ROUTINE.

	DIVAC=	DADD		/DIVIDE AC
	DIVMQ=	DLOAD		/DIVIDE MQ
	MDIVSOR=DCOM		/DIVISOR
	DSHIFT=	DSTORE		/SHIFT COUNTER

/	NUMERIC VALIDATION ROUTINE.

VALNUM,	.-.			/VALIDATE NUMERIC VALUE
	DCA	DATSETUP	/SAVE PASSED VALUE
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	VLNXIT		/STORE IN-LINE
	TAD	DATSETUP	/RESTORE PASSED VALUE
	TAD	(-":!200)	/ADD ON LIMIT
	CLL			/CLEAR LINK FOR TEST
	TAD	(":-"0)		/ADD ON RANGE
	SZL CLA			/SKIP IF BAD
	ISZ	VALNUM		/BUMP RETURN IF GOOD
VLNXIT,	.-.			/WILL BE CIF CDF RETURN FIELD
	JMP I	VALNUM		/RETURN EITHER WAY

/	ALPHABETIC VALIDATION ROUTINE.

VALALPH,.-.			/VALIDATE ALPHABETIC ROUTINE
	DCA	DATSETUP	/SAVE PASSED VALUE
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	VLAXIT		/STORE IN-LINE
	TAD	DATSETUP	/RESTORE PASSED VALUE
	TAD	(-"[!200)	/ADD ON LIMIT
	CLL			/CLEAR LINK FOR TEST
	TAD	("[-"A)		/ADD ON RANGE
	SZL CLA			/SKIP IF BAD
	ISZ	VALALPHA	/BUMP RETURN IF GOOD
VLAXIT,	.-.			/WILL BE CIF CDF RETURN FIELD
	JMP I	VALALPHA	/RETURN EITHER WAY

	PAGE
/	DISPLAY TRACK BUMP ROUTINE.

TRBUMP,	.-.			/BUMP DISPLAY TRACK ROUTINE
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	TRBEXIT		/STORE IN-LINE
	CDF	PRGFLD		/GOTO MAIN FIELD
	NL0002			/SET FLEXIBLE/WINCHESTER DISK MASK
	AND I	[UNIT]		/GET THE BIT
	SNA CLA			/SKIP IF FLEXIBLE DISK
	JMP	TRBWIN		/JUMP IF WINCHESTER DISK
	TAD I	[FLPFRM]	/GET FLEXIBLE DISK FORMAT WORD
	RAR			/SINGLE/DOUBLE-SIDED BIT TO LINK
	SNL CLA			/SKIP IF DOUBLE-SIDED
	JMP	TRBWIN		/JUMP IF SINGLE-SIDED
	ISZ	TBCNT		/BUMP EVEN/ODD COUNTER
	TAD	TBCNT		/GET THE COUNTER
	RAR			/EVEN/ODD BIT TO LINK
	SNL CLA			/SKIP IF NOT TIME TO BUMP
TRBWIN,	ISZ I	[TRACK]		/ELSE BUMP IT NOW
	JMP	TRBEXIT		/RETURN IF NO OVERFLOW
	ISZ I	[TRACK+1]	/ELSE BUMP HIGH-ORDER
TRBEXIT,.-.			/WILL BE CIF CDF CALLING FIELD
	JMP I	TRBUMP		/RETURN TO CALLER

/	GET MEDIA MOUNTED ROUTINE.

MOUNTY,	.-.			/THE MOUNTY ALWAYS GETS HIS MEDIA MOUNTED
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	MNTEXIT		/STORE IN-LINE
	TAD I	MOUNTY		/GET IN-LINE MESSAGE ARGUMENT
	DCA	MOUNARGUMENT	/STORE IN-LINE
	ISZ	MOUNTY		/BUMP PAST ARGUMENT
	CDF	PR1FLD		/INDICATE OUR FIELD
	JMS I	[MSGPRT]	/CALL MESSAGE PRINTING ROUTINE
MOUNARG,.-.			/WILL BE CALLER'S MESSAGE ARGUMENT
	JMS I	[UNITPRINT]	/PRINT OUT THE CURRENT UNIT MESSAGE
	JMS I	(WAITRESPONSE)	/WAIT FOR ANY RESPONSE
	MTRLMSG			/AFTER PRINTING THIS MESSAGE
MNTEXIT,.-.			/WILL BE CIF CDF CALLING FIELD
	JMP I	MOUNTY		/RETURN TO CALLER
/	GET CURRENT DRIVE UNIT READY ROUTINE.

GTREADY,.-.			/GET UNIT READY ROUTINE
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	GTREXIT		/STORE IN-LINE
	TAD I	GTREADY		/GET FLEXIBLE DISK MESSAGE ARGUMENT
	DCA	GTRARGUMENT	/STORE IN-LINE
	ISZ	GTREADY		/BUMP PAST ARGUMENT
	CDF	PRGFLD		/GOTO MAIN FIELD
	NL0002			/SETUP UNIT MASK
	AND I	[UNIT]		/GET FLEXIBLE DISK BIT
	SZA CLA			/SKIP IF WINCHESTER DISK
	JMP	GTRFLX		/JUMP IF FLEXIBLE DISK
	TAD	(WMTMSG)	/GET WINCHESTER DISK ORIENTED MESSAGE ADDRESS
	DCA	GTRARGUMENT	/STORE IN-LINE
GTRFLX,	CDF	PR1FLD		/INDICATE OUR FIELD
	JMS I	(MOUNTY)	/CALL MOUNT ROUTINE
GTRARGU,.-.			/WILL BE APPROPRIATE MESSAGE ARGUMENT
	JMS I	(TREADY)	/FIND OUT IF DRIVE IS READY
	SNA			/SKIP IF NOT
	JMP	GTRDOK		/JUMP IF SO
	JMS I	[ERRPREXTRA]	/GO COMPLAIN
	MNTMSG			/WITH THIS MESSAGE
	JMS I	[ASKRETRY]	/RETRY?
	JMP	GTRFLX		/YES
GFAIL,	CIF CDF	PRGFLD		/GOTO MAIN FIELD
	JMP I	(FAIL)		/FORGET IT

GTRDOK,	JMS I	[MSGPRT]	/TELL THEM
	ISRMSG			/THEY DID IT
GTREXIT,.-.			/WILL BE CIF CDF CALLING FIELD
	JMP I	GTREADY		/RETURN

/	CURRENT UNIT PRINTING ROUTINE.

UNITPRI,.-.			/UNIT PRINT ROUTINE
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	UNPRXIT		/STORE IN-LINE
	CDF	PRGFLD		/GOTO MAIN FIELD
	TAD I	[UNIT]		/GET CURRENT UNIT
	TAD	(UNITABLE)	/ADD ON TABLE BASE
	DCA	TEMP1		/STASH THE POINTER
	CDF	PR2FLD		/GOTO TABLE FIELD
	TAD I	TEMP1		/GET THE MESSAGE ADDRESS
	DCA	.+3		/STORE IN-LINE
	CDF	PR1FLD		/INDICATE OUR FIELD
	JMS I	[MSGPRT]	/CALL MESSAGE PRINTING ROUTINE
	.-.			/WILL BE UNIT-ORIENTED MESSAGE
UNPRXIT,.-.			/WILL BE CIF CDF RETURN FIELD
	JMP I	UNITPRINT	/RETURN
/	BEEPER ROUTINE.

BEEP,	.-.				/BEEPER ROUTINE
	JMS	SETFLD			/SETUP RETURN FIELD
	DCA	BEEPXIT			/STORE IN-LINE
	CDF	PR1FLD			/INDICATE OUR FIELD
	NL0006				/SET <BEL>-1
	IAC				/NOW HAVE <BEL>
	JMS I	[P7CH]			/RING IT
BEEPXIT,.-.				/WILL BE CIF CDF CALLING FIELD
	JMP I	BEEP			/RETURN TO CALLER

/	PERMISSION TO USE MEDIA ROUTINE.

USIT,	.-.				/ASK TO USE IT ROUTINE
	JMS	SETFLD			/SETUP RETURN FIELD
	DCA	USITXIT			/STORE IN-LINE
	CDF	PR1FLD			/INDICATE OUR FIELD
	JMS I	[MSGPRT]		/ASK THEM FOR PERMISSION
	PERMSG				/TO USE CURRENT MEDIA
	JMS I	[YORNO]			/GET REPLY
	ISZ	USIT			/YES, BUMP RETURN ADDRESS
USITXIT,.-.				/WILL BE CIF CDF RETURN FIELD
	JMP I	USIT			/RETURN TO CALLER

/	GET TWO NUMERICS ROUTINE.

GET2,	.-.				/GET VALUE FROM TWO NUMERICS ROUTINE
	CDF	PR1FLD			/ENSURE OUR FIELD
	NL7777				/BACKUP
	TAD I	GET2			/GET PASSED ARGUMENT
	DCA	XR2			/STASH THE POINTER
	ISZ	GET2			/BUMP PAST ARGUMENT
	CDF	TBLFLD			/GOTO TABLE FIELD
	TAD I	XR2			/GET FIRST VALUE
	DCA	GET2TMP			/SAVE IT
	TAD	GET2TMP			/GET IT BACK
	CLL RTL				/*4
	TAD	GET2TMP			/*5
	RAL				/*10
	TAD I	XR2			/ADD ON SECOND VALUE
	CDF	PR1FLD			/BACK TO OUR FIELD
	TAD	(-"0+200^12-"0+200)	/REMOVE ASCII BITS
	JMP I	GET2			/RETURN

GET2TMP,.-.				/TEMPORARY

	PAGE
/	DMA ERROR CODE PRINTING ROUTINE.

ERRDMA,	.-.			/DMA-ORIENTED ERROR ROUTINE
	DCA	ERRVALUE	/SAVE PASSED VALUE
	TAD I	ERRDMA		/GET PASSED ARGUMENT
	DCA	ERMESG		/STORE IN-LINE
	DCA	NOUNIT		/PREVENT UNIT INFORMATION
	NL0001			/SET BUMP FACTOR
	TAD	ERRDMA		/GET OUR CALLER
	JMP	ERXENTRY	/CONTINUE THERE

/	EXTRA ERROR CODE PRINTING ROUTINE.

ERRPREX,.-.			/EXTRA ERROR PRINTING ROUTINE
	DCA	ERRVALUE	/SAVE PASSED VALUE
	TAD I	ERRPREXTRA	/GET PASSED ARGUMENT
	DCA	ERMESG		/STORE IN-LINE
	NL0001			/SET BUMP FACTOR
	TAD	ERRPREXTRA	/GET OUR CALLER
	JMP	ERXENTRY	/CONTINUE THERE

/	EXPANDED ERROR CODE PRINTING ROUTINE.

ERRPRSP,.-.			/SPECIAL ERROR PRINTING ROUTINE
	DCA	ERRVALUE	/SAVE PASSED VALUE
	TAD I	ERRPRSPECIAL	/GET PASSED ARGUMENT
	DCA	ERMESG		/STORE IN-LINE
	DCA	ERSWITCH	/MAKE IT PRINT THE DISK ADDRESS
	NL0001			/SET BUMP FACTOR
	TAD	ERRPRSPECIAL	/GET OUR CALLER
ERXENTR,DCA	ERRPRINT	/MAKE IT THEIRS
	JMP	SPERENTRY	/CONTINUE THERE

/	ERROR CODE PRINTING ROUTINE.

ERRPRIN,.-.			/ERROR CODE PRINT ROUTINE
	DCA	ERRVALUE	/SAVE ERROR CODE
SPERENT,JMS	SETFLD		/SETUP RETURN FIELD
	DCA	ERRPXT		/STORE IN-LINE
	CDF	PR1FLD		/GOTO OUR FIELD
	TAD	ERRVALUE	/GET ERROR CODE
	SNA			/SKIP IF ALREADY SOMETHING
	TAD I	(CSTATUS)	/ELSE GET ERROR STATUS
	DCA	ERRVALUE	/STORE BACK
	JMS I	[CRLF]		/DO A <CR>, <LF>
	JMS I	[MSGPRT]	/CALL MESSAGE PRINT ROUTINE
ERMESG,	NULMSG			/CALLER MESSAGE IF ENABLED
NOUNIT,	SKP			/**** ZAPPED **** 0000
NOBLK,	JMP	NOBLOCK		/PREVENT UNIT INFORMATION
	JMS I	[MSGPRT]	/CALL MESSAGE PRINT ROUTINE
	EROMSG			/GIVE OPENING MESSAGE
	JMS I	[UNITPRINT]	/PRINT CURRENT UNIT
ERSWITC,JMP	NOBLOCK		/**** ZAPPED **** 0000
/	COMES HERE IF DISK ADDRESS IS DESIRED IN PRINTOUT.

	JMS I	[MSGPRT]	/CALL MESSAGE PRINT ROUTINE
	ATBMSG			/TO PRINT THE BLOCK MESSAGE
	CDF	PRGFLD		/GOTO MAIN FIELD
	DLD;	FBLK		/GET THE BLOCK
	CDF	PR1FLD		/BACK TO OUR FIELD
	JMS I	[P7DIGITS]	/PRINT IT
NOBLOCK,JMS I	[MSGPRT]	/CALL MESSAGE PRINT ROUTINE
	ECDMSG			/GIVE ERROR CODE MESSAGE
	TAD	ERRVALUE	/GET ERROR VALUE
	RTL;RTL;RAL		/MOVE DOWN HIGHEST DIGIT
	JMS	PHEX		/PRINT IT
	TAD	ERRVALUE	/GET IT AGAIN
	RTR;RTR			/MOVE DOWN MIDDLE DIGIT
	JMS	PHEX		/PRINT IT
	TAD	ERRVALUE	/GET LOWEST DIGIT
	JMS	PHEX		/PRINT IT
	TAD	[" &177]	/GET A <SPACE>
	JMS I	[P7CH]		/PRINT IT
	TAD	ERRVALUE	/GET ERROR CODE AGAIN
	AND	[177]		/JUST ERROR BITS
	TAD	(ERRTBL)	/POINT TO PARTICULAR ERROR MESSAGE
	DCA	ETEMP		/STASH THE POINTER
	TAD I	ETEMP		/GET THE MESSAGE ADDRESS VALUE
	SNA			/SKIP IF USED
	TAD	(RSVMSG)	/ELSE USED RESERVED MESSAGE
	DCA	ETEMP		/STORE IN-LINE
	TAD	("(&177)	/GET "("
	JMS I	[P7CH]		/PRINT IT
	JMS I	[MSGPRT]	/CALL MESSAGE PRINT ROUTINE
ETEMP,	.-.			/WILL BE PROPER ERROR MESSAGE
	TAD	(")&177)	/GET ")"
	JMS I	[P7CH]		/PRINT IT
	JMS I	[CRLF]		/DO A <CR>, <LF>
	TAD	(NULMSG)	/GET RESET VALUE
	DCA	ERMESG		/RESET OPENING MESSAGE
	TAD	NOBLK		/RESET THE DISK ADDRESS
	DCA	ERSWITCH	/PRINTER TO NOT PRINT
	TAD	(SKP)		/RESET THE
	DCA	NOUNIT		/UNIT INFORMATION SWITCH
ERRPXT,	.-.			/WILL BE CIF CDF CALLING FIELD
	JMP I	ERRPRINT	/RETURN TO CALLER

ERRVALU,.-.			/ERROR CODE STORED HERE
/	DMA ERROR REPORTING ROUTINE.

DMPROBL,.-.			/DMA ERROR ROUTINE
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	DMPRXT		/STORE IN-LINE
	CDF	PR1FLD		/INDICATE OUR FIELD
	JMS I	[MSGPRT]	/TELL THEM
	DMFMSG			/OF DMA FAILURE
	CDF	PRGFLD		/GOTO MAIN FIELD
	DLD;	TSTBUFFER	/GET FULL ADDRESS
	CDF	PR1FLD		/BACK TO OUR FIELD
	JMS I	[P7DIGITS]	/PRINT THE ADDRESS
	JMS I	[CRLF]		/DO A <CR>, <LF>
	JMS I	[ASKRETRY]	/ASK FOR A RETRY
	SKP			/YES, DON'T COMPLAIN YET
	JMP I	[GFAIL]		/FORGET IT
DMPRXT,	.-.			/WILL BE CIF CDF CALLING FIELD
	JMP I	DMPROBLEM	/RETURN TO CALLER

/	HEXADECIMAL DIGIT PRINT ROUTINE.

PHEX,	.-.			/HEX PRINT ROUTINE
	AND	(17)		/JUST HEX DIGIT BITS
	TAD	(-12)		/COMPARE TO DIGIT LIMIT
	SMA			/SKIP IF A DIGIT
	TAD	("A-"0-12)	/ELSE ADJUST TO ALPHA
	TAD	("0&177+12)	/ADD ON DIGIT ADJUST VALUE
	JMS I	[P7CH]		/PRINT IT
	JMP I	PHEX		/RETURN

	PAGE
/	ERROR REPORTING ROUTINE.

TELLERR,.-.			/ERROR REPORT ROUTINE
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	OUTERXIT	/STORE IN-LINE
	CDF	PRGFLD		/GOTO MAIN FIELD
	TAD I	[ERSW]		/GET PRIMARY ERROR SWITCH
	CDF	PR1FLD		/INDICATE OUR FIELD
	SNA CLA			/SKIP IF ANY PRIMARY ERRORS
	JMP	ALTREPORT	/JUMP IF NONE
	JMS I	[MSGPRT]	/TELL THEM THERE WERE
	ERPMSG			/PRIMARY AREA ERRORS
ALTREPO,CDF	PRGFLD		/GOTO MAIN FIELD
	TAD I	[AESW]		/GET ALTERNATE ERROR SWITCH
	CDF	PR1FLD		/INDICATE OUR FIELD
	SNA CLA			/SKIP IF ANY ALTERNATE ERRORS
	JMP	TSTERRORS	/JUMP IF NONE
	JMS I	[MSGPRT]	/TELL THEM THERE WERE
	AERMSG			/ALTERNATE AREA ERRORS
TSTERRO,CDF	PRGFLD		/GOTO MAIN FIELD
	TAD I	[ERSW]		/GET PRIMARY ERROR SWITCH
	SNA			/SKIP IF ANY
	TAD I	[AESW]		/ELSE GET ALTERNATE ERROR SWITCH
	SZA CLA			/SKIP IF NO ERRORS
	JMP	OUTERXIT	/JUMP IF THERE WERE ERRORS
	CDF	PR1FLD		/INDICATE OUR FIELD
	JMS I	[MSGPRT]	/TELL THEM OF
	ROKMSG			/GOOD READ
OUTERXI,.-.			/WILL BE CIF CDF CALLING FIELD
	JMP I	TELLERRORS	/RETURN TO CALLER

/	CARRIAGE RETURN, LINE FEED PRINTING ROUTINE.

CRLF,	.-.			/<CR>, <LF> ROUTINE
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	CRLFXIT		/STORE IN-LINE
	CDF	PR1FLD		/INDICATE OUR FIELD
	TAD	(15)		/GET A <CR>
	JMS I	[P7CH]		/PRINT IT
	TAD	(12)		/GET A <LF>
	JMS I	[P7CH]		/PRINT IT
CRLFXIT,.-.			/WILL BE CIF CDF CALLING FIELD
	JMP I	CRLF		/RETURN
/	TRACK UPDATE ROUTINE.

TRKUPDA,.-.			/TRACK UPDATE ROUTINE
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	TRKUXIT		/STORE IN-LINE
	CDF	PRGFLD		/GOTO MAIN FIELD
	NL0002			/SETUP WINCHESTER/FLEXIBLE DISK MASK
	AND I	[UNIT]		/GET THE BIT
	SNA CLA			/SKIP IF FLEXIBLE DISK
	JMP	TRWINUPDATE	/JUMP IF WINCHESTER DISK
	TAD	FDCNT		/GET FLEXIBLE DISK COUNT
	SKP			/NOT WINCHESTER DISK COUNT
TRWINUP,TAD	WDCNT		/GET WINCHESTER DISK COUNT
	MQL			/PUT INTO LOW-ORDER (MQ)
TRKUXIT,.-.			/WILL BE CIF CDF RETURN FIELD
	JMP I	TRKUPDATE	/RETURN TO CALLER

/	YES OR NO ROUTINE.

YORNO,	.-.			/YES OR NO ROUTINE
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	YORXIT		/STORE IN-LINE
	CDF	PR1FLD		/INDICATE OUR FIELD
YORAGN,	JMS I	[INDEV]		/GET A CHARACTER
	TAD	(-"Y!200)	/COMPARE TO "Y"
	SNA			/SKIP IF OTHERWISE
	JMP	YYES		/JUMP IF IT MATCHES
	TAD	(-"N+"Y)	/COMPARE TO "N"
	SNA CLA			/SKIP IF OTHERWISE
	JMP	YNO		/JUMP IF IT MATCHES
	JMS I	(BEEP)		/BEEP AT THEM ON NO MATCH
	JMP	YORAGN		/TRY AGAIN

YYES,	JMS I	[MSGPRT]	/TELL THEM
	YESMSG			/YES!
	JMP	YORXIT		/TAKE FIRST RETURN

YNO,	JMS I	[MSGPRT]	/TELL THEM
	NOMSG			/NO!
	ISZ	YORNO		/BUMP TO SECOND RETURN
YORXIT,	.-.			/WILL BE CIF CDF CALLING FIELD
	JMP I	YORNO		/RETURN TO CALLER EITHER WAY
/	ASK FOR RETRY ROUTINE.

ASKRETR,.-.			/ASK FOR RETRY ROUTINE
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	ASKEXIT		/STORE IN-LINE
	CDF	PR1FLD		/INDICATE OUR FIELD
	JMS I	[MSGPRT]	/GIVE THEM THE
	RETMSG			/RETRY MESSAGE
	JMS I	[YORNO]		/GET REPLY
	SKP			/YES, DON'T BUMP RETURN
	ISZ	ASKRETRY	/NO, BUMP RETURN ADDRESS
ASKEXIT,.-.			/WILL BE CIF CDF CALLING FIELD
	JMP I	ASKRETRY	/RETURN TO CALLER

/	NUMERIC STRING PRINTING ROUTINE.

NUMPRT,	.-.			/NUMERIC STRING PRINT ROUTINE
	TAD	(NUMTBL-1)	/ADD ON TABLE BASE
	DCA	TEMP1		/STASH THE POINTER
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	NUMPXIT		/STORE IN-LINE
	CDF	PR2FLD		/GOTO TABLE FIELD
	TAD I	TEMP1		/GET THE MESSAGE ADDRESS
	CDF	PR1FLD		/BACK TO OUR FIELD
	DCA	.+2		/STORE IN-LINE
	JMS I	[MSGPRT]	/GIVE THE MESSAGE
	.-.			/FOR PROPER NUMBER
NUMPXIT,.-.			/WILL BE CIF CDF CALLING FIELD
	JMP I	NUMPRT		/RETURN TO CALLER

/	WAIT FOR ANY RESPONSE ROUTINE.

WAITRES,.-.			/WAIT FOR RESPONSE
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	WAITXIT		/STORE IN-LINE
	TAD I	WAITRESPONSE	/GET IN-LINE ARGUMENT
	DCA	WAITARGUMENT	/STORE IN-LINE
	ISZ	WAITRESPONSE	/BUMP PAST ARGUMENT
	CDF	PR1FLD		/INDICATE OUR FIELD
	JMS I	[MSGPRT]	/CALL MESSAGE PRINTING ROUTINE
WAITARG,.-.			/WILL BE PASSED MESSAGE ADDRESS
	JMS I	[INDEV]		/GET ANY RESPONSE
	JMS I	[MSGPRT]	/TELL THEM
	MSGOK			/ALL IS OK
WAITXIT,.-.			/WILL BE CIF CDF CALLING FIELD
	JMP I	WAITRESPONSE	/RETURN

	PAGE
/	SCREEN-ORIENTED MESSAGE PRINT SPECIAL ENTRY POINT.

SCMESSA,.-.			/SCREEN-ORIENTED MESSAGE ENTRY POINT
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	MSGEXIT		/STORE IN-LINE
	TAD	SCMESSAGE	/GET OUR CALLER
	DCA	MSGPRT		/MAKE IT THEIRS
	TAD	(MSGFLD-TBLFLD)	/SETUP OUR
	DCA	MSGOFFSET	/FIELD OFFSET
	TAD	(CDF	TBLFLD)	/SETUP OUR FIELD INSTRUCTION
	JMP	SCMENTRY	/CONTINUE THERE

/	MESSAGE PRINTING ROUTINE.

MSGPRT,	.-.			/MESSAGE PRINT ROUTINE
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	MSGEXIT		/STORE IN-LINE
	TAD	[MS2FLD-MSGFLD]	/SETUP OUR
	DCA	MSGOFFSET	/FIELD OFFSET
	TAD	(CDF	MSGFLD)	/SETUP OUR
SCMENTR,DCA	EXCCDF		/FIELD INSTRUCTION
	TAD	(140)		/SETUP THE DEFAULT
	DCA	MSCASE		/TO LOWER-CASE
	TAD I	MSGPRT		/GET THE PASSED ARGUMENT
	DCA	MSPTR		/STASH THE POINTER
	TAD I	MSGPRT		/GET IT AGAIN
	RAR			/MOVE EVEN/ODD BIT TO LINK
	SZL CLA			/SKIP IF EVEN
	TAD	MSGOFFSET	/ELSE USE NEXT LOGICAL MESSAGE FIELD
	TAD	EXCCDF		/ADD ON BASE FIELD INSTRUCTION
	DCA	EXCCDF		/STORE BACK UPDATED VALUE
MSLOOP,	JMS	DATSETUP	/GOTO MESSAGE FIELD
	TAD I	MSPTR		/GET A PAIR
	RTR;RTR;RTR		/HIGH-ORDER HALF FIRST
	JMS	MSPRNT		/PRINT IT
	JMS	DATSETUP	/GOTO MESSAGE FIELD
	TAD I	MSPTR		/GET IT AGAIN
	JMS	MSPRNT		/PRINT LOWER HALF
	ISZ	MSPTR		/BUMP TO NEXT PAIR
	JMP	MSLOOP		/KEEP GOING

MSEND,	ISZ	MSGPRT		/BUMP PAST ARGUMENT
MSGEXIT,.-.			/WILL BE CIF CDF CALLING FIELD
	JMP I	MSGPRT		/RETURN TO CALLER
MSPRNT,	.-.			/TRIM AND PRINT ROUTINE
	AND	(77)		/JUST SIX-BIT
	SNA			/END OF MESSAGE?
	JMP	MSEND		/YES, RETURN TO MAIN CALLER
	DCA	MSCHAR		/NO, SAVE IT
	CDF	PR1FLD		/GOTO OUR FIELD
	TAD	MSCHAR		/GET THE CHARACTER
	TAD	(-"%!200)	/COMPARE TO "%"
	SNA			/SKIP IF OTHERWISE
	JMP	MSDOCRLF	/JUMP IF IT MATCHES
	TAD	(-"^+100+"%)	/COMPARE TO "^"
	SNA CLA			/SKIP IF OTHERWISE
	JMP	MSCASFLIP	/JUMP IF IT MATCHES
	TAD	MSCHAR		/GET THE CHARACTER AGAIN
	AND	[40]		/JUST QUADRANT BIT
	SNA CLA			/SKIP IF SET
	TAD	MSCASE		/ELSE ADD PREVAILING CASE
	TAD	MSCHAR		/ADD ON THE CHARACTER ITSELF
	JMS I	[P7CH]		/PRINT IT
	JMP I	MSPRNT		/RETURN

MSDOCRL,JMS I	[CRLF]		/DO A <CR>, <LF>
	JMP I	MSPRNT		/RETURN

MSCASFL,TAD	MSCASE		/GET CURRENT CASE
	CIA			/INVERT
	TAD	(140+100)	/ADD ON SUM OF BOTH VALUES
	DCA	MSCASE		/STORE BACK NOW-INVERTED VALUE
	JMP I	MSPRNT		/RETURN

MSGOFFS,.-.			/FIELD OFFSET
MSCASE,	.-.			/MESSAGE CASE
MSCHAR,	.-.			/LATEST CHARACTER
MSPTR,	.-.			/MESSAGE POINTER

/	PRINT MULTIPLE BLANKS ROUTINE.

PBLANK,	.-.			/<SPACE> PRINTING ROUTINE
	DCA	PBLCNT		/SAVE PASSED COUNT
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	PBLXIT		/STORE IN-LINE
	CDF	PR1FLD		/GOTO OUR FIELD
	TAD	[" &177]	/GET A <SPACE>
	JMS I	[P7CH]		/PRINT IT
	ISZ	PBLCNT		/DONE YET?
	JMP	.-3		/NO, KEEP GOING
PBLXIT,	.-.			/WILL BE CIF CDF CALLING FIELD
	JMP I	PBLANK		/YES, RETURN

PBLCNT,	.-.			/COUNTER TEMPORARY
/	INPUT WITH <^U> CHECK ROUTINE.

INDEVUP,.-.			/INPUT WITH <^U> ROUTINE
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	INDVXIT		/STORE IN-LINE
	CDF	PR1FLD		/GOTO OUR FIELD
	JMS I	[INDEV]		/GET A CHARACTER
	TAD	(-"U!300)	/COMPARE TO <^U>
	SNA CLA			/SKIP IF OTHERWISE
	JMP	INUPU		/JUMP IF IT MATCHES
	CDF	PRGFLD		/GOTO MAIN FIELD
	TAD I	[INCHAR]	/GET THE CHARACTER
INDVXIT,.-.			/WILL BE CIF CDF RETURN FIELD
	JMP I	INDEVUPU	/RETURN TO CALLER

INUPU,	TAD	("^&177)	/GET AN "^"
	JMS I	[P7CH]		/PRINT IT
	TAD	("U&177)	/GET A "U"
	JMS I	[P7CH]		/PRINT IT
	JMS I	[CRLF]		/DO A <CR>, <LF>
	CDF	PRGFLD		/GOTO MAIN FIELD
	TAD I	(UPURET)	/GET <^U> ADDRESS
	DCA	INDEVUPU	/SET IT UP
	TAD I	(UPURET+1)	/GET <^U> FIELD
	DCA	INDVXIT		/SET IT UP
	JMP	INDVXIT		/LEAVE THROUGH THERE

	PAGE
/	<^C>, ETC. CHECKING INPUT ROUTINE.

CTLCTST,.-.			/CHECK FOR <^C>, ETC. ROUTINE
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	CTLCXIT		/STORE IN-LINE
	CDF	PRGFLD		/GOTO MAIN FIELD
	DCA I	[INCHAR]	/OBLITERATE OLD CHARACTERS
	KSFIOT			/FLAG UP?
OTHZAP,	JMP	CTLCXIT		/**** ZAPPED **** JMP OTHER
	KRSIOT			/YES IN THE CHARACTER
OTHENT,	AND	(177)		/JUST SEVEN-BIT
	DCA I	[INCHAR]	/SAVE THE CHARACTER
	NL7775			/SETUP -3
	TAD I	[INCHAR]	/COMPARE TO <^C>
	SPA SNA CLA		/SKIP IF GREATER THAN <^C>
	JMP	BUTEXIT		/JUMP IF <^C> OR LESS
	KCCIOT			/CLEAR THE FLAG NOW
	TAD I	[INCHAR]	/GET THE CHARACTER
CTLCXIT,.-.			/WILL BE CIF CDF RETURN FIELD
	JMP I	CTLCTST		/RETURN TO CALLER

BUTEXIT,CIF CDF	PRGFLD		/GOTO MAIN FIELD
	JMP I	[SBOOT]		/GOODBYE!

OTHER,	LKSFIOT			/FLAG UP?
	JMP	CTLCXIT		/NO, FORGET IT
	LKRBIOT			/YES, GET THE CHARACTER
	JMP	OTHENT		/CONTINUE THERE

	OTHJMP=	JMP	OTHER	/ENABLING INSTRUCTION
/	CHECK FOR SPECIAL CHARACTERS ROUTINE.

CHKUP,	.-.			/<^P>, ETC. CHECKING ROUTINE
	JMS	SETFLD		/SETUP RETURN ADDRESS
	DCA	CHKXIT		/STORE IN-LINE
	CDF	PR1FLD		/INDICATE OUR FIELD
	JMS	CTLCTST		/TEST FOR <^C>, ETC.
	SNA			/SKIP IF ANYTHING THERE
	JMP	CHKXIT		/RETURN IF NOT
	TAD	(-"N!300)	/IS IT <^N>?
	SNA			/SKIP IF NOT
	JMP	DOUN		/JUMP IF SO
	TAD	(-"R+"N)	/IS IT <^R>?
	SNA			/SKIP IF NOT
	JMP	DOUR		/JUMP IF SO
	IAC	/TAD	(-"Q+"R)/IS IT <^Q>?
	SNA			/SKIP IF NOT
	JMP	CHKCLR		/JUMP IF SO
	IAC	/TAD	(-"P+"Q)/IS IT <^P>?
	SNA			/SKIP IF NOT
	JMP	DOUP		/JUMP IF SO
	TAD	(-"S+"P)	/IS IT <^S>?
	SZA CLA			/SKIP IF SO
	JMP	CHKXIT		/RETURN IF NOT
	JMS	CTLCTST		/WAIT FOR ANOTHER CHARACTER
	TAD	(-"Q!300)	/IS IT <^Q>?
	SZA CLA			/SKIP IF SO
	JMP	.-3		/JUMP IF NOT
CHKCLR,	CDF	PRGFLD		/GOTO MAIN FIELD
	DCA I	[INCHAR]	/OBLITERATE <^Q>
CHKXIT,	.-.			/WILL BE CIF CDF RETURN FIELD
	JMP I	CHKUP		/RETURN

DOUN,	CDF	PRGFLD		/GOTO MAIN FIELD
	ISZ I	(UNSW)		/INDICATE <^N> HIT
	JMP	CHKCLR		/IGNORE IT FOR NOW

DOUR,	CDF	PRGFLD		/GOTO MAIN FIELD
	ISZ I	(URSW)		/INDICATE <^R> HIT
	JMP	CHKCLR		/IGNORE IT FOR NOW

DOUP,	TAD	("^&177)	/GET AN "^"
	JMS I	[P7CH]		/PRINT IT
	TAD	("P&177)	/GET A "P"
	JMS I	[P7CH]		/PRINT IT
	CDF	PRGFLD		/GOTO MAIN FIELD
	TAD I	(UPREST)	/GET RESTART ADDRESS
	DCA	CHKUP		/SET IT UP
	TAD I	(UPREST+1)	/GET RESTART FIELD
	DCA	CHKXIT		/SET IT UP
	JMP	CHKXIT		/LEAVE THROUGH THERE
	JMP I	UPREST		/RESTART
/	ERROR COUNTING ROUTINE.

CNTERRO,.-.			/COUNT ERRORS ROUTINE
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	CNTERXIT	/STORE IN-LINE
	CDF	PRGFLD		/GOTO MAIN FIELD
	NL0002			/SETUP UNIT MASK
	AND I	[UNIT]		/GET THE BIT
	CDF	PR1FLD		/GOTO OUR FIELD
	SNA CLA			/SKIP IF FLEXIBLE DISK UNIT
	JMP	CNTWINERRORS	/JUMP IF WINCHESTER DISK UNIT
NORMERR,CDF	PR1FLD		/ENSURE OUR FIELD
	JMS	ERRINCREMENT	/BUMP REGULAR ERROR COUNT
CNTERXI,.-.			/WILL BE CIF CDF CALLING FIELD
	JMP I	CNTERRORS	/RETURN TO CALLER

CNTWINE,DLD;	WTRCNT		/GET LOGICAL TRACK COUNT
	DCM			/INVERT FOR TESTING
	CDF	PRGFLD		/GOTO MAIN FIELD
	DAD;	TRACK		/COMPARE TO CURRENT TRACK
	SPA CLA			/SKIP IF TOO FAR
	JMP	NORMERROR	/JUMP IF NOT
	ISZ I	[AESW]		/BUMP ALTERNATE ERROR SWITCH
	JMP	CNTERXIT	/FINISH IT THERE
	NL7777			/SET TO LARGEST IF OVERFLOW
	DCA I	[AESW]		/RESET THE SWITCH
	JMP	CNTERXIT	/FINISH IT THERE

/	SIMPLE ERROR COUNTING ROUTINE.

ERRINCR,.-.			/NORMAL ERROR INCREMENT ROUTINE
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	ERRINXT		/STORE IN-LINE
	CDF	PRGFLD		/GOTO MAIN FIELD
	ISZ I	[ERSW]		/BUMP ERROR COUNTER
	JMP	ERRINXT		/FINISH IT THERE
	NL7777			/RESET TO LARGEST
	DCA I	[ERSW]		/VALUE OF SWITCH
ERRINXT,.-.			/WILL BE CIF CDF RETURN FIELD
	JMP I	ERRINCREMENT	/RETURN TO CALLER

	PAGE
/	CONSOLE INPUT ROUTINE.

INDEV,	.-.			/KEYBOARD INPUT ROUTINE
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	INDEVXIT	/STORE IN-LINE
	CDF	PRGFLD		/GOTO MAIN FIELD
	DCA I	[INCHAR]	/OBLITERATE PREVIOUS CHARACTER
INLOOP,	CDF	PR1FLD		/INDICATE OUR FIELD
	JMS I	[CHKUP]		/CHECK FOR AVAILABLE CHARACTER
	CDF	PRGFLD		/GOTO MAIN FIELD
	TAD I	[INCHAR]	/GET THE LATEST CHARACTER
	SNA			/SKIP IF ANYTHING THERE
	JMP	INLOOP		/GO TRY IT AGAIN
	TAD	(-140)		/SUBTRACT LOWER-CASE LIMIT
	SPA			/SKIP IF LOWER-CASE
	TAD	[40]		/RESTORE IF UPPER-CASE
	TAD	(100)		/RESTORE THE CHARACTER
	DCA I	[INCHAR]	/SAVE IT
	TAD I	[INCHAR]	/GET IT BACK
INDEVXI,.-.			/WILL BE CIF CDF CALLING FIELD
	JMP I	INDEV		/RETURN TO CALLER

/	PRIMARY TERMINAL OUTPUT ROUTINE.

P7CH,	.-.			/TERMINAL OUTPUT ROUTINE
	DCA	P7TEMP		/SAVE PASSED CHARACTER
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	P7XIT		/STORE IN-LINE
	CDF	PR1FLD		/INDICATE OUR FIELD
P7LOOP,	TAD	P7TEMP		/GET THE CHARACTER BACK
P7LPZAP,NOP			/**** LPT: OUTPUT **** JMP P7PRT
	TSFIOT			/FLAG UP?
	JMP	P7TEST		/NO, TRY THE KEYBOARD
	TLSIOT			/PRINT THE CHARACTER
P7ZAP,	NOP			/**** LPT: ECHO **** JMS P7LPT
P7LBAK,	JMS I	[CHKUP]		/CHECK INPUT FLAGS AND CLEAN UP
P7XIT,	.-.			/WILL BE CIF CDF CALLING FIELD
	JMP I	P7CH		/RETURN

P7TEST,	JMS I	[CHKUP]		/CHECK FOR <^S>, ETC.
	JMP	P7LOOP		/GO CHECK OUTPUT DONE FLAG AGAIN

/	COMES HERE IF OUTPUTTING TO LPT: INSTEAD OF TTY:.

P7PRT,	JMS	P7LPT		/OUTPUT TO LPT: INSTEAD
	JMP	P7LBAK		/FINISH IT THERE

P7TEMP,	.-.			/TEMPORARY
/	LPT: ENABLE ROUTINE.

LPTENAB,.-.			/LPT: ENABLE
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	LPTENXIT	/STORE IN-LINE
	TAD	(JMP	P7PRT)	/SETUP THE
	DCA	P7LPZAP		/LPT: ZAP
LPTENXI,.-.			/WILL BE CIF CDF CALLING FIELD
	JMP I	LPTENABLE	/RETURN TO CALLER

/	LPT: DISABLE ROUTINE.

LPTDISA,.-.			/LPT: DISABLE
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	LPTDSXIT	/STORE IN-LINE
	TAD	(NOP)		/RESTORE THE
	DCA	P7LPZAP		/LPT: ZAP
LPTDSXI,.-.			/WILL BE CIF CDF CALLING FIELD
	JMP I	LPTDISABLE	/RETURN TO CALLER

/	SCREEN-ORIENTED OR HARDCOPY <FF> ROUTINE.

SCFF,	.-.			/<FF> ROUTINE
	CLA			/CLEAN UP JUST IN CASE
	CDF	PR1FLD		/GOTO OUR FIELD
	XLIST	OFF
	IFZERO	1-NOFORM+VT100	<
	XLIST	ON
	ZBLOCK	32		/WASTE SOME SPACE
	XLIST	OFF		>
	IFZERO	NOFORM		<
	XLIST	ON
	TAD	(14)		/GET A <FF>
	JMS I	[P7CH]		/PRINT IT
	ZBLOCK	30		/WASTE SOME SPACE
	XLIST	OFF		>
	IFNZRO	VT100		<
	XLIST	ON
	TAD	(33)		/GET AN <ESC>
	JMS I	[P7CH]		/SEND IT
	TAD	("[&177)	/GET "["
	JMS I	[P7CH]		/SEND IT
	TAD	("H&177)	/GET "H"
	JMS I	[P7CH]		/SEND IT
	TAD	(-1000)		/SETUP THE
	DCA	TEMP1		/WASTE COUNTER
KWTLUP,	JMS I	[CHKUP]		/CHECK FOR KEYBOARD INPUT
	CDF	PRGFLD		/GOTO MAIN FIELD
	TAD I	[INCHAR]	/GET INPUT BUFFER
	CDF	PR1FLD		/BACK TO OUR FIELD
	SZA CLA			/SKIP IF NOTHING CAME IN
	JMP	KEYDONE		/JUMP IF THEY HIT SOMETHING
	TAD	(-1000)		/SETUP THE
	DCA	XR2		/COUNTER
	ISZ	XR2		/WASTED ENOUGH TIME?
	JMP	.-1		/NO, KEEP GOING
	ISZ	TEMP1		/WAITING LONG ENOUGH?
	JMP	KWTLUP		/NO, TRY AGAIN
KEYDONE,TAD	(33)		/GET AN <ESC>
	JMS I	[P7CH]		/SEND IT
	TAD	("[&177)	/GET "["
	JMS I	[P7CH]		/SEND IT
	TAD	("J&177)	/GET "J"
	JMS I	[P7CH]		/SEND IT
	XLIST	OFF		>
	XLIST	ON
	CIF CDF	PRGFLD		/GOTO MAIN FIELD
	JMP I	SCFF		/RETURN
/	LPT: OUTPUT ROUTINE.

P7LPT,	.-.			/LPT: OUTPUT ROUTINE
	DCA	P7TEMP		/SAVE PASSED VALUE
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	P7LXIT		/STORE IN-LINE
	CDF	PR1FLD		/INDICATE OUR FIELD
	JMP	P7LTST		/JUMP INTO IT

P7LUP,	TAD	P7TEMP		/GET THE CHARACTER
	LSFIOT			/FLAG UP?
	JMP	P7LTST		/NO, TRY OTHER DIRECTION
	LLSIOT			/YES, SEND IT
	JMS I	[CHKUP]		/CHECK OTHER FLAGS AND CLEAR AC
P7LXIT,	.-.			/WILL BE CIF CDF RETURN FIELD
	JMP I	P7LPT		/RETURN

P7LTST,	JMS I	[CHKUP]		/CHECK OTHER FLAGS AND CLEAR AC
	LKSFIOT			/INPUT FLAG UP?
	JMP	P7LUP		/NO, TRY OUTPUT FLAG AGAIN
	LKRBIOT			/YES, GET THE CHARACTER
	AND	[177]		/JUST SEVEN-BIT
	TAD	(-"S!300)	/COMPARE TO <^S>
	SZA CLA			/SKIP IF IT MATCHES
	JMP	P7LUP		/JUMP IF NOT
P7LWAT,	LKSFIOT			/INPUT FLAG UP?
	JMP	P7LCHK		/NO, TRY OTHERS
	LKRBIOT			/YES, READ IT IN
	AND	[177]		/JUST SEVEN-BIT
	TAD	(-"Q!300)	/COMPARE TO <^Q>
	SZA CLA			/SKIP IF IT MATCHES
	JMP	P7LWAT		/JUMP IF NOT
	JMP	P7LTST		/CHECK FOR OTHERS AND RESUME OUTPUT WAIT

P7LCHK,	JMS I	[CHKUP]		/CHECK OTHERS
	JMP	P7LWAT		/WAIT FOR OUR INPUT AGAIN

	PAGE
/	SEVEN DIGIT DECIMAL PRINT ROUTINE.

P7DIGIT,.-.			/PRINT DECIMAL SEVEN DIGITS ROUTINE
	DCA	P7TMP+1		/SAVE HIGH-ORDER
	MQA			/GET LOW-ORDER
	DCA	P7TMP		/SAVE IT
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	P7DXIT		/STORE IN-LINE
	CDF	PR1FLD		/GOTO OUR FIELD
	TAD	(P7BUF+7-1)	/SETUP THE
	DCA	P7PTR		/OUTPUT POINTER
	TAD	(-7)		/SETUP THE
	DCA	P7CNT		/OUTPUT COUNT
P7DLUP,	TAD	P7TMP+1		/GET HIGH-ORDER
	MQL			/SETUP AS LOW-ORDER DIVIDEND
	DVI;	(12)		/DIVIDE BY TEN
	SWP			/GET QUOTIENT
	DCA	P7TMP+1		/SAVE AS NEW HIGH-ORDER
	TAD	P7TMP		/GET LOW-ORDER
	SWP			/NOW HAVE OLD REMAINDER.LOW-ORDER
	DVI;	(12)		/DIVIDE BY TEN
	DCA I	P7PTR		/STORE IN BUFFER
	MQA			/GET LOW-ORDER QUOTIENT
	DCA	P7TMP		/SAVE AS NEW LOW-ORDER
	NL7777			/BACKUP THE
	TAD	P7PTR		/OUTPUT POINTER
	DCA	P7PTR		/STORE BACK
	ISZ	P7CNT		/DONE SIX YET?
	JMP	P7DLUP		/NO, KEEP GOING
	TAD	(P7BUF-1)	/YES, POINT AT
	DCA	XR1		/OUTPUT BUFFER
	TAD	(-7)		/SETUP THE
	DCA	P7CNT		/OUTPUT COUNTER
P7OTLP,	TAD I	XR1		/GET A DIGIT
	TAD	("0&177)	/MAKE IT ASCII
	JMS I	[P7CH]		/PRINT IT
	ISZ	P7CNT		/DONE YET?
	JMP	P7OTLP		/NO, KEEP GOING
P7DXIT,	.-.			/WILL BE CIF CDF CALLING FIELD
	JMP I	P7DIGITS	/YES, RETURN

P7BUF,	ZBLOCK	7		/OUTPUT BUFFER
P7CNT,	.-.			/OUTPUT COUNTER
P7PTR,	.-.			/OUTPUT POINTER
P7TMP,	ZBLOCK	2		/PASSED VALUE STORED HERE
/	CHECK IF FLAW MAP IS VALID ROUTINE.

TABCHK,	.-.			/FLAW TABLE CHECK ROUTINE
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	TABCXIT		/STORE IN-LINE
	CDF	PR1FLD		/INDICATE OUR FIELD
	JMS	FLUCHK		/CHECK IF FLAW UNIT IS VALID
	SKP			/SKIP IF NOT
	JMP	TBUNOK		/JUMP IF OK
TABADXI,CIF CDF	PRGFLD		/GOTO MAIN FIELD
	JMP I	(EDFAGN)	/RESTART IF FLAW UNIT NOT VALID

TBUNOK,	JMS I	(RBTTBL)	/TRY TO READ IN THE TABLE
	CDF	PRGFLD		/GOTO MAIN FIELD
	TAD I	(TVSW)		/GET TABLE VALIDITY SWITCH
	SMA CLA			/SKIP IF BAD
	JMP	TABCXIT		/JUMP IF TABLE IS GOOD
	CDF	PR1FLD		/BACK TO OUR FIELD
	TAD I	(CSTATUS)	/GET I/O STATUS
	SNA CLA			/SKIP IF BAD
	JMP	TABBAD		/JUMP IF JUST INVALID
	JMS I	[MSGPRT]	/TELL THEM
	FMEMSG			/WE CAN'T EVEN READ IT
	JMP	TABADXIT	/FINISH IT THERE

TABBAD,	JMS I	[MSGPRT]	/CALL MESSAGE PRINTING ROUTINE
	TBDMSG			/TELL THEM TABLE IS BAD
	JMP	TABADXIT	/FINISH IT THERE

TABCXIT,.-.			/WILL BE CIF CDF CALLING FIELD
	JMP I	TABCHK		/RETURN TO CALLER

/	CHECK FOR FLAW UNIT AVAILABILITY ROUTINE.

FLUCHK,	.-.			/FLAW ROUTINE UNIT CHECK
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	FLUEXIT		/STORE IN-LINE
	CDF	PRGFLD		/GOTO MAIN FIELD
	TAD I	(FLWUNIT)	/GET CURRENT FLAW UNIT VALUE
	SMA			/SKIP IF BAD
	JMP	FLUOK		/JUMP IF OK
	CDF	PR1FLD		/INDICATE OUR FIELD
	JMS I	[MSGPRT]	/TELL THEM THERE WAS
	FNIMSG			/NO INITIALIZED UNIT
	JMP	FLUEXIT		/TAKE BAD RETURN

FLUOK,	DCA I	[UNIT]		/SETUP OTHERS
	ISZ	FLUCHK		/BUMP TO GOOD RETURN
FLUEXIT,.-.			/WILL BE CIF CDF CALLING FIELD
	JMP I	FLUCHK		/RETURN
/	MEMORY CONFIGURATION PRINT ROUTINE.

MEMPRT,	.-.			/PRINT MEMORY CONFIGURATION
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	MEMXIT		/STORE IN-LINE
	CDF	PR1FLD		/GOTO OUR FIELD
	JMS I	[CRLF]		/DO A <CR>, <LF>
	TAD	(KD1-1)		/POINT AT MEMORY DIGITS
	DCA	XR1		/STASH THE POINTER
MEMLUP,	TAD I	XR1		/GET A DIGIT
	SPA			/SKIP IF POSSIBLE
	JMP	MEMOVER		/JUMP IF DONE
	TAD	(-" !200)	/COMPARE TO <BLANK>
	SNA			/SKIP IF OTHERWISE
	JMP	MEMDONT		/JUMP IF IT MATCHES
	TAD	[" &177]	/RESTORE THE CHARACTER
	CDF	PR1FLD		/BACK TO OUR FIELD
	JMS I	[P7CH]		/PRINT IT
MEMDONT,ISZ	XR2		/DONE ENOUGH?
	JMP	MEMLUP		/NO, KEEP GOING
MEMOVER,JMS I	[MSGPRT]	/TELL THEM
	KAVMSG			/AVAILABLE MEMORY MESSAGE
MEMXIT,	.-.			/WILL BE CIF CDF RETURN FIELD
	JMP I	MEMPRT		/RETURN TO CALLER

	PAGE
/	GET SURE RESPONSE ROUTINE.

RUSURE,	.-.			/SURE RESPONSE ROUTINE
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	RUSXIT		/STORE IN-LINE
	TAD I	RUSURE		/GET IN-LINE MESSAGE POINTER
	DCA	RUSINLINE	/STORE IN-LINE
	ISZ	RUSURE		/BUMP PAST ARGUMENT
	CDF	PR1FLD		/GOTO OUR FIELD
	JMS I	[MSGPRT]	/ASK THEM THE
RUSINLI,.-.			/PASSED QUESTION
	JMS I	[YORNO]		/GET THE RESPONSE
	SKP			/SKIP IF YES
	JMP	RUSXIT		/ELSE TAKE IMMEDIATE RETURN
	JMS I	[MSGPRT]	/ASK THEM IF
	RUSMSG			/THEY ARE SURE
	JMS I	[YORNO]		/GET THE RESPONSE
	ISZ	RUSURE		/BUMP RETURN IF YES
RUSXIT,	.-.			/WILL BE CIF CDF RETURN FIELD
	JMP I	RUSURE		/RETURN EITHER WAY

/	FLAW ENTRY PRINT ROUTINE.

PRTFLAW,.-.			/FLAW PRINTING ROUTINE
	DCA	PRFTEMP		/STORE HIGH-ORDER
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	PRTFXIT		/STORE IN-LINE
	CDF	PR1FLD		/GOTO OUR FIELD
	TAD	PRFTEMP		/GET IT BACK
	AND	(1777)		/REMOVE FLAG BITS
	JMS I	[P7DIGITS]	/PRINT IT
	NL2000			/SET MASK
	AND	PRFTEMP		/GET ALTERNATE BIT
	SZA CLA			/SKIP IF NORMAL ENTRY
	JMP	FPRTALTERNATE	/JUMP IF ALTERNATE BAD SPOT
	JMS I	[MSGPRT]	/PRINT THE
	BETMSG			/BRIDGING MESSAGE
	DLD;	FLWBLK		/GET THE REPLACEMENT ADDRESS
	JMS I	[P7DIGITS]	/PRINT THE ADDRESS
FPRCOMM,TAD	PRFTEMP		/GET HIGH-ORDER AGAIN
	SMA CLA			/SKIP IF FACTORY JOB
	JMP	NOTFCT		/JUMP IF USER
	JMS I	[MSGPRT]	/TELL THEM
	FACMSG			/FACTORY DID IT
NOTFCT,	JMS I	[CRLF]		/DO A <CR>, <LF>
PRTFXIT,.-.			/WILL BE CIF CDF CALLING FIELD
	JMP I	PRTFLAW		/RETURN TO CALLER

FPRTALT,JMS I	[MSGPRT]	/TELL THEM
	BATMSG			/THIS IS A BAD ALTERNATE SPOT
	JMP	FPRCOMMON	/CONTINUE THERE
/	SET SECTOR SIZE ROUTINE.

SETSECT,.-.			/SET SECTOR SIZE
	DCA	SETSBLK		/SAVE PASSED HIGH-ORDER BLOCK
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	SETSXIT		/STORE IN-LINE
	CDF	PRGFLD		/GOTO MAIN FIELD
	NL0002			/SETUP UNIT MASK
	AND I	[UNIT]		/GET THE BIT
	SNA CLA			/SKIP IF FLEXIBLE DISK UNIT
	JMP	SETSWIN		/JUMP IF WINCHESTER DISK UNIT
	NL7776			/SETUP FORMAT MASK
	AND I	[FLPFRM]	/GET FORMAT TYPE
	TAD	(-6)		/COMPARE TO PROBLEMATIC VALUE
	SZA CLA			/SKIP IF POSSIBLE PROBLEM
	JMP	SETNFLX		/JUMP IF NO PROBLEM
	TAD	SETSBLK		/GET PASSED HIGH-ORDER BLOCK
	MQA			/OR IN LOW-ORDER BLOCK
	SZA CLA			/SKIP IF TRULY ZERO
	JMP	SETNFLX		/JUMP IF NO PROBLEM
	TAD	FLXSIZE		/GET NORMAL SIZE
	CLL RAR			/%2
	SKP			/DON'T USE NORMAL SIZE!
SETNFLX,TAD	FLXSIZE		/GET FLEXIBLE DISK SIZE
	SKP			/DON'T USE WINCHESTER SIZE!
SETSWIN,TAD	WINSIZE		/GET WINCHESTER DISK SIZE
SETSXIT,.-.			/WILL BE CIF CDF RETURN FIELD
	JMP I	SETSECTORSIZE	/RETURN TO CALLER

PRFTEMP,.-.			/TEMPORARY
SETSBLK,.-.			/PASSED HIGH-ORDER BLOCK SAVED HERE
/	COMMON READ SETUP ROUTINE.

RDSETUP,.-.			/READ SETUP ROUTINE
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	RDSXIT		/STORE IN-LINE
	CDF	PRGFLD		/GOTO MAIN FIELD
	DCA I	[FBLK]		/CLEAR OUT
	DCA I	[FBLK+1]	/LOGICAL BLOCK
	DCA I	[TRACK]		/CLEAR DISPLAY TRACK
	DCA	TBCNT		/CLEAR EVEN/ODD INDICATOR
	DCA I	[ERSW]		/CLEAR PRIMARY ERROR SWITCH
	DCA I	[AESW]		/CLEAR ALTERNATE ERROR SWITCH
	NL0002			/SETUP UNIT MASK
	AND I	[UNIT]		/GET THE BIT
	SNA CLA			/SKIP IF FLEXIBLE DISK UNIT
	JMP	WRDSETUP	/JUMP IF WINCHESTER DISK UNIT
	TAD I	[FLPFRM]	/GET FLEXIBLE DISK FORMAT WORD
	CDF	PR1FLD		/GOTO OUR FIELD
	RAR			/SIDE BIT TO LINK
	SNL CLA			/SKIP IF DOUBLE-SIDED DISK
	JMP	RDFSNGL		/JUMP IF SINGLE-SIDED DISK
	DLD;	FTRCNT		/GET BASIC TRACK COUNT
	SWP			/LOW-ORDER FIRST
	CLL RAL			/*2
	SWP			/GET HIGH-ORDER
	RAL			/MOVE UP
RDSCOMM,CDF	PRGFLD		/GOTO MAIN FIELD
	DCM			/INVERT IT
	DST;	TRKCNT		/STORE AS TRACK COUNTER
	CAM			/CLEAN UP
RDSXIT,	.-.			/WILL BE CIF CDF CALLING FIELD
	JMP I	RDSETUP		/RETURN TO CALLER

RDFSNGL,DLD;	FTRCNT		/GET FLEXIBLE DISK TRACK COUNT
	JMP	RDSCOMMON	/CONTINUE THERE

WRDSETU,CDF	PR1FLD		/GOTO OUR FIELD
	DLD;	WTRCNT		/GET LOGICAL TRACK COUNT
	JMP	RDSCOMMON	/CONTINUE THERE

	PAGE
/	MEDIA DATA STATUS ROUTINE.

DATASTA,.-.				/MOUNTED MEDIA STATUS ROUTINE
	DCA	DSSW			/SAVE ERROR MESSAGE SWITCH
	JMS	SETFLD			/SETUP RETURN FIELD
	DCA	DATEXIT			/STORE IN-LINE
	CDF	PR1FLD			/GOTO OUR FIELD
	JMS I	[MSGPRT]		/GIVE THEM THE
	STATMSG				/STATUS MESSAGE
	JMS I	[UNITPRINT]		/IDENTIFY THE DRIVE
	TAD	(":&177)		/GET A ":"
	JMS I	[P7CH]			/PRINT IT
	CDF	PRGFLD			/GOTO MAIN FIELD
	DCA I	[FBLK]			/CLEAR OUT
	DCA I	[FBLK+1]		/LOGICAL BLOCK
	CDF	PR1FLD			/BACK TO OUR FIELD
	JMS I	(RTRACK)		/READ TRACK ZERO IN
	SNA CLA				/SKIP IF ERRORS
	JMP	DATAOK			/JUMP IF NONE
	ISZ	DSSW			/SKIP IF SPECIAL CALLER
	TAD	(CNTRMSG-CNTR2MSG)	/ELSE USE STANDARD MESSAGE
	TAD	(CNTR2MSG)		/GET SPECIAL MESSAGE ADDRESS
	DCA	DATINLINE		/STORE IN-LINE
	JMS I	[MSGPRT]		/CALL MESSAGE PRINTING ROUTINE
DATINLI,CNTRMSG	/OR CNTR2MSG		/CORRECT MESSAGE AS NECESSARY
	NL4000				/INDICATE UNREADABILITY
DSCOMMO,DCA	DSSW			/SAVE EXIT STATUS FOR NOW
	CDF	PRGFLD			/GOTO MAIN FIELD
	NL0002				/SETUP UNIT MASK
	AND I	[UNIT]			/GET THE BIT
	CDF	PR1FLD			/BACK TO OUR FIELD
	SZA CLA				/SKIP IF WINCHESTER UNIT
	JMP	DSGONE			/JUMP IF FLEXIBLE DISK UNIT
	JMS I	(RBTTBL)		/ATTEMPT TO READ IN FLAW MAP
	CDF	PRGFLD			/GOTO MAIN FIELD
	TAD I	(TVSW)			/GET VALIDITY SWITCH
	CDF	PR1FLD			/BACK TO OUR FIELD
	SMA CLA				/SKIP IF INVALID
	JMP	DSTBGUD			/JUMP IF OK
	TAD I	(CSTATUS)		/GET I/O STATUS
	SNA CLA				/SKIP IF BAD
	JMP	DSTBAD			/JUMP IF NOT
	JMS I	[MSGPRT]		/TELL THEM
	FMEMSG				/WE CAN'T EVEN READ IT
	JMP	DSGONE			/FORGET IT

DSTBGUD,JMS I	[MSGPRT]		/TELL THEM
	TGDMSG				/FLAW MAP IS OK
	JMP	DSGONE			/FINISH IT THERE

DSTBAD,	JMS I	[MSGPRT]		/TELL THEM
	TBDMSG				/FLAW MAP IS BAD
DSGONE,	TAD	DSSW			/RESTORE EXIT STATUS
DATEXIT,.-.				/WILL BE CIF CDF RETURN FIELD
	JMP I	DATASTATUS		/RETURN TO CALLER
DATAOK,	CAM				/CLEAN UP
	JMS I	[SETSECTORSIZE]		/GET TRACK ZERO SECTOR SIZE ON CURRENT UNIT
	DCA	DATCTR			/STORE LOW-ORDER
	DCA	DATCTR+1		/CLEAR HIGH-ORDER
	NL7777				/BACKUP
	TAD	DATCTR			/NOW HAVE DATA MASK
	DCA	DMASK			/STORE IT
	JMS I	[TRKUPDATE]		/GET UPDATE FACTOR
	SWP				/GET IT WHILE CLEARING MQ
	CIA				/INVERT FOR COUNTING
	DCA	DATEST			/STASH THE COUNTER
	DAD;	DATCTR			/ADD ON CURRENT SECTOR SIZE
	ISZ	DATEST			/DONE ALL SECTORS?
	JMP	.-3			/NO, KEEP GOING
	DCM				/WANT NEGATIVE FORM
	DST;	DATCTR			/STORE AS DATA COUNTER
	NL7777				/SETUP THE
	DCA	XR1			/DATA POINTER
	TAD	(CDF	DATFLD-10)	/SETUP
	DCA	DATFIELD		/INITIAL FIELD
	CDF	DATFLD			/GOTO INITIAL DATA FIELD
	TAD I	[5]			/GET FIRST WORD
	CIA				/INVERT FOR TESTING
	DCA	DATEST			/STORE FOR COMPARISON LATER
DATALUP,TAD	XR1			/GET THE POINTER
	AND	DMASK			/JUST RELATIVE BITS
	CIA				/INVERT FOR TEST
	TAD	DMASK			/COMPARE TO END VALUE
	SZA CLA				/SKIP IF AT END
	JMP	DATFIELD		/JUMP IF NOT
	TAD	XR1			/GET POINTER AGAIN
	CMA				/INVERT FOR TEST
	SZA CLA				/SKIP IF AT END OF FIELD
	JMP	DATABMP			/JUMP IF NOT
	TAD	DATFIELD		/GET CURRENT DATA FIELD INSTRUCTION
	TAD	[10]			/BUMP TO NEXT FIELD
	DCA	DATFIELD		/STORE BACK
DATABMP,TAD	XR1			/GET POINTER
	TAD	[5]			/UPDATE PAST HEADER
	DCA	XR1			/STORE BACK
	TAD	DATCTR			/GET COUNTER
	TAD	[5]			/UPDATE IT
	DCA	DATCTR			/STORE BACK
DATFIEL,.-.				/WILL BE CDF LATEST DATA FIELD
	TAD I	XR1			/GET A DATA WORD
	TAD	DATEST			/COMPARE TO TEST VALUE
	SZA CLA				/SKIP IF IT MATCHES
	JMP	DATAGOOD		/JUMP IF NOT
	ISZ	DATCTR			/DONE YET?
	JMP	DATALUP			/NO, KEEP GOING
	ISZ	DATCTR+1		/DONE YET?
	JMP	DATALUP			/NO, KEEP GOING
	CDF	PR1FLD		/BACK TO OUR FIELD
	JMS I	[MSGPRT]	/TELL THEM
	FPTNMSG			/FORMAT PATTERN IS PRESENT
/	NL0000			/INDICATE PATTERN
	JMP	DSCOMMON	/EXIT THERE

DATAGOO,CDF	PR1FLD		/BACK TO OUR FIELD
	JMS I	[MSGPRT]	/TELL THEM THAT
	GDTMSG			/"GOOD" DATA IS PRESENT
	NL3777			/INDICATE DATA
	JMP	DSCOMMON	/EXIT THERE

DATCTR,	ZBLOCK	2		/DATA COUNTER
DATEST,	.-.			/TEST VALUE
DMASK,	.-.			/ADDRESS MASK
DSSW,	.-.			/ERROR MESSAGE SWITCH

	PAGE
/	TEST BUFFER SETUP ROUTINE.

BUFSETU,.-.			/BUFFER SETUP ROUTINE
	DCA	BUFCNT		/SAVE PASSED BUFFER COUNT
	MQA			/GET PASSED INITIAL BUFFER NUMBER
	DCA	BUFNUM		/STASH IT
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	BUFSXIT		/STORE IN-LINE
	CDF	PRGFLD		/GOTO MAIN FIELD
	TAD I	(PATTERN)	/GET DATA PATTERN
	DCA	BUFPATTERN	/STASH IT
	DLD;	FBLK		/GET CURRENT BLOCK
	CDF	PR1FLD		/GOTO OUR FIELD
	JMS I	[SETSECTORSIZE]	/GET ACTUAL SECTOR SIZE
	DCA	BSECTSIZE	/STORE IT
BUFLUP,	JMS I	(BUFCOMMON)	/DO COMMON ADDRESS STUFF
	CDF	PRGFLD		/GOTO MAIN FIELD
	DLD;	FBLK		/GET CURRENT BLOCK NUMBER
	JMS	DATSETUP	/GOTO BUFFER FIELD
	DCA I	XR1		/STORE HIGH-ORDER BLOCK NUMBER
	MQA			/GET LOW-ORDER BLOCK NUMBER
	DCA I	XR1		/STORE IN BUFFER
	TAD	BUFNUM		/GET CURRENT BUFFER NUMBER
	DCA I	XR1		/STORE IN BUFFER
	CDF	PRGFLD		/GOTO MAIN FIELD
	DLD;	TRANS		/GET TRANSACTION NUMBER
	JMS	DATSETUP	/GOTO BUFFER FIELD
	DCA I	XR1		/STORE HIGH-ORDER TRANSACTION NUMBER
	MQA			/GET LOW-ORDER TRANSACTION NUMBER
	DCA I	XR1		/STORE IN BUFFER
	CDF	PRGFLD		/GOTO MAIN FIELD
	TAD I	(TRACK)		/GET MQ DISPLAY VALUE
	MQL			/RESTORE IT
	JMS	DATSETUP	/GOTO BUFFER FIELD
	TAD	BSECTSIZE	/GET SECTOR SIZE
	CIA			/INVERT FOR COUNTING
	TAD	[5]		/ACCOUNT FOR TEST WORDS
	DCA	BCT		/SAVE AS DATA COUNTER
BUFFILL,TAD	BUFPATTERN	/GET DATA PATTERN
	DCA I	XR1		/STORE A WORD
	ISZ	BCT		/BUFFER FILLED?
	JMP	BUFFILL		/NO, KEEP GOING
	ISZ	BUFNUM		/YES, BUMP TO NEXT BUFFER NUMBER
	ISZ	BUFCNT		/DONE ALL BUFFERS?
	JMP	BUFLUP		/NO, KEEP GOING
BUFSXIT,.-.			/WILL BE CIF CDF RETURN INSTRUCTION
	JMP I	BUFSETUP	/RETURN TO CALLER
/	TEST BUFFER VALIDATION ROUTINE.

BUFVALI,.-.			/BUFFER VALIDATION ROUTINE
	DCA	BUFCNT		/SAVE PASSED BUFFER COUNT
	MQA			/GET PASSED BUFFER NUMBER
	DCA	BUFNUM		/STASH IT
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	BUFVXIT		/STORE IN-LINE
	CDF	PRGFLD		/GOTO MAIN FIELD
	TAD I	(PATTERN)	/GET TEST DATA PATTERN
	CIA			/INVERT FOR COMPARING
	DCA	BUFPATTERN	/SAVE IT
	DLD;	FBLK		/GET CURRENT BLOCK
	CDF	PR1FLD		/GOTO OUR FIELD
	JMS I	[SETSECTORSIZE]	/GET CORRESPONDING SECTOR SIZE
	DCA	BSECTSIZE	/STORE IT
BUFVLP,	JMS I	(BUFCOMMON)	/DO COMMON ADDRESS STUFF
	CDF	PRGFLD		/GOTO MAIN FIELD
	TAD I	(TRACK)		/GET DISPLAY TRACK VALUE
	MQL			/DISPLAY IN MQ
	JMS	DATSETUP	/GOTO BUFFER FIELD
	TAD I	XR1		/GET TEST VALUE
	CIA			/INVERT FOR TESTING
	CDF	PRGFLD		/GOTO MAIN FIELD
	TAD I	[FBLK+1]	/COMPARE TO HIGH-ORDER BLOCK NUMBER
	SZA CLA			/SKIP IF IT MATCHES
	JMP	BUFVXIT		/JUMP IF NOT
	TAD I	[FBLK]		/GET LOW-ORDER BLOCK NUMBER
	CIA			/INVERT FOR TESTING
	JMS	DATSETUP	/GOTO BUFFER FIELD
	TAD I	XR1		/COMPARE TO TEST VALUE
	SZA CLA			/SKIP IF IT MATCHES
	JMP	BUFVXIT		/JUMP IF NOT
	TAD I	XR1		/GET TEST VALUE
	CIA			/INVERT FOR TESTING
	TAD	BUFNUM		/COMPARE TO BUFFER NUMBER
	SZA CLA			/SKIP IF IT MATCHES
	JMP	BUFVXIT		/JUMP IF NOT
	TAD I	XR1		/GET TEST VALUE
	CIA			/INVERT FOR TESTING
	CDF	PRGFLD		/GOTO MAIN FIELD
	TAD I	(TRANS+1)	/COMPARE TO HIGH-ORDER TRANSACTION NUMBER
	SZA CLA			/SKIP IF IT MATCHES
	JMP	BUFVXIT		/JUMP IF NOT
	TAD I	(TRANS)		/GET LOW-ORDER TRANSACTION NUMBER
	CIA			/INVERT FOR TESTING
	JMS	DATSETUP	/GOTO BUFFER FIELD
	TAD I	XR1		/COMPARE TO TEST VALUE
	SZA CLA			/SKIP IF IT MATCHES
	JMP	BUFVXIT		/JUMP IF NOT
	TAD	BSECTSIZE	/GET SECTOR SIZE
	CIA			/INVERT FOR COUNTING
	TAD	[5]		/ACCOUNT FOR TESTED WORDS
	DCA	BCT		/SAVE AS DATA TEST COUNT
BCMPLP,	TAD I	XR1		/GET A TEST VALUE
	TAD	BUFPATTERN	/COMPARE TO TEST PATTERN
	SZA CLA			/SKIP IF IT MATCHES
	JMP	BUFVXIT		/JUMP IF NOT
	ISZ	BCT		/DONE ALL?
	JMP	BCMPLP		/NO, KEEP GOING
	ISZ	BUFNUM		/YES, BUMP TO NEXT BUFFER NUMBER
	ISZ	BUFCNT		/DONE ALL BUFFERS?
	JMP	BUFVLP		/NO, KEEP GOING
	ISZ	BUFVALIDATE	/TAKE SKIP RETURN IF SUCCESSFUL MATCH
BUFVXIT,.-.			/WILL BE CIF CDF RETURN FIELD
	JMP I	BUFVALIDATE	/RETURN TO CALLER

BCT,	.-.			/DATA COUNTER
BSECTSI,.-.			/SECTOR SIZE
BUFCNT,	.-.			/BUFFER COUNTER
BUFNUM,	.-.			/BUFFER NUMBER
BUFPATT,.-.			/BUFFER PATTERN

	PAGE
/	TEST BUFFER ADDRESS ROUTINE.

BUFCOMM,.-.			/COMMAN ADDRESS SETUP ROUTINE
	CDF	PR1FLD		/ENSURE OUR FIELD
	TAD I	(BSECTSIZE)	/GET SECTOR SIZE
	DCA	BADDR		/STORE AS LOW-ORDER FOR NOW
	DCA	BADDR+1		/CLEAR HIGH-ORDER
	TAD I	(BUFNUM)	/GET BUFFER NUMBER
	CMA			/INVERT IT
	DCA	BUCT		/SAVE COUNTER
	CAM			/CLEAN UP
	JMP	BOTM		/JUMP INTO IT

BLUP,	DAD;	BADDR		/ADD ON SECTOR SIZE
BOTM,	ISZ	BUCT		/DONE ENOUGH?
	JMP	BLUP		/NO, GO BACK
	CLL RTL;RAL		/MOVE UP FIELD BITS
	TAD	(CDF	DATFLD)	/ADD ON BASE INSTRUCTION
	DCA	EXCCDF		/STORE PROPER FIELD INSTRUCTION
	MQA			/GET LOW-ORDER ADDRESS
	TAD	(-1)		/CORRECT IT
	DCA	XR1		/SETUP DATA POINTER
	JMP I	BUFCOMMON	/RETURN

BADDR,	ZBLOCK	2		/DATA ADDRESS TEMPORARY
BUCT,	.-.			/COUNTER

/	READ CHECK ROUTINE.

RDCHECK,.-.			/READ CHECK AND RETRY ROUTINE
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	RDCEXIT		/STORE IN-LINE
	CDF	PR1FLD		/GOTO OUR FIELD
RCHAGN,	/NL0000			/INDICATE READ
	JMS I	(RTRACK)	/READ IN A TRACK
	SNA			/SKIP IF ERRORS
	JMP	RDCEXIT		/JUMP IF NONE
	JMS I	[ERRPRSPECIAL]	/COMPLAIN OF
	RCERMSG			/READ CHECK ERROR
	JMS I	[ASKRETRY]	/ASK FOR A RETRY
	JMP	RCHAGN		/YES
	JMS I	[CNTERRORS]	/BUMP ERROR COUNTER
RDCEXIT,.-.			/WILL BE CIF CDF RETURN FIELD
	JMP I	RDCHECK		/RETURN TO CALLER
/	READ/WRITE TRACK TEST ROUTINE.

RWCHECK,.-.				/WRITE/READ CHECK ROUTINE
	JMS	SETFLD			/SETUP RETURN FIELD
	DCA	RWCHXIT			/STORE IN-LINE
RWCHAGN,CDF	PRGFLD			/GOTO MAIN FIELD
	DCA I	(PATTERN)		/CLEAR DATA PATTERN
/	NL0000				/INDICATE INITIAL BUFFER NUMBER
	MQL				/PASSED IN MQ
	TAD I	[SECTCNT]		/GET SECTOR COUNT
	CDF	PR1FLD			/BACK TO OUR FIELD
	JMS I	[BUFSETUP]		/SETUP TEST BUFFER
	NL0002	/TAD	(WRITFN-READFN)	/INDICATE WRITE
	JMS I	[RDSECTORS]		/GO WRITE THE TRACK
	SNA				/SKIP IF ANY ERRORS
	JMP	RWWROK			/JUMP IF OK
	JMS I	[ERRPRSPECIAL]		/COMPLAIN OF
	WCERMSG				/WRITE ERROR
RWBCOMM,JMS I	[ASKRETRY]		/ASK FOR A RETRY
	JMP	RWCHAGN			/YES
	JMS I	[CNTERRORS]		/NO, BUMP ERROR COUNT
RWCHXIT,.-.				/WILL BE CIF CDF RETURN FIELD
	JMP I	RWCHECK			/RETURN TO CALLER

RWWROK,	/NL0000				/INDICATE READ
	JMS I	[RDSECTORS]		/GO READ THE TRACK BACK IN
	SNA				/SKIP IF ANY ERRORS
	JMP	RWRDOK			/JUMP IF OK
	JMS I	[ERRPRSPECIAL]		/COMPLAIN OF
	RCERMSG				/READ ERROR
	JMP	RWBCOMMON		/CONTINUE THERE

RWRDOK,	/NL0000				/INDICATE INITIAL BUFFER VALUE
	MQL				/PASSED IN MQ
	CDF	PRGFLD			/GOTO MAIN FIELD
	TAD I	[SECTCNT]		/GET BUFFER LENGTH
	CDF	PR1FLD			/BACK TO OUR FIELD
	JMS I	[BUFVALIDATE]		/VALIDATE READ
	SKP				/SKIP IF BAD
	JMP	RWCHXIT			/JUMP IF OK
	NL7776				/SET INVENTED ERROR VALUE
	JMS I	[ERRPRSPECIAL]		/COMPLAIN OF
	CMEMSG				/COMPARE ERROR
	JMP	RWBCOMMON		/CONTINUE THERE
/	SEEK ROUTINE.

SEEK,	.-.			/SEEK ROUTINE
	DCA	TEMP1		/SAVE PASSED HIGH-ORDER VALUE
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	SEEKXT		/STORE IN-LINE
	CDF	PRGFLD		/GOTO MAIN FIELD
	TAD	TEMP1		/RESTORE PASSED VALUE
	DCA I	[FBLK+1]	/STORE AS HIGH-ORDER SEEK BLOCK
	MQA			/GET LOW-ORDER PASSED VALUE
	DCA I	[FBLK]		/STORE AS LOW-ORDER SEEK BLOCK
	CDF	PR1FLD		/GOTO OUR FIELD
SEEKAGN,JMS I	(SEEKTRK)	/DO THE SEEK
	SNA			/SKIP IF ANY ERRORS
	JMP	SEEKXT		/ELSE EXIT NORMALLY
	JMS I	[ERRPRSPECIAL]	/GO PRINT THE COMPLAINT
	SKERMSG			/OF A SEEK ERROR
	JMS I	[ASKRETRY]	/RETRY?
	JMP	SEEKAGN		/YES, TRY AGAIN
	JMP I	[GFAIL]		/NO, FORGET IT

SEEKXT,	.-.			/WILL BE CIF CDF RETURN FIELD
	JMP I	SEEK		/RETURN TO CALLER

/	QUICK CHECKOUT TEST MOUNT ROUTINE.

QTMOUNT,.-.			/QUICK MOUNT ROUTINE
	CDF	PRGFLD		/GOTO MAIN FIELD
	DCA I	[UNIT]		/SAVE PASSED UNIT VALUE
	CDF	PR1FLD		/GOTO OUR FIELD
	TAD	QTMOUNT		/GET OUR CALLER
	DCA I	(EXMOUNT)	/MAKE IT THEIRS
	JMS I	(GTREADY)	/GET THE DRIVE MOUNTED
	RCMMSG			/FLEXIBLE DISK MESSAGE
/	NL0000			/INDICATE ANYTHING IS ALLOWED
	JMS I	(DATASTATUS)	/GET DISK DATA STATUS
	JMS I	(RUSURE)	/ASK IF THEY ARE SURE OF THEMSELVES
	PTDMSG			/PERMISSION MESSAGE
	SKP			/SKIP IF THEY CHANGED THEIR MINDS
	JMP I	(EXMMORE)	/JUMP IF THEY AGREED TO IT
	CIF CDF	PRGFLD		/GOTO MAIN FIELD
	JMP I	(QIKAGN)	/ASK WHAT THEY WANT INSTEAD
	PAGE
/	EXERCISER REPORT ROUTINE.

EXPRINT,.-.			/EXERCISER UNIT REPORT ROUTINE
	CDF	PR1FLD		/ENSURE OUR FIELD
	DCA	EXPRTMP		/SAVE PASSED UNIT INDICATOR
	NL7776			/SETUP INITIAL SPACE COUNT
	JMS I	(PBLANK)	/PRINT SOME SPACES
	NL0002			/SETUP UNIT MASK
	AND	EXPRTMP		/GET THE BIT
	SNA CLA			/SKIP IF FLEXIBLE DISK DRIVE
	TAD	("W-"F)		/ELSE USE WINCHESTER DISK VALUE
	TAD	("F&177)	/GET AN "F" AT LEAST
	JMS I	[P7CH]		/PRINT IT
	NL0001			/SETUP MASK
	AND 	EXPRTMP		/GET THE UNIT BIT
	TAD	("0&177)	/MAKE IT ASCII
	JMS I	[P7CH]		/PRINT IT
	TAD	EXPRTMP		/GET UNIT AGAIN
	CLL RAL			/*2
	TAD	EXPRTMP		/*3
	RAL			/*6
	TAD	(R0ERRLO-1)	/POINT TO COUNT VALUE
	DCA	XR2		/STASH THE POINTER
	TAD	(-5)		/GET SPACING COUNT
	JMS	EXOUT		/PRINT READ ERROR COUNT
	TAD	(-7)		/GET SPACING COUNT
	JMS	EXOUT		/PRINT WRITE ERROR COUNT
	TAD	(-10)		/GET SPACING COUNT
	JMS	EXOUT		/PRINT COMPARE ERROR COUNT
	JMS I	[CRLF]		/DO A <CR>, <LF>
	CIF CDF	PRGFLD		/GOTO MAIN FIELD
	JMP I	EXPRINT		/RETURN TO CALLER

EXPRTMP,.-.			/TEMPORARY

EXOUT,	.-.			/EXERCISER PRINT OUTPUT ROUTINE
	JMS I	(PBLANK)	/PRINT PASSED NUMBER OF <SPACE> CHARACTERS
	TAD I	XR2		/GET LOW-ORDER
	MQL			/LOAD IT
	TAD I	XR2		/GET HIGH-ORDER
	JMS I	(P7DIGITS)	/PRINT THE VALUE
	JMP I	EXOUT		/RETURN
/	EXERCISER READ/WRITE ROUTINE.

EXRWCHK,.-.				/READ/WRITE ROUTINE FOR EXERCISER
	JMS	SETFLD			/SETUP RETURN FIELD
	DCA	EXRWXIT			/STORE IN-LINE
	CDF	PRGFLD			/GOTO MAIN FIELD
/	NL0000				/INDICATE INITIAL BUFFER NUMBER
	MQL				/WHICH IS PASSED IN THE MQ
	TAD I	[SECTCNT]		/GET BUFFER LENGTH
	CDF	PR1FLD			/INDICATE OUR FIELD
	JMS I	[BUFSETUP]		/SETUP TEST BUFFER
	NL0002	/TAD	(WRITFN-READFN)	/INDICATE WRITE
	JMS I	[RDSECTORS]		/GO WRITE OUT THE TRACK
	SNA CLA				/SKIP IF ANY ERRORS
	JMP	EXWROK			/JUMP IF OK
	TAD	(W0ERRLO-1)		/POINT AT WRITE ERROR
EXRWCOM,CDF	PRGFLD			/GOTO MAIN FIELD
	TAD I	[UNIT]			/*1
	TAD I	[UNIT]			/*2
	TAD I	[UNIT]			/*3
	TAD I	[UNIT]			/*4
	TAD I	[UNIT]			/*5
	TAD I	[UNIT]			/*6
	DCA	XR1			/STASH THE ERROR POINTER
	CDF	PR1FLD			/GOTO TABLE FIELD
	ISZ I	XR1			/BUMP LOW-ORDER ERROR COUNT
	SKP				/SKIP IF NO OVERFLOW
	ISZ I	XR1			/ELSE BUMP HIGH-ORDER COUNT
EXRWXIT,.-.				/WILL BE CIF CDF RETURN FIELD
	JMP I	EXRWCHK			/RETURN TO CALLER

EXWROK,	/NL0000				/INDICATE READ
	JMS I	[RDSECTORS]		/READ THE DATA BACK
	SNA CLA				/SKIP IF ANY ERRORS
	JMP	EXRDOK			/JUMP IF NONE
	TAD	(R0ERRLO-1)		/POINT AT READ ERROR
	JMP	EXRWCOMMON		/CONTINUE THERE

EXRDOK,	/NL0000				/INDICATE INITIAL BUFFER NUMBER
	MQL				/PASSED IN MQ
	CDF	PRGFLD			/GOTO MAIN FIELD
	TAD I	[SECTCNT]		/GET BUFFER LENGTH
	CDF	PR1FLD			/INDICATE OUR FIELD
	JMS I	[BUFVALIDATE]		/VALIDATE READ
	SKP				/SKIP IF BAD
	JMP	EXRWXIT			/JUMP IF OK
	TAD	(C0ERRLO-1)		/POINT AT COMPARE ERROR
	JMP	EXRWCOMMON		/CONTINUE THERE
/	EXERCISER MOUNT ROUTINE.

EXMOUNT,.-.			/EXERCISER MOUNT ROUTINE
	CDF	PRGFLD		/ENSURE MAIN FIELD
	DCA I	[UNIT]		/STORE LOGICAL DRIVE UNIT
	CDF	PR1FLD		/GOTO OUR FIELD
	JMS I	(GTREADY)	/GET THE DRIVE READY
	EXMMSG			/FLEXIBLE DISK MESSAGE
	NL7777			/INDICATE CHANGE OF ERROR MESSAGE
	JMS I	(DATASTATUS)	/FIND OUT WHAT DRIVE IS DOING
	JMS I	(RUSURE)	/GET RESPONSE TO QUESTION
	PTXMSG			/FOR PERMISSION
	SKP			/SKIP IF THEY CHANGED THEIR MINDS
	JMP	EXMMORE		/JUMP IF THEY AGREED TO IT
	CIF CDF	PRGFLD		/GOTO MAIN FIELD
	JMP I	(EXFORGET)	/ASK WHAT THEY WANT INSTEAD

EXMMORE,NL7777			/INDICATE LOGICAL LIMIT ONLY
	JMS I	(SEEKLIMITS)	/SETUP LIMITS FOR THIS UNIT
	CDF	PRGFLD		/GOTO MAIN FIELD
	TAD I	[UNIT]		/GET CURRENT UNIT
	CLL RAL			/*2
	TAD	(LIM0-1)	/POINT AT LIMIT ELEMENT
	DCA	XR1		/STASH THE POINTER
	CDF	PR1FLD		/GOTO DATA FIELD
	DLD;	SUPPERLIMIT	/GET THIS UNIT'S UPPER LIMIT
	SWP			/WANT LOW-ORDER FIRST
	DCA I	XR1		/STORE IN TABLE
	MQA			/GET HIGH-ORDER
	DCA I	XR1		/STORE IN TABLE
	CIF CDF	PRGFLD		/GOING TO MAIN FIELD
	JMP I	EXMOUNT		/RETURN TO CALLER

	PAGE
/	FLAW MAP READ AND VERIFY ROUTINE.

RBTTBL,	.-.			/READ FLAW TABLE ROUTINE
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	RBTEXIT		/STORE IN-LINE
RBTAGN,	CDF	PRGFLD		/GOTO MAIN FIELD
	NL0002			/SETUP UNIT MASK
	AND I	[UNIT]		/GET THE BIT
	SZA CLA			/SKIP IF WINCHESTER DISK UNIT
	JMP	RBADXT		/FORGET IT IF FLEXIBLE DISK UNIT
	TAD I	[UNIT]		/GET CURRENT UNIT
	CDF	PR1FLD		/BACK TO OUR FIELD
	TAD	(4^100+TBLFLD)	/FORM READ FUNCTION
	DCA	RBTFUN		/STORE IN-LINE
	JMS	FTLIMITS	/SETUP I/O LIMITS
RBTLP2,	NL7775			/SETUP THE
	DCA	RETRYCT		/RETRY COUNTER
RBTLUP,	JMS I	[CHKUP]		/CHECK FOR <^P>, ETC.
	JMS I	[IOHAND]	/CALL I/O HANDLER
	BTBUFFER		/TRANSFER ADDRESS
RBTFUN,	4^100+TBLFLD+.-.	/FUNCTION WORD; UNIT BITS WILL BE FILLED IN
	FLWBLK			/RECORD POINTER
	SKP			/SKIP IF I/O ERROR
	JMP	RBTOK		/JUMP IF OK
	ISZ	RETRYCT		/TRY AGAIN?
	JMP	RBTLUP		/YES, TRY TO READ THIS ONE IN AGAIN
	DLD;	FLWBLK		/GET CURRENT BLOCK
	DAD;	FTUPDATE	/ADD ON BLOCK UPDATE FACTOR
	DST;	FLWBLK		/STORE IT BACK
/	CDF	PRGFLD		/GOTO MAIN FIELD
/	DST;	FBLK		/SAVE FOR ERROR ROUTINE
/	CDF	PR1FLD		/BACK TO OUR FIELD
	DCM			/INVERT FOR TESTING
	DAD;	FTLBLK		/COMPARE TO LIMIT BLOCK
	MQA			/OR LOW-ORDER IN
	SZA CLA			/SKIP IF IT MATCHES
	JMP	RBTLP2		/ELSE TRY AGAIN
/	JMS I	[ERRPREXTRA]	/GO COMPLAIN OF
/	RBTMSG			/TABLE PROBLEMS
/	JMS I	[ASKRETRY]	/ASK FOR A RETRY
/	JMP	RBTAGN		/TRY AGAIN
RBADXT,	NL7777			/INDICATE FAILURE
RGUDXT,	CDF	PRGFLD		/GOTO MAIN FIELD
	DCA I	[TVSW]		/STORE VALIDITY SWITCH VALUE
	CAM			/CLEAN UP
	DST;	FBLK		/CLEAR BLOCK FOR OTHERS
RBTEXIT,.-.			/WILL BE CIF CDF RETURN FIELD
	JMP I	RBTTBL		/RETURN TO CALLER

RBTOK,	JMP I	(VERTBL)	/GO VERIFY READ-IN TABLE
/	FLAW TABLE LIMITS CALCULATION ROUTINE.

FTLIMIT,.-.			/CALCULATE FLAW TABLE LIMITS
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	FTLEXIT		/STORE IN-LINE
	CDF	PR1FLD		/ENSURE OUR FIELD
	DLD;	WPTRCNT		/GET PHYSICAL TRACK COUNT
	DST;	FTLBLK		/STORE FOR NOW
	DAD;	M4		/BACKUP FOUR TRACKS
	DST;	FLWBLK		/STORE FOR NOW
	JMS	FLCSET		/SETUP THE COUNTER
	DAD;	FLWBLK		/GET TRACK COUNT
	ISZ	TEMP1		/DONE ENOUGH?
	JMP	.-3		/NO, KEEP GOING
	DST;	FLWBLK		/SAVE FIRST FLAW TABLE BLOCK
	JMS I	[SETSECTORSIZE]	/GET SECTOR SIZE
	TAD	[-200]		/COMPARE TO ONE PAGE SIZE
	SNA			/SKIP IF OTHER
	JMP	FTL200		/JUMP IF IT MATCHES
	TAD	[-400+200]	/COMPARE TO TWO PAGE SIZE
	SNA			/SKIP IF OTHER
	JMP	FTL400		/JUMP IF IT MATCHES
	HLT			/**** SYSTEM ERROR ****
FTL200,	TAD	(4-2)		/USE FOUR BLOCKS FOR FOUR PAGES
FTL400,	TAD	(2)		/USE TWO BLOCKS FOR FOUR PAGES
	MQL			/PUT IN LOW-ORDER
	DST;	FTUPDATE	/STORE AS BLOCK UPDATE FACTOR
	JMS	FLCSET		/SETUP THE COUNTER
	DAD;	FTLBLK		/GET TRACK COUNT
	ISZ	TEMP1		/ENOUGH TIMES?
	JMP	.-3		/NO, KEEP GOING
	DST;	FTLBLK		/SAVE AS FLAW TABLE UPPER LIMIT
	JMS	FLCSET		/SETUP THE COUNTER
	DAD;	WTRCNT		/GET LOGICAL TRACK COUNT
	ISZ	TEMP1		/ENOUGH TIMES?
	JMP	.-3		/NO, KEEP GOING
	DCM			/INVERT IT
	DST;	SUPPERLIMIT	/SAVE AS NEGATIVE MAXIMUM LOGICAL ADDRESS
	JMS	FLCSET		/SETUP THE COUNTER
	TAD	TEMP1		/GET THE VALUE
	MQL			/TO LOW-ORDER
	NL7777			/SETUP HIGH-ORDER
	DST;	FLBACKUP	/SAVE AS BACKUP FACTOR
	CAM			/CLEAN UP
FTLEXIT,.-.			/WILL BE CIF CDF RETURN FIELD
	JMP I	FTLIMITS	/RETURN

FLCSET,	.-.			/COUNT SET ROUTINE
	JMS I	[TRKUPDATE]	/GET WINCHESTER UPDATE FACTOR
	SWP			/CLEAR MQ AND GET VALUE
	CIA			/INVERT IT
	DCA	TEMP1		/STORE COUNTER
	JMP I	FLCSET		/RETURN

/	FLAW RECORD BACKUP ROUTINE.

FLWBACK,.-.			/BACKUP FLAW MAP RECORD
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	FLWBXT		/STORE IN-LINE
	CDF	PR1FLD		/GOTO OUR FIELD
	DLD;	FLWBLK		/GET CURRENT VALUE
	DAD;	FLBACKUP	/ADD ON BACKUP VALUE
	DST;	FLWBLK		/STORE BACK
FLWBXT,	.-.			/WILL BE CIF CDF RETURN FIELD
	JMP I	FLWBACKUP	/RETURN TO CALLER
