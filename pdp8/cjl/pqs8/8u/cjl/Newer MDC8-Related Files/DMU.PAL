	CIF	PR1FLD		/GOTO CODE FIELD
	JMS I	[GTREADY]	/GET THE UNIT READY
	OCUMSG			/FLEXIBLE DISK MESSAGE
	JMP I	CMOANN		/RETURN

DSUNIT,	.-.			/UNIT PRINT ROUTINE
