/	FLAW MAP SUPPORT ROUTINES.

ADCHEK,	.-.			/ADD CHECK ROUTINE
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	ADCHXIT		/STORE IN-LINE
	CDF	PR1FLD		/GOTO OUR FIELD
	JMS I	[TRKUPDATE]	/GET UPDATE VALUE
	CDF	PRGFLD		/GOTO MAIN FIELD
	TAD I	[TRACK+1]	/GET HIGH-ORDER ARGUMENT
	SWP			/MOVE EVERYONE AROUND
	DCA I	(TEMP)		/STORE DIVISOR
	DVI;	TEMP		/DIVIDE BY IT
	SWP			/GET QUOTIENT
	DCA	HIQUO		/SAVE IT
	TAD I	[TRACK]		/GET LOW-ORDER ARGUMENT
	SWP			/MOVE EVERYONE AROUND
	DVI;	TEMP		/DIVIDE BY DIVISOR
	SWP			/GET LOW-ORDER
	DCA	LOQUO		/SAVE IT
	DCM			/NEGATE REMAINDER
	DAD;	TRACK		/ADD ON THEIR VALUE
	DST;	TRACK		/STORE BACK
	DST;	FBLK		/PUT INTO SEARCH ARGUMENT
	CAM			/CLEAN UP
	TAD	(1777)		/SETUP THE
	DCA I	(SMASK)		/SEARCH MASK
	CDF	PR1FLD		/INDICATE OUR FIELD
	JMS I	[MSGPRT]	/TELL THEM THE
	IMPMSG			/IMPLIED ADDRESS
	CDF	PRGFLD		/GOTO MAIN FIELD
	DLD;	FBLK		/GET THE ADDRESS
	CDF	PR1FLD		/INDICATE OUR FIELD
	JMS I	[P7DIGITS]	/PRINT THE VALUE
	JMS I	[CRLF]		/DO A <CR>, <LF>
	JMS I	(SEFLAW)	/TRY TO FIND IT
	ISZ	ADCHEK		/BUMP RETURN IF NOT THERE
ADCHXIT,.-.			/WILL BE CIF CDF RETURN FIELD
	JMP I	ADCHEK		/RETURN TO CALLER
HGHCHK,	.-.			/HIGH CHECK ROUTINE
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	HGHXIT		/STORE IN-LINE
	CDF	PRGFLD		/GOTO MAIN FIELD
	TAD I	[TRACK+1]	/GET HIGH-ORDER
	SPA CLA			/SKIP IF POSSIBLE
	JMP	HGHFLAW		/JUMP IF NOT
	CDF	PR1FLD		/INDICATE OUR FIELD
	JMS I	(FTLIMITS)	/SETUP LIMITS
	DLD;	SUPPERLIMIT	/GET UPPER LIMIT
	CDF	PRGFLD		/GOTO MAIN FIELD
	DAD;	TRACK		/COMPARE TO DESIRED
	SPA CLA			/SKIP IF TOO HIGH
	JMP	HGHXIT		/JUMP IF NOT
HGHFLAW,CDF	PR1FLD		/INDICATE OUR FIELD
	JMS I	[MSGPRT]	/TELL THEM
	THIMSG			/IT'S TOO HIGH
LOWOUT,	CIF CDF	PRGFLD		/GOTO MAIN FIELD
	JMP I	(EDFLRESTART)	/CONTINUE THERE

HGHXIT,	.-.			/WILL BE CIF CDF RETURN FIELD
	JMP I	HGHCHK		/RETURN TO CALLER

RNGCHK,	.-.			/RANGE CHECK ROUTINE
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	RNGXIT		/STORE IN-LINE
	CDF	PRGFLD		/GOTO MAIN FIELD
	TAD I	[TRACK+1]	/GET HIGH-ORDER
	SPA CLA			/SKIP IF POSSIBLE
	JMP	HGHFLAW		/JUMP IF NOT
	CDF	PR1FLD		/INDICATE OUR FIELD
	JMS I	(FTLIMITS)	/SETUP LIMITS
	DLD;	SUPPERLIMIT	/GET UPPER LIMIT
	CDF	PRGFLD		/GOTO MAIN FIELD
	DAD;	TRACK		/COMPARE TO DESIRED
	SPA CLA			/SKIP IF LARGE ENOUGH
	JMP	LOWFLAW		/JUMP IF TOO SMALL
	CDF	PR1FLD		/BACK TO OUR FIELD
	DLD;	FLWBLK		/GET UPPER LIMIT BLOCK
	DCM			/INVERT IT
	CDF	PRGFLD		/GOTO MAIN FIELD
	DAD;	TRACK		/COMPARE TO DESIRED
	SMA CLA			/SKIP IF SMALL ENOUGH
	JMP	HGHFLAW		/JUMP IF TOO LARGE
RNGXIT,	.-.			/WILL BE CIF CDF RETURN FIELD
	JMP I	RNGCHK		/RETURN TO CALLER
LOWFLAW,CDF	PR1FLD		/INDICATE OUR FIELD
	JMS I	[MSGPRT]	/TELL THEM
	TLOMSG			/IT'S TOO BIG
	JMP	LOWOUT		/CONTINUE THERE

HIQUO,	.-.			/HIGH-ORDER QUOTIENT
LOQUO,	.-.			/LOW-ORDER QUOTIENT

	PAGE
/	SEEK LIMIT SETUP ROUTINE.

SEEKLIM,.-.			/SEEK LIMIT ROUTINE
	DCA	SLSW		/SAVE PASSED VALUE
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	SEEKLXIT	/STORE IN-LINE
	CDF	PRGFLD		/GOTO MAIN FIELD
	NL0002			/SETUP UNIT MASK
	AND I	[UNIT]		/GET THE BIT
	CDF	PR1FLD		/BACK TO OUR FIELD
	SNA CLA			/SKIP IF FLEXIBLE DISK UNIT
	JMP	WSEEKLIMITS	/JUMP IF WINCHESTER DISK UNIT
	JMS I	[TRKUPDATE]	/GET UPDATE FACTOR
	DST;	ONECYLINDER	/STORE FOR NOW
	SWP			/GET THE VALUE
	CIA			/INVERT IT
	DCA	TEMP1		/SAVE FOR COUNTING
	DAD;	FTRCNT		/GET THE TRACK COUNT
	ISZ	TEMP1		/ENOUGH TIMES?
	JMP	.-3		/NO, KEEP GOING
	DST;	MAXUPSTROKE	/STORE MAXIMUM STROKE ADDRESS
	CDF	PRGFLD		/GOTO MAIN FIELD
	TAD I	[FLPFRM]	/GET FLEXIBLE DISK FORMAT WORD
	RAR			/SIDE BIT TO LINK
	CDF	PR1FLD		/BACK TO OUR FIELD
	SNL CLA			/SKIP IF DOUBLE-SIDED DISK
	JMP	SEEK1LIMITS	/JUMP IF SINGLE-SIDED DISK
	DLD;	ONECYLINDER	/GET CURRENT VALUE
	DAD;	ONECYLINDER	/DOUBLE IT
	DST;	ONECYLINDER	/STORE IT BACK
	DLD;	MAXUPSTROKE	/GET MAXIMUM STROKE ADDRESS
	DAD;	MAXUPSTROKE	/DOUBLE IT
	DST;	MAXUPSTROKE	/STORE IT BACK
SEEK1LI,DLD;	ONECYLINDER	/GET ONE CYLINDER UPDATE
	DCM			/WANT NEGATIVE FORM ALSO
	DST;	MONECYLINDER	/STORE IT
	DLD;	MAXUPSTROKE	/GET MAXIMUM STROKE ADDRESS
	DCM			/WANT NEGATIVE FORM ALSO
	DST;	SUPPERLIMIT	/STORE IT
	CAM			/CLEAN UP
SEEKLXI,.-.			/WILL BE CIF CDF RETURN FIELD
	JMP I	SEEKLIMITS	/RETURN TO CALLER
WSEEKLI,TAD	SLSW		/GET PASSED SWITCH
	SZA CLA			/SKIP IF NOT VERIFYING
	JMP	WVERLIMIT	/JUMP IF VERIFYING
	DLD;	WPTRCNT		/USE PHYSICAL LIMIT IF NOT VERIFYING
	JMP	WLIMCOMMON	/CONTINUE THERE

WVERLIM,DLD;	WTRCNT		/GET LOGICAL LIMIT
WLIMCOM,DST;	MAXUPSTROKE	/STORE UPPER TRACK LIMIT
	JMS I	[TRKUPDATE]	/GET SECTOR COUNT
	SWP			/CLEAR MQ, GET THE VALUE
	CIA			/INVERT FOR COUNTING
	DCA	TEMP1		/STORE THE COUNTER
	DAD;	MAXUPSTROKE	/GET TRACK COUNT
	ISZ	TEMP1		/ENOUGH TIMES?
	JMP	.-3		/NO, KEEP GOING
	DST;	MAXUPSTROKE	/STORE LOGICAL LIMIT
	JMS I	[TRKUPDATE]	/GET ONE-HEAD UPDATE
	DST;	ONECYLINDER	/STORE IT
	CAM			/CLEAN UP
	TAD	HDCNT		/GET HEAD COUNT
	DCA	TEMP1		/SETUP COUNTER
	DAD;	ONECYLINDER	/ADD ON UPDATE
	ISZ	TEMP1		/ENOUGH TIMES?
	JMP	.-3		/NO, KEEP GOING
	DST;	ONECYLINDER	/STORE UPDATE VALUE
	JMP	SEEK1LIMITS	/FINISH IT THERE

SLSW,	.-.			/LOGICAL/PHYSICAL WINCHESTER SEEK LIMIT SWITCH
/	DMA BUFFER READ ROUTINE.

DMINPUT,.-.				/DMA INPUT ROUTINE
	DCA	TEMP1			/SAVE HIGH-ORDER FOR NOW
	JMS	SETFLD			/SETUP RETURN FIELD
	DCA	DMIXIT			/STORE IN-LINE
	CDF	PR1FLD			/GOTO OUR FIELD
	TAD	TEMP1			/RETRIEVE HIGH-ORDER
	DST;	DMTADR			/STORE FOR I/O ROUTINE
DMIAGN,	NL0000				/INDICATE READ
	JMS I	(DMAFUN)		/GO READ THE DMA BUFFER
	SNA				/SKIP IF ERRORS
	JMP	DMIXIT			/JUMP IF NONE
	JMS I	(ERRDMA)		/GO COMPLAIN
	DIEMSG				/ABOUT DMA READ PROBLEM
	JMS I	[ASKRETRY]		/RETRY?
	JMP	DMIAGN			/YES
	JMP I	[GFAIL]			/NO, FORGET IT

DMIXIT,	.-.				/WILL BE CIF CDF RETURN FIELD
	JMP I	DMINPUT			/RETURN TO CALLER

/	DMA BUFFER WRITE ROUTINE.

DMOUTPU,.-.				/DMA OUTPUT ROUTINE
	DCA	TEMP1			/SAVE HIGH-ORDER FOR NOW
	JMS	SETFLD			/SETUP RETURN FIELD
	DCA	DMOXIT			/STORE IN-LINE
	CDF	PR1FLD			/GOTO OUR FIELD
	TAD	TEMP1			/RETRIEVE HIGH-ORDER
	DST;	DMTADR			/STORE FOR I/O ROUTINE
DMOAGN,	NL0003	/TAD	(WDMAFN-RDMAFN)	/INDICATE WRITE
	JMS I	(DMAFUN)		/GO WRITE THE DMA BUFFER
	SNA				/ANY ERRORS?
	JMP	DMOXIT			/JUMP IF NONE
	JMS I	(ERRDMA)		/GO COMPLAIN
	DOEMSG				/ABOUT DMA WRITE PROBLEM
	JMS I	[ASKRETRY]		/RETRY?
	JMP	DMOAGN			/YES
	JMP I	[GFAIL]			/FORGET IT

DMOXIT,	.-.				/WILL BE CIF CDF RETURN FIELD
	JMP I	DMOUTPUT		/RETURN TO CALLER

	PAGE
/	RANDOM SEEK CALCULATION ROUTINE.

RSCALCU,.-.			/RANDOM SEEK BLOCK CALCULATOR
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	RSCXIT		/STORE IN-LINE
	CDF	PR1FLD		/GOTO OUR FIELD
RSCLAGN,CIF	PR2FLD		/GOTO CODE FIELD
	JMS I	(RAND24);BLSEED	/CALCULATE RANDOM NUMBER
	AND	(777)		/JUST 21 BITS WORTH
	DST;	FLWBLK		/SAVE FOR NOW
	DAD;	SUPPERLIMIT	/COMPARE TO UPPER LIMIT
	SMA CLA			/SKIP IF POSSIBLE
	JMP	RSCLAGN		/JUMP IF NOT POSSIBLE
	CDF	PRGFLD		/GOTO MAIN FIELD
	TAD I	(RSVSW)		/GET POSITION-VERIFY SWITCH
	CDF	PR1FLD		/BACK TO OUR FIELD
	SNA CLA			/SKIP IF VERIFYING
	JMP	RSCLOK		/JUMP IF NOT
	JMS I	[TRKUPDATE]	/GET UPDATE FACTOR
	DAD;	FLWBLK		/ADD ON THE BLOCK
	DAD;	SUPPERLIMIT	/COMPARE TO LIMIT
	DAD;	MONE		/CORRECT THE COMPARISON
	SMA CLA			/SKIP IF OK
	JMP	RSCLAGN		/ELSE FORGET THIS ONE
RSCLOK,	DLD;	FLWBLK		/GET THE GOOD BLOCK
	CDF	PRGFLD		/GOTO MAIN FIELD
	DST;	FBLK		/SETUP THEIR ARGUMENT
RSCXIT,	.-.			/WILL BE CIF CDF RETURN FIELD
	JMP I	RSCALCULATE	/RETURN TO CALLER
/	RANDOM EXERCISER BLOCK AND FUNCTION CALCULATION ROUTINE.

BFCALCU,.-.			/BLOCK AND FUNCTION CALCULATOR
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	BFCXIT		/STORE IN-LINE
	CDF	PR1FLD		/GOTO OUR FIELD
BFCAGN,	CIF	PR2FLD		/GOTO CODE FIELD
	JMS I	(RAND6);FNSEED	/GET RANDOM VALUE
	SNA			/SKIP IF USABLE
	JMP	BFCAGN		/ELSE GO GET ANOTHER ONE
	DCA	BFCNT		/SAVE IT FOR NOW
	JMS I	[TRKUPDATE]	/GET UPDATE VALUE
	MQA			/GET THE VALUE
	CIA			/INVERT IT
	TAD	BFCNT		/COMPARE TO CALCULATION
	SMA SZA CLA		/SKIP IF USABLE
	JMP	BFCAGN		/ELSE GO GET ANOTHER ONE
BFCBAGN,CIF	PR2FLD		/GOTO CODE FIELD
	JMS I	(RAND24);BLSEED	/CALCULATE RANDOM BLOCK
	AND	(777)		/JUST 21 BITS WORTH
	DST;	FLWBLK		/SAVE FOR NOW
	CLA			/CLEAN UP
	CDF	PRGFLD		/GOTO MAIN FIELD
	TAD I	[UNIT]		/GET DRIVE UNIT
	CDF	PR1FLD		/BACK TO OUR FIELD
	CLL RAL			/*2
	TAD	(LIM0-1)	/POINT AT LIMIT TABLE ELEMENT
	DCA	XR1		/STASH THE POINTER
	TAD I	XR1		/GET LOW-ORDER
	MQL			/LOAD IT
	TAD I	XR1		/GET HIGH-ORDER
	DST;	SUPPERLIMIT	/STORE AS UPPER LIMIT FOR THIS UNIT
	DAD;	FLWBLK		/COMPARE TO CALCULATED VALUE
	SMA CLA			/SKIP IF POSSIBLE
	JMP	BFCBAGN		/JUMP IF NOT
	TAD	BFCNT		/GET CALCULATED COUNT
	MQL			/TO LOW-ORDER
	DAD;	FLWBLK		/ADD ON CALCULATED BLOCK
	DAD;	SUPPERLIMIT	/COMPARE TO LIMIT
	DAD;	MONE		/ADJUST COMPARISON
	SMA CLA			/SKIP IF POSSIBLE
	JMP	BFCBAGN		/ELSE FORGET THIS ONE
	DLD;	FLWBLK		/GET THE VALUE
	CDF	PRGFLD		/GOTO MAIN FIELD
	DST;	FBLK		/SETUP THEIR ARGUMENT
	CLA			/CLEAN UP
	TAD	BFCNT		/GET THE COUNT
	CIA			/INVERT IT
	DCA I	[SECTCNT]	/STORE THEIR ARGUMENT
BFCXIT,	.-.			/WILL BE CIF CDF RETURN FIELD
	JMP I	BFCALCULATE	/RETURN TO CALLER

BFCNT,	.-.			/CALCULATED COUNT

	PAGE
/	I/O HANDLER FOR MDC8.

/	USAGE:

/	CDF	MYFLD		/SET CALLING DATA FIELD
/	CIF	PR1FLD		/SET HANDLER FIELD
/	JMS I	[IOHAND]	/CALL HANDLER
/	ADDRESS			/LOW-ORDER TRANSFER ADDRESS
/	FUNCTION		/FUNCTION WORD; SEE BELOW
/	POINTER			/POINTER TO I/O RECORD NUMBER; SEE BELOW
/	ERROR RETURN		/RETURNS HERE WITH AC=4000 IF ERROR
/	GOOD RETURN		/RETURNS HERE WITH AC=0000 IF OK

/	FUNCTION WORD:

/	BIT[0]:			READ/WRITE
/	BITS[1-5]:		PAGE COUNT (BIT[5] MUST BE 0 IF BLOCKSIZE=400)
/	BITS[6-8]:		TRANSFER FIELD
/	BIT[9]:			UNUSED
/	BIT[10-11]:		LOGICAL UNIT ON MDC8

/	POINTER:

/	POINTER CONTAINS ADDRESS OF DOUBLE-WORD DISK RECORD NUMBER
/	IN DOUBLE-PRECISION EAE FORMAT (LOW, HIGH).
IOHAND,	.-.			/I/O HANDLER ENTRY POINT
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	IOEXIT		/STORE IN-LINE
	TAD I	IOHAND		/GET TRANSFER ADDRESS
	DCA	TRADDRESS	/STORE IN COMMAND
	ISZ	IOHAND		/BUMP TO FUNCTION WORD
	NL4000			/SET READ/WRITE MASK
	AND I	IOHAND		/GET THE READ/WRITE BIT
	CLL IAC RTL		/0004 IF READING, 0005 IF WRITING
	RAL			/0010 IF READING, 0012 IF WRITING
	DCA	RWCOMMAND	/STORE IN COMMAND
	TAD I	IOHAND		/GET FUNCTION WORD AGAIN
	AND	(3700)		/JUST PAGE BITS
	SNA			/SKIP IF ANY SET
	NL4000			/ELSE SET MAXIMUM VALUE
	CLL RTR;RTR;RTR		/MOVE DOWN
	DCA	SCTCNT		/STORE AS SECTOR COUNT
	TAD I	IOHAND		/GET FUNCTION WORD AGAIN
	AND	(70)		/JUST TRANSFER FIELD
	CLL RTR;RAR		/MOVE DOWN
	DCA	TRFLD		/STORE AS (BANK AND) FIELD
	NL0003			/SET UNIT MASK
	AND I	IOHAND		/GET THE UNIT BITS
	CLL RTL;RTL;RAL		/MOVE UP
	DCA	SECTHI		/STORE FOR NOW
	ISZ	IOHAND		/BUMP TO RECORD POINTER
	TAD I	IOHAND		/GET THE POINTER
	DCA	SECTLO		/STASH THE POINTER
	ISZ	IOHAND		/BUMP TO ERROR RETURN
	TAD I	SECTLO		/GET LOW-ORDER BLOCK NUMBER
	DCA	IOBLKLO		/STORE IT
	ISZ	SECTLO		/BUMP TO HIGH-ORDER
	TAD I	SECTLO		/GET HIGH-ORDER BLOCK NUMBER
	DCA	IOBLKHI		/STORE IT
	TAD	SECTHI		/GET UNIT BACK
	AND	(100)		/JUST WINCHESTER/FLEXIBLE DISK BIT
	SZA CLA			/SKIP IF WINCHESTER DISK
	JMP	IOFLEX		/JUMP IF FLEXIBLE DISK
	TAD	WINSIZE		/GET BLOCK SIZE WORD
	TAD	[-200]		/COMPARE TO LIKELY VALUE
	SNA			/SKIP IF OTHER
	JMP	WIN200		/JUMP IF IT MATCHES
	TAD	[-400+200]	/COMPARE TO OTHER POSSIBLE VALUE
	SNA			/SKIP IF OTHER
	JMP	WIN400		/JUMP IF IT MATCHES
	HLT			/**** SYSTEM ERROR ****
WIN200,	TAD	IOBLKLO		/GET LOW-ORDER BLOCK NUMBER
	DCA	SECTLO		/STORE LOW-ORDER IN COMMAND
	TAD	IOBLKLO		/GET IT AGAIN
	AND	[7400]		/JUST HIGH-ORDER BITS
	CLL RAL			/MOVE UP
	DCA	SECTMD		/SAVE FOR NOW
	TAD	IOBLKHI		/GET HIGH-ORDER BLOCK NUMBER
	AND	[17]		/JUST LOW-ORDER BITS
	TAD	SECTMD		/ADD ON PRIOR BITS
	RTL;RTL			/MOVE EVERYBODY UP
	DCA	SECTMD		/STORE IN COMMAND
	TAD	IOBLKHI		/GET HIGH-ORDER BLOCK NUMBER
	RTR;RTR			/MOVE DOWN
	AND	[37]		/JUST HIGH-ORDER BITS
	TAD	SECTHI		/ADD ON UNIT BITS
	DCA	SECTHI		/STORE HIGH-ORDER IN COMMAND
	TAD	(IOTABLE)	/POINT AT COMMAND
	JMS I	[CEXC]		/GO DO IT
	SZA			/SKIP IF NO ERRORS
	NL4000			/ELSE SET FAILURE VALUE
	SMA			/SKIP IF ERROR RETURN
	ISZ	IOHAND		/ELSE BUMP TO GOOD RETURN
IOEXIT,	.-.			/WILL BE CIF CDF RETURN FIELD
	JMP I	IOHAND		/RETURN TO CALLER

WIN400,	TAD	SCTCNT		/GET SECTOR COUNT
	CLL RAR			/%2
	DCA	SCTCNT		/STORE BACK
	TAD	IOBLKHI		/GET HIGH-ORDER BLOCK NUMBER
	CLL RAR			/%2
	DCA	IOBLKHI		/STORE BACK
	TAD	IOBLKLO		/GET LOW-ORDER BLOCK NUMBER
	RAR			/%2
	DCA	IOBLKLO		/STORE BACK
	JMP	WIN200		/CONTINUE THERE

IOFLEX,	CDF	PRGFLD		/GOTO MAIN FIELD
	NL7776			/SETUP FORMAT MASK
	AND I	[FLPFRM]	/GET FLEXIBLE DISK FORMAT
	CDF	PR1FLD		/BACK TO OUR FIELD
	SNA			/SKIP IF NOT 3740 FORMAT
	JMP I	(FLX100)	/JUMP IF IT IS
	TAD	(-6+0)		/COMPARE TO SYSTEM 34 FORMAT
	SNA			/SKIP IF OTHER
	JMP I	(FLXWRD)	/JUMP IF IT MATCHES
	TAD	[-206+6]	/COMPARE TO ONE-PAGE FORMAT
	SNA			/SKIP IF OTHER
	JMP	WIN200		/HANDLE SAME AS SAME SIZE WINCHESTER
	TAD	(-212+206)	/COMPARE TO TWO-PAGE FORMAT
	SNA			/SKIP IF OTHER
	JMP	WIN400		/HANDLE SAME AS SAME SIZE WINCHESTER
	HLT			/**** SYSTEM ERROR ****
/	READ/WRITE COMMAND TABLE.

IOTABLE,.-.^400+6!DMAIND	/TABLE LENGTH PLUS DMA INDICATOR
RWCOMMA,.-.			/10 IF READING, 12 IF WRITING
SECTHI,	.-.			/UNIT AND HIGH-ORDER SECTOR BITS HERE
SECTMD,	.-.			/MIDDLE SECTOR BITS
SECTLO,	.-.			/LOW-ORDER SECTOR BITS
SCTCNT,	.-.			/SECTOR COUNT
SCONTRL,300			/CONTROL WORD: DISABLE RETRIES, ECC CORRECTION
TRFLD,	.-.			/(BANK AND) FIELD
TRADDR,	.-.			/TRANSFER ADDRESS

IOBLKLO,.-.			/LOW-ORDER BLOCK NUMBER
IOBLKHI,.-.			/HIGH-ORDER BLOCK NUMBER

	PAGE
FLX100,	CLA			/CLEAN UP
	TAD I	(SCTCNT)	/GET THE SECTOR COUNT
	CLL RAL			/*2
FLXWENT,DCA I	(SCTCNT)	/STORE IT BACK
	TAD I	(IOBLKLO)	/GET LOW-ORDER BLOCK NUMBER
	CLL RAL			/*2
	DCA I	(IOBLKLO)	/STORE IT BACK
	TAD I	(IOBLKHI)	/GET HIGH-ORDER BLOCK NUMBER
	RAL			/*2
	DCA I	(IOBLKHI)	/STORE IT BACK
	JMP I	(WIN200)	/CONTINUE THERE

FLXWRD,	TAD I	(IOBLKHI)	/GET HIGH-ORDER BLOCK NUMBER
	SZA CLA			/SKIP IF POSSIBLE
	JMP	FLXW15		/JUMP IF NOT
	CLL			/CLEAR LINK FOR TEST
	TAD I	(IOBLKLO)	/GET LOW-ORDER BLOCK NUMBER
	TAD	(-15)		/COMPARE TO PROBLEM BLOCK
	SZL CLA			/SKIP IF A PROBLEM
	JMP	FLXW15		/JUMP IF NOT
	TAD I	(IOBLKLO)	/GET LOW-ORDER BLOCK NUMBER
	TAD I	(SCTCNT)	/ADD ON SECTOR COUNT
	TAD	(-15)		/COMPARE TO LIMIT
	SPA/SNA			/SKIP IF MIXED SITUATION
	JMP	FLX100		/JUMP IF SIMPLE CASE ALL ON TRACL ZERO
	DCA I	(SCTCNT)	/SAVE REMAINDER FOR LATER
	TAD I	(IOBLKLO)	/GET LOW-ORDER BLOCK NUMBER
	CIA			/INVERT IT
	TAD	(15)		/NOW HAVE SMALL SECTOR COUNT
	CLL RAL			/DOUBLE IT FOR PHYSICAL SECTOR COUNT
	TAD I	(SCTCNT)	/ADD ON REMAINDER
	JMP	FLXWENTRY	/CONTINUE THERE

FLXW15,	CLL			/CLEAR LINK
	TAD I	(IOBLKLO)	/GET LOW-ORDER
	TAD	(15)		/ADD ON 15
	DCA I	(IOBLKLO)	/STORE BACK
	RAL			/GET CARRY
	TAD I	(IOBLKHI)	/GET HIGH-ORDER
	DCA I	(IOBLKHI)	/STORE BACK
	JMP I	(WIN200)	/CONTINUE THERE
/	SEEK ROUTINE.

SEEKTRK,.-.			/SEEK TO TRACK ROUTINE
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	SEEKXIT		/STORE IN-LINE
	JMS I	[SETADR]	/SETUP THE UNIT
	SKSCTHI			/AND DISK ADDRESS
	TAD	(SKTABLE)	/POINT AT COMMAND
	JMS I	[CEXC]		/GO EXECUTE COMMAND
SEEKXIT,.-.			/WILL BE CIF CDF RETURN FIELD
	JMP I	SEEKTRK		/RETURN TO CALLER

/	SEEK COMMAND.

SKTABLE,.-.^400+6		/COMMAND LENGTH
	SEEKFN			/COMMAND
SKSCTHI,.-.			/UNIT BITS AND HIGH-ORDER SECTOR BITS
SKSCTMD,.-.			/MIDDLE SECTOR BITS
SKSCTLO,.-.			/LOW-ORDER SECTOR BITS
	0			/NOT USED
	200			/CONTROL WORD: DISABLE RETRIES

/	DMA ROUTINE.

DMAFUN,	.-.			/DMA ROUTINE
	TAD	(RDMAFN)	/ADD BASIC COMMAND TO PASSED OFFSET
	DCA	DMCOMMAND	/STORE IN COMMAND
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	DMAFXT		/STORE IN-LINE
	CDF	PR1FLD		/GOTO OUR FIELD
	TAD I	(DMTADR)	/GET TRANSFER ADDRESS
	DCA	DMTRADDRESS	/STORE IN COMMAND
	TAD I	(DMTADR+1)	/GET (BANK AND) FIELD
	DCA	DMTRFLD		/STORE IN COMMAND
	TAD	(DMCTABLE)	/POINT AT COMMAND
	JMS I	[CEXC]		/GO EXECUTE COMMAND
DMAFXT,	.-.			/WILL BE CIF CDF RETURN FIELD
	JMP I	DMAFUN		/RETURN TO CALLER

/	DMA COMMAND TABLE.

DMCTABL,.-.^400+6!DMAIND	/TABLE LENGTH PLUS DMA INDICATOR
DMCOMMA,.-.			/READ DMA OR WRITE DMA COMMAND GOES HERE
	0^40			/UNIT NUMBER
	ZBLOCK	3		/NOT USED
	300			/CONTROL FIELD
DMTRFLD,.-.			/(BANK AND) FIELD
DMTRADD,.-.			/TRANSFER ADDRESS
	PAGE
/	TEST READY (SENSE STATUS) ROUTINE.

TREADY,	.-.			/TEST READY ROUTINE
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	TRDEXIT		/STORE IN-LINE
	CDF	PRGFLD		/GOTO MAIN FIELD
	TAD I	[UNIT]		/GET UNIT NUMBER
	CDF	PR1FLD		/BACK TO OUR FIELD
	CLL RTL;RTL;RAL		/MOVE UP
	DCA	TRUNIT		/STORE IN COMMAND
	TAD	(TRCOMMAND)	/POINT AT COMMAND
	JMS I	[CEXC]		/GO EXECUTE THE COMMAND
TRDEXIT,.-.			/WILL BE CIF CDF RETURN FIELD
	JMP I	TREADY		/RETURN TO CALLER

/	TEST READY COMMAND.

TRCOMMA,.-.^400+6		/COMMAND LENGTH
	TRFN			/COMMAND
TRUNIT,	.-.			/UNIT STORED HERE
	ZBLOCK	4		/REST OF COMMAND NOT USED

/	FORMAT TRACK ROUTINE.

FRMTRK,	.-.			/FORMAT TRACK ROUTINE
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	FRMTXIT		/STORE IN-LINE
	CDF	PRGFLD		/GOTO MAIN FIELD
	NL0002			/SETUP UNIT MASK
	AND I	[UNIT]		/GET THE BIT
	CLL RTR			/MOVE TO LINK
	SZL			/SKIP IF WINCHESTER DISK
	TAD I	(FINTLV)	/GET FLEXIBLE DISK INTERLEAVE FACTOR
	SNL			/SKIP IF FLEXIBLE DISK
	TAD I	(WINTLV)	/GET WINCHESTER DISK INTERLEAVE FACTOR
	DCA	INTRLV		/STORE IN COMMAND
	JMS I	[SETADR]	/SETUP THE UNIT
	FTSCTHI			/AND DISK ADDRESS
	TAD	(FTTABLE)	/POINT AT COMMAND
	JMS I	[CEXC]		/GO EXECUTE COMMAND
FRMTXIT,.-.			/WILL BE CIF CDF CALLING FIELD
	JMP I	FRMTRK		/RETURN TO CALLER

/	FORMAT TRACK COMMAND.

FTTABLE,.-.^400+6		/COMMAND LENGTH
	FTRKFN			/COMMAND
FTSCTHI,.-.			/UNIT BITS AND HIGH-ORDER SECTOR BITS
FTSCTMD,.-.			/MIDDLE SECTOR BITS
FTSCTLO,.-.			/LOW-ORDER SECTOR BITS
INTRLV,	.-.			/INTERLEAVE FACTOR
	200			/CONTROL WORD: DISABLE RETRIES
/	READ SECTORS ROUTINE.

RDSECTO,.-.			/READ SECTORS ROUTINE
	TAD	[READFN]	/ADD ON BASIC READ (MAY BE WRITE CALL!)
	DCA	RCOMMAND	/STORE IN COMMAND
	TAD	RDSECTORS	/GET OUR CALLER
	DCA	RTRACK		/MAKE IT THEIRS
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	RTRKXIT		/STORE IN-LINE
	CDF	PRGFLD		/GOTO MAIN FIELD
	TAD I	(SECTCNT)	/GET SECTOR COUNT
	CIA			/WANT POSITIVE FORM
	JMP	RDSENTRY	/CONTINUE THERE

/	READ ENTIRE TRACK ROUTINE.

RTRACK,	.-.			/READ A TRACK ROUTINE
	TAD	[READFN]	/ADD ON READ COMMAND (MAY BE WRITE CALL!)
	DCA	RCOMMAND	/STORE IN COMMAND
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	RTRKXIT		/STORE IN-LINE
	CDF	PRGFLD		/GOTO MAIN FIELD
	NL0002			/SETUP UNIT MASK
	AND I	[UNIT]		/GET WINCHESTER/FLEXIBLE DISK MASK
	CLL RTR			/MOVE TO LINK
	SZL			/SKIP IF WINCHESTER DISK
	TAD	FDCNT		/USE FLEXIBLE DISK SECTOR COUNT
	SNL			/SKIP IF FLEXIBLE DISK
	TAD	WDCNT		/USE WINCHESTER DISK SECTOR COUNT
RDSENTR,DCA	RTSCNT		/STORE SECTOR COUNT IN COMMAND
	JMS I	[SETADR]	/SETUP THE UNIT
	RTSCTHI			/AND DISK ADDRESS
	TAD	(RDTABLE)	/POINT AT COMMAND
	JMS I	[CEXC]		/GO EXECUTE COMMAND
RTRKXIT,.-.			/WILL BE CIF CDF RETURN FIELD
	JMP I	RTRACK		/RETURN TO CALLER

/	READ COMMAND TABLE.

RDTABLE,.-.^400+6!DMAIND	/TABLE LENGTH PLUS DMA INDICATOR
RCOMMAN,.-.			/READ OR WRITE COMMAND GOES HERE
RTSCTHI,.-.			/UNIT BITS AND HIGH-ORDER SECTOR BITS
RTSCTMD,.-.			/MIDDLE SECTOR BITS
RTSCTLO,.-.			/LOW-ORDER SECTOR BITS
RTSCNT,	.-.			/SECTOR COUNT
RTCONTR,300			/CONTROL WORD: DISABLE RETRIES, ECC CORRECTION
RTRFLD,	DATFLD%10		/(BANK AND) FIELD
RTRADDR,0			/TRANSFER ADDRESS
	PAGE
/	SASI COMMAND EXECUTION ROUTINE.

CEXC,	.-.			/COMMAND EXECUTION ROUTINE
	CDF	PR1FLD		/ENSURE OUR FIELD
	DCA	SCP		/SAVE COMMAND POINTER
	TAD I	SCP		/GET COMMAND HEADER
	AND	(4377)		/REMOVE CONTROLLER BITS
	TAD	CNTSEL		/ADD ON CURRENT CONTROLLER
	DCA I	SCP		/STORE IN COMMAND HEADER
	TAD	(-200)		/GET INITIAL TIME-OUT FACTOR
	JMS	CSETUP		/SETUP TIME-OUT
	DSRS			/GET STATUS NOW
	SPA CLA			/SKIP IF IDLE
	JMP	CTIMOUT		/ELSE GO TIME IT OUT
	TAD	(PR1FLD%10)	/GET (BANK AND) FIELD
	DSHI			/LOAD IT
	NL7775			/SETUP TIME-OUT FACTOR
	JMS	CSETUP		/SET TIME-OUT ROUTINE
	DSRS			/GET STATUS NOW
	SMA CLA			/SKIP IF NOW BUSY
	JMP	CTIMOUT		/ELSE GO TIME IT OUT
	DSCF			/CLEAR FLAG NOW
	TAD	SCP		/GET COMMAND POINTER
	DSGO			/START IT UP
	JMS	CWAIT		/WAIT FOR COMMAND TO TAKE
	DSIM			/FINISH COMMAND
	JMS	CWAIT		/WAIT FOR COMMAND TO EXECUTE
CEXCXIT,CDF	PRGFLD		/GOTO MAIN FIELD
	JMP I	CEXC		/RETURN

CSETUP,	.-.			/TIME-OUT SETUP ROUTINE
	DCA	CTIMER		/SAVE TIME-OUT COUNTER VALUE
	JMP I	CSETUP		/RETURN

CTIMOUT,ISZ	CFOO		/DONE ENOUGH?
	JMP I	CSETUP		/NO, KEEP GOING
	ISZ	CTIMER		/DONE TOO MANY?
	JMP I	CSETUP		/NO, KEEP GOING
	NL7777			/SET TIME-OUT ERROR VALUE
	JMP	CEXCXIT		/RETURN WITH ERROR
CWAIT,	.-.			/WAIT ROUTINE
	NL5777			/SETUP THE WAIT FACTOR
	JMS	CSETUP		/SETUP LONG TIME-OUT
	DSSF			/FLAG UP?
	JMP	CTIMOUT		/NO, TIME IT OUT
	DSCF			/YES, CLEAR IT NOW
	AND I	0		/\
	AND I	0		/ \
	AND I	0		/  \
	AND I	0		/   \WASTE
	AND I	0		/   /SOME TIME
	AND I	0		/  /
	AND I	0		/ /
	AND I	0		//
	DSRS			/GET STATUS
	DCA	CSTATUS		/STASH IT
	TAD	CSTATUS		/GET IT BACK
	CLL RAL			/REMOVE BUSY BIT
	SNA CLA			/SKIP IF ANY ERRORS
	JMP I	CWAIT		/ELSE RETURN
	TAD	CSTATUS		/GET THE ERROR STATUS
	JMP	CEXCXIT		/RETURN WITH ERROR

CFOO,	.-.			/TIME-OUT INNER COUNTER
CNTSEL,	CNUM^400		/CONTROLLER SELECT WORD
CSTATUS,.-.			/ERROR STATUS
CTIMER,	.-.			/TIME-OUT COUNTER
SCP,	.-.			/SASI COMMAND POINTER
/	SASI COMMAND ADDRESS SETUP ROUTINE.

SETADR,	.-.			/SETUP ADDRESS ROUTINE
	CDF	PR1FLD		/ENSURE OUR FIELD
	TAD I	SETADR		/GET HIGH-ORDER ADDRESS POINTER
	DCA	HSCTPTR		/STASH THE POINTER
	NL0001			/SET INCREMENT
	TAD	HSCTPTR		/POINT AT MIDDLE ADDRESS
	DCA	MSCTPTR		/STASH THE POINTER
	NL0002			/SET INCREMENT
	TAD	HSCTPTR		/POINT AT LOW-ORDER ADDRESS
	DCA	LSCTPTR		/STASH THE POINTER
	ISZ	SETADR		/BUMP PAST THE ARGUMENT
	CDF	PRGFLD		/GOTO MAIN FIELD
	TAD I	[UNIT]		/GET LOGICAL UNIT
	CLL RTL;RTL;RAL		/MOVE UP UNIT BITS
	CDF	PR1FLD		/BACK TO OUR FIELD
	DCA I	HSCTPTR		/STORE IN COMMAND FOR NOW
	CDF	PRGFLD		/GOTO MAIN FIELD
	TAD I	[FBLK]		/GET LOW-ORDER DISK ADDRESS
	CDF	PR1FLD		/BACK TO OUR FIELD
	DCA I	LSCTPTR		/STORE IN COMMAND
	TAD I	LSCTPTR		/GET IT BACK
	AND	[7400]		/JUST NEEDED BITS
	CLL RAL			/MOVE UP
	DCA I	MSCTPTR		/STORE FOR NOW
	CDF	PRGFLD		/GOTO MAIN FIELD
	TAD I	[FBLK+1]	/GET HIGH-ORDER DISK ADDRESS
	CDF	PR1FLD		/BACK TO OUR FIELD
	AND	[17]		/JUST NEEDED BITS
	TAD I	MSCTPTR		/ADD ON OTHER BITS
	RTL;RTL			/MOVE EVERYONE AROUND
	DCA I	MSCTPTR		/STORE IN COMMAND
	CDF	PRGFLD		/GOTO MAIN FIELD
	TAD I	[FBLK+1]	/GET HIGH-ORDER AGAIN
	CDF	PR1FLD		/BACK TO OUR FIELD
	RTR;RTR			/MOVE DOWN
	AND	[37]		/ISOLATE NEEDED BITS
	TAD I	HSCTPTR		/ADD ON UNIT BITS
	DCA I	HSCTPTR		/STORE IN COMMAND
	JMP I	SETADR		/RETURN TO CALLER

HSCTPTR,.-.			/HIGH-ORDER ADDRESS POINTER
LSCTPTR,.-.			/LOW-ORDER ADDRESS POINTER
MSCTPTR,.-.			/MIDDLE ADDRESS POINTER

