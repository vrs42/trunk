QSTCNT,	.-.			/COUNTER

CHKN,	.-.			/CHECK FOR <^N>, ETC. ROUTINE
	CIF	PR1FLD		/GOTO CODE FIELD
	JMS I	[CHKUP]		/CHECK FOR <^P>, ETC.
	TAD	UNSW		/GET <^N> SWITCH
	SNA CLA			/SKIP IF SET
	JMP I	CHKN		/ELSE JUST RETURN
	TAD	["^&177]	/GET "^"
	JMS I	[PRINT]		/PRINT IT
	TAD	("N&177)	/GET "N"
