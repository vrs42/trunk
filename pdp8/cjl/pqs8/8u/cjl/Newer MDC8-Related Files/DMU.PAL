/MDC8 DISK MAINTENANCE UTILITY
	XLIST	OFF
	IFNDEF	OFF	<OFF=	1>
	IFNDEF	ON	<ON=	0>
	XLIST	ON

/	LAST EDIT:	01-NOV-1985	12:00:00	CJL

/	STAND-ALONE DISK MAINTENANCE UTILITY FOR MDC8/WINCHESTER AND FLEXIBLE DISKS.

/	REQUIRES PDP-8/I PROCESSOR (OR BETTER) WITH MQ.

/	(C)	1985	CHARLES LASNER ASSOCIATES.

/	ASSEMBLY INSTRUCTIONS:

/	CHANGE "DEVCODE" TO PROPER DEVICE CODE AS NECESSARY (DEFAULT IS 70).

/	MUST BE ASSEMBLED WITH '/J' (OS/8 PAL8 '/F') SWITCH SET.
/	ASSEMBLY DEFINITIONS, ETC.

/	ASSEMBLY LISTING PARAMETER.

/	IFNDEF	LSTMES	<LSTMES=0>	/DON'T LIST TEXT MESSAGES
	IFNDEF	LSTMES	<LSTMES=1>	/LIST TEXT MESSAGES

/	PRINTING PARAMETER.

/	IFNDEF	PDEBUG	<PDEBUG=0>	/DON'T ALLOW PRINTER DEBUGGING
	IFNDEF	PDEBUG	<PDEBUG=1>	/ALLOW PRINTER DEBUGGING OUTPUT FROM LAS

/	FORM-FEED PARAMETER.

/	IFNDEF	NOFORM	<NOFORM=1>	/DON'T ALLOW <FF> ON SCREEN MENU MESSAGES
	IFNDEF	NOFORM	<NOFORM=0>	/ALLOW <FF> ON SCREEN MENU MESSAGES

/	VT100 PARAMETER.

/	IFNDEF	VT100	<VT100=1>	/DO VT100 ESCAPE SEQUENCES ON SCREENS
	IFNDEF	VT100	<VT100=0>	/DON'T DO VT100 ESCAPE SEQUENCES

/	MDC8 IOT DEFINITIONS.

	IFNDEF	DEVCODE	<DEVCODE=70>	/USES 670X BY DEFAULT

	DSEI=	DEVCODE^10+6000		/INTERRUPT ENABLE/DISABLE PER AC[11]
	DSSF=	DEVCODE^10+6001		/SKIP ON DONE FLAG
	DSCF=	DEVCODE^10+6002		/CLEAR DONE FLAG
	DSHI=	DEVCODE^10+6003		/LOAD HIGH-ORDER COMMAND ADDRESS
	DSGO=	DEVCODE^10+6004		/LOAD LOW-ORDER COMMAND AND GO
/	    =	DEVCODE^10+6005		/UNUSED
	DSRS=	DEVCODE^10+6006		/READ STATUS
	DSIM=	DEVCODE^10+6007		/INTERFACE MAINTENANCE INSTRUCTION

/	CONTROLLER PARAMETER.

	IFNDEF	CNUM	<CNUM=	0>	/USES CONTROLLER ZERO BY DEFAULT

/	CONSOLE IOT DEFINITIONS.

/	IFNDEF	CICODE	<CICODE=40>	/USES 640X BY DEFAULT
/	IFNDEF	COCODE	<COCODE=41>	/USES 641X BY DEFAULT
	IFNDEF	CICODE	<CICODE=03>	/USES 603X BY DEFAULT
	IFNDEF	COCODE	<COCODE=04>	/USES 604X BY DEFAULT

	KCCIOT=	CICODE^10+6002		/CLEAR KEYBOARD FLAG, AC
	KRSIOT=	CICODE^10+6004		/READ KEYBOARD BUFFER, DON'T CLEAR FLAG
	KSFIOT=	CICODE^10+6001		/SKIP ON KEYBOARD FLAG
	TLSIOT=	COCODE^10+6006		/LOAD OUTPUT, CLEAR FLAG
	TSFIOT=	COCODE^10+6001		/SKIP ON OUTPUT FLAG
/	LINE PRINTER IOT DEFINITIONS.

/	IFNDEF	LICODE	<LICODE=65>	/USES 665X BY DEFAULT
/	IFNDEF	LOCODE	<LOCODE=66>	/USES 666X BY DEFAULT
	IFNDEF	LICODE	<LICODE=40>	/USES 640X BY DEFAULT
	IFNDEF	LOCODE	<LOCODE=41>	/USES 641X BY DEFAULT
/	IFNDEF	LICODE	<LICODE=43>	/USES 643X BY DEFAULT
/	IFNDEF	LOCODE	<LOCODE=47>	/USES 647X BY DEFAULT

	LKCCIOT=LICODE^10+6002		/CLEAR INPUT FLAG, AC
	LKRBIOT=LICODE^10+6006		/LOAD KEYBOARD BUFFER, CLEAR FLAG
	LKSFIOT=LICODE^10+6001		/SKIP ON INPUT FLAG
	LLSIOT=	LOCODE^10+6006		/LOAD OUTPUT, CLEAR FLAG
	LSFIOT=	LOCODE^10+6001		/SKIP ON OUTPUT FLAG

/	EXTENDED ARITHMETIC DEFINITIONS.

	XLIST	OFF
	IFNDEF	DAD	<DAD=	0>
	IFNDEF	DCM	<DCM=	0>
	IFNDEF	DLD	<DLD=	0>
	IFNDEF	DST	<DST=	0>
	IFNDEF	DVI	<DVI=	0>
	XLIST	ON
	CAM=	CLA MQL			/CLEAR AC, MQ
	DAD=	JMS I	[DADD]		/DOUBLE-PRECISION ADD
	DCM=	JMS I	[DCOM]		/DOUBLE-PRECISION COMPLEMENT
	DLD=	JMS I	[DLOAD]		/DOUBLE-PRECISION LOAD
	DST=	JMS I	[DSTORE]	/DOUBLE-PRECISION STORE
	DVI=	JMS I	[DIVIDE]	/DIVIDE

/	DEVICE SIZE AND AREA DEFINITIONS.

	BLKSIZE=0400			/SIZE OF ONE RECORD IN WORDS
	MBLKSIZ=-BLKSIZE		/-(SIZE OF ONE RECORD IN WORDS)

/	DEFAULT FLEXIBLE DISK PARAMETERS.

	DFLFRM=	0207			/256 BYTES/SECTOR, 26 SECTORS/TRACK DOUBLE-SIDED
	FDEFSIZ=0200			/256 BYTES/SECTOR DEFAULT SECTOR SIZE
	FDSECS=	0032			/26 SECTORS/TRACK IS DEFAULT TRACK SIZE
	FTDEFHI=0000			/DEFAULT TRACK COUNT - HIGH-ORDER
	FTDEFLO=0115			/DEFAULT TRACK COUNT - LOW-ORDER

/	DEFAULT WINCHESTER DISK PARAMETERS.

	WDEFSIZ=0200			/256 BYTES/SECTOR DEFAULT SECTOR SIZE
	WDHEADS=0006			/SIX HEADS ON DEFAULT WINCHESTER DISK
	WPDEFHI=0000			/DEFAULT PHYSICAL TRACK COUNT - HIGH-ORDER
	WPDEFLO=3454			/DEFAULT PHYSICAL TRACK COUNT - LOW-ORDER
	WDSECS=	0041			/33 SECTORS/TRACK IS DEFAULT TRACK SIZE
	WTDEFHI=0000			/DEFAULT LOGICAL TRACK COUNT - HIGH-ORDER
	WTDEFLO=3350			/DEFAULT LOGICAL TRACK COUNT - LOW-ORDER
/	MEMORY DEFINITIONS.

	DATFLD=	0040			/DATA FIELD
	MSGFLD=	0050			/MESSAGE FIELD
	MS2FLD=	0060			/SECOND MESSAGE FIELD
	PRGFLD=	0000			/PROGRAM FIELD
	PR1FLD=	0010			/FIRST ADDITIONAL PROGRAM FIELD
	PR2FLD=	0020			/SECOND ADDITIONAL PROGRAM FIELD
	TBLFLD=	0030			/BAD TRACK TABLE FIELD

/	SASI CONTROLLER FUNCTION DEFINITIONS.

	DFDFFN=	0300			/DEFINE FLEXIBLE DISK FORMAT FUNCTION
	FTRKFN=	0006			/FORMAT TRACK FUNCTION
	RDMAFN=	0354			/READ DMA BUFFER
	READFN=	0010			/READ DATA FUNCTION
	SEEKFN=	0013			/SEEK FUNCTION
	SIPVAL=	0015			/SEEK IN PROGRESS STATUS VALUE
	TRFN=	0000			/TEST READY FUNCTION
	WDMAFN=	0357			/WRITE DMA BUFFER
	WRITFN=	0012			/WRITE DATA FUNCTION

/	SEEK PARAMETER DEFINITIONS.

	DEFCNT=	1			/DEFAULT STROKE COUNT
	DEFSEP=	4			/DEFAULT SEPARATION
	LNGCNT=	4			/LONG STROKE COUNT
	LNGSEP=	1			/LONG SEPARATION

/	OTHER DEFINITIONS.

	COPSIZE=0020			/COPY PAGE COUNT
	DMAIND=	4000			/DMA INDICATOR
	XLIST	OFF
	IFNDEF	MOVE	<MOVE=	0>
	XLIST	ON
	MOVE=	JMS I	[XMOVE]		/BLOCK MOVE
	NL0000=	CLA			/LOAD AC WITH 0000
	NL0001=	CLA IAC			/LOAD AC WITH 0001
	NL0002=	CLA CLL CML RTL		/LOAD AC WITH 0002
	NL0003=	CLA CLL CML IAC RAL	/LOAD AC WITH 0003
	NL0004=	CLA CLL IAC RTL		/LOAD AC WITH 0004
	NL0006=	CLA CLL CML IAC RTL	/LOAD AC WITH 0006
	NL2000=	CLA CLL CML RTR		/LOAD AC WITH 2000
	NL3777=	CLA CLL CMA RAR		/LOAD AC WITH 3777
	NL4000=	CLA CLL CML RAR		/LOAD AC WITH 4000
	NL5777=	CLA CLL CMA RTR		/LOAD AC WITH 5777
	NL6000=	CLA CLL CML IAC RTR	/LOAD AC WITH 6000
	NL7775=	CLA CLL CMA RTL		/LOAD AC WITH 7775
	NL7776=	CLA CLL CMA RAL		/LOAD AC WITH 7776
	NL7777=	CLA CMA			/LOAD AC WITH 7777
	REVISIO="H			/REVISION LETTER
	SBOOT=	7600			/SYSTEM BOOTSTRAP ADDRESS
	VERSION=02			/VERSION NUMBER
	WRITE=	4000			/I/O HANDLER WRITE BIT
/	FIELD	PRGFLD%10	/WHERE WE START LOADING

	*0			/START AT THE BEGINNING

	IFNZRO	.	<ERROR>
EXSW,	.-.			/EXERCISER SWITCH

AESW,	.-.			/ALTERNATE ERROR SWITCH
CMPCNT,	.-.			/COMPARE COUNTER
EDFREST,.-.			/RESTART ADDRESS AFTER FLAW MAP ERROR

	ZBLOCK	7-.		/EMPTY SPACE

EXWORD,	.-.			/EXERCISE DRIVE WORD

	*10			/GET TO AUTO-INDEX AREA

XR1,	.-.			/AUTO-INDEX NUMBER ONE
XR2,	.-.			/AUTO-INDEX NUMBER TWO
DMAPATT,.-.			/DMA PATTERN
ERSW,	.-.			/PRIMARY ERROR SWITCH
FAMODE,	.-.			/4000=FACTORY, 0=USER MODE
FINTLV,	.-.			/FLEXIBLE DISK INTERLEAVE FACTOR
RCSW,	.-.			/READ CHECK SWITCH
WINTLV,	.-.			/WINCHESTER DISK INTERLEAVE FACTOR

	*20			/GET PAST AUTO-INDEX AREA

SETFLD,	.-.			/CALLING FIELD SETUP ROUTINE
	NL0002			/SET CIF BIT
	RDF			/GET CALLING FIELD
	TAD	[CDF]		/FORM CIF CDF RETURN INSTRUCTION
	JMP I	SETFLD		/RETURN

DATSET,	.-.			/DATA FIELD SETUP ROUTINE
EXCCDF,	.-.			/WILL BE CDF DATA FIELD
	JMP I	DATSETUP	/RETURN
ADVSW,	.-.			/ADVANCEMENT SWITCH
ALMODE,	.-.			/ALTERNATE MODE SWITCH
ANNSW,	.-.			/ANNOUNCEMENT SWITCH
COMCNT,	.-.			/TEMPORARY
CNT,	.-.			/COUNTER
EXRESTA,.-.			/EXERCISER RESTART ADDRESS
FBLK,	ZBLOCK	2		/FORMAT, ETC. BLOCK
FLPFRM,	.-.			/FLEXIBLE DISK FORMAT DEFINITION
FLWUNIT,.-.			/CURRENT FLAW MAP UNIT
FRSTPTR,.-.			/FIRST TIME SWITCH POINTER
GNSW,	ZBLOCK	2		/GETNMB <CR> SWITCH
INCHAR,	.-.			/INPUT BUFFER
MEMSIZE,.-.			/ACTUAL MEMORY SIZE: 1=4K ... 10=32K
NEXT,	.-.			/NEXT ROUTINE ADDRESS
OLCHAR,	.-.			/PREVIOUS CHARACTER
PATTERN,.-.			/DATA PATTERN
PRNSW,	.-.			/ERROR PRINT SWITCH
QDADDR,	ZBLOCK	2		/QUICK DMA ADDRESS
QTSTCT,	.-.			/QUICK TEST DRIVE COUNTER
REPTSW,	.-.			/QUICK CHECKOUT REPEAT CYCLE SWITCH
RSVSW,	.-.			/RANDOM SEEK-VERIFY POSITION SWITCH
SCOUNT,	.-.			/SEEK OSCILLATION COUNT (STROKE COUNT)
SECTCNT,.-.			/SECTOR COUNTER
SEPCNT,	.-.			/SEEK DOWNSTEP SIZE (SEPARATION)
SMASK,	.-.			/SEARCH MASK
STRKCTR,.-.			/STROKE COUNTER
SVSW,	.-.			/SEEK-VERIFY POSITION SWITCH
TEMP,	.-.			/TEMPORARY
TRACK,	ZBLOCK	2		/LOGICAL TRACK
TRANS,	ZBLOCK	2		/TRANSACTION NUMBER
TRKCNT,	.-.			/TRACK COUNTER - LOW-ORDER
TRKCNHI,.-.			/TRACK COUNTER - HIGH-ORDER
TSTBUFF,.-.			/TEST ADDRESS
TSTFLD,	.-.			/TEST BANK AND FIELD
TVSW,	.-.			/BAD TRACK TABLE VALIDITY SWITCH
UNIT,	.-.			/LOGICAL UNIT
UNSW,	.-.			/<^N> SWITCH
UPREST,	ZBLOCK	2		/RESTART ADDRESS FROM <^P>
UPURET,	ZBLOCK	2		/<^U> RESTART ADDRESS
URSW,	.-.			/<^R> SWITCH
WBUNIT,	.-.			/WINCHESTER BUFFER UNIT
	PAGE

/	BEGINS HERE.

START,	JMP I	(INITIALIZE)	/**** WILL BE 0000 ****
	JMP	RESTRT		/FOR RESTART

/	DOUBLE-PRECISION SIMULATOR ROUTINES.

/	DOUBLE-PRECISION ADD.

DADD,	.-.			/ADD ROUTINE
	DCA	DCOM		/SAVE HIGH-ORDER
	RDF			/GET CURRENT DATA FIELD
	TAD	[CDF]		/TURN INTO CDF INSTRUCTION
	DCA	DADCDF		/STORE IN-LINE
	CDF	PRGFLD		/BACK TO OUR FIELD
	TAD I	DADD		/GET ARGUMENT
	DCA	DLOAD		/STASH IT
DADCDF,	.-.			/RESTORE PREVAILING FIELD
	MQA			/GET LOW-ORDER
	CLL			/INITIALIZE CARRY
	TAD I	DLOAD		/ADD ON LOW-ORDER ARGUMENT
	MQL			/PUT INTO MQ
	ISZ	DADD		/BUMP PAST ARGUMENT
	ISZ	DLOAD		/BUMP TO HIGH-ORDER
	RAL			/GET CARRY
	TAD	DCOM		/RESTORE AC
	TAD I	DLOAD		/ADD ON HIGH-ORDER ARGUMENT
	JMP I	DADD		/RETURN

/	DOUBLE-PRECISION STORE.

DSTORE,	.-.			/STORE ROUTINE
	DCA	DCOM		/SAVE AC
	RDF			/GET CURRENT DATA FIELD
	TAD	[CDF]		/TURN INTO CDF INSTRUCTION
	DCA	DSTCDF		/STORE IN-LINE
	CDF	PRGFLD		/BACK TO OUR FIELD
	TAD I	DSTORE		/GET ARGUMENT
	DCA	DLOAD		/STASH IT
DSTCDF,	.-.			/RESTORE PREVAILING FIELD
	MQA			/GET LOW-ORDER
	DCA I	DLOAD		/STORE IT
	ISZ	DSTORE		/BUMP PAST ARGUMENT
	ISZ	DLOAD		/BUMP TO HIGH-ORDER
	TAD	DCOM		/RESTORE AC
	DCA I	DLOAD		/STORE IT
	TAD	DCOM		/RESTORE AC AGAIN
	JMP I	DSTORE		/RETURN
/	DOUBLE-PRECISION LOAD.

DLOAD,	.-.			/LOAD ROUTINE
	CAM			/CLEAN UP
	TAD	DLOAD		/GET OUR CALLER
	DCA	DADD		/MAKE IT THEIRS
	JMP	DADD+1		/CONTINUE THERE

/	DIVIDE.

DIVIDE,	.-.			/DIVIDE ROUTINE
	DCA	DIVAC		/SAVE PASSED AC
	RDF			/GET PREVAILING FIELD
	TAD	[CDF]		/TURN INTO CDF INSTRUCTION
	DCA	DIVCDF		/SET IT UP
	CDF	PRGFLD		/GOTO OUR FIELD
	TAD I	DIVIDE		/GET ARGUMENT POINTER
	DCA	MDIVSOR		/STASH IT
	ISZ	DIVIDE		/BUMP PAST ARGUMENT
DIVCDF,	.-.			/RESTORE PREVAILING FIELD
	TAD I	MDIVSOR		/GET DIVISOR
	CIA			/WANT NEGATIVE FORM
	DCA	MDIVSOR		/STORE IT
	MQA			/GET LOW-ORDER
	DCA	DIVMQ		/STORE IT
	TAD	(-14)		/SETUP THE
	DCA	DSHIFT		/SHIFT COUNTER
DIVLUP,	TAD	DIVMQ		/GET LOW-ORDER
	CLL RAL			/MOVE UP
	DCA	DIVMQ		/STORE BACK
	TAD	DIVAC		/GET HIGH-ORDER
	RAL			/MOVE UP
	DCA	DIVAC		/STORE BACK
	TAD	DIVAC		/GET IT BACK
	TAD	MDIVSOR		/COMPARE TO DIVISOR
	SZL			/CARRY?
	DCA	DIVAC		/YES, STORE BACK
	SZL CLA			/CARRY?
	ISZ	DIVMQ		/YES, BUMP QUOTIENT
	ISZ	DSHIFT		/DONE ALL YET?
	JMP	DIVLUP		/NO, GO BACK
	TAD	DIVMQ		/GET LOW-ORDER
	MQL			/RESTORE IT
	TAD	DIVAC		/GET REMAINDER
	JMP I	DIVIDE		/RETURN
/	DOUBLE-PRECISION COMPLEMENT.

DCOM,	.-.			/COMPLEMENT ROUTINE
	SWP			/GET LOW-ORDER FIRST
	CLL CIA			/INVERT IT
	SWP			/PUT IT BACK
	CMA			/INVERT HIGH-ORDER
	SZL			/CARRY?
	IAC			/YES, SO INCREMENT
	JMP I	DCOM		/RETURN

/	STORAGE DEFINITIONS FOR DIVIDE ROUTINE.

	DIVAC=	DADD		/DIVIDE AC
	DIVMQ=	DLOAD		/DIVIDE MQ
	MDIVSOR=DCOM		/DIVISOR
	DSHIFT=	DSTORE		/SHIFT COUNTER

/	COMES HERE AFTER I/O FAILURE.

FAIL,	JMS I	[MESSAGE]	/TELL THEM
	FAILMSG			/THEY BLEW IT

/	WAIT FOR ANY RESPONSE AND RESTART.

AGAIN,	CIF	PR1FLD		/GOTO CODE FIELD
	JMS I	[WAITRESPONSE]	/WAIT FOR A RESPONSE
	PRSMSG			/TO THIS MESSAGE
	JMP	RESTART		/CONTINUE THERE

/	RESTARTS HERE.

RESTRT,	TLSIOT			/SET TTY: FLAG
	LLSIOT			/SET LPT: FLAG
RESTART,JMS I	[SETUP]		/SETUP RESTART ADDRESS
	JMS I	[SCRNMESSAGE]	/ANNOUNCE OURSELVES
	SCRN01			/WITH FIRST BLURB
	CAM			/CLEAN UP
	DST;	FBLK		/CLEAR BLOCK FOR ERROR REPORTS
	CIF	PR2FLD		/GOTO CODE FIELD
	JMS I	[GETCOMMAND]	/GET OUR COMMAND
	FRST-1			/FIRST LETTER LIST-1
	FRST-SCND		/LENGTH OF LIST
	FINLST-1		/TEXT/DISPATCH LIST-1

	PAGE
/	DRIVE ENABLE COMMAND COMES HERE.

DRVENAB,JMS I	[SETUP]		/SETUP RESTART ADDRESS
	JMS I	[SCRNMESSAGE]	/ANNOUNCE OURSELVES
	SCRN02			/WITH OUR BLURB
	CIF	PR2FLD		/GOTO CODE FIELD
	JMS I	[MULTENABLE]	/CALL MULTI-UNIT ENABLE ROUTINE
	EDMSG			/PASS MESSAGE ADDRESS FOR ENABLING
	DCA	GNSW		/SAVE ENABLE WORD
DENAGN,	CIF	PR1FLD		/GOTO CODE FIELD
	JMS I	[WAITRESPONSE]	/TELL THEM TO
	DENMSG			/ENABLE THE DRIVES
	TAD	GNSW		/GET ENABLE VALUE
	CIF	PR2FLD		/GOTO CODE FIELD
	JMS I	(ENADRV)	/ENABLE CURRENT DRIVE CONFIGURATION
	SNA CLA			/SKIP IF THERE WERE PROBLEMS
	JMP	DENOK		/JUMP IF NO PROBLEMS
	CIF	PR1FLD		/GOTO CODE FIELD
	JMS I	[ERRPRSPECIAL]	/TELL THEM
	DERMSG			/OF THEIR PROBLEM
	CIF	PR1FLD		/GOTO CODE FIELD
	JMS I	(ASKRETRY)	/ASK FOR A RETRY
	JMP	DENAGN		/JUMP IF YES
	JMP I	(FAIL)		/FORGET IT

DENOK,	JMS I	[MESSAGE]	/TELL THEM
	EOKMSG			/ENABLE SUCCEEDED
	JMP I	[AGAIN]		/WAIT FOR THEM AND RESTART
/	DISK-DEPENDENT FUNCTIONS COME HERE.

/	MAKE UP A GOOD NAME FOR ABOVE!

/	DEFINE FLEXIBLE DISK FORMAT COMMAND COMES HERE.

DEFLOP,	JMS I	[SETUP]			/SETUP RESTART ADDRESS
	JMS I	[SCRNMESSAGE]		/ANNOUNCE OURSELVES
	SCRN03				/WITH OUR BLURB
	CIF	PR2FLD			/GOTO CODE FIELD
	JMS I	[GETCOMMAND]		/GET OUR COMMAND
	DFRST-1				/FIRST LETTER LIST-1
	DFRST-DSCND			/LENGTH OF LIST
	DFINLST-1			/TEXT/DISPATCH LIST-1

/	EXTENDED DENSITY DEFINITION COMES HERE.

EXDENSI,NL0004	/TAD	(212-206)	/GET OFFSET FOR EXTENDED DENSITY

/	DOUBLE DENSITY DEFINITION COMES HERE.

DDENSIT,TAD	(206-6)			/GET OFFSET FOR DOUBLE DENSITY

/	SPECIAL DOUBLE DENSITY DEFINITION COMES HERE.

SPDENSI,TAD	(6-0)			/GET SPECIAL DENSITY VALUE

/	SINGLE DENSITY DEFINITION COMES HERE.

SDENSIT,DCA	DENTEMP			/SAVE BASIC VALUE
	JMS I	[MESSAGE]		/ASK THEM
	DSIDMSG				/IF DOUBLE SIDED
	CIF	PR1FLD			/GOTO CODE FIELD
	JMS I	[YORNO]			/GET RESPONSE
	NL0001				/YES, SET INCREMENT FOR SECOND SIDE
	TAD	DENTEMP			/GET BASIC VALUE EITHER WAY
	DCA	FLPFRM			/STORE FINAL FORMAT DEFINITION
/	DO DEFINE FLEXIBLE DISK FORMAT COMMAND HERE.
	JMP I	[AGAIN]			/WAIT FOR THEM AND RESTART

/	ASSIGN DISK PARAMETERS COMMAND COMES HERE.

DENTEMP,.-.				/TEMPORARY

	PAGE
/	QUICK CHECKOUT TEST COMMAND COMES HERE.

QUICK,	JMS I	[SETUP]		/SETUP RESTART ADDRESS
	JMS I	[SCRNMESSAGE]	/ANNOUNCE OURSELVES
	QUMENU			/WITH OUR BLURB
QIKAGN,	CIF	PR2FLD		/GOTO CODE FIELD
	JMS I	[GETCOMMAND]	/GET OUR COMMAND
	QUFRST-1		/FIRST LETTER LIST-1
	QUFRST-QUSCND		/LENGTH OF LIST
	QUFINLST-1		/TEXT/DISPATCH LIST-1

/	COMES HERE IF NO DRIVES SELECTED FOR QUICK CHECKOUT TESTS.

CHKNO,	JMS I	[MESSAGE]	/TELL THEM
	EXNMSG			/THEY GOOFED!

/	QUICK CHECKOUT TEST COMMAND COMES HERE.

QUIK,	CIF	PR2FLD		/GOTO CODE FIELD
	JMS I	[MULTENABLE]	/GET MULTIPLE DRIVES ENABLED FOR TEST
	TDMSG			/TEST MESSAGE
	SNA			/ANY SELECTED
	JMP	CHKNO		/NO, BARF
	DCA	EXWORD		/YES, STORE COMPOSITE
	NL0001			/SETUP UNIT ZERO MASK
	AND	EXWORD		/GET THE BIT
	SNA CLA			/SKIP IF ENABLED
	JMP	QTRED1		/JUMP IF NOT
/	NL0000			/SET UNIT ZERO VALUE
	CIF	PR1FLD		/GOTO CODE FIELD
	JMS I	(QTMOUNT)	/HAVE UNIT ZERO MOUNTED
QTRED1,	NL0002			/SETUP UNIT ONE MASK
	AND	EXWORD		/GET THE BIT
	SNA CLA			/SKIP IF ENABLED
	JMP	QTRED2		/JUMP IF NOT
	NL0001			/SET UNIT ONE VALUE
	CIF	PR1FLD		/GOTO CODE FIELD
	JMS I	(QTMOUNT)	/HAVE UNIT ONE MOUNTED
QTRED2,	NL0004			/SETUP UNIT TWO MASK
	AND	EXWORD		/GET THE BIT
	SNA CLA			/SKIP IF ENABLED
	JMP	QTRED3		/JUMP IF NOT
	NL0002			/SET UNIT TWO VALUE
	CIF	PR1FLD		/GOTO CODE FIELD
	JMS I	(QTMOUNT)	/HAVE UNIT TWO MOUNTED
QTRED3,	TAD	EXWORD		/GET ENABLE WORD
	AND	[10]		/GET UNIT THREE BIT
	SNA CLA			/SKIP IF ENABLED
	JMP	QTREDY		/JUMP IF NOT
	NL0003			/SET UNIT THREE VALUE
	CIF	PR1FLD		/GOTO CODE FIELD
	JMS I	(QTMOUNT)	/HAVE UNIT THREE MOUNTED
QTREDY,	JMS I	[MESSAGE]	/TELL THEM
	QIPMSG			/WE HAVE BEGUN
	DCA	UNSW		/CLEAR <^N> SWITCH
/	QUICK TEST 1:	FORMAT DRIVES.

QFTEST,	JMS I	(SETN)		/SETUP <^N> FOR
	QFTEND			/NEXT TEST
QFTLUP,	JMS I	(CHKN)		/CHECK FOR <^N>, ETC.
	JMS I	(QBTEST)	/CHECK IF LATEST DRIVE IS ENABLED FOR TESTING
	SNA CLA			/SKIP IF SO
	JMP	QFTEND		/JUMP IF NOT
	JMS I	(ANNMSG)	/TELL THEM
	QFMSG			/WE ARE FORMATTING
	CIF	PR1FLD		/GOTO CODE FIELD
	JMS I	(RBTTBL)	/READ IN FLAW TABLE
	JMS I	(FRMLENGTH)	/DO COMMON SETUP
	JMS I	[SETUP]		/SETUP <^P> FIELD
	TAD	(QFRXIT)	/SETUP THE
	DCA	UPREST		/<^P> ADDRESS
	TAD	(QUAB)		/SETUP THE
	DCA	NEXT		/<^N> BYPASS
QFRMLP,	TAD	TRACK		/GET DISPLAY TRACK
	MQL			/LOAD IT
	CIF	PR1FLD		/GOTO CODE FIELD
	JMS I	(FRMTRK)	/FORMAT LATEST TRACK
	SNA CLA			/SKIP IF ERRORS
	JMP	QFRMOK		/JUMP IF OK
	JMS I	(COMPLAIN)	/GRIPE ABOUT
	FRMMSG			/FORMAT PROBLEM
QFRMOK,	CIF	PR1FLD		/GOTO CODE FIELD
	JMS I	[TRKUPDATE]	/SET UPDATE VALUE
	DAD;	FBLK		/ADD ON LATEST BLOCK
	DST;	FBLK		/STORE NEW VALUE
	JMS I	(CHKN)		/CHECK FOR <^N>, ETC.
	CIF	PR1FLD		/GOTO CODE FIELD
	JMS I	[TRBUMP]	/BUMP DISPLAY TRACK
	ISZ	TRKCNT		/DONE INNER LOOP?
