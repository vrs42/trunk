	TAD	[CDF]		/FORM CDF INSTRUCTION
	DCA	FROMCDF		/STORE IN-LINE
	ISZ	XMOVE		/BUMP TO NEXT
	TAD I	XMOVE		/GET "TO" ARGUMENT
	DCA	TEMP		/STASH IT
	ISZ	XMOVE		/BUMP PAST
	TAD I	TEMP		/GET "TO" ADDRESS
	DCA	SETFLD		/STASH THE POINTER
