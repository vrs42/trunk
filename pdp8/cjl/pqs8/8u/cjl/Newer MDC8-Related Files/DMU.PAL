	JMP	WBTEXIT			/JUMP IF FLEXIBLE DISK UNIT
WBTAGN,	CDF	PRGFLD			/GOTO MAIN FIELD
	TAD I	[UNIT]			/GET DRIVE UNIT
	CDF	PR1FLD			/BACK TO OUR FIELD
	TAD	(4^100+WRITE+TBLFLD)	/FORM WRITE FUNCTION
	DCA	WBTFUN			/STORE IN-LINE
