RAND24,	.-.			/24-BIT RANDOM NUMBER GENERATOR
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	R24EXT		/STORE IN-LINE
	TAD I	RAND24		/GET SEED POINTER
	DCA	RANPTLO		/STASH LOW-ORDER POINTER
	NL0001			/SET OFFSET TO HIGH-ORDER
	TAD	RANPTLO		/GET CORRECTED POINTER
	DCA	RANPTHI		/STORE HIGH-ORDER POINTER
	CDF	PR2FLD		/GOTO OUR FIELD
	NL0001			/SETUP INITIAL INCREMENT
	MQL			/STORE INITIAL LOW-ORDER
	TAD	(-5)		/SETUP THE
	DCA	RANCNT		/MULTIPLIER COUNT
RANLUP,	CLL			/CLEAR THE LINK
	SWP			/GET LOW-ORDER
	TAD I	RANPTLO		/ADD ON LOW-ORDER
	SWP			/SWAP IT BACK
	SZL			/CARRY?
	IAC			/YES
	TAD I	RANPTHI		/ADD ON HIGH-ORDER
	ISZ	RANCNT		/DONE ENOUGH?
	JMP	RANLUP		/NO, KEEP GOING
	DCA I	RANPTHI		/STORE BACK NEW HIGH-ORDER
	MQA			/GET LOW-ORDER
	DCA I	RANPTLO		/STORE BACK NEW LOW-ORDER
	TAD I	RANPTHI		/RESTORE NEW HIGH-ORDER
	ISZ	RAND24		/BUMP PAST SEED POINTER
R24EXT,	.-.			/WILL BE CIF CDF RETURN FIELD
	JMP I	RAND24		/RETURN

