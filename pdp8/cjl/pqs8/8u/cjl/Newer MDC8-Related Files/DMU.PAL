	SPA			/SKIP IF TOO MUCH
	JMP	OUTOK		/JUMP IF OK
	DCM			/INVERT IT
	DAD;	UPDATE		/SUBTRACT FROM UPDATE FACTOR
	DST;	UPDATE		/STORE NEW UPDATE FACTOR
OUTOK,	CAM			/CLEAN UP
	TAD I	(CNTRLBLK)	/GET LOW-ORDER CONTROL BLOCK
