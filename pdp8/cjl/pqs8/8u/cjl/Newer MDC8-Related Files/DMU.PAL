	TAD	[ERRPRSPECIAL]		/GET NORMAL POINTER
	DCA	TEMP			/STASH IT
	TAD I	COMPLAIN		/GET IN-LINE ARGUMENT
	DCA	CMPLARG			/STORE IN-LINE
	ISZ	COMPLAIN		/BUMP PAST ARGUMENT
	TAD	PRNSW			/GET REPORTING SWITCH
	SNA CLA				/SKIP IF ON
	JMP I	COMPLAIN		/RETURN IF OFF
	CIF	PR1FLD			/GOTO CODE FIELD
	JMS I	TEMP			/MAKE
CMPLARG,.-.				/THEIR COMPLAINT
	JMP I	COMPLAIN		/RETURN

