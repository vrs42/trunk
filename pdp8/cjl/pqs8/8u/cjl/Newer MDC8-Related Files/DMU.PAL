VERTBL,	TAD	(TA00-TA24-1)	/SETUP THE
	DCA	RETRYCT		/DIGIT CHECKING COUNT
	NL7777	/TAD	(TA00-1)/SETUP THE
	DCA	XR1		/BUFFER POINTER
VSERLP,	CDF	TBLFLD		/GOTO TABLE FIELD
	TAD I	XR1		/GET A WORD
	CDF	PR1FLD		/BACK TO OUR FIELD
	JMS I	(VALNUMERIC)	/CHECK IF VALID DIGIT
	JMP I	(RBADXT)	/COMPLAIN IF NOT A DIGIT
	ISZ	RETRYCT		/DONE ALL DIGITS?
	JMP	VSERLP		/NO, KEEP GOING
	NL7775			/SETUP THE
	DCA	RETRYCT		/CHARACTER COUNT
VTIMLP,	CDF	TBLFLD		/GOTO TABLE FIELD
	TAD I	XR1		/GET A TIME ZONE CHARACTER
	CDF	PR1FLD		/BACK TO OUR FIELD
	JMS I	(VALALPHA)	/CHECK IF VALID ALPHABETIC
	JMP I	(RBADXT)	/COMPLAIN IF NOT A DIGIT
	ISZ	RETRYCT		/DONE ALL CHARACTERS?
	JMP	VTIMLP		/NO, KEEP GOING
	JMS I	(GET2);	TA11	/GET MONTH VALUE
	TAD	(-14-1)		/ADD ON LIMIT
	CLL			/CLEAR LINK FOR TEST
	TAD	(14)		/ADD ON RANGE
	SNL CLA			/SKIP IF OK
	JMP I	(RBADXT)	/COMPLAIN IF NOT
	JMS I	(GET2);	TA15	/GET DECADE VALUE
	TAD	(-24)		/COMPARE TO 20XX
	SNA			/SKIP IF OTHER
	JMP	VB2000		/JUMP IF IT MATCHES
	IAC			/COMPARE TO 19XX
	SZA CLA			/SKIP IF IT MATCHES
	JMP I	(RBADXT)	/COMPLAIN IF NOT
	JMS I	(GET2);	TA17	/GET YEAR VALUE
	TAD	(-143-1)	/ADD ON LIMIT
	CLL			/CLEAR LINK FOR TEST
	TAD	(144-120)	/ADD ON RANGE (80-99)
	SNL CLA			/SKIP IF 1980-1999
	JMP I	(RBADXT)	/COMPLAIN IF NOT
	JMP	VBCOMMON	/CONTINUE THERE

VB2000,	JMS I	(GET2);	TA17	/GET YEAR VALUE
	TAD	(-117-1)	/ADD ON LIMIT
	CLL			/CLEAR LINK FOR TEST
	TAD	(120)		/ADD ON RANGE (00-79)
	SNL CLA			/SKIP IF 2000-2079
	JMP I	(RBADXT)	/COMPLAIN IF NOT
VBCOMMO,JMS I	(GET2);	TA17		/GET THE YEAR
	AND	(3)			/JUST LEAP YEAR BITS
	CDF	PR2FLD			/GOTO DATE TABLE FIELD
	SNA CLA				/SKIP IF NOT LEAP YEAR
	ISZ I	(FEBENT)		/ELSE MAKE IT LEAP YEAR
	JMS I	(GET2);	TA11		/GET MONTH VALUE
	TAD	(JANENT-1)		/ADJUST TO PROPER ELEMENT
	DCA	RETRYCT			/STASH THE POINTER
	CDF	PR2FLD			/GOTO DATE TABLE FIELD
	TAD I	RETRYCT			/GET THE VALUE
	CIA				/INVERT FOR TESTING
	DCA	RETRYCT			/SAVE IT FOR LATER
	TAD	(34)			/RESET THE
	DCA I	(FEBENT)		/FEBRUARY ENTRY
	JMS I	(GET2);	TA13		/GET THE DAY VALUE
	SNA				/SKIP IF POSSIBLE
	JMP I	(RBADXT)		/COMPLAIN IF NOT
	TAD	RETRYCT			/ADD ON LIMIT
	SMA SZA CLA			/SKIP IF VALID
	JMP I	(RBADXT)		/COMPLAIN IF NOT
	JMS I	(GET2);	TA21		/GET HOURS VALUE
	TAD	(-30)			/ADD ON LIMIT
	CLL				/CLEAR LINK FOR TEST
	TAD	(30)			/ADD ON RANGE
	SNL CLA				/SKIP IF VALID
	JMP I	(RBADXT)		/COMPLAIN IF NOT
	JMS I	(GET2);	TA23		/GET MINUTES VALUE
	TAD	(-74)			/ADD ON LIMIT
	CLL				/CLEAR LINK FOR TEST
	TAD	(74)			/ADD ON RANGE
	SNL CLA				/SKIP IF OK
	JMP I	(RBADXT)		/COMPLAIN IF NOT
	TAD	(BTBFEND-TENT%2^7777)	/SETUP THE
	DCA	RETRYCT			/ENTRY COUNTER
	JMS I	(FTLIMITS)		/SETUP FLAW LIMITS AGAIN
	JMS I	(FLWBACKUP)		/BACKUP TO FIRST ENTRY
	CAM				/CLEAN UP
	JMP I	(VENLUP)		/CONTINUE THERE
	PAGE
VENLUP,	CDF	TBLFLD		/GOTO TABLE FIELD
	TAD I	XR1		/GET A WORD
	MQL			/PUT IN LOW-ORDER
	TAD I	XR1		/GET HIGH-ORDER
	CDF	PR1FLD		/BACK TO OUR FIELD
	DST;	FLWTMP		/SAVE IT
	ISZ I	(FLWTMP)	/CHECK FOR -1
	SKP			/SKIP IF POSSIBLE
	ISZ I	(FLWTMP+1)	/CHECK HIGH-ORDER
	JMP	NOTM1		/JUMP IF OTHER VALUE
VENTOK,	JMS I	(FLWBACKUP)	/BACKUP ONE TRACK'S WORTH
	CAM			/CLEAN UP
	ISZ	RETRYCT		/DONE ALL ENTRIES?
	JMP	VENLUP		/NO, GO GET ANOTHER ONE
	JMP I	(RGUDXT)	/TAKE GOOD RETURN

NOTM1,	DST;	FLWTM1		/SAVE UN-MODIFIED BLOCK FOR NOW
	CLL RAL			/MOVE UP
	CLL RAR			/CLEAR BIT[0]
	DST;	FLWTM2		/SAVE IT AGAIN
	DAD;	SUPPERLIMIT	/COMPARE TO LARGEST LOGICAL SECTOR
	SPA CLA			/SKIP IF BAD
	JMP	VENTOK		/JUMP IF OK
	DLD;	FLWTM1		/GET IT BACK
	RAL			/MOVE UP
	SMA CLA			/SKIP IF BAD ALTERNATE TRACK ENTRY
	JMP I	(RBADXT)	/COMPLAIN IF NOT
	DLD;	FLWTM2		/GET STRIPPED FORM
	CLL RTL			/MOVE UP
	CLL RTR			/MOVE DOWN WITH BIT[1] OFF
	DCM			/INVERT FOR TESTING
	DAD;	FLWBLK		/COMPARE TO CURRENT VALUE
/	SNA			/SKIP IF ALREADY BAD
	MQA			/ELSE GET LOW-ORDER
	SNA CLA			/SKIP IF IT DOESN'T MATCH
	JMP	VENTOK		/JUMP IF IT DOES
	JMP I	(RBADXT)	/COMPLAIN IF NO MATCH
/	FLAW MAP SEARCH ROUTINE.

SEFLAW,	.-.				/SEARCH FLAW MAP ROUTINE
	JMS	SETFLD			/SETUP RETURN FIELD
	DCA	SEFXIT			/STORE IN-LINE
	CDF	PR1FLD			/GOTO OUR FIELD
	JMS I	(FTLIMITS)		/SETUP TABLE LIMITS
	JMS I	(FLWBACKUP)		/BACKUP TO HIGHEST ALTERNATE
	CAM				/CLEAN UP
	TAD	(BTBFEND-TENT%2^7777)	/SETUP THE
	DCA	RETRYCT			/SEARCH COUNT
	TAD	(TENT-1)		/SETUP THE
	DCA	XR1			/SEARCH POINTER
SEFLUP,	CDF	PRGFLD			/GOTO MAIN FIELD
	TAD I	[FBLK]			/GET LOW-ORDER
	CIA				/INVERT FOR TESTING
	CDF	TBLFLD			/GOTO TABLE FIELD
	TAD I	XR1			/COMPARE TO TABLE ELEMENT
	SZA CLA				/SKIP IF IT MATCHES
	JMP	SE1DIFFER		/JUMP IF NOT
	TAD I	XR1			/GET NEXT TABLE ELEMENT
	CIA				/INVERT FOR TESTING
	CDF	PRGFLD			/GOTO MAIN FIELD
	TAD I	[FBLK+1]		/COMPARE TO HIGH-ORDER
	AND I	(SMASK)			/REMOVE UNWANTED BITS
	SZA CLA				/SKIP IF IT MATCHES
	JMP	SE2DIFFER		/JUMP IF NOT
	NL7776				/SET BACKUP FACTOR
	TAD	XR1			/NOW POINTING AT ENTRY
	DCA I	[XR1]			/SETUP THEIR VALUE
	ISZ	SEFLAW			/BUMP TO GOOD RETURN
SEFXIT,	.-.				/WILL BE CIF CDF RETURN FIELD
	JMP I	SEFLAW			/RETURN TO CALLER

SE1DIFF,ISZ	XR1			/BUMP TO NEXT ELEMENT
SE2DIFF,CDF	PR1FLD			/BACK TO OUR FIELD
	JMS I	(FLWBACKUP)		/BACKUP TO NEXT ENTRY
	CAM				/CLEAN UP
	ISZ	RETRYCT			/DONE ALL?
	JMP	SEFLUP			/NO, KEEP GOING
	JMP	SEFXIT			/YES, TAKE BAD RETURN ON SEARCH FAILURE
/	TEST READYING SEQUENCE ROUTINE.

LETSGO,	.-.			/LETS GET GOING ROUTINE FOR SOME TESTS
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	LETSEXIT	/STORE IN-LINE
	CDF	PR1FLD		/GOTO OUR FIELD
	JMS I	(GTREADY)	/GET THE SELECTED UNIT READY
	RCMMSG			/FLEXIBLE DISK MESSAGE
	NL7777			/INDICATE CHANGE OF ERROR MESSAGE
	JMS I	(DATASTATUS)	/GET DRIVE STATUS
	JMS I	(RUSURE)	/GET RESPONSE TO MESSAGE
	PTDMSG			/FOR PERMISSION TO TEST DISK
	SKP			/NO, TAKE IMMEDIATE RETURN
	ISZ	LETSGO		/YES, TAKE SKIP RETURN
LETSEXI,.-.			/WILL BE CIF CDF RETURN FIELD
	JMP I	LETSGO		/RETURN TO CALLER EITHER WAY

