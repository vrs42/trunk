/	DISK SIZING ROUTINE.

DSKSIZE,.-.			/DISK SIZE ROUTINE
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	DSKSXIT		/STORE IN-LINE
	CDF	PRGFLD		/GOTO MAIN FIELD
	NL0002			/SETUP UNIT MASK
	AND I	[UNIT]		/GET THE BIT
	CDF	PR1FLD		/GOTO DATA FIELD
	SNA CLA			/SKIP IF FLEXIBLE DISK
	JMP	WDSKSIZE	/JUMP IF WINCHESTER DISK
	TAD I	(FDCNT)		/GET SECTORS/TRACK
	CIA			/INVERT FOR COUNTING
	DCA	DSKCNT		/STORE THE COUNTER
	CAM			/CLEAN UP
	DAD;	FTRCNT		/GET TRACK COUNT
	ISZ	DSKCNT		/DONE IT ENOUGH?
	JMP	.-3		/NO, KEEP GOING
	CDF	PR2FLD		/GOTO OUR FIELD
	DST;	DSKTMP		/STORE FOR NOW
	CDF	PRGFLD		/GOTO MAIN FIELD
	NL0001			/SETUP SIDE MASK
	AND I	[FLPFRM]	/GET THE BIT
	SNA CLA			/SKIP IF DOUBLE-SIDED DISK
	JMP	DSK1SIDE	/JUMP IF SINGLE-SIDED DISK
	CDF	PR2FLD		/GOTO OUR FIELD
	DLD;	DSKTMP		/GET THE SECTORS/SIDE VALUE
	DAD;	DSKTMP		/DOUBLE IT FOR TWO SIDES
	DST;	DSKTMP		/STORE FOR NOW
	CDF	PRGFLD		/BACK TO MAIN FIELD AGAIN
DSK1SID,CAM			/CLEAN UP
	NL7776			/SETUP FORMAT DEFINITION MASK
	AND I	[FLPFRM]	/GET FORMAT DEFINITION
	CDF	PR2FLD		/GOTO OUR FIELD
	SNA			/SKIP IF OTHER THAN 128 BYTE FORMAT
	JMP	DSK128		/JUMP IF 128 BYTE MODE
	TAD	(-6+0)		/COMPARE TO SPECIAL VALUE
	SNA			/SKIP IF OTHER
	JMP	DSKSPECIAL	/JUMP IF SPECIAL MODE
	TAD	[-206+6]	/COMPARE TO 256 BYTE MODE
	SNA			/SKIP IF OTHER
	JMP	DSK256		/JUMP IF 256 BYTE MODE
	TAD	(-212+206)	/COMPARE TO 512 BYTE MODE
	SNA			/SKIP IF OTHER
	JMP	DSK512		/JUMP IF 512 BYTE MODE
	TAD	(-216+212)	/COMPARE TO 1024 BYTE MODE
	SNA			/SKIP IF OTHER
	JMP	DS1024		/JUMP IF 1024 BYTE MODE
	HLT			/BARF ON IMPOSSIBLE VALUE
DSK128,	DLD;	DSKTMP		/GET SECTOR COUNT
	CLL RAR			/%2
	SWP			/GET LOW-ORDER
	RAR			/MOVE THE BITS DOWN
	SWP			/RESTORE EVERYONE
DSKCOMM,DCM			/INVERT FOR LIMITING
DSKSXIT,.-.			/WILL BE CIF CDF RETURN FIELD
	JMP I	DSKSIZE		/RETURN TO CALLER

DS1024,	DLD;	DSKTMP		/GET SECTOR COUNT
	DAD;	DSKTMP		/DOUBLE IT
DSK512,	DAD;	DSKTMP		/GET SECTOR COUNT
	SKP			/DOUBLE IT
DSK256,	CAM			/CLEAN UP
DSKSPMO,DAD;	DSKTMP		/GET SECTOR COUNT
	JMP	DSKCOMMON	/CONTINUE THERE

DSKSPEC,DLD;	M15		/SUBTRACT SMALL SECTOR OFFSET
	JMP	DSKSPMORE	/CONTINUE THERE

WDSKSIZ,TAD I	(WDCNT)		/GET SECTORS/TRACK
	CIA			/INVERT FOR COUNTING
	DCA	DSKCNT		/STORE THE COUNTER
	CAM			/CLEAN UP
	DAD;	WTRCNT		/GET TRACK COUNT
	ISZ	DSKCNT		/DONE IT ENOUGH?
	JMP	.-3		/NO, KEEP GOING
	CDF	PR2FLD		/GOTO OUR FIELD
	DST;	DSKTMP		/STORE FOR NOW
	CAM			/CLEAN UP
	CDF	PR1FLD		/GOTO THEIR FIELD
	TAD I	(WINSIZE)	/GET CURRENT WINCHESTER SIZE
	CDF	PR2FLD		/GOTO OUR FIELD
	TAD	(-100)		/COMPARE TO 128 BYTE MODE
	SNA			/SKIP IF OTHER
	JMP	DSK128		/JUMP IF128 BYTE MODE
	TAD	(-200+100)	/COMPARE TO 256 BYTE MODE
	SNA			/SKIP IF OTHER
	JMP	DSK256		/JUMP IF 256 BYTE MODE
	TAD	[-400+200]	/COMPARE TO 512 BYTE MODE
	SNA			/SKIP IF OTHER
	JMP	DSK512		/JUMP IF 512 BYTE MODE
	TAD	[-1000+400]	/COMPARE TO 1024 BYTE MODE
	SNA			/SKIP IF OTHER
	JMP	DS1024		/JUMP IF 1024 BYTE MODE
	HLT			/BARF IF IMPOSSIBLE VALUE
DSKCNT,	.-.			/COUNTER
