/	NON-OVERLAPPED EXERCISER ROUTINE.

NOVERLA,CIF	PR2FLD		/GOTO CODE FIELD
	JMS I	(RAND6);UNSEED	/GET A RANDOM UNIT
	AND	(3)		/JUST UNIT BITS
	DCA	UNIT		/STORE THE UNIT
	TAD	UNIT		/GET IT BACK
	CMA			/INVERT FOR COUNTING
	DCA	TEMP		/STORE THE COUNTER
	CLA STL			/INITIALIZE THE BIT
	RAL			/MOVE UP
	ISZ	TEMP		/MORE?
	JMP	.-2		/YES, KEEP GOING
	AND	EXWORD		/AND AGAINST ACTIVE UNIT WORD
	SNA CLA			/SKIP IF IT MATCHES AN ACTIVE UNIT
	JMP	NOVERLAP	/ELSE GO GET ANOTHER UNIT
	CIF	PR1FLD		/GOTO CODE FIELD
	JMS I	[BFCALCULATE]	/CALCULATE BLOCK NUMBER AND FUNCTION
	CIF	PR1FLD		/GOTO CODE FIELD
	JMS I	(EXRWCHK)	/GO DO WRITE AND READ TEST
	JMP I	(COMEXEXIT)	/CONTINUE THERE

/	SYSTEM EXERCISER ROUTINE.

NXTDRV,	ISZ	EXFOO		/BUMP TO NEXT
	NL0003			/SET THE MASK
	AND	EXFOO		/GET THE BITS
	DCA	UNIT		/SAVE AS NEXT UNIT
	TAD	UNIT		/GET IT BACK
	TAD	(UNTABLE)	/POINT TO PARTICULAR JOB WORD
	DCA	JOBPTR		/STASH THE POINTER
	TAD I	JOBPTR		/GET THE VALUE
	TAD	(JMP I	STABLE)	/POINT TO PROPER ADDRESS
	DCA	.+1		/STORE IN-LINE
	.-.			/EXECUTE TABLE JUMP
/	DRIVE SHOULD BE MADE TO SEEK NOW.

STRTDRV,CIF	PR1FLD		/GOTO CODE FIELD
