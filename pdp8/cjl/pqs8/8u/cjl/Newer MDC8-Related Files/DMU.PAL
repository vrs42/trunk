	ISZ	TRKCNHI		/DONE OUTER LOOP?
	JMP	QFRMLP		/NO, KEEP GOING
	CIF	PR1FLD		/GOTO CODE FIELD
	JMS I	[WBTTBL]	/WRITE OUT FLAW TABLE
	JMS I	(ANNMSG)	/TELL THEM
	QFDMSG			/WE FINISHED FORMATTING THE DRIVE
	JMS	QUARESET	/RESET ABORT POINTERS
QUABENT,DCA I	FRSTPTR		/CLEAR FIRST TIME SWITCH FOR THIS DRIVE
	JMS I	(CHKN)		/CHECK FOR <^N>, ETC.
	JMS I	(SCYCLE)	/CHECK FOR TEST RECYCLE
	JMP	QFTLUP		/GO DO IT AGAIN
QFTEND,	ISZ	FRSTPTR		/BUMP TO NEXT DRIVE
	ISZ	QTSTCT		/DONE ALL YET?
	JMP	QFTLUP		/NO, KEEP GOING
	JMP I	(QRTEST)	/YES, ON TO NEXT TEST
