/	DISK COPY ANNOUNCEMENT ROUTINE.

DSCANN,	.-.			/ANNOUNCEMENT ROUTINE
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	DSCAXT		/STORE IN-LINE
	CDF	PR2FLD		/GOTO OUR FIELD
	TAD	VOSW		/GET VERIFY-ONLY SWITCH
	SZA CLA			/SKIP IF NORMAL MODE
	JMP	DCMANN		/JUMP IF VERIFY-ONLY MODE
	JMS	CPIANN		/ANNOUNCE INPUT
SPCPOK,	JMS	CPOANN		/ANNOUNCE OUTPUT
DCOMOK,	CIF	PR1FLD		/GOTO CODE FIELD
	JMS I	[RUSURE]	/ASK IF THEY ARE SURE
	PTCMSG			/WITH THIS MESSAGE
	JMP	DSCAXT		/FORGET IT
	JMS I	[MESAG2]	/TELL THEM
	CIPMSG			/COPY HAS STARTED
COMPCOM,ISZ	DSCANN		/BUMP TO GOOD RETURN
DSCAXT,	.-.			/WILL BE CIF CDF RETURN FIELD
	JMP I	DSCANN		/RETURN TO CALLER

DCMANN,	JMS	CMIANN		/ANNOUNCE FIRST COMPARISON
SPCMANN,JMS	CMOANN		/ANNOUNCE SECOND COMPARISON
	CIF	PR1FLD		/GOTO CODE FIELD
	JMS I	[RUSURE]	/ASK IF THEY ARE SURE
	PTMMSG			/WITH THIS MESSAGE
	JMP	DSCAXT		/FORGET IT
	JMS I	[MESAG2]	/TELL THEM
	CMPMSG			/COMPARE HAS STARTED
	JMP	COMPCOMMON	/CONTINUE THERE
SPCANN,	.-.			/SPECIAL ANNOUNCEMENT ROUTINE
	DCA	TEMP2		/SAVE PASSED VALUE
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	DSCAXT		/STORE IN-LINE
	TAD	SPCANN		/GET OUR CALLER
	DCA	DSCANN		/MAKE IT THEIRS
	CDF	PR2FLD		/GOTO OUR FIELD
	TAD	VOSW		/GET VERIFY-ONLY SWITCH
	SZA CLA			/SKIP IF NORMAL COPY
	JMP	SPCMANN		/JUMP IF VERIFY-ONLY MODE
	ISZ	TEMP2		/WHICH PHASE?
	JMP	SPCPOK		/SECONDARY ONE
	JMS	CPIANN		/ANNOUNCE INPUT
	JMS I	[MESAG2]	/TELL THEM
	DCOMSG			/WHERE IT GOES
	TAD	OUTUNIT		/GET OUTPUT UNIT
	JMS	DSUNIT		/PRINT IT
DCOMOUN,CIF	PR1FLD		/GOTO CODE FIELD
	JMS I	[GTREADY]	/GET THE DRIVE READY
	HLT			/NOT A FLEXIBLE DISK!
	CIF	PR1FLD		/GOTO CODE FIELD
	JMS I	[DATASTATUS]	/GET DATA STATUS
	SMA CLA			/SKIP IF BAD
	JMP	DCOMOK		/JUMP IF OK
	CIF	PR1FLD		/GOTO CODE FIELD
	JMS I	[ERRPRSPECIAL]	/TELL THEM
	DATMSG			/THEY GOT PROBLEMS
	CIF	PR1FLD		/GOTO CODE FIELD
	JMS I	[ASKRETRY]	/ASK FOR A RETRY
	JMP	DCOMOUNT	/TRY AGAIN
	JMP I	(FAIL1)		/FORGET IT

CPIANN,	.-.			/COPY INPUT ANNOUNCEMENT ROUTINE
	JMS I	[MESAG2]	/TELL THEM
	INDMSG			/INPUT MESSAGE
	TAD	INUNIT		/GET INPUT UNIT
	JMS	DSUNIT		/PRINT IT
	CIF	PR1FLD		/GOTO CODE FIELD
	JMS I	[GTREADY]	/GET THE DRIVE READY
	INUMSG			/FLEXIBLE DISK MESSAGE
	JMP I	CPIANN		/RETURN
CPOANN,	.-.			/COPY OUTPUT ANNOUNCEMENT ROUTINE
	JMS I	[MESAG2]	/TELL THEM
	OTDMSG			/OUTPUT MESSAGE
	TAD	OUTUNIT		/GET OUTPUT UNIT
	JMS	DSUNIT		/PRINT IT
DSOMOUN,CIF	PR1FLD		/GOTO CODE FIELD
	JMS I	[GTREADY]	/GET DRIVE READY
	OTUMSG			/FLEXIBLE DISK MESSAGE
	NL7777			/INDICATE MESSAGE CHANGE
	CIF	PR1FLD		/GOTO CODE FIELD
	JMS I	[DATASTATUS]	/GET DATA STATUS
	SMA CLA			/SKIP IF BAD
	JMP I	CPOANN		/RETURN IF OK
	CIF	PR1FLD		/GOTO CODE FIELD
	JMS I	[ERRPRSPECIAL]	/GO COMPLAIN
	DATMSG			/WITH THIS MESSAGE
	CIF	PR1FLD		/GOTO CODE FIELD
	JMS I	[ASKRETRY]	/ASK FOR A RETRY
	JMP	DSOMOUNT	/TRY AGAIN
	JMS I	(TRYFORMAT)	/TRY TO FORMAT THE DISK
	JMP	DSOMOUNT	/TRY AGAIN

CMIANN,	.-.			/COMPARE FIRST INPUT ANNOUNCEMENT ROUTINE
	JMS I	[MESAG2]	/TELL THEM
	INCMSG			/ABOUT INPUT UNIT
	TAD	INUNIT		/GET INPUT UNIT
	JMS	DSUNIT		/PRINT IT
