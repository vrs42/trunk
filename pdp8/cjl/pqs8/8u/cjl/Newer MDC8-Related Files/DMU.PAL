/	FLAW MAP WRITE AND VERIFY ROUTINE.

WBTTBL,	.-.				/FLAW MAP WRITE ROUTINE
	JMS	SETFLD			/SETUP RETURN FIELD
	DCA	WBTEXIT			/STORE IN-LINE
	CDF	PRGFLD			/GOTO MAIN FIELD
	TAD I	[TVSW]			/GET VALIDITY SWITCH
	SZA CLA				/SKIP IF OK
