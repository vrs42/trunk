	DAD;	UPDATE		/SUBTRACT FROM UPDATE FACTOR
	DST;	UPDATE		/STORE NEW UPDATE FACTOR
INOK,	CAM			/CLEAN UP
	TAD	BRSW		/GET BACKUP/RESTORE SWITCH
