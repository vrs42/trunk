R18ARG,	.-.			/SEED POINTER
	RAR			/MOVE OVER HIGH-ORDER
	SWP			/GET LOW-ORDER
	RAR			/MOVE DOWN
	SWP			/SWAP BACK
	RAR			/MOVE OVER HIGH-ORDER
	SWP			/GET LOW-ORDER
	RAR			/MOVE DOWN
	SWP			/SWAP BACK
	AND	(77)		/REMOVE JUNK BITS
	ISZ	RAND18		/BUMP PAST SEED POINTER
R18EXT,	.-.			/WILL BE CIF CDF RETURN FIELD
	JMP I	RAND18		/RETURN
RAND12,	.-.			/12-BIT RANDOM NUMBER GENERATOR
