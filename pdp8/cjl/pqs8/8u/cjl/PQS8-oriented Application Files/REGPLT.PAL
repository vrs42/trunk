/ROUTINE TO SUBTRACT X*COS FROM THE CENTER

XSUB,	CLA			/CLEAR THE AC
	TAD I	(ACOS)		/GET A*COS
	CMA IAC			/GET THE 2'S COMPLEMENT
	TAD I	(XCENT)		/ADD THE X CENTER VALUE
	JMP I	(XSAV)		/RETURN

/ROUTINE TO SUBTRACT B*SIN FROM THE CENTER

YSUB,	CLA			/CLEAR THE AC
	TAD I	(BSIN)		/GET B*SIN
	CMA IAC			/GET THE 2"S COMPLEMENT
	TAD I	(YCENT)		/ADD THE Y CENTER VALUE
	JMP I	(YSAV)		/RETURN


/ROUTINE TO DEAL WITH A BLANK

BLANK,	IAC			/INCREMENT AC
	SZA			/IS THE AC = 0?
	JMP	CRLFCK		/N0->CHECK FOR CR AND/OR LF
	JMS I	(UPCRNRS)	/UPDATE THE RIGHT CORNERS
	JMP I	(NXTCHAR)	/GET THE NEXT CHARACTER
CRLFCK,	TAD	(23)		/ADD 23 TO AC
	SZA			/IS THE AC = 0?
	JMP I	(LINFED)	/NO->DO A LF
	JMP I	(CARRET)	/YESY->DO A CR

/ROUTINE TO DO A CARRIAGE RETURN

CARRET,	CLA			/CLEAR AC
	TAD 	XFONTSTR	/GET ORIGINAL X STARTING PLACE
	DCA 	XLFCRNR		/SET X LEFT CORNER TO IT
	JMP I	(NXTCHAR)	/GET THE NEXT CHARACTER

/ROUTINE TO DO A LINE FEED

LINFED,	TAD	(3)		/ADD 3 TO <AC>
	SZA			/IF <AC> IS NOT 0
	JMP	CHKHT		/THEN CHECK FOR HTAB
	TAD I	(CRSPAC)	/GET THE Y SPACING VARIABLE
	CIA			/MAKE IT NEGATIVE
	TAD 	YLFCRNR		/ADD THE PREVIOUS Y POSITION
	DCA 	YLFCRNR		/SET THE Y LEFT CORNER TO IT
	JMP I	(NXTCHAR)	/GET THE NEXT CHARACTER
/CHECK IF THE CHARACTER IS HTAB

CHKHT,	IAC			/INCREMENT <AC>
	SZA			/IF <AC> IS NOT ZERO
	JMP	CHKBS		/THEN CHECK FOR BACKSPACE
	TAD 	XSPACE		/GET X SPACEING VALUE
	TAD 	XLFCRNR		/ADD X LEFT CORNER
	DCA 	XLFCRNR		/STORE AS NEW X LEFT CORNER
	TAD 	YSPACE		/GET Y SPACEING VALUE
	TAD 	YLFCRNR		/ADD Y LEFT CORNER
	DCA 	YLFCRNR		/STORE AS NEW Y LEFT CORNER
	JMP I	(NXTCHAR)	/JUMP TO GET THE NEXT CHARACTER
CHKBS,	IAC			/INCREMENT <AC>
	SZA			/IF <AC> IS NOT ZERO
	JMP I	(NXTCHAR)	/THEN DO NOTHING
	TAD 	XLFTAD		/GET X ADDING VARAIBLE
	CIA			/MAKE IT MINUS
	TAD 	XLFCRNR		/ADD X LEFT CORNER VALUE
	DCA 	XLFCRNR		/RESTORE IT
	JMP I	(NXTCHAR)	/RETURN TO GET NEXT CHARACTER


/ROUTINE TO ROUND THE REMAINDER OF A DIVISION BY 6
/THE REMAINDER IS IN THE <AC>
/THE QUOTIENT IS IN THE <MQ>
/THE ROUNDED QUOTIENT WILL BE IN THE <MQ> WITH A 0 IN THE <AC>

ROUND,	.-.				/SUBROUTINE HEADER
	TAD	(-3)		/ADD A MINUS 3 TO THE AC
	SPA			/IF THE <AC> IS 0
	JMP	ENDRND		/THEN LEAVE
	SWP			/ELSE GET THE QUOTIENT
	IAC			/INCREMENT IT BY 1
	SWP			/PUT IT BACK INTO THE <MQ>
ENDRND,	CLA			/CLEAR THE <AC>
	JMP I	ROUND		/RETURN

