	RAR			/DIVIDE BY 2
	SZL			/IF LINK IS ONE
	IAC			/THEN INCREMENT <AC>
	DCA I	(YOFFS)		/STORE AS Y OFFSET
	CLL			/CLEAR <LINK>
	TAD I	(FONTWID)	/GET THE FONT WIDTH
