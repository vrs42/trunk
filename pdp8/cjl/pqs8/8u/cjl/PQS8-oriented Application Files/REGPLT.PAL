	IFNZRO	DECMATE <
	CIF 	CDFL1		/CHANGE TO FIELD WHERE EAE IS LOCATED
	>
	MUY			/LOAD IT INTO THE MQ AND
YQUOT,	.-.			/MULTIPLY 
	SWP			/GET THE PRODUCT
	DCA	ADJTM2		/STORE IT IN ANOTHER TEMPORARY
	TAD	ADJTM1		/GET THE VALUE TO BE ADJUSTED
	MQL			/LOAD THE MQ
	IFNZRO	DECMATE <
	CIF 	CDFL1		/CHANGE TO FIELD WHERE EAE IS LOCATED
	>
	MUY			/LOAD IT INTO THE MQ AND
YREMAIN,.-.			/MULTIPLY
	IFNZRO	DECMATE <
	CIF 	CDFL1		/CHANGE TO FIELD WHERE EAE IS LOCATED
	>
	DVI			/AND THEN DIVIDE 
	6			/BY 6
	JMS I	(ROUND)		/ROUND THE REMAINDER
	SWP			/GET THE QUOTIENT
	TAD	ADJTM2		/ADD THE CONTENTS OF THE SECOND TEMPORARY
	DCA I	(ADJTM2)	/AND RESTORE IT
	TAD I	(MINFLG)	/GET THE UNDER FLAG
	SNA CLA			/IS IT 0?
	JMP	YADEND		/YES->PREPARE TO RETURN
	TAD	ADJTM2		/GET THE ADJUSTED Y
	CIA			/MAKE IT NEGATIVE
	JMP I	YADJUS		/RETURN LEAVING THE ANSWER IN THE <AC>
YADEND,	TAD 	ADJTM2		/GET THE ORGINAL ANSWER
	JMP I	YADJUS		/RETURN
ADJTM1,	.-.			/TEMPORARY
ADJTM2,	.-.			/TEMPORARY

