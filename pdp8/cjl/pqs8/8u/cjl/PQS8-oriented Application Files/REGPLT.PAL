/THE FOLLOWING ROUTINE IS CALLED WHEN THERE ARE OPTIONS FOR THE
/T COMMAND TO BE PROCESSED

TOPTNS,	JMS I	(CHUZIN)	/GET THE NEXT CHARACTER OF THE OPTION
	DCA	OPTPAR		/STORE IT AS A OPTION PARAMETER
	TAD	OPTPAR		/GET THE PARAMETER
	JMS I	(PRCHAR)	/PRINT IT

	TAD	OPTPAR		/GET THE OPTIONS PARAMETER
	TAD	(-UASCII)	/SUBTRACT U ASCII CODE
	SNA CLA			/IF OPTPAR = U
	JMP I	(UNTSET)	/THEN JUMP TO SET UNIT CELL SIZES
	TAD	OPTPAR		/ELSE GET OPTION
	TAD	(-LUASCI)	/SUBTRACT LOWERCASE U ASCII
	SNA CLA			/IF OPTPAR = LOWERCASE U
	JMP I	(UNTSET)	/THEN JUMP TO SET UNIT CELL SIZES
	TAD	OPTPAR		/GET THE OPTIONS PARAMETER
	TAD	(-SASCII)	/SSBTRACT S ASCII CODE
	SNA CLA			/IF OPTPAR = S
	JMP I	(CELSIZ)	/THEN JUMP TO SET STANDARD OR DISPLAY CELL SIZES
	TAD	OPTPAR		/ELSE GET OPTION
	TAD	(-LSASCI)	/SSBTRACT LOWERCASE S ASCII
	SNA CLA			/IF OPTPAR = LOWERCASE S
	JMP I	(CELSIZ)	/THEN JUMP TO SET STANDARD OR DISPLAY CELL SIZES
	TAD	OPTPAR		/GET THE OPTIONS PARAMETER
	TAD	(-DASCII)	/SUBTRACT D ASCII CODE
	SNA CLA			/IF OPTPAR = D
	JMP I	(ROTSTR)	/THEN JUMP TO SET STRING ANGLE
	TAD	OPTPAR		/ELSE GET OPTION
	TAD	(-LDASCI)	/SUBTRACT LOWERCASE D ASCII
	SNA CLA			/IF OPTPAR = LOWERCASE D
	JMP I	(ROTSTR)	/THEN JUMP TO SET STRING ANGLE
	JMS I	(CORMIS)	/CORRECT MISTAKE
	JMP	TOPTNS		/TRY AGAIN

/THE FOLLOWING IS CALLED TO ALTER THE STANDARD OR DISPLAY CELL SIZES

CELSIZ,	JMS I	(CHUZIN)	/ GET THE NEXT PARAMETER
	DCA	OPTPAR		/STORE IT
	TAD	OPTPAR		/GET IT BACK
	TAD	(-BEGBRC)	/AND SUBTRACT [ ASCII CODE
	SNA CLA			/IF OPTPAR = [
	JMP I	(DSPSET)	/THEN SET THE DISPLAY CELL SIZE
	TAD	(-COMMAC)	/GET - ASCII CODE FOR COMMA
	DCA I	(REACH1)	/STORE IT AS REANUM'S FIRST END COMMAND
	TAD	(-ENDPAR)	/GET - ASCII CODE FOR )
	DCA I	(REACH2)	/STORE IT AS REANUM'S SECOND END COMMAND
GETSIZ,	CLA			/CLEAR <AC> IN CASE REPEATED
	TAD	OPTPAR		/ELSE GET READY TO JUMP TO REANUM
	DCA I	(REATMP)	/STORE OPTPAR IN REATMP
	DCA I	(REAWRD)	/SET REAWRD TO ZERO
	TAD	(SIZRET)	/GET ADDRESS OF WHERE REANUM WILL RETURN
	DCA I	(REANUM)	/AND STORE IT
	JMP I	(REANUM+5)	/JUMP TO THE FIFTH INSTRUCTION IN REANUM
SIZRET,	DCA	OPTPAR		/STORE NUMBER RETURNED
	TAD	OPTPAR		/GET PARAMETER

	TAD	(-21)		/SUBTRACT 17
	SMA CLA			/IF OPTPAR > 16
	JMP	GETSIZ		/THEN TRY AGAIN
	TAD	(-CR)		/GET - ASCII CODE FOR CARRIAGE RETURN
	DCA I	(REACH1)	/STORE IT AS REANUM'S FIRST END COMMAND
	TAD	(-CR)		/GET - ASCII CODE CARRIAGE RETURN
	DCA I	(REACH2)	/STORE IT AS REANUM'S SECOND END COMMAND
	TAD	OPTPAR		/GET NUMBER AND USE IT AS A POINTER TO THE
				/CORRECT SIZE OPTION IN THE TABLES
	TAD	(XDSPCL)	/ADD THE ADDRESS OF THE X DISPLAY CELL OPTIONS
	DCA	NXTTAB		/STORE IT AS A POINTER TO THE NEXT TABLE TO USE
	TAD I	NXTTAB		/GET THE CONTENTS WHICH NXTTAB POINTS TO
	DCA	DSPWID		/STORE IT AS THE DISPLAY CELL WIDTH
	TAD	OPTPAR		/GET NUMBER AND USE IT AS A POINTER TO THE
				/CORRECT SIZE OPTION IN THE TABLES
	TAD	(YDSPCL)	/ADD THE ADDRESS OF THE Y DISPLAY CELL OPTIONS
	DCA	NXTTAB		/STORE IT AS A POINTER TO THE NEXT TABLE TO USE
	TAD I	NXTTAB		/GET THE CONTENTS WHICH NXTTAB POINTS TO
	DCA	DSPHGT		/STORE IT AS THE DISPLAY CELL HEIGHT
	TAD	OPTPAR		/GET NUMBER AND USE IT AS A POINTER TO THE
				/CORRECT SIZE OPTION IN THE TABLES
	TAD	(XUNTCL)	/ADD THE ADDRESS OF THE X UNIT CELL OPTIONS
	DCA	NXTTAB		/STORE IT AS A POINTER TO THE NEXT TABLE TO USE
	TAD I	NXTTAB		/GET THE CONTENTS WHICH NXTTAB POINTS TO
	DCA I	(FONTWID)	/STORE IT AS THE UNIT(FONT) CELL WIDTH
	TAD	OPTPAR		/GET NUMBER AND USE IT AS A POINTER TO THE
				/CORRECT SIZE OPTION IN THE TABLES
	TAD	(YUNTCL)	/ADD THE ADDRESS OF THE X UNIT(FONT) CELL OPTIONS
	DCA	NXTTAB		/STORE IT AS A POINTER TO THE NEXT TABLE TO USE
	TAD I	NXTTAB		/GET THE CONTENTS WHICH NXTTAB POINTS TO
	DCA I	(FONTLEN)	/STORE IT AS THE UNIT(FONT) CELL HEIGHT
	TAD	OPTPAR		/GET NUMBER AND USE IT AS A POINTER TO THE
				/CORRECT SIZE OPTION IN THE TABLES
	TAD	(CHRPOS)	/ADD THE ADDRESS OF THE X CHARACTER POSITION OPTIONS
	DCA	NXTTAB		/STORE IT AS A POINTER TO THE NEXT TABLE TO USE
	TAD I	NXTTAB		/GET THE CONTENTS WHICH NXTTAB POINTS TO
	DCA 	XSPACE		/STORE IT AS THE X SPACING VARIABLE
	TAD I	(REATMP)	/GET TE LAST CHARACTER FROM REANUM
	TAD	(-COMMAC)	/SUBTRACT COMMA ASCII CODE
	SNA CLA			/IF REATMP = COMMA
	JMP I	(CHRANG)	/THEN JUMP TO GET THE CHARACTER ANGLE
	JMP I	(GTNXCD)	/JUMP TO GET AND PROCESS THE NEXT COMMAND
DSPWID,	.-.			/DISPLAY CELL WIDTH
DSPHGT,	.-.			/DISPLAY CELL HEIGHT
NXTTAB,	.-.			/POINTER TO DISPLAY AND UNIT CELL TABLES
OPTPAR,	.-.			/OPTION PARAMETER
