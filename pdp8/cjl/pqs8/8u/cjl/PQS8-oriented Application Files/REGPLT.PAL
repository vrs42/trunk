	TAD 	XSPACE		/GET X SPACING VARIABLE
	JMS I	(ROTATE)	/JUMP TO ROTATE STRING
	.-.
			/X CENTER = 0
	.-.			/Y CENTER = 0
SINSTR,	.-.			/SINE OF ANGLE OF STRING
COSSTR,	.-.			/COSINE OF ANGLE OF STRING
	DCA 	XLFTAD		/STORE ROTATED X SPACE
	SWP
	DCA 	YLFTAD		/STORE ROTATED Y SPACE
	CLL			/CLEAR <LINK>
