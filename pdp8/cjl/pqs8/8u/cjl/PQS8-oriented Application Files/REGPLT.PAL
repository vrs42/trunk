/BIT MAPPED GRAPHICS PLOTTING SYSTEM

/		LAST EDIT:	3/18/88				SMB

/THIS SYSTEM USES (X,Y) VALUES STORED IN FIELDS 2 AND 3 AND OUTPUTS

/BIT MAPPED GRAPHICS POINTS OF A LOGICAL PAGE ON A DISK

/GIVEN A CHOICE OF A CIRCLE, SQUARE, DIAMOND, OR TRIANGLE, THIS

/SYSTEM ALSO GENERATES SYMBOLS FOR EACH (X,Y) VALUE

/SYSTEM PARAMETER DEFINITIONS
	CDFL0=	0^10		/FIELD WHERE CODE IS
	CDFL1=  1^10		/FIELD WHERECODE CONTINUES
	MESFLD=	1^10		/FIELD WHERE MESSAGES ARE LOCATED
	CHARFLD=4^10		/CHARACTER ASCII CODE FIELD
	XFLD=	2^10		/X COORDINATE DATA FIELD.
	YFLD=	3^10		/Y COORDINATE DATA FIELD.
	ABSPNT=	1100		/NUMBER OF ABSSISSANT POINTS.
	ORDPNT=	3000		/NUMBER OF ORDINATE POINTS.
	ORDWRD=	ORDPNT-1%14+1	/NUMBER OF Y AXIS WORDS.
	ABSOFFS=ABSPNT%2	/X AXIS OFFSET
	ORDOFFS=ORDPNT%2	/Y AXIS OFFSET
	XFLPNCN=14		/LOCATION IN XFLD OF NUMBER OF POINTS
	XPNSTR=	200		/LOCATION OF START OF (X,Y) VALUES
	CHPNSTR=0		/LOCATION IN CHARFLD OF FIRST ASCII CODE
	FLDUTL=2		/NUBER OF FIELDS UTILIZED IN ONE BUFFER
	FDBUF1=5^10		/FIRST FIELD FOR PUTTING POINTS
	FDBUF2=6^10		/SECOND FIELD FOR PUTTING POINTS
	FLDBUF=5^10		/STARTING FIELD FOR PUTTING POINTS
	UNIT=1			/UNIT NUMBER OF DEVICE TO READ/WRITE

	BUFSIZ=4^10		/SIZE OF EACH BUFFER
	PLTBLK=1+ORDWRD%200^ABSPNT%40%FLDUTL	/NUMBER OF JUMPS TO SAVIO
	SYSIO=7640		/LOCATION OF I/O ROUTINES 
	SFILES=7757		/WHERE FILE POINTERS BEGIN
	CR=15			/CARRIAGE RETURN ASCII CODE
	LF=12			/LINE FEED ASCII CODE
	DECMATE=0		/REAL EAE NOT AVAILABLE
	EAE=	1		/REAL EAE NOT AVAILABLE
	IFNDEF	OFF	<OFF=	1>
	IFNDEF	ON	<ON=	0>
	IFNDEF	EAE	<EAE=	0>


/PROCESSOR DEFINITIONS

	NL0000=	CLA		/LOAD A 0 INTO <AC>
	NL0001=	CLA CLL CML RAL	/LOAD A 1 INTO <AC>
	NL0002=	CLA CLL CML RTL	/LOAD A 2 INTO <AC>
	NL4000=	CLA CLL CML RAR	/LOAD A 4000 INTO <AC>
	NL7776=CLL CLA IAC CMA	/LOAD A 7776 INTO <AC>
	NL7777=CLA CLL CMA	/LOAD A 7777 INTO <AC>

/P?S MONITOR DEFINITIONS

	SWAL=	7604		/SWITCHES /A-/L
	SWMX=	7605		/SWITCHES /M-/X
	SWY9=	7606		/SWITCHES /Y-/9

/PARSER DEFINITIONS

	LTASCI=	164		/LOWERCASE T ASCII CODE
	TASCII=	124		/ASCII CODE FOR T
	LSASCI=	163		/LOWERCASE S ASCII CODE
	SASCII=	123		/ASCII CODE FOR S
	LPASCI=	160		/LOWERCASE P ASCII CODE
	PASCII= 120		/ASCII CODE FOR P
	DASCII=	104		/D ASCII CODE
	LDASCI=	144		/LOWERCASE D ASCII CODE
	UASCII=	125		/U ASCII CODE
	LUASCI=	165		/LOWERCASE U ASCII CODE
	VASCII=	126		/V ASCII CODE
	LVASCI=	166		/LOWERCASE V ASCII
	BACKSP=	10		/BACK SPACE ASCII CODE
	DELETE=	177		/DEL ASCII CODE
	SINQUO=	47		/ASCII CODE FOR SINGLE QUOTE
	DBLQUO=	42		/ASCII CODE FOR DOUBLE QUOTE
	BEGBRC= 133		/ASCII CODE FOR [
	ENDBRC= 135		/ASCII CODE FOR ]
	BEGPAR=	50		/ASCII CODE FOR (
	ENDPAR= 51		/ASCII CODE FOR )
	BLANKC=	40		/ASCII CODE FOR BLANK
	ESCAPE=	33		/ASCII CODE FOR ESC
	PLUSCD= 53		/ASCII CODE FOR +
	MINUSC= 55		/ASCCI CODE FOR -
	COMMAC=	54		/ASCII CODE FOR ,
	SLSHBK=	134		/ASCII CODE FOR \


/AUTO INDEX REGISTERS USED THROUGHOUT THE PROGRAM

	PAGE 0
ZBLOCK	10-.
XR1,	.-.			/1ST AUTO INDEX REG
XR2,	.-.			/2ND AUTO INDEX REG
XR3,	.-.			/AUTO INDEX REG 3
XR4,	.-.			/AUTO INDEX REG 4
XR5,	.-.			/AUTO INDEX REG 5
XR6,	.-.			/AUTO INDEX REG 6
XR7,	.-.			/AUTO INDEX REG 7
XR10,	.-.			/AUTO INDEX REG 8
CHARADR,.-.			/ADDRESS OF THE CHARACTER IN MEMORY
SINPTR,	.-.			/POINTER TO THE SINE TABLE
COSPTR,	.-.			/POINTER TO THE COSINE TABLE
XPTADD,	.-.			/ADDRESS OF X VALUES
YPTADD,	.-.			/ADDRESS OF Y VALUES
XCENT,	.-.			/X ARC CENTER
YCENT,	.-.			/Y ARC CENTER
XLFCRNR,.-.			/X VALUE OF LEFT CORNER OF CHARACTER
YLFCRNR,.-.			/Y VALUE OF LEFT CORNER OF CHARACTER
XRELFL,	.-.			/RELATIVE FLAG FOR FIRST PARAMETER OF GETPAR
YRELFL,	.-.			/RELATIVE FLAG FOR SECOND PARAMETER OF GETPAR
XPARMF,	.-.			/IF 1, INDICATES NO FIRST PARAMETER IN GETPAR
FILEPNT,.-.			/POINTER TO FILES FOR GIVCHAR
YPARMF,	.-.			/IF 1, INDICATES NO SECOND PARAMETER IN GETPAR
XFONTSTR,.-.			/X POSITION WHERE CHARACTER STRING BEGAN
YFONTSTR,.-.			/Y POSITION WHERE CHARACTER STRING BEGAN
				/BOTH X FONTSTR AND Y FONTSTR ARE USED FOR CARRIAGE RETURN
XSPACE,	.-.			/X DISTANCE BETWEEN CHARACTERS
YSPACE,	.-.			/Y DISTANCE BETWEEN CHARACTERS
X1,	.-.			/X ENDPOINT OF VECTOR
Y1,	.-.			/Y ENDPOINT OF VECTOR
X2,	.-.			/2ND X ENDPOINT OF VECTOR
Y2,	.-.			/2ND Y ENDPOINT OF VECTOR
PXTABL,	.-.			/BITS 11-8 OF THE TABLE WORD
PYTABL,	.-.			/BITS 8-6 OF THE TABLE WORD
PXBOLD,	.-.			/BITS 5-3 OF THE TABLE WORD
PYBOLD,	.-.			/BITS 2-0 OF THE TABLE WORD
XLFTAD,	.-.			/VALUE USED TO CALCULATE THE NEXT BEGINNING X VALUE OF THE CHARACTER
YLFTAD,	.-.			/VALUE USED TO CALACULATE THE NEXT BEGINNING Y VALUE OF THE CHARACTER
XPT,	.-.			/NEXT X VALUE TO BE PLOTTED
YPT,	.-.			/NEXT Y VALUE TO BE PLOTTED

	PAGE

	XLIST OFF
	IFZERO EAE <

	SWBA=JMS I (XSWBA)	/SWICH FROM MODE B TO MODE A

	>
	XLIST ON

BEGIN,	CLA			/CLEAR AC
	IFNZRO	DECMATE <
	CIF	CDFL1		/CHANGE TO CODE FIELD 1
	>
	SWBA			/SWITCH FROM MODE B TO A
	JMS I	(SETCNT)	/JUMP TO SET UP COUNTERS AND REGISTERS
	TAD I	(SWMX)		/GET WORD WHERE SWITCH O IS
	AND	(1000)		/AND OFF <O> BIT
	DCA I	(READFL)	/STORE IT AS READ FLAG
	TAD I	(READFL)	/GET THE READ FLAG
	SZA			/IF <O> BIT IS 1
	JMP	OVRCLR		/THEN DO NOT CLEAR PLOTTING DISK
	CDF	MESFLD		/ELSE CHANGE TO MESSAGE FIELD
	TAD	(CLRMES)	/GET ADDRESS OF CLEARING MESSAGE
	CDF	CDFL0		/CHANGE BACK TO CODING FIELD
	DCA I	(MESTMP)	/STORE THE ADDRESS
	JMS I	(MESPRN)	/PRINT THE MESSAGE
	JMS I	(PRECLR)	/CLEAR THE DISK
OVRCLR,	CLA CLL			/CLEAR THE AC AND LINK
	JMS	CHKINP		/JUMP TO CHECK IF THE INPUT WILL BE FROM THE
				/KEYBOARD OR FILES ON DISK

/NOW LETS CHECK THE SWITCHES TO SEE WHAT WE WANT TO GENERATE


	TAD I	(SWMX)		/GET THE S SWITCH
	AND	(40)		/AND OFF THE S BIT
	SZA			/IS THE BIT A 0?
	JMS I	(SYMINP)	/NO->WE WANT TO GENERATE SYMBOLS
	TAD I	(SWMX)		/YES->GET THE R SWITCH
	AND	(100)		/AND OFF THE R BIT
	SZA			/IS THE BIT A 0?
	JMP I	(REGINP)	/NO->WE WANT TO USE REGIS COMMANDS
	JMP	JOBERR		/YES->NO INPUT HAS BEEN GIVEN => ERROR
	JMP I	(7600)		/BOOTSTRAP


/THE FOLLOWING ROUTINE IS USED TO CHECK WHAT TYPE OF INPUT DEVICE WILL BE
/USED IN ORDER TO CONTROL THE GRAPHICS PROGRAM- KEYBOARD OR DISK FILE

CHKINP,	.-.			/HEADER

	DCA	INPFLG		/SET INPUT FLAG TO ZERO
	TAD I	(SWAL)		/GET K SWITCH
	AND	(2)		/AND OFF K BIT
	SZA			/IS THE BIT A 0?
	JMP I	CHKINP		/NO->FLAG IS SET, RETURN
	TAD I	(SWAL)		/GET F SWITCH
	AND	(100)		/AND OFF F BIT
	SNA			/IS THE BIT A 1?
	JMP I	(INPERR)	/NO->NO CONTROL DEVICE HAS BEEN CHOSEN->ERROR
	DCA	INPFLG		/YES->SET INPUT FLAG
	TAD	(SFILES-1)	/GET ADDRESS OF FILES
	DCA 	FILEPNT		/STORE AS A POINTER
	JMP I	CHKINP		/RETURN
INPFLG,	.-.			/FLAG USED TO TELL WHAT THE INPUT DEVICE WILL
				/BE. '0' DENOTES KEYBOARD, '1' DENOTES DISK FILE

/ROUTINE WHICH IS CALLED WHEN NO INPUT DEVICE HAS BEEN SPECIFIED

INPERR,	CDF	MESFLD		/CHANGE TO THE MESSAGE FIELD
	TAD	(NOINER)	/GET ADDRESS OF NO INPUT DEVICE ERROR MESSAGE
	CDF	CDFL0		/CHANGE BACK TO THE CODING FIELD
	DCA I	(MESTMP)	/STORE IT IN THE MESSAGE PRINTING TEMP
	JMS I	(MESPRN)	/JUMP TO PRINT THE MESSAGE
	JMP I	(7600)		/BOOTSTRAP

/ROUTINE WHICH IS CALLED WHEN NO JOB HAS BEEN SPECIFIED

JOBERR,	CLA			/CLEAR AC

	CDF	MESFLD		/CHANGE TO MESSAGE FIELD
	TAD	(NOJBER)	/GET ADDRESS OF NO JOB ERROR MESSAGE
	CDF	CDFL0		/CHANGE BACK TO FIELD WHERE CODE IS
	DCA I	(MESTMP)	/STORE IT IN MESSAGE PRINTING TEMP
	JMS I	(MESPRN)	/JUMP TO PRINT THE MESSAGE
	JMP I	(7600)		/BOOTSTRAP

/THE FOLLOWING ROUTINE IS CALLED WHEN A SYMBOL NUMBER GREATER THAN 5
/WAS CHOSEN

CHOERR,	CLA			/CLEAR AC
	CDF	MESFLD		/CHANGE TO MESSAGE FIELD
	TAD	(BADCHO)	/GET ADDRESS OF BAD CHOICE ERROR
	CDF	CDFL0		/CHANGE BACK TO CODING FIELD
	DCA I	(MESTMP)	/STORE IT IN MESSAGE PRINTING TEMP
	JMS I	(MESPRN)	/JUMP TO PRINT THE MESSAGE
	JMP I	(7600)		/BOOTSTRAP

/SPECIFICALLY, THIS ROUTINE DETERMINES IF THE INPUT WILL COME FROM THE
/KEYBOARD OR A DISK FILE.

CHUZIN,	.-.			/HEADER
	CLA			/MAKE SURE AC IS CLEAR
	RDF			/READ THE DATA FIELD
	TAD	(CDF CIF)	/ADD 6203
	DCA	CHUZRET		/SAVE FOR RETURN
	CDF	CDFL0		/CHANGE TO CODE FIELD 0
	TAD I	(INPFLG)	/GET THE INPUT FLAG
	SZA			/IS THE FLAG 0?
	JMP	CALGIV		/NO->GET THE NEXT CHARACTER FROM A FILE
	JMS I	(KB)		/YES->GET THE NEXT CHARACTER FROM THE KEYBOARD
	JMP	CHUZRET		/JUMP TO RETURN
CALGIV,	CLA			/CLEAR THE AC
	JMS I	(GIVCHAR)	/GET THE NEXT CHARACTER FROM FILE
CHUZRET,.-.			/RETURN TO CALLING INSTRUCTIONA ND DATA FEILD
	JMP I	CHUZIN		/RETURN
/THE FOLLOWING ROUTINE IS CALLED WHEN THE NEXT COMMAND IS REQUESTED

GETCMD,	.-.			/HEADER
	CLA			/CLEAR AC
GETLUP,	JMS I	(CHUZIN)	/GET THE COMMAND
	DCA I	(CMDTMP)	/STORE IT
	TAD I	(CMDTMP)	/GET THE COMMAND
	JMS I	(PRCHAR)	/PRINT THE CHARACTER
	TAD I	(CMDTMP)	/GET THE COMMAND
	TAD	(-40)		/ADD - SPACE
	SNA CLA			/IF IT IS ZERO
	JMP	GETLUP		/THEN IGNORE IT AND GET THE NEXT COMMAND
	TAD I	(CMDTMP)	/GET THE COMMAND
	TAD	(-CR)		/AND SUBTRACT CR
	SNA CLA			/IF IT IS A CR
	JMP	GETLUP		/THEN IGNORE IT
	TAD I	(CMDTMP)	/ELSE GET THE COMMAND AGAIN
	TAD	(-LF)		/AND SUBTRACT LF
	SNA CLA			/IF THE COMMAND IS A LF
	JMP	GETLUP		/THEN IGNORE IT
	JMP I	GETCMD		/ELSE WE HAVE FOUND THE NEXT COMMAND
	PAGE

/THE FOLLOWING ROUTINE IF CALLED WHEN ESC IS THE NEXT COMMAND

REGFIN,	TAD	(ESCAPE)	/GET ESCAPE ASCII CODE
	JMS I	(PRCHAR)	/PRINT IT
	TAD I	(CMDTMP)	/GET THE LAST COMMAND
	TAD	(-SLSHBK)	/ADD - ASCII CODE FOR BACKSLASH (\)
	SNA CLA			/IF ZERO
	JMP	LEVREG		/THEN LEAVE REGIS
	JMP I	(NOCMD)		/ELSE ERROR
	TAD	(SLSHBK)	/GET / ASCII CODE
	JMS I	(PRCHAR)	/PRINT IT
LEVREG,	JMS I	(DSKPLT)	/JUMP TO PLOT ANY POINTS GENERATED IN REGIS
	JMP I	(7600)		/BOOSTRAP

/THE FOLLOWING ROUTINE IS CALLED WHEN THE USER HAS CHOSEN SYMBOLS TO BE
/GENERATED

SYMINP,	.-.			/HEADER
	CLA			/CLEAR AC
	CDF	MESFLD		/CHANGE TO MESSAGE FIELD
	TAD	(SYMMES)	/GET ADDRESS OF SYMBOL MESSAGE
	CDF	CDFL0		/CHANGE BACK TO THE CODING FIELD
	DCA I	(MESTMP)	/STORE IT MESSAGE TEMPORARY
	JMS I	(MESPRN)	/JUMP TO PRINT THE MESSAGE IN SYMMES
	JMS I	(REANUM)	/JUMP TO GET THE SYMBOL NUMBER
	DCA	INPTMP		/STORE THE NUMBER FROM REANUM
	TAD	INPTMP		/GET THE CHOSEN SYMBOL NUMBER
	TAD	(-5)		/ADD -5 TO SEE IF IT IS A LEGAL CHOICE
	SMA CLA			/IF THE NUMBER IS GREATER THAN 5 
	JMP I	(CHOERR)	/THEN JUMP TO THE CHOICE ERROR ROUTINE
	TAD	INPTMP		/ELSE GET THE CHOSEN NUMBER
	DCA I	(SYMBOL)	/AND STORE IT AS THE SYMBOL NUMBER
	CDF	MESFLD		/CHANGE TO THE MESSAGE FIELD
	TAD	(WIDMES)	/GET THE ADDRESS OF THE WIDTH MESSAGE
	CDF	CDFL0		/CHANGE BACK TO CODING FIELD
	DCA I	(MESTMP)	/STORE IT IN THE MESSAGE PRINTING TEMPORARY
	JMS I	(MESPRN)	/JUMP TO PRINT THE MESSAGE IN WIDMES
	JMS I	(REANUM)	/JUMP TO GET THE WIDTH
	DCA I	(FONTWID)	/STORE IT AS THE FONT WIDTH
	CDF	MESFLD			/CHANGE TO MESSAGE FIELD
	TAD	(HGTMES)		/GET THE ADDRESS OF THE HEIGHT MESSAGE
	CDF	CDFL0		/CHANGE BACK TO CODING FIELD
	DCA I	(MESTMP)	/STORE IT IN THE MESSAGE PRINTING TEMPORARY
	JMS I	(MESPRN)	/JUMP TO PRINT THE MESSAGE IN HGTMES
	JMS I	(REANUM)	/JUMP TO GET THE HEIGHT
	DCA I	(FONTLEN)	/STORE IT AS THE FONT HEIGHT
	CDF	MESFLD		/CHANGE TO MESSAGE FIELD
	TAD	(SOLMES)	/ADDRESS OF SOLID MESSAGE
	CDF	CDFL0		/CHANGE BACK TO CODING FIELD
	DCA I	(MESTMP)	/STORE IT IN MESSAGE PRINTING TEMP
	JMS I	(MESPRN)	/JUMP TO PRINT SOLMES
	JMS I	(CHUZIN)	/JUMP TO GET THE ANSWER
	DCA	INPTMP		/STORE THE ANSWER
	TAD	INPTMP		/GET THE ANSWER
	JMS I	(PRCHAR)	/PRINT THE CHARACTER
	TAD	INPTMP		/GET THE ANSWER AGAIN
	TAD I	(NEGY)		/ADD - Y ASCII CODE (7-BIT)
	SZA			/IF THE ANSWER - CODE IS NOT ZERO
	JMP	AROND		/THEN THE SYMBOLS ARE TO BE HALLOW
	TAD 	FONTWID		/ELSE GET THE FONT WIDTH
	CLL			/CLEAR LINK
	RAR			/ROTATE RIGHT -> DIVIDE BY 2
	DCA 	FONTHCK		/AND STORE IT AS THE FONT THICKNESS
AROND,	CLA			/CLEAR AC
	JMS I	(SYMPLOT)	/JUMP TO SYMBOL PLOTTING ROUTINE
	JMS I	(DSKPLT)	/JUMP TO THE DISK PLOTTING ROUTINE
	JMP I	(7600)		/BOOTSTRAP
SYMBOL,	0000			/SYMBOL CODE
FONTWID,14			/FONT WIDTH
FONTLEN,44			/FONT LENGTH
FONTHCK,1			/FONT THICKNESS
CRSPAC,	100			/SPACE BETWEEN EACH LINE OF CHARACTERS
INPTMP,	.-.			/TEMPORARY USED IN THE SYMINP ROUTINE

	PAGE

	XLIST OFF
	IFZERO EAE <

	/EAE SIMULATION

	MUY=JMS I (XMUL)	/EAE MULTIPLY
	DVI=JMS I (XDVI)	/EAE DIVIDE
	>
	XLIST ON


/THE FOLLOWING ROUTINE READS IN A NUMBER AND CONVERTS IT TO BASE 8 AS IT
/IS READ IN

REANUM,	.-.			/HEADER
	CLA			/CLEAR AC
	DCA	REAWRD		/SET TEMPORARY FOR THE NUMBER TO ZERO
	JMS I	(CHUZIN)	/JUMP TO GET THE NEXT NUMBER
	DCA	REATMP		/STORE NEXT NUMBER IN A TEMP
	TAD	REATMP		/ELSE GET THE NUMBER BACK
	TAD	(-"8!200-2)
	CLL			/CLEAR LINK
	TAD	("8+2-"0)	
	SNL
	JMP	RBEEP		/JUMP TO MAKE A BEEP
	TAD	(260)		/ADD A 260
	AND	(17)
	DCA	REATMP		/STORE THE NUMBER
	TAD	(260)		/GET 260
	TAD	REATMP		/GET THE NUMBER
	JMS I	(PRCHAR)	/PRINT IT
	TAD	REAWRD		/GET THE NUMBER TEMP
	MQL			/LOAD THE MQ
	IFNZRO	DECMATE <

	CIF	CDFL1		/CHANGE TO FIELD WHERE EAE IS LOCATED 
	>
	MUY			/AND MULTIPLY IT
	12			/BY 10
	SWP			/GET THE ANSWER
	TAD	REATMP		/ADD IN THE NEXT NUMBER
	DCA	REAWRD		/RESTORE IT
	JMP	REANUM+3	/JUMP TO GET THE NEXT NUMBER
REARET,	TAD	REATMP		/GET THE LAST CHARCTER 
	JMS I	(PRCHAR)	/PRINT A CR
	TAD	REATMP		/GET THE LAST CHARCTER
	TAD	(-CR)		/SUBTRACT ASCII CODE FOR CR
	SZA			/IF THE LAST CHARCTER WAS NOT A CR
	JMP	SETRET		/THEN RETURN
	TAD	(LF)		/GET ASCII FOR LINE FEED
	JMS I	(PRCHAR)	/PRINT A LF
SETRET,	CLA			/CLEAR AC
	TAD	REAWRD		/GET THE NUMBER INPUTED
	JMP I	REANUM		/RETURN
RBEEP,	CLA			/CLEAR AC
	TAD	REACH1		/CHECK THE FIRST ENDING CODE
	TAD	REATMP		/ADD THE CURRENT REATMP
	SNA CLA			/IF THE REATMP IS AN END CODE
	JMP	REARET		/THEN RETURN
	TAD	REACH2		/ELSE GET THE SECOND END CODE
	TAD	REATMP		/ADD THE REATMP
	SNA CLA			/IF THE REATMP IS AN END CODE
	JMP	REARET		/THEN RETURN
	TAD	(007)		/SET AC TO 7
	JMS I	(PRCHAR)	/RING THE BELL
	JMP	REANUM+3	/GET NEXT NUMBER


REAWRD,	.-.			/COMPLETED NUMBER
REATMP,	.-.			/NEXT NUMBER
REACH1,	7763			/FIRST END CODE
REACH2,	7763			/SECOND END CODE

/GIVCHAR DEFINITIONS

	BUFF= 200		/WHERE TO STORE BUFFER

/THE FOLLOWING ROUTINE WILL BE USED TO READ IN DATA FROM AN INPUT FILE ON DISK

GIVCHAR,.-.			/HEADER
	JMP I	GTRIM		/JMP TO COROUTINE
GTRIM,	GEOF			/END OF FILE
	AND	(77)		/MASK LOWER BITS
	SNA			/SKIP ON NONZERO CHAR
	JMP	GNXWRD		/GET NEXT WORD IF A ZERO
	DCA	GTMP		/STORE CHARACTER
	TAD	GTMP		/GET THE CHARACTER BACK
	TAD	(-41)		/SUBTRACT 41 OCTAL
	SMA CLA			/IF CHARACTER > 40
	JMP	GNOADD		/THEN DO NOT ALTER CHARACTER
	TAD	GTMP		/ELSE GET THE CHARACTER
	TAD	(100)		/ADD 100 OCTAL
	JMP I	GIVCHAR		/RETURN IT
GNOADD,	CLA			/CLEAR <AC>
	TAD	GTMP		/GET THE CHARACTER
	JMP I	GIVCHAR		/RETURN IT
GETMOR,	CDF	CHARFLD		/CHANGE TO CHARACTER FIELD
	TAD I	GPNTR		/GET THE WORD IN THE BUFFER
	CDF	CDFL0		/CHANGE BACK TO THIS FIELD
	SNA			/CHECK FOR END OF FILE (0)
	JMP	GEOF		/END OF FILE GET ANOTHER
	BSW			/GET CHARACTER INTO LOW ORDER BITS ON PDP8/E
	JMS	GTRIM		/GO RETURN 8-BIT ASCII CHARACTER
	CDF	CHARFLD		/CHANGE TO FIELD WHERE BUFFER IS
	TAD I	GPNTR		/GET SECOND CHARACTER IN LOW ORDER BITS
	CDF	CDFL0		/CHANGE BACK TO THIS FIELD
	JMS	GTRIM		/RETURN 8 BIT ASCII CHARACTER
GETMR2,	ISZ	GPNTR		/MOVE TO NEXT WORD
	TAD	GPNTR		/GET WORD ADDRESS
	TAD	(-BUFF-200	/HAVE WE GONE THROUGH
GSYSIO,	SZA CLA			/THE BUFFER
	JMP	GETMOR		/NO,GET MORE CHARACTERS
GEOB,	JMS I	GSYSIO		/YES,CALL I/O ROUTINES FOR ANOTHER BLOCK
GBUFF,	BUFF			/BUFFER LOCATION
GFUN,	1^100+CHARFLD		/READ 1 BLOCK INTO FIELD 4
GBLK,	.-.			/BEGIN BLOCK #
	ISZ	GBLK		/NEXT BLOCK
	TAD	GBUFF		/GET BUFFER LOCATION
	DCA	GPNTR		/PUT INTO POINTER
	JMP	GETMOR		/GO GET MORE
GEOF,	ISZ	FILEPNT		/INCR FILE POINTER
	TAD I	FILEPNT		/GET THE FILE
	AND	(7770)		/MASK HIGH 9 BITS
	SNA
	HLT			/HALT FOR NOW
	DCA	GBLK
	TAD I	FILEPNT
	AND	(7)
	TAD	(1^100+CHARFLD)
	DCA	GFUN
	JMP	GEOB
GNXWRD,	TAD	(GETMR2)	/GET ADDRESS FOR OBTAINING NEW WROD
	DCA	GTRIM		/STORE INTO COROUTINE ARGUMENT
	JMP I	GIVCHAR		/RETURN
GPNTR,	.-.			/TEMP
GTMP,	.-.			/TEMPORARY

	PAGE

/THE FOLLOWING ROUTINE IS CALLED WHEN THE USER WANTS TO USE
/REGIS PROTOCOL IN ORDER TO IMPLEMENT THE CAPABILITIES OF THIS GRAPHICS PROGRAM

/IMPLEMENTED SO FAR: T

REGINP,	CLA			/CLEAR AC
	CDF	MESFLD		/CHANGE TO MESSAGE FIELD
	TAD	(REGRED)	/GET ADDRESS OF REGS READY MESSAGE
	CDF	CDFL0		/CHANGE BACK TO CODE FIELD 0
	DCA I	(MESTMP)	/STORE THE ADDRESS
	JMS I	(MESPRN)	/PRINT THE MESSAGE
	TAD	(CR)		/GET CARRAIAGE RETURN CODE
	JMS I	(PRCHAR)	/PRINT IT
	TAD	(LF)		/GET LINE FEED CODE
	JMS I	(PRCHAR)	/PRINT IT
