	DCA 	Y1		/AND STORE IT
	TAD 	Y2		/GET Y VALUE
	MQL			/PUT IT INTO MQ
	TAD 	X2		/GET X VALUE
	JMS I	(ROTATE)	/ROTATE THE X AND Y VALUES
XVECT2,	.-.			/CENTER OF VECTOR
YVECT2,	.-.			/CENTER OF VECTOR THROUGH (X2,Y2)
VECSN2,	.-.			/SINE OF ROTATION ANGLE
VECCS2,	.-.			/COSINE OF ROTATION ANGLE
	DCA 	X2		/STORE ROTATED X VALUE
	SWP			/GET ROTATED Y VALUE
	DCA 	Y2		/AND STORE IT
	JMS I	(SLPVEC)	/JUMP TO MAKE THE POINTS
	ISZ	CHARADR		/INCREMENT TABLE POINTER
	JMS I	(GETVALS)	/GET VALUES FROM NEXT ENTRY
	TAD 	PXTABL		/GET X VALUE
	SMA CLA			/IF X IS POSITIVE
	JMP	NXTVEC		/THEN GENERATE THE NEXT VECTOR
	JMP I	VECTOR		/ELSE RETURN

	PAGE
	XLIST	OFF

	IFZERO 	EAE <
	/EAE SIMULATION DEFINITIONS
	 MUY=JMS I (XMUL)	/JUMP TO THE MULTIPLY ROUTINE
	 DVI=JMS I (XDVI)	/JUMP TO THE DIVIDE ROUTINE>

	XLIST	ON

SLPVEC,	.-.			/HEADER
	NL7777			/SET AC TO -1
	DCA I	(LUPTIM)	/STORE AS COUNTER FOR THE LOOP TIME
	DCA I	(LUPFLG)	/SET THE LOOP FLAG TO ZERO
	CLA			/CLEAR <AC>
	DCA 	SINFLG		/SET THE SIGN FLAG TO ZERO
	TAD 	X1		/GET X1
	DCA 	XSTRT		/STORE IT AS THE STARTING X
	TAD 	Y1		/GET Y1
	DCA 	YSTRT		/STORE IT AS THE STARTING Y
	TAD 	X1		/GET X1
	CIA			/MAKE IT MINUS
	TAD 	X2		/ADD X2
	SMA			/IF X2 - X1 IS POSITIVE
	JMP	NOCHNG		/THEN DO NOT CHANGE THE STARTING VALUES
	CLA			/ELSE CHANGE THEM
	TAD 	X2		/GET X2

	DCA 	XSTRT		/STORE IT AS THE X STARTING POINT
	TAD 	Y2		/GET Y2
	DCA 	YSTRT		/STORE IT AS THE Y START
NOCHNG,	CLA			/CLEAR AC
	TAD 	X1		/GET 1ST X
	CIA			/MAKE IT MINUS
	TAD 	X2		/ADD 2ND X
	SNA			/IF X2-X1 = 0
	JMS I	(UNDEFI)	/THEN HANDLE YSLP/0
	SPA			/IF IT IS NEGATIVE
	ISZ 	SINFLG		/THEN INCREMENT THE SIGN FLAG
	SPA			/IF IT IS NEGATIVE
	CIA			/THEN MAKE IT POSITIVE

	DCA I	(XSLP)		/STORE IT AS THE ABSOLUTE VALUE OF THE X SLOPE
	TAD 	Y1		/GET 1ST Y
	CIA			/MAKE IT MINUS
	TAD 	Y2		/ADD THE 2ND Y
	SPA			/IF IT IS NEGATIVE
	ISZ 	SINFLG		/THEN INCREMENT SIGN FLAG
	SPA			/IF IT IS NEGATIVE THEN
	CIA			/MAKE IT POSITIVE
	MQL			/LOAD THE MQ
	IFNZRO	DECMATE <
	CIF 	CDFL1		/CHANGE TO FIELD WHERE EAE IS LOCATED
	>
	DVI			/DIVIDE BY
XSLP,	.-.			/THE X SLOPE VALUE
	DCA I	(SLPREM)	/STORE THE REMAINDER
	CLL			/CLEAR THE LINK
	SWP			/GET THE QUOTIENT
	DCA I	(SLPQUO)	/STORE IT
	TAD 	SINFLG		/GET THE SIGN FLAG
	CLL			/CLEAR THE LINK
	RAR			/ROTATE 1 PLACE RIGHT
	CLA			/CLEAR THE REST OF THE AC
	TAD I	(SLPREM)	/GET THE SLOPE REMAINDER
	SZL			/IF LINK IS 1
	CIA			/THEN MAKE THE SLOPE REMAINDER MINUS
	DCA I	(SLPREM)	/RESTORE IT
	TAD 	SINFLG		/GET THE SIGN FLAG
	RAR			/ROTATE 1 PLACE RIGHT
	CLA			/CLEAR THE AC

	TAD I	(SLPQUO)	/GET THE QUOTIENT
	SZL			/IF THE LINK IS NOT ZERO
	CIA			/THEN MAKE THE QUOTIENT NEGATIVE
	DCA I	(SLPQUO)	/STORE AS THE SLOPE QUOTIENT
	CLL			/CLEAR THE LINK JUST IN CASE

	TAD	XSLP		/GET THE X SLOPE VALUE
	RAR			/ROTATE RIGT 1 PLACE = DIVIDE BY 2
	CIA			/MAKE THE ANSWER MINUS
	DCA I	(MHXSLP)	/STORE A MINUS XSLP * .5
SETLUP,	CLA			/SET UP LOOP COUNTER
	TAD I	(XSLP)		/GET X2-X1
	SMA			/IF IT IS NOT MINUS
	CIA			/THEN MAKE IT MINUS
	DCA I	(VECCNT)	/SET THE LOOP COUNTER
	DCA I	(EPSLON)	/SET VARIABLE EPSLON TO ZERO
	JMP I	(PNTLUP)	/JUMP TO GENERATING LOOP
XSTRT,	.-.			/NEXT X POINT
YSTRT,	.-.			/NEXT Y POINT
SINFLG,	.-.			/SIGN FLAG

	PAGE

/GENERATE THE POINTS

PNTLUP,	TAD I	(YSTRT)		/GET THE NEYT X VALUE TO BE STORED
	MQL			/PUT INTO <MQ>
	TAD I	(XSTRT)		/GET THE NEXT Y VALUE TO BE SAVED
	JMS I	(CHUZLP)	/JUMP TO CHECK THEN VALUES TO BE SAVED
	JMS I	(PTSAV)		/SAVE THE X AND Y VALUES
	TAD 	EPSLON		/GET THE ERROR ALTERING VARAIBLE
	TAD 	SLPREM		/ADD THE SLOPE REMAINDER
	DCA 	EROREM		/STORE IT AS THE ERROR VARIABLE REMAINDER
	TAD 	SLPQUO		/GET THE SLOPE QUOTIENT
	DCA 	EROQUO		/STORE IT AS THE ERROR QUOTIENT

	TAD 	EROQUO		/GET THE RROR QUOTIENT
	DCA 	NOTRND		/STORE IT AS THE UNROUNDED ERROR QUOTIENT
	TAD 	EROREM		/GET THE ERROR REMAINDER
	SPA			/IF IT IT NEGATIVE
	CIA			/THEN MAKE IT POSITIVE
	TAD 	MHXSLP		/SUBTRACT HALF THE XSLP
	SPA CLA			/IF IT IS NEGATIVE
	JMP	STRPNT		/THEN DO NOT ROUND IT UP
	TAD 	EROREM		/GET THE ERROR QUOTIENT
	SPA			/IF IT IS NEGATIVE
	JMP	ADMIN1		/THEN JUMP TO ADD MINUS 1
	ISZ 	EROQUO		/INCREMENT ERROR QUOTIENT
	NOP			/IN CASE EROQUO = -1
	JMP	STRPNT		/JUMP TO STORE THE POINTS
ADMIN1,	NL7777			/SET AC TO -1
	TAD 	EROQUO		/ADD THE ERROR QUOTIENT
	DCA 	EROQUO		/RESTORE IT
STRPNT,	CLA			/CLEAR THE AC
	ISZ I	(XSTRT)		/INCREMENT THE X VALUE
	NOP			/JUST IN CASE
	TAD I	(YSTRT)		/GET THE PREVIOUS Y VALUE
	TAD 	EROQUO		/ADD THE ERROR QUOTIENT VALUE

	DCA I	(YSTRT)		/STORE AS THE NEXT Y VALUE
	TAD 	EROREM		/GET THE ERROR REMAINDER
	DCA 	EPSLON		/STORE IT AS THE NEXT EPSILON VALUE
	TAD 	EROQUO		/GET THE ERROR QUOTIENT
	CIA			/MAKE IT MINUS
	TAD 	NOTRND		/AND ADD THE UNROUNDED ERROR QUOTIENT VALUE
	SNA CLA			/IF IT IS ZERO
	JMP 	LUPCHK		/THEN DO NOT CHANGE THE EPSILON VALUE
	TAD I	(SINFLG)	/GET THE SIGN FLAG
	CLL			/CLEAR THE LINK
	RAR			/ROTATE RIGHT 1 PLACE
	CLA			/CLEAR AC
	TAD I	(XSLP)		/GET THE X SLOPE VALUE
	SNL			/IF POSITIVE
	CIA			/MAKE IT MINUS
	TAD 	EROREM		/ADD THE ERROR REMAINDER
	DCA 	EPSLON		/AND STORE IT AS THE NEXT EPSLON VALUE
LUPCHK,	ISZ	VECCNT		/IF LOOP COUNT IS NOT ZERO
	JMP	PNTLUP		/THEN CONTINUE
	JMP I	(MORVEC)	/ELSE STOP

VECCNT,	.-.			/COUNTER FOR PNTLUP
EPSLON,	.-.			/USED TO ALTER ERROR VARIABLE
SLPREM,	.-.			/REMAINDER OF YSLP/XSLP
SLPQUO,	.-.			/QUOTIENT OF YSLP/XSLP
EROREM,	.-.			/DECIMAL ERROR VARAIBLE
EROQUO,	.-.			/INTEGER ERROR VARIABLE
LUPCNT,	.-.			/PNTLUP COUNTER
YSLP,	.-.			/Y2-Y1
MHXSLP,	.-.			/-XSLP*.5
NOTRND,	.-.			/UNROUNDED ERROR VARIABLE

	PAGE

MORVEC,	TAD I	(YSTRT)		/ELSE SAVE THE LAST PAIR OF POINTS
	MQL			/PUT INTO <MQ>
	TAD I	(XSTRT)		/GET THE X TO BE SAVED
	JMS I	(CHUZLP)	/JUMP TO CHECK X AND Y VALUES
	JMS I	(PTSAV)		/JUMP TO STORE THE POINTS
	TAD 	Y1		/GET Y1
	CIA			/MAKE IT MINUS
	TAD 	Y2		/ADD Y2
	SNA CLA			/IF Y2-Y1 IS ZERO
	JMP I	(VECTHK)	/THEN LEAVE
	ISZ 	LUPTIM		/IF THE LOOP TIME IS NOT ZERO
	JMP I	(VECTHK)	/THEN GET OUT OF THIS LOOP
	ISZ 	LUPFLG		/ELSE INCREMENT THE LOOP FLAG
	TAD 	X1		/GET ORIGINAL 1ST X
	SWP			/PUT IT INTO THE MQ
	TAD 	Y1		/GET THE ORIGINAL IST Y
	DCA 	X1		/AND STORE IT AS THE 1ST X
	SWP			/GET THE 1ST X
	DCA 	Y1		/AND STORE IT AS THE 1ST Y
	TAD 	X2		/GET THE 2ND X
	SWP			/PUT IT INTO THE MQ
	TAD 	Y2		/GET THE 2ND Y
	DCA 	X2		/AND STORE IT AS THE 2ND X
	SWP			/GET THE 2ND X
	DCA 	Y2		/AND STORE IT AS THE 2ND Y
	JMP I	(SLPVEC+4)	/JUMP TO RESET THE SLOPES


/ROUTINE TO SWITCH THE XPTSAV AND YPTSAV VALUES IF WE ARE DOING THE SECOND LOOP

CHUZLP,	.-.			/HEADER
	DCA I	(XPTSAV)	/STORE VALUE IN <AC> IN A TEMP
	TAD	LUPFLG		/GET THE LOOP FLAG
	RAR			/ROTATE IT RIGHT
	CLA			/CLEAR <AC>
	TAD I	(XPTSAV)	/GET ORIGINAL <AC> BACK
	SZL			/IF LINK IS 1
	SWP			/THEN SWAP <MQ> AND <AC>
	JMP I	CHUZLP		/RETURN

LUPFLG,	.-.			/THIS FLAG INDICATES THE TIME THROUGH PNTLUP
				/IF LUPFLG = 0 THEN WE ARE WORKING FROM X1 - X2
				/IF LUPFLG = 1 THEN WE ARE WORKING FROM Y1 - Y2
LUPTIM,	.-.			/THIS COUNTER ALLOWS US TO DO PNTLUP TWICE

/ROUTINE TO GENERATE VECTOR THICKNESS

VECTHK,	NL7777			/SET AC TO -1
	TAD I	(CHARTHCK)	/GET FONT THICKNESS
	SNA			/IS FONT THICKNESS-1=0
	JMP	ENDVEC		/YES->GET READY TO LEAVE
	DCA I	(CHARTHCK)	/N0->RESTORE THICKNESS
	TAD 	X1		/GET 1ST X
	TAD I	(X1BLD)		/ADD X1 BOLD
	DCA 	X1		/RESTORE
	TAD 	Y1		/GET 1ST Y
	TAD I	(Y1BLD)		/ADD Y1 BOLD
	DCA 	Y1		/RESTORE
	TAD 	X2		/GET 2ND X
	TAD I	(X2BLD)		/ADD X2 BOLD
	DCA 	X2		/RESTORE
	TAD 	Y2		/GET 2ND Y
	TAD I	(Y2BLD)		/ADD Y2 BOLD
	DCA 	Y2		/RESTORE
	JMP I	(SLPVEC+4)	/GENERATE NEXT VECTOR
ENDVEC,	CLA			/YES->RETURN
	TAD I	(SLPVEC)	/GET RETURN ADDRESS
	DCA 	VECRTN		/STORE IT
	JMP I	VECRTN		/RETURN
VECRTN,	.-.			/RETURN ADDRESS
X1BLD,	.-.			/X1 BOLD
X2BLD,	.-.			/X2 BOLD
Y1BLD,	.-.			/Y1 BOLD
Y2BLD,	.-.			/Y2 BOLD
ACOS,	.-.			/A*COS
BSIN,	.-.			/B*SIN
ARCCNTR,.-.			/NUMBER OF ENTRIES IN EACH TABLE OF VALUES
XSIGN,	.-.			/X ADD OR SUBTRACT VARIABLE
YSIGN,	.-.			/Y ADD OR SUBTRACT VARIABLE
RNDOFF,	.-.			/ROUNDING VARIABLE FOR THE VECTOR ROUTINE
ROWX,	.-.			/ROW NUMBER FOR UNDEFI ROUTINE
CHARTHCK,.-.			/TEMPORARY FOR FONT THICKNESS

	PAGE

/THIS ROUTINE GETS THE VALUES FROM THE CHARACTER WORD IN MEMORY

GETVALS,.-.			/SUBROUTINE HEADER
	CLA CLL			/CLEAN UP
	CDF	CHARFLD		/CHANGE TO THE CHARACTER TABLE FIELD
	TAD I	CHARADR		/GET THE WORD TO BE PROCESSED
	CDF	CDFL0		/CHANGE BACK TO THE CODING FIELD
	DCA	VALTMP		/STORE IT
	TAD 	VALTMP		/GET THE WORD
	AND	(7000)		/AND OFF BITS 0-2 => X VALUE
	RTL;RTL			/ROTATE AC 4 PLACES LEFT
	JMS I	(CHCK7)		/CHECK IF THE VALUE IS 7
	DCA 	PXTABL		/STORE IT AS THE X TABLE VALUE
	TAD	VALTMP		/GET THE WORD
	AND	(700)		/GET BITS 3-7 => Y VALUE
	RTR;RTR;RTR		/ROTATE AC 6 PLACES RIGHT
	JMS I	(CHCK7)		/CHECK IF THE VALUE IS 7
	DCA 	PYTABL		/STORE IT AS THE Y TABLE VALUE
	TAD	VALTMP		/GET THE WORD
	AND	(70)		/AND OFF BITS 6-8 => X BOLD VALUE
	RTR;RAR			/ROTATE AC 3 PLACES RIGHT
	JMS I	(CHCK7)		/CHECK IF VALUE IS 7
	DCA 	PXBOLD		/STORE IT AS THE X BOLD TABLE VALUE
	TAD	VALTMP		/GET THE WORD
	AND	(7)		/GET BITS 9-11 => Y BOLD VALUE
	JMS I	(CHCK7)		/CHECK IF THE VALUE IS 7
	DCA 	PYBOLD		/STORE IT AS THE Y BOLD TABLE VALUE
	JMP I	GETVALS		/RETURN

/ROUTINE TO CHECK IF VALUE IN THE AC = 7

CHCK7,	.-.			/HEADER
	DCA	CHCKTMP		/STORE THE AC
	TAD	CHCKTMP		/GET THE AC VALUE
	TAD	(-7)		/SUBTRACT 7
	SNA CLA			/IF THE ANSWER IS ZERO
	JMP 	MIN1		/THEN AC IS 7
	TAD	CHCKTMP
	JMP I	CHCK7		/AND RETURN
MIN1,	NL7777			/SET AC TO -1
	JMP I	CHCK7		/RETURN
VALTMP,	.-.			/TEMPORARY FOR THE CHARACTER WORD
CHCKTMP,.-.			/TEMPORARY FOR THE VALUE


/SUBROUTINE TO PRECLEAR AREA ON DISK FOR PLOTTING

PRECLR,	.-.			/SUBROUTINE HEADER
	JMS I	(CLRFLDS)	/CLEAR THE APPROPRIATE FIELDS
	TAD I	(BLKNUM)	/GET THE INITIAL BLOCK NUMBER
	DCA	PRCLRTMP	/STORE IT
	TAD	(-PLTBLK)	/GET NUMBER OF JUMPS TO SAVIO
	DCA 	PRCLCNT		/STORE AS COUNT
	JMS I	(SAVIO)		/STORE ON DISK
	ISZ	PRCLCNT		/IF WE FINISHED THEN SKIP
	JMP	.-2		/ELSE KEEP CLEARING
	TAD	PRCLRTMP	/GET THE INITIAL BLOCK COUNT
	DCA I	(BLKNUM)	/STORE BACK IN BLOCK NUMBER
	JMP I	PRECLR		/RETURN TO CALLER
PRCLCNT,.-.			/PRECLEAR COUNTER
PRCLRTMP,.-.			/PRECLEAR TEMPORARY

/ROUTINE TO ROUND THE ANSWER TO A*COS AND B*SIN

PTCHK,	.-.			/HEADER
	SWP			/SWAP AC AND MQ
	CLL			/CLEAR THE LINK
	RAL			/ROTATE AC LEFT ONE PLACE
	SNL			/IF LINK IS ZERO
	JMP	NOINC		/THEN JUMP TO RETURN
	CLA CLL			/ELSE CLEAR AC AND LINK
	SWP			/SWAP AC AND MQ
	IAC			/INCREMENT AC
	JMP I	PTCHK		/RETURN
NOINC,	SWP			/SWP AC AND MQ
	JMP I	PTCHK		/RETURN

	PAGE
/ROUTINE TO HANDLE CHARACTERS THAT NEED SPECIAL THICKNESS

SPECIAL,.-.			/HEADER
	TAD I	(FONTHCK)	/ADD FONT THICKNESS
	DCA 	FONTMP		/STORE IT IN A TEMP
	TAD 	FONTMP		/GET THE THICKNESS
	CLL			/CLEAR THE LINK
	RAR			/DIVIDE BY 2
	IAC			/INCREMENT AC
	DCA I	(FONTHCK)	/STORE AS THE THICKNESS
	TAD I	(RTNCHUZ)	/GET RTNCHUZ RETURN ADDRESS
	DCA 	LSTRET		/STORE IT IN A TEMP
	ISZ I	(CHARADR)	/INCREMENT TABLE POINTER

	JMS I	(GETVALS)		/GET THE TABLE VALUES
	JMS I	(RTNCHUZ)	/CONTINUE AS NORMAL
	CLA			/CLEAR AC
	TAD 	LSTRET			/GET RTNCHUZ LAST RETURN ADDRESS
	DCA I	(RTNCHUZ)	/RESTORE IT
	TAD 	FONTMP		/GET ORIGINAL FONT THICKNESS
	DCA I	(FONTHCK)	/RESTORE IT
	ISZ I	(CHARADR)	/INCREMENT TABLE POINTER
	JMS I	(GETVALS)	/GET THE TABLE VALUES
	JMP I	SPECIAL		/RETURN
LSTRET,	.-.			/TEMPORARY FOR RETURN ADDRESS
FONTMP,	.-.			/TEMPORARY FOR FONT THICKNESS

/ROUTINE TO GET THE POINTS FOR THE SYMBOL GENERATION

GETPNT,	.-.			/HEADER
	ISZ	XPTADD		/INCREMENT X VALUE POINTER
	NOP
	CDF 	XFLD		/CHANGE TO X FIELD
	TAD I	XPTADD		/GET THE NEXT X
	CDF	CDFL0		/CHANGE TO CODING FIELD
	DCA I	(XPT)		/STORE IT
	ISZ	YPTADD		/INCREMENT Y VALUE POINTER
	NOP
	CDF	YFLD		/CHANGE TO Y FIELD
	TAD I	YPTADD		/GET THE NEXT Y
	CDF	CDFL0		/CHANGE TO THE CODING FIELD
	DCA I	(YPT)		/STORE IT
