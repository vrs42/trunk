/ROUTINE WHICH CHOOSES WHICH SYMBOL IS TO BE GENERATED AND CALLS THE
/CORRECT ROUTINE.

	XLIST	OFF

	IFZERO	EAE	<
	/EAE SIMULATION DEFINITION
	DVI=JMS I (XDVI)>

	XLIST	ON

SYMPLOT,.-.			/SUBROUTINE HEADER
	CLA			/CLEAR AC
	CDF	XFLD		/CHANGE TO X DATA FIELD
	TAD I	(XFLPNCN)	/GET THE NUMBER OF X AND Y POINTS
	CDF	CDFL0		/CHANGE TO CODING FIELD
	CIA			/2'S COMPLEMENT
	DCA I	(JMPCNT)	/STORE AS JUMP COUNTER TO SYMPLOT
	TAD	(XPNSTR-1)	/GET THE ADDRESS WHERE THE X AND Y VALUES BEGIN
	DCA	XPTADD		/INITILIZE POINTER TO X VALUES
	TAD	(XPNSTR-1)	/GET ADDRESS WHERE THE X AND Y VALUES BEGIN -1
	DCA	YPTADD		/INITIALIZE POINTER TO Y VALUES
	TAD I	(FONTLEN)	/GET THE FONT LENGTH
	CLL			/CLEAR LINK
	RAR			/DIVIDE BY 2
	CIA			/MAKE IT MINUS
	DCA 	YOFFS			/STORE AS Y OFFSET VALUE
	TAD I	(FONTWID)	/GET THE FONT WIDTH
	CLL			/CLEAR LINK
	RAR			/DIVIDE BY 2
	CIA			/MAKE IT MINUS
	DCA 	XOFFS			/STORE AS X OFFSET VALUE
	DCA	FILFLG		/SET FILL FLAG TO 0
FNDSYM,	TAD I	(SYMBOL)	/GET THE SYMBOL CODE
	AND	(7)		/GET ONLY 3 HIGHEST BITS
	SNA			/IF SYMBOL CODE = 0
	JMS I	(DOTS)		/THEN JUMP TO GENERATE ONLY DOTS
	CIA			/SET AC TO FIND CORRECT SUB TO JUMP TO
	DCA 	SYMJMP		/STORE IT
	NL7777			/SET AC TO -1
	DCA	XR4		/SET XR4 TO -1
	CDF	CHARFLD		/CHANGE TO CHARACTER FIELD
	TAD	(STRTTAB)	/GET ADDRESS OF TABLE OF ADDRESSES
	CIA			/AMKE IT NEGATIVE
	TAD	(SYMLOC)	/ADD ADDRESS OF SYMBOL LOCATION
	TAD	(40)		/ADD 32
	CDF	CDFL0		/CHANGE BACK TO CODE FIELD 0
FNDCOD,	IAC			/INCREMENT AC
	ISZ 	SYMJMP		/IS SYMJMP = 0?
	JMP	FNDCOD		/NO->CONTINUE
	CDF	CHARFLD		/YES->CHANGE TO CHARACTER FIELD
	DCA I	XR4		/STORE CHARACTER ADDRESS IN FIRST ADDRESS
				/OF THE CHARACTER FIELD
	DCA I	XR4		/STORE A ZERO IN THE SECOND ADDRESS
	CDF	CDFL0		/CHANGE BACK TO THE CODING FIELD
	JMS I	(MAKONE)	/JUMP TO MAKE ONE SYMBOL
SYMLUP,	CLA			/CLEAR AC
	JMS I	(GETPNT)	/GET THE NEXT X-Y COORDINATE
	JMS I	(CONPNT)	/JUMP TO GENERATE THE SYMBOL
	ISZ I	(JMPCNT)	/ARE WE FINISHED WITH THE COORDINATES?
	JMP	SYMLUP		/NO->GET THE NEXT COORDINATE
	JMP I	SYMPLOT		/YES->RETURN


/ROUTINE USED TO GENERATE THE SYMBOL CHOSEN BY USING PRE-GENERATED POINTS
/STORED IN PAGES 0 AND 1 OF FIELD 4


CONPNT,	.-.			/HEADER
	CDF	XFLD		/CHANGE TO X DATA FIELD
	TAD I	(XFLPNCN)	/GET THE NUMBER OF DATA PAIRS
	CDF	CDFL0		/CHANGE BACK TO CURRENT DATA FIELD
	TAD	(XPNSTR-1)	/ADD THE STARTING ADDRESS OF THE POINTS - 1
	DCA	XR5		/SET AUTO INDEX REGISTER 5
	TAD	XR5		/GET THE ADDRESS TO START
	DCA	XR6		/SET AUTO INDEX REGISTER 6

	TAD I	(SYMPTS)	/GET NUMBER OF POINTS IN BUFFER
	CIA			/MAKE IT NEGATIVE
	DCA	BUFCNT		/AND STORE AS BUFFER COUNTER
CONLUP,	CDF	XFLD		/CHANGE TO FIELD WHERE POINTS ARE STORED
	TAD I	XR5		/GET NEXT X VALUE
	CDF	CDFL0		/CHANGE BACK TO CODING FIELD 0

	TAD I	(XPT)		/ADD THE X CENETER VALUE OF THE SYMBOL
	DCA I	(XPTSAV)	/STORE IT
	CDF	YFLD		/CHANGE TO FIELD WHERE POINTS ARE STORED
	TAD I	XR6		/GET NEYT Y VALUE
	CDF	CDFL0		/CHANGE BACK TO CODING FIELD 0

	TAD I	(YPT)		/ADD THE Y CENTER VALUE OF THE SYMBOL
	MQL			/PUT IN <MQ>
	TAD I	(XPTSAV)	/GET THE X VALUE IN <AC>
	JMS I	(PTSAV)		/JUMP TO SAVE THE POINTS
	ISZ 	BUFCNT		/ARE WE FINISHED READING THE BUFFER?
	JMP	CONLUP		/NO->GET THE NEXT VALUE
	JMP I	CONPNT		/YES->RETURN
BUFCNT,	.-.			/BUFFER COUNTER

/ROUTINE TO GENERATE ONE SYMBOL CENTERED AROUND (0,0)

MAKONE,	.-.			/HEADER
	DCA I	(SYMPTS)	/SET SYMPTS TO ZERO
	JMS I	(SETCNT)	/JUMP TO SET THE INDEX REGISTERS
	NL7777			/SET <AC> TO 7777
	DCA I	(CHRTCS)	/SET COSINE OF ROTATION ANGLE
	DCA I	(CHRTSN)	/SET SINE OF ROTATION ANGLE
	NL7777			/SET COSINE SKIP FLAG FOR
	DCA I	(COSSKP)	/ROTATION TO -1
	NL7777			/SET SINE SKIP FLAG FOR
	DCA I	(SINSKP)	/ROTATION TO -1
	JMS I	(CHARSET)	/JUMP TO GENERATE ONE SYMBOL
	CDF	XFLD		/CHANGE TO X DATA FIELD
	TAD I	(XFLPNCN)	/GET THE NUMBER OF DATA PAIRS
	CDF	CDFL0		/CHANGE BACK TO CODING FIELD
	TAD	(XPNSTR)	/ADD FIRST ADDRESS TO STORE POINTS
	CIA			/MAKE IT NEGATIVE
	TAD	XR7		/ADD ADDRESS OF LAST POINT GENERATED
	DCA I	(SYMPTS)	/NUMBER OF POINTS GENERATED FOR A COUNTER
	JMS I	(SETCNT)	/RESET REGISTERS AND COUNTERS
	JMP I	MAKONE		/RETURN
SYMPTS,	.-.			/NUMBER OF POINTS GENERATED
XOFFS,	.-.			/CONTAINS THE X FONT SIZE
YOFFS,	.-.			/CONTAINS THE Y FONT SIZE
FILFLG,	.-.			/FLAG TO TELL TO FILL THE SYMBOL
SYMJMP,	.-.			/SYMBOL ADDRESS LOOP COUNTER

