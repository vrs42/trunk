ARCCHK,	NL7777			/SET AC TO -1
	TAD I	(CHARTHCK)	/ADD THE THICKNESS VALUE
	SNA			/IF THICKNESS-1 =0
	JMP	ARCMOR		/THEN CHECK FOR MORE ARCS
	DCA I	(CHARTHCK)	/ELSE SAVE THICKNESS-1
	TAD 	PXBOLD		/GET X BOLD VALUE
	TAD I	(XRADI)		/ADD THE X RADIUS
	SMA CLA			/IF XRADI - PXBOLD IS > = 0
	DCA I	(XRADI)		/RESET X RADIUS
	TAD 	PYBOLD		/GET Y BOLD VALUE
	TAD I	(YRADI)		/ADD Y RADIUS
	SMA CLA			/IF YRADI - PYBOLD IS > = 0
	DCA I	(YRADI)		/RESET Y RADIUS
	TAD 	PXBOLD		/GET X BOLD VALUE
	TAD 	PYBOLD		/ADD Y BOLD VALUE
	SNA CLA			/IS X BOLD + Y BOLD = 0
	SKP			/YES->SKIP
	JMP I	(AGAIN)		/NO->GENERATE ARC AGAIN
ARCMOR,	CLA			/CLEAR AC
	ISZ I	(CHARADR)	/INCREMENT TABLE POINTER
	JMS I	(GETVALS)	/GET THE VALUES
	TAD 	PXTABL		/GET X VALUE
	SMA CLA			/IS IT MINUS?
	JMP I	(NXTARC)	/NO->CONTINUE WITH ARCS
	TAD I	(ARCS)		/GET RETURN ADDRESS
	DCA I	(ARCRET)	/STORE IT
	JMP I	ARCRET		/RETURN
ARCRET,	.-.			/RETURN ADDRESS FOR ARCS ROUTINE

