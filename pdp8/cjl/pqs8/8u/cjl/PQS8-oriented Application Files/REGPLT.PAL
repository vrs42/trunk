/ROUTINE TO GENERATE THE POINTS OF A LINE SEGMENT WITH SLOPE = 1/0


UNDEFI,	.-.			/SUBROUTINE HEADER
	CLA			/CLEAN UP
	TAD 	X1		/GET X VALUE
	DCA I	(ROWX)		/STORE IT AS THE ROW NUMBER
	TAD 	Y1		/GET 1ST Y
	DCA I	(YSTRT)		/INITIALIZE Y STARING VALUE
	TAD 	Y1		/GET 1ST Y
	CIA			/2'S COMPLEMENT
	TAD 	Y2		/ADD 2ND Y
	SMA			/IS Y2-Y1<0
	JMP	ZEROCK		/CHECK FOR Y2-Y1=0
	CLA			/ELSE SWITCH YSTRT TO Y2
	TAD 	Y2		/GET 2ND Y
	DCA I	(YSTRT)		/SET Y START
ZEROCK,	CLA			/CHECK FOR Y2-Y1=0
	TAD 	Y1		/GET 1ST Y
	CIA			/2'S COMPLEMENT
	TAD 	Y2		/ADD 2ND Y
	SZA			/IS IT 0?
	JMP	UNDSET		/NO->JUMP TO GENERATE VECTOR
	TAD 	Y1		/GET 1ST Y
	MQL			/PUT INTO <MQ>
	TAD I	(ROWX)		/GET ROW NUMBER
	JMS I	(CHUZLP)	/JUMP TO CHECK THE LOOP STATUS
	JMS I	(PTSAV)		/STORE THE VALUES
	JMP I	(VECTHK)	/LEAVE
UNDSET,	CLA			/SET UNDLUP COUNTER
	TAD 	Y1		/GET 1ST Y
	CIA			/GET 2'S COMPLEMENT
	TAD 	Y2		/ADD 2ND Y
	SMA			/IF IS NOT MINUS
	CIA			/THEN MAKE IT MINUS
	DCA I	(VECCNT)	/STORE IT AS THE COUNTER
UNDLUP,	CLA			/CLEAR AC
	TAD I	(YSTRT)		/GET NEXT Y ON THE VECTOR
	MQL			/PUT INTO <MQ>
	TAD I	(ROWX)		/GET ROW NUMBER
	JMS I	(CHUZLP)	/CHECK THE LOOP STATUS
	JMS I	(PTSAV)		/JUMP TO SAVE THE POINTS
	ISZ I	(YSTRT)		/SET YSTRT TO NEXT Y VALUE
	NOP			/IN CASE YSTRT=0
	ISZ I	(VECCNT)	/ARE WE FINISHED?
	JMP 	UNDLUP		/NO->CONTINUE
	JMP I	(VECTHK)	/YES->JUMP TO CHECK FOR VECTOR THICKNESS


/ROUTINE TO GET READY TO JUST PRINT DOTS

