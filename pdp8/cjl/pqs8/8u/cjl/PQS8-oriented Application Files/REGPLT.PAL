/ROUTINE TO CHECK THE SIGN OF THE Y FROM LINADJ AND CORRECT
/ITS SIGN ACCORDING TO THE ORIGINAL X VALUE

XSGNCK,	.-.			/HEADER
	DCA I	(ADJTM1)	/STORE THE AC IN A TEMP

	TAD 	SINORG			/GET ORIGINAL X
	SPA CLA			/IS IT POSITIVE?
	JMP	MAKNEG		/NO->MAKE IT NEGATIVE
	TAD I	(ADJTM1)	/GET ORIGINAL AC
	JMP I	XSGNCK		/RETURN
MAKNEG,	CLA			/CLEAR AC
	TAD I	(ADJTM1)	/GET ORIGINAL AC
	CIA			/MAKE IT NEGATIVE
	JMP I	XSGNCK		/RETURN
SINORG,	.-.			/HOLDS THE ORIGINAL VALUE OF A NUMBER

/THIS ROUTINE IS USED WHEN THE CHARACTERS GO BELOW THE X AXIS

UNDER,	.-.			/HEADER
	CLA			/CLEAR AC
	DCA 	MINFLG		/SET THE UNDER FLAG TO ZERO
	ISZ	MINFLG		/SET IT TO A 1
	TAD I	(RTNCHUZ)	/GET THE RETURN ADDRESS OF RTNCHUZ
	DCA	UNDTMP		/STORE IT IN A TEMP
	ISZ I	(CHARADR)	/INCREMENT THE CHARACTER TABLE POINTER
	JMS I	(GETVALS)	/GET THE VALUES
	JMS I	(RTNCHUZ)	/JUMP TO CHOOSE THE CORRECT ROUTINE
	CLA			/CLEAR THE AC
	TAD	UNDTMP		/GET RTNCHUZ'S ORIGINAL RETURN
	DCA I	(RTNCHUZ)	/RESTORE IT
	DCA 	MINFLG		/SET THE UNDER FLAG TO ZERO
	ISZ I	(CHARADR)	/INCREMENT THE CHARACTER YABLE POINTER
	JMS I	(GETVALS)	/GET THE VALUES
	JMP I	UNDER		/RETURN

MINFLG,	.-.			/UNDER FLAG
UNDTMP,	.-.			/HOLDS RTNCHUZ'S RETURN ADDRESS

/THIS ROUTINE ADJUSTS THE SPACING FOR SPECIAL CHARACTERS

SPESPA,	.-.			/HEADER
	ISZ	CHARADR		/INCREMENT CHARACTER TABLE POINTER
	JMS I	(GETVALS)	/GET THE VALUES OF THE NEXT WORD IN THE TABLE
	TAD 	PXTABL		/GET X DISPLACEMENT VALUE
	JMS I	(XADJUS)	/ADJUST IT
	CIA			/MAKE IT NEGATIVE
	TAD 	XLFCRNR	/ADD THE LEFT CORNER VALUE
	DCA 	XLFCRNR	/RESTORE IT
	TAD 	PYTABL		/GET THE Y DISPLACEMENT VALUE
	JMS I	(YADJUS)	/ADJUST IT
	CIA			/MAKE IT NEGATIVE
	TAD 	YLFCRNR	/ADD THE Y LEFT CORNER VALUE
	DCA 	YLFCRNR	/RESTORE IT
	ISZ	CHARADR		/INCREMENT CHARACTER TABLE POINTER
	JMS I	(GETVALS)	/GET THE VALUES
	JMP I	SPESPA		/RETURN


	PAGE 


/THE FOLLOWING ROUTINE IS CALLED WHEN THE USER WISHES TO CHANGE THE X AND Y
/SPACING VALUES

GETPAR,	.-.			/HEADER
	CLA			/CLEAR AC
	RDF			/READ DATA FIELD
	TAD	(CDF CIF)	/ADD 6203
	DCA	PARRET		/STORE FOR RETURN TO CALLING FIELD
	CDF	CDFL0		/CHANGE TO CODING FIELD 0
	NL7777			/SET X PARAMETER FLAG
	DCA	XPARMF	/TO -1
	NL7777			/SET Y PARAMMETER FLAG
	DCA	YPARMF	/TO -1
	JMS I	(CHUZIN)	/GET THE NEXT SPACING PARAMETER
	DCA 	CMDPAR		/STORE IT
	TAD	CMDPAR		/GET THE NEXT SPACING PARAMETER
	TAD	(-COMMAC)	/ADD - ASCII COMMA CODE
	SZA			/IF IT IS NOT A COMMA
	JMP 	GTXPAR		/THE JUMP TO GET THE X PARAMETER VALUE
	TAD	CMDPAR		/GET COMMA
	JMS I	(PRCHAR)	/PRINT THE COMMA
GTYPAR,	CLA			/ELSE GET THE Y VALUE
	ISZ	YPARMF	/INCREMENT Y PARAMETER FLAG
	NOP			/FOR SKIP
	TAD	(-ENDBRC)	/GET - END BRACKET ASCII CODE
	DCA I	(REACH1)	/STORE IT AS REANUM'S 1ST END CODE
	TAD	(-ENDBRC)	/GET - END BRACKET ASCII CODE
	DCA I	(REACH2)	/STORE IT AS REANUM'S 2ND END CODE
	JMS I	(CHUZIN)	/GET THE NEXT PARAMETER
	DCA	CMDPAR		/STORE THE NEXT CHARACTER
	JMS I	(GIVPAR)	/JUMP TO GET THE Y PARAMETER VALUE
	CIA			/MAKE IT OPPOSITE WHAT IT IS BECAUSE OF THE WAY
				/REGIS ORGANIZES ITS BIT MAP
PARM2,	DCA 	YSPACE		/GIVPAR RETURNS THE Y PARAMETER VALUE
	JMS I	(SETREL)	/JUMP TO SET THE RELATIVE FLAG
	DCA	YRELFL	/STORE AC IN Y RELATIVE FLAG
	TAD	(-CR)		/GET - ASCII CODE FOR CR
	DCA I	(REACH1)	/STORE IT AS REANUM'S 1ST END CODE
	TAD	(-CR)		/GET - ASCII CODE FOR CR
	DCA I	(REACH2)	/STORE IT AS REANUM'S SECOND END CODE
	JMP	PARRET		/JUMP TO RETURN

/THE FOLLOWING ROUTINE IS CALLED IN ORDER TO GET THE X SPACING VALUE

GTXPAR,	ISZ	XPARMF	/INCREMENT X PARAMETER FLAG
	NOP			/FOR SKIP
	CLA			/CLEAR AC
	TAD	(-COMMAC)	/GET - ASCII FOR COMMA
	DCA I	(REACH1)	/STORE IT AS REANUM'S 1ST END CODE
	TAD	(-ENDBRC)	/GET - ASCII FOR [
	DCA I	(REACH2)	/DTORE IT AS REANUM'S 2ND END CODE
	JMS 	GIVPAR		/JUMP TO GET THE X SPACING VALUE
PARM1,	DCA 	XSPACE		/GIVPAR RETURNS THE X PARAMETER VALUE
	JMS I	(SETREL)	/JUMP TO SET RELATIVE FLAG
	DCA	XRELFL	/STORE AC IN X RELATIVE FLAG
	TAD I	(REATMP)	/GET THE CODE THAT ENDED REANUM
	TAD	(-ENDBRC)	/ADD - ASCII FOR ]
	SZA			/IF THE END CODE WAS NOT ]
	JMP	GTYPAR		/THEN RETURN TO GET Y PARAMETER
	TAD	(-CR)		/GET - ASCII CODE FOR CR
	DCA I	(REACH1)	/STORE IT AS REANUM'S 1ST END CODE
	TAD	(-CR)		/GET - ASCII CODE FOR CR
	DCA I	(REACH2)	/STORE IT AS REANUM'S SECOND END CODE
PARRET,	.-.			/CODE TO RETURN TO CALLING INSTRUCTION AND DATA FIELD
	JMP I	GETPAR		/RETURN

CMDPAR,	.-.			/NEXT PARAMETER


/THE FOLLOWING ROUTINE IS CALLED TO SET THE RELATIVE FLAGS

/IF CMDPAR IS A PLUS OR MINUS, THEN THE AC IS SET TO 0 AND THE ROUTINE RETURNS
/ELSE, THE AC IS SET TO -1 AND RETURNS

SETREL,	.-.			/HEADER
	TAD I	(CMDPAR)	/GET THE COMMAND PARAMETER
	TAD	(-PLUSCD)	/SUBTRACT PLUS ASCII CODE
	SNA CLA			/IF CMDPAR = +
	JMP	YESREL		/THEN THE COMMAND WAS RELATIVE => SET AC TO ZERO
	TAD I	(CMDPAR)	/ELSE GET THE COMMAND PARAMETER AGAIN
	TAD	(-MINUSC)	/SUBTRACT MINUS ASCII CODE
	SNA CLA			/IF CMDPAR = -
	JMP	YESREL		/THEN SET AC TO ZERO
	NL7777			/ESLE SET AC TO -1

YESREL,	JMP I	SETREL		/RETURN

/THE FOLLOWING ROUTINE IS CALLED IN ORDER TO GET THE NEXT SPACING VALUE

GIVPAR,	.-.			/HEADER
	TAD	CMDPAR		/GET THE CHARACTER AGAIN
	TAD	(-PLUSCD)	/ADD - ASCII FOR +
	SNA CLA			/IF THE CHARACTER IS A PLUS
	JMP	GETNUM		/THEN JUMP TO GET THE NUMBER FOLLOWING IT
	TAD	CMDPAR		/ELSE GET THE CHARACTER AGAIN
	TAD	(-MINUSC)	/ADD - ASCII FOR -
	SNA CLA			/IF THE CHARCTER IS A MINUS
	JMP	GETNUM		/THEN JUMP TO GET THE FOLLOWING NUMBER
	DCA I	(REAWRD)	/ELSE GET READY TO JUMP TO REANUM
	TAD	(GIVRET)	/GET THE ADDRESS OF THE POSITION 5 PLACES DOWN
	DCA I	(REANUM)	/STORE IT AS REANUM'S RETURN ADDRESS
	TAD	CMDPAR		/GET THE NEXT CHARACTER
	DCA I	(REATMP)	/STORE IT IN REATMP
	JMP I	(REANUM+5)	/JUMP TO 5 POSITIONS PAST REANUM
GIVRET,	JMP I	GIVPAR		/RETURN WITH ANSWER IN AC

GETNUM,	TAD	(-2)		/SET AC TO -2
	DCA 	NUMSIN		/AND STORE IT AS THE NUMBER'S SIGN FLAG
	TAD 	CMDPAR		/GET THE + OR -
	JMS I	(PRCHAR)	/PRINT IT
	TAD 	CMDPAR		/GET THE + OR -
	TAD	(-PLUSCD)	/ADD - ASCII FOR PLUS
	SNA CLA			/IF IT IS NOT A PLUS
	ISZ 	NUMSIN		/THEN MAKE NUMSIN A MINUS 1
	JMS I	(REANUM)	/JUMP TO GET THE NEXT NUMBER
	ISZ 	NUMSIN		/IF NUMSIN IS -1
	CIA			/THEN MAKE THE NUMBER JUST RECEIVED NEGATIVE
	JMP I	GIVPAR  	/RETURN
NUMSIN,	.-.			/FLAG FOR THE SIGN OF THE SPACING VALUE

	PAGE
	XLIST	OFF

	IFZERO 	EAE <

	/EAE SIMULATION DEFINITIONS

 	DVI=JMS I (XDVI)	/EAE DIVIDE
	 MUY=JMS I (XMUL)	/JUMP TO THE MULTIPLY ROUTINE>

	XLIST	ON

/THE FOLLOWING ROUTINE IS USED TO ROTATE THE X AND Y VALUES ACCORDING TO THE
/CHOSEN ANGLE
/THE X VALUE TO BE ROTATED IS IN THE AC AND THE Y IS IN THE <MQ>
/THE ROTATED X VALUE WILL BE RETURNED IN THE <AC> AND THE Y IN THE <MQ>

ROTATE,	.-.			/HEADER
	DCA	ROTX		/STORE THE X VALE TO ROTATE
	SWP			/GET THE Y VALUE
	DCA	ROTY		/STORE IT
	TAD I	ROTATE		/GET X CENTER AROUND WHICH THE
	DCA	XROTOF		/POINT IS TO BE ROTATED
	ISZ	ROTATE		/INCREMENT POINTER
	TAD I	ROTATE		/GET Y CENTER AROUND WHICH THE
	DCA	YROTOF		/POINT IS TO BE ROTATED
	ISZ	ROTATE		/INCREMENT POINTER
	TAD I	ROTATE		/GET SINE OF THE ANGLE TO
	DCA	SINROT		/ROTATE THE POINT
	ISZ	ROTATE		/INCREMENT THE POINTER
	TAD I	ROTATE		/GET THE COSINE OF THE ANGLE 
	DCA	COSROT		/TO ROTATE THE POINT
	ISZ	ROTATE		/SET RETURN ADDRESS
	TAD	COSSKP		/GET THE COSINE SKIP FLAG
	DCA	COSKP1		/STORE IT FOR A LATER SKIP
	TAD	COSSKP		/GET THE FLAG AGAIN
	DCA	COSKP2		/STORE AS A LATER SKIP
	TAD	SINSKP		/GET THE SININE SKIP FLAG
	DCA	SNSKP1		/STORE IT FOR A LATER SKIP
	TAD	SINSKP		/GET THE FLAG AGAIN
	DCA	SNSKP2		/STORE AS A LATER SKIP
	TAD	YROTOF		/GET Y OFFSET
	CIA			/MAKE IT MINUS
	TAD	ROTY		/ADD Y VALUE
	DCA	ROTY		/RESTORE IT
	TAD	XROTOF		/GET OFFSET
	CIA			/MAKE IT MINUS
	TAD	ROTX		/ADD THE X VALUE TO ROTATE
	DCA	ROTX		/STORE IT
	TAD	ROTX		/GET IT BACK
	SPA			/IF ROTX IS NEGATIVE
	CIA			/THEN MAKE IT POSITIVE
	MQL			/LOAD THE MQ
	IFNZRO	DECMATE <
	CIF	CDFL1		/CHANGE TO FIELD WHERE EAE SIMULATION IS
	>
	MUY			/MULTIPLY BY
COSROT,	7777			/THE COSINE OF THETA
	JMS I	(PTCHK)		/CHECK FOR ACCURACY
	ISZ	COSKP1		/IF SKP = -1
	CIA			/THEN 2'S COMPLEMENT THE ANSWER
	MQL			/PUT ANSWER IN MQ
	TAD	ROTX		/GET THE ORIGINAL X VALUE
	JMS	ROTSIN		/JUMP TO CHECK THE SIGN OF ROTX
	DCA	ROTMP1		/STORE RETURNED ANSWER
	TAD	ROTY		/GET THE Y VALUE
	SPA			/IF ROTY IS NEGATIVE
	CIA			/THEN MAKE IT POSITIVE
	MQL			/LOAD THE MQ
	IFNZRO	DECMATE <
	CIF	CDFL1		/CHANGE TO FIELD WHERE EAE SIMULATION IS
	>
	MUY			/AND MULTIPLY BY
SINROT,	0000			/THE SINE OF THETA
	JMS I	(PTCHK)		/CHECK FOR ACCURACY
	ISZ	SNSKP1		/IF SKP = -1
	CIA			/THEN 2'S COMPLEMENT THE ANSWER
	MQL			/PUT ANSWER IN MQ
	TAD	ROTY		/PUT ROTY IN AC
	JMS	ROTSIN		/CHECK THE SIGN OF THE ANSWER
	TAD	ROTMP1		/ADD X*COS TO RETURNED ANSWER
	DCA	ROTMP2		/AND STORE IT
	TAD	SINROT		/GET THE SINE OF THETA
	DCA	SINRT2		/PLACE IT 7 WORDS AHEAD
	TAD	ROTX		/GET THE X VALUE TO ROTATE
	SPA			/IF ROTX IS NEGATIVE
	CIA			/THEN MAKE IT POSITIVE
	MQL			/LOAD IT INTO THE MQ
	IFNZRO	DECMATE <
	CIF	CDFL1		/CHANGE TO FIELD WHERE EAE SIMULATION IS
	>
	MUY			/MULTIPLY BY THE
SINRT2,	.-.			/SINE OF THETA
	JMS I	(PTCHK)		/CHECK FOR ACCURACY
	CIA			/MAKE THE ANSWER NEGATIVE
	ISZ	SNSKP2		/IF SKP = -1
	CIA			/THEN 2'S COMPLEMENT THE ANSWER
	MQL			/PUT ANSWER IN MQ
	TAD	ROTX		/GET ORIGINAL X VALUE
	JMS	ROTSIN		/JUMP TO CHECK THE SIGN OF THE ANSWER
	DCA	ROTMP1		/STORE RETURNED ANSWER
	TAD	COSROT		/GET THE COSINE OF THETA

	DCA	COSRT2		/STORE IT 7 WORDS AHEAD
	TAD	ROTY		/GET THE Y VALUE TO ROTATE
	SPA			/IF ROTY IS NEGATIVE
	CIA			/THEN MAKE IT POSITIVE
	MQL			/LOAD THE MQ
	IFNZRO	DECMATE <
	CIF	CDFL1		/CHANGE TO FIELD WHERE EAE SIMULATION IS
	>
	MUY			/MULTIPLY BY
COSRT2,	.-.			/THE COSINE OF THETA
	JMS I	(PTCHK)		/CHECK FOR ACCURACY
	ISZ	COSKP2		/IF SKP = -1
	CIA			/THEN 2'S COMPLEMENT THE ANSWER
	MQL			/PUT ANSWER INTO MQ
	TAD	ROTY		/GET ORIGINAL Y VALUE
	JMS	ROTSIN		/JUMP TO CHECK THE SIGN OF THE ANSWER
	TAD	ROTMP1		/ADD -X*SINE
	TAD	YROTOF		/ADD Y OFFSET BACK
	MQL			/PUT IT INTO THE MQ
	TAD	ROTMP2		/PUT ROTATED X VALUE IN <AC>
	TAD	XROTOF		/ADD X OFFSET BACK
	JMP I	ROTATE		/RETURN
ROTMP1,	.-.			/ROTATE TEMPORARY
ROTMP2,	.-.			/ROTATE TEMPORARY
ROTX,	.-.			/ORIGINAL X VALUE TO ROTATE
ROTY,	.-.			/ORIGINAL Y VALUE TO ROTATE
XROTOF,	.-.			/OFFSET TO CENTER
YROTOF,	.-.			/OFFSET TO CENTER
COSSKP,	.-.			/SKIP FLAG FOR COSINE
COSKP1,	.-.			/SKIP FLAG 1
COSKP2,	.-.			/SKIP FLAG 2
SINSKP,	.-.			/SKIP FLAG FOR SINE
SNSKP1,	.-.			/SKIP FLAG 1
SNSKP2,	.-.			/SKIP FLAG 2

/THE FOLLOWING ROUTINE RECEIVES PARAMETERS IN THE AC AND MQ
/IF THE VALUE IN THE AC IS NEGATIVE, THE VALUE IN THE MQ IS MADE NEGATIVE
/ELSE IT IS LEFT ALONE.
/UPON RETURNING, THE ALTERED, OR UNALTERED, VALUE IN THE AC AND MQ ARE SWAPPED

ROTSIN,	.-.			/HEADER
	SMA			/IF <AC> IS POSITIVE
	JMP	OUTROT		/THEN JUMP TO LEAVE
	SWP			/ELSE GET MQ
	CIA			/COMPLEMENT AND INCREMENT
	SKP			/SKIP NEXT INSTRUCTION TO RETURN
OUTROT,	SWP			/SWAP <AC> AND <MQ>
	JMP I	ROTSIN		/RETURN


