/ THIS SUBROUTINE FORMULATES THE FIELD, WORD AND BIT NUMBERS
/ WHICH CORRESPOND TO THE GIVEN X AND Y COORDINATES.

	XLIST	OFF


	IFZERO	EAE	<
/EAE SIMULATION DEFINITIONS
	MUY=JMS I (XMUL)	/CALL TO MULTIPLY ROUTINE
	DVI=JMS I (XDVI)	/CALL DIVIDE ROUTINE>

	XLIST	ON

GRPHPN,	.-.		
	CDF	YFLD		/CHANGE TO Y DATA FIELD.
	TAD I	XR1		/READ NEXT Y COORDINATE.
	TAD	(ORDOFFS)	/Y + ORDINATE OFFSET.
	CDF	CDFL0		/CHANGE TO CODING FIELD
	MQL			/LOAD MQ.

	MQA			/GET IT BACK INTO AC
	TAD	(-ORDPNT)	/SUBTRACT MAXIMUM ORDINATE
	SMA CLA			/IF LESS THAN MAX THEN SKIP AND CONTINUE
	JMP	ERRORY		/ELSE GO TO ORDINATE OVERFLOW ERROR

	IFNZRO	DECMATE <
	CIF 	CDFL1		/CHANGE TO FIELD WHERE EAE IS LOCATED
	>
	DVI ;	14		/DIVIDE BY 12 TO FIND WORD AND BIT NUM
	DCA	DSBIT
	SWP
	DCA	GRPHTM
	CDF	XFLD		/CHANGE TO X DATA FIELD.
	TAD I	XR2		/READ IN NEXT X COORDINATE.
	TAD	(ABSOFFS)	/X + ABS OFFSET.
	CDF	CDFL0		/CHANGE TO CODING FIELD
	MQL			/GET X POSITION INTO <MQ>

	MQA			/GET IT BACK INTO <AC>
	TAD	(-ABSPNT)	/COMPARE TO MAXIMUM ABSCISSA
	SMA CLA			/IF NO OVERFLOW THEN SKIP AND CONTINUE
	JMP	ERRORX		/ELSE INDICATE ABSCISSANT OVERFLOW

	IFNZRO	DECMATE <
	CIF 	CDFL1		/CHANGE TO FIELD WHERE EAE IS LOCATED
	>
	MUY;	ORDWRD		/(X + ABSOFFS) * ORDINATE WORD.
	SWP	;CLL		/SWAP MQ AND AC AND CLEAR L.
	TAD	GRPHTM		/ADD (Y + ORDOFFS).
	SWP			/SWAP AGAIN. 
	SZL			/IF LINK NOT 0 THEN ADD 1 TO FIELD.
	IAC
	DCA	DSPFLD		/STORE DISPLAY FIELD.
	SWP
	DCA	DSPWRD		/STORE DISPLAY WORD.
	JMP I	GRPHPN 		/RETURN.
DSBIT,	.-.			/HOLDS THE BIT NUMBER TO BE DISPLAYED

DSPWRD,	.-.			/WORD AND BIT NUMBER OF (X,Y).
DSPFLD,	.-.			/FIELD NUMBER OF (X,Y).
GRPHTM,	.-.			/TEMPORARY


/INDICATE AN ERROR IN THE X VALUE

ERRORX,	CDF	MESFLD		/CHANGE TO THE MESSAGE FIELD
	TAD	(XMES)		/GET THE ADDRESS OF THE X ERROR MESSAGE
	CDF	CDFL0		/CHANGE BACK TO THE CODING FIELD
	DCA I	(MESTMP)	/STORIE FOR THE MESSAGE PRINTING ROUTINE
	JMS I	(MESPRN)	/JUMP TO PRINT THE X ERROR MESSAGE
	JMP I	(CHKANS)	/JUMP TO CHECK RESPONSE TO CONTINUE QUESTION

/INDICATE AN ERROR IN THE Y VALUE

ERRORY,	CDF	MESFLD		/CHANGE TO THE MESSAGE FIELD
	TAD	(YMES)		/GET THE ADDRESS OF THE Y ERROR MESSAGE
	CDF	CDFL0		/CHANGE BACK TO THE CODING FIELD
	DCA I	(MESTMP)	/STORE IT FOR THE MESSAGE PRINTING ROUTINE
	JMS I	(MESPRN)	/JUMP TO PRINT THE Y ERROR MESSAGE
	JMP I	(CHKANS)	/JUMP TO CHECK RESPONSE TO CONTINUE QUESTION

/ROUTINE TO ASK IF THE PROGRAM SHOULD CONTINUE TO PROCESS THE POINTS OR END

CHKANS,	CDF	MESFLD		/CHANGE TO MESSAGE FIELD
	TAD	(CONMES)	/GET ADDRESS OF CONTINUE MESSAGE
	CDF	CDFL0		/CHANGE TO CODING FIELD
	DCA I	(MESTMP)	/STORE IT FOR THE MESSAGE PRINTING ROUTINE
	JMS I	(MESPRN)	/JUMP TO PRINT MESSAGE ON CONSOLE
	JMS I	(KB)		/JUMP TO KEYBOARD ROUTINE
	TAD I	(NEGY)		/ADD MINUS Y TO THE <AC>
	SZA			/IS IT ZERO?
	JMP I	(7600)		/NO->DO NOT CONTINUE
	JMP I	GRPHPN		/RETURN TO GET THE NEXT POINT TO PROCESS
NEGY,	7647			/-ASCII CODE FOR A Y

