/SUBROUTINE TO STORE THE DATA IN FIELDS 3,4,5, AND 6 ONTO A DISK

SAVIO,	.-.			/SUBROUTINE HEADER
/WRITE FIELD 5 ONTO THE DISK
	TAD	(BUFSIZ^100+FDBUF1+UNIT)	/I/O FUNCTION DEFINITION
	DCA	IOFUN		/STORE THE DEFINITION IN THE FUNCTION
	JMS	IOCALL		/JUMP TO WRITE THE DATA ONTO THE DISK
/WRITE FIELD 6 ONTO THE DISK
	TAD	(BUFSIZ^100+FDBUF2+UNIT)	/I/O FUNCTION DEFINITION
	DCA	IOFUN		/STORE THE DEFINITION IN THE FUNCTION
	JMS	IOCALL		/JUMP TO WRITE THE DATA ONTO THE DISK
	JMP I	SAVIO		/RETURN TO PROCESS MORE DATA
FLDADD,		0000		/ADDRESS OF THE FIELD TABLE
				/ITEMS IN THE FIELD TO BE UPDATED

/ROUTINE WHICH READS THE BIT MAP FROM DISK AND STORES IT IN FIELDS
/5 AND 6.

READIO,.-.			/SUBROUTINE HEADER
	CLA			/CLEAN UP AC
	TAD I	(BLKNUM)	/GET PRESENT BLOCK NUMBER VALUE
	DCA	BLKTMP		/STORE IT TEMPORARILY
/READ IN BIT MAP INTO FIELD 5
	TAD	(FDBUF1+UNIT)	/I/O FUNCTION DEFINITION
	DCA	IOFUN		/STORE THE DEFINITION IN THE FUNCTION
	JMS	IOCALL		/JUMP TO READ THE DATA FROM THE DISK
/READ IN BIT MAP INTO FIELD 6
	TAD	(FDBUF2+UNIT)	/I/O FUNCTION DEFINITION
	DCA	IOFUN		/STORE THE DEFINITION IN THE FUNCTION
	JMS	IOCALL		/JUMP TO READ THE DATA FROM THE DISK
	TAD	BLKTMP		/GET ORIGINAL CONTENTS OF BLKNUM
	DCA	BLKNUM		/RESTORE IT
	JMP I	READIO		/RETURN TO CALLING
BLKTMP,	.-.			/TEMPORARY STORAGE FOR ORIGINAL BLOCK NUMBER

/ROUTINE WHICH CALLS THE INPUT-OUTPUT ROUTINE

IOCALL,	.-.			/SUBROUTINE HEADER
	CLA
	TAD	BLKNUM		/GET THE CONTENTS OF BLKNUM
	TAD	(BUFSIZ)	/INCREMENT BY 40 BECAUSE EACH TIME THE
				/I/O ROUTINE WRITES 40 BLOCKS OF DATA
				/ONTO THE DISK
	DCA	BLKNUM		/RESTORE BLKNUM
	JMS I	(SYSIO)		/JUMP TO THE I/O ROUTINE WHICH WILL
				/PERFORM THE JOB DEFINED IN IOFUN
IOTRN,	.-.			/THE ADDRESS IN MEMORY WHERE THE
				/PROGRAM WILL WRITE FROM
IOFUN,	.-.			/I/O FUNCTION DEFINTION THAT TELLS
				/THE I/O ROUTINES WHAT TO DO
BLKNUM,	-40			/INITIAL BLOCK NUMBER SETTING
	JMP I	IOCALL		/RETURN TO SAVIO IN ORDER TO RESET THE

/ROUTINE WHICH INITIALIZES THE AUTO INDEX REGISTERS AND COUNTERS

AUTOSET,.-.			/SUBROUTINE HEADER
	CDF	XFLD		/CHANGE TO X DATA FIELD
	TAD I	(XFLPNCN)	/GET THE NUMBER OF POINTS THAT WERE PROCESSED
	CDF	CDFL0		/CHANGE TO THE CODING FIELD
	TAD	(XPNSTR-1)	/ADD Y COORDINATE POINTER
	TAD I	(SYMPTS)	/ADD THE NUMBER OF SYMBOL BUFFER POINTS
	DCA	XR1		/PUT INTO AUTO INDEX REGISTER
	CDF	XFLD		/CHANGE TO X DATA FIELD
	TAD I	(XFLPNCN)	/GET THE NUMBER OF POINTS THAT WERE PROCESSED
	CDF	CDFL0		/CHANGE TO CODING FIELD
	TAD	(XPNSTR-1)	/ADD THE START OF WHERE POINTS ARE
	TAD I	(SYMPTS)	/ADD THE NUMBER OF SYMBOL BUFFER POINTS
	DCA	XR2		/STORE IN ANOTHER AUTO INDEX REG
	JMP I	AUTOSET		/RETURN TO CALLING ROUTINE

/ROUTINE FOR CLEARING BUFFER FIELDS

CLRFLDS,.-.			/SUBROUTINE HEADER
	CLA
	TAD	(FLDBUF-10)	/SET UP POINTER TO THE
	DCA	FLDNUM		/FIELD TO BE ZEROED
	TAD	(-FLDUTL)	/SET UP LOOP COUNTER TO -FLDUTL WHICH
	DCA	FLDCTR		/IS THE NUMBER OF FIELDS TO ZERO
PIKFLD,	CDF	CDFL0
	TAD	FLDNUM		/GET OFFSET PTR TO FIELD TO BE ZEROED
	TAD	(10)		/ADD 10 TO POINT TO NEXT FIELD
	DCA	FLDNUM		/SAVE NEW OFFSET POINTER
	TAD	(CDF	0)	/GET 6201 -> POINTER TO FIELD 0
	TAD	FLDNUM		/ADD OFFSET 
	DCA	.+1		/SAVE FIELD CHANGE IN NEXT ADDRESS
ZEROFLD,	.-.		/TO BE EXECUTED
	NL7777			/INITIALIZE AUTO INDEX REGISTER TO
	DCA	XR3		/REFERENCE LOCATIONS TO BE ZEROED
	DCA	XR4		/INITIALIZE AUTO INDEX REGISTER TO
				/COUNT THE NUMBER OF LOCATIONS TO ZERO
CLRLUP, DCA I	XR3		/STORE A ZERO IN THE LOCATION IN XR3
	ISZ	XR4		/IF XR4 NOT = 0 THEN CONTINUE
	JMP	CLRLUP		/ZEROING THE FIELD
	CDF	CDFL0		/GET BACK TO CODING FIELD
	ISZ	FLDCTR		/ELSE IF FLDCTR NOT = 0
	JMP	PIKFLD		/THEN THERE ARE MORE FIELDS TO ZERO
	JMP I	CLRFLDS		/ELSE THE FIELDS ARE ALL ZERO AND
				/RETURN TO THE CALLING PROGRAM
FLDNUM,		.-.		/OFFSET USED TO INCREMENT 6201 TO THE
				/CORRECT FIELD TO CHANGE TO
FLDCTR,		.-.		/HOLDS THE NUMBER OF FIELDS TO ZERO

/ROUTINE WHICH ADDS THE CONTENTS OF <AC> TO THE FIELD TABLE VALUES

TABSET,	.-.			/SUBROUTINE HEADER
	DCA	TABTMP		/STORE <AC> TEMPORARILY
	TAD	(FLDTAB)	/GET THE ADDRESS OF THE FIELD TABLE
	DCA	TABPNT		/STORE IT IN TABLE POINTER
	TAD	(-FLDUTL+1)	/GET NUMBER OF FIELDS -1
	DCA 	TABCNT		/STORE IN COUNTER
	TAD	TABTMP		/GET BACK TEMPORARY
	TAD I	TABPNT		/ADD PRESENT TABLE VALUE
	DCA I	TABPNT		/STORE BACK INTO TABLE VALUE

TABLP,	TAD I	TABPNT		/GET THE TABLE VALUE
	IAC			/INCREMENT BY 1
	ISZ	TABPNT		/MOVE POINTER TO NEXT TABLE POSITION
	DCA I	TABPNT		/STORE VALUE THERE
	ISZ	TABCNT		/IF ALL FIELDS ARE DONE THEN SKIP
	JMP	TABLP		/ELSE JUMP BACK AND DO MORE
	ISZ	TABPNT		/MOVE UP TABLE POINTER
	NL7777			/GET END OF TABLE CODE
	DCA I	TABPNT		/STORE IT
	TAD I	(READFL)	/SHOULD THE FIELDS BE READ INTO MEMORY FIRST?
	SZA
	JMS I	(READIO)	/YES->JMP TO READING ROUTINE
	JMP I	TABSET		/RETURN TO CALLING ROUTINE

TABPNT,	.-.			/POINTER TO THE FIELD TABLE
TABCNT,	.-.			/TABLE POINTER COUNT
TABTMP,	.-.			/TEMPORARY

FLDTAB,		0		/0 - 37.
		1		/40 - 77.
		2		/100 - 137.
		7777		/END OF LIST

