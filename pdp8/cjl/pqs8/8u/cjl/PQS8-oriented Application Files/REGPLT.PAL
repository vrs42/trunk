/ROUTINE CALLED TO SET THE DISPLAY CELL SIZES

DSPSET,	TAD I	(OPTPAR)	/GET OPTION
/	JMS I	(PRCHAR)	/PRINT IT
/	TAD	(DCA I	[CELTM1])	/GET INSTRUCTION TO STORE PARAMETER
/	DCA I	(PARM1)		/STORE IT
/	TAD	(DCA I	[CELTM2])	/GET INSTRUCTION TO STORE PARAMETER
/	DCA I	(PARM2)		/STORE IT

/	JMS I	(GETPAR)	/JUMP TO GET THE PARAMETERS OF D OPTION
/	TAD	CELTM1		/GET THE FIRST PARAMETER
/	ISZ 	XPARMF		/IF THERE WAS A FIRST PARAMETER
/	DCA I	(DSPWID)	/THEN STORE IT
/	CLA			/ELSE DISCARD CELTM1
/	TAD	CELTM2		/GET THE SECOND PARAMETER
/	CIA			/DO 2'S COMPLEMENT BECAUSE OF GETPAR
/	ISZ 	YPARMF		/IF THERE WAS A SECOND PARAMETER
/	DCA I	(DSPHGT)	/THEN STORE IT AS THE DISPLAY CELL HEIGHT
/	CLA			/ELSE DISCARD IT
/ENDDIS,JMS I	(CHUZIN)	/GET THE NEXT CHARACTER IN THE OPTION
/	DCA I	(OPTPAR)	/STORE IT
/	TAD I	(OPTPAR)	/GET IT BACK
/	JMS I 	(PRCHAR)	/PRINT IT
/	TAD I	(OPTPAR)	/GET THE PARAMETER BACK
/	TAD	(-ENDPAR)	/SUBTRACT ) ASCII CODE
/	SNA CLA			/IF NEXT CHARACTER = )
/	JMS I	(CORMIS)	/CORRECT MISTAKE
/	JMP	ENDDIS		/TRY AGAIN
/	JMP I	(GTNXCD)	/JUMP TO GET AND PROCESS THE NEXT COMMAND
CELTM1,	.-.			/CELL TEMP 1
CELTM2,	.-.			/CELL TEMP 2


/THE FOLLOWING IS CALLED TO CHANGE THE UNIT CELL SIZE

UNTSET,	JMS I	(CHUZIN)	/GET THE NEXT CHARACTER
	DCA I	(OPTPAR)	/STORE IT
	TAD I	(OPTPAR)	/GET IT BACK
	JMS I 	(PRCHAR)	/PRINT IT
	TAD I	(OPTPAR)	/GET THE PARAMETER BACK
	TAD	(-BEGBRC)	/SUBTRACT [ ASCII CODE
	SNA CLA			/IF NEXT CHARACTER = [
	JMS I	(CORMIS)	/CORRECT MISTAKE
	JMP	UNTSET		/TRY AGAIN
	TAD	(DCA I	[CELTM1])	/GET INSTRUCTION TO STORE PARAMETER
	DCA I	(PARM1)		/STORE IT
	TAD	(DCA I	[CELTM2])	/GET INSTRUCTION TO STORE PARAMETER
	DCA I	(PARM2)		/STORE IT

	JMS I	(GETPAR)	/JUMP TO GET THE PARAMETERS OF D OPTION
	TAD	CELTM1		/GET THE FIRST PARAMETER
	ISZ 	XPARMF		/IF THERE WAS A FIRST PARAMETER
	DCA I	(FONTWID)	/THEN STORE IT
	CLA			/ELSE DISCARD CELTM1
	TAD	CELTM2		/GET THE SECOND PARAMETER
	CIA			/DO 2'S COMPLEMENT BECAUSE OF GETPAR
	ISZ 	YPARMF		/IF THERE WAS A SECOND PARAMETER
	DCA I	(FONTLEN)	/THEN STORE IT AS THE UNIT CELL HEIGHT
	CLA			/ELSE DISCARD IT
ENDUNT,	JMS I	(CHUZIN)	/GET THE NEXT CHARACTER IN THE OPTION
	DCA I	(OPTPAR)	/STORE IT
	TAD I	(OPTPAR)	/GET IT BACK
	JMS I 	(PRCHAR)	/PRINT IT
	TAD I	(OPTPAR)	/GET THE PARAMETER BACK
	TAD	(-ENDPAR)	/SUBTRACT ) ASCII CODE
	SNA CLA			/IF NEXT CHARACTER = )
	JMP I	(GTNXCD)	/JUMP TO GET AND PROCESS THE NEXT COMMAND
	JMS I	(CORMIS)	/CORRECT MISTAKE
	JMP	ENDUNT		/TRY AGAIN


/THE FOLLOWING ROUTINE IS CALLED WHEN THE USER WANTS TO ROTATE 
/THE CHARACTER OR A STRING OF CHARACTERS ON THE BIT MAP

/THE COMMAND IS STRUCTURED AS FOLLOWS:
/  T(D<ANG>,S<0-16>,D<ANG>)

ROTSTR,	TAD	(-COMMAC)	/GET - COMMAC ASCII CODE
	DCA I	(REACH1)	/STORE AS REANUM'S FIRST END CODE
	TAD	(-ENDPAR)	/GET - END PAREN ASCII CODE
	DCA I	(REACH2)	/STORE AS REANUM'S SECOND END CODE
	JMS I	(REANUM)	/JUMP TO GET THE ROTATION STRING ANGLE
	JMS I	(SNCSET)	/JUMP TO SET THE SINE AND COSINE VALUES
	DCA I	(SINSTR)	/SINE OF THE ANGLE IS IN THE AC
	SWP			/THE COSINE OF THE ANGLE IS IN
	DCA I	(COSSTR)	/THE MQ
	TAD I	(SINSTR)	/GET THE SINE OF THE ANGLE
	DCA I	(CHRTSN)	/STORE AS CHARACTER ROTATION ANGLE
	TAD I	(COSSTR)	/GET COSINE OF THE ANGLE
	DCA I	(CHRTCS)	/STORE AS CHARACTER ROTATION ANGLE
	TAD	(-CR)		/GET - CR ASCII CODE
	DCA I	(REACH1)	/STORE AS REANUM END CODE
	TAD	(-CR)		/GET -CR ASCII CODE
	DCA I	(REACH2)	/STORE AS REANUM'S END CODE
	TAD I	(REATMP)	/GET REANUM'S LAST INPUT CHARACTER
	TAD	(-ENDPAR)	/SUBTRACT END PAREN ASCII CODE
	SNA CLA			/IF REATMP = ENDPAR
	JMP I	(GTNXCD)	/THEN JUMP TO GET THE NEXT COMMAND
FNDROT,	JMS I	(CHUZIN)	/GET THE NEXT CHARACTER OF THE COMMAND STRING
	DCA	STRTMP		/STORE IN TEMP
	TAD	STRTMP		/GET THE CHARACTER BACK
	JMS I	(PRCHAR)	/PRINT IT
	TAD	STRTMP		/GET THE CHARACTER BACK
	TAD	(-SASCII)	/SUBTRACT S ASCII CODE
	SNA CLA			/IF STRTMP = S
	JMP I	(CELSIZ)	/JUMP TO SET THE CHARACTER SIZES
	TAD	STRTMP		/ELSE GET THE CHARACTER BACK
	TAD	(-LSASCI)	/SUBTRACT LOWERCASE S ASCII
	SNA CLA			/IS STRTMP = LOWERCASE S
	JMP I	(CELSIZ)	/THEN SET THE CHARACTER SIZES
	TAD	STRTMP		/GET THE CHARACTER AGAIN
	TAD	(-COMMAC)	/SUBTRACT COMMAC CODE
	SNA CLA			/IF STRTMP = COMMA
	JMP I	(CHRANG)	/THEN JUMP TO SET CHARACTER ANGLE
	JMS I	(CORMIS)	/CORRECT MISTAKE
	JMP	FNDROT		/TRY AGAIN

STRTMP,	.-.			/TEMPORARY

	PAGE

/THE FOLLOWING ROUTINE HANDLES THE COMMAND FOR DETERMINING THE ANGLE
/OF EACH CHARACTER

CHRANG,	JMS I	(CHUZIN)	/JUMP TO GET THE NEXT CHARACTER
	DCA	ANGTMP		/STORE IT TEMPORARILY
	TAD	ANGTMP		/GET ANGLE TEMP
	JMS I	(PRCHAR)	/PRINT IT
	TAD	ANGTMP		/GET THE CHARACTER BACK
	TAD	(-DASCII)	/SUBTRACT D ASCII CODE
	SNA CLA			/IF ANGTMP = D
	JMP	.+5		/THEN JUMP AHEAD
	TAD	ANGTMP		/ELSE GET THE CHARACTER BACK
	TAD	(-LDASCI)	/SUBTRACT LOWERCASE D ASCII
	SZA			/IF ANGTMP <> LOWERCASE D
	HLT			/HALT FOR NOW
	TAD	(-ENDPAR)	/ELSE GET - END AREN ASCII CODE
	DCA I	(REACH1)	/STORE A REANUM END CODE
	TAD	(-ENDPAR)	/GET - END PAREN ASCII CODE
	DCA I	(REACH2)	/STORE AS REANUM END CODE
	JMS I	(REANUM)	/JUMP TO GET THE CHARACTER ANGLE
	JMS I	(SNCSET)	/JUMP TO GET THE SINE AND COSINE OF THE ANGLE
	DCA I	(CHRTSN)	/STORE THE SINE OF THE ANGLE FROM THE <AC>
	SWP			/GET THE COSINE OF THE ANGLE FROM THE <MQ>
	DCA I	(CHRTCS)	/AND STORE IT
	TAD	(-CR)		/GET - CR ASCII CODE
	DCA I	(REACH1)	/STORE AS REANUM END CODE
	TAD	(-CR)		/GET - CR ASCII CODE
	DCA I	(REACH2)	/STORE AS REANUM END CODE
	JMP I	(GTNXCD)	/JUMP TO GET NEXT COMMAND SEQUENCE
ANGTMP,	.-.			/TEMPORARY FOR CHRANG
CHRTSN,	.-.			/SINE OF ANGLE
CHRTCS,	.-.			/COSINE OF ANGLE


	XLIST OFF
	IFZERO EAE<

	/EAE SIMULATION DEFINITIONS

	DVI=JMS I (XDVI)	/DIVIDE

>
	XLIST ON

/THE FOLLWING ROUTINE CONVERTS THE ANGLE IN THE <AC> INTO ITS
/RESPECTIVE SINE AND COSINE VALUES
/THE SINE OF THE ANGLE WILL BE IN THE <AC> AND THE COSINE IN THE <MQ>

SNCSET,	.-.			/HEADER
	MQL			/LOAD ANGLE INTO THE <MQ>
	IFNZRO	DECMATE<
	CIF	CDFL1		/CHANGE TO FIELD WHERE EAE IS
>
	DVI			/AND DIVIDE
	55			/BY 45 (BASE 10)
	IFNZRO	DECMATE<
	CIF	CDFL1		/CHANGE TO WHERE EAE IS
>
	DVI			/DIVIDE THE ANSWER
	10			/BY 8 (BASE 10)
	DCA	ANGPTR		/STORE REMAINDER AS THE TABLE POINTER
	TAD	(CSSINTB)	/GET ADDRESS OF COSINE SIGN TABLE
	TAD	ANGPTR		/ADD OFFSET
	DCA	SETMP		/STORE AS ADDRESS OF NEEDED COSINE SIGN
	TAD I	SETMP		/GET THE VALUE FROM THE TABLE
	DCA I	(COSSKP)	/STORE A COSINE SKIP FLAG
	TAD	(SNSINTB)	/GET ADDRESS OF SINE SIGN TABLE
	TAD	ANGPTR		/ADD OFFSET
	DCA	SETMP		/STORE AS ADDRESS OF NEEDED SINE SIGN
	TAD I	SETMP		/GET THE VALUE FROM THE TABLE
	DCA I	(SINSKP)	/STORE A SINE SKIP FLAG
	TAD	(CSROTB)	/GET THE ADDRESS OF THE COSINE ROTATION TABLE
	TAD	ANGPTR		/ADD THE POINTER VALUE
	DCA	SETMP		/STORE AS THE ADDRESS OF THE COSINE OF THE ANGLE
	TAD I	SETMP		/GET THE CONTENTS POINTED TO BY SETMP
	MQL			/PUT IT INTO THE <MQ>
	TAD	(SNROTB)	/GET THE ADDRESS OF THE SINE ROTATION TABLE
	TAD	ANGPTR		/ADD THE POINTER VALUE
	DCA	SETMP		/STORE AS THE ADDRESS OF THE SINE OF THE ANGLE
	TAD I	SETMP		/GET THE CONTENTS POINTED TO BY SETMP
	JMP I	SNCSET		/RETURN WITH THE SINE IN THE <AC> AND COSINE IN <MQ>
ANGPTR,	.-.			/ANGLE TABLE POINTER
SETMP,	.-.			/TEMPORARY

/THE FOLLOWING ARE THE SINE AND COSINE TABLES USED BY SNCSET TO
/GET THE CORRECT SINE AND COSINE OF TH ANGLE

CSROTB,	7777
;	5516;	0000;	5516;	7777;	5516;	0000;	5516
SNROTB,	0000;	5516;	7777;	5516;	0000;	5516;	7777;	5516;
	FIELD 1
	PAGE 1
	XLIST	OFF
	IFZERO	EAE	<
	XLIST	ON

/EAE SIMULATION FOR THE PDP 8/E
/MODE A AND B OPERATION
/THE FOLLOWING FUNCTIONS ARE IMPLEMENTED
/SWAB,SWBA,MUY,DVI,DAD,DCM,SHL,SHR,ROTL,ROTR

/SWITCH FROM MODE A TO MODE B

XSWAB,	.-.			/SUBROUTINE HEADER
	CLA			/CLEAN UP
	TAD	XSWAB		/GET THE REURN ADDRESS
	DCA	RETADD		/STORE IT FOR GENERAL RETURN
	JMS	SAVFLD		/JUMP TO SAVE THE FIELD TO RETURN TO
	TAD	(TAD I	XDCM)	/GET THE INDIRECT INSTRUCTION
SWBAENT,DCA	XMMODE		/STORE IN MODE WORD
	TAD	XMMODE		/GET MUL WORD MODE
	DCA	XDMODE		/STORE IN DIV WORD MODE
	JMP	SIMEXT		/JUMP TO GENERAL RETURNING ROUTINE

/SWITCH FROM MODE B TO MODE A
XSWBA,	.-.			/SUBROUTINE HEADER
	CLA			/CLEAN UP
	TAD	XSWBA		/GET RETURN ADDRESS
	DCA	RETADD		/STORE IT
	JMS	SAVFLD		/SAVE RETURN FIELD
	TAD	(TAD	XDCM)	/GET THE GET INSTRUCTION
	JMP	SWBAENT		/FINISH THERE
XMUL,	.-.			/MULTIPLY SUBROUTINE
	CLA CLL			/CLEAN UP
	TAD	XMUL		/GET THE RETURN ADDRESS
	DCA	RETADD		/STORE IT AS THE RETURN ADDRESS
	JMS	SAVFLD		/JUMP TO SAVE THE FIELD FROM WHICH WE CAME
	TAD	(-15)		/SET UP
	DCA	ROTL		/USE ROTL AS STEP COUNT
	TAD I	XMUL		/GET ARGUMENT
	DCA	XDCM		/STORE TEMPORARILY
XMROT,	JMS	ROTR		/ROTATE RIGHT
	ISZ	ROTL		/COUNT STEPS(INIT STPCNT=-13
	SKP
	JMP	XMULFIN		/FINISH THERE
	SNL			/LOW ORDER BIT=1?
	JMP	XMROT		/NO,ROTATE AGAIN
	CLL			/CLEAR LINK
XMMODE,	TAD	XDCM		/***TAD I	XDCM***
	JMP	XMROT		/GET NEXT BIT OF MULTIPLICAND
XMULFIN,ISZ 	RETADD		/GET THE NEXT WORD
	JMP	SIMEXT		/JUMP TO RETURN TO THE CALLER

ROTR,	.-.			/ROTATION SUBROUTINE
	RAR			/ROT AC
	SWP			/GET MQ
	RAR			/ROTATE IT
	SWP			/FINISH ROT RIGHT
	JMP I	ROTR		/WITH LOW BIT IN LINK

ROTL,	.-.			/ROT LEFT SUBROUTINE
	SWP			/GET MQ
	RAL			/ROTATE LEFT
	SWP			/GET BACK AC
	RAL			/ROTATE AGAIN
	JMP I	ROTL		/GET BACK TO CALLER

XDVI,	.-.			/EAE SIMULATED DIVIDE
	DCA	AC		/STORE HIGH DIVIDEND IN AC
	MQA			/GET MQ
	DCA	MQ		/STORE IN MQ
	TAD	XDVI		/GET RETURN ADDRESS
	DCA	RETADD		/AND STORE IT
	JMS	SAVFLD		/JUMP TO SAVE THE FIELD FROM WHICH WE CAME
	TAD I	XDVI		/GET ARGUMENT
	DCA	XDCM		/STORE THERE
XDMODE,	TAD	XDCM		/***TAD I	XDCM***
	CIA			/NEGATE IT
	DCA	MDVSOR		/STORE IT

/NOW CHECK FOR OVERFLOW

	TAD	AC		/GET BACK AC
	STL CMA			/SET LINK AND COMPLEMENT AC
	TAD I	XDVI		/ADD THE DIVISOR
	SNL CLA			/IF NO OVERFLOW THEN SKIP
	SKP			/ELSE SKIP AGAIN
	JMP	XDVOUT		/LEAVE ROUTINE WITH LINK SET IF OVERFLOW

/IF THERE IS NO OVERFLOW START DIVISION ALGORITHM

	TAD	(-14)		/GET -12
	DCA	SFTCNTR		/STORE AS SHIFT COUNTER
XDIVLP,	TAD	MQ		/GET THE MQ
	CLL RAL			/SHIFT 25 PLACES
	DCA	MQ		/TO THE
	TAD	AC		/LEFT
	RAL
	DCA 	AC
	TAD	AC		/GET BACK HIGH PART OF DIVIDEND
	TAD	MDVSOR		/ADD -THE DIVISOR
	SZL			/IF LINK IS ZERO, RESTORE BY LEAVING IT ALONE
	DCA	AC		/ELSE UPDATE THE DIVIDEND
	SZL CLA			/IF LINK WAS ZERO DON'T SET BIT IN LOW MQ
	ISZ	MQ		/ELSE DO SET THE BIT
	ISZ	SFTCNTR		/SKIP IF DONE TWELVE TIMES
	JMP	XDIVLP		/ELSE GO BACK AND DO MORE
	TAD	MQ
	MQL			/PUT QUOTIENT IN REAL MQ
	TAD	AC		/GET BACK REAL AC
XDVOUT,	ISZ 	RETADD		/GET THE NEXT WORD
	JMP	SIMEXT		/JUMP TO EXIT THE SIMULATION
AC,	.-.			/HOLDS AC VALUE
MQ,	.-.			/HOLDS MQ VALUE
MDVSOR,	.-.			/HOLDS MINUS THE DIVISOR
SFTCNTR,.-.			/HOLDS STEP COUNTER VALUE

XDCM,	.-.			/DOUBLE PREC. COMPL.
	SWP	
	CLL CMA IAC		/CLEAR LINK AND NEGATE
	SWP
	CMA			/COMPLEMENT <AC>
	SZL			/IF PREVIOUS CIA DIDN'T SET LINK THEN SKIP
	IAC			/ELSE ADD ONE
	JMP I	XDCM		/RETURN TO CALLER

XDAD,	.-.			/DOUBLE PRECISION ADD ROUTINE
	DCA	XDCM		/STORE <AC> TEMPORARILY
	TAD I	XDAD		/GET POINTER TO ARGUMENT
	DCA	XDVI		/STORE TEMPORARILY
	MQA			/GET LOW ORDER WORD
	CLL			/CLEAR LINK FOR 13 BIT ARITH
	TAD I	XDVI		/ADD LOW ORDER WORDS TOGETHER
	ISZ	XDVI		/POINT TO NEXT WORD
	MQL			/PUT RESULTS IN <MQ>
	TAD	XDCM		/GET BACK HIGH ORDER WORD
	SZL			/IF THE LINK WAS NOT SET THEN SKIP
	IAC			/ELSE INCREMENT BY 1
	TAD I	XDVI		/ADD HIGH ORDER ARGUMENT
	ISZ	XDAD		/SET PROPER RETURN
	JMP I	XDAD		/RETURN

/GENERAL PURPOSE ROUTINE TO RETURN TO CALLER

SIMEXT,	.-.			/CHANGE BACK TO FIELD WE CAME FROM
	JMP I	RETADD		/RETURN
RETADD,	.-.			/RETURN ADDRESS

/ROUTINE TO SAVE THE FIELD FROM FROM THE SIMULATION WAS CALLED

SAVFLD,	.-.			/HEADER
	RDF			/READ THE DATA FIELD REGISTER
	TAD	(CIF CDF)	/GET A 6203
	DCA 	SIMEXT		/AND STORE IT IN ORDER TO CHANGE THE FIELD
	JMP I	SAVFLD		/RETURN

	PAGE
XSHL,	.-.			/SHIFT LEFT ROUTINE
	DCA	SHLTM1		/TEMP FOR HIGH BITS
	TAD	(NOP)		/GET NOP
	DCA	XSHRE3		/STORE OVER (JMS ROTR) INSTRUCTION
	TAD	(JMS I	(ROTL))/GET THE ROTATE LEFT
	DCA	XSHRE2		/STORE IT IN LINE
XSHRE1,	TAD I	XSHL
	CMA
	DCA	XSHR
	TAD	SHLTM1
XSHRE3,	JMS I	(ROTR)
	CLL
XSHRE2,	JMS I	(ROTL)
	ISZ	XSHR
	JMP	XSHRE3
	ISZ	XSHL
	JMP I	XSHL
XSHR,	.-.			/SHIFT RIGHT ROUTINE
	DCA	SHLTM1
	TAD	XSHR
	DCA	XSHL
	TAD	(NOP)
	DCA	XSHRE2
	TAD	(JMS I 	(ROTR))	/RESTORE THE ROTATE RIGHT INSTRUCTION
	DCA	XSHRE3		/FOR USE BY THIS SUBROUTINE
	JMP	XSHRE1		/ENTER THE LEFT SUBROUTINE AND CONTINUE
SHLTM1,	.-.			/SHIFT LEFT TEMPORARY

	XLIST	OFF	>
	XLIST	ON

