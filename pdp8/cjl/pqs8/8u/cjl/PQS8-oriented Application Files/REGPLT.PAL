/THIS SUBROUTINE PRINTS MESSAGES ON THE CONSOLE

MESPRN,	.-.			/SUBROUTINE HEADER
	CDF	MESFLD		/CHANGE TO MESSAGE FIELD

	TAD I	MESTMP		/GET THE WORD IN MESSAGE
	CDF	CDFL0		/CHANGE TO CODING FIELD
	SNA			/IF NOT END OF MESSAGE THEN SKIP
	JMP I	MESPRN		/ELSE RETURN
	JMS	SCRSIX		/PRINT HIGH ORDER BYTE
	CDF	MESFLD		/CHANGE TO MESSAGE FIELD
	TAD I	MESTMP		/GET BACK THE WORD
	CDF	CDFL0		/CHANGE BACK TO CODING FIELD
	BSW			/SWITCH HIGH & LOW BYTES
	JMS	SCRSIX		/PRINT THE LOW BYTE
	ISZ	MESTMP		/MOVE TO NEXT WORD
	JMP	MESPRN+1	/GET NEXT WORD
MESTMP,	.-.			/HOLDS MESSAGE ADDRESS


/THIS ROUTINE PRINTS CHARACTERS IN SIX-BIT ASCII FORMAT
/THE CHARACTER <> IS USED FOR <CARRIAGE RETURN-LINE FEED>

SCRSIX,	.-.			/SUBROUTINE HEADER
	AND	(7700)		/MASK OFF HIGH SIX BITS
	SNA			/IF NON ZERO THEN SKIP AND CONTINUE
	JMP	SCRBLNK		/ELSE PRINT BLANK
	TAD	(4000)		/COMPLEMENT THE HIGH BIT OF THE CHARACTER
	TAD	(7500)		/COMPARE TO -<#> IN HIGH BYTE
	SNA			/IF NOT <#> THEN SKIP AND PROCESS CHARACTER
	JMP	SCRLF		/ELSE GENERATE NEW LINE
	TAD	(300)		/GET BACK ORIGINAL CHARACTER
	BSW			/PUT INTO LOW SIX BITS
	TAD	(40)		/TURN INTO 7-BIT ASCII CHARACTER
SCRBLNK,JMS	PRCHAR		/PRINT THE CHARACTER
	JMP I	SCRSIX		/RETURN TO CALLER

SCRLF,	TAD	(CR)		/GET CARRIAGE RETURN
	JMS	PRCHAR		/PRINT IT
	TAD	(LF)		/GET LINE FEED
	JMS	PRCHAR		/PRINT IT
	JMP I	SCRSIX		/RETURN TO CALLER

/READING OF CHARACTERS SUBROUTINE

KB,	.-.			/RETURN ADDRESS HELD HERE
	KSF			/SKIP ON FLAG
	JMP	.-1		/WAIT
	KRB			/READ THE BUFFER
	AND	(177)		/AND OFF BITS 5-11
	JMP I	KB		/RETURN

/THIS SUBROUTINE PRINTS CHARACTERS ON CONSOLE

PRCHAR,	.-.			/SUBROUTINE HEADER
	TSF			/IF PRINTER FLAG IS READY THEN SKIP
	JMP	.-1		/ELSE WAIT FOR IT
	TLS			/OUTPUT CHARACTER
	CLA			/CLEAR AC
	JMP I	PRCHAR		/RETURN TO CALLER
	PAGE


/THE FOLLOWING ROUTINE GETS THE NEXT CHARACTER TO BE GENERATED AND
/SETS THE APPROPRIATE POINTERS ACCORDING TO THE CHARACTER

CHARSET,.-.			/SUBROUTINE RETURN ADDRESS
	CLA CLL			/CLEAR AC AND LINK
	TAD  	(CHPNSTR-1)	/GET STARTING POINT OF ASCII CODES -1
	DCA I	(ASCPTR)	/INITIALIZE POINTER TO WHERE ASCII CODES ARE
	JMS I	(SETUP)		/JUMP TO INITIALIZE VARIABLES FOR ADJUSTMENTS
NXTCHAR,JMS I	(GETCHAR)	/ROUTINE TO GET THE NEXT CHARACTER
	TAD	(-41)		/SUBTRACT 33
	SPA			/IF AC = 0
	JMP I	(BLANK)		/THEN CHARACTER IS A BLANK
	CDF	CHARFLD		/CHANGE TO THE CHARACTER TABLE FIELD
	TAD	(STRTTAB)	/ELSE ADD THE ADDRESS OF THE FIRST POSITION
	CDF	CDFL0		/OF THE CHARACTER ADDRESS TABLE
	DCA	CHARADR		/STORE AC AS THE POINTER TO WHERE THE ADDRESSES
	CDF	CHARFLD		/OF THE CHARACTER'S TABLES ARE LOCATED
	TAD I	CHARADR		/GET CONTENTS OF ADDRESS POINTED TO BY CHARADR
	CDF	CDFL0		/CHANGE TO CODING FIELD
	DCA	CHARADR		/STORE AS THE POINTER TO THE TABLES
	JMS I	(GETVALS)	/GET THE VALUES IN THE WORD POINTED TO BY
				/CHARADR
	JMS 	RTNCHUZ		/NOW JUMP TO READ THE TABLES AND CHOOSE THE
				/CORRECT ROUTINE TO JUMP TO
	JMS I	(UPCRNR)	/JUMP TO UPDATE LEFT CORNERS
	JMP	NXTCHAR		/JUMP TO TOP

XCNTR,	.-.			/X CENTER VALUE FOR ARCS
YCNTR,	.-.			/Y CENTER VALUE FOR ARCS
XCNTMP,	.-.			/X CENTER TEMP
YCNTMP,	.-.			/Y CENTER TEMP
BOLDTMP,.-.			/TEMPORARY STORAGE FOR FONT TYPE

/THE FOLLOWING ROUTINE READS THE FIRST VALUES OF THE TABLES AND JUMPS TO
/THE CORRECT ROUTINE BASED UPON THOSE VALUES


RTNCHUZ,.-.			/HEADER

CHKVALS,CLA			/CLEAR AC
	TAD 	PYTABL		/GET Y TABLE VALUE READ IN
	SPA CLA			/IS IT NEGATIVE?
	JMP I	RTNCHUZ		/YES->RETURN
	TAD 	PYBOLD		/GET THE ROUTINE NUMBER TO JUMP TO
	CIA			/MAKE IT MINUS

	IAC			/INCREMENT AC
	SNA			/IS AC=0?
	JMS I	(VECTOR)	/YES->GENERATE VECTOR
	IAC			/NO->INCREMENT AC
	SNA			/IS IT 0?
	JMS I	(ARCS)		/YES->GENERATE ARC
	IAC			/NO->INCREMENT AC
	SNA			/IS IT 0?
	JMS I	(SPECIAL)	/YES->JUMP FOR SPECIAL THICKNESS
	IAC			/INCREMENT AC
	SNA			/IS IT 0?
	JMS I	(UNDER)		/YES->JUMP FOR CHARACTERS BELOW THE AXIS
	IAC			/INCREMENT AC
	SNA			/IS IT 0?
	JMS I	(SPESPA)	/YES->JUMP FOR CHARACTERS WITH SPECIAL SPACING
	JMP	CHKVALS		/GO BACK THROUGH LOOP


/ROUTINE TO GET THE NEXT ASCII CODE FROM MEMORY AND CHECK IF THERE ARE
/MORE CHARACTERS TO GENERATE

GETCHAR,.-.			/SUBROUTINE HEADER
	CLA			/CLEAN UP
	ISZ	ASCPTR		/INCREMENT POINTER
	NOP			/WHEN ASCPTR = 0
	CDF	CHARFLD		/CHANGE TO CHARACTER FIELD
	TAD I	ASCPTR		/GET NEXT ASCII CODE IN MEMORY
	CDF	CDFL0		/CHANGE TO CODE FIELD
	SZA			/IF THE ACII CODE IS NOT ZERO
	JMP I	GETCHAR		/THEN RETURN
	JMP I	CHARSET		/RETURN IN ORDER TO PLOT THE POINTS ON DSKPLT
ASCPTR,	.-.			/POINTER TO NEXT ASCII CODE

	PAGE


	XLIST	OFF

	IFZERO	EAE	<
	/EAE SIMULATION DEFINITIONS
	MUY=JMS I (XMUL)
	DVI=JMS I (XDVI)>

	XLIST	ON

/THIS ROUTINE GENERATES THE POINTS OF A ARC

ARCS,	.-.			/HEADER
	ISZ 	CHARADR		/INCREMENT CHARACTER ADDRESS
	JMS I	(GETVALS)	/JUMP TO GET THE VALUES
NXTARC,	CLA			/CLEAR AC
	TAD I	(FONTHCK)	/GET FONT THICKNESS
	DCA I	(CHARTHCK)	/STORE IT IN A TEMP
	TAD 	PXBOLD		/GET THE ADD OR SUBTRACT X FLAG
	DCA I	(XSIGN)		/STORE IT
	TAD 	PYBOLD		/GET THE ADD OR SUBTRACT Y FLAG
	DCA I	(YSIGN)		/STORE IT
	TAD 	PXTABL		/GET THE X CENTER VALUE FOR THE ELLIPSE
	DCA I	(XCNTR)		/STORE IT
	TAD I	(XCNTR)		/GET THE X CENTER VALUE
	JMS I	(XADJUS)	/ADJUST X TABLE VALUE
	DCA I	(XCNTMP)	/STORE ADJUSTED VALUE
	TAD I	(XCNTMP)	/GET STORED VALUE
	TAD 	XLFCRNR	/ADD THE LEFT CORNER VALUE 
	DCA 	XCENT		/STORE IT
	TAD 	PYTABL		/GET THE Y CENTER VALUE FOR THE ARC
	DCA I	(YCNTR)		/STORE IT
	TAD I	(YCNTR)		/GET THE Y CENTER VALUE
	JMS I	(YADJUS)	/ADJUST Y TABLE VALUE
	DCA I	(YCNTMP)	/STORE IT
	TAD I	(YCNTMP)	/GET IT BACK
	TAD 	YLFCRNR	/ADD THE Y LEFT CORNER VALUE
	DCA 	YCENT		/STORE IT
	ISZ 	CHARADR		/INCREMENT CHARACTER ADDRESS
	JMS I	(GETVALS)	/GET THE VALUES
	TAD I	(XCNTR)		/GET THE X CENTER VALUE
	TAD 	PXTABL		/ADD THE RADIUS VALUE
	JMS I	(XADJUS)	/ADJUST IT
	DCA I	(XCNTR)		/STORE IT
	TAD I	(XCNTMP)	/GET ADJUSTED X CENTER
	CIA			/MAKE IT NEGATIVE
	TAD I	(XCNTR)		/ADD THE ADJUSTED RADIUS
	DCA 	XRADI		/STORE IT AS THE X RADIUS
	TAD I	(YCNTR)		/GET THE Y CENTER VALUE
	TAD 	PYTABL		/ADD THE Y RADIUS VALUE
	JMS I	(YADJUS)	/ADJUST IT
	DCA I	(YCNTR)		/STORE IT
	TAD I	(YCNTMP)	/GET Y CENTER ADJUSTED
	CIA			/MAKE IT NEGATIVE
	TAD I	(YCNTR)		/ADD THE ADJUSTED RADIUS
	SPA			/IS IT POSITIVE?
	CIA			/NO->MAKE IT POSITIVE
	DCA 	YRADI		/STORE IT AS THE Y RADIUS
	TAD I	(CHRTSN)	/GET SIN OF ROTATION ANGLE
	DCA	ARCSIN		/STORE IT FOR ARC ROTATION
	TAD I	(CHRTCS)	/GET COSINE OF ROTATION ANGLE
	DCA	ARCCOS		/STORE IT FOR ARC ROTATION
AGAIN,	TAD	(-23)		/SET COUNTER
	DCA I	(ARCCNTR)	
	TAD	(SINTABL)	/GET ADDRESS OF THE SIN TABLE
	DCA 	SINPTR		/FOR A POINTER
	TAD	(COSTABL)	/GET ADDRESS OF COSINE TABLE
	DCA 	COSPTR		/FOR A POINTER
ARCLUP,	TAD I	COSPTR		/GET NEXT VALUE IN THE COSINE TABLE
	MQL			/LOAD THE MQ
	IFNZRO	DECMATE <
	CIF 	CDFL1		/CHANGE TO FIELD WHERE EAE IS LOCATED
	>
	MUY			/ELSE FIND NEXT X VALUE
XRADI,	.-.
	JMS I	(PTCHK)		/CHECK THE POINT FOR ACCURACY
	DCA I	(ACOS)		/TEMPORARILY STORE THE ANSWER
	TAD I	(XSIGN)		/GET THE X ADD OR SUBTRACT FLAG
	SPA CLA			/IF IT IS MINUS
	JMP I	(XSUB)		/THEN SUBTRACT A*COS FROM THE CENTER
XADD,	TAD 	XCENT		/GET THE X CENTER VALUE
	TAD I	(ACOS)		/ADD IN A*COS
XSAV,	DCA I	(XPTSAV)	/STORE THE POINT TO BE SAVE IN THE BIT MAP
	TAD I	SINPTR		/GET NEXT VALUE IN THE SINE TABLE
	MQL			/LOAD THE MQ
	IFNZRO	DECMATE <
	CIF 	CDFL1		/CHANGE TO FIELD WHERE EAE IS LOCATED
	>
	MUY			/AND MULTIPLY BY ABSRAD TO GET THE
YRADI,	.-.			/NEXT Y VALUE
	JMS I	(PTCHK)		/CHECK THE POINT FOR ACCURACY
	DCA I	(BSIN)		/STORE B * SIN
	TAD I	(YSIGN)		/GET THE Y ADD OR SUBTRACT FLAG
	SPA CLA			/IF IT IS MINUS
	JMP I	(YSUB)		/THEN SUBTRACT B*SIN FROM THE CENTER
YADD,	TAD 	YCENT		/GET THE Y CENTER VALUE
	TAD I	(BSIN)		/ADD IN B*SIN
YSAV,	MQL			/PUT IT INTO THE MQ
	TAD I	(XPTSAV)	/PUT X VALUE IN AC
	JMS I	(ROTATE)	/JUMP TO ROTATE THE X AND Y VALUES
XCHRCTR,.-.			/X ARC CENTER VALUE
YCHRCTR,.-.			/Y ARC CENTER VALUE
ARCSIN,	.-.			/SINE OF ARC ANGLE OF ROTATION
ARCCOS,	.-.			/COSINE OF ARC ANGLE OF ROTATION
	JMS I	(PTSAV)		/JUMP TO SAVE THE POINTS IN FIELDS 2 AND 3
	ISZ 	SINPTR		/INCREMENT POINTER TO NEXT VALUE
	ISZ 	COSPTR		/INCREMENT POINTER TO NEXT VALUE
	ISZ I	(ARCCNTR)	/ARE WE FINISHED WITH ALL THE TABLES' VALUES
	JMP	ARCLUP		/CONTINUE PROCESSING
	JMP I	(ARCCHK)	/JUMP TO CHECK FOR THICKNESS AND MORE ARCS

	PAGE
	XLIST	OFF

	IFZERO	EAE	<
	/EAE SIMULATION DEFINITIONS
	MUY=JMS I (XMUL)
	DVI=JMS I (XDVI)>

