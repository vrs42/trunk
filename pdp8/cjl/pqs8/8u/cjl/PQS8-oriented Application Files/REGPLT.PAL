/THIS ROUTINE SAVES THE GENERATED POINTS IN FIELDS 2 AND 3 
PTSAV,	.-.			/SUBROUTINE HEADER
	TAD	(-ABSOFFS+1)	/SUBTRACT BITMAP OFFSET FROM X IN <AC>
XSAVFD,	CDF	XFLD		/CHANGE TO THE X DATA FIELD
	DCA I	XR7		/STORE X IN NEXT ADDRESS
	CDF	CDFL0		/CHANGE TO CODING FIELD
	SWP			/GET THE Y VALUE FROM THE <MQ>
	TAD	(ORDOFFS-1)	/SUBTRACT BITMAP OFFSET
YSAVFD,	CDF	YFLD		/CHANGE TO Y DATA FIELD
	DCA I	XR10		/STORE Y IN NEXT ADDRESS
	CDF	CDFL0		/CHANGE TO CODING FIELD
	ISZ I	(PNTNUM)	/INCREMENT NUMBER OF POINTSGENERATED
	ISZ 	SAVCNT		/INCREMENT NUMBER OF POINTS STORED
	JMP	.+2		/DO NOT STORE FIELDS
	JMS 	PLOTFLD		/STORE FIELDS 2 AND 3 IF FULL
	JMP I	PTSAV		/RETURN
XPTSAV,	.-.			/X VALUE TO SAVE IN FIELD 2
YPTSAV,	.-.			/Y VALUE TO STORE IN FIELD 3

/THIS ROUTINE CALLS THE ROUTINE TO PLOT THE POINTS ON THE BIT MAP WHEN
/FIELDS 2 AND 3 ARE FULL

PLOTFLD,.-.			/SUBROUTINE HEADER
	JMS I	(DSKPLT)	/JUMP TO PLOT POINTS ON DISK
	CLA			/CLEAN UP
	IAC			/GET A 1
	DCA	READFL		/SET READ FLAG FOR ANY PRECEEDING PLOTS
	JMS 	SETCNT		/JUMP TO SET ANY COUNTERS
	JMP I	PLOTFLD		/RETURN

/THIS ROUTINE INIIALIZES THE AUTO INDEX REGISTERS AND COUNTERS FOR THE
/POINT SAVING ROUTINE

SETCNT,	.-.			/ROUTINE HEADER
	CLA			/CLEAN UP
	DCA I	(PNTNUM)	/SET PNTNUM TO 0
        CDF	XFLD		/CHANGE TO X FIELD
	TAD I	(XFLPNCN)	/GET NUMBER OF POINTS TO PROCESS
	CDF	CDFL0		/CHANGE TO CODING FIELD
	TAD 	(XPNSTR-1)
	TAD I	(SYMPTS)	/ADD THE NUMBER OF BUFFER POINTS
	DCA 	XR7		/STORE AS X FIELD ADDRESS
	TAD	XR7		/GET THE FIRST ADDRESS
	DCA	XR10		/STORE AS Y FIELD ADDRESS POINTER
	CDF	XFLD		/CHANGE TO X DATA FIELD
	TAD I	(XFLPNCN)
	CDF	CDFL0		/CHANGE TO CODING FIELD
	TAD	(XPNSTR)
	DCA	SAVCNT		/STORE AS SAVING ADDRESS COUNTER
	JMP I 	SETCNT		/RETURN
SAVCNT,	.-.			/COUNTER TO SEE IF STORING ADDRESS
				/ACEEDS LOCATION 4000
READFL,	.-.			/FLAG TO ALLOW DSKPLOT TO KNOW IF THE
				/FIELDS ON DISK HAVE TO BE READ BEFORE
				/THE POINTS ARE STORED.
