	TAD	[-1200]		/RESET THE
	CLAB			/PRESET REGISTER
	CLA			/CLEAN UP
	CLSA			/GET CLOCK STATUS
	CDF	BUFFLD		/BUFFER FIELD NEEDED EITHER WAY
	SMA			/OVERFLOW?
	JMP	NERVE		/NO, MUST BE SCHMITT TRIGGER
