TMCNST,	.-.			/SUBROUTINE HEADER
	CDF	00		/GET FIELD 0
	CLA			/CLEAN UP
	DCA I	(TSUM)		/CLEAR THE SUM FOR
	DCA I	(TSUM+1)	/TIME CONSTANT EVALUATION
	FENTER			/ENTER FPP
