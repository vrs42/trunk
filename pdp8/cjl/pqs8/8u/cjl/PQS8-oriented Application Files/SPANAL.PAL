MSUNDES,TEXT	/%^UNIT TYPE (7777 IS NO UNITS)=/;0
MSWNWD,	TEXT	/%^WINDOW WIDTH=/;0
MSVLTY,	TEXT	/%^TYPE OF VELOCITY IN SWPFLD:/;0
MSPSTY,	TEXT	/%^TYPE OF POSITION IN POSFLD:/;0
MSYEAR,	TEXT	/%^YEAR DATA WAS TAKEN:/;0
MSDAY,	TEXT	/%^DAY DATA WAS TAKEN:/;0
