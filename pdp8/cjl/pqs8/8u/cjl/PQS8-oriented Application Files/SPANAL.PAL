	JMP	.-1		/WAIT FOR IT
	JMP I	[STRT1]		/RESTART

CRLF,	.-.			/<CR>, <LF> ROUTINE
	CLA			/CLEAN UP FOR DIRTY CALLERS
	TAD	["M&37]		/GET A <CR>
	JMS I	[P7CH]		/GO PRINT IT
	TAD	("J&37)		/GET A <LF>
	JMS I	[P7CH]		/GO PRINT IT
	JMP I	CRLF		/RETURN

ESCRLF,	.-.			/<ESC> SWITCH TEST ROUTINE
