	DCA	SUMSQ+2		/STORE BACK
	ISZ	XR2		/HAVE WE DONE ALL POINTS?
	JMP	SUMLUP		/NO,GO BACK AND DO MORE
	TAD 	HIGHX1		/GET HIGH X VALUE
	CMA			/MAKE NEG-1
	TAD 	LOWX1		/SUBTRACT LOW X VALUE
	DCA	XR2		/STORE NUMBER OF POINTS
	TAD 	LOWX1		/GET LOW X VALUE
	DCA	MULARG		/STORE TEMPORARILY
	CDF	SWPFLD		/GET DATA FIELD
	TAD I	MULARG		/GET THE FIRST VALUE
	DCA	MAXFR		/STORE AS MAX FREQ
	TAD	MAXFR		/GET IT BACK
	DCA	MINFR		/STORE IN MIN FREQ
	ISZ	MULARG		/GO TO NEXT POINT
PKTST,	TAD	MAXFR		/MAXIMUM FREQ
	STL CIA			/COMPARE TO
	TAD I	MULARG		/GET NEXT VALUE
	SZL CLA			/SKIP IF GREATER
	JMP	MINTST		/TEST FOR MINIMUM
	TAD I	MULARG		/GET VALUE
	DCA	MAXFR		/STORE AS MAX FREQ
	TAD	MULARG		/GET THE POINTER
	DCA	MAXX		/STORE AS MAXIMUM X VALUE
MINTST,	TAD	MINFR		/GET THE MINIMUM FREQ
	CLL CIA			/MAKE NEGATIVE
	TAD I	MULARG		/ADD THE VALUE
	SZL CLA			/COMPARE
	JMP	ENDTST		/GO ON
	TAD I	MULARG		/GET THE VALUE BACK
	DCA	MINFR		/STORE AS MINIMUM FREQ
	TAD	MULARG		/GET BACK VALUE
	DCA	MINX		/STORE MIN X VALUE
ENDTST,	ISZ	MULARG		/NEXT POINT
	ISZ	XR2		/HAVE WE COMPLETED ALL POINTS
	JMP	PKTST		/GO BACK FOR MORE
	JMP I	CALCUL		/RETURN
LOWX0,	.-.
HIGHX0,	.-.
LOWX1,	.-.
HIGHX1,	.-.
MAXFR,	.-.			/HOLDS MAX FREQ
MINFR,	.-.			/HOLDS MIN FREQ
MAXX,	.-.			/X WHERE MAX FREQ OCCURS
MINX,	.-.			/X WHERE MIN FREQ OCCURS
SWEEPS,	.-.			/NUMBER OF SWEEPS
SUM,	ZBLOCK 3
SUMSQ,	ZBLOCK 3
FTEMP,	ZBLOCK 3
FRCONS,	0003;2353;6572
