HARSW,	.-.				/UNIT OR VEL SWITCH
HATEMP,	.-.				/TEMPORARY
HASGN1,	.-.				/SIGN HOLDER
K,	.-.				/INDEX
MEMVAL,	.-.				/HOLDS MEMORY VALUE
