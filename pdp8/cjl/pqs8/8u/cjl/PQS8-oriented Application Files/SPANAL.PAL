MSVPH,	TEXT	/%^DOMINANT HARMONIC PHASE=/;0
MSUPRC,	TEXT	/^ SPIKES PER SEC PER CYCLE/;0
MSVPRC,	TEXT	/^ POSITION UNITS PER SEC PER CYCLE/;0
MSPPRC,	TEXT	/^ POSITION UNITS PER CYCLE/;0
MSDEG,	TEXT	/^  DEGREES%/;0
MSG11,	TEXT	/%^TIME CONSTANT ANALYSIS/;0
