INHTC,	.-.			/INH TIME CONST SUBROUTINE
	TAD	INHTC		/GET RETURN ADDRESS
	DCA	EXCTC		/STORE THERE FOR RETURN
	TAD	AVERAG		/GET AVERAGE VALUE
	CIA			/MAKE NEGATIVE
	TAD I	(MINFR)		/ADD THE MINIMUM VALUE
	DCA	PEAK+2		/STORE
	NL7777			/GET -1
	DCA	PEAK+1		/STORE IN HIGH ORDER WORD
	TAD	(27)		/GET 23 DECIMAL
	DCA	PEAK		/PUT INTO EXPONENT WORD
	TAD I	(HIGHX1)	/GET HIGH POINTER
	CIA			/SUBTRACT FROM
