	JMP	.-1		/WAIT FOR IT
	TAD	("P&177)	/GET A "P"
	JMS	P7OUT		/PRINT IT
	JMP	.-1		/WAIT FOR IT
	JMP I	[ANSTRT]	/RESTART

/	COMES HERE IF <^R> HIT.

RHIT,	TAD	["^&177]	/GET AN "^"
	JMS	P7OUT		/PRINT IT
	JMP	.-1		/WAIT FOR IT
	TAD	("R&177)	/GET A "P"
