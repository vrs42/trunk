	CIA			/NO, MAKE NEGATIVE
	DCA I	(EXCDEL)	/STORE INTO EXCITATORY DELTA
	TAD I	(MINFR)		/GET MINIMUM FREQUENCY
	CIA			/MAKE NEGATIVE
	TAD I	(AVERAG)	/COMPARE TO AVERAGE FREQUENCY
	SPA			/IS IT >0
	CIA			/NO, MAKE NEGATIVE
