/COMPARE THE TWO 8K BASIC BINARIES.

/	FIELD 0 AND 1 HAVE THE OFFICIAL BINARY FROM THE PAPER-TAPE.

/	LOAD FIELD 2 AND 3 WITH THE LATEST TEST FROM THE ASSEMBLY OF THE SOURCE FILE.

/	THIS ALSO LOADS IN ZEROES INTO FIELDS 0, 1, 2 AND 3 AND SHOULD BE LOADED JUST
/	BEFORE THE LATEST OFFICIAL AND TEST ASSEMBLY BINARY, ETC.

/	THIS CODE LIVES IN FIELD 4 TO TEST IF FIELDS 0 AND 2 COMPARE AND ALSO FIELDS
/	1 AND 3 COMPARE.  WILL PRINT THE ADDRESS OF THE FIRST FAILURE, ETC.

/	START AT 40200.

	FIELD	0				/WHERE THE FIELD 0 OFFICIAL CODE GOES

	*0					/START AT THE BEGINNNING

	ZBLOCK	7600				/EMPTY SPACE

	FIELD	1				/WHERE THE FIELD 1 OFFICIAL CODE GOES

	*0					/START AT THE BEGINNING

	ZBLOCK	7600				/EMPTY SPACE

	FIELD	2				/WHERE THE FIELD 0 TEST CODE GOES

	*0					/START AT THE BEGINNING

	ZBLOCK	7600				/EMPTY SPACE

	FIELD	3				/WHERE THE FIELD 1 TEST CODE GOES

	*0					/START AT THE BEGINNING

	ZBLOCK	7600				/EMPTY SPACE

/	LOAD THE ASSEMBLED BINARY TEST OVER THE ABOVE TO AVOID FALSE POSITIVES.

	FIELD	4				/OUR COMPARE CODE LOADS HERE

	*20					/GET PAST AUTO-INDEX AREA

ADR,	.-.					/ADDRESS POINTER FOR COMPARISONS
ADRTMP,	.-.					/ADDRESS VALUE TEMPORARY
CNT,	.-.					/COMPARE COUNT
DIGTMP,	.-.					/4 DIGITS OUTPUT TEMPORARY
PTR,	.-.					/OUTPUT POINTER
/	SUBROUTINES.

MSGPRT, .-.					/MESSAGE PRINTING ROUTINE
	CLA					/CLEAN UP
	CDF	40				/GOTO OUR FIELD
	TAD I	MSGPRT				/GET ADDRESS OF MESSAGE
	ISZ	MSGPRT				/BUMP PAST ARGUMENT
	DCA	PTR				/STORE THE POINTER
MSGLUP,	TAD I	PTR				/GET A MESSAGE CHARACTER
	SNA					/SKIP IF NOT AT END
	JMP I	MSGPRT				/RETURN IF DONE
	JMS	OUT				/PRINT THIS CHARACTER
	ISZ	PTR				/BUMP TO NEXT
	JMP	MSGLUP				/GO DO ANOTHER ONE

FLDPRT,	.-.					/FIELD PRINT ROUTINE
	RTR;RAR					/MOVE OVER PASSED FIELD
	JMS	OCTOUT				/OUTPUT DIGIT
	JMP I	 FLDPRT				/RETURN TO CALLER

ADRPRT,	.-.					/PRINT PASSED 4-DIGIT ADDRESS ROUTINE
	DCA	ADRTMP				/SAVE PASSED VALUE
	TAD	ADRTMP				/GET PASSED VALUE
	JMS	DIG4				/OUTPUT IT
	JMS	CRLF				/MAKE IT NEAT
	JMP I	ADRPRT				/RETURN

CRLF,	.-.					/<CR>, <LF> OUTPUT ROUTINE
	TAD	["M&37]				/GET <CR>
	JMS	OUT				/OUTPUT IT
	TAD	["J&37]				/GET <LF>
	JMS	OUT				/OUTPUT IT
	JMP I	CRLF				/RETURN TO CALLER
DIG4,	.-.					/OUTPUT FOUR DIGITS ROUTINE
	DCA	DIGTMP				/SAVE PASSED VALUE
	TAD	DIGTMP				/GET IT BACK
	RTL;RTL					/MOVE HIGHEST TO LOWEST
	JMS	OCTOUT				/OUTPUT DIGIT
	TAD	DIGTMP				/GET PASSED VALUE AGAIN
	RTR;RTR;RTR				/MOVE SECOND TO LOWEST
	JMS	OCTOUT				/OUTPUT DIGIT
	TAD	DIGTMP				/GET IT AGAIN
	RTR;RAR					/MOVE THIRD TO LOWEST
	JMS	OCTOUT				/OUTPUT DIGIT
	TAD	DIGTMP				/LAST TIME
	JMS	OCTOUT				/OUTPUT LOWEST DIGIT
	JMP I	DIG4				/RETURN

OCTOUT,	.-.					/OUTPUT A SINGLE OCTAL DIGIT
	AND	[7]				/JUST DIGIT BITS
	TAD	["0&177]			/MAKE IT ASCII CHARACTER
	JMS	OUT				/OUTPUT IT
	JMP I	OCTOUT				/RETURN

/	OUTPUT ROUTINE.

OUT,	.-.					/OUTPUT TO CONSOLE
	TSF					/FLAG UP?
	JMP	.-1				/NO, WAIT FOR IT
	TLS					/YES, OUTPUT THE CHARACTER
	CLA					/CLEAN UP
	JMP I	OUT				/RETURN

	*200					/THE USUAL

STRT,	TLS					/PRIME THE PUMP

CMP0,	TAD	[-7600]				/SETUP THE
	DCA	CNT				/COMPARE COUNT
	DCA	ADR				/CLEAR POINTER ADDRESS
LP0,	CDF	00				/SETUP THE COMPARE FIELD
	TAD I	ADR				/GET A WORD TO TEST
	CIA					/INVERT IT
	CDF	20				/SETUP THE TEST FIELD
	TAD I	ADR				/TEST THE STANDARD VERSUS THE LATEST
	SNA CLA					/SKIP IF DIFFERENT
	JMP	CMP0OK				/JUMP IF A MATCH
	JMS	MSGPRT				/PRINT
	ADRMSG					/OUR MESSAGE
	TAD	LP0				/GET FIELD OF ERROR
	JMS	FLDPRT				/PRINT IT OUT
	TAD	ADR				/GET ADDRESS OF FAILURE
	JMS	ADRPRT				/PRINT IT
	CIF CDF	00				/GOING TO FIELD 0
	JMP I	[7600]				/REBOOT

CMP0OK,	ISZ	ADR				/BUMP TO NEXT
	ISZ	CNT				/DONE ENTIRE FIELD?
	JMP	LP0				/NO, GO BACK

/	WE GOT THROUGH FIELD 0, NOW TO FIELD 1.

CMP1,	TAD	[-7600]				/SETUP THE
	DCA	CNT				/COMPARE COUNT
	DCA	ADR				/CLEAR POINTER ADDRESS
LP1,	CDF	10				/SETUP THE COMPARE FIELD
	TAD I	ADR				/GET A WORD TO TEST
	CIA					/INVERT IT
	CDF	30				/SETUP THE TEST FIELD
	TAD I	ADR				/TEST THE STANDARD VERSUS THE LATEST
	SNA CLA					/SKIP IF DIFFERENT
	JMP	CMP1OK				/JUMP IF A MATCH
	JMS	MSGPRT				/PRINT
	ADRMSG					/OUR MESSAGE
	TAD	LP1				/GET FIELD OF FAILURE
	JMS	FLDPRT				/PRINT IT OUT
	TAD	ADR				/GET ADDRESS OF FAILURE
	JMS	ADRPRT				/PRINT IT
XIT,	CIF CDF	00				/GOING TO FIELD 0
	JMP I	[7600]				/REBOOT
CMP1OK,	ISZ	ADR				/BUMP TO NEXT
	ISZ	CNT				/DONE ENTIRE FIELD?
	JMP	LP1				/NO, GO BACK

/	WE GOT HERE AND ALL IS FINE.

	JMS	MSGPRT				/PRINT DONE
	DONEMSG					/DONE MESSAGE
	JMP	XIT				/FINISH IT THERE
/	BLOCK COMPARE ROUTINE.

/	CALLING SEQUENCE:

/	JMS I	[CMPBLK]			/COMPARE A BLOCK OF MEMORY.

/	-COUNT					/TWO'S COMPLEMENT OF NUMBER OF
						/WORDS TO COMPARE.
/	CDF	FRSTFLD				/CDF TO FIRST FIELD.

/	CDF	SCNDFLD				/CDF TO SECOND FIELD.

/	ERROR RETURN				/RETURN IF A COMPARE ERROR OCCURRED.

/	GOOD RETURN				/RETURN IF ALL WORDS COMPARED.

/	ALL WORDS FROM X0000 THROUGH THE VALUE DETERMINED BY THE COUNT [WHICH CAN BE
/	SET TO 0000 TO COMPARE AN ENTIRE FIELD] ARE COMPARED TO THE CORRESPONDING
/	WORDS Y0000 ONWARD WHERE X IS THE FIELD IN THE FIRST ARGUMENT AND Y IS THE
/	FIELD IN THE SECOND ARGUMENT.  FIELD ARGUMENTS ARE PASSED AS "CDF"
/	INSTRUCTIONS TO SIMPLIFY THE CODING.

/	IF THERE IS A COMPARE ERROR IN ANY CHECKED ADDRESS, THE ADDRESS OF THE
/	COMPARE FAILURE IS CONTAINED IN "ADR".  THE VALUES OF THE TWO DIFFERING FIELDS
/	CAN BE OBTAINED BY CALLING GETWD1 AND GETWD2.  THE FIELDS THEMSELVES CAN BE
/	DERIVED FROM THE ASSOCIATED FIELD CHANGE INSTRUCTIONS "GETFL1" AND "GETFL2"
/	IN THE RESPECTIVE SUBROUTINES.  THIS WILL MAKE IT EASY TO PRINT OUT THE
/	DIFFERING VALUES.

/	THE COMPARE ERROR STOPS THE COMPARE PROCESS.  IT IS POSSIBLE TO CALL THIS
/	ROUTINE FOR A DIFFERENT COMPARISON AS THIS UTILITY IS OFTEN USED TO COMPARE
/	TWO DIFFERENT SETS OF FULL [OR NEARLY FULL] FIELDS OF MEMORY.

/ MOVE THIS TO PAGE zERO!

/	GET A WORD FROM THE FIRST COMPARISON FIELD.

GETWD1,	.-.					/GET A WORD FROM THE FIRST FIELD.
GETFL1,	.-.+CDF					/WILL BE "CDF FRSTFLD".
	TAD I	ADR				/GET THE WORD.
	JMP I	GETWD1				/RETURN TO CALLER.

/	GET A WORD FROM THE SECOND COMPARISON FIELD.

GETWD2,	.-.					/GET A WORD FROM THE SECOND FIELD.
GETFL2,	.-.+CDF					/WILL BE "CDF SCNDFLD".
	TAD I	 ADR				/GET THE WORD.
	JMP I	GETWD2				/RETURN TO CALLER.







/	MESSAGES.

ADRMSG,	"C;"O;"M;"P;"A;"R;"E;" ;"E;"R;"R;"O;"R;" ;"A;"T;":;" ;0
DONEMSG,"A;"L;"L;" ;"C;"O;"M;"P;"A;"R;"E;" ;"O;"K;"!;0

	$					/THAT'S ALL FOLK!


