/	SAMPLE TEST PROGRAM.

	FIELD	0				/WHY NOT

	*200					/THE USUAL

START,	TFL					/SET TTY: FLAG
	CDF	00				/SET OUR FIELD
	CIF	MTHFLD				/GOTO MATH PACKAGE FIELD
	TAD	(BADADR)			/SUPPLY OUR ERROR-HANDLING ADDRESS
	JMS I	(MINTERPRETER)			/CALL INTERPRETER
	SETFLD;	0^10				/SET TEXT FIELD
	SETUP;	-4^SCALE+SFTIGNORE+BINARY	/SETUP INPUT SCALING
	SETOUT;	0				/SETUP OUTPUT OPTIONS
	SETFORM;-4^20+2^20+17			/SETUP OUTPUT FORMAT
	CLEAR					/CLEAN UP
	ADD;	A				/GET FIRST OPERAND
	ADD;	B				/ADD ON SECOND OPERAND
	FUNCTIO;SQROOT
/	MUL;	P1				/MULTIPLY BY .1
/	DIV;	P1				/DIVIDE BY .1
	STORE;	ANSWER				/STORE RESULT
	EXIT					/EXIT INTERPRETER
	JMS I	(OUTANSWER)			/PRINT THE RESULTS
	HLT					/PAUSE
	JMP	START				/DO IT AGAIN

	PAGE
OUTANS,	.-.			/OUTPUT ANSWER ROUTINE
	TAD	(ANSWER)	/POINT TO
	DCA	PT		/ANSWER BUFFER
LOOP,	TAD I	PT		/GET A PAIR
	BSW			/HIGH-ORDER FIRST
	JMS	P6CH		/PRINT IT
	TAD I	PT		/GET AGAIN
	JMS	P6CH		/PRINT LOW-ORDER
	ISZ	PT		/BUMP TO NEXT PAIR
	JMP	LOOP		/GO BACK

P6CH,	.-.			/SIX-BIT PRINT ROUTINE
	AND	(77)		/JUST SIX-BIT
	SNA			/<EOL>?
	JMP	CRLF		/YES, DO A <CR>, <LF> AND LEAVE
	TAD	(40)		/XOR HIGH-ORDER BIT
	AND	(77)		/REMOVE CARRY
	TAD	(40)		/REVERSE THE BIT
	JMS	OUT		/PRINT IT
	JMP I	P6CH		/RETURN

CRLF,	TAD	("E&177)	/GET DELIMITER FOR DEBUGGING
	JMS	OUT		/PRINT IT
	TAD	(15)		/GET A <CR>
	JMS	OUT		/PRINT IT
	TAD	(12)		/GET A <LF>
	JMS	OUT		/PRINT IT
	JMP I	OUTANSWER	/RETURN TO CALLER

OUT,	.-.			/OUTPUT ROUTINE
