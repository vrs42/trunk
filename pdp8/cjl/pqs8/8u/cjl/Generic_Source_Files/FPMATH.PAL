	XLIST	OFF
	IFZERO	EAE	<
	XLIST	ON
/	DEFINITIONS FOR THIS PAGE.

	DLD=	JMS	XDLD	/DOUBLE-PRECISION LOAD
	DST=	JMS	XDST	/DOUBLE-PRECSIION STORE

	XLIST	OFF	>
	XLIST	ON
/	EAE SIMULATOR ROUTINES.

/	DOUBLE-PRECISION LOAD ROUTINE.

XDLD,	.-.			/DOUBLE-PRECISION LOAD
	CAM			/CLEAR AC, MQ
	TAD	XDLD		/GET OUR CALLER
	DCA	XDAD		/MAKE IT THEIRS
	SKP			/DON'T EXECUTE HEADER!

/	DOUBLE-PRECISION ADD ROUTINE.

XDAD,	.-.			/DOUBLE-PRECISION ADD
	DCA	XDADAC		/SAVE AC
	TAD I	XDAD		/GET ARGUMENT POINTER
	DCA	XDADPTR		/STASH IT
	CLL			/CLEAR LINK FIRST
	MQA			/GET LOW-ORDER
	TAD I	XDADPTR		/ADD ON ARGUMENT LOW-ORDER
	MQL			/STORE SUM BACK
	ISZ	XDADPTR		/BUMP TO HIGH-ORDER
	RAL			/GET CARRY
	TAD	XDADAC		/ADD ON HIGH-ORDER
	TAD I	XDADPTR		/ADD ON ARGUMENT HIGH-ORDER
	ISZ	XDAD		/BUMP AROUND ARGUMENT
	JMP I	XDAD		/RETURN

XDADAC,	.-.			/AC TEMPORARY
XDADPTR,.-.			/ARGUMENT POINTER

/	DOUBLE-PRECISION TWO'S COMPLEMENT ROUTINE.

XDCM,	.-.			/TWO'S COMPLEMENT ROUTINE
	SWP			/GET LOW-ORDER FIRST
	CLL CIA			/INVERT IT
	SWP			/PUT IT BACK
	CMA			/INVERT HIGH-ORDER
	SZL			/CARRY?
	IAC			/YES, SO INCREMENT
	JMP I	XDCM		/RETURN
/	DOUBLE-PRECISION STORE ROUTINE.

XDST,	.-.			/DOUBLE-PRECISION STORE
	DCA	XDSTAC		/SAVE AC
	TAD I	XDST		/GET ARGUMENT POINTER
	DCA	XDSTPTR		/STASH IT
	MQA			/GET LOW-ORDER
	DCA I	XDSTPTR		/STORE IT
	ISZ	XDSTPTR		/BUMP TO HIGH-ORDER
	TAD	XDSTAC		/GET HIGH-ORDER
	DCA I	XDSTPTR		/STORE IT
	TAD	XDSTAC		/RESTORE AC
	ISZ	XDST		/BUMP PAST ARGUMENT
	JMP I	XDST		/RETURN

XDSTAC,	.-.			/AC TEMPORARY
XDSTPTR,.-.			/ARGUMENT POINTER

/	DIVIDE ROUTINE.

XDVI,	.-.			/DIVIDE
	DST;	XDVIMQ		/STORE PASSED VALUE
	CAM			/CLEAN UP
	TAD I	XDVI		/GET PASSED ARGUMENT
	DCA	XDVICT		/STASH IT
	TAD I	XDVICT		/GET THE ARGUMENT VALUE
	CIA			/INVERT IT
	DCA	XDIVSOR		/SAVE AS DIVISOR
	TAD	(-14)		/SETUP THE
	DCA	XDVICT		/SHIFT COUNTER
XDVILP,	TAD	XDVIMQ		/GET LOW-ORDER
	CLL RAL			/MOVE UP
	DCA	XDVIMQ		/STORE BACK
	TAD	XDVIAC		/GET HIGH-ORDER
	RAL			/MOVE UP
	DCA	XDVIAC		/STORE BACK
	TAD	XDVIAC		/GET HIGH-ORDER
	TAD	XDIVSOR		/COMPARE TO DIVISOR
	SZL			/SKIP IF SMALLER
	DCA	XDVIAC		/ELSE STORE BACK
	SZL CLA			/SKIP IF SMALLER
	ISZ	XDVIMQ		/ELSE BUMP QUOTIENT
	ISZ	XDVICT		/SHIFTED ENOUGH?
	JMP	XDVILP		/NO, KEEP GOING
	DLD;	XDVIMQ		/GET FINAL VALUE
	ISZ	XDVI		/BUMP PAST ARGUMENT
	JMP I	XDVI		/RETURN

XDVIMQ,	.-.			/LOW-ORDER STORAGE OF PASSED VALUE
XDVIAC,	.-.			/HIGH-ORDER STORAGE OF PASSED VALUE
XDVICT,	.-.			/SHIFT COUNTER
XDIVSOR,.-.			/DIVISOR
/	SHIFT LEFT ROUTINE.

XSHL,	.-.			/SHIFT LEFT ROUTINE
	DCA	XSHLAC		/SAVE AC
	TAD I	XSHL		/GET ARGUMENT
	CMA			/INVERT IT
	DCA	XSHLCT		/STORE AS SHIFT COUNTER
	TAD	XSHLAC		/RESTORE AC
	JMP	XSHLIN		/CONTINUE THERE

XSHLUP,	SWP			/GET LOW-ORDER
	CLL RAL			/MOVE UP
	SWP			/PUT IT BACK AND GET HIGH-ORDER
	RAL			/MOVE UP
XSHLIN,	ISZ	XSHLCT		/DONE YET?
	JMP	XSHLUP		/NO, KEEP GOING
	ISZ	XSHL		/YES, BUMP AROUND ARGUMENT
	JMP I	XSHL		/RETURN

XSHLAC,	.-.			/AC TEMPORARY
XSHLCT,	.-.			/SHIFT COUNTER

/	MULTIPLY ROUTINE.

XMUY,	.-.			/MULTIPLY ROUTINE
	CLA CLL			/CLEAN UP
	TAD I	XMUY		/GET IN-LINE POINTER
	DCA	XMUYTMP		/STASH THE POINTER
	ISZ	XMUY		/BUMP PAST THE ARGUMENT
	TAD	(-15)		/SETUP THE
	DCA	XMUYCT		/SHIFT COUNTER
XMUYUP,	RAR			/SHIFT RIGHT
	SWP			/INTO LOW-ORDER; GET LOW-ORDER
	RAR			/SHIFT RIGHT
	SWP			/RETURN TO LOW-ORDER; GET ORIGINAL HIGH-ORDER
	ISZ	XMUYCT		/SHIFTED ENOUGH?
	SKP			/SKIP IF NOT
	JMP I	XMUY		/RETURN IF SO
	SNL			/LATEST BIT ON
	JMP	XMUYUP		/NO, JUST KEEP GOING
	CLL			/YES, CLEAR LINK FOR PROPER CARRY
	TAD I	XMUYTMP		/ADD ON ARGUMENT VALUE
	JMP	XMUYUP		/KEEP GOING

MDIVSOR,ZBLOCK	2		/DIVISOR (NEGATED)
XMUYCT,	.-.			/SHIFT COUNTER
XMUYTMP,.-.			/ARGUMENT TEMPORARY

	PAGE
/	SHIFT RIGHT ROUTINE.

XLSR,	.-.			/LOGICAL SHIFT RIGHT
	DCA	XLSRAC		/SAVE AC PART
	TAD I	XLSR		/GET SHIFT ARGUMENT
	CMA			/INVERT IT
	DCA	XLSRCT		/STORE AS SHIFT COUNTER
	TAD	XLSRAC		/RESTORE AC
	JMP	XLSRIN		/CONTINUE THERE

XLSRLP,	CLL RAR			/MOVE OVER
	SWP			/SWAP IT FOR LOW-ORDER
	RAR			/MOVE OVER
	SWP			/RESTORE
XLSRIN,	ISZ	XLSRCT		/DONE YET?
	JMP	XLSRLP		/NO, KEEP GOING
	ISZ	XLSR		/YES, BUMP PAST ARGUMENT
	JMP I	XLSR		/RETURN

XLSRAC,	.-.			/AC TEMPORARY
XLSRCT,	.-.			/SHIFT COUNT

/	NORMALIZE ROUTINE.

XNMI,	.-.			/NORMALIZE ROUTINE
	DCA	NMTMP		/SAVE AC FOR NOW
	DCA	SC		/CLEAR STEP COUNTER
	TAD	NMTMP		/RESTORE AC
	SNA			/NON-ZERO?
	MQA			/NO, TRY MQ
	SNA CLA			/SKIP IF SOMETHING SET
	JMP	NMFIN1		/JUMP IF NOTHING TO DO
NMLUP,	MQA			/GET LOW-ORDER
	RAL			/MOVE HIGH-ORDER BIT TO LINK
	CLA			/CLEAN UP
	TAD	NMTMP		/RESTORE HIGH-ORDER
	RAL			/MOVE OVER
	SPA			/SKIP IF NOT DONE
	JMP	NMFIN2		/JUMP IF WE'RE DONE
	DCA	NMTMP		/STORE BACK
	MQA			/GET LOW-ORDER
	CLL RAL			/MOVE OVER
	MQL			/STORE BACK
	ISZ	SC		/BUMP STEP COUNTER
	JMP	NMLUP		/KEEP GOING

NMFIN2,	CLA			/CLEAN UP
NMFIN1,	TAD	NMTMP		/RESTORE FINAL HIGH-ORDER
	JMP I	XNMI		/RETURN

NMTMP,	.-.			/AC TEMPORARY
SC,	.-.			/STEP COUNTER
MULDIV,	.-.			/MULTIPLY/DIVIDE COMMON ROUTINE
	TAD	MSDIV		/SETUP THE
	DCA I	(DIVROUTINE)	/SCALING ROUTINE FOR INPUT
	JMS I	(INCON)		/GET INPUT OPERAND
	NL4000			/SET SIGN BIT
	AND I	(HI)		/GET SIGN OF OPERAND
	DCA I	(MSIGN)		/STASH IT
	NL4000			/SET SIGN BIT
	AND I	(MACHI)		/GET SIGN OF MAC
	TAD I	(MSIGN)		/XOR WITH SIGN OF OPERAND
	SMA CLA			/SKIP IF FINAL RESULT IS NEGATIVE
	NL7777			/SET INVERSION SKIP VALUE
	DCA I	(MSIGN)		/SAVE FOR LATER
	TAD	MLSR		/SETUP THE
	DCA I	(DIVROUTINE)	/ADJUST ROUTINE FOR UNSIGNED SCALING
	JMP I	MULDIV		/RETURN

MLSR,	LSR10/LSR2		/UNSIGNED DIVIDE POINTER
MSDIV,	DIV10/DIV2		/SHORT DIVIDE POINTER

