	XLIST	OFF
	IFZERO	EAE	<
	XLIST	ON
/	DEFINITIONS FOR THIS PAGE.

	DAD=	JMS I	(XDAD)	/DOUBLE-PRECISION ADD
	DCM=	JMS I	(XDCM)	/DOUBLE-PRECISION TWO'S COMPLEMENT
	DLD=	JMS I	(XDLD)	/DOUBLE-PRECISION LOAD
	DST=	JMS I	(XDST)	/DOUBLE-PRECISION STORE

	XLIST	OFF	>
	XLIST	ON
/	INPUT CONVERSION ROUTINE.

INCON,	.-.			/INPUT CONVERSION
	DCA	SCALSW		/STORE PASSED SCALING SWITCH
	DCA I	(AERROR)	/PREVENT FALSE ADJUSTMENT ERRORS
	DCA	ASIGN		/ARITHMETIC SIGN IS INITIALLY PLUS BUT NOT SEEN
	JMS I	(INSETUP)	/SETUP INPUT ROUTINE
	DCA I	(DPCNT)		/CLEAR DIGITS-AFTER-DECIMAL-POINT COUNT
	DCA	DIGCNT		/CLEAR TOTAL DIGIT COUNT
	CAM			/CLEAN UP
	DST;	OPERAND		/CLEAR BINARY INPUT BUFFER
	NL7777			/SETUP
	DCA I	(OUTEXTRA)	/DELIMITER
	TAD	(OUTBUFFER)	/SETUP
	DCA	INPTR		/DIGIT POINTER
DIGLUP,	JMS I	(GETHAF)	/GET A CHARACTER
	SNA			/END OF STRING?
	JMP	ENDCHK		/YES
	TAD	(-"9!200-1)	/ADD ON LIMIT
	CLL			/CLEAR LINK FOR TEST
	TAD	("9-"0+1)	/ADD ON RANGE
	SNL			/SKIP IF A DIGIT
	JMP	CHKMORE		/JUMP IF OTHER
	DCA I	PLATEST/(LATEST)/SAVE LATEST DIGIT
	TAD I	PLATEST/(LATEST)/GET IT BACK
	DCA I	INPTR		/STORE IN THE BUFFER
	ISZ	INPTR		/BUMP TO NEXT
	ISZ	DIGCNT		/COUNT THIS DIGIT
	JMS I	(MUL10)		/MULTIPLY ACCUMULATION BY 10
	ISZ I	(MULSW)		/DID WE OVERFLOW?
	JMP	DIGOK		/NO, KEEP GOING
MULOVFL,NL0002			/YES, SET INPUT OVERFLOW BIT
	JMP I	(MDONE2)	/TAKE BAD EXIT THERE
DIGOK,	TAD I	(DPCNT)		/GET CURRENT AFTER-DECIMAL-POINT COUNT
	SZA CLA			/SKIP IF NONE YET
	ISZ I	(DPCNT)		/ELSE INCREMENT IT FOR THIS ONE
	DLD;	OPERAND		/GET THE CURRENT VALUE
	DAD;	PLATEST,LATEST	/ADD ON LATEST DIGIT
	DST;	OPERAND		/STORE IT BACK
	JMP	DIGLUP		/KEEP GOING

CHKMORE,TAD	(-" +"0)	/IS IT A <BLANK>?
	SNA			/SKIP IF NOT
	JMP I	(BLNKCHK)	/JUMP IF SO
	TAD	(-"++" )	/IS IT A "+"?
	SNA			/SKIP IF NOT
	JMP	GOTPLUS		/JUMP IF SO
	TAD	(-".+"+)	/IS IT A "."?
	SNA			/SKIP IF NOT
	JMP	GOTPOINT	/JUMP IF SO
	IAC/TAD	(-"-+".)	/IS IT A "-"?
	SNA			/SKIP IF NOT
	JMP	GOTMINUS	/JUMP IF SO
BADINPU,NL2000			/SET INPUT CONVERSION ERROR BIT
	JMP I	(MDONE)		/EXIT WITH COMPLAINT

GOTMINU,NL7776			/SET 7777 VALUE
GOTPLUS,IAC			/OR 0001 VALUE
	DCA	SGNTMP		/SAVE SIGN VALUE
	TAD	DIGCNT		/GET DIGIT COUNT
	SNA			/SKIP IF ANY
	TAD I	(DPCNT)		/ELSE CHECK DECIMAL POINT DIGIT COUNT
	SNA			/SKIP IF EITHER
	TAD	ASIGN		/GET SIGN
	SZA			/SKIP IF NONE SEEN
	JMP	BADINPUT	/JUMP IF SO
	TAD	SGNTMP		/GET VALUE
	DCA	ASIGN		/USE AS ARITHMETIC SIGN OF OPERAND
	JMP	DIGLUP		/KEEP GOING

GOTPOIN,TAD I	(DPCNT)		/GET DECIMAL POINT DIGIT COUNT
	SZA			/SKIP IF FIRST DECIMAL POINT SEEN
	JMP	BADINPUT	/ELSE COMPLAIN
	NL4000			/SET IT TO
	DCA I	(DPCNT)		/DECIMAL POINT SEEN (BUT NO DIGITS YET)
	JMP	DIGLUP		/KEEP GOING
ENDCHK,	TAD	DIGCNT		/ANY DIGITS SEEN?
	SNA CLA			/SKIP IF ANY
	JMP	BADINPUT	/ELSE COMPLAIN
	JMS I	(ADJZERO)	/REMOVE TRAILING ZEROES, ETC.
MEMENT,	ISZ	SCALSW		/SHOULD WE SCALE IT?
	SKP			/NO, LEAVE IT ALONE
	JMS I	(ADJUST)	/YES, SCALE TO INTERNAL FACTOR
	TAD I	(AERROR)	/GET ERROR FLAG
	SZA CLA			/SKIP IF NOT SET
	JMP	MULOVFLOW	/JUMP IF IT OVERFLOWED
	TAD	ADJSFT		/GET SOFT ERROR FLAG
	MQL			/INTO MQ FOR NOW
	TAD I	(MFLAGS)	/GET MAIN ERROR FLAGS
	MQA			/OR IN SOFT ERROR FLAG
	DCA I	(MFLAGS)	/STORE COMPOSITE
	DLD;	OPERAND		/GET OPERAND VALUE
	ISZ	ASIGN		/ARE WE POSITIVE?
	SKP			/SKIP IF SO
	DCM			/NEGATE IF NEGATIVE
	DST;	OPERAND		/STORE FINAL OPERAND VALUE
	CAM			/CLEAN UP
	JMP I	INCON		/RETURN

ADJSFT,	.-.			/SOFT ERROR FLAG
ASIGN,	.-.			/ARITHMETIC SIGN OF INPUT
DIGCNT,	.-.			/DIGIT COUNTER
INPTR,	.-.			/INPUT DIGIT POINTER
SCALSW,	.-.			/SCALING SWITCH
SGNTMP,	.-.			/SIGN TEMPORARY
	PAGE
BLNKCHK,TAD I	(DIGCNT)	/GET DIGIT COUNT
	SNA			/SKIP IF ANY
	TAD I	(DPCNT)		/ELSE ADD ON AFTER-DECIMAL-POINT COUNT
	SNA CLA			/SKIP IF EITHER
	JMP I	(DIGLUP)	/IGNORE BLANKS IF NEITHER
TOSSLUP,JMS	GETHAF		/GET THE NEXT CHARACTER
	SNA			/NOT <EOL>?
	JMP I	(ENDCHK)	/JUMP IF <EOL>
	TAD	(-" !200)	/COMPARE TO <SPACE>
	SNA CLA			/SKIP IF OTHER
	JMP	TOSSLUP		/ELSE KEEP TOSSING 'TIL <EOL>
	JMP I	(BADINPUT)	/BARF ON ILLEGAL IMBEDDED BLANKS

ADJZERO,.-.			/ADJUST FOR TRAILING ZEROES ROUTINE
	NL3777			/SET MASK
	AND I	(DPCNT)		/REMOVE DECIMAL POINT BIT
	CIA			/INVERT IT
	DCA I	(DPCNT)		/SAVE AS NEGATIVE COUNT OF DIGITS
	DCA I	(AERROR)	/PREVENT FALSE SCALING ERRORS
	DCA I	(ADJSFT)	/CLEAR SOFT ERROR FLAG NOW
	TAD I	(INPTR)		/GET DIGIT POINTER
	DCA	ENDPTR		/SAVE AS OUR POINTER
ADJZLP,	NL7777			/\
	TAD	ENDPTR		/ >BACKUP THE POINTER
	DCA	ENDPTR		//
	TAD I	ENDPTR		/GET LAST DIGIT
	SZA CLA			/SKIP IF TRAILING ZERO
	JMP	ADJZOK		/JUMP IF NOT
	TAD I	(MFLAGS)	/GET ERROR FLAGS
	AND	(7577)		/REMOVE OLD BIT
	TAD	(200)		/FORCE IT ON
	DCA I	(MFLAGS)	/STORE BACK
	JMS I	(DIV10)		/DIVIDE BY TEN
	ISZ I	(DPCNT)		/BACKUP AFTER-DECIMAL-POINT COUNT
	JMP	ADJZLP		/KEEP GOING
	JMP	ADJZLP		/JUST IN CASE
/	HALF-WORD ROUTINES.

GETHAF,	.-.			/GET A HALF-WORD ROUTINE
	CLA CLL			/CLEAN UP
	TAD	GETNDX		/GET INDEX VALUE
	RAR			/MOVE OVER
	TAD	GETBASE		/ADD ON BASE ADDRESS
	DCA	GTEMP		/STASH THE ADDRESS
GETCDF,	.-.			/GOTO BUFFER FIELD
	TAD I	GTEMP		/GET THE WORD
	CDF	MTHFLD		/BACK TO OUR FIELD
	SZL			/WANT EVEN HALF?
	JMP	GETODD		/NO, TAKE LOW-ORDER (ODD) HALF
	RTR;RTR;RTR		/BSW
GETODD,	AND	(77)		/JUST SIX-BIT
	ISZ	GETNDX		/BUMP FOR NEXT TIME
	JMP I	GETHAF		/RETURN

PUTHAF,	.-.			/PUT A HALF-WORD ROUTINE
	AND	(77)		/JUST SIX-BIT
	DCA	PTEMP1		/SAVE IT
	TAD	PUTNDX		/GET INDEX VALUE
	CLL RAR			/MOVE OVER
	TAD	PUTBASE		/ADD ON BASE ADDRESS
	DCA	PTEMP2		/STASH THE ADDRESS
PUTCDF,	.-.			/GOTO BUFFER FIELD
	TAD I	PTEMP2		/GET THE VALUE
	SZL			/EVEN HALF?
	JMP	PUTODD		/NO, STORE LOW-ORDER (ODD) HALF
	RTR;RTR;RTR		/MOVE OVER ODD HALF
	AND	(7600)		/REMOVE OLD EVEN HALF
	TAD	PTEMP1		/ADD ON NEW EVEN HALF
	RTL;RTL;RTL		/RESTORE BIT POSITIONS
	JMP	PUTCOMMON	/CONTINUE THERE

PUTODD,	AND	(7700)		/REMOVE OLD ODD HALF
	TAD	PTEMP1		/ADD ON NEW ODD HALF
PUTCOMM,DCA I	PTEMP2		/STORE COMPOSITE
	CDF	MTHFLD		/BACK TO OUR FIELD
	ISZ	PUTNDX		/BUMP FOR NEXT TIME
	JMP I	PUTHAF		/RETURN
ADJZOK,	TAD I	(BINDECMODE)	/GET ARITHMETIC MODE
	SZA CLA			/SKIP IF DECIMAL
	JMS I	(BINCON)	/ELSE CONVERT TO BINARY
ADJCALL,JMP I	ADJZERO		/RETURN

ENDPTR,	.-.			/DIGIT POINTER
GETBASE,.-.			/HALF-WORD INPUT BASE
GETNDX,	.-.			/HALF-WORD INPUT INDEX
GTEMP,	.-.			/TEMPORARY
LATEST,	ZBLOCK	2		/LATEST DIGIT
PTEMP1,	.-.			/TEMPORARY
PTEMP2,	.-.			/TEMPORARY
PUTBASE,.-.			/HALF-WORD OUTPUT BASE
PUTNDX,	.-.			/HALF-WORD OUTPUT INDEX

