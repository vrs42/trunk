	XLIST	OFF
	IFZERO	EAE	<
	XLIST	ON
/	DEFINITIONS FOR THIS PAGE.

	DAD=	JMS I	(XDAD)	/DOUBLE-PRECISION ADD
	DCM=	JMS I	(XDCM)	/DOUBLE-PRECISION TWO'S COMPLEMENT
	DLD=	JMS I	(XDLD)	/DOUBLE-PRECISION LOAD
	DST=	JMS I	(XDST)	/DOUBLE-PRECISION STORE

	XLIST	OFF	>
	XLIST	ON
/	OUTPUT CONVERSION ROUTINE.

MSTORE,	TAD I	(BINDECMODE)	/GET MODE BIT
	SZA CLA			/SKIP IF DECIMAL MODE
	JMP	CONFIRST	/JUMP IF BINARY MUST FIRST BE CONVERTED
	TAD I	(MADJST)	/GET POWER OF TEN
	DCA I	(DMADJST)	/STASH IT
	DLD;	MAC		/GET MATH ACCUMULATOR
	DST;	DECMAC		/STORE IN BUFFER
CONCOMM,CAM			/CLEAN UP
	TAD I	(DMACHI)	/GET SIGN WORD
	SPA CLA			/SKIP IF POSITIVE
	NL7777			/ELSE SET NEGATIVE VALUE
	DCA	SIGN		/STORE ARITHMETIC SIGN
	DLD;	DECMAC		/GET DECMAC
	SPA			/SKIP IF POSITIVE
	DCM			/ELSE NEGATE IT
	DST;	OPERAND		/SAVE IN OPERAND BUFFER
	CLA			/CLEAN UP
	TAD I	(ACOPTIONS)	/GET FORMAT WORD
	RTL;RTL;RAL		/MOVE OVER
	AND	(17)		/JUST FORMAT BITS
	DCA	OUTFMT		/SAVE FOR NOW
	TAD I	(ACOPTIONS)	/GET FORMAT WORD AGAIN
	SPA CLA			/SKIP IF POSITIVE FORMAT VALUE
	TAD	(7760)		/ELSE SET SIGN EXTENSION BITS
	TAD	OUTFMT		/ADD ON PASSED VALUE
	DCA	OUTFMT		/STORE COMPOSITE
	TAD I	(DMADJST)	/GET CURRENT INTERNAL SCALE
	DCA	OADJST		/STASH IT
SIZLUP,	TAD	OUTFMT		/GET DESIRED SCALE FACTOR
	CIA			/INVERT FOR TESTING
	TAD	OADJST		/COMPARE TO CURRENT INTERNAL VALUE
	SNA			/SKIP IF DIFFERENT
	JMP I	(SAMSCALE)	/JUMP IF THEY MATCH
	SMA			/SKIP IF SCALED TOO SMALL
	JMP	BIGGER		/JUMP IF SCALED TOO LARGE
	IAC			/CHECK IF ONLY ONE DECADE AWAY
	SZA CLA			/SKIP IF SO
	JMP	SMALLER		/JUMP IF MORE THAN ONE
	DLD;	OPERAND		/GET THE VALUE
	DAD;	L5		/ADD ON .5 OF NEXT DIGIT FOR ROUNDING
	DST;	OPERAND		/STORE BACK
SMALLER,JMS I	(DIV10)		/DIVIDE BY TEN
	ISZ	OADJST		/ADJUST SCALING FACTOR
	NOP			/JUST IN CASE
	JMP	SIZLUP		/KEEP GOING

CONFIRS,JMS I	(CONDEC)	/CONVERT BINARY MAC => DECMAC
	JMP	CONCOMMON	/CONTINUE THERE

BIGGER,	JMS I	(MUL10)		/MULTIPLY BY TEN
	ISZ I	(MULSW)		/DID WE OVERFLOW?
	SKP			/SKIP IF NOT
	JMP	OOVFLOW		/JUMP IF SO
	NL7777			/ADJUST
	TAD	OADJST		/THE
	DCA	OADJST		/SCALING FACTOR
	JMP	SIZLUP		/KEEP GOING

OOVFLOW,TAD	(100)		/SET CONVERSION OVERFLOW BIT
	JMP I	(MDONE)		/FINISH THERE

OADJST,	.-.			/OUTPUT SCALE TEMPORARY
OUTFMT,	.-.			/OUTPUT SCALE
SIGN,	.-.			/ARITHMETIC SIGN OF MAC

/	INTERNAL OUTPUT BUFFER.

OUTEXTR,.-.			/EXTRA DIGIT BUFFER
OUTBUFF,ZBLOCK	2/10		/NUMERICAL OUTPUT BUFFER
SQULO,	ZBLOCK	2		/LOW-ORDER SQUARE-ROOT TEMPORARY
SQUHIGH,ZBLOCK	2		/HIGH-ORDER SQUARE-ROOT TEMPORARY
SQUTEMP,ZBLOCK	2		/EXTRA SQUARE-ROOT TEMPORARY

/	DOUBLE-PRECISION CONSTANTS.

L5,	5;	0		/CONSTANT 0000 0005
	PAGE
/	OUTPUT THE BCD DIGITS IN REVERSE ORDER BY PROGRESSIVE DIVISION.

SAMSCAL,TAD	(OUTBUFFER+7+1)	/SETUP THE
	DCA	OUTPTR		/OUTPUT POINTER
	TAD	(-10)		/SETUP THE
	DCA	OUTCNT		/DIGIT COUNTER
OUTLP1,	NL7777			/\
	TAD	OUTPTR		/ >BACKUP THE POINTER
	DCA	OUTPTR		//
	JMS I	(DIV10)		/DIVIDE BY 10
	TAD I	(REM10)		/GET LOW DIGIT
	DCA I	OUTPTR		/STORE IN OUTPUT BUFFER
	ISZ	OUTCNT		/DONE ALL YET?
	JMP	OUTLP1		/NO, KEEP GOING

/	LEFT-ZERO SUPPRESSION.

	TAD	(-10)		/SETUP THE
	DCA	OUTCNT		/DIGIT COUNTER
	DCA	LZFLAG		/CLEAR LEFT-ZERO FLAG
OUTLP2,	TAD I	OUTPTR		/GET A DIGIT
	TAD	LZFLAG		/ADD ON FLAG
	SNA			/SKIP IF SIGNIFICENT
	JMP	OUTBLNK		/ELSE MAKE IT A <SPACE>
	NL4000			/SETUP FORCED SIGNIFICENCE
	DCA	LZFLAG		/STORE FORCED-ON FLAG
	SKP			/DON'T USE <SPACE>!
OUTBLNK,TAD	(" -"0)		/CONVERT TO <SPACE> IF NOT SIGNIFICENT
	TAD I	OUTPTR		/ADD ON DIGIT
	TAD	("0&177)	/CONVERT TO ASCII
	DCA I	OUTPTR		/STORE PRINTABLE DIGIT (OR <SPACE>)
	ISZ	OUTPTR		/BUMP TO NEXT
	ISZ	OUTCNT		/DONE ALL DIGITS?
	JMP	OUTLP2		/NO, KEEP GOING

/	LEADING ZERO AND SIGNIFICENT ZERO INSERTION.

	TAD	(" &177)	/RESET THE EXTRA
	DCA I	(OUTEXTRA)	/DIGIT POSITION
	TAD I	(OUTFMT)	/GET DESIRED OUTPUT SCALE
	SPA CLA			/SKIP IF NO DECIMAL POINTS
	JMP	FRCHECK		/JUMP IF FRACTIONAL OUTPUT
	NL7777			/SETUP FOR INTEGER-TYPE OUTPUT
	JMP	CHKCOMMON	/CONTINUE THERE

FRCHECK,TAD I	(OPCODE)	/GET SPECIAL BITS
	AND	(400)		/ISOLATE LEADING ZERO BIT
	SNA CLA			/SKIP IF LEADING ZERO DISABLED
	NL7777			/ELSE ONE EXTRA POSITION IS NEEDED
	TAD I	(OUTFMT)	/ADD ON FRACTIONAL COUNT
CHKCOMM,DCA	OUTCNT		/SAVE TOTAL DIGIT CHECKING COUNT
OUTLP3,	NL7777			/\
	TAD	OUTPTR		/ >BACKUP THE POINTER
	DCA	OUTPTR		//
	TAD I	OUTPTR		/GET A DIGIT
	TAD	(-" !200)	/WAS IT CONVERTED TO <SPACE>?
	SNA CLA			/SKIP IF NOT
	TAD	("0-" )		/CONVERT BACK TO "0"
	TAD I	OUTPTR		/ADD ON ORIGINAL
	DCA I	OUTPTR		/STORE BACK
	ISZ	OUTCNT		/DONE YET?
	JMP	OUTLP3		/NO, KEEP GOING

/	COUNT UP MINIMUM REQUIRED FIELD WIDTH.

	TAD	(-11)		/SETUP THE MAXIMUM DIGIT COUNT
	DCA	OUTCNT		/(INCLUDING THE LEADING ZERO)
	TAD	(OUTBUFFER+7+1)	/SETUP THE
	DCA	OUTPTR		/OUTPUT POINTER
OUTLP4,	NL7777			/\
	TAD	OUTPTR		/ >BACKUP THE POINTER
	DCA	OUTPTR		//
	TAD I	OUTPTR		/GET A CHARACTER
	TAD	(-" !200)	/IS IT A <SPACE>?
	SNA CLA			/SKIP IF NOT
	JMP	OCOUNT		/JUMP IF SO
	ISZ	OUTCNT		/CHECKED ALL?
	JMP	OUTLP4		/NO, KEEP GOING

/	ADJUST MINIMUM FIELD WIDTH.

OCOUNT,	TAD	OUTCNT		/GET REMAINING COUNT
	TAD	(11)		/ADJUST TO DIGIT COUNT
	DCA	SDCNT		/SAVE SIGNIFICENT DIGIT COUNT
	DCA	DPSW		/CLEAR DECIMAL POINT COUNT
	DCA	SIGNEXTRA	/CLEAR EXTRA SIGN CHARACTER COUNT
	TAD I	(OPCODE)	/GET SPECIAL BITS
	SMA CLA			/SKIP IF NO LEADING POSITIVE SIGN CHARACTER
	JMP	O1MORE		/JUMP IF LEADING POSITIVE SIGN CHARACTER
	TAD I	(SIGN)		/GET SIGN OF OUTPUT
	SPA CLA			/SKIP IF POSITIVE
O1MORE,	ISZ	SIGNEXTRA	/COUNT LEADING SIGN CHARACTER
	TAD I	(OUTFMT)	/GET OUTPUT SCALE
	SPA CLA			/SKIP IF INTEGER OUTPUT
	ISZ	DPSW		/COUNT DECIMAL POINT
	TAD I	(ACOPTIONS)	/GET FORMAT WORD
	AND	(17)		/JUST FIELD WIDTH BITS
	CIA			/INVERT FOR TESTING
	TAD	SDCNT		/ADD ON SIGNIFICENT DIGIT COUNT
	TAD	SIGNEXTRA	/ADD SIGN CHARACTER COUNT
	TAD	DPSW		/ADD DECIMAL POINT COUNT
	SPA SNA			/SKIP IF TOO LARGE
	JMP	OSIZOK		/JUMP IF IT FITS
	NL0004			/SET WIDTH ERROR BIT
	JMP I	(MDONE)		/BARF THERE
OSIZOK,	DCA I	(PADCNT)	/SAVE LEADING BLANK COUNT
	JMP I	(OMORE)		/CONTINUE THERE

DPSW,	.-.			/DECIMAL POINT SWITCH
LZFLAG,	.-.			/LEFT-ZERO SUPPRESSION FLAG
OUTCNT,	.-.			/DIGIT COUNTER
OUTPTR,	.-.			/DIGIT POINTER
SDCNT,	.-.			/SIGNIFICENT DIGIT COUNT
SIGNEXT,.-.			/LEADING SIGN CHARACTER SWITCH

