	DCM			/ELSE TAKE ABSOLUTE VALUE
	DST;	AOPERAND	/STORE IN WORK AREA
	DLD;	MAC		/GET MATH AC
	SPA			/SKIP IF POSITIVE
	DCM			/ELSE TAKE ABSOLUTE VALUE
	DST;	AMAC		/STORE IN WORK AREA
	CLA			/START WITH LOW-ORDER IN MQ
	MUY;	AOPERAND	/MULTIPLY BY LOW-ORDER OPERAND
	DST;	OPERAND		/STORE IN LOW-ORDER PAIR OF ANSWER
	CAM			/CLEAN UP
	DST;	HIGHER		/CLEAR HIGH-ORDER PAIR OF ANSWER BUFFER NOW
	TAD	AMACLO		/GET LOW-ORDER MAC AGAIN
	MQL			/PUT INTO MQ
	MUY;	AHI		/MULTIPLY BY HIGH-ORDER OPERAND
	DAD;	HI		/ADD ON MIDDLE PAIR
	DST;	HI		/STORE BACK IN MIDDLE PAIR
	CAM			/CLEAN UP
	TAD	AMACHI		/GET HIGH-ORDER MAC
	MQL			/PUT INTO MQ
	MUY;	AOPERAND	/MULTIPLY BY LOW-ORDER OPERAND
	DAD;	HI		/ADD ON MIDDLE PAIR
	DST;	HI		/STORE IN MIDDLE PAIR
	SZL CLA			/CARRY?
	ISZ I	(HIGHEST)	/YES, SET CARRY IN HIGHEST WORD
	TAD	AMACHI		/GET HIGH-ORDER MAC
	MQL			/PUT INTO MQ
	MUY;	AHI		/MULTIPLY BY HIGH-ORDER OPERAND
	DAD;	HIGHER		/ADD ON HIGH-ORDER PAIR
	DST;	HIGHER		/STORE IN HIGH-ORDER PAIR
	CAM			/CLEAN UP
	JMP I	MULTIPLY	/RETURN
	AOPERAN=.		/WORK AREA FOR OPERAND

ALO,	.-.			/WORK AREA FOR OPERAND - LOW-ORDER
AHI,	.-.			/WORK AREA FOR OPERAND - HIGH-ORDER

	AMAC=	.		/WORK AREA FOR MAC

AMACLO,	.-.			/WORK AREA FOR MAC - LOW-ORDER
AMACHI,	.-.			/WORK AREA FOR MAC - HIGH-ORDER

	DAC=	.		/DIVIDE "AC"

DACLO,	.-.			/DIVIDE AC - LOW-ORDER
DACHI,	.-.			/DIVIDE AC - HIGH-ORDER
DIVCNT,	.-.			/SHIFT COUNTER
DIVLNK,	.-.			/LINK SAVED HERE
DIVTMP,	.-.			/TEMPORARY

	DMQ=	.		/DIVIDE "MQ"

DMQLO,	.-.			/DIVIDE MQ - LOW-ORDER
DMQHI,	.-.			/DIVIDE MQ - LOW-ORDER

