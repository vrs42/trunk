/	ARITHMETIC INTERPRETER FOR ALL FUNCTIONS.

/	CALLING SEQUENCE:

/	CDF	MYFLD		/SET CALLING DATA FIELD
/	CIF	MTHFLD		/GOTO PACKAGE FIELD
/	TAD	(ERRORADDRESS)	/AC CONTAINS ERROR HANDLING ADDRESS
/	JMS I	(MINTERPRETER)	/CALL INTERPRETER
/	INLINE PSEUDO-INSTRUCTIONS HERE

/	ALL ERRORS WILL RETURN THROUGH THE DEDICATED ERROR ADDRESS.

/	EXAMINING THE HEADER OF "MINTERPRETER" WILL DETERMINE WHICH
/	PSEUDO-INSTRUCTION ACTUALLY FAILED.

/	ALLOWED PSEUDO-OPERATIONS:

/	CLEAR			/CLEAR MAC
/	SETFLD;	FIELD&70	/SETUP OPERAND FIELD (IMMEDIATE)
/	ADD;	OPERAND		/ADD OPERAND TO MAC
/	SUB;	OPERAND		/SUBTRACT OPERAND FROM MAC
/	MUL;	OPERAND		/MULTIPLY MAC BY OPERAND
/	DIV;	OPERAND		/DIVIDE MAC BY OPERAND
/	FUNCTIO;(FUNCTION #)	/PERFORM INDICATED FUNCTION ON MAC
/	MACOUT;	OPERAND		/OUTPUT MAC TO OPERAND BUFFER
/	SETFORM;FORMAT		/SETUP OUTPUT FORMAT (IMMEDIATE)
/	SETOUT;	SPECIALS	/SETUP SPECIAL OUTPUT BITS (IMMEDIATE)
/	SETUP;	SCALEFACTOR	/SET SCALING, CLEAR AND I/O MODE (IMMEDIATE)
/	STORE;	OPERAND		/OUTPUT MAC TO OPERAND BUFFER
/	ISUB;	OPERAND		/SUBTRACT MAC FROM OPERAND
/	IDIV;	OPERAND		/DIVIDE OPERAND BY MAC
/	EXIT			/EXIT INTERPRETER

MINTERP,.-.			/INTERPRETER ENTRY POINT
	DCA	MERRADRESS	/STASH PASSED ERROR-HANDLING ADDRESS
	RDF			/GET CALLING FIELD
	TAD	(CDF)		/MAKE INTO CDF CALLING FIELD INSTRUCTION
	DCA	MINTLUP		/STORE IN-LINE
	NL0002			/SET CIF BIT
	TAD	MINTLUP		/MAKE INTO CIF CDF CALLING FIELD INSTRUCTION
	DCA	MINTXT		/STORE IN-LINE
MINTLUP,.-.			/WILL BE CDF CALLING FIELD
	TAD I	MINTERPRETER	/GET NEXT OPCODE
	SPA CLA			/SKIP IF NOT EXIT VALUE
	JMP	MINTXT		/JUMP IF EXIT VALUE
	TAD I	MINTERPRETER	/GET OPCODE AGAIN
	AND	(7)		/JUST REAL OPCODE BITS
	TAD	SCLWRD		/ADD ON INPUT SCALING FACTOR
	TAD	SFIELD		/ADD ON FIELD BITS
	DCA	MICAL1		/STORE IN-LINE
	TAD I	MINTERPRETER	/GET OPCODE WORD AGAIN
	AND	(17)		/JUST OPCODE BITS
	TAD	(JMP I	MINTABL)/MAKE INTO JUMP INSTRUCTION
	DCA	MINTMP		/STORE IN-LINE
MINTMP,	.-.			/WILL BE CORRECT JUMP INSTRUCTION
/	DISPATCH TABLE.

MINTABL,MICLEAR			/CLEAR MAC
	MIADD			/ADD OPERAND TO MAC
	MISUB			/SUBTRACT OPERAND FROM MAC
	MIMUL			/MULTIPLY MAC BY OPERAND
	MIDIV			/DIVIDE MAC BY OPERAND
	MIFUN			/PERFORM INDICATED FUNCTION ON MAC
	MIOUTPUT		/OUTPUT MAC INTO OPERAND
	MISETUP			/SETUP INTERNAL SCALE FACTOR AND POSSIBLY CLEAR MAC
	MISTFLD			/SETUP OPERAND FIELD
	MISTOUTPUTSPECIALBITS	/SETUP OUTPUT SPECIAL BITS
	MIISUB			/SUBTRACT MAC FROM OPERAND
	MISTFORMAT		/SETUP OUTPUT FORMAT WORD
	MIIDIV			/DIVIDE OPERAND BY MAC
	MIBARF			/ERROR
	MIBARF			/ERROR
	MIBARF			/ERROR

MISTFLD,ISZ	MINTERPRETER	/BUMP TO FIELD WORD
	TAD I	MINTERPRETER	/GET THE FIELD WORD
	AND	(70)		/JUST FIELD BITS
	DCA	SFIELD		/STASH IT
	JMP	MINEXT		/KEEP GOING

MISTFOR,ISZ	MINTERPRETER	/BUMP TO FORMAT WORD
	TAD I	MINTERPRETER	/GET THE FORMAT WORD
	DCA	FORMWRD		/STASH IT
	JMP	MINEXT		/KEEP GOING

MISTOUT,ISZ	MINTERPRETER	/BUMP TO SPECIAL BITS WORD
	TAD I	MINTERPRETER	/GET THE SPECIAL BITS WORD
	DCA	OUTSPECIALS	/STASH IT
	JMP	MINEXT		/KEEP GOING

MIFUN,	ISZ	MINTERPRETER	/BUMP TO FUNCTION NUMBER
	TAD I	MINTERPRETER	/GET FUNCTION NUMBER
	JMP	MICLEAR		/CONTINUE THERE

MIOUTPU,TAD	MICAL1		/GET FIRST IN-LINE ARGUMENT
	AND	(77)		/RETAIN FIELD AND OPCODE BITS
	TAD	OUTSPECIALS	/ADD ON SPECIAL BITS
	DCA	MICAL1		/STORE BACK
	TAD	FORMWRD		/GET AC FORMAT WORD
	SKP			/USE OUR VALUE
MIISUB,				/ISUB - SET INVERSE VALUE
MIIDIV,	NL7777			/IDIV - SET INVERSE VALUE
MIADD,				/ADD - SET NORMAL VALUE
MISUB,				/SUB - SET NORMAL VALUE
MIMUL,				/MUL - SET NORMAL VALUE
MIDIV,	DCA	MISW		/SAVE SWITCH VALUE
	ISZ	MINTERPRETER	/BUMP TO OPERAND
	TAD I	MINTERPRETER	/GET OPERAND ADDRESS
	DCA	MICAL2		/STORE IN-LINE
	TAD	MISW		/GET SWITCH VALUE
MICLEAR,CDF	MTHFLD			/SET OUR FIELD
	JMS I	(MTHPAK)		/CALL THE PACKAGE
MICAL1,	.-.				/OPCODE WORD
MICAL2,	.-.				/BUFFER WORD
	JMP	MINTXT			/BARF!
MINEXT,	ISZ	MINTERPRETER		/BUMP PAST OPERAND
	JMP	MINTLUP			/KEEP GOING

MISETUP,ISZ	MINTERPRETER		/BUMP TO OPERAND
	TAD	MICAL1			/GET FIRST IN-LINE ARGUMENT
	AND	(77)			/RETAIN FIELD AND OPCODE
	DCA	MICAL1			/STORE IT BACK
	TAD I	MINTERPRETER		/GET SCALING FACTOR
	AND	(7400)			/RETAIN ADJUST BITS
	DCA	SCLWRD			/SAVE THEM
	TAD	MICAL1			/GET FIRST ARGUMENT WORD
	TAD	SCLWRD			/ADD ON OTHER BITS
	DCA	MICAL1			/STORE IN-LINE
	TAD I	MINTERPRETER		/GET ARGUMENT AGAIN
	AND	(BINARY!SAVE!MEMODE)	/ISOLATE MEMORY, SAVE BITS
	CLL RTR;RAR			/MOVE OVER
	DCA	MINTMP			/SAVE FOR NOW
	TAD I	MINTERPRETER		/GET ARGUMENT AGAIN
	AND	(SFTIGNORE!TRIGNORE)	/JUST MASKABLE ERROR BITS
	CLL RTL				/MOVE UP TO WHERE THEY BELONG
	TAD	MINTMP			/GET OTHER BITS
	JMP	MICLEAR			/CONTINUE THERE

MIBARF,	NL7777				/SET BARF VALUE
MINTXT,	.-.				/WILL BE CIF CDF RETURN FIELD
	SZA				/SKIP IF NO ERRORS
	JMP I	MERRADRESS		/ELSE GOTO ERROR HANDLER
	ISZ	MINTERPRETER		/BUMP PAST LAST OPERAND
	JMP I	MINTERPRETER		/RETURN TO CALLER

FORMWRD,.-.				/FORMAT WORD
MERRADR,.-.				/ERROR-HANDLING ADDRESS
MISW,	.-.				/INVERSION SWITCH
OUTSPEC,.-.				/OUTPUT SPECIAL BITS
SCLWRD,	.-.				/INPUT SCALING FACTOR
SFIELD,	.-.				/OPERAND FIELD

	PAGE
ADJUST,	.-.				/SCALING ROUTINE
	DCA	AERROR			/CLEAR ERROR FLAG
	DCA I	(ADJSFT)		/CLEAR SOFT ERROR FLAG
ADJLUP,	TAD I	(MADJST)		/GET SCALING FACTOR
	CIA				/INVERT IT
	TAD I	(DPCNT)			/COMPARE TO DECIMAL POINT DIGIT COUNT
	SNA				/SKIP IF NON-MATCHING
	JMP I	ADJUST			/RETURN IF IT MATCHES
	SPA CLA				/SKIP IF OUR UNITS ARE TOO BIG
	JMP	ADJDWN			/JUMP IF OUR UNITS ARE TOO SMALL
	JMS I	MULROUTINE		/SCALE UP BY TEN OR TWO
	ISZ I	(MULSW)			/OVERFLOW?
	JMP	ADJOK			/NO, KEEP GOING
	ISZ	AERROR			/INDICATE SCALING OVERFLOW
	JMP I	ADJUST			/RETURN WITH ERROR SET

ADJOK,	NL7777				/BACKUP THE
	TAD I	(DPCNT)			/DIGIT COUNT
	DCA I	(DPCNT)			/STORE BACK
	JMP	ADJLUP			/TRY AGAIN

ADJDWN,	JMS I	DIVROUTINE		/SCALE DOWN BY TEN OR TWO
	TAD	(200)			/SET THE
	DCA I	(ADJSFT)		/SOFT ERROR FLAG
	TAD I	(REM10/REM2)		/GET REMAINDER FROM DIVIDE
	SNA CLA				/SKIP IF WE LOST ANYTHING
	JMP	ADJDOK			/JUMP IF NOT
	TAD I	(MFLAGS)		/GET THE ERROR FLAGS
	AND	(-400-1)		/REMOVE OLD BIT
	TAD	(400)			/FORCE ON NEW TRUNCATION BIT
	DCA I	(MFLAGS)		/STORE IT BACK
ADJDOK,	ISZ I	(DPCNT)			/ADJUST DIGIT COUNT
	JMP	ADJLUP			/KEEP GOING
	JMP	ADJLUP			/JUST IN CASE

AERROR,	.-.				/OVERFLOW ERROR FLAG
DIVROUT,DIV10/DIV1048 OR DIV2/DIV248	/POINTER TO DIVIDE ROUTINE
MULROUT,MUL10/OR MUL2			/POINTER TO MULTIPLY ROUTINE

