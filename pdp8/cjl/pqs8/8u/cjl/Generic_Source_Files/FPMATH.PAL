/	SETUP OPERATION.

MSETUP,	TAD I	(ACOPTIONS)	/GET PASSED AC
	AND	(600)		/JUST MASKABLE BITS
	CMA			/INVERT TO FORM MASK
	DCA I	(MMASK)		/STORE NEW MASK
	TAD I	(OPCODE)	/GET OPCODE WORD AGAIN
	RTL;RTL;RAL		/MOVE SCALE TO LOW-ORDER BITS
	AND	(17)		/ISOLATE SCALE BITS
	DCA I	(MADJST)	/SAVE FOR NOW
	NL0001			/SET MASK
	AND I	(ACOPTIONS)	/GET ARITHMETIC MODE BIT
	CLL RAR			/PUT INTO LINK
	SNL			/SKIP IF BINARY MODE
	TAD I	(OPCODE)	/GET SIGN OF SCALE IF DECIMAL MODE
	SPA CLA			/SKIP IF POSITIVE SCALE (OR BINARY MODE)
	TAD	(7760)		/SET SIGN EXTENSION BITS FOR NEGATIVE DECIMAL SCALES
	TAD I	(MADJST)	/ADD ON SCALE BITS
	DCA I	(MADJST)	/STORE BACK
	SNL			/BINARY MODE?
	JMP	MSET10		/NO, LEAVE IT AS DECIMAL SIGNED SCALE
	TAD I	(MADJST)	/YES, GET BACK OFFSET
	TAD	(TAD	BTABLE)	/FORM TABLE INSTRUCTION
	DCA	.+1		/STORE IN-LINE
	.-.			/GET PROPER TABLE MEMBER
	DCA I	(MADJST)	/STORE BINARY SCALE
MSET10,	TAD	(DIV10)		/GET DECIMAL SHORT DIVIDE POINTER
	SZL			/SKIP IF DECIMAL MODE
	TAD	(DIV2-DIV10)	/ELSE MAKE IT BINARY SHORT DIVIDE
	DCA I	(ASDIV)		/STORE AS THEIR POINTER
	TAD I	(ASDIV)		/GET IT BACK
	DCA I	(MSDIV)		/STORE AS THEIR POINTER ALSO
	TAD	(DIV1048)	/GET DECIMAL LONG DIVIDE POINTER
	SZL			/SKIP IF DECIMAL MODE
	TAD	(DIV248-DIV1048)/ELSE MAKE IT BINARY LONG DIVIDE
	DCA I	(MLDIV)		/STORE AS THEIR POINTER
	TAD	(MUL10)		/GET DECIMAL SHORT MULTIPLY POINTER
	SZL			/SKIP IF DECIMAL MODE
	TAD	(MUL2-MUL10)	/ELSE MAKE IT BINARY SHORT MULTIPLY
	DCA I	(MULROUTINE)	/STORE THEIR POINTER
	TAD	(LSR10)		/GET DECIMAL UNSIGNED DIVIDE BY TEN POINTER
	SZL			/SKIP IF DECIMAL MODE
	TAD	(LSR2-LSR10)	/ELSE MAKE IT BINARY UNSIGNED DIVIDE BY TEN
	DCA I	(MLSR)		/STORE THEIR POINTER
	RTL			/GET MODE BIT BACK
	DCA I	(BINDECMODE)	/SAVE AS BASIC ARITHMETIC MODE BIT
	TAD I	(ACOPTIONS)	/GET AC OPTION BITS
	CLL RAL			/MOVE UP
	DCA I	(IOSW)		/SAVE MEMORY/TEXT MODE SWITCH
	SZL			/DO WE CLEAR?
	JMP I	(MDONE)		/NO, FORGET IT
