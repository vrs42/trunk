	ATX	2		/SAVE IN AN INDEX.
	JGE	MCPRTD		/IF NO PLACES THEN EXIT.
MCPRTL,	JSA	MCGETD		/GET A DIGIT NOW.
	JSA	MCPUTC		/PRINT IT.
	JXN	MCPRTL,2+	/LOOP UNTIL ALL DONE.
	JA	MCPRTD		/THEN RETURN NOW.
