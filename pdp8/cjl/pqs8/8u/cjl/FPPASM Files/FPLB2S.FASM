/
ATAN,	JA	.		/NEW ARCTANGENT ROUTINE.
	LDX	-1,0		/REMEMBER SIGN
	JGE	.+5
	LDX	0,0		/SAVE THE SIGN.
	FNEG			/NEGATE THE FAC [ABS]
	FSTA	MCRTP1		/AND STORE AWAY.
	FSTA	MCRTP2
	FSUB	ATANC1		/TEST TO SEE IF TOO SMALL.
	JLE	ATANBG		/IT IS. ATAN(X)=X
	FSUB	ATANC2		/TEST TO SEE IF TOO BIG.
	JLE	ATANLW		/IT ISNT.
	FLDA	FPPONE		/TO BIG. INVERT IT.
	FDIV	MCRTP1
	FSTA	MCRTP1
/
ATANLW,	FCLA			/CLEAR OUT TEMP.
	FSTA	MCRTP3
	FLDA	MCRTP1		/RECALL NUMBER.
	FSUB	ATANC3		/START THE KNOCKING OFF PROCESS.
	JLT	ATANNT		/WRONG SECTOR.
	FLDA	ATANC4		/BOP UP ORIGINAL.
	FADDM	MCRTP1
	FLDA	ATANCJ		/GET MAGIC NUMBER.
	FDIV	MCRTP1
	FADD	ATANC4
	FSTA	MCRTP1
	FLDA	ATANC5
	FSTA	MCRTP3
/
ATANNT,	FLDA	MCRTP1		/RECALL AND SQUARE IT.
	FMUL	MCRTP1
	FSTA	MCRTP4		/YET ANOTHER TEMP.
	FLDA	ATANC6
	FMUL	MCRTP4
	FADD	ATANC7
	FMUL	MCRTP4
	FADD	ATANC8
	FMUL	MCRTP4
	FADD	ATANC9
	FMUL	MCRTP4
	FADD	FPPONE
	FMUL	MCRTP1
	FADD	MCRTP3
	FSTA	MCRTP1
	FLDA	MCRTP2
	FSUB	FPPONE
	JLE	ATANBG
	FLDA	ATANCH
	FSUB	MCRTP1
	JA	.+3
/
ATANBG,	FLDA	MCRTP1
	JXN	ATAN,0
	FNEG
	JA	ATAN
/
