	FLDA	EXPFUD		/AN EXIT.
EXP,	JA	.		/ENTRY
	LDX	-1,0		/PRESERVE SIGN.
	JGE	.+5
	FNEG			/IF NEGATIVE NEGATE IT.
	LDX	0,0		/AND REMEMBER IT,BUBBY.
	FMUL	EXP2E		/MULTIPLY TO BINARY TYPE.
	FSTA	MCRTP1		/AND SAVE IT AWAY.
	JAL	EXPER		/CAN T FIX IT, ERROR.
	ALN	0		/FIX IT UP.
	FSTA	MCRTP3		/AND SAVE IT.
	FNORM			/NOW NORMALIZE FOR OUR COMPUTATIONS.
	FNEG			/NEGATE THE FAC
	FADD	MCRTP1		/ADD IN BEFORE NORMAL.
	FSTA	MCRTP1		/AND STORE BACK. NO FADDM
	FMUL	MCRTP1		/NOW SQUARE IT.
	FSTA	MCRTP2		/AND SAVE IT.
	FADD	EXPDF		/START THE ITERATION.
	FSTA	MCRTP4		/SAVE IN ANOTHER TEMP.
	FLDA	EXPCF		/NEXT CONSTANT.
	FDIV	MCRTP4		/AND DIVIDE INTO IT.
	FSUB	MCRTP1		/SUBTRACT BACK NOW.
	FADD	EXPAF		/NEXT CONSTANT.
	FSTA	MCRTP4		/AND SAVE AGAIN. KEEP THIS UP.
	FLDA	EXPBF
	FMUL	MCRTP2
	FADDM	MCRTP4
	FLDA	MCRTP1
	FDIV	MCRTP4
	FMUL	FPPTWO
	FADD	FPPONE
	FSTA	EXPFUD		/NOW FIDDLE THE EXPONENT.
	STARTD
	FLDA	MCRTP3
	FADDM	EXPFUD-1	/EXPONENT UPDATE.
	STARTF
	JXN	EXP-2,0		/NO INVERSION NECESSARY. RETURN.
	FLDA	FPPONE		/INVERT IT
	FDIV	EXPFUD
	JA	EXP
