/
/
/
/
/
/	THIS IS THE SQUARE ROOT PROGRAM.
/
/	THE ARGUMENT IS WRITTEN IN THE FORM:
/		X=F*(2**2B)   WHERE 0<X<1
/
/	SQRT(X) IS THEN CALCULATED AS SQRT(F)*2**B
/	SQRT(X) IS CALCULATED BY A LINEAR APPROXIMATION, THE NATURE OF
/	WHICH ON WHETHER 1/4<F<1/2 OR 1/2<F<1,
/	FOLLOWED BY TWO ITERATIONS OF NEWTON METHOD.
/
/
/
/
/
/
/
/	NOTE: ENTRY IS NEAR END OF ROUTINE.
/
/
/
SQRTOK,	FSTA	SQRTEX+1	/SAVE NUMBER AWAY FOR A SECOND.
	FLDA	SQRT13		/GET A RIGHT ADJUSTED 13 IN THE FAC.
	FSTA	SQRTEX-2	/STORE AWAY RIGHT AHEAD OF THE EXPONENT.
	FLDA	SQRTEX		/NOW RETREIVE THE EXPONENT AS HIGH ORDER WORD.
	ALN	0		/CHOP OFF CRAP.
	JEQ	SQRTSC		/IS IT EXACTLY ZERO? IF SO, SPECIAL CASE.
	FNORM			/NORMALIZE IT.
	FSUB	FPPONE		/NOW SUBTRACT ONE FROM IT.
	FDIV	FPPTWO		/CHOP IT IN HALF NOW.
	FSTA	MCRTP1		/AND SAVE 1/2 EXP IN A TEMP.
	ALN	0		/NOW FIX THE EXPONENT.
	FNORM			/AND NORMALIZE IT TO REMOVE UNDESIRABLE BITS.
	FSUB	MCRTP1		/NOW SUBTRACT OFF EXTRANEOUS BITS.
	FMUL	FPPTWO		/EXPAND IT AGAIN [FAC =0 OR -1], OR 0 TO +1
	JGE	.+3		/MAKE SURE ITS POSITIVE.
	FNEG			/NOW MAKE IT 0 IF NO BIT OR +1 IF BIT
SQRTBK,	ATX	1		/SAVE IN AN INDEX.
	FSUB	FPPONE		/SUBTRACT ONE TO MAKE IT -1 IF NO BIT OR 0 IF BIT.
	ALN	0		/AND NOW SHIFT IT RIGHT.
	FSTA	SQRTEX-1	/AND SAVE IT OVER THE OLD EXPONENT.
	FLDA	MCRTP1		/RECALL OLD PART
	ALN	0		/FIX IT UP, NOW.
	FSTA	MCRTP1		/AND STORE IT BACK FOR LATER USE.
/
/		SQRTEX IS NOW 1/4 <X< 1
/
	FLDA	SQRTEX+1	/RECALL NUMBER.
	FSTA	MCRTP2		/SAVE IN A TEMP.
/
	FMUL	SQRTS1,1	/MULTIPLY BY CORRECT CONSTANT.
	FADD	SQRTS2,1	/AND NOW ADD IN CORRECT CONSTANT.
/
/		NOTE: INITIAL APPROXIMATION DEPENDS ON WHETHER X IS 1/4<X<1/2 OR
/		     1/2<X<1
/
	FSTA	MCRTP3		/SAVE IN A SECOND TEMP.
	FLDA	MCRTP2		/RECALL INITIAL.
	FDIV	MCRTP3		/CALCULATE X(0)/X(1)
	FADD	MCRTP3		/X(1)+X(0)/X(1)
	FDIV	FPPTWO		/1/2(X(1)+X(0)/X(1))
	FSTA	MCRTP3		/SAVE AGAIN. NOW X(2)
	FLDA	MCRTP2		/RECALL ORIGINAL.
	FDIV	MCRTP3		/X(0)/X(2)
	FADD	MCRTP3		/X(2)+X(0)/X(2)
	FSTA	SQRTEX+1	/NOW STORE AWAY FOR FINAL EXPONENT DIDDLING.
/
	STARTD
/
	FCLA			/ZERO HIGH ORDER EXPONENT PART.
	FSTA	SQRTEX-1
	FLDA	MCRTP1		/RECALL MODIFIED EXPONENT.
	FADDM	SQRTEX		/UPDATE FRACTIONAL EXPONENT.
/
	STARTF			/RETRUN TO FLOATING MODE.
/
	FLDA	SQRTEX+1	/PICK UP THE ANSWER.
/
/		AND RETURN.
/
/
SQRT,	JA	.		/SQUARE ROOT ENTRY AND EXIT.
	JGT	SQRTOK		/IF GREATER THEN 0 PROCEED.
	JEQ	SQRT		/IF ZERO JUST RETURN.
	TRAP7	3		/IF LESS THEN 0 GIVE A TRAP
	JA	SQRT		/BYE BYE.
/
/
/
SQRTSC,	FSUB	FPPONE		/SPECIAL CASE FUDGE.
	FSTA	MCRTP1		/SET EXPONENT ADD ON TO -1.
	FNEG			/AND SET ODD BIT ON.
	JA	SQRTBK		/AND GO BACK UP.
/
/
/
/
/
/
SQRTS1,	0			/IF BETWEEN 1/4 & 1/2
	3200
	0
	0			/IF BETWEEN 1/2 & 1
	2240
	0
/
SQRTS2,	7777			/IF BETWEEN 1/4 & 1/2
	2327
	7772
	7777			/IF BETWEEN 1/2 & 1
	3300
	0
/
/
/
/
	0			/THE MANTISSA ND EXPOENT DIDDLE AREAS.
	0
