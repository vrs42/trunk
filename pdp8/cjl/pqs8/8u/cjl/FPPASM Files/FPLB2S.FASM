/
/		THIS ROUTINE UNPACKS A STRING AND SENDS IT TO "PUTC" ONE CHAR AT A TIME.
/
/
/
/
PUTSTR,	JA	.		/ENTRY POINT.
	JSA	PUTSRL		/GET A CHARACTER NOW.
	JEQ	PUTSTR		/IF ZERO EXIT.
	FNEG			/ELSE SEND IT TO AN INDEX REGISTER.
	ATX	1
	JSA	PUTSRL		/GET ANOTHER CHAR.
	JSA	PUTC		/OUTPUT IT.
	JXN	.-4,1+		/LOOP AROUND FOR AWHILE.
	JA	PUTSTR		/AND THEN RETURN.
/
/
/
PUTSRL,	JA	.		/THE ENTRY POINT.
	STARTD			/GET INTO MINI-MODE
	FLDA I	MCRTPB		/GET A DOUBLE WORD.
	FSTA	PUTSRB		/AND SAVE AWAY.
	FLDA	FPPPI2-1	/NOW ADD "00000001" TO THE POINTER.
	FADDM	MCRTPB		/AND STORE BACK.
	STARTF			/GO BACK INTO FLOATING MODE.
	FLDA	PUTSRB-2	/RECALL MYSTERY WORD.
	FNORM			/NORMALIZE IT.
	JA	PUTSRL		/AND EXIT NOW.
/
/
/
/
