/
/
/	EXP3 RAISES A BASE TO A POWER.
/	X=A**B IN FORTRAN NOTATION.
/
/
/
EXP3OK,	JSA	ALOG		/TAKE LOG OF THE NUMBER.
	FMUL	MCRTP8		/MULITIPLY BY HIS POWER.
	JSA	EXP		/NOW RAISE IT.
/
EXP3,	JA	.		/RETURN AND ENTRY.
/
	JEQ	EXP3		/0^X=0
	FSTA	MCRTP2		/SAVE BASE
	FLDA	MCRTP1		/GET POWER AND SAVE
	JEQ	EXP3ON		/X^0=1
	FSTA	MCRTP8
	FLDA	MCRTP2
	JGE	EXP3OK		/ALL IS WELL.
	TRAP7	0		/GIVE TRAP.
	JA	EXP3		/AND RETURN.
/
EXP3ON,	FLDA	FPPONE
	JA	EXP3		/AND RETURN
