TANH,	JA	.		/HYPERBOLIC TANGENT ROUTINE.
	FSTA	MCRTP6		/SAVE ARGUMENT
	JSA	COSH		/PERFORM COSH
	FSTA	MCRTP5		/SAVE IT AWAY.
	FLDA	MCRTP6		/RECALL ARG.
	JSA	SINH		/PREFORM SINH.
	FDIV	MCRTP5		/SINH/COSH=TANH.
	JA	TANH		/AND RETURN NOW.
/
