/V800 BOOTSTRAP ROM CONTENTS

/	LAST EDIT:	20-DEC-1982	11:00:00	CJL

/	BASED ON DIABOT8 BY BRIAN WIGHAM, VICKERS MEDICAL 24-SEP-1980.

/	(C)	1982,	CHARLES LASNER ASSOCIATES.

/	ASSEMBLY INSTRUCTIONS:

/	MUST BE ASSEMBLED WITH '/J' (OS/8 PAL8 '/F') SWITCH SET.

/	ASSEMBLE AND LOAD WITH ROMPRT BINARY TO PRODUCE LISTING OF CONTENTS
/	AND FUNCTION IN OCTAL, HEX., ETC.
/	ASSEMBLY DEFINITIONS, ETC.

	BOOTADR=0022			/MINIMAL BOOTSTRAP ADDRESS
	DEP=	0002			/DEPOSIT BITS
	DIBOOT=	0400			/DIAGNOSTIC BOOTSTRAP
	LA=	0010			/LOAD ADDRESS BITS
	LX=	0004			/LOAD EXTENDED ADDRESS BITS
	NL0001=	CLA IAC			/LOAD AC WITH 0001
	NL0100=	CLA IAC BSW		/LOAD AC WITH 0100
	ROMBUFF=1000			/ROM CONTENTS HERE
	ROMFUN=	1200			/ROM FUNCTIONS HERE
	ST=	0001			/START BITS
	XR1=	0010			/AUTO-INDEX NUMBER 1
	XR2=	0011			/AUTO-INDEX NUMBER 2

/	DEVICE IOT DEFINITIONS.

	IFNDEF	DEVCODE	<DEVCODE=31>	/USES 631X BY DEFAULT

	DSEI=	DEVCODE^10+6000		/INTERRUPT ENABLE
	DSSF=	DEVCODE^10+6001		/SKIP ON DONE FLAG
	DSCD=	DEVCODE^10+6002		/CLEAR DONE FLAG
	DSHI=	DEVCODE^10+6003		/LOAD HIGH-ORDER COMMAND ADDRESS
	DSGO=	DEVCODE^10+6004		/LOAD LOW-ORDER COMMAND AND GO
	DSRS=	DEVCODE^10+6005		/READ STATUS
	DSDI=	DEVCODE^10+6006		/DISABLE INTERRUPTS
	DSIP=	DEVCODE^10+6007		/(DIAGNOSTIC) INITIAL PROGRAM LOAD (BOOTSTRAP)
	*ROMBUFF		/DEFINE INPUT BUFFER FOR ROMPRT

/	AUTO-RESTART ADDRESS - REPLACED HERE BY VERSION TEXT.

	TEXT	"V800"		/DEFINE VERSION STRING OVER MANDITORY AUTO-RESTART WORDS

/	ROM ADDRESS FOR NORMAL BOOTSTRAP-ONLY FUNCTION.

	BOOTADR			/LA BOOTSTRAP ADDRESS
	0000			/LXA 0000

	RELOC	BOOTADR		/FOOL THE ASSEMBLER

/	MINIMAL BOOTSTRAP FOR FLOPPY DISK SYSTEM.

BOOTADR,CAF			/POWER CLEAR IS GOOD ENOUGH
	DSIP			/DO (DIAGNOSTIC) BOOTSTRAP COMMAND
OVERLAY,JMP	.		/WAIT FOR OVERLAY

	RELOC			/UN-FOOL THE ASSEMBLER

	BOOTADR			/LA, ST

/	ROM ADDRESS FOR DIAGNOSTIC BOOTSTRAP FUNCTION.

	DIBOOT			/LA 0400
	0000			/LXA 0000
	RELOC	DIBOOT		/FOOL THE ASSEMBLER

DIBOOT,	CAF			/CLEAN UP
	TAD	A		/GET THE CHARACTER
	TLS			/OUTPUT IT
	TSF			/FLAG UP?
	JMP	.-1		/NO, WAIT FOR IT
	CIA			/INVERT FOR TESTING
	SMA CLA			/SKIP IF POSSIBLY OK
	JMP	DIBOOT		/ELSE RESTART IT

/	TEST OPERATION OF SEVERAL PROCESSOR OPERATES.

	CMA			/FORM 7777
	MQL			/PUT INTO MQ REGISTER
	SZA			/SKIP IF MQL CLEARED AC
	JMP	ERR1		/ELSE COMPLAIN
	MQA			/GET IT BACK
	STL RAL			/SET LINK AND SHIFT IT IN
	IAC			/INCREMENT BACK TO ZERO
	SZA CLA			/SKIP IF OK
	JMP	ERR1		/ELSE COMPLAIN

/	TEST OPERATION OF ISZ INSTRUCTION.

	IAC			/COUNTUP FOR ISZ TEST
	ISZ	RESUB		/DO TEST ISZ INSTRUCTION
	JMP	.-2		/UNTIL IT SKIPS
	SZA			/SKIP IF IT APPEARS TO COUNT OK
	JMP	ERR1		/ELSE COMPLAIN

/	TEST OPERATION OF JMS INSTRUCTION.

	JMS	RESUB		/CALL IT

RESUB,	.-.			/WILL HAVE OUR P.C. HERE
	TAD	RESUB		/GET THE P.C.
	CIA			/INVERT FOR TEST
	TAD	JMSCON		/COMPARE TO EXPECTED
	SZA			/SKIP IF OK
	JMP	ERR1		/ELSE COMPLAIN

/	TEST OPERATION OF AND INSTRUCTION.

	TAD	JMSCON		/GET TEST CONSTANT
	CMA			/INVERT FOR TEST
	AND	JMSCON		/AND AGAINST ORIGINAL
	SZA			/SKIP IF ALL BITS OK
	JMP	ERR1		/ELSE COMPLAIN
/	TEST OPERATION OF DCA INSTRUCTION.

	DCA	RESUB		/CLEAR TEST LOCATION
	TAD	RESUB		/GET IT BACK
	SZA			/SKIP IF OK
	JMP	ERR1		/ELSE COMPLAIN

/	TELL OPERATOR THAT CPU SEEMS OK.

	NL0001 CLL		/SET AC TO ONE
	TAD	O		/MAKE IT INTO OUR SECOND CHARACTER
	JMS	PRINT		/PRINT IT

/	TEST OF MEMORY.

MEMTST,	TAD	MEMLOK		/SETUP THE
	DCA	XR1		/POINTER
	TAD	XR1		/GET IT BACK
	DCA	XR2		/STORE IN OTHER POINTER REGISTER ALSO
NEXT,	TAD	MEMIND		/GET TEST INDICATOR LOCATION
FLD,	CDF	00+.-.		/WILL BE CHANGED AS NECESSARY
	DCA I	XR1		/STORE IT
	TAD I	XR2		/GET IT BACK
	CIA			/INVERT FOR TEST
	CDF	00		/BACK TO FIELD 0
	TAD	MEMIND		/COMPARE TO TEST VALUE
	SZA CLA			/SKIP IF IT MATCHES
	JMP	ERR2		/ELSE COMPLAIN
	TAD	XR1		/GET POINTER
TIMOUT,	SZA CLA			/SKIP IF AT END OF TEST
	JMP	NEXT		/ELSE KEEP GOING
	TAD	MEMIND		/GET TEST INDICATOR
	SZA CLA			/SKIP IF TESTING WITH ZEROES
	JMP	FLDSLT		/ELSE DO NEXT FIELD
	CMA			/INVERT TO ONES
	DCA	MEMIND		/STORE NEW TEST INDICATOR
	JMP	MEMTST		/KEEP GOING

FLDSLT,	ISZ	FLDCNT		/DONE ALL FIELDS?
	SKP			/SKIP IF NOT
	JMP	DONE		/JUMP IF SO
	TAD	FLD		/GET CURRENT VALUE
	TAD	P10		/UPDATE TO NEXT FIELD
	DCA	FLD		/STORE BACK
	DCA	MEMIND		/RESET TEST INDICATOR
	DCA	MEMLOK		/REMOVE PROTECTION WHEN TESTING UPPER MEMORY FIELDS
	JMP	NEXT		/KEEP GOING

/	MEMORY APPEARS GOOD. INFORM OPERATOR WITH "K" (MACHINE IS "AOK").

DONE,	NL0001			/SET A ONE
	TAD	K		/GET THE CHARACTER
	JMS	PRINT		/PRINT IT
/	NOW TRY TO ACTUALLY READ THE FLOPPY DISK.

	DSIP			/READ RECORD ZERO OF THE DISK
	DSSF			/DONE YET?
	JMP	.-1		/NO, WAIT FOR IT
	DSCD			/YES, CLEAR THE DONE FLAG
	ISZ	TIMOUT		/WAIT FOR AWHILE
	JMP	.-1		/FOR STATUS AVAILABILITY
	DSRS			/READ STATUS NOW
	SNA			/SKIP IF BAD
	JMP	OVERLAY+1	/JUMP IF OK
	RTL			/DO INITIAL ADJUST
OCTLUP,	RTL			/MOVE UP THE BITS
	DCA	JMSCON		/SAVE THEM
	TAD	JMSCON		/GET THEM BACK
	AND	FIL2		/ISOLATE A DIGIT
	TAD	K260		/MAKE IT ASCII
	JMS	PRINT		/PRINT THE DIGIT
	TAD	JMSCON		/GET IT AGAIN
	RAL			/DO ADJUST FOR NEXT TIME
	ISZ	CHRCNT		/DONE ALL YET?
	JMP	OCTLUP		/NO, KEEP GOING

/	ERRORS COME HERE.

ERR2,	NL0100 CLL		/SET 0100
	JMS	PRINT		/PRINT <AT-SIGN>
WAIT,	JMP	.		/WERE STUCK!

ERR1,	NL0100 CLL		/SET 0100
	SKP			/DON'T EXECUTE HEADER

PRINT,	WAIT			/PRINT ROUTINE
	TLS			/PRINT THE CHARACTER
	TSF			/WAIT FOR IT
	JMP	.-1		/TO FINISH
	CLA			/CLEAN UP
	JMP I	PRINT		/RETURN

CHRCNT,	-4			/OCTAL CHARACTER COUNTER
FIL2,	7			/OCTAL DIGIT MASK
K260,	"0			/OCTAL-ASCII CONSTANT
JMSCON,	RESUB			/JMS TEST LOCATION
FLDCNT,	-4			/TEST FIELD COUNTER
MEMIND,	0			/MEMORY TEST INDICATOR LOCATION
MEMLOK,	.!177			/PROTECTED MEMORY ADDRESS
P10,	10			/CONSTANT 0010
A,	"A			/"A"
O,	"O-1			/"O"
K,	"K-1			/"K"

	RELOC			/UN-FOOL THE ASSEMBLER

	DIBOOT			/LA, ST
	*ROMFUN			/DEFINE CORRESPONDING WORD FUNCTIONS HERE.

	LA			/000
	LX!ST			/002
