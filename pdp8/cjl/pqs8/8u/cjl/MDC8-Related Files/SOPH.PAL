/SOPH BOOTSTRAP ROM CONTENTS

/	LAST EDIT:	11-MAR-1985	16:00:00	CJL

/	BASED ON DIABOT8 BY BRIAN WIGHAM, VICKERS MEDICAL 24-SEP-1980.
/	ALSO BASED ON V800 BY CHARLES LASNER, CHARLES LASNER ASSOCIATES 20-DEC-1982.

/	(C)	1985,	CHARLES LASNER ASSOCIATES.

/	ASSEMBLY INSTRUCTIONS:

/	MUST BE ASSEMBLED WITH '/J' (OS/8 PAL8 '/F') SWITCH SET.

/	CHANGE "DEVCODE" TO PROPER DEVICE CODE AS NECESSARY (DEFAULT IS 70).

/	ASSEMBLE AND LOAD WITH ROMPRT BINARY TO PRODUCE LISTING OF CONTENTS
/	AND FUNCTION IN OCTAL, HEX., ETC.
/	ASSEMBLY DEFINITIONS, ETC.

	BEXTERN=0025			/EXTERNAL BOOTSTRAP LOCATION
	DEP=	0002			/DEPOSIT BITS
	DICODE=	0400			/DIAGNOSTIC BOOTSTRAP CODE STARTS LOADING HERE
	LA=	0010			/LOAD ADDRESS BITS
	LX=	0004			/LOAD EXTENDED ADDRESS BITS
	NL7777=	CLA CMA			/LOAD AC WITH 7777
	ROMBUFF=1000			/ROM CONTENTS HERE
	ROMFUN=	1200			/ROM FUNCTIONS HERE
	ST=	0001			/START BITS
	XR1=	0010			/AUTO-INDEX NUMBER 1
	XR2=	0011			/AUTO-INDEX NUMBER 2
	XR3=	0012			/AUTO-INDEX NUMBER 3

/	MDC8 IOT DEFINITIONS.

	IFNDEF	DEVCODE	<DEVCODE=70>	/USES 670X BY DEFAULT

	DSEI=	DEVCODE^10+6000		/INTERRUPT ENABLE/DISABLE PER AC[11]
	DSSF=	DEVCODE^10+6001		/SKIP ON DONE FLAG
	DSCF=	DEVCODE^10+6002		/CLEAR DONE FLAG
	DSHI=	DEVCODE^10+6003		/LOAD HIGH-ORDER COMMAND ADDRESS
	DSGO=	DEVCODE^10+6004		/LOAD LOW-ORDER COMMAND AND GO
/	    =	DEVCODE^10+6005		/UNUSED
	DSRS=	DEVCODE^10+6006		/READ STATUS
	DSIM=	DEVCODE^10+6007		/INTERFACE MAINTENANCE INSTRUCTION
/	STARTS HERE TO MOVE THE CODE FOR TESTING.

START,	CAF			/CLEAR THE BUSS
	TAD	(MOVST-1)	/SETUP
	DCA	XR1		/THE
	TAD	(DICODE-1)	/MOVE
	DCA	XR2		/POINTERS
	TAD	(MOVST-MOVEND)	/SETUP THE
	DCA	XR3		/MOVE LENGTH
MOVLUP,	TAD I	XR1		/GET A WORD
	DCA I	XR2		/PUT A WORD
	ISZ	XR3		/DONE YET?
	JMP	MOVLUP		/NO, KEEP GOING
	KSF			/FLAG UP?
	JMP	.-1		/NO, WAIT FOR IT
	CAF			/CLEAR THE BUSS
	JMP I	(DIBOOT)	/GO DO IT!

	PAGE
	*ROMBUFF		/DEFINE INPUT BUFFER FOR ROMPRT

/	AUTO-RESTART ADDRESS - REPLACED HERE BY VERSION TEXT.

	TEXT	"SOPH"		/DEFINE VERSION STRING OVER MANDITORY AUTO-RESTART WORDS

/	ROM ADDRESS FOR DIAGNOSTIC BOOTSTRAP FUNCTION.

	DICODE			/LA 0400
	0000			/LX

/	ALL THE FOLLOWING CODE WORDS ARE "DEP" TYPE.

	MOVST=	.		/TEST MOVE STARTS HERE
	RELOC	DICODE		/FOOL THE ASSEMBLER

	IFNZRO	.&177	<ERROR	.>
PRINT,	RESUB			/PRINT ROUTINE
	TLS			/PRINT THE CHARACTER
	TSF			/WAIT FOR IT
	JMP	.-1		/TO FINISH
	CLA			/CLEAN UP
	JMP I	PRINT		/RETURN

CHRCNT,	-4			/OCTAL PRINTOUT CHARACTER COUNTER
EXTUNIT,1001			/BOOTSTRAP VALUE PRELOADED FOR UNIT TWO

DIBOOT,	CAF			/CLEAN UP
	LAS			/GET CONSOLE SWITCHES
	SNA			/SKIP IF EXPLICIT BOOTSTRAP REQUESTED
	JMP	DOALL		/JUMP IF NOT
	DCA	EXTUNIT		/SAVE REQUEST
	JMP	BOOTIT		/GO DO IT

DOALL,	TAD	A		/GET THE CHARACTER
	TLS			/OUTPUT IT
	TSF			/FLAG UP?
	JMP	.-1		/NO, WAIT FOR IT
	CIA			/INVERT FOR TESTING
	SPA CLA			/SKIP IF POSSIBLY OK
	JMP	DIBOOT		/ELSE RESTART IT

/	TEST OPERATION OF SEVERAL PROCESSOR OPERATES.

	CMA			/FORM 7777
	MQL			/PUT INTO MQ REGISTER
	SZA			/SKIP IF MQL CLEARED AC
	JMS	ERR		/ELSE COMPLAIN
A,	CLA MQA			/GET IT BACK
	STL RAL			/SET LINK AND SHIFT IT IN
L3,	IAC BSW			/INCREMENT BACK TO ZERO
	SZA CLA			/SKIP IF OK
	JMS	ERR		/ELSE COMPLAIN

/	TEST OPERATION OF ISZ INSTRUCTION.

	IAC			/COUNTUP FOR ISZ TEST
	ISZ	RESUB		/DO TEST ISZ INSTRUCTION
	JMP	.-2		/UNTIL IT SKIPS
	SZA			/SKIP IF IT APPEARS TO COUNT OK
	JMS	ERR		/ELSE COMPLAIN
/	TEST OPERATION OF JMS INSTRUCTION.

	JMS	RESUB		/CALL IT
RESUB,	0			/WILL HAVE OUR P.C. HERE
	TAD	RESUB		/GET THE P.C.
	CIA			/INVERT FOR TEST
L200,	TAD	PRINT		/COMPARE TO EXPECTED
	SZA			/SKIP IF OK
	JMS	ERR		/ELSE COMPLAIN

/	TEST OPERATION OF AND INSTRUCTION.

	TAD	TSTCON		/GET TEST CONSTANT
	CMA			/INVERT FOR TEST
TSTCON,	AND	TSTCON		/AND AGAINST ORIGINAL
	SZA			/SKIP IF ALL BITS OK
	JMS	ERR		/ELSE COMPLAIN

/	TEST OPERATION OF DCA INSTRUCTION.

	DCA	RESUB		/CLEAR TEST LOCATION
	TAD	RESUB		/GET IT BACK
	SZA			/SKIP IF OK
	JMS	ERR		/ELSE COMPLAIN

/	TELL OPERATOR THAT CPU SEEMS OK.

	TAD	O		/GET THE SECOND CHARACTER
	JMS	PRINT		/PRINT IT

/	TEST OF MEMORY.

MEMTST,	TAD	DWAIT		/SETUP THE
	DCA	XR1		/POINTER
	TAD	XR1		/GET IT BACK
	DCA	XR2		/STORE IN OTHER POINTER REGISTER ALSO
NEXT,	TAD	RESUB		/GET TEST INDICATOR LOCATION
FLD,	CDF	00+.-.		/WILL BE CHANGED AS NECESSARY
	DCA I	XR1		/STORE IT
	TAD I	XR2		/GET IT BACK
	CIA			/INVERT FOR TEST
	CDF	00		/BACK TO FIELD 0
	TAD	RESUB		/COMPARE TO TEST VALUE
TIMOUT,	SZA CLA			/SKIP IF IT MATCHES
	JMS	ERR		/ELSE COMPLAIN
	TAD	XR1		/GET POINTER
	SZA CLA			/SKIP IF AT END OF TEST
	JMP	NEXT		/ELSE KEEP GOING
	TAD	RESUB		/GET INDICATOR
	CMA			/INVERT IT
	DCA	RESUB		/STORE IT BACK
	TAD	RESUB		/GET IT AGAIN
	SZA CLA			/SKIP IF IT JUST FLIPPED TWICE
	JMP	MEMTST		/ELSE KEEP GOING
	IFNZRO	.&177-113	<ERROR	.>
L10,	10			/CONSTANT 0010
	TAD	FLD		/GET CURRENT CDF INSTRUCTION
K,	TAD	L10		/BUMP TO NEXT FIELD
	DCA	FLD		/STORE IT BACK

	IFNZRO	.&177-117	<ERROR	.>
L60,	60			/CONSTANT 0060
	DCA	DWAIT		/REMOVE PROTECTION WHEN TESTING UPPER MEMORY FIELDS
	ISZ	FLDCNT		/DONE ALL FIELDS?
	JMP	NEXT		/NO, KEEP GOING

/	MEMORY APPEARS GOOD. INFORM OPERATOR WITH "K" (MACHINE IS "AOK").

	TAD	K		/GET THE CHARACTER
	JMS	PRINT		/PRINT IT

/	NOW TRY TO ACTUALLY BOOTSTRAP THE DISK.

/	COMES HERE DIRECTLY IF CONSOLE SWITCHES SET.

BOOTIT,	JMS	DWAIT		/WAIT FOR CONTROLLER TO BE READY
	TAD	L200		/GET RESET VALUE
	DSIM			/RESET THE CONTROLLER
	JMS	DWAIT		/WAIT FOR AWHILE
	ISZ	TIMOUT		/WAITED ENOUGH?
	JMP	.-2		/NO, KEEP WAITING
	JMS	DWAIT		/NOW WAIT FOR REAL
	TAD	EXTUNIT		/GET SETUP BOOT AND UNIT COMMAND
	DSIM			/START IT UP
	JMS	DWAIT		/WAIT FOR IT TO FINISH
	DSRS			/GET FINAL STATUS
	SZA			/SKIP IF OK
	JMP	IOERROR		/JUMP IF NOT
	TAD	EXTUNIT		/GET BOOTSTRAP VALUE AGAIN
	JMP	BEXTERN		/FINISH IT THERE

ERR,	.-.			/ERROR ROUTINE
	DCA	FLDCNT		/SAVE ANY PASSED VALUE
OCTLUP,	TAD	ERR		/GET THE VALUE
IOERROR,RTL;RAL			/MOVE UP
	DCA	ERR		/STORE IT BACK
	TAD	ERR		/GET IT AGAIN
	AND	L3		/JUST LOW-ORDER BITS
	RAL			/NOW HAVE ISOLATED DIGIT
O,	TAD	L60		/MAKE IT ASCII
	JMS	PRINT		/PRINT IT
	ISZ	CHRCNT		/DONE FOUR?
	JMP	OCTLUP		/NO, KEEP GOING
	TAD	FLDCNT		/GET PASSED AC BACK
WAIT,	JMP	WAIT		/WAIT FOREVER
DWAIT,	.!177			/DISK WAIT ROUTINE
DWATLP,	ISZ	DIBOOT		/WASTE
	JMP	DWATLP		/SOME TIME
	DSRS			/GET STATUS NOW
	SPA CLA			/SKIP IF NOT BUSY
	JMP	DWATLP		/ELSE WAIT SOME MORE
	JMP I	DWAIT		/RETURN

FLDCNT,	-10			/TEST FIELD COUNTER

	RELOC			/UN-FOOL THE ASSEMBLER

	MOVEND=	.		/END OF TEST MOVE

	DIBOOT			/LA, ST
