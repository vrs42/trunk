	CDF	PR2FLD		/INDICATE OUR CALLING FIELD
	CIF	PRGFLD		/GOTO CODE FIELD
	JMS I	[MESSAGE]	/TELL THEM
	EDGMSG			/TO ENTER THE DIGITS
INDIGLP,JMS	GETNMB		/GET A DIGIT
	CLA			/THROW STRIPPED VALUE AWAY
	CDF	PRGFLD		/GOTO CALLING FIELD
	TAD I	[INCHAR]	/GET LATEST DIGIT
	CDF	TBLFLD		/GOTO TABLE FIELD
	DCA I	XR2		/STASH IT
	CDF	PR2FLD		/BACK TO OUR FIELD
	ISZ	BTCNTR		/DONE ALL DIGITS?
	JMP	INDIGLP		/NO, KEEP GOING
	CIF	PRGFLD		/GOTO CODE FIELD
	JMS I	[CRLF]		/DO A <CR>, <LF>
NUMBAK,	CIF CDF	PRGFLD		/GOTO CALLING FIELD
	JMP I	GETSERIAL	/RETURN

/	NUMERICAL MESSAGE TABLE.

NUMTBL,	FIRST			/FIRST MESSAGE
	SECOND			/SECOND MESSAGE
	THIRD			/THIRD MESSAGE
	FOURTH			/FOURTH MESSAGE
	FIFTH			/FIFTH MESSASE
	SIXTH			/SIXTH MESSAGE
	SEVENTH			/SEVENTH MESSAGE
	EIGHTH			/EIGHTH MESSAGE
	NINTH			/NINTH MESSAGE
	TENTH			/TENTH MESSAGE
	ELEVENTH		/ELEVENTH MESSAGE
	TWELFTH			/TWELFTH MESSAGE
	THIRTEENTH		/THIRTEENTH MESSAGE
/	FOURTEENTH		/FOURTEENTH MESSAGE
/	MEMORY CONFIGURATION PRINT ROUTINE.

PRINTK,	.-.			/MEMORY CONFIGURATION PRINT ROUTINE
	CDF	PR2FLD		/INDICATE OUR CALLING FIELD
	CIF	PRGFLD		/GOTO CODE FIELD
	JMS I	[CRLF]		/DO A <CR>, <LF>
	CDF	PRGFLD		/GOTO CALLING FIELD
	TAD I	(KL1)		/GET FIRST MEMORY DIGIT
	JMS	PK		/PRINT IT
	TAD I	(KL2)		/GET SECOND MEMORY DIGIT
	JMS	PK		/PRINT IT
	TAD I	(KL3)		/GET THIRD MEMORY DIGIT
	JMS	PK		/PRINT IT
	TAD I	(KL4)		/GET FOURTH MEMORY DIGIT
	JMS	PK		/PRINT IT
	CDF	PR2FLD		/INDICATE OUR CALLING FIELD
	CIF	PRGFLD		/GOTO CODE FIELD
	JMS I	[MESSAGE]	/TELL THEM
	KAVMSG			/AVAILABLE MEMORY MESSAGE
	CIF CDF	PRGFLD		/BACK TO CALLING FIELD
	JMP I	PRINTK		/RETURN

PK,	.-.			/PRINT SUPPRESS ROUTINE
	TAD	(-" !200)	/COMPARE TO <BLANK>
	SNA			/SKIP IF OTHERWISE
	JMP I	PK		/ELSE JUST RETURN
	TAD	[" &177]	/RESTORE THE CHARACTER
	CDF	PR2FLD		/INDICATE OUR CALLING FIELD
	CIF	PRGFLD		/GOTO CODE FIELD
	JMS I	[P7CH]		/PRINT IT
	CDF	PRGFLD		/RESET TO CALLING FIELD
	JMP I	PK		/RETURN

