/	DISK COPYING ROUTINE.

DSKCOPY,.-.			/DISK COPYING ROUTINE
	CDF	PRGFLD		/GOTO CALLING FIELD
	DLD;	FBLK		/GET INPUT BLOCK
	CDF	PR2FLD		/BACK TO OUR FIELD
	DST;	INBLK		/STORE IT
	CDF	PRGFLD		/GOTO CALLING FIELD
	DLD;	DSTROKE		/GET OUTPUT BLOCK
	CDF	PR2FLD		/BACK TO OUR FIELD
	DST;	OUTBLK		/STORE IT
	CAM			/CLEAN UP
	CIF	PRGFLD		/GOTO CODE FIELD
	JMS I	[MESSAGE]	/TELL THEM
	INDMSG			/ABOUT INPUT
	CDF	PRGFLD		/GOTO CALLING FIELD
	TAD I	(INUNIT)	/GET INPUT UNIT
	CDF	PR2FLD		/INDICATE OUR FIELD
	CIF	PRGFLD		/GOTO CODE FIELD
	JMS I	[PRTUNIT]	/PRINT IT
	CIF	PRGFLD		/GOTO CODE FIELD
	JMS I	[CRLF]		/DO A <CR>, <LF>
	CDF	PRGFLD		/GOTO CALLING FIELD
	TAD I	(INUNIT)	/GET INPUT UNIT
	DCA I	[UNIT]		/SETUP READY ROUTINE
	CDF	PR2FLD		/INDICATE OUR FIELD
	CIF	PRGFLD		/GOTO CODE FIELD
	JMS I	[GETREADY]	/GET THE INPUT UNIT MOUNTED
	INUMSG			/FLEXIBLE DISK MESSAGE
	CIF	PRGFLD		/GOTO CODE FIELD
	JMS I	[MESSAGE]	/TELL THEM
	OTDMSG			/ABOUT OUTPUT
	CDF	PRGFLD		/GOTO CALLING FIELD
	TAD I	(OTUNIT)	/GET OUTPUT UNIT
	CDF	PR2FLD		/INDICATE OUR FIELD
	CIF	PRGFLD		/GOTO CODE FIELD
	JMS I	[PRTUNIT]	/PRINT IT
	CIF	PRGFLD		/GOTO CODE FIELD
	JMS I	[CRLF]		/DO A <CR>, <LF>
OMONAGN,CDF	PRGFLD		/GOTO CALLING FIELD
	TAD I	(OTUNIT)	/GET OUTPUT UNIT
	DCA I	[UNIT]		/SETUP READY ROUTINE
	CDF	PR2FLD		/INDICATE OUR FIELD
	CIF	PRGFLD		/GOTO CODE FIELD
	JMS I	[GETREADY]	/GET THE OUTPUT UNIT MOUNTED
	OTUMSG			/FLEXIBLE DISK MESSAGE
	CDF	PRGFLD		/GOTO CALLING FIELD
	TAD I	(VOSW)		/GET VERIFY-ONLY SWITCH
	CDF	PR2FLD		/BACK TO OUR FIELD
	SZA CLA			/SKIP IF OFF
	JMP	COMSTART	/JUMP IF ON
	NL7777			/INDICATE CHANGE OF ERROR MESSAGE
	JMS I	[DATASTATUS]	/GET DRIVE DATA STATUS
	SMA CLA			/SKIP IF ERROR ON DRIVE
	JMP	OMOK		/JUMP IF OTHERWISE
	CIF	PRGFLD		/GOTO CODE FIELD
	JMS I	[ERRMSG]	/GO COMPLAIN
	EONMSG			/WITH THIS BLURB
	CIF	PRGFLD		/GOTO CODE FIELD
	JMS I	[ASKRETRY]	/ASK FOR A RETRY
	JMP	OMONAGN		/TRY AGAIN
	CIF CDF	PRGFLD		/GOTO CODE FIELD
	JMP I	[AGAIN]		/FORGET IT

OMOK,	CIF	PRGFLD		/GOTO CODE FIELD
	JMS I	[SURESPONSE]	/GET RESPONSE TO QUESTION
	PTCMSG			/FOR PERMISSION TO COPY
	JMP	DSKCRETURN	/FORGET IT
	CIF	PRGFLD		/GOTO CODE FIELD
	JMS I	[MESSAGE]	/TELL THEM
	CIPMSG			/COPY HAS STARTED
	JMP	COMCOMMON	/CONTINUE THERE

COMSTAR,CIF	PRGFLD		/GOTO CODE FIELD
	JMS I	[SURESPONSE]	/GET PERMISSION
	PTMMSG			/TO CHECK THE DATA MATCH
	JMP	DSKCRETURN	/FORGET IT
	CIF	PRGFLD		/GOTO CODE FIELD
	JMS I	[MESSAGE]	/TELL THEM
	CMPMSG			/COMPARE HAS STARTED
COMCOMM,DCA	CIOSW		/START OFF NORMALLY
	DCA	CUPDATE+1	/CLEAR HIGH-ORDER UPDATE FACTOR
	JMP I	(IOSTART)	/CONTINUE THERE
/	COMES HERE WHEN COPYING IS COMPLETE.

CPDONE,	SZA			/BETTER BE ZERO
	HLT			/**** ???? ****
	TAD I	(VOSW)		/GET VERIFY-ONLY SWITCH
	SZA CLA			/SKIP IF IN NORMAL MODE
	TAD	(CMDNMSG-CDNMSG)/ELSE USE COMPARE MESSAGE
	TAD	(CDNMSG)	/GET BASIC MESSAGE ADDRESS
	DCA	CDNARG		/STORE IN-LINE
	CDF	PR2FLD		/INDICATE OUR FIELD
	CIF	PRGFLD		/GOTO CODE FIELD
	JMS I	[MESSAGE]	/TELL THEM
CDNARG,	CDNMSG	/OR CMDNMSG	/WE'RE DONE
	CIF	PRGFLD		/GOTO CODE FIELD
	JMS I	[MESSAGE]	/TELL THEM
	CDOPMSG			/THEIR OPTIONS
DSKCRET,CIF CDF	PRGFLD		/GOTO CALLING FIELD
	JMP I	DSKCOPY		/RETURN

INBLK,	ZBLOCK	2		/INPUT BLOCK
OUTBLK,	ZBLOCK	2		/OUTPUT BLOCK

