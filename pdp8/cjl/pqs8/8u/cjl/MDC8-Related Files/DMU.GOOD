RAND24,	.-.			/24-BIT RANDOM NUMBER GENERATOR
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	R24EXT		/STORE IN-LINE
	TAD I	RAND24		/GET SEED POINTER
	DCA	RANPTLO		/STASH LOW-ORDER POINTER
	NL0001			/SET OFFSET TO HIGH-ORDER
	TAD	RANPTLO		/GET CORRECTED POINTER
	DCA	RANPTHI		/STORE HIGH-ORDER POINTER
	CDF	PR2FLD		/GOTO OUR FIELD
	NL0001			/SETUP INITIAL INCREMENT
	MQL			/STORE INITIAL LOW-ORDER
	TAD	(-5)		/SETUP THE
	DCA	RANCNT		/MULTIPLIER COUNT
RANLUP,	CLL			/CLEAR THE LINK
	SWP			/GET LOW-ORDER
	TAD I	RANPTLO		/ADD ON LOW-ORDER
	SWP			/SWAP IT BACK
	SZL			/CARRY?
	IAC			/YES
	TAD I	RANPTHI		/ADD ON HIGH-ORDER
	ISZ	RANCNT		/DONE ENOUGH?
	JMP	RANLUP		/NO, KEEP GOING
	DCA I	RANPTHI		/STORE BACK NEW HIGH-ORDER
	MQA			/GET LOW-ORDER
	DCA I	RANPTLO		/STORE BACK NEW LOW-ORDER
	TAD I	RANPTHI		/RESTORE NEW HIGH-ORDER
	ISZ	RAND24		/BUMP PAST SEED POINTER
R24EXT,	.-.			/WILL BE CIF CDF RETURN FIELD
	JMP I	RAND24		/RETURN

RAND18,	.-.			/18-BIT RANDOM NUMBER GENERATOR
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	R18EXT		/STORE IN-LINE
	TAD I	RAND18		/GET SEED POINTER
	DCA	R18ARG		/STORE IN-LINE
	CDF	PR2FLD		/GOTO OUR FIELD
	JMS	RAND24		/CALL 24-BIT RANDOM NUMBER GENERATOR
R18ARG,	.-.			/SEED POINTER
	RAR			/MOVE OVER HIGH-ORDER
	SWP			/GET LOW-ORDER
	RAR			/MOVE DOWN
	SWP			/SWAP BACK
	RAR			/MOVE OVER HIGH-ORDER
	SWP			/GET LOW-ORDER
	RAR			/MOVE DOWN
	SWP			/SWAP BACK
	AND	(77)		/REMOVE JUNK BITS
	ISZ	RAND18		/BUMP PAST SEED POINTER
R18EXT,	.-.			/WILL BE CIF CDF RETURN FIELD
	JMP I	RAND18		/RETURN
RAND12,	.-.			/12-BIT RANDOM NUMBER GENERATOR
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	R12EXT		/STORE IN-LINE
	TAD I	RAND12		/GET SEED POINTER
	DCA	R12ARG		/STORE IN-LINE
	CDF	PR2FLD		/GOTO OUR FIELD
	JMS	RAND18		/CALL 18-BIT RANDOM NUMBER GENERATOR
R12ARG,	.-.			/SEED POINTER
	CLL RTL;RTL;RTL		/MOVE UP
	DCA	RANCNT		/SAVE IT
	MQA			/GET LOW-ORDER
	RTR;RTR;RTR		/MOVE DOWN
	AND	(77)		/REMOVE JUNK BITS
	TAD	RANCNT		/RESTORE UPPER BITS
	ISZ	RAND12		/BUMP PAST SEED POINTER
R12EXT,	.-.			/WILL BE CIF CDF RETURN FIELD
	JMP I	RAND12		/RETURN

RAND6,	.-.			/6-BIT RANDOM NUMBER GENERATOR
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	R6EXT		/STORE IN-LINE
	TAD I	RAND6		/GET SEED POINTER
	DCA	R6ARG		/STORE IN-LINE
	CDF	PR2FLD		/GOTO OUR FIELD
	JMS	RAND18		/CALL 18-BIT RANDOM NUMBER GENERATOR
R6ARG,	.-.			/SEED POINTER
	ISZ	RAND6		/BUMP PAST SEED POINTER
R6EXT,	.-.			/WILL BE CIF CDF RETURN FIELD
	JMP I	RAND6		/RETURN

RANCNT,	.-.			/RANDOM COUNTER
RANPTHI,.-.			/HIGH-ORDER SEED POINTER
RANPTLO,.-.			/LOW-ORDER SEED POINTER

