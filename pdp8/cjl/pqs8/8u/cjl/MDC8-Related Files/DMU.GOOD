	JMP I	(CMERR)		/BARF!
	ISZ	BTCNTR		/DONE ALL YET?
	JMP	IOCMLP		/NO, KEEP GOING
	JMP I	(OTPAST)	/CONTINUE THERE
CMECNT,	.-.			/COMPARE ERROR COUNTER
INECNT,	.-.			/INPUT ERROR COUNTER
OTECNT,	.-.			/OUTPUT ERROR COUNTER

