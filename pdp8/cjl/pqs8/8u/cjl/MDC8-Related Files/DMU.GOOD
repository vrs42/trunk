/	MULTIPLE DRIVE ENABLE ROUTINE.

MULTENA,.-.			/MULTIPLE DRIVE ENABLE ROUTINE
	CDF	PRGFLD		/ENSURE CALLING FIELD
	TAD I	MULTENABLE	/GET IN-LINE ARGUMENT
	DCA	MLTINLINE	/STORE IN-LINE
	ISZ	MULTENABLE	/BUMP PAST IT
	CDF	PR2FLD		/GOTO OUR FIELD
	TAD	(-4)		/SETUP THE
	DCA	MLCNTR		/UNIT COUNTER
	DCA	MLWORD		/CLEAR ENABLE WORD
MULOOP,	CIF	PRGFLD		/GOTO CODE FIELD
	JMS I	[MESSAGE]	/TELL THEM
MLTINLI,.-.			/PASSED MESSAGE
	NL0004			/SET OFFSET
	TAD	MLCNTR		/NOW HAVE LATEST UNIT
	CIF	PRGFLD		/GOTO CODE FIELD
	JMS I	[PRTUNIT]	/PRINT OUT UNIT NAME
	CIF	PRGFLD		/GOTO CODE FIELD
	JMS I	[MESSAGE]	/TELL THEM
	QTRMSG			/TRAILING MESSAGE
	CIF	PRGFLD		/GOTO CODE FIELD
