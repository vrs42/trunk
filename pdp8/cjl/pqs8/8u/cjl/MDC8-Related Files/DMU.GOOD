	DST;	RWBLK			/INITIAL BAD TRACK TABLE BLOCK
WBTLP2,	NL7775				/SETUP THE
	DCA	BTRYCT			/RETRY COUNT
WBTLUP,	JMS I	[UPCHECK]		/CHECK FOR <^C>, ETC.
	CIF	PRGFLD			/GOTO CODE FIELD
