GETREAD,.-.			/GET UNIT READY ROUTINE
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	GETRDXT		/STORE IN-LINE
	TAD I	GETREADY	/GET PASSED ARGUMENT
	DCA	GETARG		/STORE IN-LINE
	ISZ	GETREADY	/BUMP PAST
	CDF	PRGFLD		/GOTO OUR FIELD
GETOK,	NL0002			/SET UNIT MASK
	AND	UNIT		/ISOLATE FLEXIBLE DISK BIT
	SNA CLA			/SKIP IF FLEXIBLE DISK UNIT
	JMP	GETWIN		/JUMP IF WINCHESTER DISK UNIT
	CIF	PR2FLD		/GOTO CODE FIELD
	JMS I	(DEFORM)	/SETUP CURRENT UNIT'S FORMAT
	SNA CLA			/SKIP IF ANY ERRORS WHILE SETTING UP FORMAT
	JMP	GETOOK		/JUMP IF OK
	JMS I	[ERRMSG]	/COMPLAIN OF
	DEFEMSG			/FORMAT PROBLEMS
	JMS I	[KLUDGE]	/UGH!
	JMP I	[AGAIN]		/WAIT FOR THEM AND RESTART

GETOOK,	JMS I	[MOUNT]		/GET FLEXIBLE DISK MOUNTED
GETARG,	.-.			/PASSED MESSAGE ARGUMENT
	JMP	GECOMMON	/CONTINUE THERE

GETWIN,	JMS I	[MOUNT]		/ASK FOR
	WMTMSG			/WINCHESTER TO BE ENABLED
GECOMMO,CIF	PR2FLD		/GOTO CODE FIELD
	JMS I	(TSTREADY)	/TEST IF CURRENT DRIVE IS READY
	SNA			/SKIP IF PROBLEMATIC
	JMP	GREADY		/JUMP IF OK
	AND	(777)		/ISOLATE ERROR CODE
	TAD	[-4]		/COMPARE TO DRIVE READY ERROR
	SNA			/SKIP IF OTHER THAN READY ERROR
	JMP	GRETRY		/TRY AGAIN IF NOT READY ERROR
	TAD	(-304+4)	/COMPARE TO DRIVE NOT ENABLED ERROR
	SNA CLA			/SKIP IF NONE OF THE ABOVE
	JMP	GDNERROR	/JUMP IF DRIVE NOT ENABLED ERROR
	JMS I	[ERRMSG]	/TELL THEM
	RERRMSG			/THE BAD NEWS
	JMP I	[AGAIN]		/GOODBYE

GDNERRO,JMS I	[MESSAGE]	/TELL THEM
	DNEMSG			/DRIVE NOT ENABLED
	JMP I	[AGAIN]		/GOODBYE

GRETRY,	JMS I	[MESSAGE]	/TELL THEM
	NRDYMSG			/DRIVE IS NOT READY
	JMS I	[ASKRETRY]	/ASK FOR A RETRY
	JMP	GETOK		/TRY AGAIN
FAIL,	JMS I	[MESSAGE]	/TELL THEM
	FAILMSG			/TO FORGET IT
	JMP I	[AGAIN]		/GOODBYE
GREADY,	JMS I	[MESSAGE]	/TELL THEM
	ISRMSG			/DRIVE IS READY
GETRDXT,.-.			/WILL BE CIF CDF RETURN FIELD
	JMP I	GETREADY	/RETURN FOR MORE

TBUMP,	.-.			/TRACK BUMP ROUTINE
	NL0002			/SET FLEXIBLE/WINCHESTER DISK MASK
	AND	UNIT		/GET THE BIT
	SNA CLA			/SKIP IF FLEXIBLE DISK
	JMP	TBUMPIT		/JUMP IF WINCHESTER
	TAD	FLPFRM		/GET FLEXIBLE DISK FORMAT WORD
	RAR			/SINGLE/DOUBLE-SIDED BIT TO LINK
	SNL CLA			/SKIP IF DOUBLE-SIDED
	JMP	TBUMPIT		/JUMP IF SINGLE-SIDED
	ISZ	TBCNT		/BUMP EVEN/ODD COUNTER
	TAD	TBCNT		/GET THE VALUE
	RAR			/EVEN/ODD BIT TO LINK
	SNL CLA			/SKIP IF NOT TIME TO BUMP
TBUMPIT,ISZ	TRACK		/ELSE BUMP IT NOW
	JMP I	TBUMP		/RETURN
	ISZ	TRACK+1		/BUMP HIGH-ORDER
	JMP I	TBUMP		/RETURN

TRUPDAT,.-.			/TRACK UPDATE FACTOR ROUTINE
	NL0002			/SET FLEXIBLE/WINCHESTER DISK MASK
	AND	UNIT		/GET UNIT BIT
	SNA CLA			/SKIP IF FLEXIBLE DISK
	NL0002	/TAD	(21-17)	/SET WINCHESTER OFFSET
	TAD	(17)		/GET BASIC UPDATE VALUE
	MQL			/INTO MQ
	JMP I	TRUPDATE	/RETURN

ERROUT,	.-.			/ERROR REPORTING ROUTINE
	TAD	ERSW		/GET PRIMARY ERROR SWITCH
	SNA CLA			/SKIP IF ANY PRIMARY ERRORS
	JMP	REPALT		/JUMP IF NONE
	JMS I	[MESSAGE]	/TELL THEM
	ERPMSG			/THEY GOT PRIMARY ERRORS
REPALT,	TAD	AESW		/GET ALTERNATE ERROR SWITCH
	SNA CLA			/SKIP IF ANY ALTERNATE ERRORS
	JMP	ERRTST		/JUMP IF NO ALTERNATE ERRORS
	JMS I	[MESSAGE]	/TELL THEM
	AERMSG			/THEY GOT ALTERNATE AREA ERRORS
ERRTST,	TAD	ERSW		/GET PRIMARY ERROR SWITCH
	SNA			/SKIP IF ANY
	TAD	AESW		/ELSE GET ALTERNATE ERROR SWITCH
	SZA CLA			/SKIP IF NO ERRORS
	JMP I	ERROUT		/RETURN IF WE TOLD THEM ALREADY
	JMS I	[MESSAGE]	/TELL THEM
	ROKMSG			/READ IS OK
	JMP I	ERROUT		/RETURN
PRTWO,	.-.			/PRINT TWO CHARACTERS ROUTINE
	CDF	TBLFLD		/GOTO TABLE FIELD
	TAD I	XR2		/GET A CHARACTER
	CDF	PRGFLD		/BACK TO OUR FIELD
	JMS I	[P7CH]		/PRINT IT
	CDF	TBLFLD		/GOTO TABLE FIELD
	TAD I	XR2		/GET A CHARACTER
	CDF	PRGFLD		/BACK TO OUR FIELD
	JMS I	[P7CH]		/PRINT IT
	JMP I	PRTWO		/RETURN

SEEK,	.-.			/SEEK ROUTINE
	DST;	FBLK		/STORE PASSED LOGICAL DISK ADDRESS
SEKAGN,	CIF	PR2FLD		/GOTO PROGRAM FIELD
	JMS I	(SEKTRK)	/GO SEEK
	SNA CLA			/SKIP IF ANY ERRORS
	JMP I	SEEK		/RETURN IF NONE
	JMS I	[ERRMSG]	/COMPLAIN OF
	SKERMSG			/SEEK ERROR
	JMS I	[KLUDGE]	/UGH!
	JMS I	[ASKRETRY]	/ASK FOR A RETRY
	JMP	SEKAGN		/TRY AGAIN
	JMP I	(FAIL)		/FORGET IT

