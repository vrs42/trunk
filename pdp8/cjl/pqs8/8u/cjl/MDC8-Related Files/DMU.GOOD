	AND	UNIT		/GET UNIT TYPE
	SZA CLA			/SKIP IF WINCHESTER DISK DRIVE
	JMS I	(CHKN)		/ELSE CHECK FOR <^N>, ETC.
	JMS I	[TBUMP]		/BUMP TO NEXT DISPLAY TRACK
	ISZ	TRKCNT		/DONE YET?
	JMP	QFRMLP		/NO, KEEP GOING
