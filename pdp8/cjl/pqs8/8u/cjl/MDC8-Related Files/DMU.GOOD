	ISZ	BTCNTR		/TOO MANY ERRORS?
	JMP	WBTLP2		/NO, TRY AGAIN
	CIF	PRGFLD		/GOTO CODE FIELD
	JMS I	[ERRMSG]	/COMPLAIN OF
	WBTMSG			/TABLE WRITE PROBLEMS
	CIF	PRGFLD		/GOTO CODE FIELD
