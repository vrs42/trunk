	SNA CLA			/SKIP IF ERRORS
	JMP	QREDOK		/JUMP IF NONE
	JMS I	(COMPLAIN)	/COMPLAIN OF
	RCERMSG			/READ ERROR
	JMS I	[KLUDGE]	/UGH!
QREDOK,	JMS I	[TRUPDATE]	/UPDATE TRACK
	DAD;	FBLK		/ADD ON TO CURRENT
	DST;	FBLK		/STORE IT BACK
	JMS I	(CHKN)		/CHECK FOR <^N>, ETC.
	JMS I	[TBUMP]		/BUMP TO NEXT TRACK
