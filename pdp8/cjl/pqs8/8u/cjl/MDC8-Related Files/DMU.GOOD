	COMMSG			/COMMAND:
	TAD	XR1TMP		/SETUP THE
	DCA	XR1		/LIST POINTER
	TAD	BTCNTR		/SETUP THE
	DCA	TMPCNT		/COUNTER
	CIF	PRGFLD		/GOTO CODE FIELD
	JMS I	[TTYINC]	/GET A CHARACTER
CMAGN,	CDF	MS2FLD		/GOTO TABLE FIELD
	TAD I	XR1		/COMPARE TO LIST ELEMENT
	SNA			/SKIP IF DIFFERENT FROM LIST
	JMP	FOUND1		/JUMP IF SAME
	ISZ	TMPCNT		/LOOKED FOR ALL YET?
	JMP	CMAGN		/NO, GO BACK
COMBARF,CDF	PR2FLD		/INDICATE OUR CALLING FIELD
	CIF	PRGFLD		/GOTO CODE FIELD
	JMS I	[BONG]		/BEEP AT THEM
	CIF	PRGFLD		/GOTO CODE FIELD
	JMS I	[CRLF]		/DO A <CR>, <LF>
	JMP	COMMAGN		/TRY AGAIN

FOUND1,	CDF	PRGFLD		/GOTO CALLING FIELD
	TAD I	[INCHAR]	/GET LATEST CORRECT CHARACTER
	CDF	PR2FLD		/INDICATE OUR CALLING FIELD
	CIF	PRGFLD		/GOTO CODE FIELD
	JMS I	[P7CH]		/PRINT IT
	CIF	PRGFLD		/GOTO CODE FIELD
	JMS I	[TTYINC]	/GET SECOND CHARACTER
	CLA			/DON'T NEED IT RIGHT NOW
	JMP	FOUND2		/CONTINUE THERE

CM2AGN,	CDF	MS2FLD		/GOTO TABLE FIELD
	TAD I	XR1		/COMPARE AGAIN TO FIRST LIST ELEMENT
	SNA			/SKIP IF NOT A MATCH
	JMP	FOUND2		/JUMP IF POTENTIAL MATCH
SRCHMOR,ISZ	TMPCNT		/LOOKED AT ALL YET?
	JMP	CM2AGN		/NO, GO BACK
	JMP	COMBARF		/YES, GO COMPLAIN
FOUND2,	TAD	BTCNTR		/GET (FIRST-SECOND)
	CIA			/NOW HAVE (SECOND-FIRST)
	TAD	XR1		/POINT TO CORRESPONDING ELEMENT IN SECOND LIST
	DCA	DATSETUP	/STASH THE POINTER
	CDF	PRGFLD		/GOTO CALLING FIELD
	TAD I	[INCHAR]	/GET SECOND CHARACTER
	CDF	MS2FLD		/GOTO TABLE FIELD
	TAD I	DATSETUP	/COMPARE TO SECOND CHARACTER
	SZA CLA			/SKIP IF IT MATCHES
	JMP	SRCHMORE	/JUMP IF NOT THIS ONE
	CDF	PRGFLD		/GOTO CALLING FIELD
	TAD I	[INCHAR]	/GET THE CHARACTER
	CDF	PR2FLD		/INDICATE OUR CALLING FIELD
	CIF	PRGFLD		/GOTO CODE FIELD
	JMS I	[P7CH]		/PRINT IT NOW
	TAD	XR1TMP		/GET (FIRST-1)
	CMA			/NOW HAVE (-FIRST)
	TAD	BTCNTR		/NOW HAVE (-SECOND)
	TAD	DATSETUP	/NOW HAVE RELATIVE VALUE OF MATCH
	CLL RAL			/*2
	CDF	PRGFLD		/GOTO CALLING FIELD
	TAD I	GETCOMMAND	/POINT AT TEXT MESSAGE POINTER
	DCA	XR1		/STASH THE POINTER
	CDF	MS2FLD		/GOTO TABLE FIELD
	TAD I	XR1		/GET THE FINISHING MESSAGE POINTER
	DCA	TMPCNT		/STASH IT IN-LINE
	CDF	PR2FLD		/INDICATE OUR CALLING FIELD
	CIF	PRGFLD		/GOTO CODE FIELD
	JMS I	[MESSAGE]	/GO PRINT
TMPCNT,	.-.			/THE REST OF THE COMMAND
	CDF	MS2FLD		/GOTO TABLE FIELD
	TAD I	XR1		/GET THE DISPATCHING ADDRESS
	DCA	TMPCNT		/STASH IT
	CAM			/CLEAN UP MQ NOW
	CIF CDF	PRGFLD		/GOTO CALLING FIELD
	JMP I	TMPCNT		/GO THERE

XR1TMP,	.-.			/TEMPORARY
