BUFSETU,.-.			/BUFFER SETUP ROUTINE
	DCA	BTCNTR		/SAVE PASSED BUFFER COUNT
	MQA			/GET PASSED INITIAL BUFFER NUMBER
	DCA	BUFNUM		/SET IT UP
	CDF	PRGFLD		/ENSURE CALLING FIELD
	TAD I	(MQHOLD)	/GET SAVED MQ VALUE
	MQL			/RESTORE IT
	TAD I	(PATTERN)	/GET DATA PATTERN
	DCA	BUFPATTERN	/STORE IT
BUFLUP,	JMS	BUFCOMMON	/DO COMMON SETUP
	CDF	PRGFLD		/GOTO CALLING FIELD
	TAD I	[FBLK]		/GET LOW-ORDER BLOCK NUMBER
	JMS	DATSETUP	/GOTO BUFFER FIELD
	DCA I	XR1		/STASH IT
	CDF	PRGFLD		/GOTO CALLING FIELD
	TAD I	[FBLK+1]	/GET HIGH-ORDER BLOCK NUMBER
	JMS	DATSETUP	/GOTO BUFFER FIELD
	DCA I	XR1		/STASH IT
	TAD	BUFNUM		/GET BUFFER NUMBER
	DCA I	XR1		/STASH IT
	CDF	PRGFLD		/GOTO CALLING FIELD
	TAD I	(TRANS)		/GET LOW-ORDER TRANSACTION NUMBER
	JMS	DATSETUP	/GOTO BUFFER FIELD
	DCA I	XR1		/STASH IT
	CDF	PRGFLD		/GOTO CALLING FIELD
	TAD I	(TRANS+1)	/GET HIGH-ORDER TRANSACTION NUMBER
	JMS	DATSETUP	/GOTO BUFFER FIELD
	DCA I	XR1		/STASH IT
	TAD	(-BLKSIZE+5)	/SETUP THE
	DCA	BTRYCT		/REMAINING COUNT
BUFFIL,	TAD	BUFPATTERN	/GET DATA PATTERN
	DCA I	XR1		/STORE IT IN BUFFER
	ISZ	BTRYCT		/DONE ALL YET?
	JMP	BUFFIL		/NO, KEEP GOING
	ISZ	BUFNUM		/BUMP TO NEXT BUFFER
	ISZ	BTCNTR		/DONE ALL YET?
	JMP	BUFLUP		/NO, GO BACK
	CIF CDF	PRGFLD		/GOTO CALLING FIELD
	JMP I	BUFSETUP	/RETURN

BUFCOMM,.-.			/COMMON BUFFER SETUP ROUTINE
	TAD	BUFNUM		/GET CURRENT BUFFER NUMBER
	CLL RTR;RTR;RAR		/MOVE OVER
	DCA	ADDRESS		/STORE HEAD OF BUFFER
	RTL;RTL			/GET FIELD OFFSET
	TAD	(CDF	DATFLD)	/FORM DATA FIELD INSTRUCTION
	DCA	EXCCDF		/STORE IN-LINE
	NL7777			/BACKUP
	TAD	ADDRESS		/POINT AT BUFFER
	DCA	XR1		/STASH THE POINTER
	JMP I	BUFCOMMON	/RETURN
BUFVALI,.-.			/BUFFER VALIDATE ROUTINE
	DCA	BTCNTR		/SAVE PASSED COUNT
	MQA			/GET PASSED INITIAL BUFFER NUMBER
	DCA	BUFNUM		/SET IT UP
	CDF	PRGFLD		/ENSURE CALLING FIELD
	TAD I	(MQHOLD)	/GET SAVED MQ VALUE
	MQL			/RESTORE IT
	TAD I	(PATTERN)	/GET DATA PATTERN
	CIA			/INVERT FOR TESTING
	DCA	BUFPATTERN	/SAVE IT FOR LATER
BUFVLP,	JMS	BUFCOMMON	/DO COMMON SETUP
	JMS	DATSETUP	/GOTO BUFFER FIELD
	TAD I	XR1		/GET FIRST WORD
	CIA			/INVERT FOR TESTING
	CDF	PRGFLD		/GOTO CALLING FIELD
	TAD I	[FBLK]		/COMPARE TO BLOCK NUMBER
	SZA CLA			/SKIP IF OK
	JMP	BUFBAD		/JUMP IF NOT
	CDF	PRGFLD		/GOTO CALLING FIELD
	TAD I	[FBLK+1]	/GET HIGH-ORDER BLOCK NUMBER
	CIA			/INVERT FOR TESTING
	JMS	DATSETUP	/GOTO BUFFER FIELD
	TAD I	XR1		/GET SECOND WORD
	SZA CLA			/SKIP IF OK
	JMP	BUFBAD		/JUMP IF NOT
	TAD I	XR1		/GET THIRD WORD
	CIA			/INVERT FOR TESTING
	TAD	BUFNUM		/COMPARE TO BUFFER NUMBER
	SZA CLA			/SKIP IF OK
	JMP	BUFBAD		/JUMP IF NOT
	TAD I	XR1		/GET FOURTH WORD
	CIA			/INVERT FOR TESTING
	CDF	PRGFLD		/GOTO CALLING FIELD
	TAD I	(TRANS)		/COMPARE TO TRANSACTION NUMBER
	SZA CLA			/SKIP IF OK
	JMP	BUFBAD		/JUMP IF NOT
	TAD I	(TRANS+1)	/GET HIGH-ORDER TRANSACTION NUMBER
	CIA			/INVERT FOR TESTING
	JMS	DATSETUP	/GOTO BUFFER FIELD
	TAD I	XR1		/COMPARE TO FIFTH WORD
	SZA CLA			/SKIP IF OK
	JMP	BUFBAD		/JUMP IF NOT
	TAD	(-BLKSIZE+5)	/SETUP THE
	DCA	BTRYCT		/REMAINING COUNT
CMPLUP,	TAD I	XR1		/GET A WORD
	TAD	BUFPATTERN	/COMPARE TO DESIRED
	SZA CLA			/SKIP IF OK
	JMP	BUFBAD		/JUMP IF NOT
	ISZ	BTRYCT		/DONE ALL YET?
	JMP	CMPLUP		/NO, KEEP GOING
	ISZ	BUFNUM		/BUMP TO NEXT BUFFER
	ISZ	BTCNTR		/DONE ALL BUFFERS?
	JMP	BUFVLP		/NO, KEEP GOING
	ISZ	BUFVALIDATE	/BUMP TO GOOD RETURN
BUFBAD,	CIF CDF	PRGFLD		/BACK TO CALLING FIELD
	JMP I	BUFVALIDATE	/RETURN EITHER WAY

ADDRESS,.-.			/BUFFER ADDRESS
BUFNUM,	.-.			/BUFFER NUMBER
BUFPATT,.-.			/BUFFER PATTERN WORD

