MESSAGE,.-.			/MESSAGE PRINTING ROUTINE
	JMS	SETFLD		/SET RETURN FIELD
	DCA	MESXIT		/STORE IN-LINE
	TAD	[MS2FLD-MSGFLD]	/SETUP OUR
	DCA	MFOFFSET	/FIELD OFFSET
	TAD	(CDF	MSGFLD)	/GET OUR MESSAGE FIELD
MSGENTR,DCA	EXCCDF		/SET IT UP
	TAD	(140)		/INITIALIZE TO
	DCA	MSGCASE		/LOWER-CASE
	TAD I	MESSAGE		/GET THE POINTER
	DCA	MSGPTR		/STASH IT
	TAD I	MESSAGE		/GET IT AGAIN
	RAR			/MOVE EVEN/ODD BIT TO LINK
