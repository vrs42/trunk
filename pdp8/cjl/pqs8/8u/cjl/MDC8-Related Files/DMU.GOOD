XMOVE,	.-.			/MOVE ROUTINE
	SNA			/ANY PASSED COUNT?
	TAD	[-BLKSIZE]	/NO, ASSUME ONE BLOCK'S WORTH
	DCA	CNT		/SAVE THE COUNT
	TAD I	XMOVE		/GET "FROM" ARGUMENT
	DCA	TEMP		/STASH IT
	TAD I	TEMP		/GET "FROM" ADDRESS
	DCA	DATSETUP	/STASH THE POINTER
	ISZ	TEMP		/BUMP TO FIELD WORD
	TAD I	TEMP		/GET THE FIELD
	RTL;RAL			/MOVE UP
	AND	(70)		/JUST FIELD BITS
	TAD	[CDF]		/FORM CDF INSTRUCTION
	DCA	FROMCDF		/STORE IN-LINE
	ISZ	XMOVE		/BUMP TO NEXT
	TAD I	XMOVE		/GET "TO" ARGUMENT
	DCA	TEMP		/STASH IT
	ISZ	XMOVE		/BUMP PAST
	TAD I	TEMP		/GET "TO" ADDRESS
	DCA	SETFLD		/STASH THE POINTER
	ISZ	TEMP		/BUMP "TO" FIELD WORD
	TAD I	TEMP		/GET THE FIELD
	RTL;RAL			/MOVE UP
	AND	(70)		/JUST FIELD BITS
	TAD	[CDF]		/FORM CDF INSTRUCTION
	DCA	TOCDF		/STORE IN-LINE
FROMCDF,.-.			/GOTO "FROM" FIELD
	TAD I	DATSETUP	/GET A WORD
TOCDF,	.-.			/GOTO "TO" FIELD
	DCA I	SETFLD		/PUT A WORD
	ISZ	DATSETUP	/BUMP "FROM" POINTER
	JMP	FROMOK		/KEEP GOING
	TAD	FROMCDF		/GET CURRENT FIELD
	TAD	[10]		/ADD ON UPDATE FACTOR
	DCA	FROMCDF		/STORE UPDATED VALUE
FROMOK,	ISZ	SETFLD		/BUMP "TO" POINTER
	JMP	TOOK		/KEEP GOING
	TAD	TOCDF		/GET CURRENT FIELD
	TAD	[10]		/ADD ON UPDATE FACTOR
	DCA	TOCDF		/STORE UPDATED VALUE
TOOK,	ISZ	CNT		/DONE YET?
	JMP	FROMCDF		/NO, GO BACK
	CDF	PRGFLD		/YES, BACK TO OUR FIELD
	JMP I	XMOVE		/RETURN
TABCHK,	.-.			/CHECK IF FLAW MAP IS OK
	JMS I	(FLUCHK)	/CHECK IF UNIT IS INVALID
	JMP I	TABCHK		/TAKE IMMEDIATE RETURN IF NOT
	CIF	PR2FLD		/GOTO CODE FIELD
	JMS I	(RBTTBL)	/TRY TO READ IN THE TABLE
	TAD	TVSW		/GET VALIDITY SWITCH
	SMA CLA			/SKIP IF BAD
	JMP	TBISOK		/JUMP IF OK
