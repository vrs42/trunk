	TAD I	GETCOMMAND	/GET COUNT
	DCA	BTCNTR		/STASH THE COUNT
	ISZ	GETCOMMAND	/BUMP TO NEXT
COMMAGN,CDF	PRGFLD		/ENSURE CALLING FIELD
	TAD	(COMMAGN)	/SETUP THE
	DCA I	[UPURET]	/<^U> ADDRESS
	CDF	PR2FLD		/INDICATE OUR CALLING FIELD
	CIF	PRGFLD		/GOTO CODE FIELD
