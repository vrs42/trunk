	TAD	(-37-1)		/SUBTRACT LIMIT
	CLL			/CLEAR LINK FOR TEST
	TAD	(37)		/ADD ON RANGE
	SNL			/SKIP IF OK
	JMP	DATBAD		/JUMP IF NOT
	DCA	DAYCT		/SAVE UNTIL YEAR IS KNOWN
	ISZ I	(FEBENT)	/ASSUME THIS IS LEAP YEAR!
	JMS	DATCHK		/CHECK FOR VALID DAY
	JMS I	(DEP2)		/STORE DAYS DIGITS
	TAD	("/&177)	/GET A "/"
	CIF	PRGFLD		/GOTO CODE FIELD
	JMS I	[P7CH]		/PRINT IT
	JMS I	(GETVALUE)	/GET YEAR VALUE
	DCA	GETEMP		/SAVE IT
	CDF	TBLFLD		/GOTO TABLE FIELD
	TAD	GETEMP		/GET IT BACK
	TAD	(-120+1)	/COMPARE TO (19)80
	SPA SNA CLA		/SKIP IF IN RANGE
	JMP	DO2000		/ELSE ASSUME 2000-2079
	TAD	("1&177)	/GET A "1"
	DCA I	XR2		/STORE AS UPPER DECADE DIGIT
	TAD	("9&177)	/GET A "9"
	JMP	DECCOMMON	/CONTINUE THERE

DO2000,	TAD	("2&177)	/GET A "2"
	DCA I	XR2		/STORE AS UPPER DECADE DIGIT
	TAD	("0&177)	/GET A "0"
DECCOMM,DCA I	XR2		/STORE AS LOWER DECADE DIGIT
	JMS I	(DEP2)		/STORE YEARS DIGITS
	NL0003			/FORM LEAP YEAR MASK
	AND	GETEMP		/JUST LEAP YEAR BITS
	SNA CLA			/SKIP IF NOT LEAP YEAR
	ISZ I	(FEBENT)	/ELSE BUMP IT FOR LEAP YEAR
	JMS	DATCHK		/CHECK FOR VALID DAY AGAIN
	CIF	PRGFLD		/GOTO CODE FIELD
	JMS I	[CRLF]		/DO A <CR>, <LF>
	CIF CDF	PRGFLD		/GOTO CALLING FIELD
	JMP I	GETDATE		/RETURN

DATBAD,	CIF	PRGFLD		/GOTO CODE FIELD
	JMS I	[MESSAGE]	/TELL THEM
	BDTMSG			/THEY GOOFED
	JMP	GETDAGN		/TRY AGAIN

DATCHK,	.-.			/DATE VALIDITY CHECK ROUTINE
	TAD	MONCT		/GET MONTH COUNT
	TAD	(JANENT/+14)	/UPDATE TO PROPER MONTH
	DCA	GETEMP		/STASH THE POINTER
	TAD I	GETEMP		/GET THE MONTH COUNT
	CIA			/INVERT FOR TESTING
	TAD	DAYCT		/COMPARE TO OUR VALUE
	DCA	GETEMP		/SAVE TEST RESULTS FOR LATER
	TAD	(34)		/RESET THE FEBRUARY
	DCA I	(FEBENT)	/NON-LEAP YEAR VALUE
	TAD	GETEMP		/GET TEST RESULTS
	SMA CLA			/SKIP IF OK
	JMP	DATBAD		/ELSE RESTART
	JMP I	DATCHK		/RETURN

