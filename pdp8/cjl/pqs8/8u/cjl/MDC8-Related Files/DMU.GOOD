	SNA CLA				/SKIP IF ANY ERRORS
	JMP	RWWROK			/JUMP IF OK
	TAD	EXSW			/GET EXERCISER SWITCH
	SNA CLA				/SKIP IF EXERCISER IS CALLING US
	JMP	WENORMAL		/JUMP OTHERWISE
	TAD	(W0ERRLO-1)		/POINT AT WRITE ERROR
RWXXIT,	TAD	UNIT			/*1
	TAD	UNIT			/*2
	TAD	UNIT			/*3
	TAD	UNIT			/*4
	TAD	UNIT			/*5
	TAD	UNIT			/*6
	DCA	XR1			/STASH THE ERROR POINTER
	CDF	PR2FLD			/GOTO TABLE FIELD
	ISZ I	XR1			/BUMP LOW-ORDER
	SKP				/SKIP IF NO OVERFLOW
	ISZ I	XR1			/ELSE BUMP HIGH-ORDER
	CDF	PRGFLD			/BACK TO OUR FIELD
	JMP I	RWCHECK			/FORGET IT

WENORMA,JMS I	[ERRMSG]		/COMPLAIN OF
	WCERMSG				/WRITE ERROR
RWBCOMM,JMS I	[KLUDGE]		/UGH!
	JMS I	[ASKRETRY]		/RETRY?
	JMP	RWCHAGN			/YES
	JMS	BUMPERRORS		/BUMP ERROR COUNT
	JMP I	RWCHECK			/RETURN

RWWROK,/NL0000				/INDICATE READ
	CIF	PR2FLD			/GOTO CODE FIELD
	JMS I	(RDSECTORS)		/READ IT BACK IN
	SNA CLA				/SKIP IF ANY ERRORS
	JMP	RWRDOK			/JUMP IF OK
	TAD	EXSW			/GET EXERCISER SWITCH
	SNA CLA				/SKIP IF EXERCISER CALLING US
	JMP	RENORMAL		/JUMP OTHERWISE
	TAD	(R0ERRLO-1)		/POINT AT READ ERROR
	JMP	RWXXIT			/FINISH IT THERE

RENORMA,JMS I	[ERRMSG]		/COMPLAIN OF
	RCERMSG				/READ ERROR
	JMP	RWBCOMMON		/CONTINUE THERE
RWRDOK,	TAD	UNIT		/GET CURRENT UNIT
	CLL RTR;RTR		/MOVE OVER
	DCA	ERRTEMP		/SAVE IN CASE OF COMPARE ERROR
	MQA			/GET CURRENT MQ VALUE
	DCA	MQHOLD		/SAVE IT
/	NL0000			/INDICATE INITIAL BUFFER VALUE
	MQL			/PASSED IN MQ
	TAD	SECTCNT		/GET BUFFER LENGTH
	CIF	PR2FLD		/GOTO CODE FIELD
	JMS I	(BUFVALIDATE)	/VALIDATE READ
	JMP	RWRDBAD		/JUMP IF BAD
	JMP I	RWCHECK		/RETURN

RWRDBAD,TAD	EXSW		/GET EXERCISER SWITCH
	SNA CLA			/SKIP IF EXERCISER CALLING US
	JMP	CENORMAL	/JUMP OTHERWISE
	TAD	(C0ERRLO-1)	/POINT AT COMPARE ERROR
	JMP	RWXXIT		/FINITH IT THERE

CENORMA,JMS I	[ERRMSG]	/COMPLAIN OF
	CMEMSG			/COMPARE ERROR
	JMP	RWBCOMMON	/CONTINUE THERE

BUMPERR,.-.			/ERROR SWITCH BUMPING ROUTINE
BUMPAGN,ISZ	ERSW		/BUMP IT IN THE SIMPLE CASE
	JMP I	BUMPERRORS	/JUST RETURN
	NL7776			/RESET THE
	DCA	ERSW		/SWITCH
	JMP	BUMPAGN		/TRY AGAIN

ERRBUMP,.-.			/ERROR BUMPING ROUTINE
	NL0002			/SET FLEXIBLE/WINCHESTER DISK BIT
	AND	UNIT		/GET THE BIT
	SNA CLA			/SKIP IF FLEXIBLE DISK UNIT
	JMP	WRDERROR	/JUMP IF WINCHESTER DISK UNIT
REGERR,	JMS	BUMPERRORS	/BUMP NORMAL ERROR COUNT
	JMP I	ERRBUMP		/RETURN

WRDERRO,DLD;	WTRKS		/GET LARGEST LOGICAL TRACK
	DCM			/INVERT IT
	DAD;	TRACK		/COMPARE TO CURRENT VALUE
	SPA CLA			/SKIP IF PAST LIMIT
	JMP	REGERROR	/JUMP IF BEFORE LIMIT
	ISZ	AESW		/BUMP ALTERNATE ERROR SWITCH
	JMP I	ERRBUMP		/RETURN
/	DMA BUFFER READ ROUTINE (ACTUALLY DISK READ ROUTINE.)

DMREAD,	.-.				/DMA READ ROUTINE
	DST;	DMADDRESS		/STORE PASSED ADDRESS
DMRAGN,	NL0000				/INDICATE READ
	CIF	PR2FLD			/GOTO CODE FIELD
	JMS I	(DMEMPTY)		/CALL EMPTY ROUTINE
	SNA CLA				/SKIP IF PROBLEMS
	JMP I	DMREAD			/ELSE RETURN
	JMS I	[ERRMSG]		/TELL THEM
	RCERMSG				/OF ERROR
	JMS I	[KLUDGE]		/UGH!
	JMS I	[ASKRETRY]		/ASK FOR A RETRY
	JMP	DMRAGN			/TRY AGAIN
	JMP I	(FAIL)			/FORGET IT

/	DMA BUFFFER WRITE ROUTINE (ACTUALLY DISK WRITE ROUTINE.)

DMWRITE,.-.				/DMA WRITE ROUTINE
	DST;	DMADDRESS		/STORE PASSED ADDRESS
DMWAGN,	NL0002	/TAD	(WRITFN-READFN)	/INDICATE WRITE
	CIF	PR2FLD			/GOTO CODE FIELD
	JMS I	(DMEMPTY)		/CALL FILL ROUTINE
	SNA CLA				/SKIP IF PROBLEMS
	JMP I	DMWRITE			/ELSE RETURN
	JMS I	[ERRMSG]		/TELL THEM
	WCERMSG				/OF ERROR
	JMS I	[KLUDGE]		/UGH!
	JMS I	[ASKRETRY]		/ASK FOR A RETRY
	JMP	DMWAGN			/TRY AGAIN
	JMP I	(FAIL)			/FORGET IT

MQHOLD,	.-.				/MQ SAVED HERE

	PAGE
/	READ SETUP ROUTINE.

RSETUP,	.-.			/READ SETUP ROUTINE
	CAM			/CLEAN UP
	DST;	FBLK		/CLEAR BLOCK NUMBER
	DCA	TRACK		/CLEAR DISPLAY TRACK
	DCA	TBCNT		/CLEAR EVEN/ODD COUNTER
	DCA	ERSW		/CLEAR ERROR SWITCH
	DCA	AESW		/CLEAR ALTERNATE ERROR SWITCH
	TAD	FLPFRM		/GET FLEXIBLE DISK FORMAT WORD
	RAR			/SINGLE/DOUBLE-SIDED BIT TO LINK
	CLA			/CLEAN UP
	TAD	(-FLXTRKS)	/SETUP BASIC TRACK COUNT
	SZL			/SKIP IF SINGLE-SIDED DISK
	CLL RAL			/ELSE DOUBLE IT
	DCA	TRKCNT		/STORE LOW-ORDER COUNT
	NL7777			/SET EXTENSION BITS
	DCA	TRKCNHI		/STORE HIGH-ORDER COUNT
	NL0002			/SET UNIT MASK
	AND	UNIT		/GET THE BIT
	SZA CLA			/SKIP IF WINCHESTER UNIT
	JMP	RSETXT		/JUMP IF FLEXIBLE DISK
	DLD;	WTRKS		/GET WINCHESTER LOGICAL LENGTH
	DCM			/INVERT IT
	DST;	TRKCNT		/STORE IT
RSETXT,	CAM			/CLEAN UP
	JMP I	RSETUP		/RETURN

/	FLAW SUPPORT ROUTINE.

ADCHEK,	.-.			/ADD CHECK ROUTINE
	JMS	TRCHEK		/CHECK FOR IMPROPER VALUE
	SZA CLA			/SKIP IF OK
	JMP	ADDBAD		/JUMP IF NOT
	DLD;	TRACK		/GET THE VALUE
	DST;	FBLK		/PUT INTO SEARCH ARGUMENT
	CAM			/CLEAN UP
	TAD	(1777)		/SETUP THE
	DCA	SMASK		/SEARCH MASK
	CIF	PR2FLD		/GOTO CODE FIELD
	JMS I	(SEFLAW)	/TRY TO FIND IT
	ISZ	ADCHEK		/BUMP RETURN IF NOT THERE
	JMP I	ADCHEK		/RETURN EITHER WAY
/	FLAW MAP SUPPORT ROUTINES.

HGHCHK,	.-.			/HIGH CHECK ROUTINE
	DLD;	LOGMAX		/GET UPPER LIMIT
	DCM			/INVERT IT
	DAD;	TRACK		/ADD ON USER VALUE
	SPA CLA			/SKIP IF NOT BELOW LIMIT
	JMP I	HGHCHK		/RETURN IF OK
HGHFLAW,JMS I	[MESSAGE]	/TELL THEM
	THIMSG			/TOO HIGH
	JMP I	EDFRESTART	/TRY AGAIN

RNGCHK,	.-.			/RANGE CHECK ROUTINE
	DLD;	LOGMAX		/GET LOWER LIMIT
	DCM			/INVERT IT
	DAD;	TRACK		/COMPARE TO GIVEN VALUE
	SPA CLA			/SKIP IF OK
	JMP	LOWFLAW		/JUMP IF TOO LOW
	DLD;	BTBLKINITIAL	/GET UPPER LIMIT
	DCM			/INVERT IT
	DAD;	TRACK		/COMPARE TO GIVEN VALUE
	SMA CLA			/SKIP IF LESS
	JMP	HGHFLAW		/JUMP IF NOT
	JMP I	RNGCHK		/RETURN IF OK

ADDBAD,	JMS I	[MESSAGE]	/TELL THEM
	IMPMSG			/OF IMPROPER VALUE
	JMP I	EDFRESTART	/TRY AGAIN

DUPENTR,JMS I	[MESSAGE]	/TELL THEM
	DPEMSG			/ENTRY ALREADY EXISTS
	JMP I	EDFRESTART	/TRY AGAIN

LOWFLAW,JMS I	[MESSAGE]	/TELL THEM
	TLOMSG			/TOO LOW
	JMP I	EDFRESTART	/TRY AGAIN

MAPFULL,JMS I	[MESSAGE]	/TELL THEM
	FLMMSG			/MAP IS FULL
	JMP I	(EDFAGN)	/FORGET IT
QBTEST,	.-.			/QUICK DRIVE ENABLE TEST ROUTINE
	NL0004			/SET OFFSET
	TAD	QTSTCT		/GET CURRENT COUNT
	DCA	UNIT		/SAVE AS LATEST UNIT
	TAD	QTSTCT		/GET CURRENT COUNT
	DCA	TEMP		/STASH IT
	TAD	(20)		/GET INITIAL BIT VALUE
	CLL RAR			/MOVE OVER
	ISZ	TEMP		/DONE YET?
	JMP	.-2		/NO, KEEP GOING
	AND	EXWORD		/YES, TEST CORRESPONDING ENABLE BIT
	JMP I	QBTEST		/RETURN

SETUP,	.-.			/<^P> SETUP ROUTINE
	NL7777			/BACKUP CALLER
	TAD	SETUP		/GET OUR CALLER
	DCA	UPREST		/USE FOR <^P> PURPOSES
	JMP I	SETUP		/RETURN

TRCHEK,	.-.			/TRACK ADDRESS VALIDITY CHECKER
	TAD	TRACK+1		/GET HIGH-ORDER VALUE
	MQL			/PUT IN LOW-ORDER
	CIF	PR2FLD		/GOTO CODE FIELD
	JMS I	(SETSIZE)	/SETUP DEVICE-DEPENDENT SIZE
	CIA			/WANT POSITIVE FORM
	DCA	TEMP		/STORE IT
	DVI;	TEMP		/DIVIDE
	SWP			/GET QUOTIENT
	DCA	HIQUO		/SAVE IT
	TAD	TRACK		/GET LOW-ORDER VALUE
	SWP			/PUT IN LOW-ORDER
	DVI;	TEMP		/DIVIDE
	SWP			/GET LOW-ORDER
	DCA	LOQUO		/SAVE IT
	SWP			/GET REMAINDER
	JMP I	TRCHEK		/RETURN

HIQUO,	.-.			/HIGH-ORDER QUOTIENT
LOQUO,	.-.			/LOW-ORDER QUOTIENT

	PAGE
/	I/O HANDLER FOR MDC8.

/	USAGE:

/	CDF	MYFLD		/SET CALLING DATA FIELD
/	CIF	PRGFLD		/SET HANDLER FIELD
/	JMS I	[IOHAND]	/CALL HANDLER
/	ADDRESS			/LOW-ORDER TRANSFER ADDRESS
/	FUNCTION		/FUNCTION WORD;SEE BELOW
/	POINTER			/POINTER TO I/O RECORD NUMBER;SEE BELOW
/	ERROR RETURN		/RETURNS HERE WITH AC=4000 IF ERROR
/	GOOD RETURN		/RETURNS HERE WITH AC=0000 IF OK

/	FUNCTION WORD:

/	BIT[0]:			READ/WRITE
/	BITS[1-5]:		PAGE COUNT
/	BITS[6-8]:		TRANSFER FIELD
/	BIT[9]:			UNUSED
/	BIT[10-11]:		LOGICAL UNIT ON MDC8

/	POINTER:

/	POINTER CONTAINS ADDRESS OF DOUBLE-WORD DISK RECORD NUMBER
/	IN DOUBLE-PRECISION EAE FORMAT (LOW, HIGH).
/	COMMAND TABLE DEFINITIONS.

/	WORD	1:	POSITIVE LENGTH OF ENTIRE TABLE IN WORDS.

/	WORD	2:	COMMAND TYPE (0000 FOR DISK READ/WRITE).

/	WORD	3:	COMMAND (0010:READ, 0012:WRITE).

/	WORD	4:	DRIVE CODE (0:WINCHESTER #1, 1:WINCHESTER #2
/			2:FLEXIBLE DISK #1, 3:FLEXIBLE DISK #2).

/	WORD	5:	CONTROL WORD (0:USE DEFAULTS;SEE BREAKDOWN.).

/	WORD	6:	HIGH-ORDER SIX BITS OF DISK ADDRESS.

/	WORD	7:	MIDDLE SIX BITS OF DISK ADDRESS.

/	WORD	8:	LOW-ORDER SIX BITS OF DISK ADDRESS.

/	WORD	9:	SECTOR COUNT (1-20 FOR OS/8;200 MAXIMUM).

/	WORD   10:	BANK AND FIELD (BANK:0000, FIELD:0-7 FOR OS/8).

/	WORD   11:	HIGH-ORDER SIX BITS OF MEMORY ADDRESS.

/	WORD   12:	LOW-ORDER SIX BITS OF MEMORY ADDRESS.

/	ALL WORDS IGNORE THE HIGH-ORDER FOUR BITS AND ARE SENT AS AN
/	EIGHT-BIT BYTE TO THE CONTROLLER.

/	ALL SIX-BIT ORIENTED WORDS IGNORE THE HIGH-ORDER TWO BITS OF THE
/	EIGHT-BIT BYTE.
/	CONTROL WORD BREAKDOWN.

/	BITS[0-3]:	IGNORED.

/	BIT   [4]:	0:DEFAULT CONTROLLER TO 0 0 0 0 1 0 0 0 X 0 1 X
/			EQUIVALENT PATTERN WITHIN THIS WORD.
/			1:READ OTHER BITS FOR NON-DEFAULT PATTERN.

/	BIT   [5]:	0:NO "FAST HANDSHAKE" MODE DURING BUFFERED TRANSFERS.
/			1:USE "FAST HANDSHAKE" MODE DURING BUFFERED TRANSFERS.

/	BIT   [6]:	0:USE LOGICAL DISK ADDRESSING.
/			1:USE PHYSICAL DISK ADDRESSING.

/	BIT   [7]:	0:ENABLE RETRIES.
/			1:DISABLE RETRIES.

/	BIT   [8]:	0:DISABLE ERROR CORRECTION ON FLOPPIES.
/			1:ENABLE ERROR CORRECTION ON FLOPPIES.
/			N. B. REVERSE IS TRUE FOR WINCHESTERS;DOES NOT APPLY TO DIRECT
/			READS.

/	BIT   [9]:	0:DISABLE WRITING OF DELETED DATA MARKS.
/			1:ENABLE WRITING OF DELETED DATA MARKS ON FLOPPIES ONLY.

/	BIT  [10]:	0:ENABLE BUFFERED TRANSFER.
/			1:DISABLE BUFFERED TRANSFER.

/	BIT  [11]:	0:DISABLE HALF-SECTOR READ ON FINAL SECTOR
/			1:ENABLE HALF-SECTOR READ ON FINAL SECTOR.
/			(CAUSES LAST READ TO BE A BUFFERED TRANSFER)
IOHAND,	.-.			/HANDLER ENTRY POINT
	CLA			/CLEAN UP
	RDF			/GET CALLING FIELD
	TAD	LCIF		/MAKE INTO CIF RETURN FIELD INSTRUCTION
	DCA	RETFLD		/STORE IN-LINE
	TAD I	IOHAND		/GET TRANSFER ADDRESS
	RTR;RTR;RTR		/MOVE DOWN
	DCA	TRADRHI		/STORE HIGH-ORDER HALF
	TAD I	IOHAND		/GET IT AGAIN
	DCA	TRADRLO		/STORE LOW-ORDER HALF
	ISZ	IOHAND		/BUMP TO FUNCTION WORD
	NL4000			/SET READ/WRITE MASK
	AND I	IOHAND		/GET READ/WRITE MASK
	CLL IAC RTL		/4 IF READING, 5 IF WRITING
	RAL			/10 IF READING, 12 IF WRITING
	DCA	RWCOM		/STORE AS COMMAND
	NL3777			/SETUP PAGE COUNT MASK
	AND I	IOHAND		/GET PAGE BITS (OTHERS DON'T MATTER)
	TAD	L100		/ROUND UP
	AND	[7600]		/JUST PAGE BITS
	SNA			/SKIP IF NOT MAXIMUM CALL
	NL4000			/ELSE SET MAXIMUM VALUE
	CLL RTL;RTL;RTL		/REDUCE TO SECTOR COUNT
	DCA	SCTCNT		/STASH IT
	TAD I	IOHAND		/GET FUNCTION WORD AGAIN
	AND	L100		/JUST HALF-SECTOR BIT
	SZA CLA			/SKIP IF OFF
	IAC			/ELSE SET HALF-SECTOR BIT
	TAD	L202		/GET NON-DEFAULT BITS
	DCA	DCONTROL	/STASH CONTROL WORD
	TAD I	IOHAND		/GET FUNCTION WORD AGAIN
	AND	L70		/JUST TRANSFER FIELD BITS
	CLL RTR;RAR		/MOVE OVER
	DCA	TRFLD		/SAVE IN BANK AND FIELD WORD
	NL0003			/SET UNIT MASK
	AND I	IOHAND		/GET LOGICAL UNIT BITS
	DCA	DRVUNT		/STORE IN DRIVE WORD
	RIF			/GET OUR FIELD
	CLL RTR;RAR		/MOVE OVER
	DSHI			/SETUP COMMAND FIELD
	ISZ	IOHAND		/BUMP TO RECORD POINTER
	TAD I	IOHAND		/GET RECORD POINTER
	DCA	IOTEMP		/STASH IT
	ISZ	IOHAND		/BUMP TO ERROR RETURN
	TAD I	IOTEMP		/GET LOW-ORDER PORTION OF DISK ADDRESS
	RTR;RTR;RTR		/MOVE OVER
	DCA	SECTMD		/STASH HIGH-ORDER HALF
	TAD I	IOTEMP		/GET LOW-ORDER PORTION AGAIN
	DCA	SECTLO		/STASH LOW-ORDER HALF
	ISZ	IOTEMP		/BUMP TO HIGH-ORDER PORTION
	TAD I	IOTEMP		/GET HIGH-ORDER PORTION
	DCA	SECTHI		/STASH IT
	TAD	L7700		/GET COUNTER VALUE
	DCA	IOTEMP		/STASH IT
	TAD	(TABLE)		/GET TABLE ADDRESS
	ISZ	IOTEMP		/WAIT
	JMP	.-1		/FOR AWHILE
	DSGO			/GO START IT UP
	DSSF			/FLAG UP?
	JMP	.-1		/NO, WAIT FOR IT
	DSCF			/YES, CLEAR THE FLAG
	AND I	0		/WASTE
	AND I	0		/SOME
	AND I	0		/TIME
LCIF,	CIF			/CIF CONSTANT
L100,	100			/CONSTANT 0100
L202,	202			/CONSTANT 0202
L70,	70			/CONSTANT 0070
L7700,	7700			/CONSTANT 7700
	DSRS			/GET THE RETURNED STATUS
	DCA	ERRTEMP		/SAVE IT
	TAD	ERRTEMP		/GET IT BACK
	SZA			/SKIP IF OK
	NL4000			/ELSE SET BAD VALUE
	SMA			/SKIP IF BAD
	ISZ	IOHAND		/ELSE BUMP RETURN ADDRESS
RETFLD,	.-.			/WILL BE CIF RETURN FIELD
	JMP I	IOHAND		/RETURN TO CALLER

/	COMMAND TABLE.

TABLE,	COMMEND-TABLE&377	/LENGTH OF WHOLE TABLE INCLUDING THIS WORD
COMTYPE,0&377			/COMMAND TYPE
RWCOM,	.-.&377			/0010 IF READING, 0012 IF WRITING
DRVUNT,	.-.&377			/0000 IF WINCHESTER DRIVE 0, 0001 IF WINCHESTER DRIVE 1
				/0002 IF FLEXIBLE DISK DRIVE 0
				/0003 IF FLEXIBLE DISK DRIVE 1
DCONTRL,.-.&377			/CONTROL WORD
SECTHI,	.-.&77			/DISK ADDRESS - HIGH-ORDER SIX BITS
SECTMD,	.-.&77			/DISK ADDRESS - MIDDLE SIX BITS
SECTLO,	.-.&77			/DISK ADDRESS - LOW-ORDER SIX BITS
SCTCNT,	.-.&377			/SECTOR COUNTER (1-20)
TRFLD,	.-.&377			/BANK (0000) AND TRANSFER FIELD (0-7)
TRADRHI,.-.&77			/TRANSFER ADDRESS - HIGH-ORDER SIX BITS
TRADRLO,.-.&77			/TRANSFER ADDRESS - LOW-ORDER SIX BITS

	COMMEND=.		/END OF COMMAND TABLE

IOTEMP,	.-.			/TEMPORARY
/	DOUBLE-PRECISION DATA, ETC.

BTBLKIN,BTBLO;	BTBHI		/DISK ADDRESS OF FIRST BAD TRACK TABLE
DMADDR,	ZBLOCK	2		/DMA ADDRESS
DSTROKE,			/DOWNSTROKE ADDRESS
FLWBLK,	ZBLOCK	2		/FLAW MAP BLOCK
KL1,	.-.			/FIRST MEMORY SIZE DIGIT
KL2,	.-.			/SECOND MEMORY SIZE DIGIT
KL3,	.-.			/THIRD MEMORY SIZE DIGIT
KL4,	.-.			/FOURTH MEMORY SIZE DIGIT
LOGMAX,	LMAXLO;	LMAXHI		/LARGEST LOGICAL SECTOR ON PRIME AREA OF DISK
L21,	21;	0		/CONSTANT 00000021
MFLMAX,	-FLMAXLO;-FLMAXHI-1	/FLEXIBLE DISK ADDRESS LIMIT
MFL1MAX,-FL1MXLO;-FL1MXHI-1	/SINGLE-SIDED FLEXIBLE DISK ADDRESS LIMIT
MPMAX,	-PMAXLO;-PMAXHI-1	/WINCHESTER DISK PHYSICAL ADDRESS LIMIT
M1,	-1;	-0-1		/CONSTANT 77777777
M21,	-21;	-0-1		/CONSTANT 77777757
WTRKS,	WLSCTLO;WLSCTHI		/TRACK COUNT - WINCHESTER (LOGICAL)
WTRKSMX,WPSCTLO;WPSCTHI		/TRACK COUNT - WINCHESTER (PHYSICAL)

	PAGE
	ZBLOCK	.+BLKSIZE-1&MBLKSIZ-.	/FORCE A GOOD BOUNDARY

/	COMES HERE FOR INITIALIZATION.

/	USED LATER FOR DMA TESTING, ETC.

INITIAL,KCCIOT				/CLEAR CONSOLE FLAG
	LKRBIOT				/CLEAR LPT: INPUT FLAG
	CAM				/CLEAN UP
	TLSIOT				/SET TTY: FLAG
	LLSIOT				/SET LPT: FLAG
	LAS				/GET SWITCHES
	PDEBUG^SMA CLA			/SKIP IF SET
	JMP	LEAVIT			/JUST RETURN
	TAD I	(P7PRT)			/GET ZAP INSTRUCTION
	DCA I	(P7ZAP)			/ZAP IT IN
	TAD	(OTHJMP)		/GET ZAP INSTRUCTION
	DCA I	(OTHZAP)		/ZAP IT IN
LEAVIT,	TAD	(213)			/SETUP THE
	DCA	FLPFRM			/DEFAULT FLEXIBLE DISK FORMAT
	DCA	FAMODE			/DEFAULT IS USER MODE FOR FLAW TABLES
	NL0001				/SET THE
	DCA	RCSW			/READ CHECK SWITCH
	NL0001				/SETUP THE DEFAULT
	DCA	FINTLV			/FLEXIBLE DISK INTERLEAVE FACTOR
	NL0006				/SETUP THE DEFAULT
	DCA	WINTLV			/WINCHESTER DISK INTERLEAVE FACTOR
	DST;	TRANS			/CLEAR OUT TRANSACTION NUMBER
	NL4000				/SETUP THE DEFAULT
	DCA	FLWUNIT			/FLAW UNIT VALUE (NO DRIVE)
	NL4000				/SETUP THE DEFAULT
	DCA	DMAUNIT			/DMA UNIT VALUE (NO DRIVE)
	NL4000				/SETUP THE DEFAULT
	DCA	WBUNIT			/WINCHESTER UNIT VALUE (NO DRIVE)
	DCA	VOSW			/DEFAULT IS TO COPY, NOT COMPARE
	TAD	(2525)			/USE THE WORST CASE
	DCA	DMAPATTERN		/FOR DMA PATTERN
	TAD	(-7)			/SETUP THE FIELD
	DCA	CMPCNT			/TESTING COUNT
	TAD	(NOP)			/GET SAFE INSTRUCTION
	DCA	EXSW			/SAVE IN OUR FIELD
MTRYNXT,CDF	PRGFLD		/RESET TO OUR FIELD
MCDFNXT,CDF	10		/TEST FOR LATEST FIELD
	TAD I	(EXSW)		/GET VALUE
	DCA	EDFRESTART	/SAVE IT
	TAD	(1234)		/GET RANDOM VALUE
	DCA I	(EXSW)		/STORE IT
	TAD I	(EXSW)		/GET IT BACK
	TAD	(-1234)		/COMPARE TO DESIRED
	SZA CLA			/SKIP IF OK
	JMP	MDONE		/FORGET IT
	CDF	PRGFLD		/BACK TO OUR FIELD
	TAD	EXSW		/GET OUR ORIGINAL VALUE
	TAD	(-NOP)		/COMPARE TO DESIRED
	SZA CLA			/SKIP IF OK
	JMP	MDONE		/JUMP IF WIPED OUT
	TAD	MCDFNXT		/GET WORKING TEST VALUE
	DCA	.+1		/STORE IN-LINE
	.-.			/BACK TO TEST FIELD
	TAD	EDFRESTART	/GET SAVED VALUE
	DCA I	(EXSW)		/RESTORE IT FOR NEATNESS
	TAD	MCDFNXT		/GET CURRENT TEST VALUE
	TAD	[10]		/UPDATE TO NEXT FIELD
	DCA	MCDFNXT		/STORE BACK
	ISZ	CMPCNT		/DONE ALL FIELDS?
	JMP	MTRYNXT		/NO, KEEP GOING
MDONE,	CDF	PRGFLD		/RESET TO OUR FIELD
	TAD	CMPCNT		/GET THE COUNTER
	TAD	[10]		/CHANGE TO POSITIVE FORM
	DCA	MEMSIZE		/STORE FOR OTHERS
	TAD	MEMSIZE		/GET IT BACK
	CLL RTL			/*4 FOR "K"'S
	MQL			/PUT INTO LOW-ORDER
	DVI;	(12)		/DIVIDE BY TEN
	CLL RTL			/MOVE UP
	STL RTR			/FORCE SIGNIFICENCE
	DCA I	(KL4)		/STORE AS LAST DIGIT
	DVI;	(12)		/DIVIDE BY TEN
	DCA I	(KL3)		/STORE THIRD DIGIT
	DVI;	(12)		/DIVIDE BY TEN
	DCA I	(KL2)		/STORE SECOND DIGIT
	MQA			/GET FIRST DIGIT
	DCA I	(KL1)		/STORE IT
	TAD	(KL1)		/POINT AT
	DCA	EDFRESTART	/DIGIT LIST
	DCA	CMPCNT		/CLEAR SIGNIFICENCE FLAG
	TAD	[-4]		/SETUP THE
	DCA	CNT		/DIGIT COUNT
DFLOOP,	TAD	CMPCNT		/GET CURRENT SIGNIFICENCE
	SZA CLA			/SKIP IF NONE
	NL2000			/ELSE SET IT
	TAD I	EDFRESTART	/GET A DIGIT
	SZA			/SKIP IF NO SIGNIFICENCE YET
	ISZ	CMPCNT		/ELSE SET SOME
	SNA			/SKIP IF BLANK NOT ALLOWED
	TAD	(" -"0)		/ELSE MAKE IT A BLANK
	TAD	("0&77)		/ADD ON NUMERIC BITS
	AND	(77)		/REMOVE ANY JUNK
	DCA I	EDFRESTART	/STORE THE PRINTABLE DIGIT
	ISZ	EDFRESTART	/BUMP TO NEXT DIGIT
	ISZ	CNT		/DONE ALL DIGITS YET?
	JMP	DFLOOP		/NO, KEEP FILLING THEM IN
	JMP I	(MFORMORE)	/YES, CONTINUE THERE

	PAGE
MFORMOR,TAD	MEMSIZE		/GET THE SIZE BACK
	TAD	(MS2FLD%10^7777)/COMPARE TO MINIMUM USABLE
	SMA SZA			/SKIP IF BAD
	JMP	MEMOK		/JUMP IF OK
	CLA			/CLEAN UP
TADBAD,	TAD	BAD		/GET A CHARACTER
	SNA			/SKIP IF NOT AT END
	JMP	ENDBAD		/JUMP IF AT END
	JMS I	[P7CH]		/PRINT IT
	ISZ	TADBAD		/BUMP TO NEXT
	JMP	TADBAD		/KEEP GOING

ENDBAD,	TAD I	(KL1)		/GET A SIZE DIGIT
	JMS I	[P7CH]		/PRINT IT
	TAD I	(KL2)		/GET NEXT DIGIT
	JMS I	[P7CH]		/PRINT IT
	TAD I	(KL3)		/GET NEXT DIGIT
	JMS I	[P7CH]		/PRINT IT
	TAD I	(KL4)		/GET LAST DIGIT
	JMS I	[P7CH]		/PRINT IT
	TAD	("K&177)	/GET A "K"
	JMS I	[P7CH]		/PRINT IT
	JMS I	(CRLF)		/DO A <CR>, <LF>
	HLT			/BARF

MEMOK,	CDF	PR2FLD		/GOTO TABLE FIELD
	TAD	(-1)		/TRY ANOTHER FIELD
	SPA SNA			/SKIP IF THERE
	JMP	MEMOK2		/JUMP IF NOT
	ISZ I	(DMA6)		/ALLOW ANOTHER TEST FIELD
	NOP			/WILL SKIP!
	TAD	(-1)		/TRY ANOTHER FIELD
	SZA CLA			/SKIP IF NO MORE MEMORY
	DCA I	(DMA7)		/ELSE ALLOW FIELD SEVEN ALSO
MEMOK2,	CDF	PRGFLD		/BACK TO OUR FIELD
	TAD I	(KL1)		/GET FIRST DIGIT
	CLL RTL;RTL;RTL		/MOVE UP
	TAD I	(KL2)		/ADD ON SECOND DIGIT
	CDF	TBLFLD		/GOTO MESSAGE FIELD
	DCA I	(KMES+10)	/STORE IN MESSAGE
	CDF	PRGFLD		/BACK TO OUR FIELD
	TAD I	(KL3)		/GET THIRD DIGIT
	CLL RTL;RTL;RTL		/MOVE UP
	TAD I	(KL4)		/ADD ON FOURTH DIGIT
	CDF	TBLFLD		/GOTO MESSAGE FIELD
	DCA I	(KMES+11)	/STORE IN MESSAGE
	CDF	PRGFLD		/BACK TO OUR FIELD
	TAD	(-DEFCNT)	/SETUP THE
	DCA	SCOUNT		/DEFAULT OSCILLATION COUNT
	TAD	(-DEFSEP)	/SETUP THE
	DCA	SEPCNT		/DEFAULT DOWNSTEP SIZE
	DCA	SVSW		/DEFAULT TO NO POSITION VERIFICATION IN SEEK TESTING
	DCA	RSVSW		/SAME FOR RANDOM SEEK
/	NL0000			/DON'T REPEAT
	DCA	REPTSW		/QUICK CHECKOUT TESTS
	NL0001			/ANNOUNCE
	DCA	ANNSW		/TEST SECTIONS
	NL0001			/ADVANCE NORMALLY
	DCA	ADVSW		/THROUGH TESTS
	NL0001			/PRINT OUT
	DCA	PRNSW		/ERROR REPORTS
	DCA I	(START)		/ALLOW A RESTART

	ZBLOCK	20		/FOR FURTHER INITIALIZATION

	JMS I	[SETUP]		/SETUP RESTART ADDRESS
	JMS I	[MESAG2]	/GO PRINT OUR MESSAGE
	COPMSG			/OUR TRADEMARK
	JMS I	[TTYIN]		/WAIT FOR ANY RESPONSE
	JMS I	[MESSAGE]	/TELL THEM
	MSGOK			/OK
	JMP I	(RESTART)	/KEEP GOING
