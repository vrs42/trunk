BFCALCU,.-.			/BLOCK NUMBER, ETC. ROUTINE
FNSAGN,	CIF	PR2FLD		/GOTO CODE FIELD
	JMS I	(RAND6);FNSEED	/GET FUNCTION COUNT
	AND	(37)		/REMOVE UNWANTED BITS
	SNA			/SKIP IF POSSIBLE
	JMP	FNSAGN		/ELSE GO GET ANOTHER ONE
