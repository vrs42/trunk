	TAD I	XR2		/GET HIGH-ORDER
	CDF	PRGFLD		/BACK TO OUR FIELD
	JMS I	(P10SIX)	/PRINT THE VALUE
	JMP I	EXOUT		/RETURN

PBLANK,	.-.			/<SPACE> PRINTING ROUTINE
	DCA	CNT		/SAVE PASSED COUNT
	TAD	[" &177]	/GET A <SPACE>
	JMS I	[P7CH]		/PRINT IT
	ISZ	CNT		/DONE YET?
	JMP	.-3		/NO, KEEP GOING
	JMP I	PBLANK		/YES, RETURN
EXPRINT,.-.			/UNIT REPORT ROUTINE
	DCA	EXMOUNT		/SAVE PASSED UNIT INDICATOR
	NL7776			/GET INITIAL SPACE COUNT
	JMS	PBLANK		/PRINT SOME SPACES
	NL0002			/SETUP UNIT MASK
	AND	EXMOUNT		/GET THE BIT
	SNA CLA			/SKIP IF FLEXIBLE DISK DRIVE
	TAD	("W-"F)		/ELSE USE WINCHESTER DISK VALUE
	TAD	("F&177)	/GET AN "F" AT LEAST
	JMS I	[P7CH]		/PRINT IT
	NL0001			/SETUP MASK
	AND	EXMOUNT		/GET THE UNIT BIT
	JMS I	(ODPRT)		/PRINT IT
	TAD	EXMOUNT		/GET UNIT AGAIN
	CLL RAL			/*2
	TAD	EXMOUNT		/*3
	RAL			/*6
	TAD	(R0ERRLO-1)	/POINT TO COUNT TABLE
	DCA	XR2		/STASH THE POINTER
	TAD	(-6)		/GET SPACE COUNT
	JMS	EXOUT		/PRINT READ ERROR COUNT
	TAD	(-7)		/GET SPACE COUNT
	JMS	EXOUT		/PRINT WRITE ERROR COUNT
	TAD	(-11)		/GET SPACE COUNT
	JMS	EXOUT		/PRINT COMPARE ERROR COUNT
	JMS I	[CRLF]		/DO A <CR>, <LF>
	JMP I	EXPRINT		/RETURN

