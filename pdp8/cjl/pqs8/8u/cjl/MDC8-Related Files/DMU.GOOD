	TAD	MESAG2		/GET OUR CALLER
	DCA	MESSAGE		/MAKE IT THEIRS
	TAD	(14)		/GET A <FF>
	XLIST	OFF
	IFNZRO	NOFORM	<
	XLIST	ON
	CLA			/THROW IT AWAY
	XLIST	OFF	>
	IFZERO	NOFORM	<
	XLIST	ON
