/	PREVIOUS TWO PAGES ARE USED FOR DMA TESTING, ETC.
/	BEEPER ROUTINE.

BONG,	.-.			/BEEPER ROUTINE
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	BNGXIT		/STORE IN-LINE
	CDF	PRGFLD		/GOTO OUR FIELD
	NL0006			/SET <BEL>-1
	IAC			/NOW HAVE <BEL>
	JMS I	[P7CH]		/RING IT
BNGXIT,	.-.			/WILL BE CIF CDF RETURN FIELD
	JMP I	BONG		/RETURN

CHKUP,	.-.			/<^C>, ETC. INPUT ROUTINE
	JMS	SETFLD		/SETUP RETURN ADDRESS
	DCA	CHKXIT		/STORE IN-LINE
	CDF	PRGFLD		/GOTO OUR FIELD
	JMS	CTLCTST		/TEST FOR <^C>, ETC.
	SNA			/SKIP IF ANYTHING THERE
	JMP	CHKXIT		/RETURN IF NOT
	TAD	(-"N!300)	/IS IT <^N>?
	SNA			/SKIP IF NOT
	JMP	DOUN		/JUMP IF SO
	TAD	(-"R+"N)	/IS IT <^R>?
	SNA			/SKIP IF NOT
	JMP	DOUR		/JUMP IF SO
	IAC	/TAD	(-"Q+"R)/IS IT <^Q>?
	SNA			/SKIP IF NOT
	JMP	CHKCLR		/JUMP IF SO
	IAC	/TAD	(-"P+"Q)/IS IT <^P>?
	SNA			/SKIP IF NOT
	JMP	DOUP		/JUMP IF SO
	TAD	(-"S+"P)	/IS IT <^S>?
	SZA CLA			/SKIP IF SO
	JMP	CHKXIT		/RETURN IF NOT
	JMS	CTLCTST		/WAIT FOR ANOTHER CHARACTER
	TAD	(-"Q!300)	/IS IT <^Q>?
	SZA CLA			/SKIP IF SO
	JMP	.-3		/JUMP IF NOT
CHKCLR,	DCA	INCHAR		/OBLITERATE <^Q>
CHKXIT,	.-.			/WILL BE CIF CDF RETURN FIELD
	JMP I	CHKUP		/RETURN

DOUN,	ISZ	UNSW		/INDICATE <^N> HIT
	JMP	CHKCLR		/IGNORE IT FOR NOW

DOUR,	ISZ	URSW		/INDICATE <^R> HIT
	JMP	CHKCLR		/IGNORE IT FOR NOW

DOUP,	TAD	("P&177)	/GET A "P"
	CIF	PR2FLD		/GOTO CODE FIELD
	JMS I	(CARPRT)	/PRINT "^P"
	JMP I	UPREST		/RESTART
CTLCTST,.-.			/TEST FOR <^C>, ETC.
	CLA			/CLEAN UP
	DCA	INCHAR		/OBLITERATE OLD CHARACTERS
	KSFIOT			/**** ZAPPED **** 0000
OTHZAP,	JMP I	CTLCTST		/NO, JUST RETURN
	KRSIOT			/YES, READ IT IN
OTHENT,	AND	(177)		/JUST SEVEN-BIT
	DCA	INCHAR		/SAVE IT
	NL7775			/-3
	TAD	INCHAR		/COMPARE TO <^C>
	SPA SNA CLA		/SKIP IF GREATER THAN <^C>
	JMP I	[SBOOT]		/BACK TO THE MONITOR
	KCCIOT			/CLEAR THE FLAG NOW
	TAD	INCHAR		/GET THE CHARACTER
	JMP I	CTLCTST		/RETURN

OTHER,	LKSFIOT			/FLAG UP?
	JMP I	CTLCTST		/NO, FORGET IT
	LKRBIOT			/YES, GET THE CHARACTER
	JMP	OTHENT		/CONTINUE THERE

	OTHJMP=	JMP	OTHER	/ENABLING INSTRUCTION

P7CH,	.-.			/SEVEN-BIT ASCII PRINT ROUTINE
P7STORE,DCA	P7TEMP		/SAVE FOR NOW
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	P7XIT		/STORE IN-LINE
	CDF	PRGFLD		/SETUP OUR FIELD
	TAD	P7TEMP		/RESTORE PASSED CHARACTER
P7LZAP,	DCA	P7TEMP		/SAVE PASSED CHARACTER
P7LOOP,	TAD	P7TEMP		/GET IT BACK
	TSFIOT			/FLAG UP?
	JMP	P7TEST		/NO, TRY THE KEYBOARD
	TLSIOT			/PRINT IT
P7ZAP,	NOP			/FOR ZAPPING PURPOSES
	JMS I	[CHKUP]		/CHECK INPUT FLAG AND CLEAN UP
P7XIT,	.-.			/WILL BE CIF CDF RETURN FIELD
	JMP I	P7CH		/RETURN

P7TEST,	JMS I	[CHKUP]		/CHECK FOR <^S>, ETC.
	JMP	P7LOOP		/CHECK OUTPUT FLAG AGAIN

P7PRT,	JMS I	(P7LPT)		/OUTPUT TO LPT: INSTEAD
	JMP	P7XIT		/RETURN

	P7JMP=	JMP	P7PRT	/ENABLING INSTRUCTION

P7TEMP,	.-.			/OUTPUT TEMPORARY
TTYINC,	.-.			/TTY: INPUT ROUTINE WITH <^U> CHECK
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	TYNCXT		/STORE IN-LINE
	CDF	PRGFLD		/GOTO OUR FIELD
	JMS I	[TTYIN]		/GET A CHARACTER
	TAD	(-"U!300)	/IS IT <^U>?
	SNA CLA			/SKIP IF NOT
	JMP	ISUPU		/JUMP IF SO
	TAD	INCHAR		/GET IT BACK
TYNCXT,	.-.			/WILL BE CIF CDF RETURN FIELD
	JMP I	TTYINC		/RETURN

ISUPU,	TAD	("U&177)	/GET A "U"
	CIF	PR2FLD		/GOTO CODE FIELD
	JMS I	(CARPRT)	/PRINT "^U"
	JMS I	[CRLF]		/DO A <CR>, <LF>
	TAD	UPURET		/GET CANCEL ADDRESS
	DCA	TTYINC		/STASH IT
	JMP	TYNCXT		/EXIT TO <^U> ADDRESS

TTYIN,	.-.			/CHARACTER INPUT ROUTINE
	DCA	INCHAR		/OBLITERATE PREVIOUS CHARACTER
	JMS I	[CHKUP]		/CHECK FOR <^C>, ETC.
	TAD	INCHAR		/GET THE LATEST CHARACTER
	SNA			/SKIP IF ANYTHING THERE
	JMP	.-3		/ELSE WAIT FOR SOMETHING TO APPEAR
	TAD	(-140)		/SUBTRACT LOWER-CASE LIMIT
	SPA			/SKIP IF LOWER-CASE
	TAD	[40]		/RESTORE IF UPPER-CASE
	TAD	(100)		/RESTORE THE CHARACTER
	DCA	INCHAR		/SAVE IT
	TAD	INCHAR		/GET IT BACK
	JMP I	TTYIN		/RETURN WITH LATEST CHARACTER (FOLDED)

