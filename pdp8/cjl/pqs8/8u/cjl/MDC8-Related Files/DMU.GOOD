/MDC8 DISK MAINTENANCE UTILITY
	XLIST	OFF
	IFNDEF	OFF	<OFF=	1>
	IFNDEF	ON	<ON=	0>
	XLIST	ON

/	LAST EDIT:	30-JAN-1985	10:00:00	CJL

/	STAND-ALONE DISK MAINTENANCE UTILITY FOR MDC8/WINCHESTER AND FLEXIBLE DISKS.

/	REQUIRES PDP-8/I PROCESSOR (OR BETTER) WITH MQ.

/	(C)	1985	CHARLES LASNER ASSOCIATES.

/	ASSEMBLY INSTRUCTIONS:

/	CHANGE "DEVCODE" TO PROPER DEVICE CODE AS NECESSARY (DEFAULT IS 31).

/	MUST BE ASSEMBLED WITH '/J' (OS/8 PAL8 '/F') SWITCH SET.
/	ASSEMBLY DEFINITIONS, ETC.

/	ASSEMBLY LISTING PARAMETER.

/	IFNDEF	LSTMES	<LSTMES=0>	/DON'T LIST TEXT MESSAGES
	IFNDEF	LSTMES	<LSTMES=1>	/LIST TEXT MESSAGES

/	PRINTING PARAMETER.

/	IFNDEF	PDEBUG	<PDEBUG=0>	/DON'T ALLOW PRINTER DEBUGGING
	IFNDEF	PDEBUG	<PDEBUG=1>	/ALLOW PRINTER DEBUGGING OUTPUT FROM LAS

/	FORM-FEED PARAMETER.

/	IFNDEF	NOFORM	<NOFROM=1>	/DON'T ALLOW <FF> ON SCREEN MENU MESSAGES
	IFNDEF	NOFORM	<NOFORM=0>	/ALLOW <FF> ON SCREEN MENU MESSAGES

/	MDC8 IOT DEFINITIONS.

	IFNDEF	DEVCODE	<DEVCODE=31>	/USES 631X BY DEFAULT

	DSEI=	DEVCODE^10+6000		/INTERRUPT ENABLE/DISABLE PER AC[11]
	DSSF=	DEVCODE^10+6001		/SKIP ON DONE FLAG
	DSCF=	DEVCODE^10+6002		/CLEAR DONE FLAG
	DSHI=	DEVCODE^10+6003		/LOAD HIGH-ORDER COMMAND ADDRESS
	DSGO=	DEVCODE^10+6004		/LOAD LOW-ORDER COMMAND AND GO
	DSRS=	DEVCODE^10+6005		/READ STATUS
	DSCB=	DEVCODE^10+6006		/CHECK BUSY
	DSIP=	DEVCODE^10+6007		/(DIAGNOSTIC) INITIAL PROGRAM LOAD (BOOTSTRAP)

/	CONSOLE IOT DEFINITIONS.

/	IFNDEF	CICODE	<CICODE=40>	/USES 640X BY DEFAULT
/	IFNDEF	COCODE	<COCODE=41>	/USES 641X BY DEFAULT
	IFNDEF	CICODE	<CICODE=03>	/USES 603X BY DEFAULT
	IFNDEF	COCODE	<COCODE=04>	/USES 604X BY DEFAULT

	KCCIOT=	CICODE^10+6002		/CLEAR KEYBOARD FLAG, AC
	KRSIOT=	CICODE^10+6004		/READ KEYBOARD BUFFER, DON'T CLEAR FLAG
	KSFIOT=	CICODE^10+6001		/SKIP ON KEYBOARD FLAG
	TLSIOT=	COCODE^10+6006		/LOAD OUTPUT, CLEAR FLAG
	TSFIOT=	COCODE^10+6001		/SKIP ON OUTPUT FLAG
/	LINE PRINTER IOT DEFINITIONS.

/	IFNDEF	LICODE	<LICODE=65>	/USES 665X BY DEFAULT
/	IFNDEF	LOCODE	<LOCODE=66>	/USES 666X BY DEFAULT
/	IFNDEF	LICODE	<LICODE=40>	/USES 640X BY DEFAULT
/	IFNDEF	LOCODE	<LOCODE=41>	/USES 641X BY DEFAULT
	IFNDEF	LICODE	<LICODE=43>	/USES 643X BY DEFAULT
	IFNDEF	LOCODE	<LOCODE=47>	/USES 647X BY DEFAULT

	LKCCIOT=LICODE^10+6002		/CLEAR INPUT FLAG, AC
	LKRBIOT=LICODE^10+6006		/LOAD KEYBOARD BUFFER, CLEAR FLAG
	LKSFIOT=LICODE^10+6001		/SKIP ON INPUT FLAG
	LLSIOT=	LOCODE^10+6006		/LOAD OUTPUT, CLEAR FLAG
	LSFIOT=	LOCODE^10+6001		/SKIP ON OUTPUT FLAG

/	EXTENDED ARITHMETIC DEFINITIONS.

	XLIST	OFF
	IFNDEF	DAD	<DAD=	0>
	IFNDEF	DCM	<DCM=	0>
	IFNDEF	DLD	<DLD=	0>
	IFNDEF	DST	<DST=	0>
	IFNDEF	DVI	<DVI=	0>
	XLIST	ON
	CAM=	CLA MQL			/CLEAR AC, MQ
	DAD=	JMS I	[DADD]		/DOUBLE-PRECISION ADD
	DCM=	JMS I	[DCOM]		/DOUBLE-PRECISION COMPLEMENT
	DLD=	JMS I	[DLOAD]		/DOUBLE-PRECISION LOAD
	DST=	JMS I	[DSTORE]	/DOUBLE-PRECISION STORE
	DVI=	JMS I	[DIVIDE]	/DIVIDE

/	DEVICE SIZE AND AREA DEFINITIONS.

	BLKSIZE=0400			/SIZE OF ONE RECORD IN WORDS
	BTBHI=	0007			/FIRST BAD TRACK TABLE SECTOR - HIGH-ORDER
	BTBLO=	4650			/FIRST BAD TRACK TABLE SECTOR - LOW-ORDER
	BTCNT=	0104			/68 SECTORS (4 TRACKS) IN BAD TRACK AREA
	FLMAXHI=0000			/FLEXIBLE DISK LOGICAL ADDRESS COUNT - HIGH-ORDER
	FLMAXLO=4406			/FLEXIBLE DISK LOGICAL ADDRESS COUNT - LOW-ORDER
	FLXTRKS=0115			/FLEXIBLE DISK TRACK COUNT
	FL1MXHI=0000			/SINGLE-SIDED FLEXIBLE DISK COUNT - HIGH-ORDER
	FL1MXLO=2203			/SINGLE-SIDED FLEXIBLE DISK COUNT - LOW-ORDER
	LMAXHI=	0007			/LARGEST LOGICAL ADDRESS COUNT - HIGH-ORDER
	LMAXLO=	2003			/LARGEST LOGICAL ADDRESS COUNT - LOW-ORDER
	MBLKSIZ=-BLKSIZE		/-(SIZE OF ONE RECORD IN WORDS)
	PMAXHI=	0007			/LARGEST PHYSICAL ADDRESS COUNT - HIGH-ORDER
	PMAXLO=	4754			/LARGEST PHYSICAL ADDRESS COUNT - LOW-ORDER
	WLSCTHI=0000			/WINCHESTER LOGICAL TRACK COUNT - HIGH-ORDER
	WLSCTLO=3323			/WINCHESTER LOGICAL TRACK COUNT - LOW-ORDER
	WPSCTHI=0000			/WINCHESTER PHYSICAL TRACK COUNT - HIGH-ORDER
	WPSCTLO=3454			/WINCHESTER PHYSICAL TRACK COUNT - LOW-ORDER

/	MEMORY DEFINITIONS.

	DATFLD=	0030			/DATA FIELD
	MSGFLD=	0040			/MESSAGE FIELD
	MS2FLD=	0050			/SECOND MESSAGE FIELD
	PRGFLD=	0000			/PROGRAM FIELD
	PR2FLD=	0010			/SECOND PROGRAM FIELD
	TBLFLD=	0020			/BAD TRACK TABLE FIELD
/	SASI CONTROLLER FUNCTION DEFINITIONS.

	DFDFFN=	0300			/DEFINE FLEXIBLE DISK FORMAT FUNCTION
	FTRKFN=	0006			/FORMAT TRACK FUNCTION
	READFN=	0010			/READ DATA FUNCTION
	SEEKFN=	0013			/SEEK FUNCTION
	TRFN=	0000			/TEST READY FUNCTION
	WRITFN=	0012			/WRITE DATA FUNCTION

/	SEEK PARAMETER DEFINITIONS.

	DEFCNT=	1			/DEFAULT STROKE COUNT
	DEFSEP=	4			/DEFAULT SEPARATION
	HEADS=	6			/NUMBER OF HEADS IN WINCHESTER DRIVE
	LNGCNT=	4			/LONG STROKE COUNT
	LNGSEP=	1			/LONG SEPARATION

/	OTHER DEFINITIONS.

	XLIST	OFF
	IFNDEF	MOVE	<MOVE=	0>
	XLIST	ON
	MOVE=	JMS I	[XMOVE]		/BLOCK MOVE
	NL0000=	CLA			/LOAD AC WITH 0000
	NL0001=	CLA IAC			/LOAD AC WITH 0001
	NL0002=	CLA CLL CML RTL		/LOAD AC WITH 0002
	NL0003=	CLA CLL CML IAC RAL	/LOAD AC WITH 0003
	NL0004=	CLA CLL IAC RTL		/LOAD AC WITH 0004
	NL0006=	CLA CLL CML IAC RTL	/LOAD AC WITH 0006
	NL2000=	CLA CLL CML RTR		/LOAD AC WITH 2000
	NL3777=	CLA CLL CMA RAR		/LOAD AC WITH 3777
	NL4000=	CLA CLL CML RAR		/LOAD AC WITH 4000
	NL5777=	CLA CLL CMA RTR		/LOAD AC WITH 5777
	NL6000=	CLA CLL CML IAC RTR	/LOAD AC WITH 6000
	NL7775=	CLA CLL CMA RTL		/LOAD AC WITH 7775
	NL7776=	CLA CLL CMA RAL		/LOAD AC WITH 7776
	NL7777=	CLA CMA			/LOAD AC WITH 7777
	REVISIO="E			/REVISION LETTER
	SBOOT=	7600			/SYSTEM BOOTSTRAP ADDRESS
	VERSION=02			/VERSION NUMBER
	WRITE=	4000			/I/O HANDLER WRITE BIT
/	FIELD	PRGFLD%10	/WHERE WE START LOADING

	*0			/START AT THE BEGINNING

	IFNZRO	.	<ERROR>
EXSW,	.-.			/EXERCISER SWITCH

AESW,	.-.			/ALTERNATE ERROR SWITCH
CMPCNT,	.-.			/COMPARE COUNTER
EDFREST,.-.			/RESTART ADDRESS AFTER FLAW MAP ERROR

	ZBLOCK	7-.		/EMPTY SPACE

DMAPATT,.-.			/DMA PATTERN

	*10			/GET TO AUTO-INDEX AREA

XR1,	.-.			/AUTO-INDEX NUMBER ONE
XR2,	.-.			/AUTO-INDEX NUMBER TWO
ERRTEMP,.-.			/TEMPORARY FOR STATUS ERRORS
ERSW,	.-.			/PRIMARY ERROR SWITCH
FAMODE,	.-.			/4000=FACTORY, 0=USER MODE
FINTLV,	.-.			/FLEXIBLE DISK INTERLEAVE FACTOR
RCSW,	.-.			/READ CHECK SWITCH
WINTLV,	.-.			/WINCHESTER DISK INTERLEAVE FACTOR

	*20			/GET PAST AUTO-INDEX AREA

SETFLD,	.-.			/CALLING FIELD SETUP ROUTINE
	NL0002			/SET CIF BIT
	RDF			/GET CALLING FIELD
	TAD	[CDF]		/FORM CIF CDF RETURN INSTRUCTION
	JMP I	SETFLD		/RETURN

DATSET,	.-.			/DATA FIELD SETUP ROUTINE
EXCCDF,	.-.			/WILL BE CDF DATA FIELD
	JMP I	DATSETUP	/RETURN
ADVSW,	.-.			/ADVANCEMENT SWITCH
ALMODE,	.-.			/ALTERNATE MODE SWITCH
ANNSW,	.-.			/ANNOUNCEMENT SWITCH
COMCNT,	.-.			/TEMPORARY
CNT,	.-.			/COUNTER
DMAUNIT,.-.			/DMA UNIT
EXWORD,	.-.			/EXERCISE DRIVE WORD
FBLK,	ZBLOCK	2		/FORMAT, ETC. BLOCK
FLPFRM,	.-.			/FLEXIBLE DISK FORMAT DEFINITION
FLWUNIT,.-.			/CURRENT FLAW MAP UNIT
FRSTPTR,.-.			/FIRST TIME SWITCH POINTER
GNSW,	.-.			/GETNMB <CR> SWITCH
INCHAR,	.-.			/INPUT BUFFER
INUNIT,		.-.		/INPUT UNIT
MEMSIZE,.-.			/ACTUAL MEMORY SIZE: 1=4K ... 10=32K
NEXT,	.-.			/NEXT ROUTINE ADDRESS
OLCHAR,	.-.			/PREVIOUS CHARACTER
OTUNIT,	.-.			/OUTPUT UNIT
PATTERN,.-.			/DATA PATTERN
PRNSW,	.-.			/ERROR PRINT SWITCH
QDADDR,	ZBLOCK	2		/QUICK DMA ADDRESS
QTSTCT,	.-.			/QUICK TEST DRIVE COUNTER
REPTSW,	.-.			/QUICK CHECKOUT REPEAT CYCLE SWITCH
RSVSW,	.-.			/RANDOM SEEK-VERIFY POSITION SWITCH
SCOUNT,	.-.			/SEEK OSCILLATION COUNT (STROKE COUNT)
SECTCNT,.-.			/SECTOR COUNTER
SEPCNT,	.-.			/SEEK DOWNSTEP SIZE (SEPARATION)
SMASK,	.-.			/SEARCH MASK
STRKCTR,.-.			/STROKE COUNTER
SVSW,	.-.			/SEEK-VERIFY POSITION SWITCH
TBCNT,	.-.			/TRACK BUMP COUNTER
TEMP,	.-.			/TEMPORARY
TRACK,	ZBLOCK	2		/LOGICAL TRACK
TRANS,	ZBLOCK	2		/TRANSACTION NUMBER
TRKCNT,	.-.			/TRACK COUNTER - LOW-ORDER
TRKCNHI,.-.			/TRACK COUNTER - HIGH-ORDER
TSTBUFF,.-.			/TEST ADDRESS
TSTFLD,	.-.			/TEST BANK AND FIELD
TVSW,	.-.			/BAD TRACK TABLE VALIDITY SWITCH
UNIT,	.-.			/LOGICAL UNIT
UNSW,	.-.			/<^N> SWITCH
UPREST,	.-.			/RESTART ADDRESS FROM <^P>
UPURET,	.-.			/<^U> RESTART ADDRESS
URSW,	.-.			/<^R> SWITCH
VOSW,	.-.			/VERIFY-ONLY SWITCH
WBUNIT,	.-.			/WINCHESTER BUFFER UNIT
	PAGE

/	BEGINS HERE.

START,	JMP I	(INITIALIZE)	/**** WILL BE 0000 ****
	JMP	RESTRT		/FOR RESTART

/	DOUBLE-PRECISION SIMULATOR ROUTINES.

/	DOUBLE-PRECISION ADD.

DADD,	.-.			/ADD ROUTINE
	DCA	DCOM		/SAVE HIGH-ORDER
	RDF			/GET CURRENT DATA FIELD
	TAD	[CDF]		/TURN INTO CDF INSTRUCTION
	DCA	EXCCDF		/STORE IN-LINE
	CDF	PRGFLD		/BACK TO OUR FIELD
	TAD I	DADD		/GET ARGUMENT
	DCA	DLOAD		/STASH IT
	JMS	DATSETUP	/RESTORE PREVAILING FIELD
	MQA			/GET LOW-ORDER
	CLL			/INITIALIZE CARRY
	TAD I	DLOAD		/ADD ON LOW-ORDER ARGUMENT
	MQL			/PUT INTO MQ
	ISZ	DADD		/BUMP PAST ARGUMENT
	ISZ	DLOAD		/BUMP TO HIGH-ORDER
	RAL			/GET CARRY
	TAD	DCOM		/RESTORE AC
	TAD I	DLOAD		/ADD ON HIGH-ORDER ARGUMENT
	JMP I	DADD		/RETURN

/	DOUBLE-PRECISION STORE.

DSTORE,	.-.			/STORE ROUTINE
	DCA	DCOM		/SAVE AC
	RDF			/GET CURRENT DATA FIELD
	TAD	[CDF]		/TURN INTO CDF INSTRUCTION
	DCA	EXCCDF		/STORE IN-LINE
	CDF	PRGFLD		/BACK TO OUR FIELD
	TAD I	DSTORE		/GET ARGUMENT
	DCA	DLOAD		/STASH IT
	JMS	DATSETUP	/RESTORE PREVAILING FIELD
	MQA			/GET LOW-ORDER
	DCA I	DLOAD		/STORE IT
	ISZ	DSTORE		/BUMP PAST ARGUMENT
	ISZ	DLOAD		/BUMP TO HIGH-ORDER
	TAD	DCOM		/RESTORE AC
	DCA I	DLOAD		/STORE IT
	TAD	DCOM		/RESTORE AC AGAIN
	JMP I	DSTORE		/RETURN
/	DOUBLE-PRECISION LOAD.

DLOAD,	.-.			/LOAD ROUTINE
	CAM			/CLEAN UP
	TAD	DLOAD		/GET OUR CALLER
	DCA	DADD		/MAKE IT THEIRS
	JMP	DADD+1		/CONTINUE THERE

/	DIVIDE.

DIVIDE,	.-.			/DIVIDE ROUTINE
	DCA	DIVAC		/SAVE PASSED AC
	RDF			/GET PREVAILING FIELD
	TAD	[CDF]		/TURN INTO CDF INSTRUCTION
	DCA	EXCCDF		/SET IT UP
	CDF	PRGFLD		/GOTO OUR FIELD
	TAD I	DIVIDE		/GET ARGUMENT POINTER
	DCA	MDIVSOR		/STASH IT
	ISZ	DIVIDE		/BUMP PAST ARGUMENT
	JMS	DATSETUP	/RESTORE PREVAILING FIELD
	TAD I	MDIVSOR		/GET DIVISOR
	CIA			/WANT NEGATIVE FORM
	DCA	MDIVSOR		/STORE IT
	MQA			/GET LOW-ORDER
	DCA	DIVMQ		/STORE IT
	TAD	(-14)		/SETUP THE
	DCA	DSHIFT		/SHIFT COUNTER
DIVLUP,	TAD	DIVMQ		/GET LOW-ORDER
	CLL RAL			/MOVE UP
	DCA	DIVMQ		/STORE BACK
	TAD	DIVAC		/GET HIGH-ORDER
	RAL			/MOVE UP
	DCA	DIVAC		/STORE BACK
	TAD	DIVAC		/GET IT BACK
	TAD	MDIVSOR		/COMPARE TO DIVISOR
	SZL			/CARRY?
	DCA	DIVAC		/YES, STORE BACK
	SZL CLA			/CARRY?
	ISZ	DIVMQ		/YES, BUMP QUOTIENT
	ISZ	DSHIFT		/DONE ALL YET?
	JMP	DIVLUP		/NO, GO BACK
	TAD	DIVMQ		/GET LOW-ORDER
	MQL			/RESTORE IT
	TAD	DIVAC		/GET REMAINDER
	JMP I	DIVIDE		/RETURN
/	DOUBLE-PRECISION COMPLEMENT.

DCOM,	.-.			/COMPLEMENT ROUTINE
	SWP			/GET LOW-ORDER FIRST
	CLL CIA			/INVERT IT
	SWP			/PUT IT BACK
	CMA			/INVERT HIGH-ORDER
	SZL			/CARRY?
	IAC			/YES, SO INCREMENT
	JMP I	DCOM		/RETURN

/	STORAGE DEFINITIONS FOR DIVIDE ROUTINE.

	DIVAC=	DADD		/DIVIDE AC
	DIVMQ=	DLOAD		/DIVIDE MQ
	MDIVSOR=DCOM		/DIVISOR
	DSHIFT=	DSTORE		/SHIFT COUNTER

/	RESTARTS HERE.

RESTRT,	TLSIOT			/SET TTY: FLAG
	LLSIOT			/SET LPT: FLAG
RESTART,JMS I	[SETUP]		/SETUP RESTART ADDRESS
	JMS I	[MESAG2]	/ANNOUNCE OURSELVES
	SCRN01			/WITH FIRST BLURB
	CAM			/CLEAN UP
	DST;	FBLK		/CLEAR BLOCK FOR ERROR REPORTS
	CIF	PR2FLD		/GOTO CODE FIELD
	JMS I	[GETCOMMAND]	/GET OUR COMMAND
	FRST-1			/FIRST LETTER LIST-1
	FRST-SCND		/LENGTH OF LIST
	FINLST-1		/TEXT/DISPATCH LIST-1

/	COMES HERE IF HARDWARE TIMED OUT.

IOBARF,	JMS I	[MESSAGE]	/TELL THEM
	TOMSG			/WE TIMED OUT
	JMP	RESTART		/RESTART
/	DRIVE ENABLE COMMAND COMES HERE.

DRVENAB,JMS I	[SETUP]		/SETUP RESTART ADDRESS
	JMS I	[MESAG2]	/ANNOUNCE OURSELVES
	SCRN02			/WITH OUR BLURB
	CIF	PR2FLD		/GOTO CODE FIELD
	JMS I	[MULTENABLE]	/CALL MULTI-UNIT ENABLE ROUTINE
	EDMSG			/PASS MESSAGE ADDRESS FOR ENABLING
	DCA	GNSW		/SAVE ENABLE WORD
DENAGN,	JMS I	[WAITOK]	/TELL THEM
	DENMSG			/TO ENABLE THE DRIVES
	TAD	GNSW		/GET ENABLE VALUE
	CIF	PR2FLD		/GOTO CODE FIELD
	JMS I	(ENADRV)	/ENABLE CURRENT DRIVE CONFIGURATION
	SNA CLA			/SKIP IF THERE WERE PROBLEMS
	JMP	DENOK		/JUMP IF NO PROBLEMS
	JMS I	[ERRMSG]	/TELL THEM
	DERMSG			/OF PROBLEM
	JMS I	[ASKRETRY]	/ASK FOR RETRY
	JMP	DENAGN		/JUMP IF YES
	JMP I	(FAIL)		/WAIT FOR THEM AND RESTART

DENOK,	JMS I	[MESSAGE]	/TELL THEM
	EOKMSG			/ENABLE SUCCEEDED
	JMP I	[AGAIN]		/WAIT FOR THEM AND RESTART

	PAGE
/	DEFINE FLEXIBLE DISK FORMAT COMMAND COMES HERE.

DEFLOP,	JMS I	[SETUP]			/SETUP RESTART ADDRESS
	JMS I	[MESAG2]		/ANNOUNCE OURSELVES
	SCRN03				/WITH OUR BLURB
	CIF	PR2FLD			/GOTO CODE FIELD
	JMS I	[GETCOMMAND]		/GET OUR COMMAND
	DFRST-1				/FIRST LETTER LIST-1
	DFRST-DSCND			/LENGTH OF LIST
	DFINLST-1			/TEXT/DISPATCH LIST-1

/	EXTENDED DENSITY DEFINITION COMES HERE.

EXDENSI,NL0004	/TAD	(212-206)	/GET OFFSET FOR EXTENDED DENSITY

/	DOUBLE DENSITY DEFINITION COMES HERE.

DDENSIT,TAD	(206-6)			/GET OFFSET FOR DOUBLE DENSITY

/	SPECIAL DOUBLE DENSITY DEFINITION COMES HERE.

SPDENSI,TAD	(6-0)			/GET SPECIAL DENSITY VALUE

/	SINGLE DENSITY DEFINITION COMES HERE.

SDENSIT,DCA	ERRTEMP			/SAVE BASIC VALUE
	JMS I	[MESSAGE]		/ASK THEM
	DSIDMSG				/IF DOUBLE SIDED
	JMS I	[YORNO]			/GET RESPONSE
	NL0001				/YES, SET INCREMENT FOR SECOND SIDE
	TAD	ERRTEMP			/GET BASIC VALUE EITHER WAY
	DCA	FLPFRM			/STORE FINAL FORMAT DEFINITION
	JMP I	[AGAIN]			/WAIT FOR THEM AND RESTART

/	QUICK CHECKOUT COMMAND COMES HERE.

QUICK,	JMS I	[SETUP]			/SETUP RESTART ADDRESS
	JMS I	[MESAG2]		/ANNOUNCE OURSELVES
	QUMENU				/WITH OUR BLURB
QIKAGN,	CIF	PR2FLD			/GOTO CODE FIELD
	JMS I	[GETCOMMAND]		/GET OUR COMMAND
	QUFRST-1			/FIRST LETTER LIST-1
	QUFRST-QUSCND			/LENGTH OF LIST
	QUFINLST-1			/TEXT/DISPATCH LIST-1
/	COMES HERE IF NO DRIVES SELECTED FOR QUICK CHECKOUT TESTS.

CHKNO,	JMS I	[MESSAGE]	/TELL THEM
	EXNMSG			/THEY GOOFED!

/	QUICK CHECKOUT COMMAND COMES HERE

QUIK,	CIF	PR2FLD		/GOTO CODE FIELD
	JMS I	[MULTENABLE]	/GET MULTIPLE DRIVES ENABLED FOR TEST
	TDMSG			/TEST MESSAGE
	SNA			/ANY SELECTED
	JMP	CHKNO		/NO, BARF
	DCA	EXWORD		/YES, STORE COMPOSITE
	NL0001			/SETUP UNIT ZERO MASK
	AND	EXWORD		/GET THE BIT
	SZA CLA			/SKIP IF NOT ENABLED
	JMS I	(QTMOUNT)	/ELSE HAVE UNIT ZERO MOUNTED
	NL0002			/SETUP UNIT ONE MASK
	AND	EXWORD		/GET THE BIT
	SNA CLA			/SKIP IF ENABLED
	JMP	QTRED2		/JUMP IF NOT
	NL0001			/SET UNIT ONE VALUE
	JMS I	(QTMOUNT)	/HAVE UNIT ONE MOUNTED
QTRED2,	NL0004			/SETUP UNIT TWO MASK
	AND	EXWORD		/GET THE BIT
	SNA CLA			/SKIP IF ENABLED
	JMP	QTRED3		/JUMP IF NOT
	NL0002			/SET UNIT TWO VALUE
	JMS I	(QTMOUNT)	/HAVE UNIT TWO MOUNTED
QTRED3,	TAD	EXWORD		/GET ENABLE WORD
	AND	[10]		/GET UNIT THREE BIT
	SNA CLA			/SKIP IF ENABLED
	JMP	QTREDY		/JUMP IF NOT
	NL0003			/SET UNIT THREE VALUE
	JMS I	(QTMOUNT)	/HAVE UNIT THREE MOUNTED
QTREDY,	JMS I	[MESSAGE]	/TELL THEM
	QIPMSG			/WE HAVE BEGUN
	DCA	UNSW		/CLEAR <^N> SWITCH
/	QUICK TEST 1:	FORMAT DRIVES.

QFTEST,	JMS I	(SETN)		/SETUP <^N> FOR
	QFTEND			/NEXT TEST
QFTLUP,	JMS I	(CHKN)		/CHECK FOR <^N>, ETC.
	JMS I	(QBTEST)	/CHECK IF LATEST DRIVE IS ENABLED FOR TESTING
	SNA CLA			/SKIP IF SO
	JMP	QFTEND		/JUMP IF NOT
	JMS I	(ANNMSG)	/TELL THEM
	QFMSG			/WE ARE FORMATTING
	JMS I	(QFSUB)		/GO FORMAT THE DRIVE
	DCA	UNSW		/CLEAR <^N> SWITCH
	JMS I	(ANNMSG)	/TELL THEM
	QFDMSG			/WE FINISHED FORMATTING THE DRIVE
	DCA I	FRSTPTR		/CLEAR FIRST TIME SWITCH FOR THIS DRIVE
	JMS I	(CHKN)		/CHECK FOR <^N>, ETC.
	JMS I	(SCYCLE)	/CHECK FOR TEST RECYCLE
	JMP	QFTLUP		/GO DO IT AGAIN
QFTEND,	ISZ	FRSTPTR		/BUMP TO NEXT DRIVE
	ISZ	QTSTCT		/DONE ALL YET?
	JMP	QFTLUP		/NO, KEEP GOING

/	QUICK TEST 2:	READ CHECK DRIVES.

QRTEST,	JMS I	(SETN)		/SETUP <^N> FOR
	QRTEND			/NEXT TEST
QRTLUP,	JMS I	(CHKN)		/CHECK FOR <^N>, ETC.
	JMS I	(QBTEST)	/CHECK IF LATEST DRIVE IS ENABLED FOR TESTING
	SNA CLA			/SKIP IF SO
	JMP	QRTEND		/JUMP IF NOT
	JMS I	(ANNMSG)	/TELL THEM
	QRMSG			/WE ARE READ CHECKING
	JMS I	(QRSUB)		/GO READ THE DRIVE
	JMS I	(ANNMSG)	/TELL THEM
	QRDMSG			/WE FINISHED
	DCA I	FRSTPTR		/CLEAR FIRST TIME SWITCH
	JMS I	(CHKN)		/CHECK FOR <^N>, ETC.
	JMS I	(SCYCLE)	/CHECK FOR REPEAT CYCLE
	JMP	QRTLUP		/GO DO IT AGAIN
QRTEND,	ISZ	FRSTPTR		/BUMP TO NEXT DRIVE
	ISZ	QTSTCT		/DONE ALL DRIVES?
	JMP	QRTLUP		/NO, KEEP GOING
/	QUICK TEST 3:	SEEK TEST DRIVES.

QSTEST,	JMS I	(SETN)		/SETUP <^N> FOR
	QSTEND			/NEXT TEST
QSTLUP,	JMS I	(CHKN)		/CHECK FOR <^N>, ETC.
	JMS I	(QBTEST)	/CHECK IF LATEST DRIVE IS ENABLED FOR TESTING
	SNA CLA			/SKIP IF SO
	JMP	QSTEND		/JUMP IF NOT
	JMS I	(ANNMSG)	/TELL THEM
	QSMSG			/WE ARE SEEKING
	JMS I	(QSSUB)		/CALL SEEK ROUTINE
	JMS I	(ANNMSG)	/TELL THEM
	QSDMSG			/WE FINISHED
	DCA I	FRSTPTR		/CLEAR FIRST TIME SWITCH
	JMS I	(CHKN)		/CHECK FOR <N>, ETC.
	JMS I	(SCYCLE)	/CHECK FOR REPEAT CYCLE
	JMP	QSTLUP		/GO DO IT AGAIN
QSTEND,	ISZ	FRSTPTR		/BUMP TO NEXT DRIVE
	ISZ	QTSTCT		/DONE ALL DRIVES?
	JMP	QSTLUP		/NO, KEEP GOING
	JMP I	(QWTEST)	/ON TO NEXT TEST

	PAGE
/	QUICK TEST 4:	READ/WRITE TEST DRIVES.

QWTEST,	JMS I	(SETN)			/SETUP <^N> FOR
	QWTEND				/NEXT TEST
QWTLUP,	JMS I	(CHKN)			/TEST FOR <^N>, ETC.
	JMS I	(QBTEST)		/CHECK IF LATEST DRIVE IS ENABLED FOR TESTING
	SNA CLA				/SKIP IF SO
	JMP	QWTEND			/JUMP IF NOT
	JMS I	(ANNMSG)		/TELL THEM
	QWMSG				/WE ARE READ/WRITE CHECKING
	JMS I	(QWSUB)			/CALL READ/WRITE ROUTINE
	JMS I	(ANNMSG)		/TELL THEM
	QWDMSG				/WE FINISHED
	DCA I	FRSTPTR			/CLEAR FIRST TIME SWITCH
	JMS I	(CHKN)			/CHECK FOR <^N>, ETC.
	JMS I	(SCYCLE)		/CHECK FOR REPEAT CYCLE
	JMP	QWTLUP			/GO DO IT AGAIN
QWTEND,	ISZ	FRSTPTR			/BUMP TO NEXT DRIVE
	ISZ	QTSTCT			/DONE ALL DRIVES?
	JMP	QWTLUP			/NO, KEEP GOING

/	TEST 5:	DIRECT MEMORY ACCESS TEST.

QDTEST,	JMS I	(SETN)			/SETUP FOR
	QEND				/NEXT (TEST)
QDLOOP,	JMS I	(QBTEST)		/TEST IF LATEST DRIVE IS ENABLED FOR TESTING
	SZA CLA				/SKIP IF NOT
	JMP	QDTAGN			/JUMP IF SO
	ISZ	QTSTCT			/ON TO NEXT
	JMP	QDLOOP			/KEEP GOING
QDTAGN,	JMS I	(CHKN)			/CHECK FOR <^N>, ETC.
	NL7777				/INDICATE NO FRILLS USAGE
	JMS I	(ANNMSG)		/TELL THEM
	QDMMSG				/WE START THE DMA TEST
	NL0003	/TAD	(DATFLD%10)	/SETUP THE
	DCA	QDADDR+1		/FIELD
	DCA	QDADDR			/SETUP THE ADDRESS
	TAD	[-BLKSIZE]		/SETUP THE
	DCA	GNSW			/DMA COUNTER
	DCA	FBLK			/CLEAR OUT
	DCA	FBLK+1			/DMA BLOCK
QDTLUP,	JMS I	(CHKN)			/CHECK FOR <^N>, ETC.
	MQL				/CLEAR BUFFER NUMBER
	NL7777				/SETUP FOR ONE BUFFER
	CIF	PR2FLD			/GOTO CODE FIELD
	JMS I	(BUFSETUP)		/SETUP THE PATTERN BUFFER
	MOVE;	PCRBUFF;PATBUFF		/SAVE THE PATTERN
	MOVE;	PATBUFF;QDADDR		/MOVE IN THE PATTERN TO TEST BUFFER
	DLD;	QDADDR			/GET OUR TEST ADDRESS
	DST;	DMADDRESS		/STORE FOR DMA ROUTINES
	NL0002	/TAD	(WRITFN-READFN)	/SETUP FOR WRITE
	CIF	PR2FLD			/GOTO CODE FIELD
	JMS I	(DMEMPTY)		/CALL DMA ROUTINES
	SNA CLA				/SKIP IF PROBLEMS
	JMP	QDWROK			/JUMP IF OK
	JMS I	(COMPLAIN)		/TELL THEM
	WCERMSG				/ABOUT WRITE PROBLEM
	JMS I	[KLUDGE]		/UGH!
QDWROK,	NL7777				/SETUP THE
	DCA	XR1			/BUFFER POINTER
	TAD	[-BLKSIZE]		/SETUP THE
	DCA	CNT			/COUNTER
	CDF	DATFLD			/GOTO BUFFER FIELD
	DCA I	XR1			/CLEAR A WORD
	ISZ	CNT			/DONE YET?
	JMP	.-2			/NO, GO BACK
	CDF	PRGFLD			/YES, BACK TO OUR FIELD
	MOVE;	PCRBUFF;QDADDR		/CLEAR OUT TEST BUFFER
/	NL0000				/INDICATE READ
	CIF	PR2FLD			/GOTO CODE FIELD
	JMS I	(DMEMPTY)		/READ IT BACK IN
	SNA CLA				/SKIP IF PROBLEMS
	JMP	QDRDOK			/JUMP IF OK
	JMS I	(COMPLAIN)		/TELL THEM
	RCERMSG				/THEY HAVE PROBLEMS
	JMS I	[KLUDGE]		/UGH!
QDRDOK,	MOVE;	QDADDR;	PCRBUFF	/MOVE TEST PATTERN BACK
	CAM			/CLEAN UP
	NL7777			/SETUP COUNT
	CIF	PR2FLD		/GOTO CODE FIELD
	JMS I	(BUFVALIDATE)	/VALIDATE BUFFER
	SKP			/SKIP IF BAD
	JMP	QDMGUD		/JUMP IF OK
	TAD	PRNSW		/GET PRINTING SWITCH
	SNA CLA			/SKIP IF ERROR REPORTING ALLOWED
	JMP	QDMGUD		/ELSE FORGET IT
	JMS I	[MESSAGE]	/TELL THEM
	DMFMSG			/THEY GOOFED
	DLD;	QDADDR		/GET ADDRESS
	JMS I	(P10SIX)	/PRINT IT
	JMS I	[CRLF]		/DO A <CR>, <LF>
QDMGUD,	TAD	QDADDR		/GET ADDRESS
	TAD	(BLKSIZE+1)	/UPDATE IT
	DCA	QDADDR		/STORE IT BACK
	ISZ	GNSW		/DONE YET?
	JMP	QDTLUP		/NO, KEEP GOING
	NL7777			/INDICATE NO FRILLS MODE
	JMS I	(ANNMSG)	/TELL THEM
	QDMFMSG			/WE FINISHED
	DCA I	FRSTPTR		/CLEAR FIRST TIME SWITCH
	JMS I	(CHKN)		/CHECK FOR <^N>, ETC.
	JMS I	(SCYCLE)	/CHECK FOR REPEAT CYCLE
	JMP	QDTAGN		/GO DO IT AGAIN
QEND,	TAD	REPTSW		/GET REPITITION SWITCH
	SZA CLA			/SKIP IF NOT SET
	JMP I	(QRTEST)	/ELSE START ALL OVER
	JMS I	[MESSAGE]	/TELL THEM
	QDNMSG			/WE FINISHED IT ALL
	JMP I	(QIKAGN)	/GO BACK FOR MORE

	PAGE
QWSUB,	.-.				/READ/WRITE CHECK ROUTINE
	TAD	[-BLKSIZE]		/SETUP THE
	DCA	ANNARG			/READ/WRITE COUNTER
QWAGN,	JMS I	(CHKN)			/CHECK FOR <^N>, ETC.
	JMS I	(BFCALCULATE)		/CALCULATE BLOCK NUMBER, ETC.
	DCA	PATTERN			/CLEAR DATA PATTERN
/	NL0000				/INDICATE INITIAL BUFFER NUMBER
	MQL				/PASSED IN MQ
	TAD	SECTCNT			/GET BUFFER LENGTH
	CIF	PR2FLD			/GOTO CODE FIELD
	JMS I	(BUFSETUP)		/SETUP THE BUFFER
	TAD	FBLK			/GET DISPLAY BLOCK
	MQL				/SHOW IT
	NL0002	/TAD	(WRITFN-READFN)	/INDICATE WRITE
	CIF	PR2FLD			/GOTO CODE FIELD
	JMS I	(RDSECTORS)		/WRITE SOME SECTORS OUT
	SNA CLA				/SKIP IF PROBLEMS
	JMP	QWOK			/JUMP IF OK
	JMS I	(COMPLAIN)		/COMPLAIN OF
	WCERMSG				/WRITE ERRORS
	JMS I	[KLUDGE]		/UGH!
QWOK,/	NL0000				/INDICATE READ
	CIF	PR2FLD			/GOTO CODE FIELD
	JMS I	(RDSECTORS)		/READ SOME SECTORS IN
	SNA CLA				/SKIP IF PROBLEMS
	JMP	QRDOK			/JUMP IF OK
	JMS I	(COMPLAIN)		/COMPLAIN OF
	RCERMSG				/READ ERRORS
	JMS I	[KLUDGE]		/UGH!
QRDOK,	TAD	UNIT			/GET CURRENT UNIT
	CLL RTR;RTR			/MOVE OVER
	DCA	ERRTEMP			/SAVE IN CASE OF COMPARE ERROR
/	NL0000				/INDICATE INITIAL BUFFER NUMBER
	MQL				/PASSED IN MQ
	TAD	SECTCNT			/GET COUNT
	CIF	PR2FLD			/GOTO CODE FIELD
	JMS I	(BUFVALIDATE)		/VERIFY THE DATA
	SKP				/SKIP IF BAD
	JMP	QCMPOK			/JUMP IF OK
	JMS I	(COMPLAIN)		/COMPLAIN OF
	CMEMSG				/VALIDATION ERROR
QCMPOK,	ISZ	ANNARG			/DONE YET?
	JMP	QWAGN			/NO, GO DO ANOTHER ONE
	JMP I	QWSUB			/YES, RETURN
ANNMSG,	.-.			/ANNOUNCEMENT ROUTINE
	DCA	CHKN		/SAVE PASSED VALUE
	TAD I	ANNMSG		/GET THE IN-LINE ARGUMENT
	DCA	ANNARG		/STORE IN-LINE
	ISZ	ANNMSG		/BUMP PAST IT
	TAD	ANNSW		/GET ANNOUNCEMENT SWITCH
	SZA CLA			/SKIP IF OFF
	JMP	ANNCIT		/JUMP IF ON
	TAD	ADVSW		/GET ADVANCEMENT SWITCH
	SZA CLA			/SKIP IF OFF
	JMP I	ANNMSG		/FORGET IT
	TAD I	FRSTPTR		/IS THIS THE FIRST TIME FOR THIS DRIVE?
	SNA CLA			/SKIP IF SO
	JMP I	ANNMSG		/ELSE FORGET IT
ANNCIT,	JMS I	[MESSAGE]	/PRINT
ANNARG,	.-.			/THEIR MESSAGE
	ISZ	CHKN		/DO MORE?
	SKP			/SKIP IF SO
	JMP I	ANNMSG		/RETURN IF NOT
	TAD	UNIT		/GET CURRENT UNIT
	JMS I	[PRTUNIT]	/PRINT IT ALSO
	JMS I	[CRLF]		/DO A <CR>, <LF>
	JMP I	ANNMSG		/RETURN

CHKN,	.-.			/CHECK FOR <^N>, ETC. ROUTINE
	JMS I	[CHKUP]		/CHECK FOR <^P>, ETC.
	TAD	UNSW		/GET <^N> SWITCH
	SNA CLA			/SKIP IF SET
	JMP I	CHKN		/ELSE JUST RETURN
	DCA	UNSW		/CLEAR THE SWITCH
	JMP I	NEXT		/JUMP TO NEXT TEST

SETN,	.-.			/<^N> SETUP ROUTINE
	NL0001			/SET THE VALUE
	DCA	FRST0		/SET A WORD
	NL0001			/SET THE VALUE
	DCA	FRST1		/SET A WORD
	NL0001			/SET THE VALUE
	DCA	FRST2		/SET A WORD
	NL0001			/SET THE VALUE
	DCA	FRST3		/SET A WORD
	TAD I	SETN		/GET IN-LINE ARGUMENT
	DCA	NEXT		/STORE AS NEXT TEST ADDRESS
	TAD	[-4]		/SETUP THE
	DCA	QTSTCT		/DRIVE COUNT
	TAD	(FRST0)		/POINT TO
	DCA	FRSTPTR		/FIRST DRIVE
	ISZ	SETN		/BUMP PAST ARGUMENT
	JMP I	SETN		/RETURN
COMPLAI,.-.			/ERROR REPORTING ROUTINE
	TAD I	COMPLAIN	/GET IN-LINE ARGUMENT
	DCA	CMPLARG		/STORE IN-LINE
	ISZ	COMPLAIN	/BUMP PAST ARGUMENT
	TAD	PRNSW		/GET REPORTING SWITCH
	SNA CLA			/SKIP IF ON
	JMP	COMPSILENTLY	/JUMP IF OFF
	JMS I	[ERRMSG]	/MAKE
CMPLARG,.-.			/THEIR COMPLAINT
COMPSIL,JMS I	[KLUDGE]	/UGH!
	JMP I	COMPLAIN	/RETURN

SCYCLE,	.-.			/SINGLE CYCLE CHECK ROUTINE
	TAD	ADVSW		/GET ADVANCEMENT SWITCH
	SZA CLA			/SKIP IF OFF
	ISZ	SCYCLE		/ELSE TAKE SKIP RETURN
	JMP I	SCYCLE		/RETURN EITHER WAY

QTMOUNT,.-.			/QUICK MOUNT ROUTINE
	DCA	UNIT		/SAVE PASSED UNIT VALUE
	JMS I	[GETREADY]	/GET THE DRIVE MOUNTED
	RCMMSG			/FLEXIBLE DISK MESSAGE
/	NL0000			/INDICATE ANYTHING IS ALLOWED
	CIF	PR2FLD		/GOTO CODE FIELD
	JMS I	[DATASTATUS]	/GET DISK DATA STATUS
	CLA			/IGNORE PROBLEMS
	JMS I	[SURESPONSE]	/ASK IF THEY ARE SURE
	PTDMSG			/PERMISSION MESSAGE
	JMP I	(QIKAGN)	/FORGET IT
	JMP I	QTMOUNT		/RETURN

FRST0,	.-.			/FIRST TIME SWITCH FOR DRIVE ZERO
FRST1,	.-.			/FIRST TIME SWITCH FOR DRIVE ONE
FRST2,	.-.			/FIRST TIME SWITCH FOR DRIVE TWO
FRST3,	.-.			/FIRST TIME SWITCH FOR DRIVE THREE

