	CSFINLST-1		/TEXT/DISPATCH LIST-1
/	SAVE CONTENTS OF FLEXIBLE DISK DRIVE ZERO IN WINCHESTER BUFFER COMMAND COMES HERE.

S0,	NL0002			/USE DRIVE TWO
	SKP			/NOT DRIVE THREE

/	SAVE CONTENTS OF FLEXIBLE DISK DRIVE ONE IN WINCHESTER BUFFER COMMAND COMES HERE.

S1,	NL0003			/USE DRIVE THREE
	DCA	INUNIT		/STORE INPUT UNIT
	JMS	WBCHK		/SETUP WINCHESTER UNIT
	DCA	OTUNIT		/STORE OUTPUT UNIT
	JMS I	(SETFLX)	/SETUP NEGATED FLEXIBLE DISK LIMIT
	DAD;	LOGMAX		/ADD ON WINCHESTER SIZE
	DST;	DSTROKE		/SETUP INITIAL OUTPUT BLOCK
	DLD;	LOGMAX		/GET WINCHESTER SIZE
	DCM			/WANT NEGATIVE FORM
	DST;	UPLIM		/SAVE AS UPPER LIMIT
	CAM			/CLEAN UP
	DST;	FBLK		/INPUT STARTS AT ZERO
R1ENTRY,CIF	PR2FLD		/GOTO CODE FIELD
	JMS I	(DSKCOPY)	/GO COPY A DISK
	JMP	CSPAGN		/GO BACK FOR MORE

/	RESTORE CONTENTS OF FLEXIBLE DISK DRIVE ZERO FROM WINCHESTER BUFFER COMMAND COMES HERE.

R0,	NL0002			/USE DRIVE TWO
	SKP			/NOT DRIVE THREE

/	RESTORE CONTENTS OF FLEXIBLE DISK DRIVE ONE FROM WINCHESTER BUFFER COMMAND COMES HERE.

R1,	NL0003			/USE DRIVE THREE
	DCA	OTUNIT		/STORE OUTPUT UNIT
	JMS	WBCHK		/SETUP WINCHESTER UNIT
	DCA	INUNIT		/STORE INPUT UNIT
	JMS I	(SETFLX)	/SETUP NEGATED FLEXIBLE DISK LIMIT
	DST;	UPLIM		/SAVE AS UPPER LIMIT
	DAD;	LOGMAX		/ADD ON WINCHESTER SIZE
	DST;	FBLK		/SAVE AS INITIAL INPUT BLOCK
	CAM			/CLEAN UP
	DST;	DSTROKE		/OUTPUT STARTS AT ZERO
	JMP	R1ENTRY		/CONTINUE THERE
/	SPECIFY WINCHESTER DISK FOR DATA BUFFER COMMAND COMES HERE.

SPWIND,	JMS I	[MESSAGE]	/TELL THEM
	EWNMSG			/TO ENTER THE NUMBER
