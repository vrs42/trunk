/	OUTPUT ERRORS COME HERE.

OTERR,	JMS I	(KLUDG1)	/BARF!
	ISZ I	(OTECNT)	/TOO MANY ERRORS?
	JMP I	(OTAGN)		/NO, TRY AGAIN
	TAD	(OTEMSG)	/SETUP THE
OTCOMN,	DCA	OERRARG		/MESSAGE POINTER
	JMS	IOCHK		/CHECK FOR ONE-AT-A-TIME MODE
	DLD;	OUTBLK		/GET CURRENT OUTPUT BLOCK
	CDF	PRGFLD		/GOTO CALLING FIELD
	DST;	FBLK		/STORE FOR ERROR ROUTINE
	CAM			/CLEAN UP
	CDF	PR2FLD		/INDICATE OUR FIELD
	CIF	PRGFLD		/GOTO CODE FIELD
	JMS I	[ERRMSG]	/COMPLAIN ABOUT
OERRARG,OTEMSG	/OR CMEMSG	/OUTPUT ERROR
	CIF	PRGFLD		/GOTO CODE FIELD
	JMS I	[ASKRETRY]	/ASK FOR A RETRY
	JMP I	(INPAST)	/YES, TRY AGAIN
	CIF	PRGFLD		/GOTO CODE FIELD
	JMS I	[MESSAGE]	/TELL THEM
	SKPMSG			/THEY CAN SKIP PAST
	CIF	PRGFLD		/GOTO CODE FIELD
	JMS I	[YORNO]		/ASK FOR IT
	JMP	OTPAST		/YES, SKIP PAST THE PROBLEM
FAIL1,	CIF CDF	PRGFLD		/GOTO CALLING FIELD
	JMP I	(FAIL)		/FORGET IT

/	COMPARE ERRORS COME HERE.

CMERR,	JMS I	(KLUDG1)	/BARF!
	ISZ I	(CMECNT)	/TOO MANY ERRORS?
	JMP I	(VERAGN)	/NO, TRY AGAIN
	TAD	(CMEMSG)	/POINT AT OUR MESSAGE
	JMP	OTCOMN		/CONTINUE THERE
IOCHK,.-.			/I/O MODE CHECK ROUTINE
	TAD	CIOSW		/GET CURRENT SWITCH VALUE
	SZA CLA			/SKIP IF IN NORMAL MODE
	JMP I	IOCHK		/RETURN IF IN ONE-AT-A-TIME MODE
	TAD	(20%2^7777)	/SETUP THE
	DCA	CIOSW		/ONE-AT-A-TIME MODE
	NL0001			/SETUP SINGLE RECORD UPDATE
	DCA	CUPDATE		/STORE NEW UPDATE FACTOR
	JMP I	(IOLOOP)	/CONTINUE THERE

	PAGE
/	DISK I/O EXECUTE ROUTINE.

DEXC,	.-.			/I/O EXECUTE ROUTINE
	DCA	IOADR		/SAVE COMMAND ADDRESS
	CDF	PRGFLD		/ENSURE MAIN PROGRAM FIELD
	TAD	(-1000)		/SETUP THE
	DCA	IOCNT2		/TIME-OUT COUNTER
IOCLUP,	DSCB			/READ BUSY STATUS
	SMA CLA			/SKIP IF STILL BUSY
	JMP	IOCMORE		/JUMP IF NOT BUSY
	ISZ	IOCNT1		/WASTE
	JMP	.-1		/SOME TIME
	ISZ	IOCNT2		/TOO LONG?
	JMP	IOCLUP		/NO, KEEP GOING
	CIF	PRGFLD		/GOTO MAIN PROGRAM FIELD
	JMP I	(IOBARF)	/GO COMPLAIN THERE

IOCMORE,JMS	WASTE6		/WASTE SOME TIME
	NL0001	/TAD	(PR2FLD)/SET OUR FIELD
	DSHI			/SET BANK AND FIELD
	TAD	(-150)		/SETUP THE
	DCA	IOCNT1		/TIMING LOOP
	ISZ	IOCNT1		/WASTE
	JMP	.-1		/SOME TIME
	TAD	IOADR		/GET PASSED ADDRESS BACK
	DSGO			/START IT UP
	DSSF			/FLAG UP?
	JMP	.-1		/NO, WAIT FOR IT
	DSCF			/YES, CLEAR IT
	JMS	WASTE6		/WASTE SOME TIME
	DSRS			/READ STATUS NOW
	DCA I	[ERRTEMP]	/SAVE FOR OTHERS
	TAD I	[ERRTEMP]	/GET IT BACK
	JMP I	DEXC		/RETURN

WASTE6,	.-.			/WASTE SOME TIME ROUTINE
	AND I	0		/\
	AND I	0		/ \
	AND I	0		/  \WASTE
	AND I	0		/  /SOME TIME
	AND I	0		/ /
	AND I	0		//
	JMP I	WASTE6		/RETURN

ENADRV,	.-.			/DRIVE ENABLE ROUTINE
	DCA	DEWORD		/STORE COMPOSITE IN COMMAND
	TAD	(DECOMD)	/POINT AT OUR COMMAND
	JMS	DEXC		/GO DO IT
	CIF	PRGFLD		/BACK TO CALLING FIELD
	JMP I	ENADRV		/RETURN WITH PASSED STATUS
DEFORM,	.-.			/DEFINE FLEXIBLE DISK FORMAT ROUTINE
	TAD I	[UNIT]		/GET CURRENT UNIT
	DCA	DEFDRV		/STORE IN COMMAND
	TAD I	(FLPFRM)	/GET CURRENT FLEXIBLE DISK FORMAT
	DCA	DEFFRM		/STORE IN COMMAND
	TAD	(DEFCMD)	/POINT TO OUR COMMAND
	JMS	DEXC		/GO DO IT
	CIF	PRGFLD		/BACK TO CALLING FIELD
	JMP I	DEFORM		/RETURN WITH PASSED ERROR STATUS

/	DMA ROUTINE (ACTUALLY DISK READ/WRITE.)

DMEMPTY,.-.			/DMA FILL/EMPTY ROUTINE
	TAD	[READFN]	/ADD ON READ BITS TO PASSED OFFSET
	DCA	DMRW		/STORE IN COMMAND
	TAD I	[UNIT]		/GET CURRENT UNIT
	DCA	DMUNIT		/STORE IN COMMAND
	TAD I	[DMADDRESS+1]	/GET HIGH-ORDER DMA ADDRESS
	DCA	DMAFLD		/STORE IN COMMAND
	TAD I	[DMADDRESS]	/GET LOW-ORDER DMA ADDRESS
	DCA	DMADLO		/STORE IN COMMAND
	TAD I	[DMADDRESS]	/GET IT AGAIN
	RTR;RTR;RTR		/MOVE DOWN HIGH-HALF OF IT
	DCA	DMADHI		/STORE IN COMMAND
	TAD	(DMCOMMAND)	/POINT AT COMMAND
	JMS	DEXC		/EXECUTE THIS COMMAND
	CIF	PRGFLD		/GOTO CALLING FIELD
	JMP I	DMEMPTY		/RETURN

/	DRIVE ENABLE COMMAND TABLE.

DECOMD,	3			/LENGTH OF COMMAND
	210			/COMMAND TYPE
DEWORD,	.-.			/DRIVE ENABLE WORD

/	DEFINE FLEXIBLE DISK FORMAT COMMAND TABLE.

DEFCMD,	5			/LENGTH
	0			/TYPE 0 COMMAND
	DFDFFN			/DEFINE FLEXIBLE DISK FORMAT VALUE
DEFDRV,	.-.			/WILL BE DRIVE UNIT NUMBER
DEFFRM,	.-.			/WILL BE FLEXIBLE DISK FORMAT TYPE

IOADR,	.-.			/I/O ADDRESS TEMPORARY
IOCNT1,	.-.			/INNER COUNTER
IOCNT2,	.-.			/OUTER COUNTER
/	FIELD ONE KLUDGE ROUTINE.

KLUDG1,	.-.			/KLUDGY ROUTINE
	CLA			/CLEAN UP
	CDF	PRGFLD		/GOTO CALLING FIELD
	TAD I	[UNIT]		/GET CURRENT UNIT
	CDF	PR2FLD		/BACK TO OUR FIELD
	TAD	(2^100)		/TURN INTO READ FUNCTION
	DCA	KL1FUN		/STORE IN-LINE
	NL7775			/SETUP THE
	DCA	KL1CNT		/KLUDGE COUNTER
KLULOOP,CIF	PRGFLD		/GOTO CODE FIELD
	JMS I	[IOHAND]	/CALL HANDLER
	INITIAL			/TRANSFER ADDRESS
KL1FUN,	2^100+.-.		/UNIT BITS WILL BE FILLED IN
	KL0			/RECORD POINTER
	CLA			/CLEAN UP
	ISZ	KL1CNT		/DONE ENOUGH?
	JMP	KLULOOP		/NO, KEEP GOING
	JMP I	KLUDG1		/YES, RETURN

KL1CNT,	.-.			/COUNTER
KL0,	ZBLOCK	2		/POINTER TO RECORD ZERO

/	DMA COMMAND TABLE (ACTUALLY READ/WRITE COMMAND TABLE.)

DMCOMM,	14			/LENGTH OF COMMAND
	0			/COMMAND TYPE
DMRW,	READFN/OR WRITFN	/COMMAND
DMUNIT,	.-.			/DRIVE CODE
	0			/CONTROL WORD
	0			/DISK ADDRESS - HIGH-ORDER
	0			/DISK ADDRESS - MIDDLE
	0			/DISK ADDRESS - LOW-ORDER
	1			/SECTOR COUNT
DMAFLD,	.-.			/TRANSFER BANK AND FIELD
DMADHI,	.-.			/TRANSFER ADDRESS - HIGH-ORDER
DMADLO,	.-.			/TRANSFER ADDRESS - LOW-ORDER

	PAGE
/	TEST READY (SENSE STATUS) ROUTINE.

TSTREAD,.-.			/TEST FOR READY ROUTINE
	TAD I	[UNIT]		/GET LOGICAL UNIT
	DCA	TSTUNIT		/STORE IN COMMAND
	TAD	(TSTCOMMAND)	/POINTER TO OUR COMMAND
	JMS I	(DEXC)		/GO DO IT
	CIF	PRGFLD		/GOTO CALLING FIELD
	JMP I	TSTREADY	/RETURN

/	FORMAT TRACK ROUTINE.

FRMTRK,	.-.			/FORMAT A TRACK ROUTINE
	NL0002			/SET FLEXIBLE DISK/WINCHESTER DISK MASK
	AND I	[UNIT]		/GET THE BIT
	CLL RTR			/MOVE TO LINK
	SZL			/SKIP IF WINCHESTER DISK
	TAD I	(FINTLV)	/GET FLEXIBLE DISK INTERLEAVE FACTOR
	SNL			/SKIP IF FLEXIBLE DISK
	TAD I	(WINTLV)	/GET WINCHESTER DISK INTERLEAVE FACTOR
	DCA	INTRLV		/STORE IN COMMAND
	TAD I	[UNIT]		/GET CURRENT UNIT
	DCA	FTUNIT		/STORE IN COMMAND
	TAD I	[FBLK+1]	/GET HIGH-ORDER DISK ADDRESS
	DCA	FTADHIGH	/STORE IN COMMAND
	TAD I	[FBLK]		/GET MIDDLE DISK ADDRESS
	RTR;RTR;RTR		/MOVE OVER
	DCA	FTADMIDDLE	/STORE IN COMMAND
	TAD I	[FBLK]		/GET LOW-ORDER DISK ADDRESS
	DCA	FTADLOW		/STORE IN COMMAND
	TAD	(FTCOMMAND)	/POINT TO OUR COMMAND
	JMS I	(DEXC)		/GO DO IT
	CIF	PRGFLD		/GOTO CALLING FIELD
	JMP I	FRMTRK		/RETURN

/	READ SECTORS ROUTINE.

RDSECTO,.-.			/READ SECTORS ROUTINE
	TAD	[READFN]	/ADD ON BASIC READ
	DCA	REDCOMMAND	/STORE IN-LINE
	TAD	RDSECTORS	/GET OUR CALLER
	DCA	RDTRACK		/MAKE IT THEIRS
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	RDTXIT		/STORE IN-LINE
	CDF	PRGFLD		/ENSURE DATA FIELD
	TAD I	(SECTCNT)	/GET SECTOR COUNT
	JMP	RDSENTRY	/CONTINUE THERE
/	READ ENTIRE TRACK ROUTINE.

RDTRACK,.-.			/READ TRACK ROUTINE
	TAD	[READFN]	/ADD ON BASIC READ COMMAND
	DCA	REDCOMMAND	/STORE IN-LINE
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	RDTXIT		/STORE IN-LINE
	CDF	PR2FLD		/INDICATE OUR CALLING FIELD
	JMS I	(SETSIZE)	/SETUP DEVICE-DEPENDENT SIZE
	CDF	PRGFLD		/ENSURE DATA FIELD
RDSENTR,CIA			/WANT POSITIVE FORM
	DCA	RDSCNT		/STORE IN COMMAND
	TAD I	[UNIT]		/GET CURRENT UNIT
	DCA	RDUNIT		/STORE IN COMMAND
	TAD I	[FBLK+1]	/GET HIGH-ORDER DISK ADDRESS
	DCA	RDADHIGH	/STORE IN COMMAND
	TAD I	[FBLK]		/GET MIDDLE DISK ADDRESS
	RTR;RTR;RTR		/MOVE OVER
	DCA	RDADMIDDLE	/STORE IN COMMAND
	TAD I	[FBLK]		/GET LOW-ORDER DISK ADDRESS
	DCA	RDADLOW		/STORE IN COMMAND
	TAD	(RDCOMMAND)	/POINT AT COMMAND
	JMS I	(DEXC)		/GO DO IT
RDTXIT,	.-.			/WILL BE CIF CDF RETURN FIELD
	JMP I	RDTRACK		/RETURN

SEKTRK,	.-.			/SEEK ROUTINE
	CLA			/CLEAN UP
	TAD I	[UNIT]		/GET THE UNIT
	DCA	SKUNIT		/STORE IN COMMAND
	TAD I	[FBLK+1]	/GET HIGH-ORDER DISK ADDRESS
	DCA	SKADHIGH	/STORE IN COMMAND
	TAD I	[FBLK]		/GET MIDDLE DISK ADDRESS
	RTR;RTR;RTR		/MOVE OVER
	DCA	SKADMIDDLE	/STORE IN COMMAND
	TAD I	[FBLK]		/GET LOW-ORDER DISK ADDRESS
	DCA	SKADLOW		/STORE IN COMMAND
	TAD	(SKCOMMAND)	/POINT AT COMMAND
	JMS I	(DEXC)		/GO DO IT
	CIF	PRGFLD		/GOTO CALLING FIELD
	JMP I	SEKTRK		/RETURN
/	TEST READY COMMAND TABLE.

TSTCOMM,5			/LENGTH OF COMMAND
	0			/COMMAND TYPE
	TRFN			/COMMAND
TSTUNIT,.-.			/DRIVE CODE
	0			/CONTROL WORD

/	FORMAT TRACK COMMAND TABLE.

FTCOMMA,11			/LENGTH OF COMMAND
	0			/COMMAND TYPE
	FTRKFN			/COMMAND
FTUNIT,	.-.			/DRIVE CODE
	0			/CONTROL WORD
FTADHI,	.-.			/DISK ADDRESS - HIGH-ORDER
FTADMID,.-.			/DISK ADDRESS - MIDDLE
FTADLO,	.-.			/DISK ADDRESS - LOW-ORDER
INTRLV,	.-.			/INTERLEAVE FACTOR

/	READ COMMAND TABLE.

RDCOMM,	14			/LENGTH OF COMMAND
	0			/COMMAND TYPE
REDCOMM,READFN			/COMMAND
RDUNIT,	.-.			/DRIVE CODE
	0			/CONTROL WORD
RDADHI,	.-.			/DISK ADDRESS - HIGH-ORDER
RDADMID,.-.			/DISK ADDRESS - MIDDLE
RDADLOW,.-.			/DISK ADDRESS - LOW-ORDER
RDSCNT,	.-.			/SECTOR COUNT
	DATFLD%10		/TRANSFER FIELD
	0			/TRANSFER ADDRESS - HIGH-ORDER
	0			/TRANSFER ADDRESS - LOW-ORDER

/	SEEK COMMAND TABLE.

SKCOMM,	10			/LENGTH OF COMMAND
	0			/COMMAND TYPE
	SEEKFN			/COMMAND
SKUNIT,	.-.			/DRIVE CODE
	0			/CONTROL WORD
SKADHI,	.-.			/DISK ADDRESS - HIGH-ORDER
SKADMID,.-.			/DISK ADDRESS - MIDDLE
SKADLOW,.-.			/DISK ADDRESS - LOW-ORDER
