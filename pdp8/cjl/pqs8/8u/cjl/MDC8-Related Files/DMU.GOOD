VERTBL,	TAD	(TA00-TA24-1)	/SETUP THE
	DCA	BTRYCT		/DIGIT CHECKING COUNT
	NL7777	/TAD	(TA00-1)/SETUP THE
	DCA	XR1		/BUFFER POINTER
VSERLP,	CDF	TBLFLD		/GOTO TABLE FIELD
	TAD I	XR1		/GET A WORD
	CDF	PR2FLD		/BACK TO OUR FIELD
	JMS I	(VALNUMERIC)	/CHECK IF VALID DIGIT
	JMP I	(RBADXT)	/COMPLAIN IF NOT A DIGIT
	ISZ	BTRYCT		/DONE ALL DIGITS?
	JMP	VSERLP		/NO, GO BACK
	NL7775			/SETUP THE
	DCA	BTRYCT		/CHARACTER COUNT
VTIMLP,	CDF	TBLFLD		/GOTO TABLE FIELD
	TAD I	XR1		/GET A TIME ZONE CHARACTER
	CDF	PR2FLD		/BACK TO OUR FIELD
	JMS I	(VALALPHA)	/CHECK IF VALID ALPHABETIC
	JMP I	(RBADXT)	/COMPLAIN IF NOT A VALID ALPHABETIC
	ISZ	BTRYCT		/DONE ALL YET?
	JMP	VTIMLP		/NO, KEEP GOING
	JMS I	(GET2);	TA11-1	/GET MONTH VALUE
	TAD	(-14-1)		/ADD ON LIMIT
	CLL			/CLEAR LINK FOR TEST
	TAD	(14)		/ADD ON RANGE
	SNL CLA			/SKIP IF OK
	JMP I	(RBADXT)	/COMPLAIN IF NOT
	JMS I	(GET2);	TA15-1	/GET DECADE VALUE
	TAD	(-24)		/COMPARE TO 20XX
	SNA			/SKIP IF OTHER
	JMP	VB2000		/JUMP IF IT MATCHES
	IAC			/COMPARE TO 19XX
	SZA CLA			/SKIP IF IT MATCHES
	JMP I	(RBADXT)	/COMPLAIN IF NOT
	JMS I	(GET2);	TA17-1	/GET YEAR VALUE
	TAD	(-143-1)	/ADD ON LIMIT
	CLL			/CLEAR LINK FOR TEST
	TAD	(144-120)	/ADD ON RANGE (80-99)
	SNL CLA			/SKIP IF 1980-1999
	JMP I	(RBADXT)	/COMPLAIN IF NOT
	JMP	VBCOMMON	/CONTINUE THERE

VB2000,	JMS I	(GET2);	TA17-1	/GET YEAR VALUE
	TAD	(-117-1)	/ADD ON LIMIT
	CLL			/CLEAR LINK FOR TEST
	TAD	(120)		/ADD ON RANGE (00-79)
	SNL CLA			/SKIP IF 2000-2079
	JMP I	(RBADXT)	/COMPLAIN IF NOT
VBCOMMO,JMS I	(GET2);	TA17-1		/GET THE YEAR
	AND	(3)			/JUST LEAP YEAR BITS
	SNA CLA				/SKIP IF NOT LEAP YEAR
	ISZ I	(FEBENT)		/ELSE MAKE IT LEAP YEAR IN TABLE
	JMS I	(GET2);	TA11-1		/GET MONTH VALUE
	TAD	(JANENT-1)		/ADJUST TO PROPER ELEMENT
	DCA	BTRYCT			/STASH THE POINTER
	CDF	PR2FLD			/GOTO DATE TABLE FIELD
	TAD I	BTRYCT			/GET THE VALUE
	CIA				/INVERT FOR TESTING
	DCA	BTRYCT			/SAVE IT FOR LATER
	TAD	(34)			/RESTORE THE
	DCA I	(FEBENT)		/FEBRUARY ENTRY
	JMS I	(GET2);	TA13-1		/GET THE DAY VALUE
	SNA				/SKIP IF POSSIBLE
	JMP I	(RBADXT)		/COMPLAIN IF NOT
	TAD	BTRYCT			/ADD ON LIMIT
	SMA SZA CLA			/SKIP IF VALID
	JMP I	(RBADXT)		/COMPLAIN IF NOT
	JMS I	(GET2);	TA21-1		/GET HOURS VALUE
	TAD	(-30)			/ADD ON LIMIT
	CLL				/CLEAR LINK FOR TEST
	TAD	(30)			/ADD ON RANGE
	SNL CLA				/SKIP IF VALID
	JMP I	(RBADXT)		/COMPLAIN IF NOT
	JMS I	(GET2);	TA23-1		/GET MINUTES VALUE
	TAD	(-74)			/ADD ON LIMIT
	CLL				/CLEAR LINK FOR TEST
	TAD	(74)			/ADD ON RANGE
	SNL CLA				/SKIP IF OK
	JMP I	(RBADXT)		/COMPLAIN IF NOT
	CDF	PRGFLD			/ENSURE CALLING FIELD
	DLD;	BTBLKINITIAL		/GET LIMIT BLOCK
	DAD;	M21			/BACKUP TO HIGHEST ALTERNATE
	CDF	PR2FLD			/BACK TO OUR FIELD
	DST;	FLWRECORD		/STORE IT
	CAM				/CLEAN UP
	TAD	(BTBFEND-TENT%2^7777)	/SETUP THE
	DCA	BTRYCT			/ENTRY COUNTER
	JMP I	(VENLUP)		/CONTINUE THERE
	PAGE
VENLUP,	CDF	TBLFLD		/GOTO TABLE FIELD
	TAD I	XR1		/GET A WORD
	MQL			/PUT IN LOW-ORDER
	TAD I	XR1		/GET HIGH-ORDER
	CDF	PR2FLD		/BACK TO OUR FIELD
	DST;	FLWTMP		/SAVE IT
	ISZ I	(FLWTMP)	/CHECK FOR -1
	SKP			/SKIP IF POSSIBLE
	ISZ I	(FLWTMP+1)	/CHECK HIGH-ORDER
	JMP	NOTM1		/JUMP IF OTHER VALUE
VENTOK,	DLD;	FLWRECORD	/GET CURRENT BLOCK
	CDF	PRGFLD		/GOTO CALLING FIELD
	DAD;	M21		/DECREMENT ONE TRACK'S WORTH
	CDF	PR2FLD		/BACK TO OUR FIELD
	DST;	FLWRECORD	/STORE BACK
	CAM			/CLEAN UP
	ISZ	BTRYCT		/DONE ALL ENTRIES?
	JMP	VENLUP		/NO, GO GET ANOTHER ONE
	JMP I	(RGUDXT)	/TAKE GOOD RETURN

NOTM1,	DST;	FLWTM1		/SAVE UN-MODIFIED BLOCK FOR NOW
	CLL RAL			/MOVE UP
	CLL RAR			/CLEAR BIT[0]
	DST;	FLWTM2		/SAVE IT AGAIN
	DAD;	MWLGMAX		/COMPARE TO LARGEST LOGICAL SECTOR
	SPA CLA			/SKIP IF BAD
	JMP	VENTOK		/JUMP IF OK
	DLD;	FLWTM1		/GET IT BACK
	RAL			/MOVE UP
	SMA CLA			/SKIP IF BAD ALTERNATE TRACK ENTRY
	JMP I	(RBADXT)	/COMPLAIN IF NOT
	DLD;	FLWTM2		/GET STRIPPED FORM
	CLL RTL			/MOVE UP
	CLL RTR			/MOVE DOWN WITH BIT[1] OFF
	DCM			/INVERT FOR TESTING
	DAD;	FLWRECORD	/COMPARE TO CURRENT VALUE
	SNA			/SKIP IF ALREADY BAD
	MQA			/ELSE GET LOW-ORDER
	SNA CLA			/SKIP IF IT DOESN'T MATCH
	JMP	VENTOK		/JUMP IF IT DOES
	JMP I	(RBADXT)	/COMPLAIN IF NO MATCH
/	FLAW MAP SEARCH ROUTINE.

SEFLAW,	.-.				/SEARCH FLAW TABLE
	CDF	PRGFLD			/ENSURE CALLING FIELD
	DLD;	BTBLKINITIAL		/GET LIMIT BLOCK
	DAD;	M21			/BACKUP
	DST;	FLWBLK			/STORE INITIAL MAP BLOCK
	CAM				/CLEAN UP
	TAD	(BTBFEND-TENT%2^7777)	/SETUP THE
	DCA	BTCNTR			/SEARCH COUNT
	TAD	(TENT-1)		/SETUP THE
	DCA	XR1			/SEARCH POINTER
SEFLUP,	CDF	TBLFLD			/GOTO TABLE FIELD
	TAD I	XR1			/GET LOW-ORDER
	CIA				/INVERT FOR TESTING
	CDF	PRGFLD			/BACK TO CALLING FIELD
	TAD I	[FBLK]			/COMPARE TO DESIRED
	SZA CLA				/SKIP IF IT MATCHES
	JMP	SE1DIF			/JUMP IF NOT
	CDF	TBLFLD			/GOTO TABLE FIELD
	TAD I	XR1			/GET HIGH-ORDER
	CIA				/INVERT FOR TESTING
	CDF	PRGFLD			/BACK TO CALLING FIELD
	TAD I	[FBLK+1]		/COMPARE TO DESIRED
	AND I	(SMASK)			/REMOVE UN-WANTED BITS
	SZA CLA				/SKIP IF FOUND
	JMP	SE2DIF			/JUMP IF NOT
	TAD	XR1			/GET POINTER
	DCA I	(XR1)			/SAVE FOR CALLERS
	ISZ	SEFLAW			/BUMP TO GOOD RETURN
SEFXIT,	CIF CDF	PRGFLD			/BACK TO OUR FIELD
	JMP I	SEFLAW			/RETURN

SE1DIF,	ISZ	XR1			/BUMP PAST UNUSED ENTRY
SE2DIF,	DLD;	FLWBLK			/GET CURRENT BLOCK
	DAD;	M21			/DECREMENT IT
	DST;	FLWBLK			/STORE BACK
	CAM				/CLEAN UP
	ISZ	BTCNTR			/LOOKED AT ALL?
	JMP	SEFLUP			/NO, KEEP GOING
	JMP	SEFXIT			/TAKE BAD RETURN
GET2,	.-.				/GET VALUE FROM TWO NUMERICS ROUTINE
	TAD I	GET2			/GET PASSED ARGUMENT
	DCA	XR2			/STASH THE POINTER
	ISZ	GET2			/BUMP PAST ARGUMENT
	CDF	TBLFLD			/GOTO TABLE FIELD
	TAD I	XR2			/GET FIRST VALUE
	DCA	BTCNTR			/SAVE IT
	TAD	BTCNTR			/GET IT BACK
	CLL RTL				/*4
	TAD	BTCNTR			/*5
	RAL				/*10
	TAD I	XR2			/ADD ON SECOND VALUE
	CDF	PR2FLD			/BACK TO OUR FIELD
	TAD	(-"0+200^12-"0+200)	/REMOVE ASCII BITS
	JMP I	GET2			/RETURN

