	TAD	MLCNTR		/YES, USE UNIT COUNT
	DCA	BTRYCT		/SAVE COUNTER EITHER WAY
	TAD	(20)		/GET BIT VALUE
	CLL RAR			/MOVE OVER
	ISZ	BTRYCT		/DONE YET?
	JMP	.-2		/NO, KEEP GOING
	TAD	MLWORD		/ADD ON ACCUMULATION
	DCA	MLWORD		/STORE IT BACK
	ISZ	MLCNTR		/DONE YET?
	JMP	MULOOP		/NO, KEEP GOING
	TAD	MLWORD		/YES, GET COMPOSITE
	CIF CDF	PRGFLD		/GOTO CALLING FIELD
	JMP I	MULTENABLE	/RETURN

MLCNTR,	.-.			/UNIT COUNTER
MLWORD,	.-.			/ENABLE WORD

