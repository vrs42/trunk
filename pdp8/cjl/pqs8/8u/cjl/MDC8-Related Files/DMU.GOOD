	NL0001			/SET YES VALUE
	DCA	PRNSW		/SAVE EITHER WAY
	JMP	QVAAGN		/KEEP GOING

/	COPYING FUNCTIONS COMMAND COMES HERE.

COPY,	JMS I	[SETUP]		/SETUP RESTART ADDRESS
	JMS I	[MESAG2]	/ANNOUNCE OURSELVES
	COMENU			/WITH FIRST BLURB
COPAGN,	CIF	PR2FLD		/GOTO CODE FIELD
