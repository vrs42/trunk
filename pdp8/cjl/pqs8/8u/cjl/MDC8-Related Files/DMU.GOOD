	*5000

/	FIELD ZERO SUPPORT ROUTINES.

/	YES OR NO ROUTINE.

YORNO,	.-.			/YES OR NO ROUTINE
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	YRNXIT		/STORE IN-LINE
	CDF	PRGFLD		/GOTO OUR FIELD
YNAGN,	JMS I	[TTYIN]		/GET A CHARACTER
	TAD	(-"Y!200)	/COMPARE TO "Y"
	SNA			/SKIP IF SOMETHING ELSE
	JMP	ISYES		/JUMP IF IT MATCHES
	TAD	(-"N+"Y)	/COMPARE TO "N"
	SNA CLA			/SKIP IF SOMETHING ELSE
	JMP	ISNO		/JUMP IF IT MATCHES
	JMS I	[BONG]		/BEEP AT THEM
	JMP	YNAGN		/TRY AGAIN

ISYES,	JMS I	[MESSAGE]	/TELL THEM
	YESMSG			/YES!
	JMP	YRNXIT		/TAKE FIRST RETURN

ISNO,	JMS I	[MESSAGE]	/TELL THEM
	NOMSG			/NO!
	ISZ	YORNO		/BUMP RETURN ADDRESS
YRNXIT,	.-.			/WILL BE CIF CDF RETUN FIELD
	JMP I	YORNO		/TAKE SKIP RETURN

/	DRIVE MOUNT ROUTINE.

MOUNT,	.-.			/MOUNT ROUTINE
	TAD I	MOUNT		/GET PASSED ARGUMENT
	DCA	MNTARG		/STORE IN OUR ARGUMENT
	ISZ	MOUNT		/BUMP PAST
	JMS I	[MESSAGE]	/ISSUE MOUNT MESSAGE
MNTARG,	.-.			/PASSED ARGUMENT HERE
	TAD	UNIT		/GET UNIT NUMBER
	JMS I	[PRTUNIT]	/GO PRINT AGAIN
	JMS I	[WAITOK]	/GIVE THE TRAILING MESSAGE
	MTRLMSG			/FOR A GOOD LOOK
	JMP I	MOUNT		/RETURN
/	SIX-DIGIT DECIMAL PRINT ROUTINE.

P10SIX,	.-.			/PRINT DECIMAL SIX DIGITS ROUTINE
	DST;	P10TMP		/SAVE PASSED VALUE
	CAM			/CLEAN UP
	TAD	(P10BUF+6-1)	/SETUP THE
	DCA	P10PTR		/OUTPUT POINTER
	TAD	(-6)		/SETUP THE
	DCA	P10CNT		/OUTPUT COUNT
P10LUP,	TAD	P10TMP+1	/GET HIGH-ORDER
	MQL			/SETUP AS LOW-ORDER DIVIDEND
	DVI;	(12)		/DIVIDE BY TEN
	SWP			/GET QUOTIENT
	DCA	P10TMP+1	/SAVE AS NEW HIGH-ORDER
	TAD	P10TMP		/GET LOW-ORDER
	SWP			/NOW HAVE OLD REMAINDER.LOW-ORDER
	DVI;	(12)		/DIVIDE BY TEN
	DCA I	P10PTR		/STORE IN BUFFER
	MQA			/GET LOW-ORDER QUOTIENT
	DCA	P10TMP		/SAVE AS NEW LOW-ORDER
	NL7777			/BACKUP THE
	TAD	P10PTR		/OUTPUT POINTER
	DCA	P10PTR		/STORE BACK
	ISZ	P10CNT		/DONE SIX YET?
	JMP	P10LUP		/NO, KEEP GOING
	TAD	(P10BUF-1)	/YES, POINT AT
	DCA	XR1		/OUTPUT BUFFER
	TAD	(-6)		/SETUP THE
	DCA	P10CNT		/OUTPUT COUNTER
P10OTLP,TAD I	XR1		/GET A DIGIT
	TAD	("0&177)	/MAKE IT ASCII
	JMS I	[P7CH]		/PRINT IT
	ISZ	P10CNT		/DONE YET?
	JMP	P10OTLP		/NO, KEEP GOING
	JMP I	P10SIX		/YES, RETURN

P10BUF,	ZBLOCK	6		/OUTPUT BUFFER
P10CNT,	.-.			/OUTPUT COUNTER
P10PTR,	.-.			/OUTPUT POINTER
P10TMP,	ZBLOCK	2		/PASSED VALUE STORED HERE
/	ASK FOR RETRY ROUTINE.

ASKRETR,.-.			/ASK FOR RETRY ROUTINE
	JMS	SETFLD		/SETUP RETURN FIELD
	DCA	ASKXIT		/STORE IN-LINE
	CDF	PRGFLD		/GOTO OUR FIELD
	JMS I	[MESSAGE]	/ISSUE THE
	RETMSG			/RETRY MESSAGE
	JMS I	[YORNO]		/GET REPLY
	SKP			/YES, DON'T BUMP RETURN
	ISZ	ASKRETRY	/NO, BUMP RETURN ADDRESS
ASKXIT,	.-.			/WILL BE CIF CDF RETURN FIELD
	JMP I	ASKRETRY	/RETURN

/	UNIT PRINT ROUTINE.

PRTUNIT,.-.			/UNIT PRINTING ROUTINE
	TAD	(UNITABLE)	/ADD ON TABLE BASE TO PASSED VALUE
	DCA	TEMP		/SAVE THE POINTER
	JMS	SETFLD		/SETUP RETURN ADDRESS
	DCA	PRUXIT		/STORE IN-LINE
	CDF	PR2FLD		/GOTO TABLE FIELD
	TAD I	TEMP		/GET THE MESSAGE ADDRESS
	CDF	PRGFLD		/BACK TO OUR FIELD
	DCA	.+2		/STORE IN-LINE
	JMS I	[MESSAGE]	/CALL MESSAGE PRINTER
	.-.			/WITH PROPER ADDRESS
PRUXIT,	.-.			/WILL BE CIF CDF RETURN FIELD
	JMP I	PRTUNIT		/RETURN

/	READ CHECK ROUTINE.

RCHECK,	.-.			/READ CHECK AND RETRY ROUTINE
RCHAGN,	NL0000			/INDICATE READ
	CIF	PR2FLD		/GOTO CODE FIELD
	JMS I	(RDTRACK)	/CALL TRACK READ ROUTINE
	SNA CLA			/SKIP IF ERRORS
	JMP I	RCHECK		/ELSE JUST RETURN
	JMS I	[ERRMSG]	/COMPLAIN OF
	RCERMSG			/READ CHECK ERROR
	JMS I	[KLUDGE]	/UGH!
	JMS I	[ASKRETRY]	/RETRY?
	JMP	RCHAGN		/YES
	JMS I	(ERRBUMP)	/BUMP ERROR COUNT
	JMP I	RCHECK		/RETURN
