/	VARY QUICK CHECKOUT TEST PARAMETERS COMMAND COMES HERE.

QUVARY,	JMS I	[SETUP]		/SETUP RESTART ADDRESS
	JMS I	[MESAG2]	/ANNOUNCE OURSELVES
	QVMENU			/WITH OUR BLURB
QVAAGN,	CIF	PR2FLD		/GOTO CODE FIELD
	JMS I	[GETCOMMAND]	/GET OUR COMMAND
	QVFRST-1		/FIRST LETTER LIST-1
	QVFRST-QVSCND		/LENGTH OF LIST
