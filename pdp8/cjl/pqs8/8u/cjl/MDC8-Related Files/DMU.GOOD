	MQL			/STASH THEM FOR NOW
	LAS			/GET CONSOLE SWITCHES
	SPA CLA			/SKIP IF HIGH-ORDER OFF
	JMP	DOMID		/JUMP IF HIGH-ORDER ON
	TAD I	(OUTBLK+1)	/GET HIGH-ORDER INPUT BLOCK
	RTL;RTL;RTL		/MOVE UP LOW-ORDER HALF
	SKP			/DON'T USE OTHERS
DOMID,	TAD I	(OUTBLK)	/GET LOW-ORDER INPUT BLOCK
