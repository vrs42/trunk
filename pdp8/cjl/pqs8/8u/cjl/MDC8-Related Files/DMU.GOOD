/	SEEK LIMITS ROUTINE.

SEKLIM,	.-.			/SEEK LIMITS ROUTINE
	CDF	PRGFLD		/ENSURE CALLING FIELD
	NL0002			/SET FLEXIBLE/WINCHESTER DISK BIT
	AND I	[UNIT]		/GET THE BIT
	SNA CLA			/SKIP IF FLEXIBLE DRIVE
	JMP	WINLIM		/JUMP IF WINCHESTER DRIVE
	TAD I	(FLPFRM)	/GET FLEXIBLE DISK FORMAT DEFINITION WORD
	RAR			/SIDE BIT TO LINK
	SZL CLA			/SKIP IF SINGLE SIDED DISK
	JMP	IS2SIDED	/JUMP IF DOUBLE-SIDED DISK
	TAD	(17)		/GET UPDATE FACTOR FOR ONE SIDE
	MQL			/TO LOW-ORDER
	DST;	TRKUPDATE	/STORE UPDATE FACTOR
	DLD;	MFL1MAX		/GET ONE-SIDED FLEXIBLE DISK ADDRESS LIMIT
	JMP	LODMAX		/CONTINUE THERE

IS2SIDE,TAD	(17^2)		/GET UPDATE FACTOR FOR TWO-SIDED DISK
	MQL			/TO LOW-ORDER
	DST;	TRKUPDATE	/STORE UPDATE FACTOR
	DLD;	MFLMAX		/GET MAXIMUM FLEXIBLE DISK ADDRESS
	JMP	LODMAX		/CONTINUE THERE

WINVERI,DLD;	LOGMAX		/GET MAXIMUM LOGICAL ADDRESS IF VERIFYING POSITION
	DCM			/INVERT IT
	JMP	LODMAX		/CONTINUE THERE

WINLIM,	TAD	(-HEADS)	/SETUP THE
	DCA	BTRYCT		/HEADS COUNTER
	CAM			/CLEAN UP
WNLMLP,	DAD;	L21		/ADD ON TRACK UPDATE VALUE FOR ONE HEAD
	ISZ	BTRYCT		/DONE ALL YET?
	JMP	WNLMLP		/NO, GO BACK
	DST;	TRKUPDATE	/STORE UPDATE FACTOR
	CLA			/CLEAN UP
	TAD I	(SVSW)		/GET SEEK-VERIFY SWITCH
	SZA CLA			/SKIP IF NO VERIFYING
	JMP	WINVERIFY	/JUMP IF VERIFYING
	DLD;	MPMAX		/GET MAXIMUM WINCHESTER DISK ADDRESS
LODMAX,	DST;	UPLIM		/STORE DRIVE LIMIT
	DCM			/WANT POSITIVE FORM
	DST;	MUSTROKE	/INITIALIZE MAXIMUM UPSTROKE VALUE
	DLD;	TRKUPDATE	/GET TRACK UPDATE VALUE
	DCM			/NEGATE IT
	DST;	MUPDATE		/STORE AS NEGATIVE UPDATE
	CAM			/CLEAN UP
	CIF CDF	PRGFLD		/GOTO CALLING FIELD
	JMP I	SEKLIMITS	/RETURN

