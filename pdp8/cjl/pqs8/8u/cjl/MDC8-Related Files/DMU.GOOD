UNSAGN,	CIF	PR2FLD		/GOTO CODE FIELD
	JMS I	(RAND6);UNSEED	/GET A RANDOM UNIT
	AND	(3)		/JUST UNIT BITS
	DCA	UNIT		/STORE THE UNIT
	TAD	UNIT		/GET IT BACK
	CMA			/INVERT FOR COUNTING
	DCA	TEMP		/STORE THE COUNTER
	CLA STL			/INITIALIZE THE BIT
	RAL			/MOVE UP
	ISZ	TEMP		/MORE?
	JMP	.-2		/YES, KEEP GOING
	AND	EXWORD		/AND AGAINST ACTIVE UNIT WORD
	SNA CLA			/SKIP IF IT MATCHES AN ACTIVE UNIT
	JMP	UNSAGN		/ELSE GO GET ANOTHER UNIT
	JMS	BFCALCULATE	/CALCULATE BLOCK NUMBER, FUNCTION, ETC.
/	NL0000			/INDICATE ALL ZEROES DATA PATTERN FOR BULK OF DATA WORDS
	JMS I	(RWCHECK)	/GO WRITE AND READ BACK THE DATA
	ISZ	TRANS		/BUMP LOW-ORDER TRANSACTION NUMBER
	SKP			/SKIP IF NO OVERFLOW
	ISZ	TRANS+1		/ELSE BUMP HIGH-ORDER
	JMS I	[CHKUP]		/CHECK FOR <^P>, ETC.
	TAD	URSW		/GET <^R> SWITCH
	SNA CLA			/SKIP IF SET
	JMP	UNSAGN		/JUMP IF NOT
	DCA	URSW		/CLEAR <^R> SWITCH
	JMS I	[MESSAGE]	/TELL THEM
	ERMMSG			/REPORT HEADER
	DLD;	TRANS		/GET TRANSACTION COUNT
	JMS I	(P10SIX)	/PRINT IT
	JMS I	[MESSAGE]	/TELL THEM
	ER2MSG			/SECONDARY HEADER
	NL0001			/SETUP UNIT ZERO MASK
	AND	EXWORD		/GET THE BIT
	SZA CLA			/SKIP IF NOT BEING EXERCISED
	JMS I	(EXPRINT)	/PRINT UNIT ZERO REPORT
	NL0002			/SETUP UNIT ONE MASK
	AND	EXWORD		/GET THE BIT
	SNA CLA			/SKIP IF BEING EXERCISED
	JMP	EXUN2		/JUMP IF NOT
	NL0001			/SET UNIT ONE VALUE
	JMS I	(EXPRINT)	/PRINT UNIT ONE REPORT
EXUN2,	NL0004			/SETUP UNIT TWO MASK
	AND	EXWORD		/GET THE BIT
	SNA CLA			/SKIP IF BEING EXERCISED
	JMP	EXUN3		/JUMP IF NOT
	NL0002			/SET UNIT TWO VALUE
	JMS I	(EXPRINT)	/PRINT UNIT TWO REPORT
EXUN3,	TAD	EXWORD		/GET THE WORD
