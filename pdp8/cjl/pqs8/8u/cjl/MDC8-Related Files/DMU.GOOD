	SMA			/SKIP IF OK
	JMP I	(CPDONE)	/JUMP IF DONE
	CDF	PR2FLD		/BACK TO OUR FIELD
	DAD;	CUPDATE		/FIGURE IN LATEST UPDATE FACTOR
	SPA CLA			/SKIP IF NEAR THE END
	JMP	IOK		/JUMP IF NOT
	MQA			/GET LOW-ORDER
	CIA			/INVERT IT
	TAD	CUPDATE		/SHORTEN THE LENGTH
	DCA	CUPDATE		/STORE NEW VALUE
IOK,	TAD	CUPDATE		/GET UPDATE FACTOR
	CLL RTR;RTR;RTR		/MOVE OVER
	TAD	(DATFLD)	/ADD ON FIELD BITS
	CDF	PRGFLD		/GOTO CALLING FIELD
	TAD I	(INUNIT)	/ADD ON INPUT UNIT
	DCA	INFUN		/STORE IN-LINE
