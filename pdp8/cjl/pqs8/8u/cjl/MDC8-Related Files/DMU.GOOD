	CLL			/CLEAR LINK FOR TEST
	TAD	(14)		/ADD ON RANGE
	SNL			/SKIP IF OK
	JMP	DATBAD		/JUMP IF NOT
/	TAD	(-14)		/BIAS FOR REAL-TIME COUNTING
	DCA	MONCT		/SAVE AS MONTH COUNTER FOR LATER
