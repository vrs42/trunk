	TAD	EXCCDF		/GET BASE CDF INSTRUCTION
	DCA	EXCCDF		/STORE BACK
MSGLUP,	JMS	DATSETUP	/GOTO MESSAGE FIELD
	TAD I	MSGPTR		/GET A PAIR
	RTR;RTR;RTR		/MOVE HIGH-HALF TO LOW-ORDER BITS
	JMS	MSTRIM		/TRIM AND PRINT HIGH-ORDER
	JMS	DATSETUP	/GOTO MESSAGE FIELD
	TAD I	MSGPTR		/GET AGAIN
	JMS	MSTRIM		/TRIM AND PRINT LOW-ORDER
	ISZ	MSGPTR		/BUMP TO NEXT PAIR
	JMP	MSGLUP		/GO BACK FOR MORE

MESEND,	ISZ	MESSAGE		/BUMP PAST IN-LINE ARGUMENT
MESXIT,	.-.			/WILL BE CIF CDF RETURN FIELD
	JMP I	MESSAGE		/RETURN TO CALLER
MSTRIM,	.-.			/TRIM AND PRINT ROUTINE
	CDF	PRGFLD		/BACK TO OUR FIELD
	AND	(77)		/JUST SIX-BIT
	SNA			/END OF TEXT?
	JMP	MESEND		/YES, RETURN TO MAIN CALLER
	DCA	MSGTMP		/NO, SAVE IT
	TAD	MSGTMP		/GET IT BACK
	TAD	(-"%!200)	/COMPARE TO "%"
	SNA			/SKIP IF OTHER
	JMP	MSCRLF		/JUMP IF IT MATCHES
	TAD	(-"^+100+"%)	/COMPARE TO "^"
	SNA CLA			/SKIP IF OTHER
	JMP	CASFLP		/JUMP IF IT MATCHES
	TAD	MSGTMP		/GET THE CHARACTER
	AND	[40]		/JUST QUADRANT BIT
	SNA CLA			/SKIP IF SET
	TAD	MSGCASE		/ELSE ADD CURRENT CASE
	TAD	MSGTMP		/ANYWAY GET THE CHARACTER ITSELF
	JMS I	[P7CH]		/PRINT IT
	JMP I	MSTRIM		/RETURN

MSCRLF,	JMS I	[CRLF]		/DO A <CR>, <LF>
	JMP I	MSTRIM		/RETURN

CASFLP,	TAD	MSGCASE		/GET CURRENT CASE
	CIA			/INVERT
	TAD	(140+100)	/ADD SUM OF POSSIBLE VALUES
	DCA	MSGCASE		/SAVE IT BACK
	JMP I	MSTRIM		/RETURN

