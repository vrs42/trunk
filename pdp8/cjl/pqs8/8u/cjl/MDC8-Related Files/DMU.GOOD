/	GET SIX-DIGIT DECIMAL INPUT ROUTINE.

GETDEC,	.-.			/GET SIX-DIGIT NUMBER
GETOAGN,CDF	PRGFLD		/ENSURE CALLING FIELD
	TAD	(GETOAGN)	/SETUP THE
	DCA I	[UPURET]	/<^U> ADDRESS
	CDF	PR2FLD		/INDICATE OUR CALLING FIELD
	CIF	PRGFLD		/GOTO CODE FIELD
	JMS I	[MESSAGE]	/TELL THEM
	EODMSG			/TO ENTER THE DIGITS
	TAD	(-6)		/SETUP THE
	DCA	BTRYCT		/DIGIT COUNT
	CDF	PRGFLD		/GOTO CALLING FIELD
	DCA I	(TRACK)		/CLEAR
	DCA I	(TRACK+1)	/BUFFER
ODIGLP,	CDF	PR2FLD		/INDICATE OUR CALLING FIELD
	CIF	PRGFLD		/GOTO CODE FIELD
	JMS I	[TTYINC]	/GET A CHARACTER
	TAD	(-":!200)	/ADD ON LIMIT
	CLL			/CLEAR LINK FOR TEST
	TAD	(":-"0)		/ADD ON RANGE
	SNL			/SKIP IF OK
	JMP	DECBAD		/JUMP IF NOT
	CDF	PRGFLD		/GOTO CALLING FIELD
	MQL			/SETUP LATEST IN LOW-ORDER
	TAD	(-12)		/SETUP THE
	DCA	BTCNTR		/SHIFT COUNTER
	DAD;	TRACK		/ADD ON ACCUMULATION
	ISZ	BTCNTR		/DONE TEN YET?
	JMP	.-3		/NO, KEEP GOING
	DST;	TRACK		/YES, STORE NEW ACCUMULATION
	CAM			/CLEAN UP
	TAD I	[INCHAR]	/GET THE CHARACTER
	CDF	PR2FLD		/INDICATE OUR CALLING FIELD
	CIF	PRGFLD		/GOTO CODE FIELD
	JMS I	[P7CH]		/PRINT IT
	ISZ	BTRYCT		/DONE ALL DIGITS?
	JMP	ODIGLP		/NO, KEEP GOING
	CIF	PRGFLD		/YES, GOTO CODE FIELD
	JMS I	[CRLF]		/DO A <CR>, <LF>
	CIF CDF	PRGFLD		/GOTO CALLING FIELD
	JMP I	GETDEC		/RETURN

DECBAD,	CIF	PRGFLD		/GOTO CODE FIELD
	JMS I	[MESSAGE]	/COMPLAIN OF
	BOCMSG			/BAD DIGITS
	JMP	GETOAGN		/TRY AGAIN
/	DMA UNIT CHECK ROUTINE.

DMUCHK,	.-.			/DMA UNIT CHECK ROUTINE
	CDF	PRGFLD		/ENSURE CALLING FIELD
	TAD I	(DMAUNIT)	/GET DMA UNIT
	SMA CLA			/SKIP IF NONE EVER SET
	JMP	DMUOK		/JUMP IF OK
	CDF	PR2FLD		/INDICATE OUR CALLING FIELD
	CIF	PRGFLD		/GOTO CODE FIELD
	JMS I	[MESSAGE]	/TELL THEM
	DNIMSG			/NO DMA UNIT SET
DMUXIT,	CIF CDF	PRGFLD		/GOTO CALLING FIELD
	JMP I	DMUCHK		/RETURN IMMMEDIATELY

DMUOK,	TAD I	(DMAUNIT)	/GET SETUP UNIT
	DCA I	[UNIT]		/MAKE IT EVERYONE'S UNIT
	ISZ	DMUCHK		/BUMP RETURN
	JMP	DMUXIT		/TAKE SKIP RETURN TO CALLER

/	READ FLAW MAP TABLE ROUTINE.

RBTTBL,	.-.			/READ FLAW MAP
RBTAGN,	CDF	PRGFLD		/ENSURE CALLING FIELD
	TAD I	[UNIT]		/GET CURRENT UNIT
	TAD	(2^100+TBLFLD)	/FORM FUNCTION WORD
	DCA	RBTFUN		/STORE IN-LINE
	TAD	[-BTCNT]	/SETUP THE
	DCA	BTCNTR		/BLOCK COUNT
	DLD;	BTBLKINITIAL	/SETUP THE
	CDF	PR2FLD		/BACK TO OUR FIELD
	DST;	RWBLK		/INITIAL BAD TRACK TABLE BLOCK
RBTLP2,	NL7775			/SETUP THE
	DCA	BTRYCT		/RETRY COUNT
RBTLUP,	JMS I	[UPCHECK]	/CHECK FOR <^C>, ETC.
	CIF	PRGFLD		/GOTO CODE FIELD
	JMS I	[IOHAND]	/CALL THE HANDLER
	BTBUFFER		/TRANSFER ADDRESS
RBTFUN,	2^100+TBLFLD+.-.	/UNIT BITS WILL BE FILLED IN
	RWBLK			/RECORD POINTER
	SKP			/SKIP IF BAD
	JMP I	(VERTBL)	/JUMP IF OK
	ISZ	BTRYCT		/TOO MANY ERRORS?
	JMP	RBTLUP		/NO, TRY AGAIN
	NL0001			/SET INCREMENT
	MQL			/INTO LOW-ORDER
	DAD;	RWBLK		/ADD ON CURRENT
	DST;	RWBLK		/STORE IT BACK
	CDF	PRGFLD		/GOTO CALLING FIELD
	DST;	FBLK		/STORE FOR ERROR ROUTINE
	CDF	PR2FLD		/BACK TO OUR FIELD
	CAM			/CLEAN UP
	ISZ	BTCNTR		/TOO MANY ERRORS?
	JMP	RBTLP2		/NO, TRY AGAIN
	CIF	PRGFLD		/GOTO CODE FIELD
	JMS I	[ERRMSG]	/YES, COMPLAIN OF
	RBTMSG			/TABLE READ PROBLEMS
	CIF	PRGFLD		/GOTO CODE FIELD
	JMS I	[ASKRETRY]	/ASK FOR A RETRY
	JMP	RBTAGN		/TRY AGAIN
RBADXT,	NL7777			/SET BADNESS VALUE
RGUDXT,	CDF	PRGFLD		/GOTO CALLING FIELD
	DCA I	[TVSW]		/INDICATE BAD OR GOOD TABLE
	CAM			/CLEAN UP
	DST;	FBLK		/RESET FOR OTHERS
	CIF CDF	PRGFLD		/GOTO CALLING FIELD
	JMP I	RBTTBL		/RETURN

