/PDP-8/A ROM PRINTOUT PROGRAM

/	LAST EDIT:	11-MAR-1985	16:00:00	CJL

/	(C)	1982, 1985	CHARLES LASNER ASSOCIATES.

/	ASSEMBLY INSTRUCTIONS:

/	MUST BE ASSEMBLED WITH '/J' (OS/8 PAL8 '/F') SWITCH SET.

/	LOAD ACTUAL ROM BINARY INTO 001000-001177 (12-BIT CONTENTS),
/	AND 1200-1377 (FUNCTION CONTENTS IN LOW-ORDER 4 BITS).

/	FIRST TWO WORDS WILL BE USED AS IDENTIFIER IN PRINTOUT HEADER.
/	THEY WILL BE IGNORED AND ZERO SUBSTITUTED IN THE CONTENTS TO
/	CONFORM TO AUTO-RESTART CONVENTIONS WHICH DEMAND RESTART AT
/	000000 FOR COMPATIBILITY.
/	ASSEMBLY DEFINITIONS, ETC.

	DEP=	0002					/DEPOSIT BITS
	LA=	0010					/LOAD ADDRESS BITS
	LINES=	0040					/LINES PER PAGE
	LX=	0004					/LOAD EXTENDED ADDRESS BITS
	NL0001=	CLA IAC					/LOAD AC WITH 0001
	NL0003=	CLA CLL CML IAC RAL			/LOAD AC WITH 0003
	NL0006=	CLA CLL CML IAC RTL			/LOAD AC WITH 0006
	ROMBUFF=1000					/ROM CONTENTS HERE
	ROMFUN=	1200					/ROM FUNCTIONS HERE
	SBOOT=	7600					/MONITOR BOOTSTRAP
	ST=	0001					/START BITS

	IFNDEF	DEVCODE	<DEVCODE=65>			/USE DEVICE 65, 66 PRINTER

	IFNDEF	LKRB	<LKRB=	DEVCODE^10+6006>	/READ BUFFER, CLEAR FLAG
	IFNDEF	LKSF	<LKSF=	DEVCODE^10+6001>	/SKIP ON INPUT FLAG
	IFNDEF	LLS	<LLS=	DEVCODE+1^10+6006>	/LOAD LPT: SEQUENCE
	IFNDEF	LSF	<LSF=	DEVCODE+1^10+6001>	/SKIP ON LPT: FLAG
	PAGE	0		/START AT THE BEGINNING

	*20			/GET PAST AUTO-INDEX AREA

ADDRESS,.-.			/ADDRESS COUNTER
BINCNT,	.-.			/BINARY COUNTER
BINTMP,	.-.			/BINARY TEMPORARY
DIGIT,	.-.			/DIGIT TEMPORARY
DIGTMP,	.-.			/DIGIT TEMPORARY
F1,	.-.			/FUNCTION
F2,	.-.			/TEMPORARIES
	ZBLOCK	1		/THIS DELIMITS THE FUNCTION STRING
H1,	.-.			/HEADER
H2,	.-.			/TEMPORARIES
	ZBLOCK	1		/THIS DELIMITS HEADER
HEXTMP,	.-.			/HEX OUTPUT TEMPORARY
LINCNT,	.-.			/LINE COUNTER
OCNT,	.-.			/OCTAL DIGIT COUNTER
OTEMP,	.-.			/OCTAL OUTPUT TEMPORARY
PAGCNT,	.-.			/PAGE COUNTER
PCNT,	.-.			/<SPACE> COUNTER
PTEMP,	.-.			/PRINTER TEMPORARY
SCRPTR,	.-.			/SCRIBE POINTER
TEMP,	.-.			/TEMPORARY
WRDPTR,	.-.			/CONTENTS WORD POINTER
	PAGE

START,	LSF			/FLAG UP?
	LLS			/NO, SET IT
	LKRB			/CLEAR THE FLAG
	CLA			/CLEAR THE AC
	DCA	ADDRESS		/CLEAR RELATIVE ADDRESS
	TAD I	[ROMBUFFER]	/GET FIRST HEADER PAIR
	DCA	H1		/SAVE IT
	TAD I	[ROMBUFFER+1]	/GET SECOND HEADER PAIR
	DCA	H2		/SAVE IT
	DCA I	[ROMBUFFER]	/CLEAR FIRST PAIR
	DCA I	[ROMBUFFER+1]	/CLEAR SECOND PAIR
	DCA	PAGCNT		/CLEAR PAGE COUNTER
MANLUP,	TAD	[-LINES]	/SETUP THE
	DCA	LINCNT		/LINE COUNTER
	JMS I	[DOFF]		/DO A <FF>
	JMS I	[SCRIBE]	/PRINT INITIAL HEADER
	HEADER			/BEFORE ALL ELSE
	JMS I	[MESPRT]	/PRINT THE
	H1			/HEADER ID
	TAD	[33]		/GET HEADER SEPARATOR COUNT
	JMS I	[PSPACE]	/MOVE OVER
	JMS I	[MESPRT]	/PRINT OUT
	PAGBLB			/PAGE BLURB
	ISZ	PAGCNT		/BUMP TO NEXT PAGE
	TAD	PAGCNT		/GET PAGE COUNT
	TAD	["0&177]	/MAKE IT ASCII
	JMS I	[P7CH]		/PRINT IT
	JMS I	[CRLF]		/DO A <CR>, <LF>
	JMS I	[SCRIBE]	/PRINT OUT
	BLURB1			/FIRST BLURB
	JMS I	[SCRIBE]	/PRINT OUT
	BLURB2			/SECOND BLURB
	JMS I	[SCRIBE]	/PRINT OUT
	BLURB3			/THIRD BLURB
	JMS I	[CRLF]		/DO A <CR>, <LF>
LOOP,	NL0001			/SET MASK
	AND	ADDRESS		/JUST EVEN/ODD BIT
	SNA CLA			/SKIP IF ODD
	JMS I	[CRLF]		/ELSE DO A <CR>, <LF>
	JMS I	[PSPACE]	/PRINT INITIAL SEPARATOR
	TAD	ADDRESS		/GET CURRENT ADDRESS VALUE
	JMS I	[OCTPRT]	/PRINT IT IN OCTAL
	NL0003			/GET SEPARATOR COUNT
	JMS I	[PSPACE]	/PRINT SEPARATOR
	TAD	ADDRESS		/GET ADDRESS AGAIN
	JMS I	[HEXADR]	/PRINT IT IN HEXADECIMAL
	TAD	ADDRESS		/GET ADDRESS AGAIN
	CLL RAR			/%2
	TAD	[ROMBUFF]	/POINT TO CONTENTS WORD
	DCA	WRDPTR		/STASH THE POINTER
	TAD	[5]		/GET SEPARATOR SIZE
	JMS I	[PSPACE]	/PRINT THE SEPARATOR
	NL0001			/SET MASK
	AND	ADDRESS		/GET INDICATOR BIT
	SZA CLA			/SKIP IF EVEN ADDRESS
	JMP	ODDADR		/JUMP IF ODD ADDRESS
	TAD	ADDRESS		/GET ADDRESS
	CLL RAR			/%2
	TAD	[ROMFUN]	/POINT TO FUNCTION WORD
	DCA	TEMP		/STASH THE POINTER
	TAD I	TEMP		/GET THE WORD
	AND	[17]		/JUST FUNCTION BITS
	DCA	DIGIT		/SAVE IT
	TAD	DIGIT		/GET IT BACK
	JMS I	[HEXPRT]	/PRINT IT IN HEX
	JMS I	[PSPACE]	/PRINT THE SEPARATOR
	TAD	DIGIT		/GET IT AGAIN
	JMS I	[BIN4]		/PRINT IT IN BINARY
	TAD	[5]		/GET SEPARATOR SIZE
	JMS I	[PSPACE]	/PRINT THE SEPARATOR
	TAD I	WRDPTR		/GET THE WORD
	BSW;RTR			/MOVE TO LOW-ORDER
	DCA	DIGTMP		/SAVE IT
	TAD	DIGTMP		/GET IT BACK
	JMS I	[HEXPRT]	/PRINT IT IN HEX
	JMS I	[PSPACE]	/PRINT THE SEPARATOR
	TAD	DIGTMP		/GET IT AGAIN
	JMS I	[BIN4]		/PRINT IT IN BINARY
	TAD	[5]		/GET THE SEPARATOR SIZE
	JMS I	[PSPACE]	/PRINT THE SEPARATOR
	TAD	DIGIT		/GET FUNCTION DIGIT
	CLL RAL			/*2
	TAD	[FUNTBL]	/POINT AT FUNCTION STRING
	DCA	TEMP		/STASH THE POINTER
	TAD I	TEMP		/GET FIRST PAIR
	DCA	F1		/STORE IT
	ISZ	TEMP		/BUMP TO NEXT PAIR
	TAD I	TEMP		/GET SECOND PAIR
	DCA	F2		/STORE IT
	JMS I	[MESPRT]	/PRINT OUT
	F1			/THE FUNCTION STRING
	NL0006			/GET THE SEPARATOR SIZE
	JMS I	[PSPACE]	/PRINT THE SEPARATOR
	TAD I	WRDPTR		/GET THE CONTENTS WORD AGAIN
	JMS I	[OCTPRT]	/PRINT IT IN OCTAL
	JMP	PRTCOM		/CONTINUE THERE

ODDADR,	TAD I	WRDPTR		/GET THE CONTENTS WORD
	RTR;RTR			/MOVE OVER
	DCA	DIGIT		/SAVE IT
	TAD	DIGIT		/GET IT BACK
	JMS I	[HEXPRT]	/PRINT IT IN HEX
	JMS I	[PSPACE]	/PRINT THE SEPARATOR
	TAD	DIGIT		/GET IT AGAIN
	JMS I	[BIN4]		/PRINT IT IN BINARY
	TAD	[5]		/GET SEPARATOR SIZE
	JMS I	[PSPACE]	/PRINT THE SEPARATOR
	TAD I	WRDPTR		/GET THE CONTENTS WORD
	JMS I	[HEXPRT]	/PRINT IT IN HEX
	JMS I	[PSPACE]	/PRINT THE SEPARATOR
	TAD I	WRDPTR		/GET THE CONTENTS WORD
	JMS I	[BIN4]		/PRINT IT IN BINARY
PRTCOM,	ISZ	ADDRESS		/BUMP TO NEXT ADDRESS
	JMS I	[CRLF]		/DO A <CR>, <LF>
	TAD	ADDRESS		/GET ADDRESS
	TAD	[-400]		/COMPARE TO LIMIT
	SNA CLA			/SKIP IF OTHER
	JMP	ADREXIT		/JUMP IF AT END OF PRINTOUT
	ISZ	LINCNT		/DONE A PAGE YET?
	JMP	LOOP		/NO, KEEP GOING
	JMP	MANLUP		/GO DO NEXT PAGE

ADREXIT,JMS I	[DOFF]		/DO A <FF>
	JMP I	[SBOOT]		/YES, WE'RE DONE
	PAGE

DOFF,	.-.			/DO A <FF> ROUTINE
	TAD	[14]		/GET A <FF>
	JMS I	[P7CH]		/OUTPUT IT
	JMP I	DOFF		/RETURN

PSPACE,	.-.			/PRINT <SPACES> ROUTINE
	SNA			/COUNT PASSED?
	NL0001			/NO, ASSUME ONE
	CIA			/INVERT FOR COUNTING
	DCA	PCNT		/STASH THE COUNTER
PSPLUP,	TAD	[" &177]	/GET A <BLANK>
	JMS I	[P7CH]		/PRINT IT
	ISZ	PCNT		/DONE ENOUGH?
	JMP	PSPLUP		/NO, GO BACK
	JMP I	PSPACE		/YES, RETURN

MESPRT,	.-.			/MESSAGE PRINT ROUTINE
	TAD	MESPRT		/GET OUR HEADER
	DCA	SCRIBE		/MAKE IT THEIRS
	JMP	MESSIN		/CONTINUE THERE

SCRIBE,	.-.			/MESSAGE PRINT ROUTINE
	JMS I	[CRLF]		/DO A <CR>, <LF> NOW
MESSIN,	TAD I	SCRIBE		/GET MESSAGE POINTER
	DCA	SCRPTR		/STASH IT
	ISZ	SCRIBE		/BUMP PAST POINTER
SCRLUP,	TAD I	SCRPTR		/GET A PAIR
	BSW			/HIGH-ORDER FIRST
	JMS	SCTRIM		/PRINT IT
	TAD I	SCRPTR		/GET AGAIN
	JMS	SCTRIM		/PRINT LOW-ORDER
	ISZ	SCRPTR		/BUMP TO NEXT PAIR
	JMP	SCRLUP		/GO DO IT AGAIN

SCTRIM,	.-.			/TRIM AND PRINT ROUTINE
	AND	[77]		/JUST SIX-BIT
	SNA			/END OF MESSAGE?
	JMP I	SCRIBE		/YES, RETURN
	JMS I	[P6CH]		/NO, PRINT IT
	JMP I	SCTRIM		/RETURN FOR MORE

CRLF,	.-.			/<CR>, <LF> ROUTINE
	TAD	[15]		/GET A <CR>
	JMS I	[P7CH]		/PRINT IT
	TAD	[12]		/GET A <LF>
	JMS I	[P7CH]		/PRINT IT
	JMP I	CRLF		/RETURN
P6CH,	.-.			/SIX-BIT OUTPUT ROUTINE
	AND	[77]		/JUST SIX-BIT
	SNA			/PASSED VALUE?
	TAD	[40]		/NO, ASSUME ONE
	TAD	[40]		/INVERT THE BIT
	AND	[77]		/REMOVE CARRY
	TAD	[40]		/INVERT AGAIN
	JMS I	[P7CH]		/OUTPUT SEVEN-BIT
	JMP I	P6CH		/RETURN

HEXADR,	.-.			/HEX ADDRESS PRINT ROUTINE
	DCA	HEXTMP		/SAVE PASSED VALUE
	TAD	HEXTMP		/GET IT BACK
	RTR;RTR			/MOVE OVER
	JMS I	[HEXPRT]	/PRINT HIGH DIGIT
	TAD	HEXTMP		/GET IT AGAIN
	JMS I	[HEXPRT]	/PRINT LOW DIGIT
	JMP I	HEXADR		/RETURN

HEXPRT,	.-.			/HEX PRINT DIGIT ROUTINE
	AND	[17]		/JUST HEX BITS
	TAD	[-12]		/ADD ON LIMIT
	SMA			/SKIP IF A DIGIT
	TAD	["A-"0-12]	/ADD ON ALPHA FACTOR
	TAD	["0&177+12]	/MAKE INTO DIGIT
	JMS I	[P7CH]		/PRINT IT
	JMP I	HEXPRT		/RETURN

P7CH,	.-.			/OUTPUT ROUTINE
	DCA	PTEMP		/SAVE IT FOR NOW
P7LOOP,	LSF			/OUTPUT FLAG UP?
	JMP	TSTINP		/NO, TRY INPUT FLAG
	TAD	PTEMP		/GET THE CHARACTER
	LLS			/PRINT IT
	CLA			/CLEAN UP
	JMP I	P7CH		/RETURN

TSTINP,	LKSF			/INPUT FLAG UP?
	JMP	P7LOOP		/NO, TRY OUTPUT AGAIN
	LKRB			/YES, READ IT IN
	AND	[177]		/JUST SEVEN-BIT
	TAD	[-"S!300]	/IS IT <^S>?
	SZA CLA			/SKIP IF SO
	JMP	P7LOOP		/JUMP IF NOT
TSTAGN,	LKSF			/FLAG UP?
	JMP	TSTAGN		/NO, WAIT FOR IT
	LKRB			/READ IT IN
	AND	[177]		/JUST SEVEN-BIT
	TAD	[-"Q!300]	/IS IT <^Q>?
	SZA CLA			/SKIP IF SO
	JMP	TSTAGN		/ELSE KEEP WAITING
	JMP	P7LOOP		/OK TO PROCEED
OCTPRT,	.-.			/OCTAL PRINTOUT ROUTINE
	DCA	OTEMP		/SAVE THE VALUE
	TAD	[-4]		/SETUP THE
	DCA	OCNT		/DIGIT COUNTER
OLOOP,	TAD	OTEMP		/GET THE VALUE
	CLL RTL			/MOVE IT UP
	RAL			/THREE BITS
	DCA	OTEMP		/SAVE IT BACK
	TAD	OTEMP		/GET IT AGAIN
	RAL			/ADJUST IT
	AND	[7]		/JUST ONE DIGIT
	TAD	["0&77]		/MAKE IT ASCII
	JMS I	[P6CH]		/PRINT IT
	ISZ	OCNT		/DONE ALL YET?
	JMP	OLOOP		/NO, GO BACK
	JMP I	OCTPRT		/YES, RETURN

BIN4,	.-.			/4-BIT BINARY PRINT ROUTINE
	AND	[17]		/JUST 4-BIT
	BSW;CLL RTL		/DO INITIAL ADJUST
	DCA	BINTMP		/SAVE IT
	TAD	[-4]		/SETUP THE
	DCA	BINCNT		/BIT COUNTER
BINLUP,	JMS I	[PSPACE]	/PRINT A <SPACE>
	TAD	BINTMP		/GET CURRENT VALUE
	RAL			/SHIFT IT
	DCA	BINTMP		/STORE IT BACK
	RAL			/GET LATEST BIT
	TAD	["0&177]	/MAKE IT ASCII
	JMS I	[P7CH]		/PRINT IT
	ISZ	BINCNT		/DONE ALL YET?
	JMP	BINLUP		/NO, GO BACK
	JMP I	BIN4		/YES, RETURN
	PAGE

/	FUNCTION PRINTOUT TABLE.

FUNTBL,	TEXT	"****"		/0000 = NO FUNCTION
	TEXT	"  ST"		/0001 = ST
	TEXT	" DEP"		/0010 = DEP
	TEXT	"****"		/0011 = DEP, ST
	TEXT	" LXA"		/0100 = LX
	TEXT	"LX+S"		/0101 = LX, ST
	TEXT	"****"		/0110 = LX, DEP
	TEXT	"****"		/0111 = LX, DEP, ST
	TEXT	"  LA"		/1000 = LA
	TEXT	"LA+S"		/1001 = LA, ST
	TEXT	"****"		/1010 = LA, DEP
	TEXT	"****"		/1011 = LA, DEP, ST
	TEXT	"****"		/1100 = LA, LX
	TEXT	"****"		/1101 = LA, LX, ST
	TEXT	"****"		/1110 = LA, LX, DEP
	TEXT	"****"		/1111 = LA, LX, DEP, ST
BLURB1,	TEXT	"  ROM  ROM     CONTENTS       CONTENTS   FUNCTION  CONTENTS"
BLURB2,	TEXT	" ADDR ADDR     OF ROM 1       OF ROM 2";0
BLURB3,	TEXT	"OCTAL  HEX   HEX   BINARY   HEX   BINARY              OCTAL"
HEADER,	TEXT	"PDP-8/A ROM CONTENTS: ";0
PAGBLB,	TEXT	"PAGE "
	$			/HERE COME THE LITERALS!
