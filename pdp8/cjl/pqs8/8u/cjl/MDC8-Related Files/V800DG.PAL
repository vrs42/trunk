	XLIST	ON
	FOO=	.			/CURRENT ORIGIN SETTING

	IFNZRO	SBOOT-FOO&4000	<ERROR	.>

	FIELD	PR2FLD%10		/DUMP THE LITERALS NOW

	FIELD	DATFLD%10		/DATA STORAGE FIELD

/	THIS FIELD (AND THE TWO PAGES AFTER IT) ARE USED FOR DMA DATA.
	FIELD	TBLFLD%10		/TABLE FIELD

	*0				/START AT THE BEGINNING

	ZBLOCK	.+BLKSIZE-1&MBLKSIZE-.	/FORCE GOOD BOUNDARY

