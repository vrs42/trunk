/	I/O HANDLER FOR MDC8.

/	USAGE:

/	CDF	MYFLD		/SET CALLING DATA FIELD
/	CIF	PRGFLD		/SET HANDLER FIELD
/	JMS I	[IOHAND]	/CALL HANDLER
/	ADDRESS			/LOW-ORDER TRANSFER ADDRESS
/	FUNCTION		/FUNCTION WORD;SEE BELOW
/	POINTER			/POINTER TO I/O RECORD NUMBER;SEE BELOW
/	ERROR RETURN		/RETURNS HERE WITH AC=4000 IF ERROR
/	GOOD RETURN		/RETURNS HERE WITH AC=0000 IF OK

/	FUNCTION WORD:

/	BIT[0]:			READ/WRITE
/	BITS[1-5]:		PAGE COUNT
/	BITS[6-8]:		TRANSFER FIELD
/	BIT[9]:			UNUSED
/	BIT[10-11]:		LOGICAL UNIT ON MDC8

/	POINTER:

/	POINTER CONTAINS ADDRESS OF DOUBLE-WORD DISK RECORD NUMBER
/	IN DOUBLE-PRECISION EAE FORMAT (LOW, HIGH).
/	COMMAND TABLE DEFINITIONS.

/	WORD	1:	POSITIVE LENGTH OF ENTIRE TABLE IN WORDS.

/	WORD	2:	COMMAND TYPE (0000 FOR DISK READ/WRITE).

/	WORD	3:	COMMAND (0010:READ, 0012:WRITE).

/	WORD	4:	DRIVE CODE (0:WINCHESTER #1, 1:WINCHESTER #2
/			2:FLEXIBLE DISK #1, 3:FLEXIBLE DISK #2).

/	WORD	5:	CONTROL WORD (0:USE DEFAULTS;SEE BREAKDOWN.).

/	WORD	6:	HIGH-ORDER SIX BITS OF DISK ADDRESS.

/	WORD	7:	MIDDLE SIX BITS OF DISK ADDRESS.

/	WORD	8:	LOW-ORDER SIX BITS OF DISK ADDRESS.

/	WORD	9:	SECTOR COUNT (1-20 FOR OS/8;200 MAXIMUM).

/	WORD   10:	BANK AND FIELD (BANK:0000, FIELD:0-7 FOR OS/8).

/	WORD   11:	HIGH-ORDER SIX BITS OF MEMORY ADDRESS.

/	WORD   12:	LOW-ORDER SIX BITS OF MEMORY ADDRESS.

/	ALL WORDS IGNORE THE HIGH-ORDER FOUR BITS AND ARE SENT AS AN
/	EIGHT-BIT BYTE TO THE CONTROLLER.

/	ALL SIX-BIT ORIENTED WORDS IGNORE THE HIGH-ORDER TWO BITS OF THE
/	EIGHT-BIT BYTE.
/	CONTROL WORD BREAKDOWN.

/	BITS[0-3]:	IGNORED.

/	BIT   [4]:	0:DEFAULT CONTROLLER TO 0 0 0 0 1 0 0 0 X 0 1 X
/			EQUIVALENT PATTERN WITHIN THIS WORD.
/			1:READ OTHER BITS FOR NON-DEFAULT PATTERN.

/	BIT   [5]:	0:NO "FAST HANDSHAKE" MODE DURING BUFFERED TRANSFERS.
/			1:USE "FAST HANDSHAKE" MODE DURING BUFFERED TRANSFERS.

/	BIT   [6]:	0:USE LOGICAL DISK ADDRESSING.
/			1:USE PHYSICAL DISK ADDRESSING.

/	BIT   [7]:	0:ENABLE RETRIES.
/			1:DISABLE RETRIES.

/	BIT   [8]:	0:DISABLE ERROR CORRECTION ON FLOPPIES.
/			1:ENABLE ERROR CORRECTION ON FLOPPIES.
/			N. B. REVERSE IS TRUE FOR WINCHESTERS;DOES NOT APPLY TO DIRECT
/			READS.

/	BIT   [9]:	0:DISABLE WRITING OF DELETED DATA MARKS.
/			1:ENABLE WRITING OF DELETED DATA MARKS ON FLOPPIES ONLY.

/	BIT  [10]:	0:ENABLE BUFFERED TRANSFER.
/			1:DISABLE BUFFERED TRANSFER.

/	BIT  [11]:	0:DISABLE HALF-SECTOR READ ON FINAL SECTOR
/			1:ENABLE HALF-SECTOR READ ON FINAL SECTOR.
/			(CAUSES LAST READ TO BE A BUFFERED TRANSFER)
IOHAND,	.-.			/HANDLER ENTRY POINT
	CLA			/CLEAN UP
	RDF			/GET CALLING FIELD
	TAD	LCIF		/MAKE INTO CIF RETURN FIELD INSTRUCTION
	DCA	RETFLD		/STORE IN-LINE
	TAD I	IOHAND		/GET TRANSFER ADDRESS
	RTR;RTR;RTR		/MOVE DOWN
	DCA	TRADRHI		/STORE HIGH-ORDER HALF
	TAD I	IOHAND		/GET IT AGAIN
	DCA	TRADRLO		/STORE LOW-ORDER HALF
	ISZ	IOHAND		/BUMP TO FUNCTION WORD
	NL4000			/SET READ/WRITE MASK
	AND I	IOHAND		/GET READ/WRITE MASK
	CLL IAC RTL		/4 IF READING, 5 IF WRITING
	RAL			/10 IF READING, 12 IF WRITING
	DCA	RWCOM		/STORE AS COMMAND
	NL3777			/SETUP PAGE COUNT MASK
	AND I	IOHAND		/GET PAGE BITS (OTHERS DON'T MATTER)
	TAD	L100		/ROUND UP
	AND	[7600]		/JUST PAGE BITS
	SNA			/SKIP IF NOT MAXIMUM CALL
	NL4000			/ELSE SET MAXIMUM VALUE
	CLL RTL;RTL;RTL		/REDUCE TO SECTOR COUNT
	DCA	SCTCNT		/STASH IT
	TAD I	IOHAND		/GET FUNCTION WORD AGAIN
	AND	L100		/JUST HALF-SECTOR BIT
	SZA CLA			/SKIP IF OFF
	IAC			/ELSE SET HALF-SECTOR BIT
	TAD	L202		/GET NON-DEFAULT BITS
	DCA	DCONTROL	/STASH CONTROL WORD
	TAD I	IOHAND		/GET FUNCTION WORD AGAIN
	AND	L70		/JUST TRANSFER FIELD BITS
	CLL RTR;RAR		/MOVE OVER
	DCA	TRFLD		/SAVE IN BANK AND FIELD WORD
	NL0003			/SET UNIT MASK
	AND I	IOHAND		/GET LOGICAL UNIT BITS
	DCA	DRVUNT		/STORE IN DRIVE WORD
	RIF			/GET OUR FIELD
	CLL RTR;RAR		/MOVE OVER
	DSHI			/SETUP COMMAND FIELD
	ISZ	IOHAND		/BUMP TO RECORD POINTER
	TAD I	IOHAND		/GET RECORD POINTER
	DCA	IOTEMP		/STASH IT
	ISZ	IOHAND		/BUMP TO ERROR RETURN
	TAD I	IOTEMP		/GET LOW-ORDER PORTION OF DISK ADDRESS
	RTR;RTR;RTR		/MOVE OVER
	DCA	SECTMD		/STASH HIGH-ORDER HALF
	TAD I	IOTEMP		/GET LOW-ORDER PORTION AGAIN
	DCA	SECTLO		/STASH LOW-ORDER HALF
	ISZ	IOTEMP		/BUMP TO HIGH-ORDER PORTION
	TAD I	IOTEMP		/GET HIGH-ORDER PORTION
	DCA	SECTHI		/STASH IT
	TAD	L7700		/GET COUNTER VALUE
	DCA	IOTEMP		/STASH IT
	TAD	(TABLE)		/GET TABLE ADDRESS
	ISZ	IOTEMP		/WAIT
	JMP	.-1		/FOR AWHILE
	DSGO			/GO START IT UP
	DSSF			/FLAG UP?
	JMP	.-1		/NO, WAIT FOR IT
	DSCF			/YES, CLEAR THE FLAG
	AND I	0		/WASTE
	AND I	0		/SOME
	AND I	0		/TIME
LCIF,	CIF			/CIF CONSTANT
L100,	100			/CONSTANT 0100
L202,	202			/CONSTANT 0202
L70,	70			/CONSTANT 0070
L7700,	7700			/CONSTANT 7700
	DSRS			/GET THE RETURNED STATUS
	DCA	ERRTEMP		/SAVE IT
	TAD	ERRTEMP		/GET IT BACK
	SZA			/SKIP IF OK
	NL4000			/ELSE SET BAD VALUE
	SMA			/SKIP IF BAD
	ISZ	IOHAND		/ELSE BUMP RETURN ADDRESS
RETFLD,	.-.			/WILL BE CIF RETURN FIELD
	JMP I	IOHAND		/RETURN TO CALLER

/	COMMAND TABLE.

TABLE,	COMMEND-TABLE&377	/LENGTH OF WHOLE TABLE INCLUDING THIS WORD
COMTYPE,0&377			/COMMAND TYPE
RWCOM,	.-.&377			/0010 IF READING, 0012 IF WRITING
DRVUNT,	.-.&377			/0000 IF WINCHESTER DRIVE 0, 0001 IF WINCHESTER DRIVE 1
				/0002 IF FLEXIBLE DISK DRIVE 0
				/0003 IF FLEXIBLE DISK DRIVE 1
DCONTRL,.-.&377			/CONTROL WORD
SECTHI,	.-.&77			/DISK ADDRESS - HIGH-ORDER SIX BITS
SECTMD,	.-.&77			/DISK ADDRESS - MIDDLE SIX BITS
SECTLO,	.-.&77			/DISK ADDRESS - LOW-ORDER SIX BITS
SCTCNT,	.-.&377			/SECTOR COUNTER (1-20)
TRFLD,	.-.&377			/BANK (0000) AND TRANSFER FIELD (0-7)
TRADRHI,.-.&77			/TRANSFER ADDRESS - HIGH-ORDER SIX BITS
TRADRLO,.-.&77			/TRANSFER ADDRESS - LOW-ORDER SIX BITS

	COMMEND=.		/END OF COMMAND TABLE

IOTEMP,	.-.			/TEMPORARY
