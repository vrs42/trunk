TRCHEK,	.-.			/TRACK ADDRESS VALIDITY CHECKER
	TAD	TRACK+1		/GET HIGH-ORDER VALUE
	DCA	XDMQ		/SETUP LOW-ORDER DIVIDEND
	DCA	XDAC		/CLEAR HIGH-ORDER DIVIDEND
	NL0002			/SET UNIT MASK
	AND	UNIT		/ISOLATE FLEXIBLE DISK/WINCHESTER DISK BIT
/	SZA CLA			/SKIP IF WINCHESTER
/	NL0002/	TAD	(-17+21)/ELSE USE FLEXIBLE DISK OFFSET
	TAD	(-21)		/ADD ON COMMON PART
	DCA	XDVSOR		/STORE AS DIVISOR
	JMS	XDVI		/DIVIDE BY 17
	TAD	XDMQ		/GET QUOTIENT
	DCA	HIQUO		/SAVE IT
	TAD	TRACK		/GET LOW-ORDER VALUE
	DCA	XDMQ		/SAVE AS LOW-ORDER DIVIDEND
	JMS	XDVI		/DIVIDE BY 17
	TAD	XDMQ		/GET QUOTIENT
	DCA	LOQUO		/SAVE IT
	TAD	XDAC		/GET REMAINDER
	JMP I	TRCHEK		/RETURN

XDVI,	.-.			/DIVIDE ROUTINE
	TAD	(-14)		/SETUP THE
	DCA	XDSHCT		/SHIFT COUNT
XDVLUP,	TAD	XDMQ		/GET THE QUOTIENT
	CLL RAL			/MOVE OVER
	DCA	XDMQ		/STORE BACK
	TAD	XDAC		/GET REMAINDER
	RAL			/MOVE OVER
	DCA	XDAC		/STORE BACK
	TAD	XDAC		/GET IT AGAIN
	TAD	XDVSOR		/COMPARE TO DIVISOR
	SZL			/SKIP IF SMALLER
	DCA	XDAC		/ELSE STORE CORRECTED VALUE
	SZL CLA			/SKIP IF SMALLER
	ISZ	XDMQ		/BUMP QUOTIENT
	ISZ	XDSHCT		/DONE ALL YET?
	JMP	XDVLUP		/NO, GO BACK
	JMP I	XDVI		/YES, RETURN

HIQUO,	.-.			/HIGH-ORDER QUOTIENT
LOQUO,	.-.			/LOW-ORDER QUOTIENT
XDAC,	.-.			/DIVIDE AC
XDMQ,	.-.			/DIVIDE MQ
XDVSOR,				/DIVISOR
GETVALU,.-.			/GET A VALUE ROUTINE
	JMS	GETNMB		/GET A DIGIT
	DCA	TRCHEK		/SAVE IT
	TAD	INCHAR		/GET THE CHARACTER
	DCA	OLCHAR		/SAVE FOR OTHERS
	TAD	TRCHEK		/*1
	CLL RTL			/*4
	TAD	TRCHEK		/*5
	RAL			/*10
	DCA	TRCHEK		/SAVE IT
	DCA	GNSW		/CLEAR <CR> SWITCH
	JMS	GETNMB		/GET NEXT DIGIT
	TAD	TRCHEK		/FORM COMPOSITE
	JMP I	GETVALUE	/RETURN

XDSHCT,				/SHIFT COUNT
GETNMB,	.-.			/GET A NUMERIC ROUTINE
	SKP CLA			/DON'T COMPLAIN YET
NUMBAD,	JMS I	[BONG]		/BEEP AT THEM
	JMS I	[TTYINC]	/GET A CHARACTER
	TAD	(-72)		/ADD ON LIMIT
	CLL			/CLEAR LINK FOR TEST
	TAD	(12)		/ADD ON RANGE
	SNL			/SKIP IF VALID
	JMP	NUMTST		/JUMP IF NOT
	DCA	HIQUO		/SAVE VALID VALUE
	TAD	INCHAR		/GET LATEST CHARACTER
	DCA	LOQUO		/SAVE IT
	TAD	INCHAR		/GET IT AGAIN
	JMS I	[P7CH]		/PRINT IT
	TAD	LOQUO		/GET OLD VALUE
	DCA	INCHAR		/RESTORE IT FOR OTHERS
	TAD	HIQUO		/GET OUR VALUE
	JMP I	GETNMB		/RETURN

NUMTST,	CLA			/CLEAN UP
	TAD	GNSW		/GET <CR> SWITCH
	SNA CLA			/SKIP IF SET
	JMP	NUMBAD		/JUMP IF NOT
	TAD	INCHAR		/GET INPUT CHARACTER
	TAD	(-15)		/COMPARE TO <CR>
	SZA CLA			/SKIP IF IT MATCHES
	JMP	NUMBAD		/ELSE COMPLAIN
	DCA I	XR2		/INVALIDATE VALUE
	JMS I	[CRLF]		/DO A <CR>, <LF>
	JMP I	GNSW		/GO TO CALLER DIRECTLY

