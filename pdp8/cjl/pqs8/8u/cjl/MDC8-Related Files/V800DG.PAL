	KAVMSG			/AVAILABLE MEMORY MESSAGE
	JMP I	PRINTK		/RETURN

PK,	.-.			/PRINT SUPPRESS ROUTINE
	TAD	(-" !200)	/COMPARE TO <BLANK>
	SNA			/SKIP IF OTHERWISE
