DATASTA,.-.				/STATUS OF CURRENT DATA ON MEDIA ROUTINE
	DCA	DSSW			/SAVE ERROR MESSAGE SWITCH
	JMS I	[MESSAGE]		/GIVE OPENING STATUS MESSAGE
	STATMSG				/OF THIS DRIVE
	TAD	UNIT			/GET CURRENT UNIT
	JMS I	[PRTUNIT]		/PRINT IT
	TAD	(":&177)		/GET A ":"
	JMS I	[P7CH]			/PRINT IT
	DCA	FBLK			/CLEAR OUT THE
	DCA	FBLK+1			/TRACK NUMBER
	CIF	PR2FLD			/GOTO CODE FIELD
	JMS I	(RDTRACK)		/READ TRACK ZERO IN
	SNA CLA				/SKIP IF ERRORS
	JMP	DATAOK			/JUMP IF NONE
	ISZ	DSSW			/SKIP IF SPECIAL CALLER
	TAD	(CNTRMSG-CNTR2MSG)	/ELSE USE STANDARD MESSAGE
	TAD	(CNTR2MSG)		/GET SPECIAL MESSAGE ADDRESS AT LEAST
	DCA	DATINLINE		/STORE IN-LINE
	JMS I	[MESSAGE]		/TELL THEM
DATINLI,CNTRMSG/OR CNTR2MSG		/WE CAN'T READ IT
	NL4000				/SET BADNESS BIT
	JMP I	DATASTATUS		/RETURN

DATAOK,	NL7777				/SETUP THE
	DCA	XR1			/DATA POINTER
	NL0002				/SET UNIT MASK
	AND	UNIT			/JUST FLEXIBLE/WINCHESTER DISK BIT
	SZA CLA				/SKIP IF WINCHESTER DISK
	TAD	(-17^BLKSIZE)		/ELSE SET FLEXIBLE DISK LIMIT
	DCA	CMPCNT			/SET COMPARE COUNT
	CDF	DATFLD			/GOTO DATA FIELD
	TAD I	(5)			/GET A WORD
	CIA				/INVERT IT FOR TESTING
	DCA	TEMP			/STORE FOR LATER
DATALUP,TAD	XR1			/GET CURRENT POINTER
	AND	(BLKSIZE-1)		/JUST RELATIVE VALUE
	TAD	(-BLKSIZE+1)		/COMPARE TO DANGEROUS VALUE
	SZA CLA				/SKIP IF WEIRD VALUE
	JMP	DATACOM			/JUMP IF NOT
	TAD	XR1			/BUMP THE
	TAD	(5)			/POINTER PAST
	DCA	XR1			/THE PROBLEM
	TAD	CMPCNT			/BUMP THE
	TAD	(5)			/COUNTER PAST
	DCA	CMPCNT			/THE PROBLEM
DATACOM,TAD I	XR1		/GET A DATA WORD
	TAD	TEMP		/COMPARE TO PATTERN
	SZA CLA			/SKIP IF IT MATCHES
	JMP	DATAGOOD	/JUMP IF NOT
	ISZ	CMPCNT		/CHECKED ALL YET?
	JMP	DATALUP		/NO, GO BACK
	NL0002			/SET UNIT MASK
	AND	UNIT		/JUST WINCHESTER DISK BIT
	SZA CLA			/SKIP IF NOT DONE YET
	JMP	DATAPATTERN	/JUMP IF DONE
	TAD	(-1^BLKSIZE+5)	/SETUP
	DCA	CMPCNT		/EXTRA COMPARE
	NL0004/	TAD	(5-1)	/SETUP
	DCA	XR1		/DATA POINTER
	CDF	DATFLD+10	/GOTO NEXT FIELD
DAT2LUP,TAD I	XR1		/GET A DATA WORD
	TAD	TEMP		/COMPARE TO PATTERN
	SZA CLA			/SKIP IF IT MATCHES
	JMP	DATAGOOD	/JUMP IF NOT
	ISZ	CMPCNT		/CHECKED ALL YET?
	JMP	DAT2LUP		/NO, GO BACK
DATAPAT,CDF	PRGFLD		/BACK TO OUR FIELD
	JMS I	[MESSAGE]	/TELL THEM
	FPTNMSG			/FORMAT PATTERN IS ON DISK
/	NL0000			/INDICATE PATTERN
	JMP I	DATASTATUS	/RETURN

DATAGOO,CDF	PRGFLD		/BACK TO OUR FIELD
	JMS I	[MESSAGE]	/TELL THEM
	GDTMSG			/"GOOD" DATA IS HERE
	NL3777			/INDICATE DATA
	JMP I	DATASTATUS	/RETURN

DSSW,	.-.			/ERROR MESSAGE SWITCH

DMUCHK,	.-.			/DMA UNIT CHECK ROUTINE
	TAD	DMAUNIT		/GET DMA UNIT
	SMA CLA			/SKIP IF NONE EVER SET
	JMP	DMUOK		/JUMP IF OK
	JMS I	[MESSAGE]	/TELL THEM
	DNIMSG			/NO DMA UNIT SET
	JMP I	DMUCHK		/RETURN IMMMEDIATELY

DMUOK,	TAD	DMAUNIT		/GET SETUP UNIT
	DCA	UNIT		/MAKE IT EVERYONE'S UNIT
	ISZ	DMUCHK		/BUMP RETURN
	JMP I	DMUCHK		/TAKE SKIP RETURN TO CALLER
PRINTK,	.-.			/MEMORY CONFIGURATION PRINT ROUTINE
	JMS I	[CRLF]		/DO A <CR>, <LF>
	TAD I	(KL1)		/GET FIRST MEMORY DIGIT
	JMS	PK		/PRINT IT
	TAD I	(KL2)		/GET SECOND MEMORY DIGIT
	JMS	PK		/PRINT IT
	TAD I	(KL3)		/GET THIRD MEMORY DIGIT
	JMS	PK		/PRINT IT
	TAD I	(KL4)		/GET FOURTH MEMORY DIGIT
	JMS	PK		/PRINT IT
