DMATEST,.-.			/DMA TEST ROUTINE
	CAM			/INDICATE BUFFER 0
	DST;	FBLK		/CLEAR BLOCK NUMBER
	TAD	DMAPATTERN	/GET OUR PATTERN
	DCA	PATTERN		/USE FOR THIS RUN
	NL7777			/INDICATE ONE BUFFER ONLY
	JMS I	(BUFSETUP)	/SETUP VALID BUFFER
	MOVE;	PCRBUFF;PATBUFF	/MOVE PATTERN TO SAFE BUFFER
	JMS I	[CHKUP]		/CHECK FOR <^C>, ETC.
	DLD;	SAVBUFFER	/POINT AT SAVE BUFFER
	JMS I	(DMREAD)	/READ OLD DISK CONTENTS INTO SAVE BUFFER
	MOVE;	TSTBUFF;MSVBUFF	/SAVE OLD MEMORY CONTENTS
	MOVE;	PATBUFF;TSTBUFF	/MOVE TEST PATTERN INTO TEST BUFFER
	DLD;	TSTBUFFER	/POINT AT TEST BUFFER
	JMS I	(DMWRITE)	/WRITE OUT TEST PATTERN

/	CLEAR TEST BUFFER.

	TAD I	(TSTFLD)	/GET (BANK AND) FIELD
	RTL;RAL			/MOVE UP
	AND	(70)		/JUST FIELD BITS
	TAD	[CDF]		/TURN INTO CDF INSTRUCTION
	DCA	ZERCDF		/STORE IN-LINE
	NL7777			/BACKUP
	TAD I	(TSTBUFFER)	/GET ADDRESS
	DCA	XR1		/STASH THE CLEARING POINTER
	TAD	[-BLKSIZE]	/SETUP THE
	DCA	CNT		/CLEARING COUNT
ZERCDF,	.-.			/GOTO TEST FIELD
	DCA I	XR1		/CLEAR A WORD
	ISZ	CNT		/DONE YET?
	JMP	.-2		/NO, KEEP GOING
	CDF	PRGFLD		/YES, BACK TO OUR FIELD
	DLD;	TSTBUFFER	/POINT AT TEST BUFFER
	JMS I	(DMREAD)	/READ IN TEST PATTERN
	MOVE;	TSTBUFF;PCRBUFF	/MOVE IT BACK TO PATTERN BUFFER
	MOVE;	MSVBUFF;TSTBUFF	/RESTORE OLD MEMORY CONTENTS
	DLD;	SAVBUFFER	/POINT AT SAVE BUFFER
	JMS I	(DMWRITE)	/RESTORE OLD DISK CONTENTS FROM SAVE BUFFER
	JMS I	[CHKUP]		/CHECK FOR <^C>, ETC.

/	COMPARE TEST DATA TO ORIGINAL PATTERN.

	CAM			/INDICATE BUFFER 0
	NL7777			/INDICATE ONE BUFFER ONLY
	JMS I	(BUFVALIDATE)	/VALIDATE THE BUFFER
	ISZ	DMATEST		/BAD, TAKE SKIP RETURN
	JMP I	DMATEST		/RETURN EITHER WAY

DMTABLE,.-.			/DMA TABLE LOOKUP ROUTINE
	TAD I	(DMAPTR)	/GET CURRENT POINTER VALUE
	DCA	TEMP		/STASH IT
	CDF	TBLFLD		/GOTO TABLE FIELD
	TAD I	TEMP		/GET LATEST ENTRY
	CDF	PRGFLD		/BACK TO OUR FIELD
	CMA			/INVERT FOR TESTING
	SNA			/SKIP IF NOT AT END OF LIST
	JMP I	DMTABLE		/TAKE IMMEDIATE RETURN
	CMA			/INVERT BACK
	DCA I	(TSTBUFFER)	/SAVE AS TEST ADDRESS
	TAD I	(DMAPTR)	/GET POINTER VALUE
	TAD	(-DMATBL)	/REMOVE TABLE BASE VALUE
	DCA I	(TSTFLD)	/SAVE AS TEST FIELD (AND BANK)
	ISZ	DMTABLE		/BUMP RETURN ADDRESS
	JMP I	DMTABLE		/TAKE SKIP RETURN

/	SELECT TEST PATTERN COMMAND COMES HERE.

DTP,	JMS I	[SETUP]		/SETUP RESTART ADDRESS
	JMS I	[MESAG2]	/ANNOUNCE OURSELVES
	SCRN09			/WITH OUR BLURB
DTPAGN,	JMS I	[GETCOMMAND]	/GET OUR COMMAND
	DTFRST-1		/FIRST LETTER LIST-1
	DTFRST-DTSCND		/LENGTH OF LIST
	DTFINLST-1		/TEXT/DISPATCH LIST-1
/	ONES TEST PATTERN COMMAND COMES HERE.

ONEPAT,	TAD	(7777-5252)	/OFFSET NEXT VALUE

/	COMPLEMENT WORST CASE TEST PATTERN COMMAND COMES HERE.

COMPAT,	TAD	(5252)		/USE REVERSE OF WORST CASE VALUE
	SKP			/DON'T USE NEXT

/	WORST CASE TEST PATTERN COMMAND COMES HERE.

WRSPAT,	TAD	(2525)		/USE WORST CASE VALUE

/	ZEROES TEST PATTERN COMMAND COMES HERE.

ZERPAT,	DCA	DMAPATTERN	/STORE PATTERN VALUE
	JMP	DTPAGN		/KEEP GOING

/	VARY DIRECT MEMORY ACCESS PARAMETERS COMMAND COMES HERE.

VDP,	JMS I	[SETUP]		/SETUP RESTART ADDRESS
	JMS I	[MESAG2]	/ANNOUNCE OURSELVES
	SCRN08			/WITH OUR BLURB
VDPAGN,	JMS I	[GETCOMMAND]	/GET OUR COMMAND
	VDFRST-1		/FIRST LETTER LIST-1
	VDFRST-VDSCND		/LENGTH OF LIST
	VDFINLST-1		/TEXT/DISPATCH LIST-1

/	FLEXIBLE DISK THREE COMMAND COMES HERE.

DMA3,	IAC			/SET DRIVE THREE INCREMENT

/	FLEXIBLE DISK TWO COMMAND COMES HERE.

DMA2,	IAC			/SET DRIVE TWO INCREMENT

/	WINCHESTER DISK ONE COMMAND COMES HERE.

DMA1,	IAC			/SET DRIVE ONE INCREMENT

/	WINCHESTER DISK ZERO COMMAND COMES HERE.

DMA0,	DCA	UNIT		/STORE LOGICAL UNIT NUMBER
	JMS I	[GETREADY]	/GET THE SELECTED DRIVE READY
	DMTMSG			/FLEXIBLE DISK MESSAGE
	JMP	DMUNOK		/JUMP IF OK
	SNA CLA			/SKIP IF SERIOUS ERROR
	JMP	VDPAGN		/JUMP IF DRIVE WASN'T ENABLED
	JMP I	[FAIL]		/FORGET IT

DMUNOK,	TAD	UNIT		/GET THE UNIT
	DCA	DMAUNIT		/SETUP FOR OTHERS
	JMP	VDPAGN		/RETURN FOR MORE
