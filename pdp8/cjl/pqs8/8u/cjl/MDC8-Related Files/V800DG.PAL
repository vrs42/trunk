BUFSET,	.-.			/BUFFER SETUP ROUTINE
	DCA	CNT		/SAVE PASSED BUFFER COUNT
	MQA			/GET PASSED INITIAL BUFFER NUMBER
	DCA	BUFNUM		/SET IT UP
	JMS I	(MQRESTORE)	/RESTORE POSSIBLE OLD DISPLAY VALUE
BUFLUP,	JMS	BUFCOMMON	/DO COMMON SETUP
	TAD	FBLK		/GET LOW-ORDER BLOCK NUMBER
	DCA I	XR1		/STASH IT
	TAD	FBLK+1		/GET HIGH-ORDER BLOCK NUMBER
	DCA I	XR1		/STASH IT
	TAD	BUFNUM		/GET BUFFER NUMBER
	DCA I	XR1		/STASH IT
	TAD	TRANS		/GET LOW-ORDER TRANSACTION NUMBER
	DCA I	XR1		/STASH IT
	TAD	TRANS+1		/GET HIGH-ORDER TRANSACTION NUMBER
	DCA I	XR1		/STASH IT
	TAD	(-BLKSIZE+5)	/SETUP THE
	DCA	CMPCNT		/REMAINING COUNT
BUFFIL,	TAD	PATTERN		/GET DATA PATTERN
	DCA I	XR1		/STORE IT IN BUFFER
	ISZ	CMPCNT		/DONE ALL YET?
	JMP	BUFFIL		/NO, KEEP GOING
	CDF	PRGFLD		/BACK TO OUR FIELD
	ISZ	BUFNUM		/BUMP TO NEXT BUFFER
	ISZ	CNT		/DONE ALL YET?
	JMP	BUFLUP		/NO, GO BACK
	JMP I	BUFSETUP	/YES, RETURN

BUFCOMM,.-.			/COMMON BUFFER SETUP ROUTINE
	TAD	BUFNUM		/GET CURRENT BUFFER NUMBER
	CLL RTR;RTR;RAR		/MOVE OVER
	DCA	ADDRESS		/STORE HEAD OF BUFFER
	RTL;RTL			/GET FIELD OFFSET
	TAD	(CDF	DATFLD)	/FORM DATA FIELD INSTRUCTION
	DCA	EXCCDF		/STORE IN-LINE
	JMS	DATSETUP	/SET THE DATA FIELD
	NL7777			/BACKUP
	TAD	ADDRESS		/POINT AT BUFFER
	DCA	XR1		/STASH THE POINTER
	JMP I	BUFCOMMON	/RETURN
BUFVAL,	.-.			/BUFFER VALIDATE ROUTINE
	DCA	CNT		/SAVE PASSED COUNT
	MQA			/GET PASSED INITIAL BUFFER NUMBER
	DCA	BUFNUM		/SET IT UP
	JMS I	(MQRESTORE)	/RESTORE POSSIBLE DISPLAY MQ VALUE
	TAD	PATTERN		/GET DATA PATTERN
	CIA			/INVERT FOR TESTING
	DCA	BUFPATTERN	/SAVE IT FOR LATER
BUFVLP,	JMS	BUFCOMMON	/DO COMMON SETUP
	TAD I	XR1		/GET FIRST WORD
	CIA			/INVERT FOR TESTING
	TAD	FBLK		/COMPARE TO BLOCK NUMBER
	SZA CLA			/SKIP IF OK
	JMP	BUFBAD		/JUMP IF NOT
	TAD I	XR1		/GET SECOND WORD
	CIA			/INVERT FOR TESTING
	TAD	FBLK+1		/COMPARE TO BLOCK NUMBER
	SZA CLA			/SKIP IF OK
	JMP	BUFBAD		/JUMP IF NOT
	TAD I	XR1		/GET THIRD WORD
	CIA			/INVERT FOR TESTING
	TAD	BUFNUM		/COMPARE TO BUFFER NUMBER
	SZA CLA			/SKIP IF OK
	JMP	BUFBAD		/JUMP IF NOT
	TAD I	XR1		/GET FOURTH WORD
	CIA			/INVERT FOR TESTING
	TAD	TRANS		/COMPARE TO TRANSACTION NUMBER
	SZA CLA			/SKIP IF OK
	JMP	BUFBAD		/JUMP IF NOT
	TAD I	XR1		/GET FIFTH WORD
	CIA			/INVERT FOR TESTING
	TAD	TRANS+1		/COMPARE TO TRANSACTION NUMBER
	SZA CLA			/SKIP IF OK
	JMP	BUFBAD		/JUMP IF NOT
	TAD	(-BLKSIZE+5)	/SETUP THE
	DCA	CMPCNT		/REMAINING COUNT
CMPLUP,	TAD I	XR1		/GET A WORD
	TAD	BUFPATTERN	/COMPARE TO DESIRED
	SZA CLA			/SKIP IF OK
	JMP	BUFBAD		/JUMP IF NOT
	ISZ	CMPCNT		/DONE ALL YET?
	JMP	CMPLUP		/NO, KEEP GOING
	ISZ	BUFNUM		/BUMP TO NEXT BUFFER
	ISZ	CNT		/DONE ALL BUFFERS?
	JMP	BUFVLP		/NO, KEEP GOING
	ISZ	BUFVALIDATE	/BUMP TO GOOD RETURN
BUFBAD,	CDF	PRGFLD		/BACK TO OUR FIELD
	JMP I	BUFVALIDATE	/RETURN EITHER WAY

BUFPATT,.-.			/BUFFER PATTERN WORD
RSETUP,	.-.			/READ SETUP ROUTINE
	CAM			/CLEAN UP
	DST;	FBLK		/CLEAR BLOCK NUMBER
	DCA	TRACK		/CLEAR DISPLAY TRACK
	DCA	ERSW		/CLEAR ERROR SWITCH
	JMS I	(FLXSETUP)	/SETUP FLEXIBLE DISK COUNT
	JMP I	RSETUP		/RETURN

