GETREAD,.-.			/GET UNIT READY ROUTINE
	TAD I	GETREADY	/GET PASSED ARGUMENT
	DCA	GETARG		/STORE IN-LINE
	ISZ	GETREADY	/BUMP PAST
GETOK,	JMS I	[MOUNT]		/GET FLEXIBLE DISK MOUNTED
GETARG,	.-.			/PASSED MESSAGE ARGUMENT
	CIF	PR2FLD		/GOTO CODE FIELD
	JMS I	(TSTREADY)	/TEST IF CURRENT DRIVE IS READY
	SNA			/SKIP IF PROBLEMATIC
	JMP	GREADY		/JUMP IF OK
	AND	(777)		/ISOLATE ERROR CODE
	TAD	[-4]		/COMPARE TO DRIVE READY ERROR
	SNA			/SKIP IF OTHER THAN READY ERROR
	JMP	GRETRY		/TRY AGAIN IF NOT READY ERROR
	TAD	(-304+4)	/COMPARE TO DRIVE NOT ENABLED ERROR
	SNA CLA			/SKIP IF NONE OF THE ABOVE
	JMP	GDNERROR	/JUMP IF DRIVE NOT ENABLED ERROR
	JMS I	[ERRMSG]	/TELL THEM
	RERRMSG			/THE BAD NEWS
	JMP I	[AGAIN]		/GOODBYE

GRETRY,	JMS I	[MESSAGE]	/TELL THEM
	NRDYMSG			/DRIVE IS NOT READY
	JMS I	[ASKRETRY]	/ASK FOR A RETRY
	JMP	GETOK		/TRY AGAIN
	NL7777			/SET READY FAILURE
	JMP	GETBAD		/RETURN WITH FAILURE AC SET

GDNERRO,JMS I	[MESSAGE]	/TELL THEM
	DNEMSG			/DRIVE NOT ENABLED
GETBAD,	ISZ	GETREADY	/BUMP TO FAILURE RETURN
	JMP I	GETREADY	/RETURN WITH AC SET AS NECESSARY

GREADY,	JMS I	[MESSAGE]	/TELL THEM
	ISRMSG			/DRIVE IS READY
	JMP I	GETREADY	/RETURN FOR MORE
FLXSET,	.-.			/SET FLEXIBLE DISK TRACK COUNT
	TAD	(-FLXTRKS)	/SETUP BASIC TRACK COUNT
	DCA	TRKCNT		/STORE LOW-ORDER COUNT
	NL7777			/SET EXTENSION BITS
	DCA	TRKCNHI		/STORE HIGH-ORDER COUNT
	JMP I	FLXSET		/RETURN

TBUMP,	.-.			/TRACK BUMP ROUTINE
	ISZ	TRACK		/BUMP IT NOW
	JMP I	TBUMP		/RETURN
	ISZ	TRACK+1		/BUMP HIGH-ORDER
	JMP I	TBUMP		/RETURN

TRUPDAT,.-.			/TRACK UPDATE FACTOR ROUTINE
	CLA			/JUST IN CASE
	TAD	(20)		/GET BASIC UPDATE VALUE
	MQL			/INTO MQ
	JMP I	TRUPDATE	/RETURN

ERROUT,	.-.			/ERROR REPORTING ROUTINE
	TAD	ERSW		/GET PRIMARY ERROR SWITCH
	SNA CLA			/SKIP IF ANY PRIMARY ERRORS
	JMP	ERRCLEAN	/JUMP IF NONE
	JMS I	[MESSAGE]	/TELL THEM
	ERPMSG			/THEY GOT PRIMARY ERRORS
	JMP I	ERROUT		/RETURN

ERRCLEA,JMS I	[MESSAGE]	/TELL THEM
	ROKMSG			/READ IS OK
	JMP I	ERROUT		/RETURN

SEEK,	.-.			/SEEK ROUTINE
	DST;	FBLK		/STORE PASSED LOGICAL DISK ADDRESS
SEKAGN,	CIF	PR2FLD		/GOTO PROGRAM FIELD
	JMS I	(SEKTRK)	/GO SEEK
	SNA CLA			/SKIP IF ANY ERRORS
	JMP I	SEEK		/RETURN IF NONE
	JMS I	[ERRMSG]	/COMPLAIN OF
	SKERMSG			/SEEK ERROR
	JMS I	[KLUDGE]	/UGH!
	JMS I	[ASKRETRY]	/ASK FOR A RETRY
	JMP	SEKAGN		/TRY AGAIN
	JMP I	[FAIL]		/FORGET IT

