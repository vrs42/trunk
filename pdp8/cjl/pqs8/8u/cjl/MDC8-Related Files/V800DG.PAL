	JMS I	[MESSAGE]	/CALL MESSAGE PRINTER
	.-.			/WILL BE THEIR ADDRESS
	TAD	ERRTEMP		/GET ERROR STATUS
	RTL;RTL			/MOVE OVER
	AND	(3)		/JUST UNIT BITS
	SNA			/SKIP IF ANY
	TAD	UNIT		/ELSE USE LOGICAL UNIT
	JMS I	(PRTUNIT)	/GO PRINT IT
	JMS I	[MESSAGE]	/PRINT THE
	PNTMSG			/TRAILING MESSAGE
	ISZ	ERRMSG		/BUMP PAST ARGUMENT
	TAD	ERRTEMP		/GET ERROR CODE
	RTR;RTR;RTR		/MOVE DOWN FIRST DIGIT
	JMS	ODPRT		/PRINT IT
	TAD	ERRTEMP		/GET ERROR CODE AGAIN
	RTR;RAR			/MOVE DOWN SECOND DIGIT
	JMS	ODPRT		/PRINT IT
	TAD	ERRTEMP		/GET ERROR CODE AGAIN
	JMS	ODPRT		/PRINT THIRD DIGIT
	JMS I	[MESSAGE]	/PRINT THE
	DSADMSG			/BRIDGING MESSAGE
	DLD;	FBLK		/GET THE CURRENT BLOCK
	JMS I	(P10SIX)	/PRINT IT
	JMS I	[CRLF]		/DO A <CR>, <LF>
	JMP I	ERRMSG		/RETURN

AGAIN,	JMS I	[WAITOK]	/TELL THEM
	PRSMSG			/TO PRESS SOMETHING
	JMP I	(RESTART)	/RESTART

ODPRT,	.-.			/OCTAL DIGIT PRINT ROUTINE
	AND	(7)		/JUST ONE DIGIT
	TAD	("0&177)	/MAKE IT ASCII
	JMS I	[P7CH]		/PRINT IT
	JMP I	ODPRT		/RETURN
MQSAVE,	.-.			/DISPLAY MQ SAVE ROUTINE
	CLA MQA			/GET MQ
	DCA	MQHOLD		/SAVE IT
	JMP I	MQSAVE		/RETURN

MQRESTO,.-.			/DISPLAY MQ RESTORE ROUTINE
	SWP			/SAVE CURRENT AC
	CLA			/THROW AWAY CURRENT MQ
	TAD	MQHOLD		/RESTORE PREVIOUS VALUE
	SWP			/BACK WHERE WE BELONG
	JMP I	MQRESTORE	/RETURN

MQHOLD,	.-.			/MQ SAVED HERE

WAITOK,	.-.			/MESSAGE PRINT AND WAIT FOR OK RESPONSE ROUTINE
	DCA	TEMP		/SAVE PASSED ARGUMENT
	TAD I	WAITOK		/GET IN-LINE ARGUMENT
	DCA	WATARG		/STORE IN-LINE
	ISZ	WAITOK		/BUMP PAST ARGUMENT
	TAD	TEMP		/RESTORE PASSED ARGUMENT
	JMS I	[MESSAGE]	/GIVE THEM
WATARG,	.-.			/THE PASSED BLURB
	JMS I	[TTYIN]		/GET ANY RESPONSE
	JMS I	[MESSAGE]	/TELL THEM
	MSGOK			/ALL IS OK
	JMP I	WAITOK		/RETURN

/	GET RID OF THIS ASAP!!!!

KLUDGE,	.-.			/KLUDGE TO GET THE DUMB THING TO WORK!
	TAD	(2^100+60)	/GET A GOOD NUMBER
	TAD	UNIT		/ADD ON KNOWN QUANTITY UNIT
	DCA	KLFUN		/STORE IN-LINE
	NL7775			/SETUP THE
	DCA	KLUCNT		/KLUDGE COUNT
	TAD	ERRTEMP		/GET CURRENT ERROR VALUE
	DCA	KLUTMP		/SAVE IT
KLULUP,	JMS I	[IOHAND]	/CALL HANDLER
	0000			/TRANSFER ADDRESS
KLFUN,	2^100+60+.-.		/UNIT BITS WILL BE FILLED IN
	K0			/POINTER TO BLOCK
	CLA			/THROW AWAY ERRORS!
	ISZ	KLUCNT		/DONE ENOUGH?
	JMP	KLULUP		/NO, KEEP GOING
	TAD	KLUTMP		/GET OLD ERROR STATUS
	DCA	ERRTEMP		/RESTORE IT
	JMP I	KLUDGE		/YES, RETURN

KLUCNT,	.-.			/TEMPORARY
KLUTMP,	.-.			/TEMPORARY FOR ERROR STATUS
K0,	0;	0		/POINTER TO RECORD ZERO
	PAGE
RCHECK,	.-.				/READ CHECK AND RETRY ROUTINE
RCHAGN,	NL0000				/INDICATE READ
	CIF	PR2FLD			/GOTO CODE FIELD
	JMS I	(RDTRACK)		/CALL TRACK READ ROUTINE
	SNA CLA				/SKIP IF ERRORS
	JMP I	RCHECK			/ELSE JUST RETURN
	JMS I	[ERRMSG]		/COMPLAIN OF
	RCERMSG				/READ CHECK ERROR
	JMS I	[KLUDGE]		/UGH!
	JMS I	[ASKRETRY]		/RETRY?
	JMP	RCHAGN			/YES
	JMS	ERRBUMP			/BUMP ERROR COUNT
	JMP I	RCHECK			/RETURN

RWCHECK,.-.				/WRITE/READ CHECK ROUTINE
	DCA	PATTERN			/SETUP PASSED DATA PATTERN VALUE
RWCHAGN,JMS I	(MQSAVE)		/SAVE CURRENT DISPLAY MQ
/	NL0000				/INDICATE INITIAL BUFFER NUMBER
	MQL				/PASSED IN MQ
	TAD	SECTCNT			/GET BUFFER LENGTH
	JMS I	(BUFSETUP)		/FORMAT THE BUFFER
	JMS I	(MQRESTORE)		/RESTORE DISPLAY MQ
	NL0002/	TAD	(WRITFN-READFN)	/INDICATE WRITE
	CIF	PR2FLD			/GOTO CODE FIELD
	JMS I	(RDSECTORS)		/GO WRITE A TRACK
	SNA CLA				/SKIP IF ANY ERRORS
	JMP	RWWROK			/JUMP IF OK
	TAD	EXSW			/GET EXERCISER SWITCH
	SNA CLA				/SKIP IF CALLED FROM EXERCISER
	JMP	WENORMAL		/JUMP IF OTHERWISE
	TAD	(W0ERRLO-14-1)		/POINT AT WRITE ERROR
RWXXIT,	TAD	UNIT			/*1
	TAD	UNIT			/*2
	TAD	UNIT			/*3
	TAD	UNIT			/*4
	TAD	UNIT			/*5
	TAD	UNIT			/*6
	DCA	XR1			/STASH THE ERROR POINTER
	ISZ I	XR1			/BUMP LOW-ORDER
	SKP				/SKIP IF NO OVERFLOW
	ISZ I	XR1			/ELSE BUMP HIGH-ORDER
	JMP	RWCEXT			/FORGET IT

WENORMA,JMS I	[ERRMSG]		/COMPLAIN OF
	WCERMSG				/WRITE ERROR
RWBCOMM,JMS I	[KLUDGE]		/UGH!
	JMS I	[ASKRETRY]		/RETRY?
	JMP	RWCHAGN			/YES
	JMS	BUMPERRORS		/BUMP ERROR COUNT
	JMP I	RWCHECK			/RETURN
RWWROK,/NL0000			/INDICATE READ
	CIF	PR2FLD		/GOTO CODE FIELD
	JMS I	(RDSECTORS)	/READ IT BACK IN
	SNA CLA			/SKIP IF ANY ERRORS
	JMP	RWRDOK		/JUMP IF OK
	TAD	EXSW		/GET EXERCISER SWITCH
	SNA CLA			/SKIP IF CALLED FROM EXERCISER
	JMP	RENORMAL	/JUMP IF OTHERWISE
	TAD	(R0ERRLO-14-1)	/POINT AT READ ERROR
	JMP	RWXXIT		/FINISH IT THERE

RENORMA,JMS I	[ERRMSG]	/COMPLAIN OF
	RCERMSG			/READ ERROR
	JMP	RWBCOMMON	/CONTINUE THERE

RWRDOK,	TAD	UNIT		/GET CURRENT UNIT
	CLL RTR;RTR		/MOVE OVER
	DCA	ERRTEMP		/SAVE IN CASE OF COMPARE ERROR
	JMS I	(MQSAVE)	/SAVE DISPLAY MQ
/	NL0000			/INDICATE INITIAL BUFFER VALUE
	MQL			/PASSED IN MQ
	TAD	SECTCNT		/GET BUFFER LENGTH
	JMS I	(BUFVALIDATE)	/VALIDATE READ
	JMP	RWRDBAD		/JUMP IF BAD
RWCEXT,	JMS I	(MQRESTORE)	/RESTORE DISPLAY MQ
	JMP I	RWCHECK		/RETURN

RWRDBAD,TAD	EXSW		/GET EXERCISER SWITCH
	SNA CLA			/SKIP IF CALLED FROM EXERCISER
	JMP	CENORMAL	/JUMP IF OTHERWISE
	TAD	(C0ERRLO-14-1)	/POINT AT COMPARE ERROR
	JMP	RWXXIT		/FINISH IT THERE

CENORMA,JMS I	(MQRESTORE)	/RESTORE DISPLAY MQ
	JMS I	[ERRMSG]	/COMPLAIN OF
	CMEMSG			/COMPARE ERROR
	JMP	RWBCOMMON	/CONTINUE THERE

BUMPERR,.-.			/ERROR SWITCH BUMPING ROUTINE
BUMPAGN,ISZ	ERSW		/BUMP IT IN THE SIMPLE CASE
	JMP I	BUMPERRORS	/JUST RETURN
	NL7776			/RESET THE
	DCA	ERSW		/SWITCH
	JMP	BUMPAGN		/TRY AGAIN

ERRBUMP,.-.			/ERROR BUMPING ROUTINE
REGERR,	JMS	BUMPERRORS	/BUMP NORMAL ERROR COUNT
	JMP I	ERRBUMP		/RETURN
/	DMA BUFFER READ ROUTINE (ACTUALLY DISK READ ROUTINE.)

DMREAD,	.-.				/DMA READ ROUTINE
	DST;	DMADDRESS		/STORE PASSED ADDRESS
DMRAGN,	NL0000				/INDICATE READ
	CIF	PR2FLD			/GOTO CODE FIELD
	JMS I	(DMEMPTY)		/CALL EMPTY ROUTINE
	SNA CLA				/SKIP IF PROBLEMS
	JMP I	DMREAD			/ELSE RETURN
	JMS I	[ERRMSG]		/TELL THEM
	RCERMSG				/OF ERROR
	JMS I	[KLUDGE]		/UGH!
	JMS I	[ASKRETRY]		/ASK FOR A RETRY
	JMP	DMRAGN			/TRY AGAIN
	JMP I	[FAIL]			/FORGET IT

/	DMA BUFFFER WRITE ROUTINE (ACTUALLY DISK WRITE ROUTINE.)

DMWRITE,.-.				/DMA WRITE ROUTINE
	DST;	DMADDRESS		/STORE PASSED ADDRESS
DMWAGN,	NL0002/	TAD	(WRITFN-READFN)	/INDICATE WRITE
	CIF	PR2FLD			/GOTO CODE FIELD
	JMS I	(DMEMPTY)		/CALL FILL ROUTINE
	SNA CLA				/SKIP IF PROBLEMS
	JMP I	DMWRITE			/ELSE RETURN
	JMS I	[ERRMSG]		/TELL THEM
	WCERMSG				/OF ERROR
	JMS I	[KLUDGE]		/UGH!
	JMS I	[ASKRETRY]		/ASK FOR A RETRY
	JMP	DMWAGN			/TRY AGAIN
	JMP I	[FAIL]			/FORGET IT

