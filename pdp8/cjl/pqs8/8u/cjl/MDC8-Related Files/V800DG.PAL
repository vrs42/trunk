	SZA CLA			/SKIP IF IT MATCHES
	JMP	EXFIXIT		/JUMP IF NOT
	JMS I	[MESSAGE]	/TELL THEM
	ERMMSG			/REPORT HEADER
	DLD;	TRANS		/GET TRANSACTION COUNT
	JMS I	(P10SIX)	/PRINT IT
	JMS I	[MESSAGE]	/TELL THEM
	ER2MSG			/SECONDARY HEADER
	NL0001			/SETUP UNIT ZERO MASK
	AND	EXWORD		/GET THE BIT
	SZA CLA			/SKIP IF NOT BEING EXERCISED
	JMS I	(EXPRINT)	/PRINT UNIT ZERO REPORT
	NL0002			/SETUP UNIT ONE MASK
	AND	EXWORD		/GET THE BIT
	SNA CLA			/SKIP IF BEING EXERCISED
	JMP	UNSAGN		/JUMP IF NOT
	NL0001			/SET UNIT ONE VALUE
	JMS I	(EXPRINT)	/PRINT UNIT ONE REPORT
	JMP	UNSAGN		/KEEP GOING

EXFIXIT,TAD	(UNSAGN)	/GET NEXT ADDRESS
	DCA I	[CHKUP]		/SETUP PHONEY CALL
	TAD	INCHAR		/GET LATEST CHARACTER
	JMP I	(CHKUP+2)	/CONTINUE THERE

EXCNT,	.-.			/EXERCISER SECTOR COUNT

	PAGE
EXPRINT,.-.			/UNIT REPORT ROUTINE
	DCA	EXMOUNT		/SAVE PASSED UNIT INDICATOR
	NL7776			/GET INITIAL SPACE COUNT
	JMS	PBLANK		/PRINT SOME SPACES
	TAD	("F&177)	/GET AN "F"
	JMS I	[P7CH]		/PRINT IT
	TAD	EXMOUNT		/GET THE UNIT BACK
	JMS I	(ODPRT)		/PRINT IT
	TAD	EXMOUNT		/GET UNIT AGAIN
	CLL RAL			/*2
	TAD	EXMOUNT		/*3
	RAL			/*6
	TAD	(R0ERRLO-1)	/POINT TO COUNT TABLE
	DCA	XR2		/STASH THE POINTER
	TAD	(-6)		/GET SPACE COUNT
	JMS	EXOUT		/PRINT READ ERROR COUNT
	TAD	(-7)		/GET SPACE COUNT
	JMS	EXOUT		/PRINT WRITE ERROR COUNT
	TAD	(-11)		/GET SPACE COUNT
	JMS	EXOUT		/PRINT COMPARE ERROR COUNT
	JMS I	[CRLF]		/DO A <CR>, <LF>
	JMP I	EXPRINT		/RETURN

EXOUT,	.-.			/PRINT OUTPUT ROUTINE
	JMS	PBLANK		/PRINT PASSED NUMBER OF <SPACE> CHARACTERS
	TAD I	XR2		/GET LOW-ORDER
	MQL			/LOAD IT
	TAD I	XR2		/GET HIGH-ORDER
	JMS I	(P10SIX)	/PRINT THE VALUE
	JMP I	EXOUT		/RETURN

PBLANK,	.-.			/<SPACE> PRINTING ROUTINE
	DCA	CNT		/SAVE PASSED COUNT
	TAD	[" &177]	/GET A <SPACE>
	JMS I	[P7CH]		/PRINT IT
	ISZ	CNT		/DONE YET?
	JMP	.-3		/NO, KEEP GOING
	JMP I	PBLANK		/YES, RETURN
EXMOUNT,.-.			/EXERCISER MOUNT ROUTINE
	DCA	UNIT		/STORE LOGICAL UNIT NUMBER
EXTRAGN,JMS I	(GETREADY)	/GET THE DRIVE READY
	EXMMSG			/FLEXIBLE DISK MESSAGE
	JMP	EXROK		/JUMP IF OK
	SNA CLA			/SKIP IF SERIOUS ERROR
	JMP	EXTRAGN		/JUMP IF NOT
	JMP I	[FAIL]		/FORGET IT

EXROK,	NL7777			/INDICATE CHANGE OF ERROR MESSAGE
	JMS I	(DATASTATUS)	/FIND OUT WHAT DRIVE IS DOING
	SMA CLA			/SKIP IF ERROR ON DRIVE
	JMP	EXROK2		/JUMP IF OTHERWISE
	JMS I	[ERRMSG]	/GO COMPLAIN
	EONMSG			/WITH THIS BLURB
	JMS I	[ASKRETRY]	/ASK FOR A RETRY
	JMP	EXTRAGN		/TRY AGAIN
	JMP I	[AGAIN]		/FORGET IT

EXROK2,	JMS I	(SURESPONSE)	/GET RESPONSE TO QUESTION
	PTXMSG			/FOR PERMISSION
	JMP I	(SYSAGN)	/ASK WHAT THEY WANT INSTEAD
	JMP I	EXMOUNT		/RETURN

/	ERROR COUNTERS.

R0ERRLO,ZBLOCK	2		/READ ERROR COUNTER FOR UNIT ZERO
W0ERRLO,ZBLOCK	2		/WRITE ERROR COUNTER FOR UNIT ZERO
C0ERRLO,ZBLOCK	2		/COMPARE ERROR COUNTER FOR UNIT ZERO
R1ERRLO,ZBLOCK	2		/READ ERROR COUNTER FOR UNIT ONE
W1ERRLO,ZBLOCK	2		/WRITE ERROR COUNTER FOR UNIT ONE
C1ERRLO,ZBLOCK	2		/COMPARE ERROR COUNTER FOR UNIT ONE

