/	DIRECT MEMORY ACCESS TESTS COMMAND COMES HERE.

DMA,	JMS I	[SETUP]		/SETUP RESTART ADDRESS
	JMS I	[MESAG2]	/ANNOUNCE OURSELVES
	SCRN07			/WITH FIRST BLURB
DMAAGN,	JMS I	[GETCOMMAND]	/GET OUR COMMAND
	DMFRST-1		/FIRST LETTER LIST-1
	DMFRST-DMSCND		/LENGTH OF LIST
	DMFINLST-1		/TEXT/DISPATCH LIST-1

/	DIRECT MEMORY ACCESS TEST COMMAND COMES HERE.

DMATST,	JMS	DMREDY		/GET THE DMA UNIT READY
	JMS I	[MESSAGE]	/TELL THEM
	DMGMSG			/WE ARE TESTING
	TAD	(DMATBL-1)	/SETUP THE
	DCA	DMAPTR		/TABLE POINTER
DMALUP,	ISZ	DMAPTR		/BUMP TO NEXT
DMTAGN,	JMS I	(DMTABLE)	/LOOKUP LATEST ELEMENT
	JMP	DMAEND		/JUMP IF AT END OF LIVE TABLE
	JMS I	(DMATEST)	/DO CURRENT MEMORY TEST
	JMP	DMALUP		/KEEP GOING
	JMS	DMPROBLEM	/ERROR, GO COMPLAIN
	JMP	DMTAGN		/RETRY

DMAEND,	TAD	(DATFLD%10)	/SETUP THE
	DCA	TSTFLD		/SEQUENCE TEST FIELD
	DCA	TSTBUFFER	/CLEAR INITIAL TEST ADDRESS
	TAD	[-BLKSIZE]	/SETUP THE
	DCA	DMAPTR		/TEST COUNT
DMBLUP,	JMS I	(DMATEST)	/DO CURRENT MEMORY TEST
	JMP	DMBOK		/OK, KEEP GOING
	JMS	DMPROBLEM	/ERROR, GO COMPLAIN
	JMP	DMBLUP		/RETRY

DMBOK,	TAD	TSTBUFFER	/GET TEST ADDRESS
	TAD	(BLKSIZE+1)	/UPDATE
	DCA	TSTBUFFER	/STORE IT BACK
	ISZ	DMAPTR		/DONE ALL YET?
	JMP	DMBLUP		/NO, KEEP GOING
	JMS I	[MESSAGE]	/YES, TELL THEM
	DMDMSG			/WE'RE DONE
DMFINI,	JMS I	[MESSAGE]	/YES, TELL THEM
	DMOMSG			/THEIR OPTIONS
	JMP	DMAAGN		/GO BACK FOR MORE
/	RANDOM DIRECT MEMORY ACCESS EXERCISER COMMAND COMES HERE.

RANDMA,	JMS	DMREDY			/GET THE DMA UNIT READY
	JMS I	[MESSAGE]		/TELL THEM
	DMRMSG				/WE ARE TESTING
	DCA	DMREDY			/SETUP DMA COUNTER
DMARLP,	CIF	PR2FLD			/GOTO CODE FIELD
	JMS I	(RAND18);DMSEED		/GET A RANDOM VALUE
	SWP				/GET LOW-ORDER FIRST
	SZA				/SKIP IF LOW-ORDER IS ZERO
	JMP	DMOURS			/JUMP OTHERWISE
	SWP				/SWAP BACK
	AND	(7)			/ISOLATE FIELD BITS
	TAD	(DATFLD%10^7777)	/COMPARE TO MAGIC VALUE
	SNA				/SKIP IF OTHERWISE
	JMP	DMOURS			/JUMP IF OUR SPECIAL FIELD
	TAD	(DATFLD%10+DMATBL)	/POINT AT THEIR ELEMENT
	DCA	DMAPTR			/STASH THE POINTER
	JMS I	(DMTABLE)		/CHECK IF VALID ELEMENT
	JMP	DMARLP			/WASN'T THERE, IGNORE IT
	JMP	DMARGN			/WAS THERE, JOIN REST OF CODE

DMOURS,	DCA	TSTBUFFER		/SAVE PASSED VALUE
	TAD	(DATFLD%10)		/GET MAGIC FIELD VALUE
	DCA	TSTFLD			/STASH IT
DMARGN,	JMS I	(DMATEST)		/GO DO THIS TEST
	JMP	DMROK			/NO PROBLEMS
	JMS	DMPROBLEM		/ERROR, GO COMPLAIN
	JMP	DMARGN			/TRY AGAIN

DMROK,	ISZ	DMREDY			/DONE YET?
	JMP	DMARLP			/NO, KEEP GOING
	JMS I	[MESSAGE]		/TELL THEM
	DRDMSG				/WE'RE DONE
	JMP	DMFINISH		/YES, FINISH IT THERE

DMPROBL,.-.				/DMA ERROR ROUTINE
	JMS I	[MESSAGE]		/TELL THEM
	DMFMSG				/OF DMA FAILURE
	DLD;	TSTBUFFER		/GET COMPLETE ADDRESS
	JMS I	(P10SIX)		/PRINT IT
	JMS I	[CRLF]			/DO A <CR>, <LF>
	JMS I	[ASKRETRY]		/ASK FOR A RETRY
	JMP I	DMPROBLEM		/RETURN IF YES
	JMP I	[FAIL]			/FORGET IT
DMREDY,	.-.			/GET DMA UNIT READY ROUTINE
	JMS I	(DMUCHK)	/CHECK IF UNIT AVAILABLE
	JMP	DMAAGN		/FORGET IT
DMATAGN,JMS I	[GETREADY]	/GET THE DRIVE MOUNTED
	DMTMSG			/FLEXIBLE DISK MESSAGE
	JMP	DMAISOK		/JUMP IF OK
	SNA CLA			/SKIP IF SERIOUS ERROR
	JMP	DMATAGN		/JUMP IF NOT
	JMP I	[FAIL]		/FORGET IT

DMAISOK,NL7777			/INDICATE CHANGE OF ERROR MESSAGE
	JMS I	(DATASTATUS)	/CHECK STATUS OF DRIVE
	SMA CLA			/SKIP IF ERROR ON DRIVE
	JMP	DMASOK		/JUMP IF OTHERWISE
	JMS I	[ERRMSG]	/GO COMPLAIN
	EONMSG			/WITH THIS BLURB
	JMS I	[ASKRETRY]	/ASK FOR A RETRY
	JMP	DMATAGN		/TRY AGAIN
	JMP I	[AGAIN]		/FORGET IT

DMASOK,	JMS I	(SURESPONSE)	/ASK FOR CLEARANCE
	PDMMSG			/FOR THIS OPERATION
	JMP	DMAAGN		/FORGET THEM
	JMS I	(PRINTK)	/PRINT OUT MEMORY CONFIGURATION
	JMP I	DMREDY		/RETURN

DMAPTR,	.-.			/TABLE POINTER
TSTBUFF,.-.			/TEST ADDRESS
TSTFLD,	.-.			/TEST BANK AND FIELD

