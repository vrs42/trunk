P10SIX,	.-.			/PRINT DECIMAL SIX DIGITS ROUTINE
	DST;	P10TMP		/SAVE PASSED VALUE
	CAM			/CLEAN UP
	TAD	(-12)		/SETUP FOR
	DCA I	(XDVSOR)	/DIVIDE BY 10
	TAD	(P10BUF+6-1)	/SETUP THE
	DCA	P10PTR		/OUTPUT POINTER
	TAD	(-6)		/SETUP THE
	DCA	P10CNT		/OUTPUT COUNT
P10LUP,	TAD	P10TMP+1	/GET HIGH-ORDER
	DCA I	(XDMQ)		/SETUP AS LOW-ORDER DIVIDEND
	DCA I	(XDAC)		/CLEAR HIGH-ORDER DIVIDEND
	JMS I	(XDVI)		/DIVIDE BY TEN
	TAD I	(XDMQ)		/GET HIGH-ORDER QUOTIENT
	DCA	P10TMP+1	/STASH IT
	TAD	P10TMP		/GET LOW-ORDER
	DCA I	(XDMQ)		/STORE LOW-ORDER DIVIDEND
	JMS I	(XDVI)		/DIVIDE BY TEN
	TAD I	(XDMQ)		/GET LOW-ORDER QUOTIENT
	DCA	P10TMP		/STASH IT
	TAD I	(XDAC)		/GET REMAINDER
	DCA I	P10PTR		/STORE IN BUFFER
	NL7777			/BACKUP THE
	TAD	P10PTR		/OUTPUT POINTER
	DCA	P10PTR		/STORE BACK
	ISZ	P10CNT		/DONE SIX YET?
	JMP	P10LUP		/NO, KEEP GOING
	TAD	(P10BUF-1)	/YES, POINT AT
	DCA	XR1		/OUTPUT BUFFER
	TAD	(-6)		/SETUP THE
	DCA	P10CNT		/OUTPUT COUNTER
P10OTLP,TAD I	XR1		/GET A DIGIT
	TAD	("0&177)	/MAKE IT ASCII
	JMS I	[P7CH]		/PRINT IT
	ISZ	P10CNT		/DONE YET?
	JMP	P10OTLP		/NO, KEEP GOING
	JMP I	P10SIX		/YES, RETURN

P10BUF,	ZBLOCK	6		/OUTPUT BUFFER
P10CNT,	.-.			/OUTPUT COUNTER
P10PTR,	.-.			/OUTPUT POINTER
P10TMP,	ZBLOCK	2		/PASSED VALUE STORED HERE
TTYINC,	.-.			/TTY: INPUT ROUTINE WITH <^U> CHECK
	JMS I	[TTYIN]		/GET A CHARACTER
	TAD	(-"U!300)	/IS IT <^U>?
	SNA CLA			/SKIP IF NOT
	JMP	ISUPU		/JUMP IF SO
	TAD	INCHAR		/GET IT BACK
	JMP I	TTYINC		/RETURN

ISUPU,	TAD	("U&177)	/GET A "U"
	JMS I	[CARPRT]	/PRINT "^U"
	JMS I	[CRLF]		/DO A <CR>, <LF>
	JMP I	UPURET		/RETURN TO SETUP CANCEL ADDRESS

SURESP,	.-.			/SURE RESPONSE ROUTINE
	TAD I	SURESPONSE	/GET IN-LINE MESSAGE POINTER
	DCA	SURINLINE	/STORE IN-LINE
	ISZ	SURESPONSE	/BUMP PAST ARGUMENT
	JMS I	[MESSAGE]	/ASK THEM
SURINLI,.-.			/THE PASSED QUESTION
	JMS I	[YORNO]		/GET THE RESPONSE
	SKP			/SKIP IF YES
	JMP I	SURESPONSE	/ELSE TAKE IMMEDIATE RETURN
	JMS I	[MESSAGE]	/ASK IF
	RUSMSG			/THEY ARE SURE
	JMS I	[YORNO]		/GET RESPONSE
	ISZ	SURESPONSE	/BUMP RETURN IF YES
	JMP I	SURESPONSE	/RETURN EITHER WAY
/	LPT: OUTPUT ROUTINE.

P7LPT,	.-.			/LPT: OUTPUT
	DCA	P7TEMP		/SAVE PASSED VALUE
	JMP	P7LTST		/TEST RETURN SIDE FIRST

P7LUP,	TAD	P7TEMP		/GET CHARACTER BACK
	LSFIOT			/FLAG UP?
	JMP	P7LTST		/NO, TRY OTHERS
	LLSIOT			/YES, SEND IT
	JMS I	[CHKUP]		/CHECK OTHERS AND CLEAR AC
	JMP I	P7LPT		/RETURN

P7LTST,	JMS I	[CHKUP]		/CHECK FOR OTHERS AND CLEAR AC
	LKSFIOT			/INPUT FLAG UP?
	JMP	P7LUP		/NO, TRY OUTPUT AGAIN
	LKRBIOT			/YES, GET THE CHARACTER
	AND	(177)		/JUST SEVEN BITS
	TAD	(-"S!300)	/IS IT <^S>?
	SZA CLA			/SKIP IF SO
	JMP	P7LUP		/TRY AGAIN IF NOT
P7LWAT,	LKSFIOT			/INPUT FLAG UP?
	JMP	P7LCHK		/NO, TRY OTHERS
	LKRBIOT			/YES, READ IT IN
	AND	(177)		/JUST SEVEN BITS
	TAD	(-"Q!300)	/IS IT <^Q>?
	SZA CLA			/SKIP IF SO
	JMP	P7LWAT		/JUMP IF NOT
	JMP	P7LTST		/CHECK FOR OTHERS AND RESUME OUTPUT WAIT

P7LCHK,	JMS I	[CHKUP]		/CHECK OTHERS
	JMP	P7LWAT		/WAIT FOR INPUT AGAIN


