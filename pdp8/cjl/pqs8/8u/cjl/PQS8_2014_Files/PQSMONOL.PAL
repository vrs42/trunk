SYSTART,SBOOT                   /THROUGH HERE
SYSIO,  INPBUF                  /I/O ENTRY POINT
        CLA IAC                 /SETUP FOR IOF/ION
S6000,  SKON                    /INTERRUPT ON?
        IAC                     /NO, AC=2; ELSE AC=1
        TAD     S6000           /NOW HAVE IOF/ION INSTRUCTION
        DCA     SINTXT          /SAVE FOR EXIT LATER
        RDF                     /OR IN DATA FIELD
        TAD     SCIDF           /MAKE IT CIF CDF TO CALLING FIELD
        DCA     SOUT            /SAVE FOR LATER
        TAD I   SYSIO           /GET CORE ARGUMENT
        DCA     SBUFF           /SAVE IT
        ISZ     SYSIO           /BUMP TO FUNCTION WORD
        TAD I   SYSIO           /GET FUNCTION
        DCA     SFUNCT          /SAVE TEMPORARILY
