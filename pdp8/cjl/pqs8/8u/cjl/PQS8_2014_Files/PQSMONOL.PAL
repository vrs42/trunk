SBOOT,  JMS     SYSIO           /CALL I/O ROUTINES TO BOOTSTRAP
S7600,  7600                    /STARTING ADDRESS IS 7600
S100,   0100                    /READ BLOCK 0-17, FIELD 0, UNIT 0
        0000                    /BOOTSTRAP RECORD IS BLOCK 0

SWAL,   SFIX&177+6000           /SWITCHES /A-/L ;LMODE: JMP SFIX
SWMX,   .-.                     /SWITCHES /M-/X
SWY9,   .-.                     /SWITCHES /Y-/9
SOUTFLS,.-.                     /PASSED OUTPUT FILES
SDATE,  .-.                     /SYSTEM DATE WORD
SCRSIZE,.-.                     /SOFTWARE CORE SIZE

SWPFLD, CDF     00              /FIELD OF EXTRA WORD TO BE SAVED
        TAD I   STEM            /GET THREATENED WORD
