/POORLY PROGRAMMED DEC STANDARD MR8E-C ROM
/AN EQUIVALENT OF WHICH FOLLOWS:
/       MR8E-C ROM PERMANENT CONTENTS

        FIELD   ROMFLD%10       /WHERE IT GOES

        *7400

RENTER, TAD I   ROMBPT          /UPDATE
        TAD     R200            /BUFFER
        DCA I   ROMBPT          /POINTER AND
        ISZ I   RBLOCK          /BLOCK NUMBER
        STL                     /CONTINUE FORWARD
RGO,    CLA CML RTR             /MOVE INVERTED LINK TO DIRECTION BIT
        TAD     R1000           /ADD IN GO BIT
        TAD I   RUNIT           /4000=UNIT 1
        SDLC                    /LOAD CONTROL REGISTER
        SDSQ                    /WAIT UNTIL
        JMP     .-1             /8 LINES
        SDRD                    /HAVE PASSED
        SDSQ                    /TO GUARANTEE
        JMP     .-1             /THAT WE ARE
        SDRD                    /UP TO SPEED
RSRCH,  SDSS                    /NOW WAIT FOR
        JMP     .-1             /1 LINE
        SDRC                    /READ IN COMMAND REGISTER
        CLL RTL                 /DIRECTION TO LINK, DATA TO AC 4-9
        AND     R374            /ISOLATE MARK TRACK BITS
        TAD     RM110           /IS IT END ZONE?
        SNA                     /SKIP IF NO
        JMP     RENDZ           /YES, DO SOMETHING REASONABLE
        TAD     RM20            /HOW ABOUT BLOCK MARK
        SZA CLA                 /SKIP IF YES
        JMP     RSRCH           /NO, KEEP LOOKING
        SDRD                    /YES, GET BLOCK NUMBER
        SZL                     /IF IN REVERSE, LOOK FOR 3 BEFORE
        TAD     ROM3            /THIS GUARANTEES THE TARGET BLOCK IN REVERSE
        CMA                     /INVERT AND
        TAD I   RBLOCK          /ADD ON DESIRED BLOCK (COULD BE 0)
        CMA                     /INVERT AGAIN
        SNA                     /IS THIS BLOCK CORRECT?
        JMP     RFOUND          /YES
RM110,  SZL SNA CLA             /RIGHT DIRECTION?
        JMP     RSRCH           /YES, KEEP LOOKING
RENDZ,  SDRC                    /IF IN FORWARD END ZONE WE LOSE
        CLL RTL                 /DIRECTION GOES TO LINK
        SZL CLA                 /IF FORWARD SKIP AND BARF
        JMP     RGO             /OK, JUST TURN AROUND
        CIF     00              /BARF,
        JMP I   RERROR          /BRANCH TO ERROR RETURN
RFOUND, SZL CLA                 /ARE WE IN RIGHT DIRECTION?
        JMP     RGO             /NO, GO TURN AROUND AGAIN
        TAD I   ROMBPT          /GET BUFFER POINTER
        JMP I   ROMORE          /NOW GO TO OTHER HALF OF ROM

RM200,  -200                    /PAGE COUNT VALUE
R200,   200                     /BUFFER UPDATE VALUE
R374,   374                     /SHIFTED MARK TRACK MASK
RM20,   -20                     /BLOCK MARK CONSTANT
ROM3,   3                       /OVERSHOOT FACTOR
ROMBPT, SBPTR                   /POINTER TO BUFFER POINTER
RBLOCK, SBLK                    /POINTER TO BLOCK NUMBER
RUNIT,  SUNIT                   /POINTER TO UNIT ARGUMENT
RERROR, SERROR                  /POINTER TO ERROR RETURN
ROMORE, RMORE                   /POINTER TO NEXT PAGE OF ROM
/       ROM BOOTSTRAP

/       SWITCH REGISTER = 7470
/       LOAD ADDRESS
/       EXTENDED LOAD ADDRESS
/       CLEAR
/       CONTINUE
/       AND YOU'RE IN, 'CAUSE ROM IS NOT OPEN TO THE PUBLIC
/       JUST TO PDP-8/E'S AND THEIR FAMILIES

RMBOOT, CDF     00              /BOOT TO FIELD 0
        TAD     RINST1          /MOVE
        DCA I   RMPTR1          /DOWN
        TAD     RINST2          /A
        DCA I   RMPTR2          /FIELD
        TAD     RINST3          /ZERO
        DCA I   RMPTR3          /SUBROUTINE
        TAD     RINST4          /TO USE FOR
        DCA I   RMPTR4          /BOOTSTRAP
        TAD     R3000           /UNIT 0, REVERSE, GO
        SDLC                    /TO COMMAND REGISTER
RSERCH, SDSS                    /WAIT FOR
        JMP     .-1             /END ZONE CODE
        SDRC                    /READ IT IN
        AND     R77             /JUST MARK TRACK BITS
        TAD     RM22            /END ZONE?
        SZA CLA                 /SKIP IF YES
        JMP     RSERCH          /NO, KEEP LOOKING
R1000,  TAD     R1000           /GOOD ENOUGH
        SDLC                    /GO FORWARD
RSRCH2, SDSS                    /WAIT FOR
        JMP     .-1             /NEXT CODE
        SDRC                    /READ IT IN
        AND     R77             /JUST MARK TRACK BITS
        TAD     RM31            /IS IT 31 CODE
        SZA CLA                 /SKIP IF YES
        JMP     RSRCH2          /NO, KEEP LOOKING
RLOAD,  SDSQ                    /WAIT FOR A
        JMP     .-1             /DATA WORD
        SDRD                    /READ IT IN
        CIF     00              /TO FIELD 0
        JMS I   RPUTWD          /PUT A WORD INTO FIELD 0
        ISZ I   RMPTR4          /DONE ALL YET?
        JMP     RLOAD           /NO, GO BACK 'TIL DONE
        CIF     00              /NOW GOTO
        JMP     7400            /OTHER BOOTSTRAP AT 7400
RM22,   -22                     /-END ZONE CODE
RM31,   -31                     /-CODE BEFORE DATA
R3000,  3000                    /REVERSE GO CONSTANT
R77,    77                      /MARK TRACK MASK
RPUTWD, RPUT                    /THESE
RMPTR1, RPUT+1                  /ARE
RMPTR2, RPUT+2                  /POINTERS
RMPTR3, RPUT+3                  /FOR EACH WORD
RMPTR4, RPTR                    /OF RPUT ROUTINE

        RINST1= .+1             /INSTRUCTIONS
        RINST2= RINST1+1        /TO BE
        RINST3= RINST2+1        /MOVED
        RINST4= RINST3+1        /DOWN

        NOPUNCH

        *ROMBOOT-20             /WHERE THIS'LL GO LATER

        ENPUNCH

RPUT,   .-.                     /PUT 1 12-BIT WORD
        DCA I   RPTR            /SPRAY 1 WORD
        CIF     ROMFLD          /BACK TO THE ROM
        JMP I   RPUT            /RETURN
RPTR,   ROMBOOT-4               /START PUTTING IT HERE

        NOPUNCH

        *RINST1+RPTR-RPUT       /WHERE WE REALLY ARE

        ENPUNCH

F2SET,  TAD I   RUNIT           /SUBSTITUTE FOR FIELD 2 SETUP
        SDLC                    /LOAD COMMAND REGISTER WITH UNIT
        CLA CLL CMA RTL         /-3 FOR
        DCA I   RTRY            /RETRY COUNT
        SDRC                    /GET BACK UNIT BIT
        DCA I   RXUNIT          /SAVE IT
        SDRD                    /GET ARGUMENT WORD
        CLL RAL                 /MOVE TO PAGE BITS
        AND     RM200           /JUST PAGE COUNT
        DCA I   RXPGCT          /SAVE 'EM
        SDRD                    /GET 'EM AGAIN
        DCA I   RXFUN           /SAVE AS FUNCTION WORD
        SDRD                    /ONCE MORE
        RAR                     /DIRECTION OF SEARCH INTO LINK
        JMP     RGO             /NOW SEARCH FOR BLOCK

RTRY,   STRY                    /RETRY COUNT POINTER
RXUNIT, SXUNIT                  /SAVED UNIT TEMPORARY
RXPGCT, SXPGCT                  /PAGE COUNT TEMPORARY
RXFUN,  SXFUN                   /FUNCTION TEMPORARY

        ZBLOCK  3               /EMPTY BITS
RMORE,  DCA I   RRXPTR          /SETUP GETPUT POINTER
        TAD     RR7600          /SETUP PAGE
        DCA I   RRXWCNT         /WORD COUNT
RGRDSRC,SDSS                    /WAIT FOR
        JMP     .-1             /REVERSE GUARD MARK
        SDRC                    /READ IT IN
        AND     RR77            /JUST MARK TRACK BITS
        TAD     RRM32           /IS IT REVERSE GUARD?
        SZA CLA                 /SKIP IF YES
        JMP     RGRDSRC         /NO, KEEP LOOKING
        TAD I   RRXFUN          /CHECK FUNCTION
RR7700, SMA CLA                 /READ OR WRITE?
