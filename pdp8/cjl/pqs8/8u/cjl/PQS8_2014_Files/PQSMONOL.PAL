ERSET,  ISZ     EPTR            /BUMP FETCH POINTER
        TAD     EPTR            /GET POINTER
        TAD     L200            /COMPARE TO LIMIT
        SZA CLA                 /DONE WITH BUFFER?
        JMP     EBACK           /NO... NOT QUITE YET
EOB,    JMS I   SSYSIO          /\
E7400,  RUBPAGE                 / \READ IN
EFUN,   1^100                   / /NEXT BLOCK
EBLOCK, BINADR+1                //
        ISZ     EBLOCK          /BUMP BLOCK NUMBER
EFIXIT, TAD     E7400           /RESET
        DCA     EPTR            /POINTER
