        UPUMSG                  /PRINT DELETED LINE INDICATOR
        JMP I   PLRST           /RESTART LINE

CNTRLO, JMS I   FLIPECHO        /INVERT ECHO STATUS
        JMP I   PCHLOOP         /RESUME INPUT

LNFEED, TAD     L12             /GET A <LF>
        JMS I   PRINT           /TYPE IT
        JMP I   PCHLOOP         /RESUME INPUT

EWHAT,  NL7776                  /WHAT SETS SWITCH TO -1
EDTRM,  IAC                     /EXIT SETS SWITCH TO +1
EDDONE, DCA     SCHAR           /SET THE SWITCH
        TAD     PXWHAT          /RESET "WHAT" POINTER
        DCA     WHAT            /TO IT'S ORIGINAL STATE
        TAD     CATCORE         /RESET GLINE FUDGE
        DCA I   PEDSWIT         /SO IT WORKS RIGHT
        TAD     SAVSEQ          /RESTORE THE OLD
        DCA     SEQSW           /SEQUENCE INCREMENT
        DCA I   PEDCH1          /RESET TABLE
        TAD     SAVSLI          /RESTORE OLD
        DCA     SLINUM          /SEQUENCE NUMBER
        TAD     PXGL1           /RESET THE LINE
        DCA     PLRST           /RESTART POINTER
