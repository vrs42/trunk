SFUNCT, 20^100                  /FUNCTION WORD;MUST BE AT 7630

S7570,  7570                    /-42^4

SLOAD,  JMS     SYSIO           /SYSTEM LOADER
SCORE,  0                       /CORE ARGUMENT
SFUN,   WRITE                   /FUNCTION
SBLOCK, BINADR                  /BLOCK
