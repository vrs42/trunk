        SDLD                    /WRITE THE WORD
        CLA CLL                 /SDLD DOESN'T CLEAR
        CIF     00              /RETURN TO
        JMP     SCIFR           /SUBROUTINE

RCHECK, CLA                     /CLEAN UP
        TAD I   RRCKSUM         /GET CHECKSUM
        CLL CMA RTL             /INVERT
        RTL                     /AND SHIFT TO
        RTL                     /HIGH ORDER
        CIF     00              /GET LATEST
        JMS     EQUFUN          /CHECKSUM VALUE DONE
        CLA CLL                 /THROW IT AWAY
        TAD I   RRXFUN          /GET READ OR WRITE BIT
        RAL                     /TO LINK
        CLA                     /CLEAN UP
        TAD I   RRCKSUM         /GET CHECKSUM
        AND     RR7700          /JUST LAST ONE
        SNL                     /WERE WE WRITING?
        JMP     RWCOM           /NO, JUST READING SO IT BETTER BE ZERO
        JMP     WRCHEK          /LET CHECKSUM GET WRITTEN

RRXPTR, SXPTR                   /POINTER TO POINTER TEMPORARY
RRXWCNT,SXWCNT                  /POINTER TO WORD COUNT TEMPORARY
RRM32,  -32                     /REVERSE GUARD CONSTANT
RRXFUN, SXFUN                   /POINTER TO FUNCTION TEMPORARY
RR1400, 1400                    /GO WRITE CONSTANT
RRXUNIT,SXUNIT                  /POINTER TO UNIT TEMPORARY
RRCKSUM,SCKSUM                  /POINTER TO CHECKSUM WORD
RRXPGCT,SXPGCT                  /POINTER TO PAGE WORD COUNT
RRENTER,RENTER                  /POINTER TO RE-ENTER ENTRY
        
