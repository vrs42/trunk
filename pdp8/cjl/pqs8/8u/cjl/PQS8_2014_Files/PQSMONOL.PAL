        DCA     GETNDX          /ELSE SAVE COPY
        TAD     BEGLIN          /SET GETHAF BASE POINTER
        DCA     GETBAS          /TO BEGINNING OF LINE
        DCA     RUBFLG          /SET NOT LINE OVERFLOW
        TAD     RDELIM          /GET DELIMITER
        JMS I   PRINT           /AND PRINT IT
RAGN,   STA                     /GET A -1
        TAD     PUTNDX          /OFF OF PUT OFFSET
        SPA                     /OVERFLOW?
        JMP     RNOMOR          /YES, CLOSE LINE AND START NEW ONE
        DCA     PUTNDX          /ELSE SAVE THE NEW VALUE
        TAD     EDLIN           /\
        CIA                     / \
        TAD     PUTNDX          /  \
        SMA CLA                 /   >IF EDLIN>PUTNDX, EDLIN=PUTNDX
        JMP     .+3             /  /
        TAD     PUTNDX          / /
        DCA     EDLIN           //
        JMS I   GETHAF          /GET RUBBED-OUT CHAR
        JMS I   PR6BIT          /ECHO IT ON TTY:
RMRUB,  -177                    /CAN'T EXECUTE THIS!
        STA                     /LOAD AC WITH -1
        TAD     PUTNDX          /ADD ON PUT OFFSET
        DCA     GETNDX          /AND SAVE IT FOR NEXT TIME
        JMS I   INPUT           /CAPTIVATE INPUT
        DCA     TEMP1           /SAVE IT IN GOOD LOCATION
        TAD     TEMP1           /GET WHAT HE TYPED
        TAD     RMRUB           /ANOTHER <RO>?
        SZA                     /SKIP IF SO
        TAD     L40             /BACK ARROW?
        SNA CLA                 /SKIP IF NOT EITHER
        JMP     RAGN            /RUB-A-DUB-DUB
REXIT,  TAD     RDELIM          /GET DELIMITER
        JMS I   PRINT           /AND PRINT IT TO ENCLOSE
        TAD     RTEMP2          /\
        DCA     GETNDX          / \RESTORE POINTERS
        TAD     RTEMP3          / /FOR EDIT COMMAND
        DCA     GETBAS          //
        ISZ     RUBFLG          /ARE WE HERE DUE TO OVERFLOW?
        JMP I   RCHLP2          /NO-RESUME CLEANLY
        JMP     ROVFLO          /YES, RESTART LINE

RNOMOR, STA                     /SET LINE OVERFLOW
        DCA     RUBFLG          /FOR ALL TO SEE
        JMP     REXIT           /AND LEAVE

RCHLP2, CHLOOP+2                /POINTER TO CODE TO FALL INTO
        ZBLOCK  1               /FOR ALIGNMENT WITH OTHER <RO> CODE

SETSCS, .-.                     /SETUP MEMORY CONFIGURATION
TRYNXT, CDF     00              /FOR THE PDP-8/L
CDFNXT, CDF     10              /REFERENCE NEXT FIELD
        TAD I   MESSAGE         /GET ITS TEST LOCATION
        DCA     CORTM1          /SAVE FOR RESTORATION
        TAD     CATCORE         /GET A 7000
        DCA I   MESSAGE         /STORE IT TENTATIVELY
        TAD I   MESSAGE         /TRY TO REGAIN IT
        TAD     L1000           /7000 + 1000 = 0000
        SNA                     /SKIP IF WE FAILED
        TAD     GETBASE         /DID WE HIT OUR LOCATION?
        SZA CLA                 /SKIP IF NOT
        JMP     HARDEND         /HERE IF WE'RE DONE -- SET THE SIZE
        TAD     CORTM1          /RESTORE TEST LOCATION
        DCA I   MESSAGE         /IN THE TEST FIELD
        TAD     CDFNXT          /\
        TAD     OL10            / >INCREMENT TO NEXT FIELD
        DCA     CDFNXT          //
        ISZ     NEWCAT          /INCREMENT COUNTER
        JMP     TRYNXT          /TRY NEXT FIELD
HARDEND,CDF     00              /RESTORE DATA FIELD
        TAD     NEWCAT          /GET NEGATIVE COUNTER
        TAD     L7              /MAKE IT POSITIVE
        CLL RTR                 /MOVE PHYSICAL SIZE
        RTR                     /INTO AC[0-2]
        DCA     CORTM1          /SAVE TEMPORARILY
        NL0001                  /FOR TESTING "S" BIT
        AND I   CTMSIZE         /EXTRACT IT
        SZA CLA                 /WAS IT SET?
        JMP     SETPCS          /JUMP IF SO; DON'T TOUCH MCS BITS
        XLIST   OFF
        IFNZRO  HFIELD&4000     <
        XLIST   ON
        NOP                     /FOR ALIGNMENT WITH ADJUSTABLE SYSTEM
        TAD     CORTM1          /GET PCS BITS
        CLL RTR                 /MOVE TO
        RAR                     /AC[3-5]
        XLIST   OFF             >
        IFZERO  HFIELD&4000     <
        IFNZRO  SYSADJ  <
        XLIST   ON
        TAD     CATCORE         /BACKUP BY ONE FIELD
        TAD     CORTM1          /NOW HAVE ARTIFICIAL LIMIT
        CLL RTR                 /MOVE TO
        RAR                     /AC[3-5]
        XLIST   OFF     >
        IFZERO  SYSADJ  <
        XLIST   ON
        TAD     SYSMAX          /\
        CLL RTL                 / \MOVE MEMORY LIMITATION
        RTL                     / /VALUE TO AC[3-5]
        RTL                     //
        XLIST   OFF     >
        XLIST   OFF             >
        XLIST   ON
        DCA     RTEMP1          /SAVE TEMPORARY MCS BITS
        TAD I   CTMSIZE         /GET CONFIGURATION WORD
OL10,   AND     L77             /DELETE MCS AND PCS BITS
        TAD     RTEMP1          /SET NEW MCS BITS
        DCA I   CTMSIZE         /SAVE INTO CORE
SETPCS, TAD I   CTMSIZE         /GET CONFIGURATION WORD
        AND     COR777          /REMOVE ANY PRIOR PCS BITS
        TAD     CORTM1          /ADD ON NEW PCS BITS
        DCA I   CTMSIZE         /STORE IT (FINALLY)
        JMP I   SETSCS          /RESUME ONCE-ONLY CODE

        ZBLOCK  7577-.          /EMPTY SPACE

        XLIST   OFF
        IFNZRO  HFIELD&4000     <
        XLIST   ON
SYSMAX, HFIELD                  /SYSTEM MEMORY LIMITATION WORD
        XLIST   OFF             >
        IFZERO  HFIELD&4000     <
        XLIST   ON
SYSMAX, HFIELD%10-1             /SYSTEM MEMORY LIMITATION WORD
        XLIST   OFF             >
        XLIST   ON
/P?S BATCH PROCESSOR

        FIELD   0               /RESET FIELD

