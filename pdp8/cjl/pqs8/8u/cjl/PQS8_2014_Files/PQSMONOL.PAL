/       EQUATED SYMBOLS

        BATBLK= 0117            /BATCH SYSTEM BLOCK
        BINADR= 0020            /DEFAULT BINARY SCRATCH AREA (%)
        BINBLK= 0121            /BLOCK NUMBER OF BIN SYSTEM
        BINLEN= 0012            /BINARY LOADER LENGTH (FOR LOADING)
        BTRLBLK=0075            /BATCH RECOVERY BLOCK
        BTRLEN= 0005            /TOTAL BATCH RECOVERY LENGTH
        BTSLEN= 0002            /BATCH SYSTEM LOAD LENGTH
        CATADR= 7000            /USER CATALOG ADDRESS
        DIR=    0015            /FIRST OF TWO USER DIRECTORY BLOCKS
        DUMBLK= 0147            /DUMP SYSTEM BLOCK
        DUMCORE=3200            /DUMP GENERATING ADDRESS (IN FIELD 1)
        DUMLEN= 0007            /DUMP SYSTEM LENGTH
        DUMLOD= 0000            /DUMP LOADING ADDRESS
        DUMSTRT=1400            /DUMP STARTING ADDRESS
        EXTCAT= 0067            /EXTENDED CATALOG BLOCK
        FILBEG= 3000            /FILE BUFFER
        FILSIZ= 0020            /LENGTH OF USER FILE
        HBLOCK= 0072            /FIRST HELPER BLOCK FOR EXTENDED MEMORY SYSTEMS
        HSTART= 6400            /HELPER CODE LOADS INTO 16400
        IBLOCK= 0060            /I BLOCK
        INVT=   0031            /EQUATED FROM VT8E!
        NL0001= CLA IAC         /SET AC TO ONE
        NL0002= CLA CLL CML RTL /SET AC TO TWO
        NL2000= CLA CLL CML RTR /SET AC TO TWO THOUSAND
        NL3777= CLA CLL CMA RAR /SET AC TO THREE SEVEN SEVEN SEVEN
        NL4000= CLA CLL CML RAR /SET AC TO FOUR THOUSAND
        NL5777= CLA CLL CMA RTR /SET AC TO FIVE SEVEN SEVEN SEVEN
        NL7775= CLA CLL CMA RTL /SET AC TO SEVEN SEVEN SEVEN FIVE
        NL7776= CLA CLL CMA RAL /SET AC TO SEVEN SEVEN SEVEN SIX
        NL7777= CLA CMA         /SET AC TO SEVEN SEVEN SEVEN SEVEN
        ODTBLK= 0102            /ODT SYSTEM BLOCK
        ODTCORE=0000            /ODT LOADING ADDRESS (ALSO GENERATING ADDRESS IN FIELD 1)
        ODTLEN= 0015            /ODT SYSTEM LENGTH
        ODSTRT= 3000            /ODT STARTING ADDRESS
        OUTVT=  0033            /EQUATED FROM VT8E!
        REVISIO="U&77           /REVISION NUMBER OF MONITOR
        RUBBLK= 0017            /<RO> BLOCK
        RUBPAGE=7400            /WHERE <RO> CODE, ETC. IS LOADED
        RUNBLK= 0061            /"R" COMMAND BLOCK
        RUNCOR= 3600            /"R" COMMAND GENERATION ADDRESS
        SBOOT=  7600            /SYSTEM BOOTSTRAP ADDRESS
        SFILES= 7757            /FILE ARGUMENTS PASSED TO SYSTEMS STARTING HERE
        SHADDR= 7200            /SYSTEM HANDLER EXTENDED CODE RUNS HERE
        SLOAD=  7632            /SYSTEM LOADER CALL IS HERE
        SOUTFLS=7607            /OUTPUT FILE COUNT
        SWAL=   7604            /PASSED SWITCHES /A-/L
        SWAPIN= 1200            /ADDRESS TO SWAP CODE INTO
        SWMX=   7605            /PASSED SWITCHES /M-/X
        SWY9=   7606            /PASSED SWITCHES /Y-/9
        SWPLEN= 0002            /NUMBER OF BLOCKS (PAGES) TO SWAP
        SYSCAT= 0063            /SYSTEM CATALOG BLOCK
        VERSION="8&77           /VERSION NUMBER OF SYSTEM
        WRITE=  4000            /SYSIO WRITE BIT
/               SYSGEN PARAMETER AREA

/SETTING        TC01=   1       GENERATES A TC01/TC08 DECTAPE SYSTEM (1-8 DRIVES).

/SETTING        DF32=   1       GENERATES A DF32 SYSTEM (1-4 PLATTERS). A
/                               PDP-8/E OR FASTER PROCESSOR IS REQUIRED
/                               FOR RELIABLE OPERATION OF THE SLURP LOADER.

/SETTING        DF32D=  1       GENERATES A DF32-D SYSTEM (1-4 PLATTERS)
/                               FOR ALL DF32 TYPE SYSTEMS ON ANY PROCESSOR.

/SETTING        IPB=    1       GENERATES AN INTERPROCESSOR SYSTEM UTILIZING
/                               AN IPB DESIGNED BY D. SOERGEL (SYRACUSE UNIVERSITY).
/                               THIS SYSTEM REQUIRES A MASS STORAGE SYSTEM
/                               AT THE OPPOSITE SIDE OF THE IPB.

/SETTING        TC12=   1       GENERATES A TC12 LINCTAPE SYSTEM (1-8 DRIVES)
/                               FOR THE PDP-12 (128 OR 129 WORDS/BLOCK).

/SETTING        LINC8=  1       GENERATES A LINCTAPE SYSTEM (1-8 DRIVES) FOR
/                               A MODIFIED LINC-8 (128 WORDS/BLOCK ONLY).

/SETTING        LINC8X= 1       GENERATES A LINCTAPE SYSTEM (1-8 DRIVES) FOR
/                               AN UNMODIFIED LINC-8 (128 WORDS/BLOCK ONLY).
/                               THIS VERSION REQUIRES EXTENDED MEMORY.

/SETTING        RF08=   1       GENERATES AN RF08 SYSTEM (1-4 PLATTERS).

/SETTING        DYNEX=  1 &
/               DYNFIX= 1       GENERATES A WESTERN DYNEX/DSD 240-8 SYSTEM
/                               WHICH RESIDES ON THE FIXED PLATTER
/                               OF A DYNEX DOUBLE DENSITY DRIVE.

/SETTING        DYNEX=  1 &
/               DYNFIX= 0       GENERATES A WESTERN DYNEX/DSD 240-8 SYSTEM
/                               WHICH RESIDES ON THE REMOVABLE PLATTER
/                               OF A DYNEX DOUBLE DENSITY DRIVE.
/SETTING        TDROM=  1       GENERATES A TD-8/E + MR8E-C ROM SYSTEM (1-2 DRIVES) WHICH
/                               DOES NOT REQUIRE EXTENDED MEMORY BUT DOES REQUIRE
/                               EXTENDED MEMORY CONTROL AND A PDP-8/E OR FASTER
/                               PROCESSOR DUE TO DATA RATE.

/SETTING        TD8E=   1       GENERATES A TD-8/E SYSTEM WHICH REQUIRES EXTENDED MEMORY
/                               (HFIELD IS THE MINIMUM AMOUNT;HFIELD=10-70) AND PUTS
/                               THREE PAGES IN FIELD HFIELD.

/SETTING        RK8E=   1       GENERATES AN RK-8/E (RK-8/F) SYSTEM THAT UTILIZES HALF
/                               OF EVERY SECTOR ON EACH CARTRIDGE.

/SETTING        RK8E=   1 &
/               RKFULL= 1       GENERATES AN RK-8/E (RK-8/F) SYSTEM WITH FULL DISK
/                               UTILIZATION. THIS VERSION REQUIRES EXTENDED MEMORY
/                               AND WILL AUTOMATICALLY ADJUST THE CORE SIZE.

/SETTING        RX8B=   1       GENERATES AN RX8B (DSD-210) SYSTEM (1-4 DRIVES). THIS
/                               VERSION REQUIRES EXTENDED MEMORY (SAME MEMORY
/                               REQUIREMENT AS TD8E), AND HAS IMPROVED ERROR RECOVERY.
/                               THIS VERSION REQUIRES A SPECIAL BOOTSTRAP AND RUNS ONLY
/                               ON SPECIALLY INITIALIZED DISKETTES.

/SETTING        RX8BH=  1       GENERATES AN RX01 (DSD-210) SYSTEM (1-4 DRIVES) WHICH
/                               REQUIRES AUXILARY HARDWARE/FIRMWARE. THIS VERSION
/                               REQUIRES A SPECIAL BOOTSTRAP AND RUNS ONLY ON SPECIALLY
/                               INITIALIZED DISKETTES.

/SETTING        RX8BX=  1       GENERATES AN RX8B (DSD-210) SYSTEM (1-4 DRIVES). THIS
/                               VERSION REQUIRES EXTENDED MEMORY (SAME MEMORY REQUIREMENT
/                               AS TD8E).

/SETTING        SYK7KX= 1       GENERATES A SYKES 7X50 SYSTEM (1-4 DRIVES). THIS VERSION
/                               REQUIRES EXTENDED MEMORY (SAME MEMORY REQUIREMENT AS
/                               TD8E).



/TD-8/E, RX8B, RX8BX, SYK7KX, AND LINC8X SYSTEMS WILL GENERATE A SOFTWARE
/CORE-SIZE LIMITED SYSTEM ACCORDING TO HFIELD (10 IS DEFAULT). RK-8/E SYSTEMS
/USE AN ADJUSTABLE CORE SIZE LIMITING SCHEME TO GOVERN CORE USAGE; HFIELD IS
/ONLY USED TO EXPRESS THE SYSTEM GENERATION CORE USAGE TO ALLOW MORE FLEXIBLE
/GENERATION. THE ACTUAL REQUIREMENT IS THAT 8K MINIMUM CORE BE AVAILABLE. ONLY
/CONTIGUOUS FIELDS ARE ELEGIBLE FOR THIS SYSTEM (IN ADDITION THE COLD START
/BOOTSTRAP ASSUMES THE AVAILABILITY OF FIELD 1). RK-8/E SYSTEMS USE 1, 2, OR 4
/PLATTERS AS DETERMINED BY RKNUM; THE DEFAULT IS 2 (RKNUM=2). RKFULL SYSTEMS
/CAN BE GENERATED FOR 1 OR 2 PLATTERS ONLY. SOME SYSTEMS SUPPORT MULTIPLE
/BOOTSTRAPS. SET BTUNIT TO THE DESIRED UNIT (0-7);(DEFAULT BTUNIT=0).
        XLIST   OFF
        IFNDEF  SYSADJ  <
        SYSADJ= 0       >       /SYSTEM IS NOT NORMALLY ADJUSTABLE
        IFNDEF  BTUNIT          <BTUNIT=0>
        IFNDEF  DF32            <DF32=  0>
        IFNDEF  DF32D           <DF32D= 0>
        IFNDEF  DYNEX           <DYNEX= 0>
        IFNZRO  DYNEX   <
        IFNDEF  DYNFIX          <DYNFIX=0>
                        >
        IFNDEF  IPB             <IPB=   0>
        IFNDEF  LINC8           <LINC8= 0>
        IFNDEF  LINC8X          <LINC8X=0>
        IFNDEF  RF08            <RF08=  0>
        IFNDEF  RKFULL          <RKFULL=0>
        IFNDEF  RK8E            <RK8E=  0>
        IFNZRO  RK8E                    <
        IFNDEF  RKNUM   <RKNUM= 2>
        RK1=    RKNUM&1%1
        RK2=    RKNUM&2%2
        RK4=    RKNUM&4%4
        IFNZRO  RKFULL          <
        SYSADJ= 1               /RKFULL SYSTEMS ARE ADJUSTABLE
        IFNZRO  RK4     <
        ERROR   RK4     >       /ILLEGAL CONFIGURATION!
                                >
                                        >
        IFNDEF  RX8B            <RX8B=  0>
        IFNDEF  RX8BH           <RX8BH= 0>
        IFNDEF  RX8BX           <RX8BX= 0>
        IFNDEF  SYK7KX          <SYK7KX=0>
        IFNDEF  TC01            <TC01=0>
        IFNDEF  TC12            <TC12=  0>
        IFNDEF  TDROM           <TDROM= 0>
        IFNDEF  TD8E            <TD8E=  0>

/INCLUDE IN THIS EXPRESSION ALL SYSTEMS THAT NEED EXTENDED MEMORY
        FOO=    RK8E&RKFULL+LINC8X+RX8B+RX8BX+SYK7KX+TD8E

        IFNZRO  FOO             <
        IFNDEF  HFIELD  <
        HFIELD= 10      >       /DEFAULT HFIELD SIZE FOR THOSE THAT NEED IT
                                >
        IFNDEF  HFIELD          <HFIELD=4000>

/THE FOLLOWING EXPRESSIONS ARE BROKEN INTO 2 PARTS BECAUSE
/THE CRUMMY OS/8 ASSEMBLER CAN'T HACK IT !

        FOO=    TC01+DF32+DF32D+DYNEX+RX8B+RX8BH+RX8BX+IPB+SYK7KX
        FOO=    FOO+TC12+LINC8+LINC8X+RF08+RK8E+TDROM+TD8E

        IFZERO  FOO             <TC01=  1>

        FOO=    TC01+DF32+DF32D+DYNEX+RX8B+RX8BH+RX8BX+IPB+SYK7KX
        FOO=    FOO+TC12+LINC8+LINC8X+RF08+RK8E+TDROM+TD8E

        IFNZRO  FOO-1   <
        XLIST   ON              /MAKE SURE MISTAKES ARE PRINTED
        ERROR   -1      >       /BOTCHED ASSEMBLY PARAMETERS
        XLIST   ON
/       USER FILE SPECIFICATION

/       GIVE THE NUMBER OF USER FILES DESIRED
/       MAXIMUM IS 84 (NOT INCLUDING "$" AND "%" FILES
/       ALL PHYSICAL SPACE REMAINING AFTER USER CATALOG
/       WILL BE USED FOR THE EXTENDED CATALOG

        DECIMAL

/       INSERT # OF USER FILES HERE

        UFILES= 84              /USE MAXIMUM AMOUNT

        OCTAL

        XLIST   OFF
        IFNDEF  UFILES  <UFILES=124>
        IFNZRO  124-UFILES&4000 <
        XLIST   ON              /PRINT ALL MISTAKES
        ERROR   124             >
        XLIST   ON

/       CUSTOM BINARY LOADER SPECIFICATION
/       A CUSTOMIZED BINARY LOADER WILL BE THE DEFAULT TYPE
/       IF A CUSTOMIZED (SLURP) LOADER IS FEASIBLE FOR THE
/       PARTICULAR SYSTEMS DEVICE. THE VERY LONG (/V)
/       LOADER WILL ALWAYS BE PROVIDED IN LIEU OF A SLURP LOADER
/       IF NONE IS AVAILABLE
/       CURRENT DEVICES SHOULD BE PUT INTO THE FOLLOWING EXPRESSION
/       IF THEY SUPPORT A SLURP LOADER WITHIN THE BIN SUB-SYSTEM:
        
        SLURP=  TC01+DF32+RX8B+RX8BH+RX8BX+TC12+LINC8+LINC8X
        SLURP=  SLURP+SYK7KX+IPB+TDROM+TD8E

/       THIS PARAMETER WILL BE USED TO FORCE /V IF ZERO, ELSE /V
/       IS AVAILABLE AS AN OPTION TO THE USER AT THE STANDARD TRADEOFFS

/       CONSOLE TERMINAL DEVICE CODE SPECIFICATION

/       DEFINE TTY=     DEVICE CODE OF KEYBOARD (PRINTER CODE IS
/                       ASSUMED TO BE ONE MORE)

/       DEFAULT IS 03   (KEYBOARD=03, TELEPRINTER=04)
        XLIST   OFF
        IFNDEF  TTY     <TTY=   03>
        XLIST   ON

        TTY=    TTY             /DEVICE CODE BASE
        KEYCODE=TTY^10+6000     /SKELETON KEYBOARD CODE
        PRTCODE=TTY+1^10+6000   /SKELETON PRINTER CODE
        KCCIOT= KEYCODE+2       /CLEAR AC, KEYBOARD FLAG, START READER
        KRBIOT= KEYCODE+6       /LOAD AC WITH CHARACTER, CLEAR FLAG, START READER
        KRSIOT= KEYCODE+4       /OR AC, CHARACTER
        KSFIOT= KEYCODE+1       /SKIP ON KEYBOARD FLAG
        TLSIOT= PRTCODE+6       /LOAD PRINTER BUFFER, CLEAR FLAG, START PRINT CYCLE
        TSFIOT= PRTCODE+1       /SKIP ON TELEPRINTER FLAG
/       BLOCK LAYOUT OF THE  P ? S  STARTER SYSTEM



/       BLOCK   GENERATION CORE LOADING CORE    MAJOR FUNCTION
/       -----   --------------- ------------    ----- --------


/       0        7400-7577      7600-7777       BOOTSTRAP, SYSTEM I/O, ETC.
/       1-13     0000-2577      0000-2577       KEYBOARD MONITOR
/       14       2600-2777      2600-2777       THE "EDIT" COMMAND
/       15-16    1000-1377      7000-7377       USER CATALOG
/                              (3000-3377)
/       17      15600-15777     7400-7577       TTY: EDITING FEATURES, ETC.
/                              (3400-3577)
/       20-37    1000-1777 (4X)    N.A.         "%" SCRATCH FILE
/       40-57    1000-1777 (4X)    N.A.         "$" SCRATCH FILE
/       60      16200-16377        N.A.         /I BLOCK
/       61       3600-3777      3000-3177       THE "R" COMMAND PROCESSOR
/       62       3400-3577      1200-1377       THE EXTENDED COMMAND PROCESSOR
/       63-66    3000-3127      3400-4377       SYSTEMS CATALOG
/               (1000-1777)    (1400-1577)
/       67-71    1000-1577      4400-5177       EXTENDED USER'S CATALOG
/       72-74   16400-17177    H7200-H7777      EXTENDED MEMORY HANDLER CODE
/              (H7200-H7777)
/       75      16000-16177     3000-3177       BATCH RECOVERY BLOCK
/       76         N.A.         2600-2777       ACTIVE COPY OF BATCH SAVED IN THIS BLOCK
/                              (3200-3377)
/       77         N.A.         7400-7577       LAST BATCH BUFFER SAVED IN THIS BLOCK
/                              (3400-3577)
/       100        N.A.         7600-7777       SYSTEM I/O, SETTINGS, FILE POINTERS SAVED HERE
/                              (3600-3777)
/       101        N.A.         0000-0177       PAGE ZERO USER SETTINGS SAVED HERE
/                              (4000-4177)
/       102-116 10000-13177     0000-3177       RESERVED FOR SYSTEM ODT
/       117      2400-2527      2400-2577       MODIFIED COMMAND
/               (3000-3127)                     TABLE AND BATCH
/               +3130-3177                      ONCE ONLY CODE
/       120      3200-3377      2600-2777       BATCH ONCE-ONLY CODE+BATCH SYSTEM PROPER
/       121-146  4000-6377      0000-2377       BINARY LOADER, GET, START, SCRATCH AREA
/       147-155 13200-14777     0000-1577       DUMP SYSTEM
/       156        N.A.            N.A.         FIRST FREE BLOCK FOR USER CATALOG
        *0

        IFNZRO  .       <ERROR  .>
UNIT,   BTUNIT                  /UNIT NUMBER FOR SSYMIO
TPTR1,  JMP I   L7600           /BOOTSTRAP ON POWER RESTART OR INTERRUPT
TPTR2,  -10                     /TEMPORARY;INITIALIZED FOR BOOTSTRAP TTY: TIMEOUT
L37,    37                      /CONSTANT 0037
FNAME,  7700                    /DEFAULT FILE NAME
CTMSIZE,SCRSIZE                 /POINTER TO CORE SIZE WORD FOR ONCE-ONLY CODE
COR777, 777                     /SIZE-UP ROUTINE TEMPORARY CONSTANT
L3,     3                       /USED TO TERMINATE FNAME;MUST BE LESS THAN 0100

                *10             /DEFINE AUTO-INDEX AREA

        IFNZRO  10-.    <ERROR  .>
L77,    TEMP1-1                 /CONSTANT 0077;MUST BE POSITIVE!
XR1,    .-.                     /AUTO INDEX NUMBER 1
XR2,    VERSION^100+REVISION    /AUTO INDEX NUMBER 2
L7741,  7741                    /CONSTANT 7741
L7766,  7766                    /CONSTANT 7766
L7772,  7772                    /CONSTANT 7772
L7774,  7774                    /CONSTANT 7774
RADXSW, -12                     /RADIX SWITCH

        *20                     /GET PAST AUTO-INDEX AREA

        IFNZRO  20-.    <ERROR  .>
CHAR,   .-.                     /INPUT BUFFER;ALSO USED AS A TEMPORARY
L7757,  7757                    /CONSTANT 7757
BUFEND, FILBEG+3775             /FILE BUFFER
BUFINFO,FILBEG+3774             /POINTERS
SLINUM, .-.                     /STARTING LINE NUMBER
DIREND, CATADR+377              /POINTER TO DIRECTORY END
GETNDX, .-.                     /DON'T MOVE THIS UNLESS YOU KNOW WHY
ECHOSW, 0                       /ECHO SWITCH
FIZZ1,  FILBEG+3776             /FILE LINE NUMBER POINTER
FIZZ2,  FILBEG+3777             /FILE TEXT POINTER
FLIPECH,ECHOFLP                 /POINTER TO ECHO FLIPPER
GETBASE,0                       /GET HALFWORD BASE;INITIALIZED FOR SIZE-UP ROUTINE
GLINE,  XGLINE                  /GET A LINE OF INPUT ROUTINE
INPUT,  TTYR                    /MASTER INPUT POINTER
TUNIT,  XTUNIT                  /TEST FOR :UNIT SPECIFICATION

SSYMIO, .-.                     /UNIT FIXUP I/O ENTRY
        IFNZRO  40-.    <ERROR  .>
L7770,  7770                    /CLA + HARMLESS SKIP (MAYBE)
L15,    15                      /HARMLESS AND TO PROTECT SKIP
        TAD     SSYMIO          /STORE CALLING ADDRESS
        DCA I   SSYSIO          /IN REAL ENTRY POINT
