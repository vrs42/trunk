        JMP     SEXIT           /YES
        DCA I   RRXPGCT         /NO, SAVE UPDATED COUNT
        CIF     ROMFLD          /BACK TO US
        JMP I   RRENTER         /GO DO NEXT PAGE TRANSFER
RREAD,  CIF     00              /SKIP
        JMS     RDQUAD          /AROUND
        CIF     00              /CONTROL
        JMS     RDQUAD          /WORDS
        CIF     00              /GET
        JMS     RDQUAD          /CHECKSUM
        AND     RR77            /JUST
        TAD     RR7700          /GOOD BITS
        DCA I   RRCKSUM         /SAVE INITIAL CHECKSUM
RRDLP,  CIF     00              /GET A
        JMS     RDQUAD          /WORD
        CIF     00              /CHECKSUM
        JMS     EQUFUN          /IT
        CIF     00              /STORE
        JMS     SPUT            /IT
RPTRET, CDF     00              /BACK TO FIELD 0 IN CASE EXTENDED XFER
        ISZ I   RRXPTR          /BUMP BUFFER POINTER
RR300,  300                     /JUST IN CASE
        ISZ I   RRXWCNT         /DONE 128 WORDS YET?
        JMP     RRDLP           /NO, GO BACK
        CIF     00              /READ
        JMS     RDQUAD          /LAST WORD
        CIF     00              /CHECKSUM
        JMS     EQUFUN          /LAST WORD
        CIF     00              /GET
        JMS     RDQUAD          /CHECKSUM WORD
        AND     RR7700          /JUST GOOD BITS
        CIF     00              /INCLUDE IN
        JMS     EQUFUN          /CHECKSUM ALSO
        JMP     RCHECK          /NOW
WRQ,    CIF     00              /COMES FROM WRQUAD ROUTINE
        JMS     EQUFUN          /CHECKSUM THE WORD
        SDSQ                    /WAIT FOR COMPLETION
