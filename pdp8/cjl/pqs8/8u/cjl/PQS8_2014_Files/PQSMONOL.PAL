RCHLOOP,CHLOOP                  /POINTER TO CHLOOP
RALTCH, "$&177                  /DEFAULT <ESC> INDICATOR
RDELIM, "\&177                  /DEFAULT <RO> DELIMITER
        IFNZRO  .-RDELIM-1      <ERROR  .>
BACKSP, TAD     GETNDX          /\
        DCA     RTEMP2          / \SAVE GETHAF POINTERS
        TAD     GETBAS          / /FOR EDIT COMMAND
        DCA     RTEMP3          //
        STA                     /GET A MINUS 1
        TAD     PUTNDX          /ADD PUT OFFSET VALUE
        SPA                     /AT <BOL>?
