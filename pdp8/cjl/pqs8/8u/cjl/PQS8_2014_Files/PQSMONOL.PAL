        STA                     /ALSO
        DCA I   RRCKSUM         /SETUP CHECKSUM
RWRLP,  CIF     00              /TO FIELD 0
        JMS     SGET            /GET A WORD
        CIF CDF 00              /BACK TO FIELD 0
        JMS     WRQUAD          /AND WRITE IT ON TAPE
        ISZ I   RRXPTR          /BUMP UP POINTER
RR77,   77                      /JUST IN CASE
        ISZ I   RRXWCNT         /DONE 128 YET?
        JMP     RWRLP           /NO, GO BACK
        CIF     00              /BACK TO FIELD 0
        JMS     WRQUAD          /WRITE 129TH WORD AS 0
        JMP     RCHECK          /NOW CHECK IT OUT
WRCHEK, CIF     00              /BACK TO FIELD 0
        JMS     WRQUAD          /SEE THAT
