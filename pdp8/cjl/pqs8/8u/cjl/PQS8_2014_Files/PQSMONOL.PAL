/DF32 DISK SYSTEM I/O HANDLER
SBOOT,  JMS     SYSIO           /CALL I/O ROUTINES TO BOOTSTRAP
S7600,  7600                    /READ INTO 7600
        2000                    /20 BLOCKS WORTH
        0000                    /STARTING AT BLOCK 0
SWAL,   .-.                     /SWITCHES /A-/L
SWMX,   .-.                     /SWITCHES /M-/X
SWY9,   .-.                     /SWITCHES /Y-/9
SOUTFLS,SBTMOV                  /NUMBER OF OF OUTPUT FILES (INITIALIZED FOR BOOTSTRAP)
SDATE,  .-.                     /SYSTEM DATE WORD
SCRSIZE,.-.                     /SOFTWARE CORE SIZE

S3700,  3700                    /DEAL MASK

SWAIT,  SERR2-1                 /WAIT ROUTINE PRELOADED FOR BOOTSTRAP
        DFSE                    /SKIP IF NO ERRORS
        JMP     .+4             /JUMP IF ANY
        DFSC                    /SKIP IF DONE
        JMP     .-3             /JUMP IF NOT
        SKP                     /DON'T BUMP IF NO ERRORS
        ISZ     SWAIT           /BUMP TO ERROR RETURN
        JMP I   SWAIT           /RETURN TO WHICH EVER

/INTERRUPT PROCESSOR FOR FOCAL, ETC.
SINTER, CLA CLL                 /CLEAN UP JUST IN CASE
        DFSE                    /ANY ERRORS?
        DCA     SERFLG          /YES, INDICATE SO
        DFSC                    /TRANSFER COMPLETE?
        SKP                     /NO, DO NOTHING
        DCMA                    /YES, CLEAR ALL FLAGS
        JMP I   SDSINT          /BACK TO MAIN INTERRUPT PROCESSOR SUCH AS FOCAL'S, ETC.

/SYSTEM LOADER
SLOAD,  JMS     SYSIO           /SYSTEM LOADER CALLS I/O ROUTINES
SCORE,  0                       /THESE
SFUN,   WRITE                   /ARGUMENTS
SBLOCK, BINADR                  /ARE PRELOADED
        JMP I   .+1             /TO SAVE
SYSTART,SBOOT                   /ALL OF CORE
SYSIO,  INPBUF-1                /PRELOADED FOR BOOTSTRAP
        NL0002                  /GET CIF BIT
        RDF                     /ADD ON CALLING FIELD
        TAD     SCDF            /MAKE INTO CIF CDF CALLING FIELD INSTRUCTION
        DCA     SOUT            /PUT INTO EXIT ROUTINE
SRETRY, STA                     /CLEAR FLAG
        DCA     SERFLG          /OF ERRORS
        JMP     .+3             /NOW GET ARGUMENTS

/INTERRUPT PROCESSOR ENTERS HERE
SDSINT, .-.                     /INTERRUPT PROCESSOR ENTERS BY A JMS
        JMP     SINTER          /JUMP TO REAL ROUTINE

        STA                     /-1
        TAD I   SYSIO           /ADD ON CORE ARGUMENT
        DCA     SCAA            /TO CURRENT ADDRESS
        ISZ     SYSIO           /BUMP TO NEXT ARGUMENT
        TAD I   SYSIO           /GET FUNCTION WORD
        RAL                     /PUT READ/WRITE BIT INTO LINK
        AND     S7600           /ISOLATE PAGE BITS
        SZA                     /SKIP IF 4096 WORD TRANSFER
        CIA                     /INVERT AND
        DCA     SWC             /SETUP WORD COUNT
        RTL                     /GET READ/WRITE BIT TO BIT[10]
        TAD     S6603           /AC NOW = DMAR OR DMAW
        DCA     SDSKIN          /PUT INLINE
        TAD I   SYSIO           /GET FUNCTION WORD AGAIN
        AND     S70             /JUST FIELD BITS
        DCA     SFIELD          /SAVE THEM
        TAD I   SYSIO           /GET FUNCTION WORD AGAIN
        ISZ     SYSIO           /BUMP TO BLOCK NUMBER ARGUMENT
        AND     S7              /JUST UNIT BITS
        SZA                     /SKIP IF UNIT ZERO ONLY
        JMP     SERR            /BARF
        TAD I   SYSIO           /GET BLOCK NUMBER
        RAL                     /MOVE TO DISK EXTENSION BITS
        AND     S3700           /ISOLATE THEM
        TAD     SFIELD          /BUILD REGISTER BITS UP WITH DESIRED FIELD
        DEAL                    /LOAD EXTENDED ADDRESSING REGISTER
        DEAC                    /DISK ON LINE?
        NOP                     /JUST IN CASE
        RTR                     /MOVE NON-EXISTANT DISK BIT TO LINK
        SZL CLA                 /SKIP IF OK
        JMP     SERR2           /JUMP IF BAD
        TAD I   SYSIO           /GET BLOCK NUMBER AGAIN
        RTR                     /\
        RTR                     / \CALCULATE FIRST
        RTR                     / /LOW ORDER ADDRESS
        AND     S7600           //
SDSKIN, DMAR                    /NOW DO READ OR WRITE
        JMS     SWAIT           /WAIT FOR COMPLETION
        JMP     SDONE           /COMES HERE IF NO ERRORS
SERR2,  DEAC                    /GET ERRORS
        NOP                     /JUST IN CASE
SERR,   HLT                     /HALT HERE
        NL7776                  /BACKUP
        TAD     SYSIO           /CALLING
        DCA     SYSIO           /ADDRESS
        JMP     SRETRY          /TRY, TRY AGAIN

SDONE,  DCMA                    /CLEAR THE DISK NOW IN CASE ERROR
        ISZ     SERFLG          /ANY ERRORS WHILE INTERRUPTS OCCURED?
        JMP     SERR2           /YES, FIND OUT WHAT
        ISZ     SYSIO           /BUMP PAST LAST ARGUMENT
SOUT,   CIF CDF 00              /RETURN TO CALLING FIELD
        CLA CLL                 /WHY NOT?
        JMP I   SYSIO           /RETURN TO CALLER

SERFLG, 7777                    /-1 = NO ERRORS, ERRORS OTHERWISE
SFIELD, 0                       /TRANSFER FIELD TEMPORARY
SCDF,   CDF     00              /CDF CONSTANT
S6603,  DMAR                    /I/O CONSTANT
S70,    70                      /FIELD MASK
S7,     7                       /UNIT MASK

        ZBLOCK  7750-.          /EMPTY SPACE

SWC,    SCAA&177+4000           /FOR BOOTSTRAP
SCAA,   SCAA                    /LIKEWISE
        JMP     SBOOT           /I'M SURE

        ZBLOCK  7756-.          /MORE EMPTY SPACE

SPARM,  .-.                     /PARAMETER GOES HERE
SFILES, .-.                     /FILE ARGUMENTS START HERE

        SPMST=  .               /END OF I/O ROUTINES
        NOPUNCH

        *.&177+6604             /WHERE PS/8 TYPE BOOTSTRAP PUTS THIS

        ENPUNCH

SBTMOV, CLA+400                 /CLEAR JUST IN CASE
        TAD I   SBOOT1          /MOVE A WORD
        DCA I   SBTMOV          /TO RIGHT PLACE
        ISZ     SBOOT1          /ZAP POINTER
