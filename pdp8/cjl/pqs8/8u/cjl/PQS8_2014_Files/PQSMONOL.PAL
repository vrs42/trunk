S70,    70                      /FIELD MASK

SLOAD,  JMS     SYSIO           /SYSTEM LOADER CALLS I/O ROUTINES
SCORE,  0                       /DEFAULT CORE IS TO SAVE CORE
SFUN,   WRITE                   /AS IS FUNCTION WORD,
SBLOCK, BINADR                  /BLOCK ARGUMENT
        JMP I   SYSTART         /AND
SYSTART,SBOOT                   /STARTING ADDRESS
SYSIO,  INPBUF-1                /I/O ENTRY POINT
        NL0002                  /SET CIF BIT
        RDF                     /GET CALLING FIELD
        TAD     SCDF            /NOW HAVE CIF CDF CALLING FIELD INSTRUCTION
        DCA     SDONE           /PUT INTO EXIT ROUTINE
        TAD I   SYSIO           /GET CORE ARGUMENT
        DCA     SKORE           /JUST PUT IT IN
        ISZ     SYSIO           /BUMP TO NEXT ARGUMENT
        TAD I   SYSIO           /GET FUNCTION WORD
        AND     S70             /EXTRACT FIELD BITS
        TAD     SCDF            /FORM CDF TO TRANSFER FIELD
        DCA     SWPFLD          /PUT INTO SWAP CODE
        TAD I   SYSIO           /GET FUNCTION WORD AGAIN
        RAR                     /MOVE U BIT TO LINK
        AND     S3              /ISOLATE EXTENDED UNIT BITS
        DCA     STEM            /SAVE THEM
        TAD I   SYSIO           /GET FUNCTION WORD ONCE MORE
        RTL                     /U GOES TO BIT[10], READ/WRITE BIT GOES TO BIT[11]
        AND     S3              /ISOLATE U, READ/WRITE BITS
        CLL RTL                 /MOVE TO RIGHT BITS
        TAD     SRDINS          /ADD ON RDE INSTRUCTION
        DCA     STAPINS         /SAVE INLINE
        TAD I   SYSIO           /GET FUNCTION WORD AGAIN
        RAL                     /FORM PAGE COUNT
        AND     S7600           /JUST PAGE BITS
        DCA     SPAGCT          /SAVE THEM
        TAD     SWPFLD          /AT LEAST WE DIDN'T USE SAVTEM THIS TIME!
        AND     S70             /JUST FIELD BITS
        CLL RTL                 /MOVE THEM AND
        STL IAC RTL             /FORM NOPAUSE,
        RTL                     /EXTENDED ADDRESSING BITS
        TAD     STEM            /ADD ON EXTENDED UNIT BITS
        DCA     SAXO            /SAVE INLINE
        ISZ     SYSIO           /BUMP TO BLOCK NUMBER
        TAD I   SYSIO           /GET BLOCK NUMBER
        DCA     SBLK            /PUT INLINE
        SKP                     /DON'T STOP NOW
SERR,   HLT                     /BARF
SNEXT,  CIF CDF 00              /TO PREVENT LINCY INTERRUPTS
        TAD     SKORE           /GET CORE ADDRESS
        LINC                    /GOTO SUPER (JB) MODE
        TMA                     /GIVE TRANSFER ADDRESS TO TC12
        LDA II                  /GET AC LOADED (HIC !)
SAXO,   30                      /NOPAUSE, EXTENDED ADDRESS, FIELD, UNIT BITS
        AXO                     /WATCH THAT AXO, EUGENE
STAPINS,RDE                     /RDE OR RDE U OR WRI OR WRI U
SBLK,   0                       /THIS BLOCK IS OPERATED ON
        LDA II                  /AC IS MEMBER OF AA (ACCUMULATORS ANONYMOUS)
SKORE,  .-.                     /TRANSFER ADDRESS
        PDP                     /BACK TO GOODY MODE
        TAD     S200            /ADD ON CURRENT BUFFER
        DCA     STEM            /SAVE ADDRESS OF ENDANGERED WORD
        JMP     SWPFLD          /GO SAVE IT AND WAIT FOR TRANSFER

SCHECK, CLL IAC                 /SET LINK IF NO PARITY ERROR
