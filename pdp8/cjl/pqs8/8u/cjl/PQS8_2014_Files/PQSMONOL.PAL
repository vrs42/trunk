SYSTART,SBOOT                   /THIS STARTING ADDRESS
SYSIO,  INPBUF                  /I/O ENTRY PRELOADED WITH RETURN
        CLA IAC                 /GET ION BIT
S6000,  SKON                    /SKIP NEXT IF INTERRUPT ON, TURN IT OFF
        IAC                     /CHANGE TO IOF BIT
        TAD     S6000           /ADD ON PROCESSOR IOT
        DCA     SINTXT          /SAVE IN EXIT ROUTINE
        JMP     SYS1            /NOW PROCESS PARAMETERS PASSED TO SYSIO

SGET,   .-.                     /LOAD DATA FROM BUFFER ROUTINE
SFLD1,  CDF     00              /CIF CDF TO APPROPRIATE FIELD GOES HERE
        TAD I   SXPTR           /DO AS ROMULUS TELLS US
        CIF     ROMFLD          /BACK TO HIM
        JMP I   SGET            /TO COMMAND IS TO OBEY

SPUT,   RPTRET                  /PUT DATA INTO BUFFER ROUTINE
SFLD2,  CDF     00              /CIF CDF TO APPROPRIATE FIELD GOES HERE
        DCA I   SXPTR           /YES, MASTER
        CIF     ROMFLD          /MASTER, I
        JMP I   SPUT            /WILL BE LOYAL

SERROR, JMP     SWAL/CLA CLL    /CLEAR LINK, AC FOR RETRY
SERR,   HLT                     /BARF
        CIF     ROMFLD          /BACK TO THE ROM
        JMP I   SRGO            /TRY, TRY AGAIN

SYS3,   TAD     SUNIT           /GET CURRENT UNIT BIT
        CIF     ROMFLD          /GOTO THE ROM
        JMP I   STRY            /THROUGH HERE

SRGO,   RGO                     /POINTER TO ROM GO ROUTINE

WRQUAD, .-.                     /WRITE A 12-BIT WORD ROUTINE
        CIF     ROMFLD          /BACK TO A DEDICATED
        JMP     WRQ             /ROUTINE TO WRITE AND CHECKSUM
SCIFR,  CIF     ROMFLD          /COMES BACK MAGICALLY
        JMP I   WRQUAD          /RETURN TO ROM CALLING ROUTINE

RDQUAD, .-.                     /READ A 12-BIT WORD ROUTINE
        SDSQ                    /WAIT FOR
        JMP     .-1             /4 LINES
        SDRD                    /READ IT IN
        CIF     ROMFLD          /NOW BACK TO THE ROM
        JMP I   RDQUAD          /RETURN
EQUFUN, .-.                     /EQUIVALENCE CHECKSUM ROUTINE
        CMA                     /ACTUALLY CHECKSUMS
        DCA     EQUTMP          /ON DECTAPE ARE EQUIVALENCE OF
        TAD     EQUTMP          /ALL WORDS IN A BLOCK 6 BITS AT A TIME
        AND     SCKSUM          /SINCE EQUIVALENCE IS ASSOCIATIVE
        CIA                     /WE DO IT 12 BITS AT A TIME
        CLL RAL                 /AND CONDENSE LATER
        TAD     EQUTMP          /IDENTITIES USED ARE:
        TAD     SCKSUM          /A+B=(A.XOR.B)+2*(A.AND.B)
        DCA     SCKSUM          /A.EQV.B=.NOT.(A.XOR.B)=A.XOR.(.NOT.B)
        TAD     EQUTMP          /A.EQV.B=(A+(.NOT.B))-2*(A.AND.(.NOT.B))
        CLL CMA                 /Q. E. D.
        CIF     ROMFLD          /BACK TO THE ROM
        JMP I   EQUFUN          /RETURN

SEXIT,  TAD     SUNIT           /STOP THE
        SDLC                    /TAPE DRIVE
SINTXT, IOF                     /OR ION
SOUT,   CIF CDF 00              /RETURN FIELD GOES HERE
        JMP I   SYSIO           /RETURN TO CALLER

S70,    70                      /FIELD MASK
STRY,   F2SET+5                 /RETRY COUNT
SXUNIT, 0                       /UNNEEDED EXTRA UNIT TEMPORARY
SXFUN,  0                       /MUST BE NON-NEGATIVE FOR BOOTSTRAP
SCKSUM, .-.                     /CHECKSUM
SBLK,   0                       /MUST BE ZERO FOR BOOTSTRAP
SUNIT,  0                       /MUST BE 0 FOR BOOTSTRAP

SYS2,   TAD I   SYSIO           /GET FUNCTION WORD AGAIN
        RAR                     /MOVE UNIT BIT TO LINK
        CLA RAR                 /MOVE UNIT BIT TO HIGH ORDER
        DCA     SUNIT           /SAVE AS SYSIO UNIT
        ISZ     SYSIO           /BUMP TO BLOCK ARGUMENT
        TAD I   SYSIO           /GET BLOCK NUMBER
        DCA     SBLK            /SAVE IN ROM'S BLOCK TEMPORARY
        ISZ     SYSIO           /BUMP TO FINAL RETURN
SCIDF,  CIF CDF 00              /DATA FIELD MUST BE ZERO
        JMP     SYS3            /FINISH UP THERE
EQUTMP, .-.                     /EQUIVALENCE FUNCTION TEMPORARY
SBPTR,  SBOOT                   /INITIALIZED FOR BOOTSTRAP
SXPGCT, 20^200                  /BOOTSTRAP READS IN BLOCKS 0-17
SXPTR,  .                       /COPY OF BUFFER POINTER
SXWCNT, .                       /WORD COUNT
SSPACE, ZBLOCK  1               /EXTRA WORD
SPARM,  TAD     SFIX1-20        /GET FIXUP VALUE
SFILES, DCA     SFLD1           /RESTORE IT
        TAD     SFIX2-20        /GET SECOND FIXUP WORD
        DCA     SFLD2           /RESTORE IT
        TAD I   SBOOT1-20       /GET A WORD
        DCA I   SBOOT2-20       /PUT A WORD
        ISZ     SBOOT1-20       /BUMP TO NEXT
        ISZ     SBOOT2-20       /DONE YET?
        JMP     .-4-20          /NO, GO BACK
        JMP I   SYSTART-20      /YES, GO START IT UP

SBOOT1, ROMBOOT                 /WHERE IT IS
SBOOT2, SBOOT                   /WHERE IT SHOULD BE
SFIX1,  RGO                     /FIRST FIXUP VALUE
SFIX2,  JMP I   WRQUAD          /SECOND FIXUP VALUE

SFIX3,  CIF     ROMFLD          /BACK TO THE ROM
        JMP I   .+1             /NOW KEEP GOING
        RWCOM+4                 /THROUGH HERE

/       TD-8/E, ROM DEFINITIONS

        RMBOOT= 7470            /ROM BOOTSTRAP STARTS HERE
        ROMBOOT=7360            /WHERE ROM LOADS BOOTSTRAP FOR TD-8/E
        ROMCODE=77^10           /DEVICE CODE FOR TD-8/E ROM SYSTEM
        ROMFLD= 70              /MEMORY EXTENSION BITS FOR FIELD OF ROM
        SDLC=   6004+ROMCODE    /SIMPLE DECTAPE LOAD CONTROL REGISTER
        SDLD=   6005+ROMCODE    /SIMPLE DECTAPE LOAD DATA REGISTER
        SDRC=   6006+ROMCODE    /SIMPLE DECTAPE READ CONTROL REGISTER
        SDRD=   6007+ROMCODE    /SIMPLE DECTAPE READ DATA REGISTER
        SDSQ=   6003+ROMCODE    /SIMPLE DECTAPE SKIP ON QUAD LINE FLAG
        SDSS=   6001+ROMCODE    /SIMPLE DECTAPE SKIP ON SINGLE LINE FLAG
        SDST=   6002+ROMCODE    /SIMPLE DECTAPE SKIP ON TIME (RATE) ERROR

