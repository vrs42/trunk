/       THIS CODE RESIDES IN THE INPUT BUFFER AND WILL BE DESTROYED!

INPBUF, TAD I   LOOKUP          /\
        JMS I   PMOVE           / \MOVE CATALOG UP
        FILBEG                  / /WHERE IT BELONGS
        CATADR                  //
        JMS I   SIZCOR          /GO SET UP MEMORY CONFIGURATION WORD
TIMOUT, ISZ     SIZCOR          /WAIT A
        JMP     TIMOUT          /WHILE
        ISZ     TPTR2           /DONE WAITING?
        SKP                     /NO
        TLSIOT                  /YES, SO OUTPUT A <NUL>
        TSFIOT                  /FLAG UP YET?
        JMP     TIMOUT          /NO, JUST KEEP WAITING FOR IT
        ISZ I   TSPACE          /IS BATCH RUNNING?
        JMP     BATLOD          /YES, RELOAD BATCH STUFF
        KSFIOT                  /IS FLAG UP?
        JMP     NOTUPC          /NO, CAN'T BE <^C>
        KRBIOT                  /READ IT IN
        AND I   XGETHAF+1       /JUST 7-BIT
        TAD     L7775           /COMPARE TO <^C>
        SZA CLA                 /SKIP IF EQUAL
        JMP     NOTUPC          /FORGET IT
        JMS I   NAMPRT          /PRINT
        UPC                     /<^C>
NOTUPC, JMS I   PR6BIT          /GO TO NEXT LINE

        ZBLOCK  2563-.          /FOR ALIGNMENT WITH VT-8/E OVERLAY

BATBAK, JMP I   STNEXT          /DO A SCRATCH OR LOAD $

BATLOD, JMS I   SSYSIO          /\
        BATRL                   / \
        BTRLEN^100              /  >READ IN BATCH RECOVERY ROUTINE AND BRANCH TO IT
        BTRLBLK                 / /
        JMS I   .-3             //

L7775,  7775                    /CONSTANT 7775

        ZBLOCK  2576-.          /EMPTY SPACE

SIZCOR, SETSCS                  /POINTER TO SOFTWARE CORE SIZE SETUP ROUTINE
STNEXT, NEWBUF                  /OR LOAD+2 IF LOADING "$"
