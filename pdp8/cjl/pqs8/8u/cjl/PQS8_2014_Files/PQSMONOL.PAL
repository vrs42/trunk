        ENPUNCH

SBOOT2, TAD     SOUTFLS                 /GET JMP INSTRUCTION
        DCA     SCIDF                   /ZAP IT IN
        TAD     SDIR                    /GET HELPER BLOCK NUMBER
        DCA     SBLK                    /WILL SEARCH FOR IT
        JMP     SEARCH                  /GO DO IT

SBOOT3, CDF     HFIELD                  /TO HELPER FIELD NOW
        DCA I   SBTPT2                  /STORE A WORD UP THERE
        ISZ     SBTPT2                  /BUMP TO NEXT
        JMP     SWAL                    /GO GET NEXT
        TAD     .+2                     /RESTORE
        DCA     SCIDF                   /ZAPPED INSTRUCTION
        CIF CDF 00                      /BACK TO FIELD 0
        JMP     SBOOT                   /NOW REALLY BOOTSTRAP

SBTPT2, SBOOT-2-1                       /POINTER FOR EXTENDED LOAD

        NOPUNCH

        *.+SRELOC-SBOOT                 /WHERE THIS LOADS

        ENPUNCH

SRLOC8, SRELOC                          /POINTER TO WHERE CODE IS NOW

        NOPUNCH

        *.+SBOOT-SRELOC                 /RESTORE ORIGIN;BETTER BE MINUS OR ZERO

        ENPUNCH
/SECOND PAGE OF TD-8/E SYSTEM I/O ROUTINES

        FIELD   1               /WHERE IT GENERATES

        *HSTART+400             /WHERE IT IS WRITTEN OUT FROM

        NOPUNCH                 /FOOL THE ASSEMBLER

        FIELD   HFIELD%10       /USE EXTENDED MEMORY FOR REAL

        *SBOOT                  /SAME PLACE IN BOTH FIELDS

        ENPUNCH                 /UN-FOOL THE ASSEMBLER

SGTCHK, .-.                     /GET CHECKSUM ROUTINE
SS7600, CLA+400                 /CLEAN UP
        TAD     SCKSUM          /GET CURRENT CHECKSUM
        CLL RTL                 /MOVE THIS
        RTL                     /LOWER HALF
        RTL                     /TO EQUIVALENCE WITH HIGH HALF
        JMS     EQUFUN          /FORM HIGH CHECKSUM
        CLA STL                 /CLEAN UP;LINK NEEDED LATER
        TAD     SCKSUM          /GET CHECKSUM
        AND     S7700           /JUST GOOD BITS
        JMP I   SGTCHK          /RETURN

RDQUAD, .-.                     /READ A WORD ROUTINE
        SDSQ                    /WAIT FOR
        JMP     .-1             /4 LINES
        SDRD                    /READ IT IN
        JMP I   RDQUAD          /RETURN

/MANUAL BOOTSTRAP STARTS HERE
SMBOOT, NL2000                  /SET REVERSE
        JMS     SGET1           /GO FIND END ZONE
S6201,  CDF     00              /RELOADING FIELD 0
        JMS     SGET1           /GO FIND BLOCK 0 CHECKSUM WORD
SLOOP,  JMS     RDQUAD          /GET A WORD
        DCA I   SBOOTPT         /PUT A WORD
        ISZ     SBOOTPT         /BUMP TO NEXT 'TIL DONE
        JMP     SLOOP           /GO BACK FOR NEXT
        CIF     00              /GOTO FIELD 0
        JMP     SBOOT2          /BOOTSTRAP FOR REAL
SGET1,  .-.                     /GET NEXT MARK ROUTINE
SS1000, TAD     SS1000          /ADD ON GO BIT
        SDLC                    /START UP THE TAPE
SRCH,   SDSS                    /WAIT FOR
        JMP     .-1             /ONE LINE
        SDRC                    /READ MARK BITS IN
        AND     S77             /JUST MARK BITS
        TAD     SMRKOD          /COMPARE TO DESIRED MARK
        SZA CLA                 /SKIP IF FOUND
        JMP     SRCH            /JUMP IF NOT
        ISZ     .-3             /BUMP TO NEXT MARK CODE
        JMP I   SGET1           /RETURN

SREAD,  JMS     RDQUAD          /SKIP CONTROL WORD
        JMS     RDQUAD          /READ REVERSE CHECKSUM
        AND     S77             /JUST CHECK BITS
        TAD     S7700           /FORCE NO SIGNIFICENCE IN OTHER BITS
        DCA     SCKSUM          /INITIALIZE CHECKSUM
SRLOOP, JMS     RDQUAD          /GET A DATA WORD
        JMS     EQUFUN          /CHECKSUM IT
        DCA I   SBFPTR          /STORE IT
        ISZ     SBFPTR          /BUMP TO NEXT
S77,    77                      /JUST IN CASE
        ISZ     SGTCHK          /DONE A PAGE YET?
        JMP     SRLOOP          /NO, GO BACK
        JMS     RDQUAD          /READ 129TH WORD
        JMS     EQUFUN          /CHECKSUM IT TOO
        JMS     RDQUAD          /GET TAPE CHECKSUM
        AND     S7700           /JUST CHECK BITS
        JMS     EQUFUN          /INCLUDE IN ACCUMULATION
        JMS     SGTCHK          /GO CONDENSE FINAL VALUE
        JMP     SRWCOM          /FIND OUT WHAT HAPPENED

WRQUAD, .-.                     /WRITE A WORD ROUTINE
        JMS     EQUFUN          /CHECKSUM IT FIRST
        SDSQ                    /WAIT FOR
        JMP     .-1             /4 LINES
        SDLD                    /LOAD THIS WORD NEXT
        CLA                     /THROW IT AWAY
        JMP I   WRQUAD          /RETURN

        IFNZRO  7700-.  <ERROR  .>
S70,    70                      /THIS MUST BE AT 7700
SBOOTPT,SBOOT-4                 /BOOTSTRAP BUFFER POINTER
SMORE,  DCA     WRQUAD          /SAVE TRUE STATUS NOW
        TAD     SS7600          /SET UP
        DCA     SGTCHK          /WORD COUNT
        TAD I   PSBUFF          /GET THEIR BUFFER POINTER
        DCA     SBFPTR          /MAKE IT OURS
        TAD I   PSFUNCT         /GET FUNCTION WORD
S300,   AND     S70             /JUST FIELD BITS
        TAD     S6201           /FORM CDF TO TRANSFER FIELD
        DCA     SCKSUM          /EXECUTE IT HERE
        TAD I   PSFUNCT         /GET FUNCTION AGAIN
SCKSUM, CDF     00              /GOTO TRANSFER FIELD
        SMA                     /SKIP IF WRITING
        JMP     SREAD           /JUMP IF READING
        RAR                     /UNIT TO LINK
PSFUNCT,SFUNCT                  /SZL CLA;THIS COULD SKIP BUT CLEARS AC
PSPAGCT,SPAGCT                  /SPA SNA CLA;THIS CAN BE SKIPPED AND CAN'T SKIP
        TAD     WRQUAD          /GET STATUS
        AND     S300            /WLO, SEL OR TIMING ERROR?
        SZA                     /SKIP IF NO ERRORS
        JMP     SRWCOM          /NON-ZERO AC WILL GO TO ERROR ROUTINE
        RAR                     /GET UNIT
        TAD     SWLOOP          /PLUS GO, WRITE BITS
        SDLC                    /TURN WRITERS ON
        STA                     /WRITE
        JMS     WRQUAD          /REVERSE CHECKSUM
        STA                     /INITIALIZE
        DCA     SCKSUM          /CHECKSUM
SWLOOP, TAD I   SBFPTR          /GET A DATA WORD
        JMS     WRQUAD          /WRITE AND CHECKSUM IT
        ISZ     SBFPTR          /BUMP TO NEXT
S7700,  7700                    /THIS NEVER SKIPS
        ISZ     SGTCHK          /DONE 200 YET?
        JMP     SWLOOP          /NO, GO BACK
        JMS     WRQUAD          /WRITE 129TH WORD
        JMS     SGTCHK          /GET CHECKSUM
        JMS     WRQUAD          /WRITE IT TOO
        JMS     WRQUAD          /THIS SHIFTS OUT THE CHECKSUM
SRWCOM, CIF CDF 00              /EITHER WAY, BACK TO FIELD 0
        SDST                    /ANY TIMING ERRORS?
        SZA CLA                 /ANY PARITY PROBLEMS
        JMP     SERR            /YES, BARF
        TAD I   PSPAGCT         /GET CURRENT PAGE COUNT
        TAD     SS7600          /DECREMENT IT
        SNA                     /DONE?
        JMP     SEXIT           /YES
        DCA I   PSPAGCT         /NO, STORE IT BACK
        TAD I   PSBUFF          /GET CURRENT BUFFER POINTER
        JMP     SNEXT           /GO DO NEXT BLOCK

SMRKOD, -22                     /END ZONE
PSBUFF, -31                     /BLOCK MARK (SHIFTED)
SBFPTR, .-.                     /TRANSFER BUFFER POINTER

EQUFUN, .-.                     /EQUIVALENCE CHECKSUM ROUTINE
        DCA     RDQUAD          /CHECKSUMS ON DECTAPE ARE EQUIVALENCE OF
        TAD     RDQUAD          /ALL WORDS IN A BLOCK 6 BITS AT A TIME
        AND     SCKSUM          /SINCE EQUIVALENCE IS ASSOCIATIVE
        CIA                     /WE DO IT 12 BITS AT A TIME
        CLL RAL                 /AND CONDENSE LATER
        TAD     RDQUAD          /IDENTITIES USED ARE:
        TAD     SCKSUM          /A+B=(A.XOR.B)+2*(A.AND.B)
        DCA     SCKSUM          /A.EQV.B=.NOT.(A.XOR.B)=A.XOR.(.NOT.B)
        TAD     RDQUAD          /A.EQV.B=(A+(.NOT.B))-2*(A.AND.(.NOT.B))
        JMP I   EQUFUN          /RETURN

/       TD-8/E DEFINITIONS

        TDCODE= 0770            /TD-8/E DEVICE CODE
        SDLC=   6004+TDCODE     /SIMPLE DECTAPE LOAD CONTROL REGISTER
        SDLD=   6005+TDCODE     /SIMPLE DECTAPE LOAD DATA REGISTER
        SDRC=   6006+TDCODE     /SIMPLE DECTAPE READ CONTROL REGISTER
        SDRD=   6007+TDCODE     /SIMPLE DECTAPE READ DATA REGISTER
        SDSQ=   6003+TDCODE     /SIMPLE DECTAPE SKIP ON QUAD LINE FLAG
        SDSS=   6001+TDCODE     /SIMPLE DECTAPE SKIP ON SINGLE LINE FLAG
        SDST=   6002+TDCODE     /SIMPLE DECTAPE SKIP ON TIME (RATE) ERROR
        XLIST   OFF             >
