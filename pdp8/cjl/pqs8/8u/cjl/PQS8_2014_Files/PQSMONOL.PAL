        *RUNCOR

        NOPUNCH

        *FILBEG                 /WHERE IT LOADS

        ENPUNCH

/GRAND AND GLORIOUS "R" COMMAND PROCESSOR
DORUN,  DCA I   RUNCLR          /SCRATCH THE FILE FIRST
RPTR1,  TAD     L7600           /\
RPTR2,  JMS I   PMOVE           / \MOVE DOWN THE EXTENDED
RPTR3,  3200                    / /COMMAND OVERLAY NOW
RUNTEM, SWAPIN                  //
OLDNDX, JMS     RZAP            /LINK IS CLEAR, PERFORM A LIMITED ZAP
        DCA I   WHATMORE        /BOOTSTRAP ON LOOKUP ERRORS
        JMS I   NAME            /CHECK FOR VALID NAME
        JMP I   WHAT            /ISN'T ANY, BARF
        TAD     UNIT            /GET CURRENT UNIT
        DCA     OLDUNIT         /SAVE IT
        JMS I   TUNIT           /TEST FOR :UNIT
        JMP     SAMUNIT         /WASN'T ANY
        JMS     SSYMIO          /READ IN
        3400                    /A NEW
        4^100+.-.               /COPY OF
        RUNBLK+2                /THE CATALOGUE
SAMUNIT,JMP I   .+1             /DO AN "EXTENDED COMMAND" (PART 1)
        RUNIN                   /WITH MINIMAL ZAP

/IF "EXTENDED COMMAND" (PART 1) SUCCEEDS, IT COMES HERE:
RUNBAK, STL                     /PUT BACK
        JMS     RZAP            /LIMITED STUFF
        TAD     RESTR           /MAKE FULL ZAPS
        DCA     RREST           /NEXT TIME
        TAD     R3              /MAKE OVERLAY
        DCA I   RRNZAP          /COME TO US
        JMP I   RST             /TO XGLINE OVERLAY OR EBRK IF BATCH

/TRAP FOR NEW CAT CALLS (NO DOG CALLS)
RTRAP1, JMS I   PLODCAT         /LOAD NEW USER CATALOG
        JMS     SSYMIO          /\
L4400,  4400                    / \READ IN NEW
        3^100                   / /EXTENDED CATALOG
        EXTCAT                  //
        JMP I   NEWCAT          /RETURN

/TRAP FOR "FILE NOT FOUND!"
RTRAP2, TAD     OLDNDX          /\
        TAD     GETNDX          / >HAVE WE BEEN HERE BEFORE?
        SNA                     //
        JMP I   RGONE           /YES, BARF
        CIA                     /\
        TAD     OLDNDX          / >NO, SETUP OLD VALUE FOR NEXT TIME
        DCA     OLDNDX          //
        JMP     RMOR            /TRY AGAIN IN EXTENDED CATALOGUE
/TRAP FOR ILLEGAL NAMES WHICH MIGHT BEGIN WITH "*"
RTRAP3, JMS I   GETHAF          /GET BEGINNING CHARACTER
        TAD     R7726           /\
        SZA CLA                 / >COMPLAIN IF NOT "*"
        JMP I   WHAT            //
        ISZ     GETNDX          /BUMP AROUND IT
        JMS I   NAME            /TRY AGAIN
        JMP I   WHAT            /BARF AGAIN
        JMS     NEWCAT          /OK, CHECK FOR UNIT
RMOR,   TAD     R5              /SET BUMP FACTOR
R2,     DCA     TCNT1           /TO FIVE
        TAD I   L5377           /GET FIRST EXTCAT FILE'S BLOCK
        DCA     TAPREC          /TO STARTING BLOCK
        TAD     XINST1          /MAKE LENGTHS
        DCA I   XCTZAP          /ADDITIVE
        TAD     L4400           /GET EXTCAT POINTER
        JMS I   LOOKUP          /TRY TO FIND NAME
        DCA     SSYMIO          /SAVE BLOCK NUMBER
        TAD     XINST2          /PUT BACK
        DCA I   XCTZAP          /FIXED FILES
        TAD     SSYMIO          /GET BLOCK NUMBER
        JMP I   .+1             /RETURN
        TRYDOL-1                /TO SENDER

/ZAPPED LOCATION LIST
RRST,   RST                     /THIS MUST COME BACK FIRST
        RSAV                    /DON'T SAVE EMPTY "$:0"!
        CATPT                   /LOCATE SYSTEMS CATALOG WHERE IT NOW IS
RREST,  .-.                     /THIS BECOMES NEWCAT+3
        EDLIN                   /THIS IS USED TO COME BACK WITH
        NOTFND+4                /THIS TRAPS UNFOUND FILES
        LOOKPT                  /COME TO US THROUGH HERE
        TRYOLD+5                /MAKE THIS COME TO US
        SAVCAT                  /THROUGH THIS AS A POINTER
        PSLOAD                  /MUST COME TO US BEFORE STARTING IT UP
        0                       /THIS ENDS THE TABLE

        IFNZRO  .-FILLEN&177    <ERROR  .>
R1,     RRST                    /POINTER TO ZAP ADDRESS LIST
RGONE,  LOOKNG                  /POINTER TO "FILE NOT FOUND!" ROUTINE
RESTR,  NEWCAT+3                /DISPLACED ADDRESS
R5,     5                       /CONSTANT 0005

/"EXTENDED COMMAND" (PART 2) OVERLAY COMES HERE BEFORE STARTING:
RUNBK2, CLL                     /MAKE SURE
        JMS     RZAP            /ZAP EVERYTHING
        TAD     TSPCAL          /GET DISPLACED INSTRUCTION
        DCA I   RRNZAP          /PUT IT BACK
        JMP I   RRNZAP          /GO BACK AND DO IT
        IFNZRO  .-TCNT1&177     <ERROR  .>
/ZAP VALUE LIST
RRNBAK, RUNBAK                  /COME BACK TO US
        JMP I   RST             /DON'T SAVE "$:0" TWICE
        3400                    /WHERE IT IS LOADED ALREADY
        JMP I   EDLIN           /NEWCAT TRAP INSTRUCTION
        RTRAP1                  /WHERE IT GOES
        LOOKPT&177+5600         /JMP I LOOKPT
        RTRAP2                  /WHERE IT GOES TO
        SAVCAT&177+5600         /JMP I SAVCAT
        RTRAP3                  /WHERE IT GOES TO
        RTRAP4                  /WHERE PSLOAD WILL GOTO

RRNZAP, RUNLUP                  /POINTER TO ZAP IN "EXTENDED COMMAND" SWAPIN
R7726,  7726                    /CONSTANT 7726
R3,     SWITCH&177+5600         /JMP I SWITCH
XCTZAP, LKINST                  /WHERE TO PUT XINST1 OR XINST2
XINST1, TAD I   XR1             /INSTRUCTION TO PUT INTO LOOKUP ROUTINE
TSPCAL, JMS I   TSPACE          /A DISPLACED INSTRUCTION TO BE PUT BACK

/TRAP FOR SUCCESSFUL TERMINATION:
RTRAP4, STL                     /PUT BACK
        JMS     RZAP            /EVERYTHING
        JMP I   PSLOAD          /START THE SYSTEM

RZAP,   .-.                     /ZAP ROUTINE
XINST2, TAD     R1              /\
        DCA     RPTR1           / \
        TAD     R2              /  \RESET
        DCA     RPTR2           /  /POINTERS
        TAD     R3              / /
        DCA     RPTR3           //
RZAPLP, TAD I   RPTR1           /GET FIRST ADDRESS
        SNA                     /DONE?
        JMP I   RZAP            /YES
        DCA     RUNTEM          /NO, SAVE IT
        SZL                     /SKIP IF ZAPPING
        JMP     .+5             /JUMP IF PUTTING BACK
        TAD I   RUNTEM          /SAVE OLD VALUE
        DCA I   RPTR3           /FOR LATER RESTORATION
        TAD I   RPTR2           /GET ZAP VALUE
        SKP                     /1 WAY ONLY
        TAD I   RPTR3           /GET RESTORE VALUE
        DCA I   RUNTEM          /STASH IT
        ISZ     RPTR1           /\
        ISZ     RPTR2           / >BUMP LIST POINTERS
        ISZ     RPTR3           //
        JMP     RZAPLP          /GO BACK AND DO ANOTHER
RUNCLR, FILBEG                  /WHERE TO END THE FILE
L5377,  5377                    /FIRST EXTCAT BLOCK NUMBER HERE

        NOPUNCH

