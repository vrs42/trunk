EPTR,   NEWBUF                  /THROUGH HERE

ETEST,  "\&77                   /DEFAULT <EOT> CHARACTER
EEDCOM, EDCOM                   /"EDIT" COMMAND ADDRESS
EDSLOT, EDCMND                  /WHERE IN TABLE TO PUT IT
ERESET, ERSET                   /ALIGNED RETURN
E7652,  7652                    /<TAB> CONVERSION CONSTANT
E7602,  SBOOT+2                 /WHERE CURRENT SYSTEM UNIT IS
ECHECK, EFIXIT                  /TEMPORARY;PRELOADED WITH ADDRESS TO USE IF /A
EEOSEQ, 4;      22              /<^D> OR <^R>

EREAD,  SWMX                    /GIVE ME A CHARACTER ENTRY
