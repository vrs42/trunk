SPAGCT, HLT                     /PAGE COUNTER;COMES HERE ON
                                /COLD START I/O ERROR TO RETRY
SPARM,  AND     S6&177          /ISOLATE DISK BITS
SFILES, DCA     SBTEMP&177      /SAVE THEM
        TAD     SBTEMP&177      /GET IT BACK
        TAD     SBFUN&177       /ADD ON OTHER COMMAND BITS
        DLDC                    /LOAD COMMAND
        TAD     SSCOLD&177      /GET TRANSFER ADDRESS
        DLCA                    /LOAD IT
        TAD     SHLPBLK&177     /GET DISK SECTOR
        DLAG                    /START IT UP
        DSKP                    /DONE YET?
        JMP     .-1&177         /NO, WAIT FOR IT
        CIF     10              /GOTO TRANSFERRED FIELD
        JMP I   SSCOLD&177      /BRANCH TO JUST TRANSFERRED CODE

        XLIST   OFF
        IFNZRO  RK1     <
        XLIST   ON
SBFUN,  BTUNIT%6+10             /COMMAND BITS
SHLPBLK,BTUNIT^1454+H2          /HELPER BLOCK SECTOR
        XLIST   OFF     >
        IFNZRO  RK2     <
        XLIST   ON
SBFUN,  BTUNIT&3%3+10           /COMMAND BITS
SHLPBLK,BTUNIT&3^3130+H2        /HELPER BLOCK SECTOR
        XLIST   OFF     >
        XLIST   ON
S6,     6                       /PHYSICAL DISK MASK
SSCOLD, SCOLD                   /HELPER ADDRESS CONSTANT
SBTEMP, .-.                     /PHYSICAL DISK SAVED HERE

        H2=     HBLOCK%2        /HELPER BLOCK'S RELATIVE DISK SECTOR
        FIELD   1               /GENERATES HERE

        *HSTART                 /WHERE IT IS WRITTEN OUT FROM

        NOPUNCH                 /FOOL THE ASSEMBLER

        FIELD   HFIELD%10       /USED IN HFIELD

        FIELD   1               /EXECUTES IN FIELD 1

        *SHADDR                 /THIS IS IN THE WORKING BUFFER!

        ENPUNCH                 /UN-FOOL THE ASSEMBLER

        IFNZRO  CLA-.   <ERROR CLA>

SCOLD,  CLA                     /CLEAN UP AND CONTAIN PDP-8 EXTENDED MEMORY BUG
STEMP,  CDF     00              /MAKE SURE FIELD 0
        TAD I   SHSBTEMP        /GET DISK DRIVE BITS
        DCA     STEMP2          /SAVE THEM
        DRST                    /GET STATUS
        CLL RAL                 /REMOVE DONE BIT
        SNA CLA                 /SKIP IF BAD
        JMP     SBTOK           /JUMP IF OK
SAGAIN, TAD     STEMP2          /GET THE DISK DRIVE BITS
        CIF CDF 00              /BACK TO FIELD 0;MAKE SURE DATA FIELD IS CORRECT!
        JMP     SPAGCT&177      /GO BACK TO MANUAL BOOTSTRAP CODE

SBTOK,  TAD     SCOUNT          /GET HELPER ADDRESS
        DLCA                    /LOAD IT
        TAD I   SPTR            /GET A WORD FROM PAGE ZERO
        DCA I   SCOUNT          /MOVE TO LAST PAGE
        ISZ     SPTR            /BUMP TO NEXT
        ISZ     SCOUNT          /DONE ENOUGH?
        JMP     .-4             /NO, GO BACK
STRYNXT,CDF     10              /PUT THIS HERE FOR BENEFIT OF PDP-8/L
SCDFNXT,CDF     20              /TRY NEXT FIELD
        TAD I   SPSCOLD         /GET A WORD
        DCA     STEMP           /WILL BE SKIPPED ON PDP-8!
        TAD     SH7000          /GET A NOP
        DCA I   SPSCOLD         /PUT IT IN ITS PLACE
        TAD I   SPSCOLD         /GET IT BACK
        TAD     SH1000          /COMPARE TO NOP
        SZA CLA                 /SKIP IF OK
        JMP     SCORDN          /JUMP IF NOT
        TAD     SCOLD           /GET OUR TEST ADDRESS
        TAD     SH600           /COMPARE TO ITS NORMAL VALUE
        SZA CLA                 /SKIP IF UNCHANGED
        JMP     SCORDN          /JUMP IF ZAPPED
        TAD     STEMP           /GET PREVIOUS CONTENTS
        DCA I   SPSCOLD         /RESTORE FOR NEATNESS
        TAD     SCDFNXT         /GET THE CDF INSTRUCTION
        TAD     SH10            /BUMP TO NEXT FIELD
        DCA     SCDFNXT         /STASH IT
        ISZ     SFLDCNT         /DONE ALL FIELDS?
        JMP     STRYNXT         /NO, ON TO NEXT ONE
SCORDN, TAD     SH7770          /GET BACKUP FACTOR
        TAD     SCDFNXT         /GET HIGHEST AVAILABLE FIELD
        DCA     SCOUNT          /SAVE FOR LATER
        TAD     SCOUNT          /GET IT BACK FOR NOW
        AND     SH70            /JUST FIELD BITS
        TAD     STEMP2          /ADD ON PHYSICAL DISK BITS
        TAD     SHBFUN          /NOW HAVE COMMAND COMPOSITE
        DLDC                    /LOAD COMMAND
        TAD     SHSECT          /GET HELPER SECTOR
        DLAG                    /START UP THE TRANSFER
        DSKP                    /DONE YET?
        JMP     .-1             /NO, WAIT FOR IT
        DRST                    /YES, GET THE STATUS
        CLL RAL                 /REMOVE DONE BIT
        SZA CLA                 /SKIP IF OK
        JMP     SAGAIN          /BARF
        TAD     STEMP2          /GET PHYSICAL DISK BITS
        XLIST   OFF
        IFNZRO  RK2     <
        XLIST   ON
        AND     SH4             /JUST DISK PAIR BIT
        XLIST   OFF     >
        XLIST   ON
SCOUNT, SBOOT                   /WILL BE CDF TO HIGHEST FIELD AVAILABLE
        XLIST   OFF
        IFNZRO  RK2     <
        XLIST   ON
        DCA I   SSHDSK          /STORE FOR OTHERS
        TAD     STEMP2          /GET PHYSICAL DISK BITS
        XLIST   OFF     >
        XLIST   ON
        DCA I   SHSBDSK         /STORE FOR COLD BOOTSTRAP
        XLIST   OFF
        IFNZRO  RK2     <
        XLIST   ON
        XLIST   OFF     >
        XLIST   ON
        RDF                     /GET THE NEW DATA FIELD
        CDF     00              /BACK TO FIELD 0
        TAD     SHCIF           /MAKE INTO CIF HFIELD INSTRUCTION
        DCA I   SHSWTFLD        /STORE INTO WAIT ROUTINE
        TAD I   SHSWTFLD        /GET CIF INSTRUCTION BACK AGAIN
        DCA I   SHSFXCIF        /STORE INTO FIXUP LOCATION
        XLIST   OFF
        IFNZRO  RK2     <
        XLIST   ON
        NL0002                  /SET LOWER DRIVE BIT MASK
        AND     STEMP2          /GET LOWER DRIVE BIT
        RAL                     /MAKE INTO HIGH-ORDER UNIT BIT
        TAD I   SHSBTF          /ADD ON BOOTSTRAP UNIT BITS
        DCA I   SHSBTF          /STORE AS COMPOSITE BOOTSTRAP UNIT
        TAD I   SHSBTF          /GET IT BACK
        TAD I   SHSBT2          /MAKE INTO READ FUNCTION
        DCA I   SHSBT2          /STORE IN BOOTSTRAP CALL
        XLIST   OFF     >
        XLIST   ON
SHCIF,  CIF     00              /GOTO FIELD 0
        JMP I   SHSBOOT         /CONTINUE THERE
        XLIST   OFF
        IFNZRO  RK1     <
        XLIST   ON
        XLIST   OFF     >
        IFNZRO  RK2     <
        XLIST   ON

        XLIST   OFF     >
        XLIST   ON
SFLDCNT,-6                      /COUNT OF FIELDS TO TEST
        XLIST   OFF
        IFNZRO  RK1     <
        XLIST   ON
SHBFUN, BTUNIT%6+100            /COMMAND BITS
        XLIST   OFF     >
        IFNZRO  RK2     <
        XLIST   ON
SHBFUN, BTUNIT&3%3+100          /COMMAND BITS
        XLIST   OFF     >
        XLIST   ON
SHSBOOT,SBOOT                   /POINTER TO SYSTEM BOOTSTRAP
SHSBTEM,SBTEMP&177              /WHERE SOFTWARE DISK BITS ARE
        XLIST   OFF
        IFNZRO  RK1     <
        XLIST   ON
SHSECT, BTUNIT^1454+H2+1        /NEXT HELPER BLOCK'S SECTOR
        XLIST   OFF     >
        IFNZRO  RK2     <
        XLIST   ON
SHSECT, BTUNIT&3^3130+H2+1      /NEXT HELPER BLOCK'S SECTOR
        XLIST   OFF     >
        XLIST   ON
SHSFXCI,SFXCIF                  /WHERE TO PUT CIF HFIELD
SHSWTFL,SWTFLD                  /WHERE TO PUT CIF HFIELD
SH10,   10                      /MEMORY TEST CONSTANT
SH1000, 1000                    /MEMORY TEST CONSTANT
        XLIST   OFF
        IFNZRO  RK2     <
        XLIST   ON
SH4,    4                       /HIGH-ORDER PHYSICAL DISK BIT MASK
        XLIST   OFF     >
        XLIST   ON
SH600,  -SCOLD                  /MEMORY TEST CONSTANT
SH70,   70                      /FIELD BITS MASK
SH7000, NOP                     /MEMORY TEST INSTRUCTION
SH7770, 7770                    /CONSTANT 7770
SPSCOLD,SCOLD                   /TEST POINTER FOR EXTENDED MEMORY TEST
SPTR,   SBOOT&177               /WHERE BLOCK 0 CODE IS NOW
        XLIST   OFF
        IFNZRO  RK2     <
        XLIST   ON
SSHDSK, SPHDSK                  /PHYSICAL EXTENSION STORED HERE
        XLIST   OFF     >
        XLIST   ON
SHSBDSK,SBDISK                  /WHERE PHYSICAL DISK BITS ARE STORED FOR COLD START
        XLIST   OFF
        IFNZRO  RK2     <
        XLIST   ON
SHSBTF, SBTFUN                  /WHERE BOOTSTRAP UNIT IS
SHSBT2, SBOOT2+2                /WHERE BOOTSTRAP READ FUNCTION IS
        XLIST   OFF     >
        XLIST   ON
STEMP2, .-.                     /HARDWARE PHYSICAL DISK UNIT
        FIELD   1               /WHERE IT GENERATES

        *HSTART+400             /WHERE IT IS WRITTEN OUT FROM

        NOPUNCH                 /FOOL THE ASSEMBLER

        FIELD   HFIELD%10       /THIS EXECUTES IN THE HIGHEST FIELD

        *SBOOT                  /IN LAST PAGE

        ENPUNCH                 /UN-FOOL THE ASSEMBLER

        IFNZRO  SBOOT-. <ERROR SBOOT>
S37,    37                      /CONSTANT 0037

SODCHK, DCA     SCHKBIT         /ALWAYS CHECK THE FIRST TIME!
        SZL CLA                 /IS IT AN ODD HALF?
        JMP     SECTODD         /YES, FIXUP THERE
SECLUP, TAD I   SSBUFF          /GET THE TRANSFER ADDRESS
        DLCA                    /SETUP THE ADDRESS COUNTER
        TAD I   SSPAGCT         /GET THE CURRENT PAGE COUNT
        TAD     S7700           /COMPARE TO ONE PAGE TRANSFER
        XLIST   OFF
        IFNZRO  RK1     <
        XLIST   ON
        SNA CLA                 /SKIP IF LARGER
        XLIST   OFF     >
        IFNZRO  RK2     <
        XLIST   ON
SCMDBF, SCOMD&SPA SNA CLA       /SKIP IF LARGER;SPA IS USED TO FORM ADDRESS
        XLIST   OFF     >
        XLIST   ON
        JMP     S1PAGE          /JUMP IF SINGLE PAGE
S1READ, TAD     SCHKBIT         /GET CHECK BIT IN CASE SECONDARY TRANSFER
        TAD I   SSFUNCT         /GET BASIC COMMAND
        XLIST   OFF
        IFNZRO  RK1     <
        XLIST   ON
        TAD     SBDISK          /ADD ON PHYSICAL DISK BITS
        XLIST   OFF     >
        IFNZRO  RK2     <
        XLIST   ON
        TAD     SPHDSK          /ADD ON PHYSICAL DISK EXTENSION BITS
        TAD I   SSDISK          /GET DRIVE BIT DUE TO UNIT[0]
        XLIST   OFF     >
        XLIST   ON
SWRITIN,DLDC                    /LOAD COMPOSITE COMMAND
        TAD I   SSECT           /GET DISK SECTOR
        CIF     00              /BACK TO FIELD 0
        JMS     SWAIT           /START IT UP AND WAIT FOR IT TO FINISH
SODRDIN,ISZ I   SSECT           /BUMP UP DISK SECTOR
        SKP                     /DIDN'T OVERFLOW
        ISZ I   SSFUNCT         /BUMP HIGH-ORDER SECTOR BIT
        TAD     SBAKUP          /GET ADDRESS BACKUP FACTOR
        TAD     S400            /ACCOUNT FOR TWO PAGES NORMALLY
        TAD I   SSBUFF          /GET OLD ADDRESS VALUE
        DCA I   SSBUFF          /SAVE UPDATED VALUE
        DCA     SBAKUP          /REMOVE HALF-SECTOR BACKUP
        TAD I   SSPAGCT         /GET PAGE COUNTER
        TAD     SS7600          /SUBTRACT TWO PAGES
        SPA SNA                 /SKIP IF NOT DONE
        JMP     SOVER           /JUMP IF FINISHED
        DCA I   SSPAGCT         /SAVE UPDATED COUNT
        TAD I   SSECT           /GET NEXT SECTOR
S200,   AND     S37             /JUST ON-TRACK BITS
        SZA CLA                 /SKIP IF NEW TRACK NEEDED
        TAD     S1000           /ALLOW NON-CHECK FOR SPEED'S SAKE
        DCA     SCHKBIT         /SAVE CHECK BIT EITHER WAY
        JMP     SECLUP          /GO DO ANOTHER SECTOR

SOVER,  SCOLD                   /CLEAN UP
        CIF     00              /BACK TO FIELD 0
        JMP     SDONE           /WE'RE DONE!

SMOVE,  .-.                     /BUFFER MOVE ROUTINE
        TAD     SS7600          /SETUP THE
        DCA     SBUFRD          /MOVE COUNT
SFRCDF, .-.                     /WILL BE "FROM" CDF
        TAD I   SFRPTR          /GET A WORD
STOCDF, .-.                     /WILL BE "TO" CDF
        DCA I   STOPTR          /PUT A WORD
        ISZ     SFRPTR          /BUMP INPUT POINTER
S7400,  7400                    /CONSTANT 7400 HERE JUST IN CASE
        ISZ     STOPTR          /BUMP OUTPUT POINTER
SS7600, SBOOT                   /CONSTANT 7600 HERE JUST IN CASE
        ISZ     SBUFRD          /DONE ALL YET?
        JMP     SFRCDF          /NO, GO DO ANOTHER ONE
SSCDF,  CDF     00              /YES, BACK TO FIELD 0
        JMP I   SMOVE           /RETURN
SECTODD,TAD I   SSPAGCT         /GET CURRENT PAGE COUNT
        TAD     S100            /ADD ONE TO COUNTER DECREMENT LATER
        DCA I   SSPAGCT         /STORE IT BACK
        TAD     SS7600          /SETUP THE
        DCA     SBAKUP          /BACKUP FACTOR
        TAD I   SSFUNCT         /GET THE READ/WRITE FUNCTION
S7700,  SMA CLA                 /SKIP IF WRITING
        JMP     SODRD           /JUMP IF READING
SODWRIT,TAD     S200            /ODD WRITING AFFECTS THE SECOND HALF
S1WRITE,TAD     SOVER           /GET WORKING BUFFER POINTER
        DCA     STOPTR          /BECOMES MOVE DESTINATION POINTER
        JMS     SBUFRD          /READ IN THE CURRENT DISK CONTENTS
        DCA     SFRCDF          /SAVE SOURCE CDF INSTRUCTION
        TAD I   SSBUFF          /GET TRANSFER ADDRESS
        DCA     SFRPTR          /USE AS MOVE SOURCE POINTER
        RIF                     /GET THIS FIELD
        TAD     SSCDF           /MAKE INTO CDF INSTRUCTION
        DCA     STOCDF          /SAVE AS DESTINATION CDF
        JMS     SMOVE           /MOVE USER PAGE TO WORK BUFFER
        TAD     SOVER           /SETUP THE
        DLCA                    /CURRENT ADDRESS
        NL4000                  /GET A WRITE BIT
        XLIST   OFF
        IFNZRO  RK1     <
        XLIST   ON
        TAD     SBFTMP          /ADD ON TO FORMER READ
        XLIST   OFF     >
        IFNZRO  RK2     <
        XLIST   ON
        TAD I   SCMDBF          /ADD ON TO FORMER READ
        XLIST   OFF     >
        XLIST   ON
        JMP     SWRITIN         /GO WRITE IT OUT

SODRD,  JMS     SBUFRD          /READ IN THE WHOLE SECTOR
        DCA     STOCDF          /SETUP DESTINATION CDF INSTRUCTION
        TAD I   SSBUFF          /GET THE TRANSFER ADDRESS
        DCA     STOPTR          /BECOMES DESTINATION POINTER
        TAD     S7400           /SETUP THE
        DCA     SFRPTR          /SOURCE POINTER
        RIF                     /GET THIS FIELD
        TAD     SSCDF           /MAKE INTO CDF INSTRUCTION
        DCA     SFRCDF          /SAVE AS SOURCE CDF INSTRUCTION
        JMS     SMOVE           /MOVE FIRST WORK PAGE TO USER BUFFER
        JMP     SODRDIN         /CONTINUE THERE

S1PAGE, TAD I   SSFUNCT         /GET READ/WRITE FUNCTION
        SPA CLA                 /SKIP IF ONE PAGE READ
        JMP     S1WRITE         /JUMP IF WRITING
        TAD     S100            /GET "HALF-SECTOR" BIT
        JMP     S1READ          /CONTINUE THERE
SBUFRD, .-.                     /READ A WORK BUFFER ROUTINE
        TAD     SOVER           /GET WORK POINTER
        DLCA                    /LOAD CURRENT ADDRESS
        NL0001                  /SETUP HIGH-ORDER SECTOR BIT MASK
        AND I   SSFUNCT         /GET THE HIGH-ORDER SECTOR BIT
        XLIST   OFF
        IFNZRO  RK1     <
        XLIST   ON
        TAD     SBDISK          /GET PHYSICAL DRIVE BITS
        XLIST   OFF     >
        IFNZRO  RK2     <
        XLIST   ON
        TAD     SPHDSK          /GET PHYSICAL DISK EXTENSION BIT
        TAD I   SSDISK          /ADD ON DISK EXTENSION DUE TO UNIT[0]
        XLIST   OFF     >
        XLIST   ON
        RIF                     /ADD ON THIS FIELD
        XLIST   OFF
        IFNZRO  RK1     <
        XLIST   ON
        DCA     SBFTMP          /SAVE FOR LATER
        TAD     SBFTMP          /GET COMMAND BACK
        XLIST   OFF     >
        IFNZRO  RK2     <
        XLIST   ON
        DCA I   SCMDBF          /SAVE FOR LATER
        TAD I   SCMDBF          /GET COMMAND BACK
        XLIST   OFF     >
        XLIST   ON
        DLDC                    /LOAD IT
        TAD I   SSECT           /GET THE DISK SECTOR
        CIF     00              /BACK TO FIELD 0
        JMS     SWAIT           /GO READ AND WAIT FOR IT TO FINISH
        TAD I   SSFUNCT         /GET FUNCTION AGAIN
        AND     S70             /JUST TRANSFER FIELD
        TAD     SSCDF           /MAKE INTO CDF INSTRUCTION
        JMP I   SBUFRD          /RETURN

SBAKUP, .-.                     /BACKUP FACTOR FOR ODD SINGLE TRANSFERS
SBDISK, .-.                     /PHYSICAL DISK BITS FOR COLD BOOTSTRAP
        XLIST   OFF
        IFNZRO  RK1     <
        XLIST   ON
SBFTMP, .-.                     /COMMAND TEMPORARY
        XLIST   OFF     >
        XLIST   ON
SFRPTR, .-.                     /MOVE "FROM" POINTER
        XLIST   OFF
        IFNZRO  RK2     <
        XLIST   ON
SPHDSK, .-.                     /PHYSICAL DISK EXTENSION
        XLIST   OFF     >
        XLIST   ON
SSBUFF, SBUFF                   /POINTER TO TRANSFER BUFFER VALUE
SCHKBIT,.-.                     /HEADER CHECK BIT
        XLIST   OFF
        IFNZRO  RK2     <
        XLIST   ON
SSDISK, SDISK                   /POINTER TO UNIT[0] DERIVED DISK EXTENSION
        XLIST   OFF     >
        XLIST   ON
SSECT,  SECT                    /WHERE DISK SECTOR IS
SSFUNCT,SFUNCT                  /POINTER TO DISK FUNCTION
SSPAGCT,SPAGCT                  /WHERE PAGE COUNTER IS
STOPTR, .-.                     /MOVE "TO" POINTER
S100,   100                     /CONSTANT 0100
S1000,  1000                    /CONSTANT 1000
S400,   400                     /CONSTANT 0400
S70,    70                      /CONSTANT 0070
        XLIST   OFF             >
        XLIST   ON
/RK-8/E DEFINITIONS
 
        RKCODE= 6740            /DEVICE CODE OF RK-8/E
 
        DSKP=   RKCODE+1        /SKIP ON DONE
        DCLR=   RKCODE+2        /CLEAR STATUS
        DLAG=   RKCODE+3        /LOAD AND GO
        DLCA=   RKCODE+4        /LOAD CURRENT ADDRESS
        DRST=   RKCODE+5        /READ STATUS
        DLDC=   RKCODE+6        /LOAD COMMAND
        DMAN=   RKCODE+7        /MAINTAINENCE
        XLIST   OFF                     >
        XLIST   ON
