        SNA                     /     /FOLLOWED BY ")" OR <EOL>
        JMP     EOPARM          /    /
        TAD     L7727           /   /
        SNA CLA                 /  /
        JMP     SCNEXT          / /
        JMP     .-7             //

SWITOK, TAD     L32             /FIX UP NUMBER
        ISZ     TPTR1           /BUMP POINTER
        TAD     L7764           /TWELVE BITS WORTH
        SMA                     /SKIP IF OK
        JMP     SWITOK+1        /JUMP BACK IF NOT
        DCA     TCNT1           /SAVE BIT POSITION
        STL                     /TURN FLAG ON
        RAL                     /\
PFILNAM,ISZ     TCNT1           / >MOVE FLAG TO CORRECT POSITION
        JMP     .-2             //
        DCA     TCNT1           /SAVE FLAG
        TAD     TCNT1           /\
        CMA                     / \
        AND I   TPTR1           /  >OR FLAG INTO TABLE
        TAD     TCNT1           / /
        DCA I   TPTR1           //
        ISZ     GETNDX          /BUMP PAST SWITCH
        JMP I   SWITCH          /RETURN

        RELOC                   /TURN OFF RELOCATION
        *BATGEN                 /WHERE TO PUT THE CATALOG FOR NOW

SYSCOR, TEXT    "ODT";0         /OCTAL DEBUGGING TECHNIQUE
        ODTBLK                  /BLOCK NUMBER
        ODTCORE+ODTLEN          /LOAD ADDRESS+LENGTH
        ODSTRT                  /STARTING ADDRESS
        TEXT    "BATCH"         /BATCH SYSTEM
        BATBLK                  /BLOCK NUMBER
        XGETHAF+BTSLEN          /LOAD ADDRESS+LENGTH
        ESTART                  /STARTING ADDRESS
