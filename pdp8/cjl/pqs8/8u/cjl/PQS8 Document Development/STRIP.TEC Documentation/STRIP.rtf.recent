	MQL		/CLEAR MQ
	TAD ARMDLY	/WILL ALLOW MAX OF 8 MISSILES
	SHL		/PER SHIP
	 2		/BY *10(8)
	DCA I MISPNT	/ALIVE FOR NEXT MISSILE
