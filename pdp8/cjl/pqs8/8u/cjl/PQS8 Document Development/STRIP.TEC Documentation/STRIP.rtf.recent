/COME HERE FROM INTERRUPT

SAVAC,	0
SAVLK,	0

INTRPT,	DCA SAVAC	/SAVE ACCUMULATOR
	RAR
	DCA SAVLK	/AND LINK
	KSF		/KEYBOARD?
	JMP .+4
	KRB		/READ THE CHAR
	DCA ICHAR	/STORE
	JMP I OPTIONS
	TSF		/TELEPRINTER
	JMP CLKINT	/NO CHECK CLOCK
	TCF		/CLEAR THAT FLAG
	DCA TELSW	/SET NOT IN PROGRESS SWITCH
	JMP I OPTIONS

TELSW,	0
ICHAR,	0
DELAY1,	0

CLKINT,
	IFNZRO KW12+DK8EP <
	CLSK		/SKIP ON CLOCK INTERRUPT
	JMP INTEXT	/QUIT (UNDEFINED INT?)
	CLSA		/CLEAR THE FLAGS
	>
	IFNZRO FCLOCK <
	6131		/SKIP IF NOT FLAG
	SKP
	JMP INTEXT	/NOPE
	6132		/RECONNECT TO INT
	>
	IFNZRO DK8EA <
	6133		/SKIP ON CLOCK
	JMP INTEXT	/NOPE
	6131		/MAKE SURE INT STILL ENABLED
	ISZ DELAY1	/WANT 30/SEC
	JMP INTEXT	/NOPE: NEXT TIME
	CLL STA RTL	/-2
	DCA DELAY1	/RESET DELAY1
	>
	IFNZRO AX08 <
	6321		/SKIP IF CLOCK
	JMP INTEXT	/WHO???
	6352		/CLEAR CLOCK
	ISZ DELAY1
	JMP INTEXT	/NOT YET
	TAD CLKLIM	/RESET INTRPS
	DCA DELAY1	/DELAY INTERVAL
	>

	STA		/SET AC=-1 TO INDICATE WAITING
	DCA WAIT	/UPDATE THE WAITING FLAG

INTEXT,	6402		/CLEAR THE FLAG ON THE SECOND SERIAL PORT RECEIVER
	6412		/CLEAR THE FLAG ON THE SECOND SERIAL PORT TRANSMITTER
	IFNZRO T30G <6161;NOP>
	CLA CLL
	TAD SAVLK	/GET LINK
	RAL CLL
	TAD SAVAC	/AND AC.
	RMF		/RESTORE FIELDS
	ION		/AND RESTOR INTERRUPTS
	JMP I 0		/RETURN TO PROGRAM

/GO BACK TO SPCWAR

OPTION,	KBOARD
	JMP INTEXT

	IFNZRO KW12+DK8EP <
/SUBROUTINE TO START UP CLOCK
/MAY BE HARDWARE DEPENDENT
/THIS IS FOR KW12A CLOCK - PDP12
/OR PROGRAMABLE PDP8E CLOCK DK8EP
	CLSK=6131	/SKIP ON CLOCK INTERRUPT
	CLLR=6132	/LOAD CLOCK CONTROL REGISTER
	CLAB=6133	/AC TO BUFFER PRESET REGISTER
	CLEN=6134	/LOAD CLOCK ENABLE REGISTER
	CLSA=6135	/CLOCK STATUS TO AC

STCLK,	0
	CLA CLL		/JUST IN CASE, CLEAR THE AC AND LINK
IFNZRO PDP12 <CLLR	/STOP THE KW12A CLOCK
	CLEN		/CLEAR THE KW12A INTERRUPT ENABLES
	>
	TAD (-40	/ABOUT 30 HERTZ
	CLAB		/LOAD THE KW12A BUFFER PRESET REGISTER
	CLA CLL		/CLEAR THE AC AND LINK
	IFNZRO PDP12 <
	TAD (0100	/0XXX=STOP THE CLOCK,X1XX=PRESET TIME
	CLLR		/LOAD THE KW12A CONTROL	REGISTER
	CLSA		/CLEAR THE KW12A STATUS AND POSSIBLE OVERFLOW
	CLA CLL		/CLEAR THE AC AND LINK
	TAD (300	/INTERRUPT ON OVERFLOW
	CLEN		/LOAD THE KW12A ENABLE REGISTER
	CLA CLL		/CLEAR THE AC AND LINK
	TAD (4100	/4XXX=1KHZ,X1XX=PRESET TIME, START UP THE KW12A CLOCK
	>
	IFNZRO DK8EP <
	TAD (5300	/INTR ON CLOCK - 100HZ
	>
	CLLR		/LOAD THE KW12A CONTROL	REGISTER
	CLA CLL		/CLEAR THE AC AND LINK
	JMP I STCLK>	/RETURN TO THE CALLER

	IFNZRO FCLOCK <
/DYER'S FUNNY CLOCK

STCLK,	0
	6132
	JMP I STCLK>

	IFNZRO DK8EA <
/DK8EA (LINE CLOCK)

STCLK,	0
	6131		/ENABLE INTERRUPTS
	JMP I STCLK>

	IFNZRO AX08 <
STCLK,	0
	CLA CLL
	TAD (400
	6346		/START CRYSTAL CLOCK
	TAD CLKLIM	/INITIALIZE CLOCK
	DCA DELAY1
	JMP I STCLK

CLKLIM,	7400
>

	IFZERO KW12+AX08+FCLOCK+DK8EA+DK8EP <
STCLK,	0
	JMP I STCLK>

