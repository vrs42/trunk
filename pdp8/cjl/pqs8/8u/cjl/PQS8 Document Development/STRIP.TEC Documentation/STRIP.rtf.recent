/PROGRAM:	UCNVRT CARD READER OVERLAY
/WRITTEN BY:	MARK J. HYDE
/LAST MODS:	77/12/02/03:15  (002)
$

.TYPE JILL.PA
/UNIVERSAL SOURCE FILE CONVERTER.
/"FILE SYSTEM" HANDLER OVERLAY TO READ "NEEDS
/ASSESSMENT TASK FORCE" MARK-SENSE CARDS.
 
/EXTENDED OPCODES.
/PMODE
FIXMRI	LAC=1000
FIXMRI	INC=2000
FIXMRI	DZM=3000
RCSF=6631		/CARD READER IOTS.
RCRB=6634
RCSD=6671
RCSE=6672
RCRD=6674
AC1=7201
FIXTAB
 
/DEFINE AUTO-INDEX REGISTERS.
X11=11
 
/BUFFER ALLOCATIONS.
IBUF=7000		/INPUT BUFFER.
 
/CROSS-SOURCE SYMBOL CONCORDANCES.
K177=31
CTR=33
K100=44
SELP=47
M4=56
K40=57
IFILE=105
RORI6=112
K7600=135
MAIN=201
 
/CHANGE TABLES TO INCLUDE ERSATZ FILE SYSTEM
/HANDLER "CD".
 
/FOR PDP-12, KILL DIAL-MS HANDLER.
/*145
/	 0		/ZAP DEV HNDLR PTR.
/*156
/	 JILL		/ZAP FILE SYS HNDLR PTR.
/*167
/	 -304		/HANDLER CODE:="CD".
/*6042
/	CLA		/KEEP INIT CODE FROM
			 /ZAPPING OUT HANDLER.
 
/FOR PDP-8, KILL DISK MONITOR HANDLER.
*144
	 0		/ZAP DEV HNDLR PTR.
*150
	 JILL		/ZAP FILE SYS HNDLR PTR.
*154
	 -304		/HANDLER CODE:="CD".
/MARK SENSE CARD ERSATZ FILE SYSTEM HANDLER.
*5400
 
/MAIN ENTRY POINT.  AC=MODE SELECTOR OR
/CHAR TO BE OUTPUT.
JILL,	 0!0
	JMS I	SELP	/DISPATCH TO MODES.
	 JETBL+3
JENTER,	CLA		/JUST TOSS OUTPUT.
	JMP I	JILL	/EXIT.
 
/TABLE USED BY SEL TO DISPATCH TO MODE HNDLRS.
JETBL,	 JLOOKP
	 JENTER
	 MAIN
	 JINPUT

/LOOKUP MODE HANDLER.
JLOOKP,	LAC	JTOPP	/SET CO-ROUTINE PTR.
	DCA	JGTNXT
	JMP I	JILL	/EXIT.
JTOPP,	 JTOP
 
/INPUT MODE HANDLER.
JINPUT,	JMP I	JGTNXT	/GET NEXT CHAR VIA
JGTNXT,	 0!0		 /CO-ROUTINE.
	JMP I	JILL	/EXIT.
/CO-ROUTINE TO HANDLE "NEEDS ASSESSMENT TASK
/FORCE" MARK-SENSE CARDS.  NOTE:  BECAUSE OF
/STUPID COLLATION OF DECKS, 1ST CARD (1-40) IS
/READ 2ND, AND 2ND CARD (41-80) IS READ 1ST.
JTOP,	JMS I	JCARDP	/READ 2ND CARD
	 IBUF+0-1	 /OF PAIR.
	LAC I	JIBUFP	/IS IT END-OF-FILE?
	TAD	JM7007
	SZA CLA
	JMP	JNEOF	/NO; KEEP GOING.
	STA		/YES; SEND BACK EOF.
	JMP I	JILL	/EXIT.
JNEOF,	JMS I	JUGGLP	/UNSCREW RESPONSE FLD.
	 IBUF+0+20
JRSP2A,	 IBUF+200-1
	JMS I	JCARDP	/READ 1ST CARD
	 IBUF+50-1	 /OF PAIR.
	JMS I	JUGGLP	/UNSCREW RESPONSE FLD.
	 IBUF+50+20
JRSP1A,	 IBUF+300-1
	LAC	JRSP1A	/SET PTR TO CARD 1,
	DCA	X11	 /RESPONSE 1.
	LAC	K100	/OUTPUT RANGE:=ALPHA.
	DCA	JCHRNG
	DZM	JLEN	/INPUT LENGTH:=SINGLE.
	JMS I	JCONVP	/SEND CHARACTER 1.
	INC	JLEN	/INPUT LENGTH:=DOUBLE.
	JMS I	JCONVP	/SEND CHARACTER 2.
	JMS I	JCONVP	/SEND CHARACTER 3.
	DZM	JLEN	/INPUT LENGTH:=SINGLE.
	JMS I	JCONVP	/SEND CHARACTER 4.
	JMS I	JCONVP	/SEND CHARACTER 5.
	INC	JLEN	/INPUT LENGTH:=DOUBLE.
	JMS I	JCONVP	/SEND CHARACTER 6.
	LAC	J57	/OUTPUT RANGE:=0-4.
	DCA	JCHRNG
	DZM	JLEN	/INPUT LENGTH:=SINGLE.
	JMS	JMULT	/SEND CHARACTERS 7-12.
	 -6
	INC	JLEN	/INPUT LENGTH:=DOUBLE.
	JMS I	JCONVP	/SEND CHARACTER 13.
	JMS I	JCONVP	/SEND CHARACTER 14.
	INC	JCHRNG	/OUTPUT RANGE:=1-5.
	DZM	JLEN	/INPUT LENGTH:=SINGLE.
	JMS	JMULT	/SEND CHARACTERS 15-19.
	 -5
	LAC	J57	/OUTPUT RANGE:=0-4.
	DCA	JCHRNG
	INC	JLEN	/INPUT LENGTH:=DOUBLE.
	JMS I	JCONVP	/SEND CHARACTER 20.
	LAC	K100	/OUTPUT RANGE:=ALPHA.
	DCA	JCHRNG
	INC	JLEN	/INPUT LENGTH:=TRIPLE.
	JMS I	JCONVP	/SEND CHARACTER 21.
/(CO-ROUTINE CONTINUED.)
	LAC	J60	/OUTPUT RANGE:=1-5.
	DCA	JCHRNG
	DZM	JLEN	/INPUT LENGTH:=SINGLE.
	JMS	JMULT	/SEND CHARACTERS 22-26.
	 -5
	INC	X11	/SKIP RESPONSES 35
	INC	X11	 /AND 36.
	LAC	J57	/OUTPUT RANGE:=0-4.
	DCA	JCHRNG
	JMS I	JCNTP	/SEND CHARACTER 27.
	JMS I	JCNTP	/SEND CHARACTER 28.
	JMS I	JCNTP	/SEND CHARACTER 29.
	JMS I	JNUMXP	/SEND CHARACTER 30.
	 IBUF+50+1	/DATA IN CARD COLUMN 2.
	JMS I	JCNTP	/SEND CHARACTER 31.
	JMS I	JNUMP	/SEND CHARACTER 32.
	 IBUF+50+0	/DATA IN CARD COLUMN 1.
	LAC	JRSP2A	/SET PTR TO CARD 2,
	DCA	X11	 /RESPONSE 1.
	LAC	J60	/OUTPUT RANGE:=1-5.
	DCA	JCHRNG
	JMS	JMULT	/SEND CHARACTERS 33-45.
	 -15
	INC	X11	/SKIP RESPONSE 14.
	JMS	JMULT	/SEND CHARACTERS 46-71.
	 -32
	LAC	JM11	/SET CTR FOR 9 SPACES.
	DCA	JCTR
JFILL,	LAC	K40	/GET A SPACE.
	JMS	JGTNXT	/SEND CHARACTERS 72-80.
	ISZ	JCTR	/DONE ENOUGH?
	JMP	JFILL	/NO; DO NEXT.
	LAC	J15	/GET A <CR>.
	JMS	JGTNXT	/SEND END-OF-RECORD.
	JMP	JTOP	/DO IT ALL AGAIN.
JCARDP,	 JCARD
JIBUFP,	 IBUF
JM7007,	 -7007
JUGGLP,	 JUGGLE
JCONVP,	 JCONV
JCHRNG=IFILE
JLEN=IFILE+1
J60,	 60
J57,	 57
JCNTP,	 JCOUNT
JNUMXP,	 JNUMX
JNUMP,	 JNUM
JM11,	 -11
JCTR=IFILE+2
J15,	 15
/S/R TO CALL JCONV REPEATEDLY.
JMULT,	 0!0
	LAC I	JMULT	/GET ITERATION COUNT.
	INC	JMULT
	DCA	JCTR	/SET COUNTER.
JMLOOP,	JMS I	JCONVP	/SEND BACK A CHARACTER.
	ISZ	JCTR	/DONE ENOUGH?
	JMP	JMLOOP	/NO; DO ANOTHER.
	JMP I	JMULT	/YES; EXIT.
/READ IN A 40(10) COL. J-D STUDENT ANSWER CARD.
PAGE
JCARD,	 0!0
JRSTRT,	LAC I	JCARD	/SET BUFFER PTR.
	DCA	X11
	LAC	JM51
	DCA	JCOLCT	/SET COLUMN CTR.
	RCRB		/CLR ANY STRAY FLAGS.
	CLA STL RTR	/STATUS:=RDR UNREADY.
JRDYWT,	JMS	JKBD	/CHK FOR KBD CONTROLS.
	RCSE		/READER READY?
