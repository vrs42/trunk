/TERMINAL SETUP LOADER

/TERMINAL SETUP PROGRAM FOR DS-120.

/	LAST EDIT:	05-MAY-1984	18:00:00	CJL

/	DEFINITIONS.

	SBOOT=	7600		/MONITOR EXIT HERE
	TLSIOT=	6046		/OUTPUT TO TTY:
	TSFIOT=	6041		/SKIP ON TTY: DONE FLAG
	XR1=	10		/AUTO-INDEX REGISTER

	*200			/AS USUAL

TABLOD,	TSFIOT			/FLAG UP?
	TLSIOT			/NO, SET IT
	JMS	CRLF		/DO A <CR>, <LF>
	TAD	("H&177)	/GET AN "H"
	JMS	ESCSEND		/SEND <ESC> H
	TAD	(-20)		/SETUP THE
	DCA	TABCNT		/TAB COUNTER
TABLUP,	TAD	(-10)		/SETUP THE
	DCA	SPCNTR		/SPACE COUNTER
SPCLUP,	TAD	(" &177)	/GET A SPACE
	JMS	OUTPUT		/SEND IT
	ISZ	SPCNTR		/DONE A COMPLETE TAB ZONE?
	JMP	SPCLUP		/NO, KEEP GOING
	TAD	("1&177)	/GET A "1"
	JMS	ESCSEND		/SEND <ESC> 1
	ISZ	TABCNT		/DONE ALL TAB ZONES?
	JMP	TABLUP		/NO, KEEP GOING
	TAD	("O&177)	/GET AN "O"
	JMS	ESCSEND		/SEND <ESC> O
	TAD	("3&177)	/GET A "3"
	JMS	OUTPUT		/OUTPUT IT
	TAD	("4&177)	/GET A "4"
	JMS	OUTPUT		/OUTPUT IT
	TAD	("G&177)	/GET A "G"
	JMS	ESCSEND		/SEND <ESC> G
	TAD	("C&177)	/GET A "C"
	JMS	ESCSEND		/SEND <ESC> C
	TAD	("1&177)	/GET A "1"
	JMS	OUTPUT		/OUTPUT IT
	TAD	(TABL1-1)	/GET LIST POINTER
	JMS	STSEND		/SEND BIT STRING
	TAD	("C&177)	/GET A "C"
	JMS	ESCSEND		/SEND <ESC> C
	TAD	("A-1&177)	/GET AN <AT-SIGN>
	JMS	OUTPUT		/OUTPUT IT
	TAD	(TABL2-1)	/GET LIST POINTER
	JMS	STSEND		/SEND BIT STRING
	TAD	("I&177)	/GET AN "I"
	JMS	ESCSEND		/SEND <ESC> I
	JMP I	(SBOOT)		/EXIT TO MONITOR
CRLF,	.-.			/<CR>, <LF> ROUTINE
	TAD	(15)		/GET A <CR>
	JMS	OUTPUT		/OUTPUT IT
	TAD	(12)		/GET A <LF>
	JMS	OUTPUT		/OUTPUT IT
	JMP I	CRLF		/RETURN

OUTPUT,	.-.			/OUTPUT ROUTINE
	TSFIOT			/FLAG UP?
	JMP	.-1		/NO, WAIT FOR IT
	TLSIOT			/YES, SEND NEXT CHARACTER
	CLA			/CLEAN UP
	JMP I	OUTPUT		/RETURN

ESCSEND,.-.			/SEND <ESC> AND PASSED CHARACTER ROUTINE
	DCA	ESCTMP		/SAVE PASSED CHARACTER
	TAD	(33)		/GET AN <ESC>
	JMS	OUTPUT		/OUTPUT IT
	TAD	ESCTMP		/GET THE PASSED CHARACTER
	JMS	OUTPUT		/OUTPUT IT
	JMP I	ESCSEND		/RETURN

STSEND,	.-.			/STRING SEND ROUTINE
	DCA	XR1		/SAVE PASSED POINTER
STLOOP,	TAD I	XR1		/GET A CHARACTER
	SPA			/SKIP IF STILL IN MESSAGE
	JMP	STEXIT		/JUMP IF DELIMITER
	TAD	("0&177)	/CONVERT TO ASCII
	JMS	OUTPUT		/OUTPUT THE CHARACTER
	JMP	STLOOP		/KEEP GOING

STEXIT,	CLA			/CLEAN UP
	JMP I	STSEND		/RETURN

ESCTMP,	.-.			/TEMPORARY
SPCNTR,	.-.			/TEMPORARY
TABCNT,	.-.			/TEMPORARY

	PAGE
/	CHARACTER PATTERN TABLES.

	DECIMAL

TABL1,	0;8;1;4;2;2;4;1;5;5;4;1;4;1;-1
TABL2,	1;4;2;2;4;5;4;9;5;1;2;2;1;4;-1
