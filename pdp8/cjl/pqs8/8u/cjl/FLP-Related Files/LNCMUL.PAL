	ISSP		/SET LINC PC
	CLA		/CLEAN UP
	ICON		/STOP THE TAPES
	TAD	(10)	/GET SELECT VALUE
	ICON		/SELECT THE LINC
	IAC;IAC		/GET START VALUE
	ICON		/START THE LINC
	NOP		/WASTE
	NOP		/SOME
	NOP		/TIME
	CLA		/CLEAN UP
	IAAC		/GET LINC AC
