/	TEST OF VT-8/E (AND OVERLAY)

	*200

START,	NOP			/CLEAN UP
LOOP,	DPCL			/FLAG UP?
	JMP	LOOP		/NO, WAIT FOR IT
LOOP2,	DPCL			/WAIT
	JMP	LOOP2		/AGAIN
	LAS
	DCA	0
	ISZ	0
	JMP	.-1
	DPMD			/READ THE DATA BUFFER NOW
	MQL			/DISPLAY IT
	JMP	LOOP2		/DO IT AGAIN
 
	DPCL=	6456		/SKIP ON CLOCK FLAG, CLEAR IT
	DPMD=	6454		/READ DATA BUFFER
