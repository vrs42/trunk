
/    NICOLET DATA CONVERSION         P?S PAL V08I    23-MAR-86  PAGE 1

    1                /       NICOLET DATA CONVERSION
    2   
    3                /       PROGRAM TO CONVERT DATA LEFT IN MEMORY BY FOCAL WITH "NPATCH" INTO
    4                /       P?S/8 OUTPUT FILE(S).
    5   
    6                /       LAST EDIT:      23-MAR-1986     13:00:00        CJL
    7   
    8                /       MUST BE ASSEMBLED WITH '/J' SWITCH SET.
    9   
   10                /       ASSEMBLY INSTRUCTIONS:
   11   
   12                /       SET "BUFFLD" TO PROPER FIELD FOR MEMORY DATA (DEFAULT IS 20).
   13   
   14                /       SET "N" TO AMOUNT OF P?S/8 BLOCKS PER ORIGINAL READ/WRITE (DEFAULT IS 2).
   15                /       MUST BE A POWER OF TWO FOR PROPER OPERATION.
   16   
   17                /       DEFINITIONS.
   18   
   19                /       P?S/8 DEFINITIONS.
   20   
   21          0040          DOLBLK= 0040                    /DEFAULT ASCII SCRATCH AREA ($)
   22          0031          INCON=  0031                    /EQUATED FROM CONSOLE!
   23          0033          OUTCON= 0033                    /EQUATED FROM CONSOLE!
   24          0003          TTY=    0003                    /CONSOLE DEVICE CODE
   25          7600          SBOOT=  7600                    /SYSTEM EXIT HERE
   26          7602          SBTFUN= 7602                    /SYSTEM BOOTSTRAP UNIT WORD
   27          7611          SCRSIZE=7611                    /SOFTWARE CORE SIZE WORD
   28          7757          SFILES= 7757                    /PASSED FILES HERE
   29          7607          SOUTFLS=7607                    /OUTPUT FILE COUNT
   30          7605          SWMX=   7605                    /M-/X SWITCHES
   31          7640          SYSIO=  7640                    /ENTER I/O ROUTINES HERE
   32          4000          WRITE=  4000                    /SYSIO WRITE BIT
   33   
   34                /       OTHER DEFINITIONS.
   35   
   36                        IFNDEF  BUFFLD  <BUFFLD=20>     /BUFFER FIELD FOR FBLK AND FWRD
   38          3000          FILBUFF=3000                    /FILE CREATED IN 003000
   39          4200          JMSC=   JMS     .               /CURRENT PAGE JMS INSTRUCTION
   40          4240          JMSSYSI=SYSIO&177+JMSC          /CALL TO SYSIO ON ITS PAGE
   41          6032          KCCIOT= TTY^10+6002             /CLEAR KEYBOARD FLAG
   42          6034          KRSIOT= TTY^10+6004             /READ KEYBOARD BUFFER
   43          6031          KSFIOT= TTY^10+6001             /SKIP ON KEYBOARD FLAG
   44                        IFNDEF  LINE    <LINE=  7>      /SEVEN ON A LINE
   46                        IFNDEF  N       <N=     2>      /NUMBER OF P?S/8 BLOCKS IN READ/WRITE
   48          7326          NL0002= CLA CLL CML RTL         /LOAD AC WITH 0002
   49          7330          NL4000= CLA CLL CML RAR         /LOAD AC WITH 4000
   50          7346          NL7775= CLA CLL CMA RTL         /LOAD AC WITH 7775
   51          7240          NL7777= CLA CMA                 /LOAD AC WITH 7777
   52          6046          TLSIOT= TTY+1^10+6006           /OUTPUT TO TELEPRINTER
   53          6041          TSFIOT= TTY+1^10+6001           /SKIP ON TELEPRINTER FLAG


