 2849   07751* 0000  MEMTEM, .-.                             /WILL CONTAIN "CDF" TO LATEST DATA FIELD.
 2850   07752* 0000  CHKSUM, .-.                             /CHECKSUM ACCUMULATION TEMPORARY.


/    P?S/8 TC01/TC08 SYSTEM HANDLER  P?S PAL V08I    18-AUG-14  PAGE 57

 2852                /       <RO> STATE REVERSAL CONSTANT.
 2853   
 2854                /       LOCATION "FLIPIT" [07753] CONTAINS THE SUM OF THE TWO POSSIBLE VALUES
 2855                /       ("JMP BEGG1" [5244] AND "JMP NOTRUB" [5255]) TO ENABLE FLIPPING BETWEEN THE
 2856                /       TWO INSTRUCTIONS STORED IN "SWINST" [07647] AS REQUIRED.  THE CURRENT CONTENTS
 2857                /       OF "SWINST" [07647] WILL BE SUBTRACTED FROM THE CONTENTS OF "FLIPIT" [07753]
 2858                /       WHICH WILL THEN BE STORED IN "SWINST" [07647] REPLACING THE CURRENT CONTENTS
 2859                /       WITH THE OTHER INSTRUCTION.
 2860   
 2861          5255          INST1=  JMP     NOTRUB          /FIRST POSSIBLE VALUE OF SWINST.
 2862   
 2863          5244          INST2=  JMP     BEGG1           /SECOND POSSIBLE VALUE OF SWINST.
 2864   
 2865   07753* 2521  FLIPIT, INST1+INST2                     /SUM OF BOTH POSSIBLE VALUES.
 2866   
 2867   07754* 0000  WORD1,  .-.                             /FIRST CHARACTER.
 2868   07755* 0000  WORD2,  .-.                             /SECOND CHARACTER.
 2869                                                        
 2870                /       STAND-ALONE PAPER-TAPE RIM LOADER STARTS HERE.
 2871   
 2872   07756* 6032  BEG,    KCC                             /CLEAR THE KEYBOARD FLAG, START THE READER.
 2873                                                        /**** HIGH-SPEED READER **** RFC
 2874   07757* 6031  BEG1,   KSF                             /FLAG UP? **** HIGH-SPEED READER **** RSF
 2875   07760* 5357          JMP     .-1                     /NO, WAIT FOR IT.
 2876   07761* 6036  BEG3,   KRB                             /YES, READ IT LATEST AND START ANOTHER.
 2877                                                        /**** HIGH-SPEED READER **** RFC RRB
 2878   07762* 7106          CLL RTL;RTL                     /MOVE LEADER/TRAILER BIT TO AC[0]
        07763* 7006 
 2880   07764* 7510          SPA                             /SKIP IF NOT LEADER CODE.
 2881   07765* 5374          JMP     CLRAC                   /FOUND LEADER, IGNORE IT.
 2882   07766* 7006          RTL                             /MOVE FIRST HALF TO HIGH-ORDER BITS.
 2883   07767* 6031  BEG11,  KSF                             /FLAG UP? **** HIGH-SPEED READER **** RSF
 2884   07770* 5367          JMP     .-1                     /NO, WAIT FOR IT.
 2885   07771* 6034  BEG13,  KRS                             /YES, READ IT IN.
 2886                                                        /**** HIGH-SPEED READER **** RRB
 2887   07772* 7420          SNL                             /SKIP IF ORIGIN SETTING.
 2888   07773* 3776          DCA I   TEMP                    /STORE LATEST DATA WORD.
 2889   07774* 3376  CLRAC,  DCA     TEMP                    /STORE LATEST ORIGIN.
 2890   07775* 5356          JMP     BEG                     /KEEP GOING.
 2891   
 2892   07776* 0000  TEMP,   .-.                             /STORAGE ORIGIN TEMPORARY.
 2893   
