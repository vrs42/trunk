 2799                /       THIS IS THE STARTING ADDRESS OF THE BIN LOADER.  A "JMP BEGIN" [5306]
 2800                /       INSTRUCTION IS PLACED INTO 07777 AS THE OFFICIAL DOCUMENTED STARTING ADDRESS.
 2801   
 2802   07706* 6032  BEGIN,  KCC                             /CLEAR THE KEYBOARD FLAG TO START THE READER.
 2803                                                        /**** HIGH-SPEED READER **** RFC
 2804   07707* 7600  M200,   CLA!400                         /CLEAN UP; ALSO FORMS CONSTANT 7600.
 2805   07710* 6214          RDF                             /GET CURRENT DATA FIELD.
 2806   07711* 1301          TAD     CHANGE/(CDF 00)         /CREATE "CDF" INSTRUCTION TO CURRENT DATA FIELD.
 2807   07712* 3351          DCA     MEMTEM                  /SAVE FOR LOADING DATA.
 2808   07713* 4243          JMS     BEGG                    /GET A NEW CHARACTER.
 2809   07714* 5313          JMP     .-1                     /LEADER FOUND, IGNORE AND TRY AGAIN.
 2810   07715* 3352  GO,     DCA     CHKSUM                  /STORE NEW CHECKSUM VALUE.
 2811   07716* 1351          TAD     MEMTEM                  /GET "CDF" TO LATEST DATA FIELD.
 2812   07717* 3327          DCA     MEMFLD                  /STORE IN-LINE.
 2813   07720* 1350          TAD     CHAR                    /GET THE LATEST CHARACTER.
 2814   07721* 3354          DCA     WORD1                   /SAVE IT.
 2815   07722* 4271          JMS     READ                    /GET THE SECOND CHARACTER.
 2816   07723* 3355          DCA     WORD2                   /SAVE IT.
 2817   07724* 4243          JMS     BEGG                    /LOOK AHEAD FOR THE NEXT CHARACTER.
 2818   07725* 5302          JMP     BEND                    /TRAILER CODE FOUND.
 2819   07726* 4341          JMS     ASSEMB                  /ASSEMBLE LATEST WORD.
 2820   07727* 7402  MEMFLD, HLT                             /WILL BE "CDF" TO LATEST DATA FIELD.
 2821   07730* 7420          SNL                             /SKIP IF ORIGIN SETTING.
 2822   07731* 3776          DCA I   TEMP                    /STORE DATA WORD.
 2823   07732* 2376          ISZ     TEMP                    /BUMP TO NEXT LOCATION.
 2824   07733* 7430          SZL                             /SKIP IF DATA AND NOT AT LOCATION 0000.
 2825   07734* 3376          DCA     TEMP                    /STORE NEW ORIGIN SETTING [POSSIBLY 0000].
 2826   07735* 1354  CHEX,   TAD     WORD1                   /GET LATEST FIRST CHARACTER.
 2827   07736* 1355          TAD     WORD2                   /GET LATEST SECOND CHARACTER
 2828   07737* 1352          TAD     CHKSUM                  /ADD ON RUNNING CHECKSUM
 2829   07740* 5315          JMP     GO                      /KEEP GOING.
 2830   
 2831   07741* 0000  ASSEMB, .-.                             /WORD ASSEMBLE ROUTINE.
 2832   07742* 1354          TAD     WORD1                   /GET FIRST CHARACTER.
 2833   07743* 7106          CLL RTL;RTL;RTL                 /MOVE UP.
        07744* 7006 
        07745* 7006 
 2836   07746* 1355          TAD     WORD2                   /ADD SECOND CHARACTER.
 2837   07747* 5741          JMP I   ASSEMB                  /RETURN TO CALLER.
