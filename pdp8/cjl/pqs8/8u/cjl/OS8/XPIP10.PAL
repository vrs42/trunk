/OUTPUT CHARACTER #3 - BITS 9-11 WORD 2 AND BITS 0-3 WORD 3

OCHAR3,	TAD OCHARY
	CLL RTR
	RTR
	AND [7		/GET BITS 9-11
	TAD I OPOINT
	DCA I OPOINT	/SET WORD 2
