GETVAR,	.-.				/GET VARIABLE ROUTINE
LET,	JMS	GETWD			/GET A WORD
NOTKWD,	MUSTBE;		7000		/MUST BE A VARIABLE
	TAD	WORD			/VARIABLE ADDRESS
	DCA	VAR			/SETUP SCALAR ADDRESS
	DCA	SSONE			/CLEAR X COORDINATE
	DCA	SSTWO			/CLEAR Y COORDINATE
	GET+ISIT;	3755		/IS IT "("?
	JMP I	GETVAR			/NO, RETURN WITH SCALAR VARIABLE SETUP
	JMS I	PEVAL/[EVAL]		/YES, EVALUATE THE X COORDINATE VALUE
	JMS I	PFIX/[FIX]		/CONVERT TO INTEGER FORM
	DCA	SSONE			/SAVE AS X COORDINATE
	ISIT;		3763		/IS IT ","?
	JMP	NOCOMMA			/NO, APPARENTLY ONLY ONE DIMENSION
	JMS I	PEVAL/[EVAL]		/YES, EVALUATE THE Y COORDINATE VALUE
	JMS I	PFIX/[FIX]		/CONVERT TO INTEGER FORM
	DCA	SSTWO			/SAVE AS Y COORDINATE
NOCOMMA,MUSTBE;		3761		/MUST BE ")"
	JMS	GETWD			/GET THE STORAGE ADDRESS SETUP
	JMP I	GETVAR			/RETURN TO CALLER

/	sTORE A VARIABLE ROUTINE.

STOVAR,	.-.				/STORE VARIABLE VALUE ROUTINE
	JMS I	PGETADDR/[GETADDR]	/GET THE FULL ADDRESS OF THE VARIABLE
VAR,	.-.				/SCALAR OR ARRAY BASE ADDRESS
SSONE,	.-.				/FIRST COORDINATE
SSTWO,	.-.				/SECOND COORDINATE
	FENTER				/USE THE FPP
	FSTI	ADDRESS			/STORE THE VALUE WHERE IT BELONGS
	FEXIT				/EXIT THE FPP
	JMP I	STOVAR			/RETURN TO CALLER
/	FUNCTION ERROR COMES HERE.

FNERR,	JMS I	PERROR/[ERR0R]		/CALL ERROR PRINTER
	TEXT	'FUNCTION'		/FUNCTION ERROR

CLRCNT,	.-.				/ROUTINE WHICH CHECKS THE STATUS OF THE
					/CONTROL C FLAG.
	NL0001				/SET AC TO 0001
	TAD	NOINT			/WAS THE FLAG SET TO -1?
	SNA CLA				/SKIP IF NOT
	JMP I	PBOMB/(CNTLCR)		/YEP, GIVE STOP MESSAGE.
	DCA	NOINT			/NOPE. RESET IT.
	JMP I	CLRCNT			/AND EXIT

PBOMB,	CNTCLR				/POINTER TO CONTROL-C CLEAR ROUTINE

/	TOO-BIG ERROR COMES HERE.

SPACERR,JMS I	PERROR/[ERR0R]		/CALL ERROR PRINTER
	TEXT	'TOO-BIG'		/TOO-BIG ERROR

/	IF COMMAND.

IF,	JMS I	PEVAL/[EVAL]		/EVALUATE ARGUMENT
	FENTER				/USE THE FPP
	FST	OPERAND			/STORE THE ARGUMENT
	FEXIT				/EXIT THE FPP
	MUSTBE;		1774		/MUST BE 'THEN'
	TAD	OPERAND			/GET HIGH-ORDER OPERAND
	SPA SNA CLA			/SKIP IF STRICTLY POSITIVE
	JMP	SKIPIT			/ELSE IGNORE THE REST OF THE LINE
	GET+ISIT;	0000		/CHECK IF NEXT IS A LINE NUMBER
	JMP I	XEXECU/(EXECUTE+1)	/JUMP IF NOT
	JMP	GOTO+1			/JUMP IF IT IS

XEXECU,	EXECUTE+1			/POINTER TO EXECUTION ROUTINE
/	FOR COMMAND.

FOR,	GET+MUSTBE;	7000		/MUST BE A VARIABLE
	JMS	FINDIT			/LOCATE IT
	JMP	NOTHERE			/JUMP IF NOT PRESENT
	NL0001				/SET +1
	TAD	INDEX1			/GET INDEX VALUE
	DCA	INDEX2			/SETUP NEW VALUE
	NL7777				/SET -1
	TAD	INDEX1			/GET DECREMENTED INDEX VALUE
	DCA	INDEX1			/STORE BACK
	JMP	INLUPF			/CONTINUE THERE

LUPF,	TAD I	INDEX2			/GET A WORD
	DCA I	INDEX1			/PUT A WORD
	TAD I	INDEX2			/GET A WORD
	DCA I	INDEX1			/PUT A WORD
INLUPF,	ISZ	GOTEMP			/DONE YET?
	JMP	LUPF			/NO, GO DO IT AGAIN
	ISZ	FORCT			/BUMP LOOP NESTING COUNTER
NOTHERE,TAD	FORCT			/GET THE COUNTER
	TAD	O11/(11)		/COMPARE TO LIMIT [9]
	SPA SNA	CLA			/SKIP IF TOO FAR IN
	JMP	FORERR			/CANNOT FIT 9 IN FORLIST
	TAD	WORD			/GET CURRENT WORD
	CIA				/NEGATE IT
	DCA I	INDEX1			/STORE THROUGH HERE
	TAD	WORD			/GET CURRENT WORD
	DCA	FORVAR			/STORE INLINE.
	GET+MUSTBE;	3673		/NEXT MUST BE "="
	JMS I 	PEVAL/[EVAL]		/EVALUATE INITIAL VALUE
	JMS I	PGETADD/[GETADDR]	/GET THE VARIABLE ADDRESS SETUP
FORVAR,	ZBLOCK	3			/VARIABLE INDEX PARTICULARS HERE
	FENTER				/USE THE FPP
	FSTI	ADDRESS			/STORE THE VALUE WHERE IT BELONGS
	FEXIT				/EXIT THE FPP
	MUSTBE;	3757			/MUST BE "TO"
	TAD	LOCCTR			/GET LOCATION COUNTER
	DCA I	INDEX1			/STORE IT
	NL7777				/\
	TAD	FORCT			/ >SET AN ADDITIONAL LEVEL DEEP
	DCA	FORCT			//
SKIPIT,	JMS I	PIGNORE/(IGNORE)	/LOOK FOR "\" OR <CR>
	JMP I	PEXECUTE/[EXECUTE]	/AND EXECUTE THE NEXT STATEMENT

PIGNORE,IGNORE				/POINTER TO IGNORE THE REST OF THE LINE ROUTINE
PASSCR,	.-.				/LOOK FOR REAL <CR> ROUTINE
PASAGN,	JMS I	PIGNORE/(IGNORE)	/LOOK FOR "\" OR <CR>
	ISZ	WORD			/BUMP TO NEXT
	ISIT;	4100			/IS IT A REAL <CR>?
	JMP	PASAGN			/NOPE, IT WAS A "\".
	JMP I	PASSCR			/RETURN TO CALLER

FORERR,	JMS I	PERROR/[ERR0R]		/CALL ERROR PRINTER
	TEXT	'FOR'			/FOR ERROR

O11,	11				/CONSTANT 0011

GOSUB,	JMS	GETWD			/GET THE NEXT WORD
	JMS	GOBOTH			/WHICH IS A LINE NUMBER
	TAD	GSBPTR			/GET CURRENT DEPTH POINTER
	TAD	MGSBEND/(-GSBEND)	/COMPARE TO UPPER LIMIT
	SNA CLA				/SKIP IF NOT TOO DEEP
	JMP	DEEPERR			/JUMP IF IN TOO DEEP
	TAD	LOCCTR			/GET CURRENT PROGRAM COUNTER
	DCA I	GSBPTR			/PLACE ON THE STACK
	ISZ	GSBPTR			/BUMP TO NEXT FOR NEXT TIME
	JMP	GOSUBENTRY		/CONTINUE EXECUTION AT THE STATED NUMBER

GOTO,	JMS	GETWD			/GET THE NEXT WORD
	JMS	GOBOTH			/WHICH IS A LINE NUMBER
GOSUBEN,ISZ	GOTEMP			/BUMP TO NEXT
	TAD I	GOTEMP			/GET SAVED RETURN POINT
	DCA	LOCCTR			/RESTORE IT
	JMP I	PEXECUTE/[EXECUTE]	/AND CONTINUE EXECUTION

MGSBEND,-GSBEND

DEEPERR,JMS I	PERROR/[ERR0R]		/CALL ERROR PRINTER
	TEXT "GOSUB"			/GOSUB ERROR
GOBOTH,	.-.
	MUSTBE;	0000			/MUST BE A LINE NUMBER
	TAD	WORD			/GET THE VALUE
	DCA	GOTEMP			/SAVE IT
	ISZ	WORD			/BUMP PAST
	ISIT;	0000			/IS IT DEFINED?
	JMP	ISITDF			/YES
	JMS I	PERROR			/NO, PRINT UNDEFINED
	TEXT	"LINENO"		/LINE NUMBER ERROR

ISITDF,	GET+MUSTBE;	2000		/MUST BE <CR> OR "\"
	JMP I	GOBOTH			/RETURN TO CALLER

VARTEMP,ZBLOCK	3			/VARIABLE TEMPORARY
PXFORLI,FORLIST-1			/FOR LIST POINTER VALUE

FINDIT,	.-.
	TAD	FORCT
	DCA	GOTEMP
	TAD	PXFORLI/(FORLIST-1)
	DCA	INDEX1
	JMP	INLOOP

FINDLUP,TAD I	INDEX1
	TAD	WORD
	SNA CLA
	JMP	FOUND
	ISZ	INDEX1
INLOOP,	ISZ	GOTEMP
	JMP	FINDLUP
	JMP I	FINDIT

FOUND,	ISZ	FINDIT
	JMP I	FINDIT

	PAGE
NEXT,	GET+MUSTBE;	7000		/MUST BE A VARIABLE
	JMS I	PFINDIT/(FINDIT)
	JMP	NEXTERR			/COULDN'T LOCATE IT
	TAD	WORD
	DCA	NEXTVAR
	GET+MUSTBE;	2000		/MUST BE <CR> OR "\"
	TAD	LOCCTR
	DCA	LOCTEMP
	TAD I	INDEX1
	DCA	LOCCTR
	JMS I 	PEVAL/[EVAL]
	FENTER
	FST+FWD+FORLIM-.
	FEXIT
	ISIT;	2000			/IS IT <CR> OR "\"
	JMP	TRYSTEP			/NO
	FENTER
	FLD	ONE
	FJMP+FWD+GOTSTEP-.

TRYSTEP,MUSTBE;		3756		/"STEP"
	JMS I	PEVAL/[EVAL]
	MUSTBE;		2000		/MUSTB BE <CR> OR "\"
	FENTER
GOTSTEP,FST+FWD+FORSTEP-.
	FEXIT
	JMS I	PGETADDR
NEXTVAR,ZBLOCK	3
	FENTER
	FLDI	ADDRESS
	FAD+FWD+FORSTEP-.
	FST+BKWD+.-VARTEMP
	FSB+FWD+FORLIM-.
	FEXIT
	TAD	ACS
	TAD	FORSTEP
	SMA CLA
	TAD	AC1
	SZA CLA
	JMP	FORDONE
	FENTER
	FLD+BKWD+.-VARTEMP
	FSTI	ADDRESS
	FEXIT
	JMP I	PEXECUTE
FORDONE,TAD	LOCTEMP
	DCA	LOCCTR
	ISZ	FORCT
	ISZ	GOTEMP
	JMP	.-2
	JMP I	PEXECUTE

LOCTEMP,.-.
PFINDIT,FINDIT

NEXTERR,JMS I	PERROR/[ERR0R]		/CALL ERROR PRINTER
	TEXT	"NEXT"

RETURN,	GET+MUSTBE;	2000		/MUST BE <CR> OR "\"
	TAD	GSBPTR
	TAD	MGOLIST
	SNA CLA
	JMP	RETNERR
	NL7777
	TAD	GSBPTR
	DCA	GSBPTR
	TAD I	GSBPTR
	DCA	LOCCTR
	JMP I	PEXECUTE

RETNERR,JMS I	PERROR/[ERR0R]		/CALL ERROR PRINTER
	TEXT	"RETURN"

MGOLIST,-GOLIST
FORLIM,	ZBLOCK	3
FORSTEP,ZBLOCK	3
	*.-1				/SGN FUNCTION HEADER OVERLAPS FORSTEP STORAGE!

/	SGN FUNCTION.

SGN,	.-.				/SIGN FUNCTION ENTRY
	FENTER				/USE THE FPP
	FSGE				/SKIP IF GREATER THAN OR EQUAL ZERO
	FLD+FWD+MNSONE-.		/LOAD MINUS ONE FOR NEGATIVE VALUES
	FSLE				/SKIP IF LESSER THAN OR EQUAL ZERO
	FLD	ONE			/LOAD PLUS ONE FOR STRICTLY POSITIVE VALUES
	FEXIT				/EXIT THE FPP
	JMP I	SGN			/RETURN

	IFNZRO	FORSTEP+2-SGN	<ERROR	.>

MNSONE,	6014;0;0			/FLOATING CONSTANT -1.0

PUTCH,	.-.
	DCA	SGN
	TAD	SGN
PCCUNT,	AND	O177/[177]
	TAD	O7763A
	SZA CLA				/IS IT A <CR>?
	JMP	PNOCR			/NOPE.
	TAD	PCCUNT			/ADD IN EXTRA PLACES FOR GOOD LUCK
	TAD	COLUMN			/SAVE COLUMN POSITION
	DCA	NEXTVAR
	DCA	COLUMN
	TAD	NEXTVAR			/REGET WHERE WE WERE.
	AND	PUTXRA			/ARE WE INSERTING <NUL> CHARACTERS?
	CLL RAR				/NO DIVIDE BY 2.
PNOCR,	CLL CML CMA RAR			/AND NOW INVERT AND DIVIDE BY 2 AGAIN.
	DCA	NEXTVAR			/SAVE FOR LATER USE.  THIS IS THE NULL COUNTER.
	TAD	SGN			/RECALL THE CHARACTER
	AND	 O140A
	SZA
	TAD	O7640A
O7640A,	SZA CLA
	ISZ	COLUMN
	TAD	SGN
	JMS I	 JPUTCH
	ISZ	NEXTVAR			/INCREMENTS THE COUNTER
	JMP	.-2			/GIVE NULLS UNTIL IT'S SATISFIED.
	JMP I	 PUTCH

O7763A,	7763
O140A,	140
PUTXRA,	.-.				/<NUL> AFTER <CR> WORD.
JPUTCH,	PUTER
	PAGE

/	BASIC STARTS HERE.

START,	JMS I	XRESTA/(XRESTA)		/RESET FLAGS AND DEVICES.
	JMP I	.+1/(SCRATCH)		/GO START IT UP
	SCRATCH				/THROUGH HERE

XRESTA,	ISET				/POINTER TO INTERRUPT RESET ROUTINE

EVAL,	.-.				/EXPRESSION EVALUATOR ROUTINE
	JMS	GETWD			/GET LATEST WORD
	TAD	EVAL			/GET OUR CALLER
EVALGO,	JMS I	PPUSH/[PUSH]		/PUSH ONTO THE STACK
	TAD	O4014/(4014)		/GET DONE CODE
	JMS I	PPUSH/[PUSH]		/PUSH ONTO THE STACK
	JMP	GETOPR+1		/CONTINUE THERE

ISUMIN,	TAD	O4213/(4213)		/GET UNARY MINUS CODE
	JMS I	PPUSH/[PUSH]		/PUSH ONTO THE STACK
GETOPR,	JMS	GETWD			/GET NEXT WORD
	ISIT;		3577		/IS IT "-"?
	SKP				/SKIP IF NOT
	JMP	ISUMIN			/JUMP IF SO
	ISIT;		3600		/IS IT "+"?
	SKP				/SKIP IF NOT
	JMP	GETOPR			/GO GET ANOTHER ONE
	ISIT;		3755		/IS IT "("
	JMP	NOPAREN			/JUMP IF NOT
	JMS	EVAL			/YES, GO EVALUATE SUB-EXPRESSION
	MUSTBE;		3761		/MUST BE ")"
	JMP I	PGOTOPR			/CONTINUE THERE
NOPAREN,ISIT;		7000		/IS IT A VARIABLE?
	JMP	NOTVAR			/JUMP IF NOT
	DCA	ONESS			/CLEAR X COORDINATE
	DCA	TWOSS			/CLEAR Y COORDINATE
	TAD	WORD			/GET ADDRESS
	DCA	WDTEMP			/STORE INLINE
	GET+ISIT;	3755		/IS NEXT A "("?
	JMP	GOTSS			/NO
	TAD	WDTEMP			/GET THE PREVIOUS ADDRESS
	JMS I	PPUSH/[PPUSH]		/PLACE ON STACK
	JMS	EVAL			/EVALUATE LATEST
	ISIT;		3763		/IS IT A ","
	JMP	ONEDIM			/JUMP IF NOT
	JMS I	PFIX/[FIX]		/CONVERT TO BINARY INDEX
	JMS I	PPUSH/[PUSH]		/PLACE ON STACK
	JMS	EVAL			/EVALUATE THIS ONE
	JMS I	PFIX/[FIX]		/CONVERT TO BINARY INDEX
	DCA	TWOSS			/SAVE AS Y COORDINATE
	JMS I	PPOP/[POP]		/GET SAVED VALUE
	JMP	.+3			/CONTINUE THERE

ONEDIM,	DCA	TWOSS			/CLEAR Y COORDINATE FOR ONE DIMENSIONAL ARRAYS
	JMS I	PFIX/[FIX]		/CONVERT LATEST TO BINARY INDEX
	DCA	ONESS			/SAVE AS X COORDINATE
	MUSTBE;		3761		/MUST BE ")"
	JMS I	PPOP/[POP]		/GET ORIGINAL BASE
	DCA	WDTEMP			/STORE INLINE
	JMS	GETWD			/GET NEXT WORD
GOTSS,	JMS I	PGETADDR/[GETADDR]	/GET THE STORAGE ADDRESS SETUP
