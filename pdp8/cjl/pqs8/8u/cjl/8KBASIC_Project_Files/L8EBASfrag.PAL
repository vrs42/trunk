MVLUP1,	TAD I	ADDRESS
	ISZ	ADDRESS
	JMS I	PSTICKIT
	ISZ	GSS2
	JMP	MVLUP1
	TAD	GDIM2
	CIA
	TAD	O4
	DCA	GDIM2
	JMS I	PSTICKIT
	ISZ	GDIM2
	JMP	.-2
	NL7775
	TAD	GETADDR
	DCA	GETADDR
	JMS I	CNCLR			/CHECK FOR CONTROL C.
	JMP	GETADDR+1

GSS1,	.-.
GSS2,	.-.
GDIM2,	.-.
PSPACER,SPACERR
O7774,	7774
O13,	13				/(12) IF 1 ORG INDEXING

SSERR,	JMS I	PERROR
	TEXT	"SUBSCRIPT"
DEF,	TAD	LINEND
	DCA	INDEX1
	TAD I	 INDEX1
	DCA	USERFN
	GET+MUSTBE;	3754		/NEXT MUST BE 'FN'
	GET+MUSTBE;	7000		/NEXT MUST BE A VARIABLE
	GET+MUSTBE;	3755		/NEXT MUST BE '("
	GET+MUSTBE;	7000		/NEXT MUST BE A VARIABLE
	GET+MUSTBE;	3761		/NEXT MUST BE ")"
	GET+MUSTBE;	3673		/NEXT MUST BE "="
	JMP I	PSKIPIT/(SKIPIT)	/KEEP GOING

PSKIPIT,SKIPIT				/POINTER TO SKIPIT ROUTINE

USERFN,	.-.
MDRERD,	MUSTBE;	3763			/MUST BE ','
READ,	JMS I	PGETVAR
	NL7777
	TAD	LOCCTR
	DCA	LOCTMP
	TAD	READLOC
	DCA	LOCCTR
	GET+ISIT;	2000		/(CR) OR '\'
	SKP
	JMP	SEARCH
	ISIT;	0000			/A LINENO
	SKP
	JMP	SEARCH
	ISIT;	3763			/','
	JMP	DATAERR
ISSOME,	JMS I	PEVAL
	NL7777
	TAD	LOCCTR
	DCA	READLOC
	TAD	LOCTMP
	DCA	LOCCTR
	JMS I	PSTOVAR
	GET+ISIT;	2000		/(CR) OR '\'
	JMP	MDRERD
	JMP I	PEXECUTE
SCHMOR,	JMS	GETWD
SEARCH,	ISIT;	1757			/'DATA'
	SKP
	JMP	ISSOME
	ISIT;	1755			/(EOF)
	JMP	SCHMOR
DATAERR,JMS I	PERROR
	TEXT	"DATA"

LOCTMP,	.-.

GETBLK,	.-.
	JMS I	PCHKFIT
	TAD	CODELOC
	DCA	LOCCTR
	TAD	CODELOC
	TAD	ABCDEF
	DCA	CODELOC
	TAD	CODELOC
	DCA	BCDEFG
	TAD	PSYMTAB			/UPDATE STMBOL TABLE NOW.
	TAD	ABCDEF			/BY ADDING IN CORRECTION FACTOR.
	DCA	PSYMTAB

GTBKLP,	TAD I	LOCCTR			/MOVE TEXT NOW.
	ISZ	LOCCTR
	DCA I	BCDEFG
	ISZ	BCDEFG
	TAD	BCDEFG			/NOW CHECK FOR END.
	CIA
	TAD	PSYMTAB
	SZA CLA
	JMP	GTBKLP

	NL7777
	TAD	NSYMTAB
	DCA	NSYMTAB
	TAD	GSBPTR
	CMA
	TAD	PGOLIST
	DCA	BCDEFG
	TAD	PGOLIST
	DCA	WORD
	TAD	ABCDEF
	TAD I	WORD
	DCA I	WORD
	ISZ	WORD
	ISZ	BCDEFG
	JMP	.-5
/

	TAD	FORCT
	DCA	BCDEFG
	TAD	PPFORLIS
	DCA	WORD
	JMP	.+6

	TAD	ABCDEF
	TAD I	WORD
	DCA I	WORD
	ISZ	WORD
	ISZ	WORD
	ISZ	BCDEFG
	JMP	.-6
	TAD	PSYMTAB
	JMP I	GETBLK

ABCDEF,	-4
BCDEFG,	.-.
PPFORLI,FORLIST+1

PUTJ,	.-.
	JMS I	PFIX
	CLA
	TAD	AC3
	JMS I	PPUTCH
	JMS I	PANORM
	JMP I	PUTJ

GETJ,	.-.				/GETS A CHARACTER FROM THE TTY.
	JMS I	PBEGFIX			/CLEAN UP THE FAC
	JMS I	PGETCH			/FETCH A CHAR.
	DCA	AC3			/SAVE IT, BABY!
	JMS I	PANORM			/AND NORMALIZE AC.
	JMP I	GETJ			/AND RETURN NOW.

PBEGFIX,BEGFIX
	PAGE

/	TEMPORARY FIXUPS TO ELIMINATE ASSEMBLY ERRORS REFERENCING SECTIONS OF CODE NOT
/	YET ADDED IN.  REMOVE WHEN ALL THE CODE IS TYPED UP AND THERE ARE NO ASSEMBLY
/	OR BINARY COMPARE ERRORS.  SYMBOLS REDUNDANT TO ROUTINES ALREADY TYPED UP ARE
/	PRESENT GIVEN THAT, DURING THE DEVELOPMENT, SOME WERE TYPED UP LATER; THERE IS
/	NO POINT IN REMOVING THE FIXUPS PREMATURELY; THE VALUES MUST BE IDENTICAL IN
/	ORDER FOR IT TO PASS MUSTER COMPLETELY.  TOTAL REMOVAL WILL BE QUITE WELCOME.

