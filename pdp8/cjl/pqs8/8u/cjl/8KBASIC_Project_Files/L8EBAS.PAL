MGOLIST,-GOLIST
FORLIM,	ZBLOCK	3
FORSTEP,ZBLOCK	3
	*.-1				/SGN FUNCTION HEADER OVERLAPS FORSTEP STORAGE!

/	SGN FUNCTION.

SGN,	.-.				/SIGN FUNCTION ENTRY
	FENTER				/USE THE FPP
	FSGE				/SKIP IF GREATER THAN OR EQUAL ZERO
	FLD+FWD+MNSONE-.		/LOAD MINUS ONE FOR NEGATIVE VALUES
	FSLE				/SKIP IF LESSER THAN OR EQUAL ZERO
	FLD	ONE			/LOAD PLUS ONE FOR STRICTLY POSITIVE VALUES
	FEXIT				/EXIT THE FPP
	JMP I	SGN			/RETURN

	IFNZRO	FORSTEP+2-SGN	<ERROR	.>

MNSONE,	6014;0;0			/FLOATING CONSTANT -1.0

PUTCH,	.-.
	DCA	SGN
	TAD	SGN
PCCUNT,	AND	O177/[177]
	TAD	O7763A
	SZA CLA				/IS IT A <CR>?
	JMP	PNOCR			/NOPE.
	TAD	PCCUNT			/ADD IN EXTRA PLACES FOR GOOD LUCK
	TAD	COLUMN			/SAVE COLUMN POSITION
	DCA	NEXTVAR
	DCA	COLUMN
	TAD	NEXTVAR			/REGET WHERE WE WERE.
	AND	PUTXRA			/ARE WE INSERTING <NUL> CHARACTERS?
	CLL RAR				/NO DIVIDE BY 2.
PNOCR,	CLL CML CMA RAR			/AND NOW INVERT AND DIVIDE BY 2 AGAIN.
	DCA	NEXTVAR			/SAVE FOR LATER USE.  THIS IS THE NULL COUNTER.
	TAD	SGN			/RECALL THE CHARACTER
	AND	 O140A
	SZA
	TAD	O7640A
O7640A,	SZA CLA
	ISZ	COLUMN
	TAD	SGN
	JMS I	 JPUTCH
	ISZ	NEXTVAR			/INCREMENTS THE COUNTER
	JMP	.-2			/GIVE NULLS UNTIL IT'S SATISFIED.
	JMP I	 PUTCH

O7763A,	7763
O140A,	140
PUTXRA,	.-.				/<NUL> AFTER <CR> WORD.
JPUTCH,	PUTER
	PAGE

/	BASIC STARTS HERE.

START,	JMS I	XRESTA/(XRESTA)		/RESET FLAGS AND DEVICES.
	JMP I	.+1/(SCRATCH)		/GO START IT UP
	SCRATCH				/THROUGH HERE

XRESTA,	ISET				/POINTER TO INTERRUPT RESET ROUTINE

EVAL,	.-.				/EXPRESSION EVALUATOR ROUTINE
	JMS	GETWD			/GET LATEST WORD
	TAD	EVAL			/GET OUR CALLER
EVALGO,	JMS I	PPUSH/[PUSH]		/PUSH ONTO THE STACK
	TAD	O4014/(4014)		/GET DONE CODE
	JMS I	PPUSH/[PUSH]		/PUSH ONTO THE STACK
	JMP	GETOPR+1		/CONTINUE THERE

ISUMIN,	TAD	O4213/(4213)		/GET UNARY MINUS CODE
	JMS I	PPUSH/[PUSH]		/PUSH ONTO THE STACK
GETOPR,	JMS	GETWD			/GET NEXT WORD
	ISIT;		3577		/IS IT "-"?
	SKP				/SKIP IF NOT
	JMP	ISUMIN			/JUMP IF SO
	ISIT;		3600		/IS IT "+"?
	SKP				/SKIP IF NOT
	JMP	GETOPR			/GO GET ANOTHER ONE
	ISIT;		3755		/IS IT "("
	JMP	NOPAREN			/JUMP IF NOT
	JMS	EVAL			/YES, GO EVALUATE SUB-EXPRESSION
	MUSTBE;		3761		/MUST BE ")"
	JMP I	PGOTOPR			/CONTINUE THERE
NOPAREN,ISIT;		7000		/IS IT A VARIABLE?
	JMP	NOTVAR			/JUMP IF NOT
	DCA	ONESS			/CLEAR X COORDINATE
	DCA	TWOSS			/CLEAR Y COORDINATE
	TAD	WORD			/GET ADDRESS
	DCA	WDTEMP			/STORE INLINE
	GET+ISIT;	3755		/IS NEXT A "("?
	JMP	GOTSS			/NO
	TAD	WDTEMP			/GET THE PREVIOUS ADDRESS
	JMS I	PPUSH/[PPUSH]		/PLACE ON STACK
	JMS	EVAL			/EVALUATE LATEST
	ISIT;		3763		/IS IT A ","
	JMP	ONEDIM			/JUMP IF NOT
	JMS I	PFIX/[FIX]		/CONVERT TO BINARY INDEX
	JMS I	PPUSH/[PUSH]		/PLACE ON STACK
	JMS	EVAL			/EVALUATE THIS ONE
	JMS I	PFIX/[FIX]		/CONVERT TO BINARY INDEX
	DCA	TWOSS			/SAVE AS Y COORDINATE
	JMS I	PPOP/[POP]		/GET SAVED VALUE
	JMP	.+3			/CONTINUE THERE

ONEDIM,	DCA	TWOSS			/CLEAR Y COORDINATE FOR ONE DIMENSIONAL ARRAYS
	JMS I	PFIX/[FIX]		/CONVERT LATEST TO BINARY INDEX
	DCA	ONESS			/SAVE AS X COORDINATE
	MUSTBE;		3761		/MUST BE ")"
	JMS I	PPOP/[POP]		/GET ORIGINAL BASE
	DCA	WDTEMP			/STORE INLINE
	JMS	GETWD			/GET NEXT WORD
GOTSS,	JMS I	PGETADDR/[GETADDR]	/GET THE STORAGE ADDRESS SETUP
WDTEMP,	.-.				/BASE ADDRESS
ONESS,	.-.				/X INDEX
TWOSS,	.-.				/Y INDEX
	FENTER				/USE THE FPP
	FLDI	ADDRESS			/GET THE VALUE
	FEXIT				/EXIT THE FPP
	JMP I	.+1/(OPDONE)		/CONTINUE THERE
	OPDONE				/THROUGH HERE

NOTVAR,	JMS I	PISITLIT/[ISITLIT]	/IS IT A LITERAL?
	JMP	ISITFUN			/NO
	JMP I	PGOTOPR/[GOTOPR]	/IT IS IN THE AC NOW
ISITFUN,TAD I	WORD			/GET VALUE
	TAD	O3754/(3754)		/-4024, WHICH IS BEGINNING OF FUNCTIONS.
	SPA				/IS IT A LEGAL FUNCTION?
	JMP I	PSXERR/[SXERR]		/NO, EXIT WITH MESSAGE.
	SNA				/WAS IT "FN"?
	JMS	GETWD			/YES, SKIP OVER LETTER
	JMS I	 PPUSH/[PUSH]		/PUSH VALUE ON STACK
	GET+MUSTBE;	3755		/MUST BE "("
	JMS	EVAL			/EVALUATE THE ARGUMENT
	JMS I	PPOP			/GET THE VALUE BACK
	TAD	FJUMP/(JMS I	FUNTAB)	/GET TABLE BASE
	DCA	.+1			/STORE INLINE
	HLT				/WILL BE PROPER SUBROUTINE CALL
	JMP I	.+1/(FNEXIT)		/RETURN
	FNEXIT				/THROUGH HERE

FJUMP,	JMS I	FUNTAB			/JMS TABLE BASE INSTRUCTION

FUNTAB,	FN				/BUILT-IN FUNCTION
	COS				/COSINE
