GETWD,	.-.				/GET A WORD ROUTINE
	TAD I	LOCCTR			/GET LATEST WORD
	DCA	WORD			/SAVE IT
	ISZ	LOCCTR			/BUMP TO NEXT WORD
	JMP I	GETWD			/RETURN

PLETDO,	LETDO				/POINTER TO LETDO ROUTINE.

LETDO,	MUSTBE;		3673		/MUST BE "="
	JMS I	PEVAL/[EVAL]		/EVALUATE IT
	MUSTBE;		2000		/MUST BE <CR> OR "\"
	JMS	STOVAR			/CALL STOVAR
EXECUTE,JMS	GETWD			/GET A WORD
	TAD	PLETDO/(LETDO)		/GET LETDO ROUTINE POINTER
	DCA	GETVAR			/SETUP WORKING POINTER
	TAD I	WORD			/GET LATEST WORD ADDRESS
	SPA				/SKIP IF HIGH-ORDER NOT SET
	JMP	KEYWD			/JUMP IF NOT
	SZA CLA				/IS IT A LINE NUMBER?
	JMP	NOTKWD			/JUMP IF NOT
	TAD	WORD			/GET WORD ADDRESS
	DCA	LINEND			/SAVE LATEST LINE VALUE
	JMS	GETWD			/GET THE NEXT WORD
	TAD I	WORD			/GET WORD ADDRESS
	SMA CLA				/SKIP IF HIGHEST SET
	JMP	NOTKWD			/JUMP IF NOT KEYWORD
KEYWD,	NL2000				/SET BIT[1] WITH CLEAR LINK
	TAD I	WORD			/GET NEXT WORD
	SNL				/IS IT A STATEMENT?
	JMP I	PSXERR/[SXERR]		/NO, THAT IS A SYNTAX ERROR
	TAD	SJUMP			/GET JUMP TABLE OFFSET
	DCA	.+1			/STORE IT INLINE
	HLT				/GOTO THE APPROPRIATE PLACE

SJUMP,	JMP I	.+1			/POINTER TO JUMP TABLE
/	JUMP ADDRESS TABLE.

	EXECUTE				/<CR>/<LF> OR "\"
