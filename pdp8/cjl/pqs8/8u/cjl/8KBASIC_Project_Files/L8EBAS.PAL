	IFNDEF	GET	<GET=	1>	/GET VALUE CALL OFFSET PAST CHECKING ROUTINES
					/TO DEFINE GET NEXT WORD AND CHECK ROUTINES.

ISITADR,ISIT=	JMS I	.;	XISIT	/ISIT ROUTINE POINTER

GISITAD,XGISIT				/GET+ISIT ROUTINE ADDRESS

