/	FLOATING POINT PACKAGE DEFINITIONS.

	FEXIT=	0000		/EXIT FLOATING POINT PROCESSING.
	FSNE=	0040		/SKIP IF FLOATING POINT AC NOT EQUAL ZERO.
	FSEQ=	0050		/SKIP IF FLOATING POINT AC EQUAL ZERO.
	FSGE=	0100		/SKIP IF FLOATING POINT AC GREAT THAN OR EQUAL ZERO.
	FSLT=	0110		/SKIP IF FLOATING POINT AC LESS THAN ZERO.
	FSGT=	0140		/SKIP IF FLOATING POINT AC GREATER THAN ZERO.
	FSLE=	0150		/SKIP IF FLOATING POINT AC LESS THAN OR EQUAL ZERO.
	FJMP=	1000		/FLOATING POINT JUMP.
	FJMPI=	1400		/FLOATING POINT JUMP INDIRECT.
	FST=	2000		/STORE FLOATING ACCUMULATOR.
	FSTI=	2400		/STORE FLOATING ACCUMULATOR INDIRECT.
	FLD=	3000		/LOAD FLOATING POINT ACCUMULATOR.
	FLDI=	3400		/LOAD FLOATING POINT ACCUMULATOR INDIRECT.
	FAD=	4000		/ADD TO FLOAT POINT ACCUMULATOR.
	FADI=	4400		/ADD TO FLOATING POINT ACCUMULATOR INDIRECT.
	FSB=	5000		/SUBTRACT FROM FLOATING POINT ACCUMULATOR.
	FSBI=	5400		/SUBTRACT FROM FLOATING POINT ACCUMULATOR INDIRECT.
	FMP=	6000		/FLOATING POINT MULTIPLY ACCUMULATOR.
	FMPI=	6400		/FLOATING POINT MULTIPLY ACCUMULATOR INDIRECT.
	FDV=	7000		/FLOATING POINT DIVIDE ACCUMULATOR.
	FDVI=	7400		/FLOATING POINT DIVIDE ACCUMULATOR INDIRECT.
	FWD=	0200		/FLOATING POINT RELATIVE ADDRESSING FORWARD.
	BKWD=	0600		/FLOATING POINT RELATIVE ADDRESSING BACKWARDS.

/	LAB-8/E INPUT/OUTPUT PERIPHERAL DEFINITIONS.

	ADCL=	6530		/A-D CLEAR ALL.
	ADLM=	6531		/LOAD MULTIPLEXOR FROM AC, CLEAR AC.
	ADST=	6532		/START A-D CONVERSION, CLEAR A-D DONE FLAG.
	ADRB=	6533		/READ A-D BUFFER.
	ADSK=	6534		/SKIP ON A-D DONE.
	ADSE=	6535		/SKIP ON A-D TIMING ERROR.
	ADLE=	6536		/LOAD A-D ENABLE REGISTER, CLEAR AC.
	ADRS=	6537		/READ A-D ENABLE, STATUS AND MULTIPLEXOR.
	DILC=	6050		/DISPLAY LOGIC CLEAR.
	DICD=	6051		/DISPLAY CLEAR DONE FLAG.
	DISD=	6052		/DISPLAY SKIP ON DONE FLAG.
	DILX=	6053		/DISPLAY LOAD X.
	DILY=	6054		/DISPLAY LOAD Y.
	DIXY=	6055		/DISPLAY INTENSIFY X, Y POINT.
	DILE=	6056		/DISPLAY LOAD ENABLE STATUS REGISTER, CLEAR AC.
	DIRE=	6057		/DISPLAY READ ENABLE REGISTER INTO AC.
	CLEN=	6134		/LOAD CLOCK ENABLE REGISTER INTO AC.
	CLAB=	6133		/LOAD AC INTO CLOCK BUFFER AND CLOCK COUNTER.
	CLOE=	6132		/AC ONES SET CLOCK ENABLE REGISTER BITS.
	CLZE=	6130		/AC ONES CLEAR CLOCK ENABLE REGISTER BITS.
	CLSK=	6131		/SKIP ON CLOCK DONE FLAG SET OR EVENT.
	CLCA=	6137		/CLOCK COUNTER TO BUFFER REGISTER AND AC.
	CLSA=	6135		/CLOCK STATUS .OR. INTO AC, AC ONES CLEAR EVENTS.
	CLBA=	6136		/CLOCK BUFFER REGISTER TO AC.
	CLCA=	6137		/CLOCK COUNTER TO CLOCK BUFFER REGISTER TO AC.
