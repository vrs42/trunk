LOCTEMP,.-.
PFINDIT,FINDIT

NEXTERR,JMS I	PERROR/[ERR0R]		/CALL ERROR PRINTER
	TEXT	"NEXT"

RETURN,	GET+MUSTBE;	2000		/MUST BE <CR> OR "\"
	TAD	GSBPTR
	TAD	MGOLIST
	SNA CLA
	JMP	RETNERR
	NL7777
	TAD	GSBPTR
	DCA	GSBPTR
	TAD I	GSBPTR
	DCA	LOCCTR
	JMP I	PEXECUTE

RETNERR,JMS I	PERROR/[ERR0R]		/CALL ERROR PRINTER
