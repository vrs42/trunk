	JMS I	PGETADDR
NEXTVAR,ZBLOCK	3
	FENTER
	FLDI	ADDRESS
	FAD+FWD+FORSTEP-.
	FST+BKWD+.-VARTEMP
	FSB+FWD+FORLIM-.
	FEXIT
	TAD	ACS
	TAD	FORSTEP
	SMA CLA
	TAD	AC1
	SZA CLA
	JMP	FORDONE
