	OUTCON=	0033		/CONSOLE OUTPUT ROUTINE
	SBLOCK=	7635		/LOAD BLOCK IN SYSTEM LOADER
	SBOOT=	7600		/SYSTEM BOOTSTRAP ADDRESS
	SCRSIZE=7611		/SYSTEM CORE SIZE WORD
	SFILES=	7757		/FILE PARAMETERS START HERE
	SFUN=	7634		/SYSTEM LOADER FUNCTION WORD
	SOUTFLS=7607		/OUTPUT FILE COUNT
