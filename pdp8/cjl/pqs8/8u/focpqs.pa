	*ENDT			/END OF TEXT POINTER

	NBUFBEG			/POINT TO NEW BEGINNING OF BUFFER

	*167			/AT END OF PAGE ZERO

P8K,	ZBLOCK	5		/USED BY 8K OVERLAY

