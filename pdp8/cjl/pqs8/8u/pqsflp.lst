  94                       FLPSIZE=10000                   /LOGICAL UNIT SIZE
  95                       NL0001= CLA IAC                 /LOAD AC WITH 0001
  96                       NL0002= CLA CLL CML RTL         /LOAD AC WITH 0002
  97                       NL4000= CLA CLL CML RAR         /LOAD AC WITH 4000
  98                       SBOFF=  SLUPAGE-SBOOT           /OFFSET VALUE
  99                       SYSNUM= 0010                    /SYSTEM ID NUMBER **** MUST BE UNIQUE ****
