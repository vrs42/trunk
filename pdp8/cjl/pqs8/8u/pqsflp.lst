 339               /      MDC8 FLOPPY DISK SYSTEM HANDLER.
 340               
 341                       FIELD   0               /WHERE IT GENERATES
 342               
 343                       *GENAD1                 /WHERE SYSGEN WANTS IT
 344               
 345                       RELOC   SBOOT           /WHERE IT EXECUTES
 346               
 347 007600* 3000  SBOOT,  DCA     SBOOT&177       /SAVE PASSED UNIT VALUE; WILL BE JMP SBOOT2
 348 007601* 6202  SCIF,   CIF     00              /CONSTANT 6202
 349 007602* 6706  SBTFUN, DSRS                    /GET STATUS; WILL BE 17^100+BOOTSTRAP UNIT
 350 007603* 7510          SPA                     /SKIP IF NOT BUSY
 351 007604* 5002  SWAL,   JMP     .-2&177         /SWITCHES /A-/L; ELSE WAIT FOR IT
 352 007605* 7440  SWMX,   SZA                     /SWITCHES /M-/X; SKIP IF NO ERROR
 353 007606* 7402  SWY9,   HLT                     /SWITCHES /Y-/9; ELSE BARF
 354 007607* 5157  SOUTFLS,JMP     SFILES&177      /OUTPUT FILE COUNT; GO MOVE THE CODE DOWN
 355 007610* 0000  SDATE,  .-.                     /SYSTEM DATE WORD
 356 007611* 0000  SCRSIZE,.-.                     /SOFTWARE CORE SIZE
 357               
 358 007612* 0000  SWAIT,  .-.                     /DISK WAIT ROUTINE
 359 007613* 6701          DSSF                    /FLAG UP?
 360 007614* 5213          JMP     .-1             /NO, WAIT FOR IT
 361 007615* 6702          DSCF                    /YES, CLEAR IT
 362 007616* 6706          DSRS                    /GET STATUS NOW
 363 007617* 7104          CLL RAL                 /REMOVE BUSY BIT
 364 007620* 7450          SNA                     /SKIP IF ANY ERRORS
 365 007621* 5612          JMP I   SWAIT           /ELSE RETURN
 366 007622* 7402  SERR,   HLT                     /HALT WITH BAD BITS IN AC
 367 007623* 5316          JMP     SRETRY          /TRY, TRY AGAIN
