/SHORT P?S/8 RX8B BOOTSTRAP

/SHORTER BOOTSTRAP FOR P?S/8

/	LAST EDIT:	08-SEP-1977	21:56:59	CJL

/THIS IS FOR THE DEC-BOOTSTRAP COMPATIBLE VERSION
 
	XLIST	1
	IFNDEF	OFF	<OFF=	1>
	XLIST	OFF
	ON=	0
	NL0002=	CLA STL RTL
	XDR=	6752
	STR=	6753
	SDN=	6755
	LCD=	6751
	BUTLOC=	0002
	COLBUT=	0050
	XLIST	ON
	*107			/WHERE TO START TOGGLING

	LOAD=	.-1		/DON'T MANUALLY LOAD HEADER

	STR			/TRANSFER UP?
	JMP	HANG		/NO, TRY DONE FLAG
	XDR			/YES, TRANSFER A WORD
	JMP I	LOAD		/RETURN

/START MANUAL BOOTSTRAP HERE
BOOT,	SDN			/WAIT FOR
	JMP	.-1		/DONE TO COME UP
	TAD	L6		/GET "READ SECTOR" COMMAND
	LCD			/LOAD IT
	CLA IAC			/SETUP FOR
L6,	JMS	LOAD		/SECTOR ONE
	JMS	LOAD		/ASK FOR TRACK ONE
	NL0002			/USE NEXT COMMAND AS FLAG
HANG,	SDN			/DONE UP?
	JMP	LOAD+1		/NO, TRY TRANSFER
	SNA			/DID WE READ IT IN YET?
	JMP	COLBUT		/YES, GO START IT UP
	LCD			/NO, LOAD "EMPTY SECTOR" COMMAND
TRNLUP,	JMS	LOAD		/GET A WORD
	DCA	BUTLOC		/PUT A WORD
	ISZ	.-1		/BUMP TO NEXT
	JMP	TRNLUP		/GO DO ANOTHER

	$			/THAT'S ALL FOLK!
