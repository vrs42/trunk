  15                       NL0001= CLA IAC         /LOAD AC WITH 0001
  16                       NL0002= CLA CLL CML RTL /LOAD AC WITH 0002
  17                       NL2000= CLA CLL CML RTR /LOAD AC WITH 2000
  18                       NL4000= CLA CLL CML RAR /LOAD AC WITH 4000
  19                       NL7775= CLA CLL CMA RTL /LOAD AC WITH 7775
  20                       NL7776= CLA CLL CMA RAL /LOAD AC WITH 7776
  21                       NL7777= CLA CMA         /LOAD AC WITH 7777
  22                       OUTCON= 0033            /EQUATED FROM CONSOLE!
  23                       SBOOT=  7600            /SYSTEM BOOTSTRAP
  24                       SBTFUN= 7602            /SYSTEM BOOTSTRAP FUNCTION
  25                       SCRSIZE=7611            /SOFTWARE CORE SIZE
  26                       SFILES= 7757            /FILES PASSES HERE
  27                       SOUTFLS=7607            /OUTPUT FILE COUNT PASSED HERE
  28                       SPARM=  7756            /EQUALS PARAMETER PASSED HERE
