	AND	L3/[3]		/JUST USEFUL UNIT BITS
	CLL RTL;RTL		/*20
	TAD	L6/[6]		/ADD ON READ BITS
	LCD			/LOAD THE COMMAND
	NL0001			/+1
	STR			/FLAG UP?
	JMP	.-1		/NO, WAIT FOR IT
	XDR			/ASK FOR SECTOR ONE
	NL0000			/0
	STR			/FLAG UP?
