	SMA CLA				/SKIP IF INPUT CATALOG IS LOADED
	JMS	ICLODE			/GO LOAD THE INPUT CATALOG
	NL0001				/INDICATE THE
	DCA	ICSW			/INPUT CATALOG IS ACTIVE
	TAD	[CATADR-1]		/SETUP THE
	DCA	XR1			/BUFFER POINTER
	TAD I	(CATADR+377)		/GET FIRST BLOCK
	DCA	ICBLK			/SETUP FILE BLOCK
ICLOOP,	TAD	XR1			/GET THE POINTER
	TAD	(-CATADR-176+1)		/COMPARE TO DANGEROUS VALUE
