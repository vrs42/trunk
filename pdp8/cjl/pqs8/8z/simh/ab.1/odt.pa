ECKS,	TAD	LSNACLA		/OR SNA CLA
	DCA	WINST		/STORE IN TEST INSTRUCTION
	JMS I	[CRLF]		/START ON A NEW LINE
	TAD	HOME		/GET THE LOWER LIMIT
	DCA	CHECK1		/SAVE AS STARTING ADDRESS
	TAD	FFIELD		/GET SEARCH FIELD
	AND	[70]		/JUST FIELD BITS
	DCA	CHECK		/SAVE AS SEARCHING FIELD
	TAD	NUMB1		/GET SEARCH ARGUMENT
	DCA	WORD		/SAVE IT
