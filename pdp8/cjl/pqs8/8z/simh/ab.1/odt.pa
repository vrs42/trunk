	JMS I	[P6CH]		/PRINT IT
	ISZ	TEMP		/DONE 4 YET?
	JMP	PLOOP		/NO, GO BACK
	TAD	[" &77]		/YES, GET A <BLANK>
	JMS I	[P6CH]		/PRINT IT ALSO
