	SKP			/SKIP IF NOT
	JMP I	SETCONT		/RETURN IF NOT
	TAD	TRPADR		/GET THE TRAPPED FIELD
	DCA	CURADR		/MAKE INTO CURRENT
	TAD	TRPAD1		/GET THE TRAPPED ADDRESS
	DCA	CURAD1		/MAKE INTO CURRENT
	JMS I	[EFFADR]	/CALCULATE EFFECTIVE ADDRESS
	TAD	CURADR		/GET NEW FIELD
	DCA	SIMADR		/SETUP SIMULATOR FIELD
	TAD	CURAD1		/GET NEW ADDRESS
	DCA	SIMAD1		/SETUP SIMULATOR ADDRESS
	JMP I	SETCONT		/RETURN
