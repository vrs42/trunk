MOVCDF,	.-.			/GOTO OUTPUT FIELD
	DCA I	XR2		/PUT A WORD
MVCDF,	CDF	00		/BACK TO FIELD 0
	ISZ	GETBRK		/DONE ALL YET?
	JMP	MOVLUP		/NO, GO BACK
	JMP I	MOVE		/YES, RETURN

