	SECT	STRCOM
	JA	#ST
#XR,	ORG	.+10
	TEXT	+STRCOM+
#RET,	SETX	#XR
	SETB	#BASE
	JA	.+3
#BASE,	ORG	.+6
A,	ORG	.+3
B,	ORG	.+3
	ORG	#BASE+30
	FNOP
	JA	#RET
	FNOP
#GOBAK,	0;0
#VAL,	ORG	.+6
#ARGS,	ORG	.+3
#TMP,	ORG	.+0011
#LIT,	0000
	0000
	0000
	0001
	2000
	0000
	0002
	3000
	0000
	0003
	3000
	0000
	#LBL=.
	ORG	#LBL
#RTN,	BASE	#BASE
	FLDA	#VAL
	JA	#GOBAK
#ST,	STARTD
	0210
	FSTA	#GOBAK,0
	0200
	SETX	#XR
	SETB	#BASE
	LDX	0,1
	FSTA	#BASE
	FSTA	#ARGS
	FLDA%	#BASE,1+
	FSTA	A
	FLDA%	#BASE,1+
	FSTA	B
	STARTF
	LDX	0002,0
	LDX	0003,0
	LDX	0004,0
	FLDA%	A
	FSTA	X
	LDX	0005,0
	FLDA%	B
	FSTA	Y
	LDX	0006,0
	FLDA	#LIT+0000
	FSTA	Z
	LDX	0007,0
	TRAP3	#A0

	SECT8	#STRCM
#A0,	TAD	M3
	DCA	CNT		/CHECK 3 WORDS
	TAD	ADX+1
	DCA	XX		/SET UP WORD POINTERS
	TAD	ADY+1
	DCA	YY
LOOP,	TAD%	XX
	AND	P7700		/TEST 1ST CHAR OF NEXT WORD
	TAD	M4000
	SZA			/A SPACE WILL BECOME A NULL
	TAD	P4000
	CMA	IAC
	SNA			/NULL IS SPECIAL
	JMP	#A3
	DCA	TEMP
	TAD%	YY
	AND	P7700
	TAD	M4000
	SZA
	TAD	P4000
	CLL
	TAD	TEMP
	SNA			/ARE CHARS =?
	JMP	#A1		/YES
	SZL	CLA		/NOT EQUAL,LINK=1 FOR X<Y
	JMP	#L
	JMP	#G
#A3,	TAD%	YY		/SPECIAL CASE WHERE 1ST CHAR WAS A NULL
	AND	P7700
	TAD	M4000
	SZA
	TAD	P4000
	SZA	CLA		/EQUAL IF 2ND IS NULL TOO,ELSE X<Y
	JMP	#L
#A1,	TAD%	XX
	AND	P77
	TAD	M40		/2ND CHAR THE SAME WAY
	SZA
	TAD	P40
	CMA	IAC
	DCA	TEMP
	TAD%	YY
	AND	P77
	TAD	M40
	SZA
	TAD	P40
	TAD	TEMP
	SNA
	JMP	#A2
	SMA	CLA
	JMP	#L
	JMP	#G
#A2,	ISZ	XX		/MOVE POINTERS FOR NEXT WORD
	ISZ	YY
	ISZ	CNT		/DONE YET?
	JMP	LOOP
	JMP	#A6		/NO DIFFERENCES IN WORDS

#L,	CLA CLL CML RAR
	CLL CML RAR
	JMP	.+3
#G,	CLA CLL CML RAR
	CLL RAR
	DCA	Z+1		/MAKE 2ND WORD
	IAC
	DCA	Z		/AND 1ST FOR +/-1
#A6,	CDF	CIF	0
	JMP%	.+2
	EXTERN	#RETRN
	ADDR	#RETRN

P7700,	7700
M4000,
P4000,	4000
P77,	77
M40,	-40
P40,	40
M3,	-3
CNT,	0
ADX,	ADDR	X
XX,	0
ADY,	ADDR	Y
YY,	0
TEMP,	0
X,	0;0;0
Y,	0;0;0
Z,	0;0;0

	SECT	STRCOM
	LDX	0010,0
	FLDA	Z
	FSTA	#VAL
	LDX	0010,0
	JA	#RTN
