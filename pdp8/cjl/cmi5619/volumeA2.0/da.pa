/	OUTPUT SCALE NUMBERS ROUTINE.

OSCALE,	.-.					/OUTPUT SCALE NUMBERS ROUTINE
/	SZA					/BETTER BE SINGLE-PRECISION
/	HLT					/ELSE BARF
	DVI;	[62]				/DIVIDE BY 50
	CLA MUY;[62]				/MULTIPLY BY 50
	CLA MQA					/GET PRODUCT
	DCA	TEMP				/SAVE IT FOR LATER
