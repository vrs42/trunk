	JMS I	[TPRINT]			/DRAW MESSAGES
	917					/X-COORDINATE
	528					/Y-COORDINATE
	GMAGMSG					/MESSAGE ADDRESS
	858					/X-COORDINATE
	288					/Y-COORDINATE
	VJMSG					/MESSAGE ADDRESS
	872					/X-COORDINATE
	762					/Y-COORDINATE
	GOFMSG					/MESSAGE ADDRESS
