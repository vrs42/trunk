	TAD	(670)				/ADJUST TO RIGHT-SCALE POSITION
	DCA	X				/STORE BACK
	TAD	TEMP				/GET VALUE
	TAD	(144)				/ADJUST TO RIGHT-SCALE VALUE
	JMS	OUT4				/OUTPUT IT
	ISZ	OSCALE				/BUMP PAST ARGUMENT
	JMP I	OSCALE				/RETURN
/	PARAMETER DRAWING ROUTINE.

PDRAW,	.-.					/PARAMETER DRAW ROUTINE
/	SZA					/BETTER BE SINGLE-PRECISION
/	HLT					/ELSE BARF
	DVI;	[62]				/DIVIDE BY 50
	MQL MUY;[12]				/GET REMAINDER*10
	SZA					/BETTER BE SINGLE-PRECISION PRODUCT
	HLT					/ELSE BARF
	MQA					/GET THE PRODUCT
	DCA	X				/USE AS LEFT-HAND COORDINATE
	TAD I	PDRAW				/GET Y-COORDINATE
