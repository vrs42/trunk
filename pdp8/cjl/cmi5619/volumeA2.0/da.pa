/	CONVERT POINTER VALUE TO MS ROUTINE.

NCONVER,.-.					/NUMERIC CONVERT AND ROUND ROUTINE
/	SZA					/BETTER BE SINGLE-PRECISION
/	HLT					/ELSE BARF
	SHL;	1				/*2
	DVI;	(5)				/%5
	TAD	[-2]				/SHOULD WE ROUND UP?
	SMA SZA CLA				/SKIP IF NO
