	JMS I	[STROUT]			/OUTPUT STRINGS
	LEVCOM					/USE COMPLEMENT MODE
	VECMODE					/GOTO VECTOR MODE
	ADRBUFFER				/ADDRESS
	ANOMOVE					/ALPHA MODE
	SCHARS					/STANDARD SIZE CHARACTERS
