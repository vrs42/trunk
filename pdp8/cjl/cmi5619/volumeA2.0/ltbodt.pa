NO6,	IAC			/?6=NO ARGUMENT TO "G" OR "R" ****
NO5,	IAC			/?5=DUPLICATE BREAKPOINT ATTEMPTED ****
NO4,	IAC			/?4=BAD ARGUMENTS TO "\"
NO3,	IAC			/?3=BREAKPOINT LOOKUP FAILURE IN "#" ****
NO2,	IAC			/?2=NO ARGUMENT TO "#" ****
NO1,	IAC			/?1=ILLEGAL ADDRESS OR VALUE
NO0,	JMP I	(NOCOM)		/?0=TOO MANY DIGITS

