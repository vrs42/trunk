	RTR;RAR			/MOVE OVER AND
	AND	L70/(70)	/ISOLATE MCS BITS
	TAD	(CIF	10)	/TURN INTO "CIF MCS+10"
	DCA	P7TSF		/STORE OVER "TSFIOT"
	TAD	P7JMP		/GET "JMP I P7OUT"
	DCA	P7TLS		/STORE OVER "TLSIOT"
	TAD	(JMS	OUTCON)	/GET OUTPUT CALL
	DCA	P7JMP		/STORE OVER "JMP I P7OUT"
	TAD	P7TSF		/GET "CIF MCS+10"
	DCA	CHKKSF		/STORE OVER "KSFIOT"
	TAD	CHKJMP		/GET "JMP I CTLCTST"
	DCA	CHKKRS		/STORE OVER "KRSIOT" (OR "KRBIOT"
	TAD	(JMS	INCON)	/GET INPUT CALL
	DCA	CHKJMP		/STORE OVER "JMP I CTLCTST"
	DCA	CHKKCC		/DESTROY "KCCIOT"
	DCA I	(VMCLR)		/DESTROY "KCCIOT"
STARTIT,TAD I	(SBTFUN)	/GET BOOTSTRAP FUNCTION
	RAR;CML RAL		/INVERT LOW-ORDER BIT
	AND	[7]		/JUST UNIT BITS
	DCA	CHKUNT		/SAVE AS CURRENT WORD SEARCH UNIT
	TAD	CHKUNT		/GET IT BACK
	DCA	CURUNT		/SAVE AS CURRENT UNIT
