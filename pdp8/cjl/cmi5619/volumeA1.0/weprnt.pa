/	WE PRINT FOR V9000

	*200			/AS USUAL

START,	CAF			/CLEAN UP
	6666			/INITIALIZE LPT:
LOOP,	6401			/FROM V9000?
	JMP	LOOP		/NO, TRY SOMEONE ELSE
	6406			/YES, GET THE CHARACTER
	DCA	TEMP		/SAVE FOR NOW
	6661			/LPT: AVAILABLE?
	JMP	WAIT		/NO
	TAD	TEMP		/YES, GET THE CHARACTER
	6666			/OUTPUT IT
	CLA			/CLEAN UP
	JMP	LOOP		/CONTINUE THERE

WAIT,	TAD	("S&37)		/GET <^S>
	JMS	SEND		/SEND IT
	6661			/WAIT FOR
	JMP	.-1		/LPT:
	TAD	TEMP		/GET THE CHARACTER
	6666			/OUTPUT IT
	CLA			/CLEAN UP
	TAD	("Q&37)		/GET <^Q>
	JMS	SEND		/SEND IT
	JMP	LOOP		/KEEP GOING

SEND,	.-.			/SEND ROUTINE
	6416			/SEND THE CHARACTER
	6411			/WAIT FOR
	JMP	.-1		/COMPLETION
	CLA			/CLEAN UP
	JMP I	SEND		/RETURN

TEMP,	.-.			/TEMPORARY
