REINIT,	JMS I	(GADATE)	/GET BACKUP DATE
	JMS I	(GATIME)	/GET BACKUP TIME
RMORE,	JMS I	(BMPSEQ)	/BUMP TO NEXT SEQUENCE NUMBER
AGNMNT,	JMS I	(MNTMSG)	/GIVE MOUNT MESSAGE AND GET REPLY
	JMS I	(LRECINPUT)	/READ IN LATEST LABEL RECORD
	JMS I	(VALDATE)	/TRY TO VALIDATE LABEL
