	-"E!200			/BACKUP ENTIRE DISK
	-"E!200			/RESTORE ENTIRE DISK
	-"A!200			/VARY PARAMETERS
	-"X!200			/EXIT
FINLST,	BSMSG			/BACKUP SYSTEM AREA
	BSYS			/A(BACKUP SYSTEM AREA)
	RSMSG			/RESTORE SYSTEM AREA
	RESYS			/A(RESTORE SYSTEM AREA)
	BLMSG			/BACKUP LIBRARY AREA
	BLIB			/A(BACKUP LIBRARY AREA
	RLMSG			/RESTORE LIBRARY AREA
	RELIB			/A(RESTORE LIBRARY AREA)
	BDMSG			/BACKUP DAILY ACTIVITY AREA
	BDAILY			/A(BACKUP DAILY ACTIVITY AREA
