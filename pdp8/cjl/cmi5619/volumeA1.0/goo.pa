	-"1!200			/RESTORE DEVICE IS WINCHESTER DISK DRIVE ONE
	-"O!200			/RESTORE IS VERIFY-ONLY
	-"O!200			/BACKUP/RESTORE IS WRITE-ONLY
	-"V!200			/BACKUP/RESTORE IS WRITE WITH VERIFY
	-"E!200			/RETURN TO MAIN MENU
	-"X!200			/EXIT
