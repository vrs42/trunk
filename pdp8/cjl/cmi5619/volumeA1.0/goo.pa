FRST,	-"B!200			/BACKUP SYSTEM AREA
	-"R+"B			/RESTORE SYSTEM AREA
	-"B+"R			/BACKUP LIBRARY AREA
	-"R+"B			/RESTORE LIBRARY AREA
	-"B+"R			/BACKUP DAILY ACTIVITY AREA
	-"R+"B			/RESTORE DAILY ACTIVITY AREA
