	VPMSG			/VARY PARAMETERS
	VARPAR			/A(VARY PARAMETERS)
	EXMSG			/EXIT
	PUTBAK/SBOOT		/A(EXIT)
/	PARAMETER LISTS FOR SECOND SCREEN.

VFRST,	-"F!200			/BACKUP DEVICE IS FLEXIBLE DISK DRIVE ZERO
	-"F+"F			/BACKUP DEVICE IS FLEXIBLE DISK DRIVE ONE
	-"W+"F			/RESTORE DEVICE IS WINCHESTER DISK DRIVE ZERO
	-"W+"W			/RESTORE DEVICE IS WINCHESTER DISK DRIVE ONE
	-"V+"W			/RESTORE IS VERIFY-ONLY
	-"W+"V			/BACKUP/RESTORE IS WRITE-ONLY
