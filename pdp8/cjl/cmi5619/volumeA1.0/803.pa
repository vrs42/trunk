/MAINDEC 803:		PDP-8 MEMORY ADDRESS TEST

	*1

BGIN,	CLA CLL			/INITIALIZE
	TAD	C+1		/CLEVER DODGE TO INITIALIZE ADDRESS
	DCA	ADRS
A,	ISZ	ADRS
	SZL CLA			/WRITING THIS PASS?
	JMP	B		/NO. GO READ
	TAD	ADRS		/YES.
	DCA I	ADRS
B,	TAD I	ADRS		/READ & COMPARE
	CIA
	TAD	ADRS		/C(ADRS)-C(C(ADRS))
	SNA CLA			/IS RESULT=0?
	JMP	C		/YES. GO ON

SIGH,	TAD I	ADRS		/NO
E1,	HLT			/ERROR: AC SHOWS INCORRECT WORD
	CLA STL
	TAD	ADRS
E1A,	HLT			/AC SHOWS CORRECT ADDRESS.

C,	CLA CMA CML		/IMPLEMENTATION OF
	AND	ADRS		/THE CLEVER DODGE
	TAD	CTAB		/END OF PASS TEST.
	SZA CLA			/IS IT?
	JMP	A		/NO, NEXT WORD
	CML			/YES, NEXT PASS
	JMP	BGIN+1

CTAB,	23
ADRS,	.-.

	$
