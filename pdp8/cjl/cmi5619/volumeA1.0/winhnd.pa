/	WAI0:		4	0		     0		0000000-0007777

/	WAJ0:		4	1		32,768		0100000-0107777

/	WAK0:		5	0		     0		0000000-0007777

/	WAL0:		5	1		32,768		0100000-0107777

/	WAM0:		6	0		     0		0000000-0007777

