/	OUTPUT AN X PATTERN ON VC-8/E

	DILX=	6053		/LOAD X ON VC-8/E
	DILY=	6054		/LOAD Y ON VC-8/E
	DISD=	6052		/SKIP ON DISPLAY DONE
	DIXY=	6055		/INTENSIFY ON VC-8/E

	*200			/THE USUAL

	CAF			/CLEAN UP
LOOP,	TAD	VAL		/GET THE VALUE
	DCA	X		/MAKE IT X
	TAD	VAL		/GET IT AGAIN
	DCA	Y		/MAKE IT Y
	JMS	DISPLAY		/DISPLAY IT
	TAD	Y		/GET Y BACK
	CIA			/INVERT IT
	DCA	Y		/STORE BACK
	JMS	DISPLAY		/DISPLAY IT
	ISZ	VAL		/BUMP TO NEXT
	ISZ	CNT		/DONE ENOUGH?
	JMP	LOOP		/NO, GO BACK
	TAD	(-2000)		/RESET THE
	DCA	CNT		/COUNTER
	DCA	VAL		/RESET THE DATA
	JMP	LOOP		/GO DO IT AGAIN

DISPLAY,.-.			/DISPLAY ROUTINE
	TAD	X		/GET X VALUE
	DILX			/LOAD X ON VC-8/E
	CLA			/CLEAN UP
	TAD	Y		/GET Y VALUE
	DILY			/LOAD Y ON VC-8/E
	CLA			/CLEAN UP
	DISD			/WAIT FOR DONE
	JMP	.-1		/ON VC-8/E
	DIXY			/INTENSIFY POINT NOW
	JMP I	DISPLAY		/RETURN

CNT,	-1			/COUNTER
VAL,	.-.			/VALUE
X,	.-.			/X
Y,	.-.			/Y

	$			/THAT'S ALL FOLK!
