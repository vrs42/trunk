 100 C	P?S/8 FOCAL HDS-3200-30 DEMO PROGRAM
 110 C	DISPLAYS SINE(X)/X FROM -20 TO +20.
 120 C	LAST EDIT:	03-JUN-1988	23:00:00	CJL
 130 1.10	ERASE
 140 1.20	S MX=-2000;S GX=2000;S MY=-2000;S GY=2000
 150 1.25	S XR=GX-MX;S YR=GY-MY
 160 1.30	S D=FDIS();S MA=-1E40;S MI=-MA
 170 1.35	S LO=-20;S UP=20;S PO=4000
 180 1.50	S IN=(UP-LO)/PO;S MI=-0.216275;S MA=1
 190 1.60	S YS=MA-MI;S J=-1;F X=LO,IN,UP;D 4
 200 1.70	D 2
 210 1.80	QUIT
 220 2.10	S AX=(FABS(MI)/YS)*4000-2000;F I=-2000,2000;S D=FDIS(I,AX)
 230 2.20	F I=-2000,100,2000;F J=-30,30;S D=FDIS(I,J+AX)
 240 2.30	S D=FDIS(-1800,1800,"^P^LOT OF ^SINE(X)/X",3,1)
 250 3.10	S RE=FSIN(X)/X
 260 C	DISPLAY ROUTINE
 270 4.10	S J=J+1;D 3
 280 4.20	S D=FDIS(((J/PO)*XR)+MX,(((RE-MI)/YS)*YR)+MY)
