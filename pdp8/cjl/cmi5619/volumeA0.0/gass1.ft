C	TEST PROGRAM THAT MIGHT WORK BETTER ON REAL FPP.
C SENTINEL ADDED BECAUSE THIS VERSION OF FORTRAN IV
C DOES NOT SUPPORT "END=".
C
	REAL HOURS,RATE,GROSS,NET,SENVAL
	SENVAL=99.99
   10	READ (5,100) HOURS,RATE
  100	FORMAT (F5.2,F5.2)
	IF (HOURS .GT. SENVAL) GOTO 99
	WRITE (4,200) HOURS,RATE
  200	FORMAT (" ","HOURS=",F5.2," RATE=",F5.2)
	GROSS=HOURS*RATE
	NET=GROSS-25.00
	WRITE (4,300) GROSS,NET
  300	FORMAT (" ","GROSS=",F8.2," NET=",F8.2)
	GOTO 10
   99	STOP
	END
