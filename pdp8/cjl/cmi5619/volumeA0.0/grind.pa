SIGN,	.-.			/ARITHMETIC SIGN FLAG
VLATEST,.-.			/LATEST VALUE
VMULT,	.-.			/MULTIPLIER TEMPORARY
VSUM,	.-.			/SUM
XYFLAG,	.-.			/X/Y FLAG

