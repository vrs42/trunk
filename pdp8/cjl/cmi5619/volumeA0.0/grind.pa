	IFNZRO	PARM2&4000	<
	XLIST	ON
	TT=	-PARM2			/USE POSITIVE FORM
	T=	TT&M^12+PARM2F%D	/FIRST PARTIAL
	T=	TT%D^12+T		/FINAL VALUE
	-T				/USE NEGATIVE FORM
	XLIST	OFF		>
	XLIST	ON

/	BEGINNING CORRECTION FOR MOVEMENT.

	XLIST	OFF
