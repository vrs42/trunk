	DST;	HSTPTR		/SAVE IT FOR LATER
	CAM			/CLEAN UP
	TAD	CHTEMP		/GET PASSED VALUE
	DCA	HISTSW		/SAVE IT FOR LATER
	JMP I	CHKHST		/RETURN

