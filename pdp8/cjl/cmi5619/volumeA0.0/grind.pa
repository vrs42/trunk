	XLIST	ON
	TT=	-PARM3			/USE POSITIVE FORM
	T=	TT&M^12+PARM3F%D	/FIRST PARTIAL
	T=	TT%D^12+T		/FINAL VALUE
	-T				/USE NEGATIVE FORM
	XLIST	OFF		>
	XLIST	ON

/	ENDING CORRECTION FOR MOVEMENT.

	XLIST	OFF
	IFZERO	PARM4&4000	<
