	DAD;	M1776		/BACKUP
	DST;	HSTPTR		/STORE IT BACK
HSTLUP,	LOAD;	HSTPTR		/GET TIME WORD
	ASR;	13		/0 IF NOT A SPIKE, 7777 IF A SPIKE
	CDF	HSTFLD		/GOTO BUFFER FIELD
	DCA I	XR2		/STASH A HISTOGRAM ELEMENT
	CDF	00		/BACK TO FIELD 0
	DLD;	HSTPTR		/GET THE CURRENT POINTER
	DAD;	L4		/UPDATE
	DST;	HSTPTR		/STORE IT BACK
	ISZ	SPKCNT		/DONE YET?
	JMP	HSTLUP		/NO, GO BACK
	JMS I	[SYSIO]		/YES, CALL I/O ROUTINES
	0000			/BUFFER IS 0000
	4+HSTFLD+WRITE		/ON UNIT 4
HSTBLK,	0000			/LATEST BLOCK
	NL0004			/GET UPDATE FACTOR
	TAD	HSTBLK		/BUMP
	DCA	HSTBLK		/FOR NEXT TIME
	JMP I	DOHIST		/RETURN

