	XLIST	OFF
	IFNZRO	BLKTST	<
	XLIST	ON

BLNKTST,TAD	CURVAL		/GET LATEST VALUE
	AND	[BLINK]		/JUST BLINK BIT
	SNA CLA			/SKIP IF A BLINK
	JMP	CHKBEGIN	/JUMP IF NOT A BLINK
