	TAD	XTEMP		/GET PREVIOUS POSITION
	DCA	XPOS2		/SAVE AS SECOND "X" POSITION
	NL0002			/GET OUR VALUE
	JMS	CHKHST		/CHECK FOR HISTOGRAM OUTPUT
