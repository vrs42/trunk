	XLIST	OFF
	IFNZRO	FILE	<
	XLIST	ON
	TAD I	(SOUTFLS)	/GET NUMBER OF OUTPUT FILES
	SNA			/SKIP IF ANY
	JMP	FILXIT		/BARF IF NONE
	TAD	FLBLK		/UPDATE INPUT POINTER
	DCA	FLBLK		/SAVE IT BACK
	DCA I	FLBLK		/DESTROY INPUT FILES
	TAD I	FILPTR		/GET FIRST FILE
	DCA	FLBLK		/PUT INTO CALL
	JMS I	(PQINIT)	/INITIALIZE FILE
FLBLK,	SFILES			/INITIAL FILE POINTER
	1			/LINE NUMBER 1
	1			/INCREMENT IS 1
	XLIST	OFF	>
	XLIST	ON
	JMP I	[NEXT]		/GO START IT UP

