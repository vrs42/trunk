	TAD	(-210+242)	/COMPARE TO 210
	SNA			/SKIP IF DIFFERENT
	JMP I	(GOT210)	/JUMP IF A MATCH
	TAD	(-220+210)	/COMPARE TO 220
	SNA			/SKIP IF DIFFERENT
	JMP I	(GOT220)	/JUMP IF A MATCH
	TAD	(220)		/RESTORE THE CHARACTER
