	AND	CATCORE/[7000]		/JUST PCS BITS
	TAD I	(SCRSIZE&177+CONSUL)	/ADD ON NEW MCS, LCS, J BITS
	DCA I	PSCRSIZE/[SCRSIZE]	/STORE IN MEMORY FOR THOSE WHO NEED IT
	JMP I	ONOCOMMON		/RETURN
