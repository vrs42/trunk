CALCHK,	.-.				/CHECKSUM CALCULATION ROUTINE
	TAD I	(SBLOCK)		/GET OUR LOADING BLOCK
	TAD	(BINBUFFER-CONSUL%200)	/ADD ON OFFSET TO OVERLAY IMAGE
	DCA	OURBLK			/STORE IN-LINE
