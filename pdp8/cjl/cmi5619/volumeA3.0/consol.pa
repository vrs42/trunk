	JMS I	(FLSETUP)		/SETUP FILE ARGUMENTS
/	NL0000				/INDICATE LOADING
	JMS I	(FILOAD)		/LOAD THE FILE
	JMP	LODLUP			/KEEP GOING

LODEND,	TAD I	(MLODZAP)		/GET VIRTUAL INDICATOR
	SZA CLA				/SKIP IF MEMORY LOAD
	JMP	VIRDONE			/JUMP IF VIRTUAL LOAD
	JMS I	(PROMESSAGE)		/TELL THEM
	MMODMSG				/MEMORY WAS UPDATED
	JMP	NOFILES			/KEEP GOING

VIRDONE,JMS I	(DUMP)			/WRITE LAST BUFFER
	JMS I	(CALCHK)		/CALCULATE CHECKSUM
	TAD	XR2			/GET THE CHECKSUM
	CIA				/INVERT IT
	TAD I	(OVRWRD+BINBUFFER)	/ADD ON OVERLAY TYPE WORD
	TAD I	(FUDWRD+BINBUFFER)	/ADD ON CURRENT FUDGE WORD
