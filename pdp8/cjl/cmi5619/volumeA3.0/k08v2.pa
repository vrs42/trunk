/	ERROR DISPATCH TABEL FOR 'GET' AND 'RECEIVE' COMMANDS	   /a010

TBLDSP, IER05+1;FPERR	   /FATAL PACKAGE RECEIVED ERROR
	IER23+1;SYNERR    /FILENAME SYNTAX ERROR
	IER24+1;DEVERR    /DEVICE NAME ERROR
	IER22+1;ERRDSK    /DISK FULL ERROR (NO ROOM)
	IER31+1;DIOERR    /DIRECTORY IO ERROR,ERROR CLOSING FILE
	0       /TERMINATE TABEL

/	ERROR HANDLING FOR INPUT

INPS60, NOP     /DUMMY RETURN FOR ERROR DISPATCH /m010
	FPACK/~FORMAT A PACKET
	NODATA/~NO DATA
	STBRK      /"NAK" PACKET TYPE    /m010
	SPACK/~SEND THE PACKET
	0/~NO RESPONSE
	TAD     (TBLDSP-2/~ GET THE TABLE ADDRESS -2
	DCA     X10/~SAVE IN INDEX REGISTER
INERLP, ISZ     X10/~ INCREMENT INDEX
	TAD I   X10/~ GET THE TABLE ENTRY
	SNA/~ SKIP IF NOT END
	JMP     NOTFND/~ NOT FOUND
	CIA/~ NEGATE
	TAD     INPS60/~ GET THE ENTRY ADDRESS
