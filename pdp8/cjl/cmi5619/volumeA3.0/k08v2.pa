	JMP     INERLP/~ TRY NEXT
	TAD I   X10/~ GET TABLE ENTRY
	SKP

NOTFND, TAD     (RECERR/~GET ERROR MESSAGE
	JMP     INPEXT/~TAKE THE ERROR RETURN

/	DISPATCH TABLES FOR "INPSRV"

INPS90, STDAT;  INPS10/~HANDLE DATA PACKETS
	STEOF;  INPS30/~HANDLE EOF PACKET
