LNFRETU,JMS I	(ZAPONE)		/CALL SINGLE ZAP ROUTINE
	CHTBL+23			/CHANGE <LF> ENTRY
	GOTCR				/TO <CR> ENTRY

LNFVIEW,JMS I	(ZAPONE)		/CALL SINGLE ZAP ROUTINE
	CHTBL+23			/CHANGE <LF> ENTRY
