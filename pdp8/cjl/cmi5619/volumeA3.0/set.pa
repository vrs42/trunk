	(CLA)			/TO THIS
	-1			/SECOND COUNT
	NOEPUNIT		/CHANGE THIS
	(CLA)			/TO THIS
	-1			/THIRD COUNT
	PROMPT			/CHANGE THIS
	PROMPT			/TO THIS
	-1			/FOURTH COUNT
	PRMPCNT			/CHANGE THIS
	(NL0001)		/TO THIS
	0			/THIS ENDS THE LIST
