	GOTESC				/TO TOPS10, ETC. <ESC> ROUTINE ADDRESS

/	SET FLNAME CONTROLLER.

FLNENTR,TAD	MESSAGE			/GET "NO" INDICATOR
	SMA CLA				/SKIP IF "NO"
	TAD	L40/[SZA-NOP-400]	/ELSE MAKE IT SZA CLA
	TAD	L7600/[CLA!400]		/GET "CLA" PART EITHER WAY
	DCA	.+3			/STORE IN-LINE
	JMS I	(PASONE)		/CALL PASS WORD PROTECTED ZAP ROUTINE
	TRYOLD+3			/CHANGE THIS
	.-.				/TO PASSED VALUE

/	SET LNFEED CONTROLLERS.

LNFECHO,JMS I	(ZAPONE)		/CALL SINGLE ZAP ROUTINE
	CHTBL+23			/CHANGE <LF> ENTRY
	LNFEED				/TO ECHO AN <LF> CHARACTER

LNFIGNO,JMS I	(ZAPONE)		/CALL SINGLE ZAP ROUTINE
	CHTBL+23			/CHANGE <LF> ENTRY
