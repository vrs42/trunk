	TEXT	"ECHO";0;ECHLST;ECHSET	/SET ECHO LIST
	TEXT	"ESCAPE";ESCLST;ESCSET	/SET ESCAPE LIST
	TEXT	"FLNAME";FLNLST;FLNSET	/SET FLNAME LIST
	TEXT	"LNFEED";LNFLST;LNFSET	/SET LNFEED LIST
	TEXT	"NULL";0;NULLST;NULSET	/SET NULL LIST
	TEXT	"PASS";0;PASLST;PASSET	/SET PASS LIST
	TEXT	"PROMPT";PROLST;PROSET	/SET PROMPT LIST
	TEXT	"RADIX"; RADLST;RADSET	/SET RADIX LIST
	TEXT	"RUBOUT";RUBLST;RUBSET	/SET RUBOUT LIST
	TEXT	"SYSTEM";SYSLST;SYSSET	/SET SYSTEM LIST
	TEXT	"TAB";0; TABLST;TABSET	/SET TAB LIST
	TEXT	"^U";0;0;CTULST;CTUSET	/SET ^U LIST
	TEXT	"^Z";0;0;CTZLST;CTZSET	/SET ^Z LIST
	0				/THIS ENDS THE LIST

/	PASS WORD.

PASSWD,	TEXT	"MARIO"			/PASS WORD STORED HERE
	TEXT	"CJL";0			/AUTHOR'S RESERVED PASS WORD
	0				/THIS ENDS THE LIST
