        07311    5765
4452    07312    5345		JMP	INCHW9		; finally join with the DELETE code
4453                 	
4454                 	; Here to check for line terminators...
4455    07313    1364	INCHW6:	TAD	[CHBSP-CHCRT]	; is this a return ??
4456    07314    7450		SNA			; ???
