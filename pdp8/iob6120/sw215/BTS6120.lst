Disk Formatter, Pass 2                                                                  BTS6120.PLX


3042                 	; Here if one (or more) words don't match..
3043    03057    6201	FMTP29:	CDF	0		; restore the usual field
3044    03060    6205		.PUSHJ	@ZCRLF		; we're in the middle of a line now
        03061    5461
3045    03062    4462		JMS	@ZINLMES	; so start a new one and print 
3046    03063    4156		 ERRDSK			;  "?Verification error, block/page "
3047    03064    6211		CDF	1		; (disk data is in field 1)
3048    03065    1512		TAD	@ZDKRBN		; get the current block/page number
3049    03066    6201		CDF	0		; ...
3050    03067    6205		.PUSHJ	@ZTOCT4C	; and type it (in octal) 
        03070    5457
3051    03071    5240		JMP	FMTP23		; better luck with the next block

