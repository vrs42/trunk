  (0230)<br>
  FBOOT.SV=A0=A0=A0=A0 2=A0=A0 28-MAR-92=A0 (0246)<br>
  FOTP.SV=A0=A0=A0=A0=A0 8=A0=A0=A0 (none)=A0=A0=A0
