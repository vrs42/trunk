9586                 		.TITLE	X / XP Commands -- Disassemble memory
9587                 	
9588                 	
9589                 	; CMDX / CMDXP: the disassembler commands.  They share an implementation,
9590                 	; since the only difference between them is whether main or panel memory is
9591                 	; read.
9592                 	
9593    20600    7200	CMDX:	CLA
9594    20601    1377		TAD	[CPD]		; access main memory
9595    20602    5205		JMP	XCOMM
9596                 	
9597    20603    7200	CMDXP:	CLA
9598    20604    1376		TAD	[SPD]		; access panel memory
9599    20605    3006	XCOMM:	DCA	DPNL
9600                 	
