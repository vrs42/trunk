5982    07533    6225		.POPJ			; return with the AC cleared
5983                 	
5984                 	; Here to check for a control-S character...
5985    07534    1363	INCHR2:	TAD	[CHCTO-CHXOF]	; is this a control-S ??
5986    07535    7440		SZA			; ???
5987    07536    5342		 JMP	 INCHR3		; nope, try again
5988    07537    7240		STA			; yes -- get a -1 into the AC
5989    07540    3054		DCA	XOFF		; and set the XOFF flag
5990    07541    6225		.POPJ			; return with the AC cleared
5991                 	
5992                 	; Here to check for a control-Q character...
5993    07542    1362	INCHR3:	TAD	[CHXOF-CHXON]	; is this a control-Q ??
5994    07543    7440		SZA			; ???
