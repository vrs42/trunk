9645    20653    7640		SZA CLA	
9646    20654    5262		 JMP INCR		; no -- continue
9647    20655    1771		TAD	@[HIGH]		; yes -- compare the addresses
9648    20656    7041		CIA			;
9649    20657    1774		TAD	@[ADDR]		; ...

