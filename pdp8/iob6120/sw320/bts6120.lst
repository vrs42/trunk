6207    07733    1000		TAD	UPC		; then the PC too
6208    07734    6205		.PUSHJ	@ZTOCT4C	; type that and a CRLF
        07735    5502
6209    07736    6205		.PUSHJ	@[REGLSC]	; type the registers on the next line
