9539    20456    7450		SNA			; is the checksum 0000?
9540    20457    5262		 JMP	 STARTXROM	; yes, continue the process
9541                 	
9542    20460    7326		NL0002
9543    20461    5275		JMP	 XROMERR	; no, return error code 0002
9544                 	
9545                 	; the extension ROM is present, copied into field 3 and its checksum is valid.
9546                 	; Let's call it!
9547                 	
9548             0007	NUMXRARGS=7			; number of parameters following
9549                 	
9550    20462        	STARTXROM:
9551    20462    1362		TAD	[NUMXRARGS]
9552    20463    6221		CDF	2
9553    20464    6232		CIF	3
9554    20465    4410		JMS	@SCAN
