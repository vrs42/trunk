9558    20470    4777		F0PATCH-1		; page that we can use in f0 if needed
9559    20471    2520		F1VECTOR		; table of pointers in field 1
9560    20472    2777		F1PATCH-1		; page that we can use in f1 if needed
9561    20473    0503		F2VECTOR		; table of pointers in field 1
9562    20474    2577		F2PATCH-1		; page that we can use in f1 if needed
9563                 	
9564                 	; and it returns here with AC=0 for no error, otherwise a code from 0003 up
