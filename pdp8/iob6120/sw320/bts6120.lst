9359                 		.TITLE	Persistent setting support (NVRAM)
9360                 	
9361                 	
9362             7700	RDPMLOC = 4032.		; 21*128*1.5 = first free byte in ramdisk 0 DAR 0
9363                 	; note: maximum storage is (4096.-4032.-2)/2 words = 31.
9364             0136	RDPMS1  = 0136		; signature 1 (byte)
9365             0266	RDPMS2  = 0266		; signature 2 (byte)
9366                 	
9367    20201    7200	RDPSS:	CLA
9368    20202    6214		RDF
9369    20203    1377		TAD	[CXF 0]
9370    20204    3240		DCA	RDPSX
9371                 	
9372    20205    1376		TAD	[FIRSTPSS-1]	; set up an auto index register
9373    20206    3013		DCA	AX1		;  ... to address the persistent vars
9374                 	
9375    20207    6201		CDF	0
9376    20210    1775		TAD	@[RAMBAS]
9377    20211    1374		TAD	[RDPMLOC]	; 21*128*1.5 = first free byte in ramdisk field
9378    20212    3014		DCA	AX2		; auto-incr to address NVRAM
9379                 	
9380    20213    6410		LDAR			; set DAR to 0
9381                 	
9382    20214    6403		MM3			; address the ramdisk memory
9383                 		;CDF	0		; 1st NVRAM
9384    20215    1414		TAD	@AX2		; are the two signature bytes there?
9385    20216    1373		TAD	[-RDPMS1]
9386    20217    7640		SZA CLA
9387    20220    5240		 JMP	 RDPSX		 ; no - exit
9388    20221    1414		TAD	@AX2
9389    20222    1372		TAD	[-RDPMS2]
9390    20223    7640		SZA CLA
9391    20224    5240		 JMP	 RDPSX		 ; no - exit
9392                 	
9393    20225    1414		TAD	@AX2		; get the number of words
9394    20226    7041		CIA			; make neg. counter for ISZ
9395    20227    3001		DCA	MEA
9396                 	
9397    20230    6403	RDPS0:	MM3
9398                 		;CDF	0		; source field
9399    20231    1414		TAD	@AX2		; get the next byte
9400    20232    7002		BSW			; take it as the upper 6 bits
9401    20233    1414		TAD	@AX2		; add in the lower 6 bits
9402    20234    6402		MM2
9403                 		;CDF	0		; destination field
9404    20235    3413		DCA	@AX1		; and store it
9405    20236    2001		ISZ	MEA
9406    20237    5230		 JMP	RDPS0		 ; next
9407                 	
9408    20240    0000	RDPSX:	0
9409    20241    6402		MM2
9410    20242    6225		.POPJ
9411                 	
9412    20243    6214	WRPSS:	RDF
9413    20244    1377		TAD	[CXF 0]
9414    20245    3303		DCA	WRPSX
9415                 	
9416    20246    6201		CDF	0
9417    20247    1775		TAD	@[RAMBAS]	; starting just after 1st RAM disk page
9418    20250    1374		TAD	[RDPMLOC]	; 21*128*1.5 = first free byte in ramdisk field
9419    20251    3014		DCA	AX2		; auto-incr to address NVRAM
9420                 	
9421    20252    1376		TAD	[FIRSTPSS-1]	; set up an auto index register
9422    20253    3013		DCA	AX1		;  ... to address the persistent vars
9423                 	

PALX - IM6100/HM6120 Assembly Language V3.32 RLA                      10-MAY-18  23:00:32   Page 235
Persistent setting support (NVRAM)                                                      bts6120.plx


9424    20254    6410		LDAR			; set DAR to 0
9425                 	
9426    20255    6403		MM3			; address the ramdisk memory
9427                 		;CDF	0
9428                 	
9429    20256    1371		TAD	[RDPMS1]	; store the signature
9430    20257    3414		DCA	@AX2
9431    20260    1370		TAD	[RDPMS2]
9432    20261    3414		DCA	@AX2
