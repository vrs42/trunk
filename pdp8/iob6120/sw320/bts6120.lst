5031    06246    3010	TASCIZ:	DCA	X1		; save the pointer to the string
5032    06247    1410	TASCI1:	TAD	@X1		; and get the first character
5033    06250    7450		SNA			; is this the end of the string ??
5034    06251    6225		 .POPJ			; yes -- quit now
5035    06252    6205		.PUSHJ	@ZOUTCHR	; no -- type this character
        06253    5476

