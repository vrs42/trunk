9628    20633    1006		TAD	DPNL
9629    20634    3236		DCA	DAP
9630    20635    0000	DAF:	0
9631    20636    0000	DAP:	0
9632    20637    1403		TAD	@XPC		; get the code word at the current address
9633    20640    3004		DCA	XIR
9634    20641    6201		CDF	0
9635    20642    6276		SPD
9636                 	
