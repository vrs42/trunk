4108    04136    6205		.PUSHJ	DBCHKS
        04137    5355
4109                 	; (4) make sure they're equal
4110    04140    7041		CIA
4111    04141    1050		TAD	CHKSUM
4112    04142    7450		SNA
4113    04143    6225		 .POPJ			; alles ganz gut
4114                 	; (5) if they weren't equal, report that
