8803                 		.TITLE	Disassemble Current Trace Location
8804                 	
8805                 	
8806                 	; XTYPIR: prints a disassembly of the current trace location
8807                 	
8808    20712    1767	XTYPIR:	TAD	@[UIRPC]	; get the current user environment
8809    20713    3003		DCA	XPC		; into our local copies
8810    20714    1766		TAD	@[UFLAGS]	; [RLA] UFLAGS is in field zero!
8811    20715    3005		DCA	IFDF
8812    20716    1765		TAD	@[UIR]
8813    20717    3004		DCA	XIR
