5164    07072    1367		TAD	[CHBEL]		; Get a bell character
5165    07073    5766		JMP	@[TFCHAR]	; Then type it out
5166                 	
5167                 	; Type a slash (used as an address separator) on the terminal.
5168    07074    7200	TSLASH:	CLA			; ...
5169    07075    1365		TAD	["/"]		; ...
5170    07076    5771		JMP	@[THCHAR]	; ...
5171                 	
5172                 	; Type a dot (used for decimal numbers and disk addresses) on the terminal.
5173    07077    7200	TDOT:	CLA			; ...
5174    07100    1364		TAD	["."]		; ...
