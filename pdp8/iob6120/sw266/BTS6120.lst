6883    11253    7360		CLA CLL CML CMA		; no disk - return LINK = 1 and AC = -1
6884    11254    6225		.POPJ			; and quit now
6885                 	
6886    11255    6205	DWR1:	.PUSHJ	@[WREADY]	; wait for the drive to become ready
        11256    5772
6887    11257    7430		SZL			; did we encounter an error ?
6888    11260    6225		 .POPJ			; yes - just give up now
6889    11261    6205		.PUSHJ	SETLBA		; set up the disk address registers
        11262    5310
6890    11263    1365		TAD	[CMDWRS]	; write sector with retry command

PALX - IM6100/HM6120 Assembly Language V3.32 RLA                      13-JAN-24  18:41:12   Page 169
Read and Write IDE Sectors                                                              BTS6120.PLX


6891    11264    4770		JMS	@[IDEWRR]	; write that to the command register
6892    11265    0107		 REGCMD			; ...
6893    11266    6205		.PUSHJ	@[WDRQ]		; wait for the drive to request data
        11267    5767
6894    11270    7430		SZL			; did the drive detect an error instead?
6895    11271    6225		 .POPJ			; yes - just give up
6896    11272    1053		TAD	BUFSIZ		; nope - transfer the data
