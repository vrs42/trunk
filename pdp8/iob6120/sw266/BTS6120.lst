        01362    5502
2081    01363    6205		.PUSHJ	@ZRDMEM		; read what we actually get from memory
        01364    5522
2082    01365    6205		.PUSHJ	@ZTOCT4M	; then type that with a CRLF
        01366    5501
2083                 	
2084                 	; Temporary storage for DANDV...
2085    01367        	GOOD:	.BLOCK	1		; the "good" value we wrote to memory
        01371    6400
        01372    6201
        01373    0712
        01374    6200
        01375    1500
        01376    6277
        01377    5751
2086    01400        		.PAGE

