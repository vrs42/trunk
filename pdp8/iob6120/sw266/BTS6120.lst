1997    01270    1004	TYPSP1:	TAD	USP1		; ...
1998    01271    4243		JMS	TYPRG4		; ...
1999    01272    3733		 SP1NAM			; "SP1>"
2000                 	
2001                 	; This routine will type the 6120 stack pointer #2...
