3938    04103    2200		 PNLBUF			; setup the panel memory disk buffer
3939    04104    1041		TAD	CPYDST		; change DKPART to the destination partition
3940    04105    6211		CDF	1		; ...
3941    04106    3773		DCA	@[DKPART]	; ...
3942    04107    6201		CDF	0		; ...
3943    04110    1135		TAD	ZM256		; load the record size for DISKWR
3944    04111    4527		JMS	@ZPUSHJ1	; (cross field call)
3945    04112    1244		 DISKWR			; and go write a block to the disk
3946    04113    7430		SZL			; any disk errors?
3947    04114    5772		 JMP	 @[DIOERR]	; yes - give up
