5551    07537    7240		STA			; yes -- get a -1 into the AC
5552    07540    3052		DCA	XOFF		; and set the XOFF flag
5553    07541    6225		.POPJ			; return with the AC cleared
5554                 	
5555                 	; Here to check for a control-Q character...
