3656    03553    4527		JMS	@ZPUSHJ1	; (call a field 1 routine)
3657    03554        	WRPTR:	 .BLOCK	1		; gets modified to DISKWR, RAMDWR or ROMWR
3658    03555    7430		SZL			; were there any I/O errors?
3659    03556    5304		 JMP	 DIOERR		; yes - go report that and quit
