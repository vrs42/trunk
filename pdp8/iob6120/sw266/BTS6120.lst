9032                 	; Opcode group tables.  For each group (upper digit), this
9033                 	; table has a mnemonic table pointer and a pointer to a function
9034                 	; that prints the parameters (e.g. effective address for AND)
9035                 	
9036                 	OPJMP:	.DATA	OP0-1, EADGRP, OP1-1, EADGRP
        21400    1417
        21401    1071
        21402    1423
