5354    07324    6205		.PUSHJ	@ZOUTCHR	; and echo that to the terminal
        07325    5474
5355    07326    6205	INCHW7:	.PUSHJ	@ZCRLF		; then close the input line
        07327    5506
5356    07330    3413		DCA	@L		; end the command with a null byte
5357    07331    1377		TAD	[CMDBUF-1]	; and then backup the pointer
5358    07332    3013		DCA	L		;   to the start of the command
5359    07333    7240		STA			; return with the AC non-zero
