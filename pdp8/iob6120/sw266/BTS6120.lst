2539    02125    1410	BPTRM1:	TAD	@X1		; get the address of this breakpoint
2540    02126    7450		SNA			; is there one there at all ??
2541    02127    5337		 JMP	 BPTRM2		; no -- on to the next one
2542    02130    3035		DCA	ADDR		; yes -- remember the address
2543    02131    1411		TAD	@X2		; then get the correct field too
2544    02132    3036		DCA	ADRFLD		; ...
2545    02133    1412		TAD	@X3		; finally get the original contents
2546    02134    6205		.PUSHJ	@ZDANDV		; deposit and verify it back where it goes
        02135    5523
2547    02136    5341		JMP	BPTRM3		; on to the next one
2548                 	
2549                 	; Here to advance to the next breakpoint...
2550    02137    2011	BPTRM2:	ISZ	X2		; keep the pointers in sync
2551    02140    2012		ISZ	X3		; ...
2552    02141    2067	BPTRM3:	ISZ	COUNT		; have we done them all ??
2553    02142    5325		 JMP	 BPTRM1		; no -- keep looping
2554    02143    6225		.POPJ			; yes -- that's it for this time

