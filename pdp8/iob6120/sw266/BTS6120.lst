2399    01756    6225		.POPJ			; and stop right now
2400                 	
2401                 	; Here if the current address dosen't match...
2402    01757    2011	BPTFN2:	ISZ	X2		; increment the field pointer too
2403    01760    2067	BPTFN3:	ISZ	COUNT		; have we searched the entire table?
2404    01761    5341		 JMP	 BPTFN1		; no -- keep looking
2405    01762    7100		CLL			; yes -- clear the LINK
2406    01763    6225		.POPJ			; and return
