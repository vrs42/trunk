4088    04266    3772		DCA	@[0]
4089                 	
4090    04267    4507		JMS	@ZINLMES	; prompt to make sure we want to do this...
4091    04270    4352		 FLMSG2
4092    04271    6205		.PUSHJ	@[CONFRM]	; go wait for a "Y" or "y"
