6821    11203    3776		DCA	@[BUFCDF+1]	; ...
6822    11204    3052		DCA	BUFPNL		; of main memory
6823    11205    6201		CDF	0		; PARMAP lives in field 0
6824    11206    1775		TAD	@[PARMAP]	; get partition number of unit 0
6825    11207    6211		CDF	1
6826    11210    3020		DCA	DKPART		; ...
