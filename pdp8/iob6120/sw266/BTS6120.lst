1989    01264    5773		JMP	@[XTYPIR]
1990                 	
1991                 	; This routine will type the current interrupt flags...
1992    01265    1002	TYPEPS:	TAD	UFLAGS		; get the flags
1993    01266    4243		JMS	TYPRG4		; ...
