3112    02650    5242		 JMP	PMALL+1		; nope - keep going
3113    02651    6225		.POPJ			; yes, we can quit now
3114                 	
3115                 	; Here to show the mapping for the unit in COUNT...
3116    02652    4507	PMSHOW:	JMS	@ZINLMES	; say
3117    02653    4065		 PM1MSG			;  "Unit "
3118    02654    1067		TAD	COUNT		; get the selected unit
3119    02655    6205		.PUSHJ	@[TDIGIT]	; and type it
        02656    5774
