4802                 	
4803                 	; This routine will read a 15 bit address into registers HIGH and HGHFLD.
4804    06423    6205	RDHIGH:	.PUSHJ	RDADDR		; read a 15 bit address
        06424    5216
4805    06425    1035		TAD	ADDR		; get the low order bits
4806    06426    3040		DCA	HIGH		; into HIGH
4807    06427    1036		TAD	ADRFLD		; get the field
