1953    01212    0376		AND	[6277]		; only these bits can actually change
1954    01213    7421		MQL			; save the new value for a minute
1955    01214    1002		TAD	UFLAGS		; get the current status
1956    01215    0375		AND	[1500]		; clear the complementary bits
1957    01216    7501		MQA			; or everything together
1958    01217    3002		DCA	UFLAGS		; and update the PS
