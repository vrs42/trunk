3133    02650    5242		 JMP	PMALL+1		; nope - keep going
3134    02651    6225		.POPJ			; yes, we can quit now
3135                 	
3136                 	; Here to show the mapping for the unit in COUNT...
3137    02652    4507	PMSHOW:	JMS	@ZINLMES	; say
3138    02653    4065		 PM1MSG			;  "Unit "
