4692                 	; byte of the AC.  The AC will be cleared on return.
4693    06274    0376	TSIXC:	AND	[77]		; Trim the character to just 6 bits
4694    06275    1375		TAD	[" "]		; No -- convert the character to ASCII
4695    06276    5774		JMP	@[THCHAR]	; And type it out

