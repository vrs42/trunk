6919    11264    4770		JMS	@[IDEWRR]	; write that to the command register
6920    11265    0107		 REGCMD			; ...
6921    11266    6205		.PUSHJ	@[WDRQ]		; wait for the drive to request data
        11267    5767
6922    11270    7430		SZL			; did the drive detect an error instead?
6923    11271    6225		 .POPJ			; yes - just give up
