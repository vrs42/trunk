        07271    5474
5351    07272    6205		.PUSHJ	@ZCRLF		; then start on a new line
        07273    5506
5352    07274    5201		JMP	INCHWL+1	; and go start all over again
5353                 	
5354                 	; Here to handle a BACKSPACE character...
