5190    07073    5766		JMP	@[TFCHAR]	; Then type it out
5191                 	
5192                 	; Type a slash (used as an address separator) on the terminal.
5193    07074    7200	TSLASH:	CLA			; ...
5194    07075    1365		TAD	["/"]		; ...
5195    07076    5771		JMP	@[THCHAR]	; ...
5196                 	
5197                 	; Type a dot (used for decimal numbers and disk addresses) on the terminal.
5198    07077    7200	TDOT:	CLA			; ...
5199    07100    1364		TAD	["."]		; ...
