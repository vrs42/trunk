7778                 		.TITLE	Get Arguments for MEMMOV Calls
7779                 	
7780                 	
7781                 	; MVXARG:
7782                 	;	call: JMS MVXARG
7783                 	;  entry: AC points to CDF x, yPD, MMz sequence location
7784                 	;  function: get and interpret an addressing control argument, filling out @XX1
7785                 	;  exit: AC contains DAR value
7786    12400    0000	MVXARG:	0
7787    12401    3012		DCA	XX1	; Save pointer to modified code in auto-incr
7788    12402    6205		.PUSHJ	@[GETARG]	; get the source field
        12403    5777
7789    12404    7100		CLL			; make sure the link is in a known state
7790    12405    1376		TAD	[4000]		; put the ramdisk/RAM flag in the LINK
7791    12406    7420		SNL
7792    12407    5226		JMP	ADRPMM		; if b0=0, do panel/main memory addressing
7793                 	; address is in ramdisk
7794                 	
