5555    07513    1366		TAD	[CHCTC]		; get another control-C character
5556    07514    6205		.PUSHJ	@ZOUTCHR	; echo it to the terminal
        07515    5474
5557    07516    5524		JMP	@ZRESTA		; and go restart the monitor
5558                 	
5559                 	; Here to check for a control-O character...
5560    07517    1365	INCHR1:	TAD	[CHCTC-CHCTO]	; compare to a control-O character
5561    07520    7440		SZA			; is this it ??
5562    07521    5334		 JMP	 INCHR2		; no -- keep checking
5563    07522    3052		DCA	XOFF		; control-O always clears the XOFF flag
5564    07523    1364		TAD	[CHCTO]		; get another control-O character
