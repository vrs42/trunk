9118                 		.TITLE	Disassembler Tables (MRIs)
9119                 	
9120                 	; Opcode group tables.  For each group (upper digit), this
9121                 	; table has a mnemonic table pointer and a pointer to a function
9122                 	; that prints the parameters (e.g. effective address for AND)
9123                 	
9124                 	OPJMP:	.DATA	OP0-1, EADGRP, OP1-1, EADGRP
        21400    1417
        21401    1071
        21402    1423
        21403    1071
9125                 		.DATA	OP2-1, EADGRP, OP3-1, EADGRP
        21404    1427
        21405    1071
        21406    1433
        21407    1071
