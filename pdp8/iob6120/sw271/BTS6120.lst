6945    11300    4770		JMS	@[IDEWRR]	; by writing it to the command register
6946    11301    0107		 REGCMD			; ...
6947    11302    5772		JMP	@[WREADY]	; wait for the drive to become ready
6948                 	
6949                 	
6950                 	;   This routine will send a spin down command.  Drives are not required by
