6849    11203    3776		DCA	@[BUFCDF+1]	; ...
6850    11204    3052		DCA	BUFPNL		; of main memory
6851    11205    6201		CDF	0		; PARMAP lives in field 0
6852    11206    1775		TAD	@[PARMAP]	; get partition number of unit 0
6853    11207    6211		CDF	1
6854    11210    3020		DCA	DKPART		; ...
6855    11211    3021		DCA	DKRBN		; block zero
6856    11212    1374		TAD	[-128.]		; we only need the first 1/2 of the block
6857    11213    5773		JMP	@[DISKRD]	; ...
6858                 	

