4796                 	
4797                 	; This routine will read a 15 bit address into registers ADDR and ADRFLD.
4798    06416    6205	RDADDR:	.PUSHJ	@[OCTNF]	; read the 15 bit address
        06417    5774
4799    06420    1065		TAD	WORD		; get the low order bits
