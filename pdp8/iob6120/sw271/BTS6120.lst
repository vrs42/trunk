5795    07733    1000		TAD	UPC		; then the PC too
5796    07734    6205		.PUSHJ	@ZTOCT4C	; type that and a CRLF
        07735    5500
5797    07736    6205		.PUSHJ	@[REGLSC]	; type the registers on the next line
