5341    07257    6205		.PUSHJ	@[TASCIZ]	; and echo the entire line back
        07260    5771
5342    07261    6205		.PUSHJ	@ZBACKUP	; backup L over the null we put there
        07262    5512
5343    07263    5210		JMP	INCHW1		; finally continue typing
5344                 	
5345                 	; Here to handle a Control-U character...
