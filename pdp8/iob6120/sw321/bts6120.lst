9995    21147    1363	EA7:	TAD	[DS1MSG-1]	; print the indirect (or double-indirect)
9996    21150    6205		.PUSHJ	TASZF2		; value, in format "\t[xxxx]"
        21151    5136
9997    21152    1002		TAD	MIA
