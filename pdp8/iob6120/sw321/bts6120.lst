4355    04342    0040		ADRFLD		; V  start field returned from RANGE
4356    04343    0042		HIGH		; V  end address returned from RANGE
4357    04344    0044		HGHFLD		; V  end field returned from RANGE
4358    04345    7645		BTSTR1-1	; H  CPREQ signaled
