7798                 	
7799                 	
7800                 	;   This routine will initialize the disk partition map so that unit 0
7801                 	; maps to partition 0, unit 1 maps to partition 1, etc...  This is the
7802                 	; default partition mapping used after a power on and remains in effect
7803                 	; until changed by an OS/8 program with the "Set Partition Mapping" PR0
7804                 	; subfunction.
7805                 	
7806    11713    7200	INIPMP:	CLA			; just in case...
7807    11714    1364		TAD	[-8.]		; we are going to init 8 units
7808    11715    3020		DCA	DKPART
7809    11716    1373		TAD	[PARMAP-1]	; set up an auto index register
7810    11717    3012		DCA	XX1		;  ... to address the partition map
7811    11720    6402		MM2
7812    11721    7215	INIPM1:	NL0010
7813    11722    1020		TAD	DKPART		; get the current partition/unit
7814    11723    6201		CDF	0
7815    11724    3412		DCA	@XX1		; and set the next entry in the map
7816    11725    6211		CDF	1
7817    11726    2020		ISZ	DKPART
7818    11727    5321		 JMP	 INIPM1		; ...
7819    11730    7300		CLA CLL
7820    11731    6225		.POPJ
