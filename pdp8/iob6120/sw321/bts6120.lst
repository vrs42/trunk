PALX - IM6100/HM6120 Assembly Language V3.32 RLA                      07-MAR-11  14:04:47   Page 155
Fetch PR0 Arguments
                                                                     bts6120.plx


6411                 		.TITLE	Fetch PR0 Arguments
6412                 	
6413                 	
6414                 	;   This routine fetches an argument for PR0 from the main memory program.
6415                 	; Since arguments are always stored in line after the PR0, the next argument
6416                 	; is in the instruction field and pointed to by the last main memory PC.
6417                 	; After the argument is fetched the main memory PC is always incremented so
6418                 	; that we'll skip over the argument when we return - you have to be careful
6419                 	; about this, since it means this routine can only be called ONCE to fetch
6420                 	; any given argument!  The PR0 argument is returned in the AC.
6421    10241    7200	GETARG:	CLA
6422    10242    6201		CDF	0		; BEWARE - UFLAGS and UPC are both in field 0!
6423    10243    1771		TAD	@[UPC]		; get the user's PC from field 0
6424    10244    3051		DCA	ARGPTR		; save it in field 1 for a moment
6425    10245    2771		ISZ	@[UPC]		; and increment it to skip over the argument
6426    10246    7000		 NOP			;  this really shouldn't ever happen!
6427    10247    1774		TAD	@[UFLAGS]	; get the last known user (main memory) flags
6428    10250    0370		AND	[70]		; then get the IF at the time of the trap
6429    10251    1367		TAD	[CDF 0]		; make a CDF instruction
6430    10252    3253		DCA	.+1		; change to the correct field
6431    10253    7000		 NOP			; ... gets overwritten with a CDF ...
6432    10254    6266		CPD			; always fetch from main memory
6433    10255    1451		TAD	@ARGPTR		; get the next word from user program space
6434    10256    6276		SPD			; back to panel memory
6435    10257    6211		CDF	1		; and back to our field
6436    10260    6225		.POPJ			; return the PR0 argument in the AC

