Read and Write Memory
                                                                   bts6120.plx


        01347    5316
2178    01350    7041		CIA			; make what we read negative
2179    01351    1367		TAD	GOOD		; and compare it to the desired value
2180    01352    7650		SNA CLA			; did they match ??
2181    01353    6225		 .POPJ			; yes -- this memory is ok
2182                 	
2183                 	; Type a "?MEM ERR AT faaaa ..." message
2184    01354    4511		JMS	@ZINLMES	; type out the first part of the message
2185    01355    3415		 MEMMSG			; ...
2186    01356    6205		.PUSHJ	@[TADDR]	; then type the address of the error
        01357    5771
2187    01360    1367		TAD	GOOD		; get the expected value
2188    01361    6205		.PUSHJ	@ZTOCT4S	; type that out first
        01362    5504
2189    01363    6205		.PUSHJ	@ZRDMEM		; read what we actually get from memory
        01364    5525
2190    01365    6205		.PUSHJ	@ZTOCT4M	; then type that with a CRLF
        01366    5503
