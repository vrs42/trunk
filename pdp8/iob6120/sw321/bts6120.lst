5722    07132    1055		TAD	HPOS		; and decrement HPOS
5723    07133    7510		SPA			; are we going to pass the left margin ??
5724    07134    5341		 JMP	 BACKS1		; yes -- don't type anything
5725    07135    3055		DCA	HPOS		; no -- update HPOS
5726    07136    1360		TAD	[CHBSP]		; then get a backspace character
5727    07137    6205		.PUSHJ	@[TFCHAR]	; and type that out
        07140    5767
5728    07141    7200	BACKS1:	CLA			; clear the AC
5729    07142    6225		.POPJ			; and that's all
