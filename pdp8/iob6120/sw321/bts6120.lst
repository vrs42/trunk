Control Panel Entry Points
                                                              bts6120.plx


        07732    5766
6275    07733    1000		TAD	UPC		; then the PC too
6276    07734    6205		.PUSHJ	@ZTOCT4C	; type that and a CRLF
        07735    5502
6277    07736    6205		.PUSHJ	@[REGLSC]	; type the registers on the next line
        07737    5765
6278    07740    6205		.PUSHJ	@[BPTRMV]	; remove any breakpoints
        07741    5764
6279    07742    6205		.PUSHJ	@[EXMEM]	; sync the ADDRESS and DATA displays
        07743    5763
6280    07744    5527		JMP	@ZRESTA		; and restart the monitor
