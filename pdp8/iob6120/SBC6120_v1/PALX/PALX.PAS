(*
      THIS IS THE 'PSEUDO-OP' TABLE.... IN THIS PARTICULAR ASSEMBLER,
   IT   CONTAINS   ONLY   PSEUDO-OPS. THE TABLE HAS TWO ENTRIES:

	.NAME -- THE 10 CHARACTER NAME OF THE OP...

	.VALUE -- A NUMBER INDICATING THE OPCODE.  THIS NUMBER IS USED IN A
		CASE STATEMENT IN BOTH PASS_ONE AND PASS_TWO...

      THIS  TABLE  IS  DEFINED  BY  AN INITPROCEDURE BECAUSE IT NEVER
   CHANGES...
*)
PROCEDURE POPTAB_INIT;
BEGIN
  POPTAB[ST_END].NAME := 'END       ';	POPTAB[ST_END].VAL := ST_END;
  POPTAB[ST_ORG].NAME := 'ORG       ';	POPTAB[ST_ORG].VAL := ST_ORG;
  POPTAB[ST_DAT].NAME := 'DATA      ';	POPTAB[ST_DAT].VAL := ST_DAT;
  POPTAB[ST_TTL].NAME := 'TITLE     ';	POPTAB[ST_TTL].VAL := ST_TTL;
  POPTAB[ST_ASZ].NAME := 'ASCIZ     ';	POPTAB[ST_ASZ].VAL := ST_ASZ;
  POPTAB[ST_ZER].NAME := 'BLOCK     ';	POPTAB[ST_ZER].VAL := ST_ZER;
  POPTAB[ST_SIX].NAME := 'SIXBIT    ';	POPTAB[ST_SIX].VAL := ST_SIX;
  POPTAB[ST_EJEC].NAME := 'EJECT     ';	POPTAB[ST_EJEC].VAL := ST_EJEC;
  POPTAB[ST_OPD].NAME := 'OPDEF     ';	POPTAB[ST_OPD].VAL := ST_OPD;
END;




(*
      THIS  ROUTINE  INITIALIZES  ALL  IMPURE  DATA AREAS (I.E. THOSE
   WHICH  ARE CHANGED DURING ASSEMBLY)... IT IS CALLED JUST AFTER THE
   ASSEMBLER IS STARTED UP...
*)
PROCEDURE  START_UP;
VAR   K : PINTEGER;
BEGIN

  (* INITIALIZE ALL TYPES AND SETS... *)
  FOR   K := 0  TO  25   DO   ERRCOD[K] := FALSE;
  IDENT_CHARS := ['A'..'Z', '0'..'9', '_', '$', '%'];
  BLANK_ID := '          ';
  FOR  K := 1  TO  SRCLIN_LEN   DO  BLANK_LINE[K] := ' ';

  (* CLEAR OUT THE USER DEFINED SYMBOL TABLE... *)
  FOR   K := 0  TO  SYMTAB_LEN   DO
    BEGIN
      SYMTAB[K].NAME := BLANK_ID;  SYMTAB[K].VAL := 0;
      SYMTAB[K].SF_TAG := FALSE;   SYMTAB[K].SF_EQU := FALSE;
      SYMTAB[K].SF_MDF := FALSE;   SYMTAB[K].SF_UDF := FALSE;
      SYMTAB[K].SF_OPD := FALSE

    END;

  (* CLEAR OUT ALL THE FLAGS... *)
  PASS_1 := FALSE;   PASS_2 := FALSE;
  FL_ERR := FALSE;   FL_PAGE := FALSE;

  (* ZERO ALL GLOBAL COUNTERS... *)
  LINEK := 0;    LINPAK := 1;   ERRORK := 0;
  
  (* SET UP THE NULL CODE RECORD... *)
  NULL_CODE := 0;

  (* INITIALIZE THE OBJECT FILE OUTPUT ROUTINES... *)
  LAST_ADDR := MAXIMUM_NUMBER;

  (* CLEAR OUT THE TITLE STRING *)
  PROGRAM_TITLE := BLANK_LINE;

  (* INITIALIZE INTERNAL SYMBOL TABLES *)
  OPTAB_INIT;  POPTAB_INIT;

END;








