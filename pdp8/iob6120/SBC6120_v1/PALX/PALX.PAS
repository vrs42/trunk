*)








(*
	***** L A B E L S *****

      THIS  PROGRAM  CONTAINS  ONLY ONE LABEL, AND THAT IS LOCATED AT
   THE  VERY  END  OF  THE MAIN PROGRAM. ITS SOLE USE IS TO PROVIDE A
   GLOBAL  ERROR EXIT, SINCE PASCAL PROVIDES NO BETTER WAY TO GET OUT
   OF A PROGRAM....
*)
LABEL
	9999;	(* THIS IS ON THE LAST END OF THE ENTIRE PROGRAM... *)








(*
	***** C O N S T A N T   D E C L A R A T I O N S *****
*)
CONST




(*
      THESE CONSTANTS DETERMINE EASILY CHANGEABLE PARAMETERS, SUCH AS
   THE  MAXIMUM  NUMBER  OF SYMBOLS, THE LENGTH OF SOURCE LINES, ETC.
   THIS  PROGRAM  MAY BE RE-COMPILED WITH ANY OF THESE SYMBOLS SET TO
   ANY REASONABLE VALUE...
*)
SYMTAB_LEN	= 1000;		(* THE MAXIMUM NUMBER OF USER DEFINED SYMBOLS *)
SRCLIN_LEN	= 80;		(* THE MAXIMUM NUMBER OF CHARACTERS IN A SINGLE SOURCE LINE *)
LN_PAGE		= 55;		(* THE NUMBER OF LINES PRINTED ON ONE PAGE OF LISTING *)
IDENT_LEN	= 10;		(* THE NUMBER OF SIGNIFICANT CHARACTERS IN AN IDENTIFIER *)



(*
       THESE   CONSTANTS  DEFINE  SPECIAL  CHARACTERS  IN  THE  SOURCE
    LANGAUGE; (E.G. INDIRECT FLAGS, LITERALS, PESUDO-OPS, ETC)...
*)
CH_COM		= ';';		(* THE COMMENTING CHARACTER *)
CH_IND		= '@';		(* SELECTS INDIRECT ADDRESSING MODE *)
CH_LIT		= '[';		(* MARKS THE START OF A LITERAL *)
CH_LTE		= ']';		(*   "    "  END    " "    "    *)
CH_PMR		= '.';		(*   "    "  START OF A PSEUDO-OP *)
CH_RPC		= '.';		(* RETURNS THE CURRENT INSTRUCTION LOCATION *)
CH_RPO		= '*';		(* THE OLDER VERSION OF ABOVE *)
CH_QTE		= '"';		(* THE MARKER FOR A QUOTED STRING *)
CH_TAB		= CHR(9);	(* ASCII HORIZONTAL TAB CHARACTER *)
CH_FFD		= CHR(12);	(* ASCII FORM FEED CHARACTER *)
CH_NUL		= CHR(0);	(* ASCII NULL CHARACTER *)




(*
       THIS  SYMBOL  DEFINES  THE TITLE STRING WHICH IS PRINTED IN THE
    ASSEMBLY LISTING, AND ON THE USER'S TERMINAL... 
*)
TITLE_STRING	= 'PALX - Intersil IM6100 Assembly Language  V2.3  RLA';




(*
      THE  FOLLOWING  CONSTANTS  ARE REALLY DETERMINED BY THE TYPE OF
   MACHINE  THE  CODE  IS BEING ASSEMLED FOR. CONSTANTS ARE USED HERE
   (INSTEAD  OF  JUST WRITING THE ACTUAL NUMERIC VALUE) FOR THE ADDED
   MNEMONIC FLAVOR... NORMALLY THESE VALUSE WOULD NEVER BE CHANGED...
*)
OPTAB_LEN	= 100;		(* THE NUMBER OF MACHINE OPCODES *)
POPTAB_LEN	= 9;		(* THE NUMBER OF PSEUDO-OPS *)
CODE_LEN	= 4;		(* THE NUMBER OF DIGITS IN THE GENERATED CODE *)
ADDRESS_LEN	= 4;		(* THE NUMBER OF DIGITS IN AN ADDRESS *)
MAXIMUM_NUMBER	= 4095;		(* THE LARGEST LEGAL VALUE FOR AN ADDRESS *)
PAGE_SIZE	= 128; {0200B}	(* THE NUMBER OF WORDS ON A PAGE OF CODE *)
IBIT		= 256; {0400B}	(* THE INDIRECT ADDRESSING BIT *)
RBIT		= 128; {0200B}	(* THE CURRENT PAGE ADDRESSING BIT *)



(*
      THE  FOLLOWING  CONSTANTS  ARE  USED  INTERNALLY  FOR  MNEMONIC
   PURPOSES ONLY. NONE OF THEM SHOULD EVER BE CHANGED...
*)
CH_EOL		= '\';		(* THE INTERNAL MARKER USED FOR THE END OF LINE *)
CHAR_STR_LEN	= 80;		(* THE LENGTH OF AN INTERNAL MESSAGE STRING *)
LSTLIN_LEN	= 132;		(* THE LENGTH OF AN INTERNAL LIST LINE *)




(*
       THE  FOLLOWING  CONST'S  ARE USED AS FLAGS TO THE LIST ROUTINE;
    THEIR USE IS MORE FULLY DESCRIBED THERE... 
*)
LF_LBL = 1;   LF_LAD = 2;   LF_LAC = 3;   LF_LCD = 4;
LF_LTX = 5;   LF_LNT = 6;




(*
      THESE CONSTANTS REPRESENT VARIOUS STATEMENT TYPES... THEIR 
   ACTUAL NUMERIC VALUE IS NOT IMPORTANT... 
*)
ST_END = 1;   ST_ORG = 2;   ST_DAT = 3;   ST_TTL = 4;
ST_ASZ = 5;   ST_ZER = 6;   ST_EJEC= 7;   ST_SIX= 8;
ST_OPD = 9;   ST_EQU = 10;  ST_MACH= 11;  ST_NUL = 12;
ST_UNK = 13;




(*
      THE  FOLLOWING  CONSTANTS  DETERMINE THE ERROR CODES PRINTED IN
   THE  LISTING  AT  THE  START  OF  THE  BAD LINE... EACH ERROR CODE
   CONSISTS  OF  A  SINGLE  LETTER  (A .. Z); EXCEPT FOR ARGUMENTS TO
   ERRMSG, WHICH CONSIST OF 80 CHARACTER STRINGS...
*)
ER_IFN		= 'N';		(* ILLEGAL FORMAT FOR NUMBER *)
ER_SYM		= 'S';		(* A SYMBOL IN THIS STATEMENT HAS BEEN IMPROPERLY DEFINED *)
ER_UDF		= 'U';		(* THIS STATEMENT USES A SYMBOL WHICH HAS NOT YET BEEN DEFINED *)
ER_MDF		= 'M';		(* THIS SYMBOL IS MULTIPLY DEFINED *)
ER_SYN		= 'X';		(* SYNTAX ERROR... *)
ER_RAN		= 'A';		(* NUMBER OUT OF RANGE... *)
ER_PAF		= 'P';		(* PAGE FULL ERROR *)
ER_MIC		= 'O';		(* ILLEGAL MICRO-CODED COMBINATION *)
ER_SCT		= 'W';		(* ILLEGAL OFF PAGE REFERENCE *)




(*
       THESE  CONSTANTS  DEFINE CERTAIN STRING USED AS MESSAGES BY THE
    PROGRAM.   NOTE  THAT  SINCE  THESE  ARE  USED  AS  ARGUMENTS  FOR
    SUBROUTINES, EACH MUST HAVE EXACTLY THE RIGHT NUMBER OF CHARACTERS
    (INCLUDING TRAILING BLANKS...).
*)
ER_PBR	= 'PALX - Program break is                                                         ';
ER_NED	= 'PALX - No errors detected                                                       ';
ER_TED	= 'PALX -                                                                          ';
ER_TE2	= ' errors detected                                                                ';
SYMMSG	= 'Symbol Table                                                                    ';
ER_NCA	= 'PALX - Symbol table full                                                        ';








(*
	***** T Y P E   D E C L A R A T I O N S *****
*)
TYPE




(*
      THESE  TYPES  DEFINE  INDEX  FOR THE MORE POPULAR TABLES IN THE
   PROGRAM...
*)
SYMTAB_INDEX	= 0..SYMTAB_LEN;	(* INDEX INTO THE USER DEFINED SYMBOL TABLE *)
OPTAB_INDEX	= 0..OPTAB_LEN;		(* INDEX INTO THE MACHINE OPERATOR TABLE *)
POPTAB_INDEX	= 0..POPTAB_LEN;	(* AND INDEX INTO THE PSEUDO-OP TABLE *)




(*
      THE   FOLLOWING  TYPES  DETERMINE  THE  CHARACTERISTICS  OF  AN
   IDENTIFIER...
*)
IDENT_INDEX	= 1..IDENT_LEN;		(* A SUBSCRIPT FOR AN IDENTIFIER *)
IDENTIFIER	=			(* THE ACTUAL IDENTIFIER... *)
		  PACKED ARRAY [IDENT_INDEX] OF CHAR;




(*
      THESE  TYPES  DETERMINE  THE REPRESENTATION OF SEVERAL TYPES OF
   STRINGS USED INTERNALLY...
*)
LSTLIN_INDEX	= 1..LSTLIN_LEN;	(* THE SIZE OF A LIST STRING *)
SRCLIN_INDEX	= 1..SRCLIN_LEN;	(* A STRING READ FROM THE SOURCE FILE *)
CHAR_STR_INDEX	= 1..CHAR_STR_LEN;	(* AND THE SIZE OF A CHARACTER STRING *)
CHAR_STRING	=			(* AN INTERNAL CHARACTER STRING... *)
		  PACKED ARRAY [CHAR_STR_INDEX] OF CHAR;
LSTLIN_STRING	=			(* A STRING TO BE PRINTED IN THE LIST FILE *)
		  PACKED ARRAY [LSTLIN_INDEX] OF CHAR;
SRCLIN_STRING	=			(* AN EDITED STRING FROM THE SOURCE FILE... *)
		  PACKED ARRAY [SRCLIN_INDEX] OF CHAR;




(*
      THESE  TYPES  DETERMINE  SOME  COMMON NUMERIC TYPES WITHIN THIS
   PROGRAM...
*)
PINTEGER	= 0..MAXINT;		(* NON-NEGATIVE INTEGER *)
PDP_WORD	= 0..MAXIMUM_NUMBER;	(* A TARGET MACHINE WORD *)
OPCODE_TYPE	= (MRI, OPR, IOT,
                   PIE, PIO, CXF);     	(* THE TYPE OF AN OPCODE *)




(*
      THIS RECORD DEFINES AN ENTRY IN THE USER SYMBOL TABLE ...
*)
SYMTAB_ENTRY	=  RECORD
			NAME   : IDENTIFIER;	(* THE NAME OF THE SYMBOL *)
			VAL    : PDP_WORD;	(* THE VALUE OF THE SYMBOL *)
			SF_TAG : BOOLEAN;	(* TRUE IF THIS SYMBOL WAS DEFINED AS A TAG.. *)
			SF_EQU : BOOLEAN;	(* TRUE IF THIS SYMBOL WAS DEFINED BY AN EQUATE *)
			SF_OPD : BOOLEAN;	(* TRUE IF THIS SYMBOL IS AN OPDEF *)
			SF_UDF : BOOLEAN;	(* FLAG THAT  INDICATES THE SYMBOL IS UNDEFINED *)
			SF_MDF : BOOLEAN	(* FLAG THAT INDICATES THE SYMBOL IS MULTIPLY DEFINED *)
		  END;




(*
      THIS RECORD DEFINES AN ENTRY IN THE MACHINE OPCODE TABLE... 
*)
OPTAB_ENTRY	=  RECORD
			NAME  : IDENTIFIER;	(* THE NAME OF THE OPCODE *)
			OPCODE : PDP_WORD;	(* THE VALUE OF THIS OPCODE *)
			MODE   : OPCODE_TYPE	(* AND THE MODE IMPLIED HERE *)
		  END;




(*
      THIS RECORD DEFINES AN ENTRY IN THE PSEUDO-OP TABLE...
*)
POPTAB_ENTRY	=  RECORD
			NAME  : IDENTIFIER;	(* THE NAME OF THE PSEUDO-OP *)
			VAL   : PINTEGER	(* AND THE VALUE OF THE PSEUDO-OP *)
		  END;








(*
	***** V A R I A B L E   D E C L A R A T I O N S *****
*)
VAR




(*
      THESE VARIABLES CONTAIN ALL THE SYMBOL TABLES...
*)
SYMTAB		:			(* THE USER DEFINED SYMBOL TABLE *)
		  ARRAY [SYMTAB_INDEX] OF SYMTAB_ENTRY;
OPTAB		:			(* THE MACHINE OPCODE TABLE *)
 		  ARRAY [OPTAB_INDEX] OF OPTAB_ENTRY;
POPTAB		:			(* AND THE PSEUDO-OP TABLE *)
		  ARRAY [POPTAB_INDEX] OF POPTAB_ENTRY;




(*
      THESE  VARIABLES  CONTAIN  ALL  THE  STRINGS  PROCESSED IN THIS
   PROGRAM...
*)
SRCLIN,					(* THE EDITED SOURCE STRING *)
SRCLNU		: SRCLIN_STRING;	(* AND THE UNEDITED SOURCE STRING *)
LSTLIN		: LSTLIN_STRING;	(* STRINGS TO BE PRINTED IN THE LIST FILE *)
BLANK_LINE	: SRCLIN_STRING;	(* A BLANK INPUT LINE *)
CURSRI		: 0..CHAR_STR_LEN;	(* POINTER TO THE INPUT STRING *)
CURSRO		: 0..LSTLIN_LEN;	(* AND POINTER TO THE OUTPUT (LIST) STRING *)




(*
      THE FOLLOWING VARIABLES ARE ALL USED AS FLAGS....
*)
PASS_1,					(* SET IF THE ASSEMBLER IS UNDER PASS 1 *)
PASS_2,					(*  "   "   "      "     "   "     "  2 *)
FL_ERR,					(* SET IF THERE HAS BEEN AN ERROR IN THE CURRENT STATEMENT *)
FL_PAGE					(* SET IF WE NEED TO START A NEW PAGE IN THE LISTING *)
		: BOOLEAN;




(*
      THESE VARIABLES ARE ALL USED TO MAINTAN THE LITERAL TABLE...
*)
LITERALS	: ARRAY [0..PAGE_SIZE] OF PDP_WORD;	(* THIS CONTANS THE ACTUAL LITERALS *)
LITERAL_BASE	: INTEGER;				(* THIS POINTS TO THE ADDRESS OF THE LAST LITERAL *)




(*
      THESE VARIABLES ARE USED AS COUNTERS WITHIN THE PROGRAM...
*)
LINEK,					(* COUNTS THE LINES PRINTED IN THE LISTING *)
PAGEK,					(* COUNTS THE PAGES PRINTED IN THE LISTING *)
LINPAK,					(* COUNTS THE NUMBER OF LINES PRINTED ON THIS PAGE *)
ERRORK					(* COUNTS THE NUMBER OF ERRORS IN THE CURRENT PROGRAM *)
		: PINTEGER;




(*
      MISCELANEOUS....
*)
ERRCOD		:			(* REMEMBERS THE ERROR LETTERS FOR THIS STATEMENT *)
		  PACKED ARRAY [0..25] OF BOOLEAN;
IDENT_CHARS	: SET OF CHAR;		(* CONTAINS ALL CHARACTERS LEGAL IN AN IDENTIFIER *)
BLANK_ID	: IDENTIFIER;		(* A NULL IDENTIFIER NAME... *)
NULL_CODE	: PDP_WORD;		(* A COMPLETELY ZERO INSTRUCTION *)
GENCODE		: PDP_WORD;		(* HOLDS THE GENERATED MICRO-INSTRUCTION *)
PC		: PDP_WORD;		(* HOLDS THE ADDRESS OF THE CURRENT INSTRUCTION *)
CHECKSUM	: INTEGER;		(* THE CHECKSUM OF THE BINARY CODE *)
LAST_ADDR	: PDP_WORD;		(* THE LAST ADDRESS WRITTEN TO THE OBJECT FILE *)
TAG_FIELD	: IDENTIFIER;		(* THE CONTENTS OF THE STATEMENT'S TAG FIELD *)
PROGRAM_TITLE	: SRCLIN_STRING;	(* THE USER'S PROGRAM TITLE *)




(*
      AND  FINALLY  THESE  PARAMETERS  DEFINE THE 3 FILES USED IN THE
   ASSEMBLER ...
*)
LISTFILE	: TEXT;			(* THE SOURCE PROGRAM LISTING FILE *)
SOURCEFILE	: TEXT;			(* THE SOURCE PROGRAM INPUT FILE *)
OBJECTFILE	: TEXT;			(* AND THE GENERATED CODE FILE *)








(*
	***** I N I T I A L I Z A T I O N *****

      THESE   ROUTINES  INITIALIZE  ALL  DATA  AREAS  NEEDED  BY  THE
   ASSEMBLER. THESE DATA AREAS CAN BE DIVIDED INTO TWO PARTS: (1) THE
   PURE DATA (THAT WHICH IS NEVER CHANGED (LIKE AN OPCODE TABLE), AND
   (2)  THE  IMPURE  DATA  (THAT WHICH IS CHANGED (LIKE A USER SYMBOL
   TABLE)).  THE  PURE  DATA  AREAS  ARE ASSIGNED VIA DEC-10 PASCAL'S
   INITPROCEDURE  FEATURE; THE IMPURE AREAS ARE DYNAMICALLY SET UP BY
   A NORMAL ROUTINE. THIS ALLOWS THE ASSEMBLER TO BE RESTARTABLE...
*)




(*
      THIS  IS  THE  MACHINE  OPCODE  TABLE... IN THIS ASSEMBLER THIS
   TABLE  CONTAINS  THE  NAMES  AND  NUMBERS  OF ALL THE OPCODES IN THE
