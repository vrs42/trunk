ROMTOOLS.OBJ:	ROMTOOLS.C $(ROMTOOLS_DEP)
	$(CC) $(CFLAGS) $(CUSEPCHFLAG) /c ROMTOOLS.C

$(PROJ).EXE::	PDP2HEX.OBJ PDPFILE.OBJ ROMTOOLS.OBJ $(OBJS_EXT) $(DEFFILE)
