/MUST BE EDITED BY THE USER
/
TRANSLATE=1
/TRANSLATE=0	THE HANDLER IS TRANSLATED
/TRANSLATE=1	PROGRAM HELP IS TRANSLATED
/
/
/
/
HEL=30		/FIELD OF PROGRAM HELP. NORMALLY
		/THE HIGHEST AVAILABLE FIELD
/
/
STRTHL=3000	/STARTING ADDRESS OF PROGRAM HELP.
		/MUST BE AT A PAGE BOUNDARY
	XLIST 1
/
	IFNZRO TRANSLATE <
	XLIST 0
/
/
/
/
ERFUNC=1
/ERFUNC=0   ERASE FUNCTION NOT INSTALLED
/      =1   ERASE FUNCTION INSTALLED
/
/
FFAUTO=0
/FFAUTO=0   FORMFEED EXECUTED ONLY,
/           IF SPACE TYPED
/      =1   FORMFEED EXECUTED AUTOMATICALLY
/
/
BUFFFF=0
/BUFFFF=0   FORMFEEDS READ IN BUFFER
/           ARE REPLACED BY LINEFEED
/      =1   FORMFEEDS READ IN BUFFER
/           ARE EXECUTED
/
/
SIZE=2
/CHARACTER SIZE, 5X7 DOT MATRIX
/1 SMALLEST SIZE, 3 MAXIMAL SIZE
/
ENDHL=STRTHL+777
CDFHEL=CDF HEL
CIFHEL=CIF HEL
CHADR=CHONE
ADXPOS=XPOS
ADYPOS=YPOS
/SAVE COMMAND FOR PROGRAM HELP:
/SAVE SYS:HELP STRTHL:ENDHL;STRTHL=JOB STATUS WORD
/THE NUMBER OF THE FIELD MUST BE INCLUDED
