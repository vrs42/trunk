/FILE: TESTRT.PA

/TEST HANDLER RT.PA

	*200
	CLA		/START HERE
	CDF 0
	CIF 10
	JMS I (7700
	1		/A FETCH HANDLER
	DEVICE RT	/ARG(1)
			/ARG(2), BECOMES DEVICE NO.
ENTRY,	1201		/ARG(3), BECOMES ENTRY POINT OF HANDLER

CALL,	CDF CIF 0
	JMS I ENTRY	/CALL HANDLER
	1000		/FUNCTION CONTROL WORD
	1400		/BUFFER ADDRESS
	0		/STARTING BLOCK NO.
	HLT		/ERROR RETURNS HERE
	NOP
	JMP CALL
	*1400
	ZBLOCK 6000
ENDTST,	0
