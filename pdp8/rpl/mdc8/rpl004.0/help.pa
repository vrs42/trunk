CHONE,  0               /ENTRY TO DISPLAY
                        /A SINGLE CHARACTER
        DCA CH4         /AC HOLDS CHARACTER
        RDF
        TAD (CDF CIF
        DCA CDIRET
        CDF HEL
        TAD CH4
        TAD CTRLG
        SNA CLA         /IS IT BELL?
        JMP CTGFND      /YES
	TAD CH4
	TAD CTRLC
	SNA CLA		/IS IT CTRL/C?
	JMP MONIT	/YES: CALL MONITOR
        JMS CHAR        /DISPLAY CHARACTER
CH4,    0
RETCHO, CLAL
CDIRET, HLT             /RESTORE DF AND IF
        EXIT CHONE
CTGFND, TAD CH4
        TLS
        TSF
        JMP .-1
        JMP RETCHO
CTRLG,  -207            /NEGATIVE VALUE OF CTRL/G
        $
