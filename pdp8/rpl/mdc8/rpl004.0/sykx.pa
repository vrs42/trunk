/	17561/7642  7656	/TO CONTAIN 62X2
/	17562/7727  7621	/     "      "
/	17563/7721  7672	/     "     62X1
/	17576/6222  6221
/	^C
/	.SAVE SYS FRTS
/
/	.GET SYS BLOAD
/	.ODT
/	500/7126  7300		/0, NOT 2     )
/	561/7727  7656		/62X2 HERE    )
/	562/7721  7621		/  "   "      )
/	565/1555  1557		/-6221, NOT 3 ) BASIC
/	566/7642  7672		/62X1 HERE    ) V 3.0
/	567/7570  7200		/NOW DEV. 60  )
/	2557/1555  1557			      )
/	2560/7642  7672			      )
/	2561/7570  7300			      )
/
/	503/7126  7300		)
/	557/7727  7656		)
/	560/7721  7621		) BASIC
/	561/7642  7672		) V 4A
/	567/7570  7300		)
/	2556/7570  7300		)
/
/	7256/7126  7300
/	7370/7727  7656
/	7371/7721  7621
/	7372/1555  1557
/	7373/7642  7672
/	7374/7570  7300
/	^C
/	.SAVE SYS BLOAD
/
