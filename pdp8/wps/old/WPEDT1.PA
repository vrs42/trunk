	EDICHR

PUTOUT=	JMS I	.		/ PUT CHARACTER TO DISPLAY
	EDOCHR

MODSET=	JMS I	.		/ SET OR CLEAR EDIT MODES
	ESMODE

INSCHR=	JMS I	.		/ INSERT CHARACTER INTO TEXT BUFFER
	ESICHR							/M241	/m239

ADVPTR=	JMS I	.		/ ADVANCE CURPTR TO NEXT NON-NULL CHAR IN FILE
	ESAPTR

BKPPTR=	JMS I	.		/ BACKUP CURPTR TO NEXT NON-NULL CHAR IN FILE
	ESBPTR

CHKPTR=	JMS I	.		/ CHECK CHARACTER IN TEXT BUFFER FOR:
	ESATST			/ 	NULL - ETX - STX  STATUS

TSTSLT=	JMS I	.		/ TEST FOR SELECT MODE ACTIVE
	ESLCTS

