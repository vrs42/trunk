LINST2,	TEXT '![[?6L![[2&J![[R'	/ SEQUENCES DESCRIBED BELOW		/C235
		/ ESC [ ? 6 l	/ SET ABSOLUTE ADDRESSING MODE		/C235
		/ ESC [ 2 J	/ ERASE ENTIRE SCREEN			/C235
		/ ESC [ r	/ CLEAR SCROLLING REGION		/C235

LINST3,	
