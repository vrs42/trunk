/d238	TAD	NWWMAR
/d238	SPA
/d238	TAD	NWLMAR
/d238	DCA	WRPMAR
/d238	AC7777
/d238	TAD	NWPMAR
/d238	SPA
/d238	TAD	NWLMAR
/d238	DCA	PGFMAR
