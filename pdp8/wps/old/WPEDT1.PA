SLCTDR,	0			/ SELECT DIRECTION
PSTBLK,	0			/ CURRENT PASTE BLOCK
PSTPTR,	0			/ CURRENT PASTE BUFFER PTR
BASKCT,	0			/ CURRENT WASTEBASKET COUNT
