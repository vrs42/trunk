	DCA	.+1
	JMP I	.-.

MVJTAB,	ADVUNT			/ ADVANCE
BKPMOD=	.-MVJTAB
	BKPUNT			/ BACK UP
BLDMOD=	.-MVJTAB
	BLDUNT			/ BOLD
UDLMOD=	.-MVJTAB
	UDLUNT			/ UNDER LINE
NBDMOD=	.-MVJTAB
	NBDUNT			/ REMOVE BOLD
NUDMOD=	.-MVJTAB
	NUDUNT			/ REMOVE UNDER LINE
CASMOD=	.-MVJTAB
	CASUNT			/ UPPER/LOWER CASE
MVMASK=	7

SETUNT,	XX			/ SET UNIT
	TAD	GRAMUN
