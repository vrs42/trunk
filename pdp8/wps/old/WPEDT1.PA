	JMP	SLTUN1		/ NOT FOUND, GO CHECK NEXT CHARACTER
	DCA	EDMODE		/ FOUND, CLEAR THE EDIT MODE FLAG
	JMP	LSTUNT		/ GO RETURN DONE CODE TO CALLER

RPCUBK,	0			/ Rapid Paging CUrrent BlocK id #

	X=.			/ INDICATE FIRST FREE LOCATION ON PAGE
