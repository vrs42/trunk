/d238	TAD	NWCMAR
/d238	CLL RAL
/d238	SMA
/d238	JMP	.+4
/d238	AC0001
/d238	TAD	LFTMAR
/d238	TAD	RGTMAR
/d238	DCA	CENMAR
/d238	CDFMNU		Qu. why did we need this anyway??	/ A219

	JMP I	COPRUL

INSRUL,	XX			/ INSTALL RULER
	TAD	(ECSTRL)
	JMS	INSRL1
	JMS	MAKRUL
	CURUL
	INSRL1
	TAD	(ECMDRL)
	JMS	INSRL1
	JMS	MAKRUL
	NWRUL
