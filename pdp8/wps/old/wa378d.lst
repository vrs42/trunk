15409 037423* 7450          SNA                     / SKIP IF: NOT
15410 037424* 5270          JMP     MRGS1A          / GO PROCESS A "<<" SEQUENCE
15411               
15412 037425* 1371          TAD     ("<-">)         / IS CHARACTER = ">"?
15413 037426* 7450          SNA                     / SKIP IF: NOT
15414 037427* 5770          JMP     MRGS2A          / GO PROCESS "<>"(NULL FIELD NAME)
15415               
