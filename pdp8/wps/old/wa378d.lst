20433               /       FCLMRJ  FIND COLUMN LIMITS FOR RIGHT JUSTIFIED TAB STOP
20434               /
20435               /
20436               /       BEGIN;
20437               /       TEMP:=CURSOR;
20438               /       WHILE( CURUL[TEMP-1] = NOSTOP OR
20439               /               CURUL[TEMP-1] = CSTOP OR
20440               /               CURUL[TEMP-1] = HSTOP) TEMP:=TEMP-1;
20441               /       IF CURUL[TEMP-1] = RIGHT.MARGIN OR
20442               /               CURUL[TEMP-1] = RIGHT.JUST.STOP THEN TEMP:=TEMP+1;
20443               /       CLMPLL:=TEMP;
20444               /       TEMP:=CURSOR-1;
20445               /       SEEN.DECIMAL.FLAG=FALSE;
20446               /       WHILE( CURUL[TEMP+1] = NOSTOP OR
20447               /               CURUL[TEMP+1] = CSTOP OR
20448               /               CURUL[TEMP+1] = HSTOP OR
20449               /               ( CURUL[TEMP+1 = DECIMAL.STOP AND
20450               /                       SEEN.DECIMAL.FLAG = FALSE))
20451               /               BEGIN;
20452               /                       TEMP:=TEMP+1;
20453               /                       IF CURUL[TEMP] = DECIMAL.STOP THEN
20454               /                               SEEN.DECIMAL.FLAG = TRUE;
20455               /               END;
20456               /       CLMPUL:=TEMP;
20457               /       END;
