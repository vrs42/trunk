RZSETX,	0							/A024
	MQL		/SAVE CODE				/A024
	TAD	RZDRIV	/GET DRIVE				/A024
	AND 	KON07	/MASK NUMBER				/A024
	TAD	TBLPTR	/GET POINTER TO TABLE +OFFSET		/A024
	DCA	USEPTR	/USER POINTER				/A024
	MQA		/GET SWITCH				/A024
	DCA I	USEPTR	/STORE IT				/A024
