	AND	KON10		/WRITE BIT			/A026
	SNA CLA			/IS WRITE PROTECT		/A026
CHKRET,	ISZ	CKWPRO		/NO 				/A026
	JMP I	CKWPRO		/RET				/A026
/
/
/
USEPTR,	0	/USED TO SAVE POINTER TO CURRENT DEVICE	/A024
