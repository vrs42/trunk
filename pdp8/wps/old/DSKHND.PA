				EJECT
			FIELD 0
			*200
	JMP I	.+3		/WRITE BLOCK
	JMP I	.+1
	7600
	RXLOAD

			*RXLDLS
	RXEWT				/WRITE CODE
	0				/DEVICE NUM
	RXQBLK				/#BLOCKS
	.				/LIST PNTR-1
	DLRXLD				/BLOCK NUM
	RXDLDP-200			/START ADDRESS(COMP FOR 1/2 BLK)/XXXDFB
	IFNDEF DECDEV <
	CDFMNU				/FIELD NO		/M048	/M033
	>
	IFDEF DECDEV <
	CDF 50							/A048
	>
	-DSRXLD				/BLOCK COUNT
	0				/END BLOCK
