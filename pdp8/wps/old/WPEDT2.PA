	IFDEF CANADA < TEXT "&TAPER &LE &NOM: " >
	IFDEF FRENCH < TEXT "&TAPER &LE &NOM : " >
	IFDEF DUTCH  < TEXT "&TYP &DE &NAAM: " >
	IFDEF GERMAN < TEXT "&NAME &EINGEBEN: " >
	IFDEF NORWAY < TEXT "&SKRIV &NAVN: " >
	IFDEF SWEDSH < TEXT "&SKRIV &NAMN: " >
	IFDEF DANISH <TEXT "&SKRIV &NAVN : " >

EIGER2,
	IFDEF ENGLSH < TEXT "!&NOT !&FOUND-!&REENTER: " >
	IFDEF V30NOR < TEXT "!&IKKE !&FUNNET-!&LEGG INN P\E NYTT: " >
	IFDEF V30SWE < TEXT "&HITTAS INTE - &F\VRS\VK IGEN: " >
	IFDEF SPANISH < TEXT "&NO &SE &ENCUENTRA-&TECLEE OTRA VEZ: " >/A255
	IFDEF ITALIAN <TEXT "&NON TROVATO - &REINTRODURRE:" >
	IFDEF CANADA < TEXT "&INTROUVABLE-&REESSAYER:">
	IFDEF FRENCH < TEXT "&INTROUVABLE--&REESSAYER : " >/L.A.E
	IFDEF DUTCH  < TEXT "&NIET &AANWEZIG-&PROBEER &OPNIEUW: " >
	IFDEF GERMAN < TEXT "&NICHT &GEFUNDEN--&NOCH &EINMAL: " >
	IFDEF NORWAY < TEXT "&IKKE &FUNNET--&PR\V &IGJEN: " > /L.PHI
	IFDEF SWEDSH < TEXT "&FINNS &INTE--&F\RS\K &IGEN: " > /L.U.O, L.U.O
	IFDEF DANISH <TEXT "&IKKE &FUNDET--&PR\V &IGEN : " >/ L.PHI

