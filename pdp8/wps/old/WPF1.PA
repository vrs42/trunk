* 100	  ; TCCNTR, 0	/ TEMPORARY_CHARACTER_COUNTER (EXTRACTNUMBER)
* 100	  ; TABFLAGS, 0	/ TAB_FLAGS: (EXTRACTNUMBER ROUTINE)
			/  BIT11 = 0: NOT A DECIMAL TAB
			/	   1: DECIMAL TAB
			/  BIT1  = 0: LINE POSITION NEQ. POSITION
			/		OF DECIMAL TAB IN RULER
			/	   1: LINE POSTION EQ. POSITION
			/		OF DECIMAL TAB IN RULER

	    SAVCP, 0	/ SAVED_CURPTR (CKCTRL, EXTRACTNUMBER, INSDEL)
