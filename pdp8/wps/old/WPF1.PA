* 6040	    ; IOTU1O, 0		/ TERMINAL OUTPUT

* 6102	    ; SPL,    0		/ SKIP ON POWER LOW

* 6236	    ; PRQ3,   0		/ PANEL REQUEST NUMBER THREE		/A011

