ESCFLG,	0			/ESCAPE ACTIVE FLAG

PARTAB,	0			/INPUT PARAMETER TABLE POINTER
PARTB1,	0			/OUTPUT PARAMETER TABLE POINTER
RIGCOL,	0			/RIGHT COLUMN NUMBER OF CURRENT CURSOR ROW
