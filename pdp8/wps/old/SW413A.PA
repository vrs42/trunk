				/  <08> 0=JUMP SCROLL, 1=SMOOTH SCROLL
				/  <07> 0=WHITE-ON-BLACK, 1=BLACK-ON-WHITE
				/  <06> 0=KEYCLICK ENABLED, 1=KEYCLICK DISABLED
				/  <05> (IN VT100) 0=ANSI MODE, 1=VT52 MODE
				/  <04> 0=VT100 MODE, 1=VT200 MODE
