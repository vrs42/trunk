				/  <02> 0=7-BIT ENVIRONMENT, 1=8-BIT
				/  <01> 0=BELL ENABLED, 1=BELL DISABLED
				/  <00> 0=AUTOREPEAT ENABLED, 1=DISABLED
BAUDPO,	14			/PRINTER PORT BAUD RATE (DEFAULT TO 4800)
BAUDCO,	7			/COMMUNICATIONS PORT BAUD RATE (DEFAULT TO 1200)
SETUW2,	0500			/ANOTHER SETUP WORD FOR FUTURES (MUST FOLLOW
				/  THE SETUP PARAMETERS ABOVE)
				/  <09-11> KEYCLICK VOLUME (7,6,5,4,3,2,1,0)
