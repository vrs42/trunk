/ ------------------------------------------
/ CHARACTER HANDLING DURING ESCAPE SEQUENCES
/ ------------------------------------------
/
				/TARGET OF A 'JMS ESCPRO', CAUSES THE NEXT
				/ADDRESS TO BE STORED HERE.  A PANEL EXIT IS
				/FORCED.  THE NEXT GRAPHIC CHARACTER WILL CAUSE
				/PROGRAM EXECUTION AT THE SAVED ADDRESS.
ESCPRO,	0			/NEXT LEVEL OF ESCAPE SEQUENCE PROCESSING
	JMP I	NEXT		/RETURN TO MAIN LINE
/
NEXT,	SLUEX1			/NORMAL RETURN (ESCAPE SEQUENCE STILL ACTIVE)
/
DONE,	SLUINX			/FINAL RETURN (CLEARS ESCAPE-IN-PROGRESS FLAG)
/
/
/ ---------------------
/ END-OF-FRAME HANDLING
/ ---------------------
/
EOFPRO,	0			/END-OF-FRAME PROCESSING ROUTINE
	JMP I	XEOF20		/JUMP TO END OF END-OF-FRAME ROUTINE
/
/
/
/
