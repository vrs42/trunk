				/  0001=ONLY GRAPHICS, TURN CURSOR ON;
				/  0002=RECENT CURSOR MOVEMENT, TURN CURSOR ON;
				/  7777=GRAPHICS AFTER CURSOR MOVEMENT, TURN OFF
ERASE,	0			/ERASE REQUEST FLAG, USED BY CRTINI
				/  0000=ERASE SCREEN,
