BOTROW,	0			/BOTTOM ROW NUMBER OF DISPLAY REGION
MODROW,	0			/MAXIMUM ROW ADDRESS
MODCOL,	0			/MAXIMUM COLUMN ADDRESS (= 79. OR 131.)
LINEFL,	0			/FIELD OF ROW DISPLAY DATA
