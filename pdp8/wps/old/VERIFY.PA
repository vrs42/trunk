  TAD  (BLKLST+1)  /1
  JMS  ORLST
  TAD  (BLKLST+2)  /2
  JMS  ORLST
  TAD  (BLKLST+6)  /6
  JMS  ORLST
  TAD  (BLKLST+377)  /377
  JMS  ORLST
  JMP I  TAKSYS

ORLST,  XX  /MQ IS BITS,AC IS ADDR, CDF IS SET
  DCA  REG10
  TAD I  REG10
  MQA
  DCA I  REG10
  JMP I  ORLST

