CPINIT,  AC7777      /USE MINUS 1        /A055
  DCA  AIR13    /TO FORCE        /A055
  JMS  DSPMSG    /TERMINAL COUNT DISPLAY      /A055
  CDFBUF      /WORKING IN THE BUFFER FIELD    /A055
  TAD  (HBLKBF-1  /LOAD START OF HOME BLOCK BUFFER -1  /A055
  DCA  AIR17    /INTO AIR 17        /A055
  TAD  (HBBUF2-1  /LOAD START OF 2ND HOME BLOCK BUFFER -1  /A055
  DCA  AIR16    /INTO AIR 16        /A055
  TAD  (-377    /LOAD A BLOCK COUNT      /A055
  DCA  T1    /INTO T1 AS THE 'TO GO' COUNT    /A055
HBMOV,  TAD I  AIR17    /GET A HOME BLOCK WORD      /A055
