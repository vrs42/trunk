  JMP  SETDR0    /GOOD RESULT, SO GO DETERMINE DEVICE 0  /A054
  JMS  SETMS1    /SET UP 'WHEN READY....PROMPT    /A054
    CRSHM2    /'DENSITIES OF BOTH ^S MUST BE EQUAL.^S'/A054
    ISDSKT    /'DISKETTE'        /A054
    TRYAGN    /'  TRY AGAIN'        /A054
  JMP  REASK    /INVITE RETRY        /A054
SETDR0,  TAD  CPYDRV    /GET THE "COPY TO" DRIVE NUMBER    /A048
  SNA CLA      /IF ITS NOT 0, MAKE CPDRV0 A 0    /A048
