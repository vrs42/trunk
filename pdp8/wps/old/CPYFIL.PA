	JMS I	TOPSC		/ GO ERASE AND DISP
	CIFMNU			/ '--COPY DOCUMENT--'			/
	JMS I	IOACAL							/
	 0								/
	 NOWCOP			/ "YOU ARE NOW COPYING DOCUMENT N"	/
	 1115								/
CPYNBR,	0			/ DOCUMENT NUMBER			/
	CLA								/
	TAD	SIGNL		/ SEE IF WE'RE DOING NUMBERED DOCUMENTS	/
