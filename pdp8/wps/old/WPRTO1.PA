/	ENTER FROM  NORMAL   SUPER   SUBSCR
PRVECT,
	JMP NORMAL;	000;	001;	101;				/C148
	JMP SETUND;	000;	001;	101;				/C148
	JMP SUPER;	101;	000;	102;				/C148
	JMP SUBSC;	001;	002;	000
