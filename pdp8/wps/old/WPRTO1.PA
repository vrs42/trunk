PRMODE,	XX
	DCA	PRMODB		/ SAVE THE CHARACTER
	TAD	PRMODB		/ NOW OPERATE ON SUPER/SUB SSCT BITS
	CLL BSW
	AND	(0014
/				/ACC = 0, 4, 8, OR 12
	TAD	(PRVECT		/ ADD ADDRESS OF THE MATRIX
	DCA	PRJUMP		/ SAVE TO INDIRECT JUMP THROUGH
	JMP I	PRJUMP		/ EXECUTE THE APPROPRIATE ROUTINE	/M046
/									/D046
PRJUMP,	0
NEWPOS,	0			/ NEW VERTICAL SELECT
OLDPOS,	0			/ OLD VERTICAL SELECT
NEWHIT,	0			/ NEW HIT COUNT /			/A046
/ moved to page zero OLDHIT,	0			/ OLD HIT COUNT	/A046
PRMODB,	0
NEWMOD,	0			/ CHANGE HIT COUNT WHEN START PRINT
/
