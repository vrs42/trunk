PRTWH,	XX			/A116
	CLA RAL			/ GET LINK				/A258
	DCA	PRSAVL		/ SAVE LINK				/A258
	TAD	PRTWHC		/ GET HOP COUNT
	SNA			/ SKIP OUTPUT IF ZERO
	JMP	PRTWHX		/ GO RESTORE THE LINK!			/A262
	JMS	PRESCS		/ ELSE OUTPUT ACCUMULATE HOP AMOUNT
		PCMRT		/
	CLA
	DCA	PRTWHC		/ CLEAR THE COUNT
	JMS	PRESCS
		PCSPUM		/ SET PUM MODE
	TAD	PRTWDP		/ GET DECIPOINT/6 COUNT
	TAD	PRTWDP		/ AND TURN IT INTO
	TAD	PRTWDP
	CLL RAL			/ DECIPOINTS BY MULT BY SIX
	JMS	PRESCS		/ AND OUTPUT EXTRA DECIPOINT MOVEMENT
		PCMRT
	CLA
	DCA	PRTWDP		/ RESET EXTRA DECIPOINT COUNT		/A258
	JMS	PRESCS		/ AND RESET PUM MODE
		PCRPUM
PRTWHX,									/A262
	TAD	PRSAVL		/ GET SAVED LINK			/A258
	CLL RAR			/ RESTORE LINK				/A258
	JMP I	PRTWH		/ AND RETURN

PRSAVL,	0			/ STORAGE FOR LINK			/A258

PRTWHC,	0			/ NUMBER OF PRINTABLE CHARACTER UNITS TO HOP OVER

PRTWDP,	0			/ EXTRA DECIPOINTS/6 TO HOP OVER
/-------------------
	PAGE

OVTYPE=OLB
OVNUM=OVNUM+1
OVADR=OVADR+400
OVRLCA=PROVA+OVTYPE
DL=DLOPRO+OVNUM		/DISK BLOCK OF THIS OVERLAY
FIELD OVNUM%20+3

RELOC
*OVADR
RELOC OVRLCA

	-OVNUM


OV3L10=.-OVRLCA			/ LQP02 "SQUISH-LINE" JUSTIFICATION LOGIC/A080
OB3L10=OVTYPE+OVNUM
IFNZRO OV3L10-OVJL10 <TEMPLATE ERROR>

	AC0001
	JMS	PLREST		/ RESET BUFFER VARIABLES FOR SCAN
	DCA	UNDERL		/ RESET UNDERLINE FLAG
	DCA	OLDPOS		/ CLEAR THE SUPER/NORMAL/SUBSCRIPT
	DCA	NEWMOD		/ RESET THE NEW MODE FLAG
	AC0001			/ WE START IN COLUMN ONE		/A243
	DCA	PNJPSN		/ CLEAR POSITION COUNTER		/A239

/FIRST OUTPUT THE NON JUSTIFIABLE PART OF THE LINE IN NORMAL MODE	/A239
/THE JUSTIFIABLE PART OF THE LINE IS THAT PART TO THE RIGHT OF		/A239
/THE RIGHTMOST TAB SPACE.  IN THE NON JUSTIFIABLE PART OF THE LINE	/A239
/WE WANT THE TABS TO LINE UP SO WE USE THE POSITION TO ABSOLUTE COL CMD	/A239

PNJ1,	ISZ	PNJPSN		/ COUNT THIS POSITION			/A239

PNJ2,	TAD	SOFTPT		/ SEE IF BUFFER POINTER IS		/A239
	SNA			/ ZERO					/A239
	JMP	P3LIN0		/ YES, THE WHOLE LINE IS JUSTIFIABLE	/A239

				/ SEE IF BUFFER POINTER IS PAST		/A239
	CIA			/ THE LAST SOFT SPACE			/A239
	TAD	PLPTR		/ IF SO WE ARE DONE WITH NON JUSTIFIED	/A239
	SMA SZA  CLA		/ PORTION OF THE LINE			/A239
	JMP	P3LIN0		/ GO PROCESS JUSTIFIED PORTION		/A239

	TAD I	PLPTR		/ GET THE CHARACTER			/A239
	AND	(2177)		/ MASK MODE BITS 0,2,3,4		/A254
	TAD	(-TSPC)		/ SEE IF A TAB SPACE			/A239
	SNA CLA			/					/A239
	JMP	PNJ4		/ IS TAB SPACE				/A239
	JMS	TCLQPA		/ CHECK FOR & PROCESS TECHNICAL CHARS	/A244
	JMS	PRMODE		/ PROCESS THE MODE BITS			/A239
	JMS	PR2TST		/ PRINT THE CHR				/A239

PNJ3,	JMS	PLCHBS		/ ARE THERE MORE CHARACTERS?		/A239
	JMP	P3LIN5		/ WE SHOULD NEVER GET HERE BUT...	/A244
	JMP	PNJ1		/ A multinational PRECEDENCE CHR	/a271
	JMP	PNJ1		/ A TECHNICAL PRECEDENCE CHR		/C244
	SKP			/ YES, IN THE SAME POSITION		/A239
	JMP	PNJ1		/ YES, IN A NEW POSITION		/A239

	TAD	(BS)		/ PUT OUT A BACKSPACE			/A239
	JMS	PRCHAR		/ PUT OUT A BACKSPACE			/A239
	JMP	PNJ2		/ GET NEXT CHR IN THIS POSITION		/A239

PNJ4,				/ TAB SPACE SEEN			/A239
	TAD I	PLPTR		/ GET THE CHARACTER			/A256
	JMS	PRMODE		/ RESET MODE BEFORE TEST FOR TAB SPACE	/A256
	TAD	PNJPSN		/ GET COLUMN POSITION			/A239
	TAD	PRMCMG		/ GET INDENT				/C244
	JMS	PRESCS		/ POSITION HEAD TO THIS COLUMN		/A239
		PCCOLA		/					/A239
		CLA		/					/A239
	JMP	PNJ3		/ NO, GET NEXT CHR			/A239

P3LIN0,	JMS	PRESCS		/ SET PUM MODE
		PCSPUM
	ISZ	PRPUMM		/ set the PUM mode flag			/a272

/WE MUST POSITION THE HEAD TO THE START OF THE FIRST CHARACTER
/IN THE JUSTIFIED PORTION.  IN PUM MODE THAT WILL BE AT HALF OF THE
/WIDTH OF THE FIRST CHARACTER.  SINCE THE LQP02 DIVIDES THE MOTION
/BY SIX WE WILL MULTIPLY BY THREE...

	JMS	PLSPCX		/ GET WIDTH AND RESTORE POINTERS	/A239
				/ PLWIDT  is returned in AC
	TAD	PLWIDT		/ Compute *2
	TAD	PLWIDT		/ Compute *3
P3LIN1,	DCA	P2HEAD		/ Save amount to move print head prior
				/  to printing the next character.

/NOW WE PROCESS THE JUSTIFIABLE PORTION BY PRINTING ALL CHARACTERS
/ in the current print position and then moving the print head by half
/ of the current print position + half of the next print position +
/ any justification spacing. We then move on to the next print position.

	JMS	PLSPC	/Get spacing to center of next char posn.
	TAD I	PLPTR	/Save current character for it's justify bit.
	DCA	P3TEMP	/ We'll use it later for intra-char spacing.

P3LIN2,	JMS	TCLQPA	/Get the character and test for mnc/tech	/c271
	JMS	PRMODE	/Process the mode bits and print character.
	JMS	PR2TSP		/ CALL ROUTINE TO TEST FOR SPACE	/C211
	TAD	NEWHIT		/ TEST TO SEE IF BOLD ATTRIBUTE
	TAD	PRQOVP		/ ONLY BIT 11 OF INTEREST
	AND	PRQSP		/ AND WITH MENU BIT			/C244
	RAR			/ PUT BIT IN LINK			/C244
	SNL CLA			/ SKIP IF SHADOWING THIS CHR		/C244
	JMP	P3LIN3		/ NO, MERGE BELOW

	AC0006		/ move print head 1/120th to the right.
	TAD	P2HEAD	/  ...
	DCA	P2HEAD	/  ...
	JMP	PR2REP		/ PRINT THE CHR AGAIN (SHADOW)	/c273	/C211
P3CONT,
/d273	TAD	(-6)	/ move print head back to orig posn.
	TAD	P2HEAD	/  ...
	DCA	P2HEAD	/  ...
P3LIN3,	JMS	PLCHBS	/Are there more characters?
	JMP	P3LIN5	/No--wrap up this LINE
	JMP	P3LI3A	/YES, multinational PRECEDENCE			/a271
	JMP	P3LI3A	/YES, TECHNICAL PRECEDENCE			/C244
	JMP	P3LIN2	/Yes--overstrike them.
			/FALL THROUGH IF YES IN A NEW POSITION		/A233
P3LI3A,
	AC4000		/If char we just printed is justifyable then
	AND I	PLPTR	/ add in extra spacing if needed.
	SNA CLA		/Skip if char is justifyable. check for xtra sp
	JMP	P3LIN4	/Ignore additional spacing for this char posn.
	TAD	PRJDEF	/See if any deficiency left.
	SMA CLA		/Skip if yes.
	JMP	P3LIN4	/Jmp if no more inter-character/space spacing.
	ISZ	PRJDEF	/Allocate an increment.
	AC0001		/If here then allocate it. Skip if no more to do
	JMP	P3LIN4		/ GO TO NEXT PAGE

P3LI4,	JMS	TCLQPA	/ deal with the precedence char and get the real/a271
	JMP	P3LI3A	/ go print it					/a271

PNJPSN,			/THIS LABEL IS USED IN NON JUSTIFIABLE PORTION	/A239
P3TEMP,	0		/THIS LABEL IS USED IN JUSTIFIABLE PORTION ONLY


/ TCLQPA IS IDENTICAL TO TCLQP BUT MUST BE FREE TO RESIDE
/ HERE SINCE THERE ARE TOO MANY LINKS IF WE *TCLQP IT
TCLQPA,	XX			/ CHECK FOR & PROCESS TECH CHR		/A233
	TAD I	PLPTR		/ GET CHARACTER				/A239
				/ IF A TECH PRECENCE CHR THEN IGNORE IT,
				/ AND REPLACE

	AND	P177		/ MASK
	TAD	(-23)		/ SEE IF A TECH PRECEDENCE CHR
	SNA			/ test for technical precedence char	/a271
	JMP	WSTECA		/ go deal with it			/a271
	IAC			/ increment to test for multinational char/a271
	SNA			/ was it a multinat precedence char	/a271	
	JMP	WSMULA		/ was go deal withit			/a271
	IAC			/ increment to test for line drawing	/a271			
				/ precedence char			/a271
	SNA CLA			/ skip if no multec char found		/a271
	JMP 	WSTECA		/ jump if it was line precedence char	/a271
TCLQPY,	TAD I	PLPTR		/ RELOAD CHR				/a271
	JMP I	TCLQPA		/ AND RETURN				/a271

WSMULA,	AC7777			/ set ac to flag mutinational		/a271
WSTECA,	JMS	BHOOK		/ call the blastr routine		/a271
	MCLQPE			/ to load reqd space or 8 bit char	/a271
	JMP	TCLQPY		/ exit					/a271
/------------------------
	PAGE

/***********************************************************************/
/									/
/	PRMODE--LQP02/03 ROUTINE TO OPERATE ON MODE BITS AND POSITION	/
/		CARRIAGE FIRST FOR PROPER SUPER/SUB/NORMAL VERTICAL	/
/		POSITION, OUTPUT PRIMARY AND SECONDARY SGR SEQUENCES	/
/		FOR BOLDNESS, UNDERLINE, AND HAMMER MUTING IF TW YES	/
/		AND NOT PRINTING THE CHR ON THIS PASS			/
/									/
/		THIS ROUTINE IS DUPLICATE THROUGH SEVERAL OF THE	/
/		OVERLAYS.  THUS IT MUST ORIGINATE AT THE SAME LOCATION	/
/		IN EACH OVERLAY OR ELSE THERE WILL BE AN ASSEMBLER ERROR/
/									/
/		THIS COPY IS A LITTLE DIFFERENT FROM OTHER COPIES	/
/		IN THAT IT USES THE HAMMER MUTING FOR TW RATHER THAN	/
/		THE FASTER HOPPING IN THE OTHER COPIES			/
/		THUS IT DOES NOT HAVE A SKIP RETURN			/
/									/
/***********************************************************************/
PRMODE,	XX
	DCA	PRMODB		/ SAVE THE MODE BITS
	TAD	PRMODB		/ NOW OPERATE ON THEM
	CLL BSW
	AND	(0014		/ KILL BOLD BIT
/				/ACC = 0, 4, 8, OR 12
	TAD	(PRVECT		/ ADD ADDRESS OF THE MATRIX
	DCA	PRJUMP		/ SAVE TO INDIRECT JUMP THROUGH
	JMP I	PRJUMP		/ EXECUTE THE APPROPRIATE ROUTINE
PRJUMP,	0
NEWPOS,	0			/ NEW VERTICAL SELECT
OLDPOS,	0			/ OLD VERTICAL SELECT
NEWHIT,	0			/ NEW HIT COUNT
/d273 moved to page zero OLDHIT,	0			/ OLD HIT COUNT
PRMODB,	0
NEWMOD,	0			/ CHANGE HIT COUNT WHEN START PRINT
/
/
/	ENTER FROM  NORMAL   SUPER   SUBSCR
PRVECT,
	JMP NORMAL;	000;	001;	101
	JMP SETUND;	000;	001;	101
	JMP SUPER;	101;	000;	102
	JMP SUBSC;	001;	002;	000

SETUND,/	THE FOLLOWING EITHER SETS OR RESETS THE UNDERLINE FLAG
	JMS	VERT		/ ACC = 0, SELECT 0
	TAD	UNDERL		/ IF UNDERLINE = OFF
	SNA CLA
	DCA	NEWMOD		/ THEN CHANGE PRINT MODE
	IAC			/ AND SET UNDERLINE = ON
	JMP	DOPRNT		/ AND DO PRINTING

SUBSC,	IAC			/ NEWPOS WILL BE SELECT 2
SUPER,	IAC			/ NEWPOS WILL BE SELECT 1
NORMAL,	JMS	VERT		/ SELECT 0 VERTICAL
RSTUND,
	TAD	UNDERL		/ IF UNDERLINE = ON
	SZA CLA
	DCA	NEWMOD		/ THEN CHANGE PRINT MODE
DOPRNT,
	DCA	UNDERL		/ AND SET/RESET UNDERLINE
PRINT,
	TAD	PRMODB	/Get the mode bits
	BSW		/And put the bold bit into the link
	RTR
	CLA
	TAD	PRQ2W	/Get the two wheel flag
	SNA		/If AC=0, no two-wheel
	JMP	PRNT1A	/Jump to handle regular printing
	SMA CLA
	CML		/Second pass--complement the link and the two cases
			/become identical.
	SZL		/Skip if we need to print during this two-wheel pass
	AC7777 CLL		/ ELSE LOAD -1 INTO THE AC
PRNT1A,
	RAL			/ GET HIT COUNT
	TAD	PRQOVP		/ ADD IN THE DARKNESS VALUE
	DCA	NEWHIT		/ SAVE AS NEW BOLD MODE
	TAD	NEWHIT		/ GET IT BACK
	TAD	OLDHIT		/ COMPARE AGAINST OLD BOLD MODE
	SZA CLA
	DCA	NEWMOD		/ IF DIFFERENT, DO ESCAPE STRING
	TAD	NEWMOD		/
	SZA CLA			/ IF NEWMOD=0, THEN HAVE TO CHANGE MODE
	JMP	OLDMDA		/ NO CHANGE
	ISZ	NEWMOD		/ ELSE DO : FLAG CHANGE MADE
	TAD	NEWHIT		/          GET NEW MODE
	JMS	PRESCS		/          SEND IT
		PCBOLD
	CIA			/          MAKE NEGATIVE FOR NEXT COMPARE
	DCA	OLDHIT		/          SAVE IT
OLDMDA,
	JMP I	PRMODE

/***********************************************************************/
/									/
/	CONTINUE JUSTIFICATION HERE FROM OTHER PAGE			/
P3LIN4,	TAD	PLPOS	/ Compute head movement for this print posn.
	DCA	P3TEMP	/ Save in temp.
	TAD	P3TEMP	/ Compute *1
	CLL RAL		/ Compute *2
	TAD	P3TEMP	/ Compute *3
	CLL RAL		/ Compute *6
	DCA	P3TEMP	/ Save, just incase.
	TAD	P3TEMP	/ Get this head movement.
	TAD	P2HEAD	/ Accumulate head movement.
	SMA		/ Skip if overflow.
	JMP	P3LIN1	/ Process next print posn.
	CLA		/ Get last (ok) movement command.
	TAD	P2HEAD	/  ...
	JMS	PRESCS	/ Move the head to that posn.
		PCMRT	/  ...
	CLA		/ Get this posn width.
	TAD	P3TEMP	/  and reset movement to this width.
	JMP	P3LIN1	/Print next posn.

P3LIN5,	DCA	P2HEAD	/ Reset accumulated head movement.
	JMS	PRMODE	/ADJUST ANY SUPER/SUBSCRIPT V-SPACE		/A099
	JMS	PRESCS	/ reset PUM mode.
		PCRPUM	/  ...
	DCA	PRPUMM	/ clear the PUM mode flag			/a272
	TAD	(CR)	/Transmit a carriage return
	JMS	PRCHAR
	JMP	PRGSL1		/ LINE COMPLETE - DO VERTICAL SPACING


PR2REP,			/ repeat last char				/a273
	AC7777			/ get flag value			/a273
	DCA	REPCHAR		/ set flag				/a273
	JMS	PR2TSP		/ send it				/a273
	TAD	(-6)
	JMP	P3CONT		/ return to mainline			/a273

PR2TSP,	XX			/ TEST FOR SPACE			/A211
	TAD I	PLPTR		/ GET CHR
	AND	P177		/ MASK
	TAD	(-SPC)		/ SEE IF SPACE
	SZA CLA			/ YES, SKIP PR2TST
	JMS	PR2TST		/ ELSE DO PR2TST
	DCA	REPCHAR		/ clear repchar for space not required	/a273
	JMP I	PR2TSP		/ RETURN
/-------------------
	PAGE

OVTYPE=OLC
OVNUM=OVNUM+1
OVADR=OVADR+400
OVRLCA=PROVA+OVTYPE
DL=DLOPRO+OVNUM		/DISK BLOCK OF THIS OVERLAY
FIELD OVNUM%20+3

RELOC
*OVADR
RELOC OVRLCA

	-OVNUM

/When PLWIDE is called, the buffer variables point to the first
/character in a position.  The routine returns the width of the position by
/storing it in PLWIDT.  This is the width from the proportional table if
/proportional printing is in effect, or the standard character size otherwise.

/If the position is a dead key sequence, the width of the widest character
/in the sequence is returned.

/If the position is the last in the line, a normal return is made.  Otherwise,
/a skip return is made.

/Upon return, the buffer variables point to the first character in the
/next position.


PLWIDE,
	XX
	DCA	PLWIDT	/Clear the position width

/This loop runs through the sequence CHAR1 BS CHAR2 BS ... BS CHARn which
/makes up the position.  The width of the position is the width of the
/widest character in the sequence.

PLWID0,

/If we are not doing proportional printing, the width of all the characters
/is always PLNRCS.

	TAD	PLPFLG	/Are we printing proportional?
	SNA CLA		/ FIX THIS SKIP SO WE WILL PRINT TO DP		/A123
	JMP	PLWID1	/Yes--retrieve the character width
	JMS	MNGETC	/ get the char pointers to the right position	/a274
	CLA		/ don't care if it is a tech char		/a274
	CLA		/ clear if it is a multinational char		/a274
PLWDA1,									/a274
	TAD	PLNRCS	/No--get the character width
	JMP	PLWID3	/And jump to join the proportional width code

PLWID1,
/SAVE THE REAL CHR IN A TMP.  CHECK TO SEE IF IT IS A REPLACEMENT	/A218
/CHR.  IF SO READ WIDTH FROM A DIFFERENT TABLE POSITION BUT LEAVE	/A218
/CHR CODE IN PRLBUF ALONE.						/A218

	JMS	RXTST		/TEST FOR REPLACEMENT CHRS		/A218
	JMP	PLWR1		/IS R1					/A218
	JMP	PLWR2		/IS R2					/A218
	JMS	MNGETC		/GET NON REPLACEMENT CHR		/c271
	JMP	PLWDA1		/go get reqd space			/a274
				/ skip return				/a274
/ check here for 8 bit chars						/a271
	AND	P177		/ get rid of the mode bits		/a271
	TAD	(200)		/ add in 200 for 8th bit		/a271
	ISZ	PLWMUL		/ skip if multinational detected	/a271
	AND	P177		/ no so take out the 8th bit		/a271	
PLWID5,	DCA	PLWTM		/ SAVE IN ROUTINE VARIABLE		/A218

/We want to recover the width OF THE CHAR FROM THE PROPORTIONAL width table
/The lower two bits of the char indicate which of the word the width
/is in. The remainder of the width identify the word. Se the table 
/documentation for more info.
/First we set up things so that we will be able to retreive the proper three
/bits from the information word

	AC0003		/ get a bit map into the ac	
	AND	PLWTM	/Get the lower two bits of the character
	CMA		/Convert them into a counter
	DCA	T1	/And save the counter

/Now we recover the information word from the table.

/d271	JMS	SKIPIF							/A211
/d271		LQPSE							/C217
/d271	TAD	(P2STBL-PSTBL)	/DIFFERENCE IN BASE TABLE		/A211
/d271	TAD	(PSTBL-7)	/-7 FOR OFFSET AT SPACE-1%4		/C218
/d271	DCA	T3		/SAVE TABLE BASE POINTER		/A211
	TAD	PLWTM		/GET THE CHR				/C218
	AND	(374)	/MASK THE MODE BITS AND 2 LS CHR BITS		/C194
	CLL	RTR	/DIVIDE BY 4 (CHARACTERS PER TABLE ENTRY)
			/normalizing the ascii space code to PSTBL
	TAD	(LQPTBL-7)	/ADD TABLE BASE POINTER				/A211
	DCA	T3	/Save to indirect through
	TAD I	T3	/And get the information word

/Now that we have the information word, we must extract the correct three
/bits from it. We simply rotate the bits around the number of times specified
/by the counter saved in T1. The R3L instruction does not use the link	

PLWID2,
	R3L		/ rotate the next three bytes
	ISZ	T1	/ have we rotated enough
	JMP	PLWID2	/ not yet
	AND	(7	/ mask the three lower bits

/ We now have the code for the desired space in the AC. We now scale it back
/ up to the desired proportional spacing.

	IAC		/ADD BIAS TO THE CODE				/C211
	CLL RAL		/Multiply by two
	DCA	T3	/And save the width

/PLWIDT contains the width of the widest character encountered so far in the
/position.  If the new width is larger, update PLWIDT.

	TAD	T3
	CIA		/Negate the new width
	TAD	PLWIDT	/Compare with the current largest width

	SMA CLA		/If the AC is negative, the new width is larger
	JMP	PLWID4	/No update is necessary
	
	TAD	T3	/Recover the new width

/The largest width found so far in the position is in the AC.  This was
/determined either by comparison (in the proportional case) or because
/all widths are the same (in the non-proportional case).  In either case,
/update PLWIDT.

PLWID3,
	DCA	PLWIDT	/Record the current largest width
	DCA	PLWMUL	/ CLEAR THE MULTINATIONAL FLAG			/A274

/We now determine whether the character sequence continues.  If it does,
/we iterate.  If not, we return the width of the position--making a regular
/return if this position is the last position, making a skip return otherwise.

PLWID4,
	JMS	PLCHBS	/Are there more characters?
	JMP I	PLWIDE	/No--make a regular return
	JMP	PLWD4	/YES, A multinational PRECEDENCE		/a271
	JMP	PLWD4	/YES, A TECHNICAL PRECEDENCE			/A233
	JMP	PLWID0	/Yes, in this position--iterate

/The end of the position's character sequence has been found.  Make a skip
/return.
PLWD4,
	ISZ	PLWIDE	/This is not the last position--make a skip return
	JMP I	PLWIDE


PLWR1,	TAD	(37-177)		/USE TABLE PSN BEFORE SPACE	/A218
					/FOR R1				/A218
PLWR2,	TAD	P177			/USE TABLE PSN 177 FOR R2	/A218
	JMP	PLWID5			/RE-ENTER ROUTINE ABOVE		/A218

PLWIDT,	0	/The width of the position pointed to by the buffer variables
		/when PLWIDE is invoked.  The return value of the routine.

PLWTM,	0	/THE CHARACTER VALUE USED TO INDEX THE TABLE		/A218

/**********************************************************************/
/									/
/	PRTST---REPLACEMENT CHR ROUTINE					/
/		THIS IS THE BASIC ROUTINE FOR OUTPUTTING THE		/
/		ACTUAL CHARACTERS TO THE PRINTER.  BEFORE WE CAN	/
/		OUTPUT A CHARACTER WE HAVE TO KNOW WHETHER		/
/		IT IS:							/
/		1)	THE REQUIRED SPACE CODE				/
/		2)	EITHER REPLACEMENT CHR (R1 OR R2)		/
/		3)	A MULITEC CHARACTER REQUIRES 8 BITS		/
/		IF SO, SPECIAL TREATMENT IS REQUIRED			/
/									/
/***********************************************************************/

PRTST,	XX	/ REPLACEMENT CHR ROUTINE	
		/ THIS ROUTINE IS FOR BOTH THE LQP02 AND LQPSE
	ISZ	REPCHAR		/ examine repeat char flag		/a273
	JMP	PRTST1		/ continue if not			/a273
	TAD	LSTCHA		/ get the last char			/a273
	JMP	PRTST2		/ just send it again			/a273
PRTST1,									/a273
	TAD I 	PLPTR	/GET CHARACTER
	AND 	P177	/STRIP OFF MODE BITS
	TAD	(-RQSP)	/IS IT THE REQUIRED SPACE?			/A217
	SNA	CLA	/						/A217
	JMP	PRC3	/YES, IS REQUIRED SPACE				/A217
	JMS	RXTST		/TEST FOR REPLACEMTN CHRS		/A218
	JMP	PRC1		/IS R1					/C218
	JMP	PRC2		/IS R2					/C218
	TAD I	PLPTR		/ GET THE CHARACTER			/C218
	AND	P177		/ watch those top bits			/a271
	TAD	(200)		/SET MULTINATIONAL BIT FOR 8 BIT PRINT	/A271
	ISZ	MNCFLG		/IS IT A MULITEC CHAR			/A271
	AND	P177		/NO DONT ADD 200			/A271
PRTST3,									/a273
	DCA	LSTCHA		/ save this char			/a273
	TAD	LSTCHA		/ get it back again			/a273
PRTST2,									/a273
	JMS	PRCHAR		/AND PRINT IT
	DCA	MNCFLG		/ CLEAR THE MULTINATIONAL CHAR FLAG	/A271
	DCA	REPCHAR		/ clear the repchar flag		/a273
	JMP I	PRTST		/EXIT
	
PRC1,	JMS 	PRESCS	/DO S1 SUBSTITUTION
		PCSUB1
	JMP I	PRTST	/EXIT

PRC2,	JMS	PRESCS	/DO S2 SUBSTITUTION
		PCSUB2	
	JMP I	PRTST	/EXIT

PRC3,

/WE HAVE DETECTED THE REQUIRED SPACE.  WE CANNOT SIMPLY OUTPUT		/A217
/A SPACE CODE INSTEAD OF THE CODE FOR THE REQUIRED SPACE SINCE		/A217
/THE AMOUNT OF MOTION THAT THE SPACE MOVES IS PROGRAMMABLE IF WE	/A217
/ARE JUSTIFYING.  THE JUSTIFICATION LOGIC PRESUMED THAT THE SPACE	/A217
/WIDTH IS CONTAINED IN PLNRCS.  THUS WE OUTPUT THAT AMOUNT OF		/A217
/HORIZONTAL MOTION...							/A217

/HERE WE USED TO OUTPUT SPACE BACKSPACE TO TRIGGER UNDERLINE		/A268
/BUT WE HAD PROBLEMS WITH JUSTIFICATION OF REQ'D SPACE SO CODE WAS DLTD	/A268


/FOR THE LQPSE WE MUST OUTPUT IN PRINT UNITS				/A218
/FOR THE LQP02 WE MUST OUTPUT IN COLUMN UNITS, ERGO:			/A218

/d273 delete these LQPSE bits to gain room for this edit 
/d273	JMS	SKIPIF							/A218
/d273		LQPSE							/A218
/d273	JMP	PRC4		/LQP02/3				/A218

/THIS IS REQUIRED SPACE TO THE LQPSE					/A218
/d273	TAD	PLNRCS		/GET STANDARD WIDTH ACCORDING TO PITCH	/A218
/d273	JMS	PLHMOV		/CALL THE LQPSE HORZ MOTION ROUTINE	/A218
/d273	JMP I	PRTST		/RETURN					/A218

PRC4,			/REQUIRED SPACE IN PRTST			/A217
/d273	TAD	PLDIR		/GET DIRECTION FLAG			/A217
/d273	JMS	PRESCS		/CALL ROUTINE FOR HORZ MOVE		/A217
/d273		PCMRT		/HORIZONTAL MOTION HAI COLUMNS		/A217
/d273		CLA							/A217
/d273	JMP I	PRTST		/EXIT					/A217
	TAD	(240)		/get an eight bit space			/a273
	JMP	PRTST3		/ go output it				/a273



/****************************************************************************
/ RXTST	        Replacement chars R1 R2
/****************************************************************************

RXTST,	XX		/ Normal exit if R1
			/ Skip exit if   R2
			/ else double skip

	TAD I	PLPTR		/GET CHR				/A218
	AND	P177		/STRIP MODE BITS			/A218
	TAD	PRQSB1		/ADD NEGATIVE OF VALUE STORED		/A218
	SNA			/					/A218
	JMP I	RXTST		/IS R1, RETURN				/A218
	ISZ	RXTST		/BUMP RETURN IF NOT R1			/A218
	TAD	PRQSB2		/ADD NEGATIVE OF DIFFERENCE		/A218
	SZA CLA			/					/A218
	ISZ	RXTST		/BUMP RETURN IF NOT R2			/A218
	JMP I	RXTST		/RETURN					/A218


/THIS IS THE REPLACEMENT CHARACTER ROUTINE FOR THE LQP02

PR2TST,	XX
	TAD	P2HEAD	/ Get amount to move print head
	SZA		/ don't move print head if no where to go
	JMS	PRESCS	/  move the print head
		PCMRT	/  harmless "and" if executed
	CLA		/ reset head movement saver
	DCA	P2HEAD	/
	JMS	PRTST	/ print char & do substitution
	JMP I	PR2TST	/ Return to caller

LSTCHA,	0		/ last character printed			/a273
REPCHAR,0		/ repeat char flag				/a273
P2HEAD,	0		/ Amount to pre-move print head
/------------------------------
	PAGE


	/XLIST
OBTABL=OVTYPE+OVNUM

/***********************************************************************/a271
/ LQPTBL     space reseved for the LQP proportional print tables	/a271
/    		must resided here see WPBLTB				/a271
/***********************************************************************/a271

LQPTBL,	ZBLOCK	77		/ 63 words reserved			/a271


/***********************************************************************/
/									/
/	VERT -- ADJUST VERTICAL POSITION WITHIN THE LINE		/
/		TRANSMITS 0, 1, OR 2 PLU OR PLD SEQUENCES		/
/		DEPENDING ON THE PREVIOUS VERTICAL ATTRIBUTE		/
/		AND THE NEXT VERTICAL ATTRIBUTE				/
/									/
/		THIS ROUTINE USED TO CALL PRESCS WITH PCMPUP		/
/		WHICH GENERATED AN E[1e WHILE GOING FROM A SUPER
/		TO A SUB.  IN JUSTIFIED TEXT WE ARE USING PUM MODE	/
/		SO THIS BECOMES A VERY SMALL MOTION, SO THIS WAS	/
/		REWRITTEN TO GENERATE TWO $L OR $K SEQUENCES WHEN	/
/		GOING FROM SUPER TO SUB OR VICE VERSA...REV148		/
/									/
/***********************************************************************/

OBVERT=OVNUM+OVTYPE							/A247

VERT,	XX
	DCA	NEWPOS		/ SET THE NEW VERTICAL SELECT
	TAD	PRJUMP		/ GET JUMP POINT
	IAC			/ POINT TO VERTICAL MOTION (0)
	TAD	OLDPOS		/ MOTION DEPENDING ON OLD VERTICAL
	DCA	VERTT1		/ SAVE ADDRESS
	AC0100			/ SET AC TO A MASK			/A148
	AND I	VERTT1		/ READ THE TABLE AND MASK		/A148
	BSW			/ SWAP INTO LSB POSITION		/A148
	DCA	VERTFG		/ SAVE AS THE DIRECTION FLAG		/A148
	TAD I	VERTT1		/ READ TABLE AGAIN			/A148
	AND	P77		/ MASK OFF FLAG BIT			/A148
	CMA			/ NEGATE BUT DON'T ADD ONE		/A148
	DCA	VERTT1		/ SAVE AS A COUNTER			/A148
VERT1,	ISZ	VERTT1		/ BUMP COUNTER				/A148
	JMP	VERT2		/ NEED TO OUTPUT SOMETHING		/A148
	TAD	NEWPOS		/ MAKE NEW POSITION THE OLD ONE
	DCA	OLDPOS
	JMP I	VERT

VERT2,	TAD	(ESC		/ LOAD ESCAPE				/A148
	JMS	PRCHAR		/ OUTPUT IT				/A148
	TAD	VERTFG		/ GET FLAG--ZERO OR ONE			/A148
	TAD	("K&177)	/ THIS GENERATES A "K OR A "L		/A148
	JMS	PRCHAR		/ OUTPUT IT				/A148
	JMP	VERT1		/ RETURN TO LOOP			/A148

VERTFG,	0			/ 0 FOR "K, 1 FOR "L			/A148

VERTT1,	0


/ INITIALIZE ROUTINE FOR LQP02 JUSTIFICATION

PLINIT,	XX		/ LQP02 LINE JUSTIFY INIT ROUTINE		/A211
	OBPLIN=OVNUM+OVTYPE	/ BLOCK ID FOR THIS SUBROUTINE		/A211

	JMS	BHOOK		/ CALL CODE FOR PLINIT THROUGH BLASTR	/A271
	PLINIE			/ table entry for PLINA			/a271
/ now put the correct justification table in				/a271
	JMS	SKIPIF		/ check for an LQP03			/a271
	LQPSE								/a271
	JMP	PLIN1		/ no keep checking			/a271
	JMP	PLIN3		/ go get the table entry		/a271
PLIN1,	JMS	SKIPIF		/ check for an LQP02			/a271
	LQP03			/					/a271
	JMP	PLIN2		/ must be an LQPSE 			/a271
	IAC			/ ac=2 :: LQP03				/a271
PLIN2,	IAC			/ ac=1 :: LQP02				/a271
PLIN3,	TAD	(LQPTBE)	/ get the base table entry		/A271
	DCA	PLILQP		/ SAVE IT as a parameter		/a271
	JMS	BHOOK		/ call the blaster to load the table 	/a271
PLILQP,	0			/ put the table entry here		/a271
	
	JMP I	PLINIT		/ RETURN FROM PLINIT			/C211

/ THIS IS THE LOGIC TO DETERMINE WHICH TYPE B OVERLAY TO LOAD	/A243
/EITHER LQPSE, LQP02 NORMAL, OR LQP02 SQUISH...				/A243

PRJL9B,				/					/M227
	TAD	(OB2L10-OB3L10)	/ NORMAL JUSTIFICATION
	TAD	(OB3L10-OBJL10)	/ SQUISH LINE JUSTIFICATION
PRJL9C,	TAD	(OBJL10)	/ LQPSE
	DCA	PRJLBO		/ SAVE BLOCK OFFSET			/A143
	TAD	(OVJL10		/ (SAME AS OV2L10 AND OV3L10)		/A143
	JMS	PROV							/A143
PRJLBO,		XX		/	BLOCK OFFSET			/A143

/---------------------

	PAGE
	/XLIST   		/ TEST

OVTYPE=OLA
OVNUM=OVNUM+1
OVADR=OVADR+400
OVRLCA=PROVA+OVTYPE
DL=DLOPRO+OVNUM		/DISK BLOCK OF THIS OVERLAY
FIELD OVNUM%20+3

RELOC
*OVADR
RELOC OVRLCA

	-OVNUM
OVJUSD=.-OVRLCA
OBJUSD=OVTYPE+OVNUM

/THIS OVERLAY IS USED FOR MATRIX PRINTERS AND DD HOST

/THIS OVERLAY IS RESPONSIBLE FOR JUSTIFYING (IF NECESSARY) AND PRINTING
/THE LINE OF TEXT WHICH HAS BEEN ASSEMBLED IN PRLBUF BY PRGTLN
/EXTERNAL ARGUMENT USED BY JUSTIFICATION OVERLAYS:

/PLPTR - A POINTER INTO THE LINE BUFFER.  INITIALLY, IT POINTS AT THE LAST
/         CHARACTER IN THE LINE, WHICH IS THE RETURN.

/PRLBUF - A LITERAL WHICH IS THE ADDRESS OF THE BEGINNING OF THE BUFFER; IT
/         IS THE ADDRESS AT WHICH THE FIRST CHARACTER IS STORED.

/PRQPIT - THE PITCH VALUE.  IT IS ZERO IF PROPORTIONAL PITCH IS SPECIFIED,
/         NON-ZERO OTHERWISE.

/PRRM   - THE JUSTIFICATION FLAG.  IT IS ZERO IF THE LINE IS NOT TO BE
/         JUSTIFIED; OTHERWISE, IT THE LENGTH OF THE LINE IN PRINT UNITS.

/PLNRCS - CHARACTER SIZE.  IT IS THE SIZE OF A CHARACTER IN PRINT UNITS.

/PRCCH  - PRINT HEAD POSITION.  INITIALLY, IT IS THE POSITION THE PRINT
/         HEAD IS IN.

/SOME DEFINITIONS WILL MAKE THE COMMENTS EASIER TO FOLLOW:

/CHARACTER - ONE OF THE ASCII VALUES WHICH FILL THE LINE BUFFER.  THE
/     POSSIBLE CHARACTERS ARE BACK SPACE, TAB, SPACE, AND TEXT.  THE
/     LAST POSITION IN THE LINE BUFFER IS FILLED BY A RETURN, WHICH IS
/     NOT A CHARACTER.

/DEAD KEY SEQUENCE - A SEQUENCE OF TEXT DELIMITED BY BACK SPACES
/     (I.E., TEXT1 BS TEXT2 BS TEXT3).  SUCH SEQUENCES ARE PRINTED WITH
/     THE CHARACTERS SUPERIMPOSED.

/POSITION - ALL THE CHARACTERS WHICH MAP TO THE SAME PHYSICAL PLACE ON
/     THE PRINTED PAGE ARE SAID TO BE THE SAME POSITION.  THEREFORE,
/     ALL THE CHARACTERS IN A DEAD KEY SEQUENCE ARE A POSITION.  A CHARACTER
/     WHICH IS NOT PART OF A DEAD KEY SEQUENCE IS A POSITION.  IN THIS
/     CODE, WE JUSTIFY BY POSITIONS; WE FIND THE WIDTH OF POSITIONS.  IT
/     IS AN IMPORTANT CONCEPT.

/WIDTH - THE SPACE OCCUPIED BY A POSITION WHEN IT IS PRINTED.  IN
/     NON-PROPORTIONAL PRINTING, THE WIDTH IS STANDARD (PLNRCS).  IN
/     PROPORTIONAL PRINTING, THE WIDTH VARIES DEPENDING ON THE CHARACTERS
/     IN THE POSITION.

/TEXT - ANY PRINTABLE ASCII CHARACTER


/WE ALSO MAKE SOME ASSUMPTIONS:

/1.  THE ONLY CHARACTERS IN THE BUFFER ARE RETURN, BACK SPACE, TAB, SPACE,
/    AND TEXT.

/2.  THE ONLY PLACE BACK SPACES OCCUR ARE BETWEEN TEXT.

/ THIS OVERLAY IS USED FOR MATRIX PRINTERS AND DD HOST			/A211
/PLPTR currently addresses the return word in the buffer.  Bit 1 of this word
/is clear for a hard return and is set otherwise.  We save the type of the
/return for later use.

	AC2000			/GET A MASK FOR THE SOFT RETURN BIT
	AND I	PLPTR		/SEE IF SOFT RETURN
	DCA	PRJRET		/RECORD THE TYPE OF RETURN.
				/PRJRET=2000 FOR SOFT RETURN
				/PRJRET=0000 FOR HARD,CENTERING, OR PARA MARKER

	AC0001			/ INSURE PROPORTIONAL PRINTING OFF	/A219
	DCA	PLPFLG		/ PROPORTIONAL PRINTING OFF--OVJUSD	/A219

									/A080
	DCA	PLBOLD	/Reset SP PROPORTIONAL LQP02 flag.		/A086

/We now set up some variables in order to process the line.  We want the
/following conditions to hold:

/PLPTR - Points to the return character (this already holds)

/PLCNT - Is the negative of the number of characters, including the return,
/		in the line.

/PLDIR - Is minus one so that processing can proceed from right to left.

PRJD0A,								/A211
	TAD	PLPTR	/Subtract the address of the return, and one more
	CMA
	TAD   (PRLBUF)	/From the address of the first character
	DCA	PLCNT	/And save as the buffer count

	AC7777
	DCA	PLDIR	/Set the direction of printing


/If the line ends with a soft return, we now strip all trailing spaces, tabs,
/and backspaces from the line.  If the line ends with a hard return, we do
/not strip these characters.  We strip in case of soft return because the
/trailing spaces interfere with justification, and should not appear in case
/the line is underlined.  In either case, when the loop is over, the following
/conditions will hold:

/1.  PLPTR will point to the right most character of the line which should
/	be printed (which will be a text character in case of a soft return
/	and the one before the return for a hard return).

/2.  PLCNT will be the negative of the number of characters from the beginning
/	of the buffer to the character pointed to by PLPTR.

PRJD0,
	JMS	PLNXT	/Look at the next character
	JMP	PRGSL1	/No more characters so the line was all blank--no
			/need to bother printing the line

	TAD	PRJRET		/WAS IT A SOFT RETURN?
	SNA CLA
	JMP	PRJD1		/NO, NO NEED TO STRIP TRAILING SPACES

	TAD I	PLPTR	/Get the character
	AND	P177	/Strip the mode bits
	TAD	(-SPC)	/Is it a space/tab/backspace?
	SPA SNA CLA	/skip if positive AND non-zero
	JMP	PRJD0	/Yes--continue stripping the line

/The line was not blank and must be printed.  We now initialize some variables
/used to gather information about the line for printing and justification.

PRJD1,
	TAD	PLCNT
	DCA	PRLBCT	/Save the stripped size of the line

	DCA	PLPS	/Clear position justification spacing
	DCA	PLSS	/Clear space justification spacing

	AC7777
	DCA	PRJPOS	/Initialize number of inter-position spaces
	DCA	PRJSPC	/Clear number of spaces

	DCA	PRRCH	/Clear right end of line position
	DCA	PRPASS	/Clear the pass counter

	DCA	PRJDEF	/Clear deficiency (no justification required yet)/A080

/This loop gathers information about the spacing and composition of the
/line by processing the characters from left to right.  When the loop
/completes, we will know:

/PRRCH - The offset of the right end of the line from the left margin in
/		elementary print units.

/PRJPOS - The number of inter-position spaces in the justifiable portion
/		of the line.

/PRJSPC - The number of spaces in the justifiable portion of the line.

/The loop also marks each character in the justifiable portion of the line
/by setting bit 0 of the character.  The justifiable portion of the line is
/that part which follows the rightmost tab space.

	AC4000		/We first set the count enable flag.  This flag is
	DCA	PRJENB	/to mark justifiable characters and is examined when
			/deciding whether to count them.  It is ultimately
			/cleared when the first tab is encountered.

/At the beginning of each iteration, PLPTR points to the first character in a
/position.  Each iteration treats the entire position with all of its dead
/keys, if any.

PRJD2,
	TAD I	PLPTR	/Get the character
	AND	P177	/Strip the mode bits

	TAD	(-SPC)	/Is it a space?
	SZA CLA
	JMP	PRJD3	/No, a text--jump to treat it

/The character is a space.  If it is part of a tab, the enable flag must be
/cleared.  If the enable flag has not been cleared by this time, we increment
/the number of justifiable spaces and fall through to the text counter.

	TAD I	PLPTR	/Retrieve the space character
	CMA RAL		/AC0=0 if the space is part of a tab, 1 otherwise
	AND	PRJENB	/AC=4000 if counting should still be enabled

	SZA		/Do not count the space if we are disabled
	ISZ	PRJSPC	/Increment the space count if we are enabled
	DCA	PRJENB	/And save the new enable flag

/This section handles characters.  If the enable flag is set, we count the
/position.

PRJD3,
	TAD	PRJENB	/Get the enable flag
	SZA CLA		/If the flag is clear, don't count the position

	ISZ	PRJPOS	/Increment the number of inter-position spaces
	NOP		/In case it skips (since it is initialized to -1)


/ NOW GET THE WIDTH OF THE POSITION.  IN THE CASE OF THE DP OR HOST
/ WE CAN SIMPLY GET THE VALUE PLNRCS.  IF AND WHEN MATRIX PRINTERS
/ CAN DO PROPORTIONAL PRINTING WE WILL HAVE TO DO SOMETHING DIFFERENT,
/ POSSIBLY JMS PLSPCX AS IS DONE FOR LQPS

	TAD	PLNRCS	/GET POSITION WIDTH				/C211

	TAD	PRRCH	/Update the right end measure
	DCA	PRRCH

/We now enter a sub-loop which moves the buffer pointer to the first
/character of the next position.  It also marks each non-backspace character
/as justifiable or not with the enable flag.  When we reach the next position,
/we continue the main loop.  If we just treated the last position, we leave
/the main loop and continue with processing.

PRJD4,
	TAD I	PLPTR	/Get the character
	TAD	PRJENB	/Mark it with the enable flag
	DCA I	PLPTR	/Save the character back into the buffer

PRJD4A,	JMS	PLCHBS	/Are there more characters?
	JMP	PRJD5	/No--leave the loop
	JMP	PRJD4A	/YES, A multinational PRECEDENCE		/A271
	JMP	PRJD4A	/YES, A TECHNICAL PRECEDENCE			/A233
	JMP	PRJD4	/Yes, in this position--continue the inner loop
	JMP	PRJD2	/Yes, in a new position--continue the outer loop


PRJD5,		/THE LINE HAS BEEN COMPLETELY MEASURED

/THIS SECTION PRINTS LINES TO A DRAFT PRINTER.
/MULTIPLE HITS AND UNDERLINING ARE HANDLED
/BY MAKING MULTIPLE PASSES THROUGH THE LINE.

/First, we determine whether or not justification is needed.

	TAD	PRBIF		/ GET BOLD INTERPRETATION FLAG		/A152
	SZA CLA								/A152
	AC2000			/ MASK AC1				/A152
	CMA			/ EITHER CLEAR IT OR LEAVE ALONE	/A152
	DCA	PRBIFM		/ SAVE AS BIT MASK			/A152

	DCA	PLSSC		/ CLEAR THE JUSTIFICATION REMAINDER
	DCA	LPUPAS		/ ZERO THE PASS COUNTER FOR UNDERLINES

	TAD	PRJRET		/ IS IT A SOFT RETURN?
	SNA CLA
	JMP	DPLIN0		/ NO, NO JUSTIFICATION NEED BE DONE

	TAD	PRJSPC	/Are there any justifiable spaces?
	SNA CLA
	JMP	DPLIN0	/No--no justification can be done

	TAD	PRRM	/Does the ruler specify justification?
	SNA
	JMP	DPLIN0	/No--no need to do justification

/The AC now contains the desired justified line length.  We subtract that
/from the current line length to obtain the amount of deficiency.

	CIA
	TAD	PRRCH	/Subtract from  the current line length	
	SMA
	JMP	DPLIN0	/Line is already long enough or too long
	DCA	PRJDEF	/Save the negative of the deficiency

/We now divide the deficiency among the spaces.  The remainder is the negative
/of the number of additional space units which must be inerted, minus one.

	TAD	PRJSPC	/Divide the deficiency between the spaces
	JMS	PRDVID
	DCA	PLSS	/Save as the increased spacing to do

	TAD	PRJDEF	/Get the remainder
	DCA	PLSSC	/Save as the correction factor


DPLIN0,	CLA
	TAD	PRLBCT	/RESTORE THE CHARACTER COUNT FOR THE LINE
	DCA	PLCNT

	TAD   (PRLBUF)	/GET THE ADDRESS OF THE FIRST CHARACTER
	DCA	PLPTR	/INITIALIZE THE BUFFER POINTER

	TAD	PLSSC	/SAVE THE JUSTIFICATION REMAINDER
	DCA	LPSSC

	TAD	PLSS	/SAVE THE JUSTIFICATION VALUE
	DCA	LPSS

	AC0001
	DCA	PLDIR	/SET THE DIRECTION OF MOTION

/GO SET UP THE UPPER FIVE BITS IN THE EACH CHARACTER IN THE LINE.
/THIS MASSAGES EACH CHARACTER IN THE LINE AND SETS UP THE BITS FOR EACH
/CHARACTER'S ATTRIBUTES. THEY ARE AS FOLLOWS: BIT 0 IS FOR A JUSTIFIABLE SPACE
/WHICH MEANS IT MAY HAVE OTHER SPACES ADDED TO IT TO SPACE JUSTIFY A LINE.
/BITS 1 & 2 ARE THE HIT BITS. BIT 1 IS FOR BOLD, BIT 2 IS FOR DOUBLE DARK. THEY
/MEAN THAT A CHARACTER MIGHT BE HIT FROM 1 TO 4 TIMES DEPENDING ON THE BINARY
/COUNT IN BITS 1 & 2. 0 0 MEANING ONE HIT, 0 1 MEANS TWO HITS, 1 0 MEANS THREE
/HITS, AND 1 1 MEANS FOUR HITS. THIS IS FROM THE PRINT MENU (DA=DARK OR NORMAL)
/AND THE BOLD BIT FROM THE EDITOR.

/BITS 3 & 4 ARE DECODED AS FOLLOWS:
/ 0 0 IS NORMAL, 0 1 IS UNDERLINE, 1 0 IS SUPERSCRIPT, AND 1 1 IS SUBSCRIPT.

	JMS	DPLIN1

/NOW LOAD THE B OVERLAY WHICH CONTAINS THE SUBROUTINES,
/AND THE C OVERLAY WHERE THENCE WE SHALL GO....

	CLA		/GOING TO PROV WITH A CLEARED AC ONLY LOADS.
	JMS	PROV
		OBDPL1

	TAD	(OVDPL1
	JMS	PROV
		OBDPL2	/GO TO OVERLAY C

/THE FOLLOWING DPLN JUSTIFICATION VARIABLES MUST APPEAR IN THE FIRST	/A215
/OF THE DPLN JUSTIFICATION OVERLAYS TO AVOID FORWARD REFERENCES TO	/A215
/OVERLAY VARIABLES WHICH ARE NOT LOADED YET ...				/A215

LPSS,	0	/Saves the value of PLSS between passes
LPSSC,	0	/Saves the value of PLSSC  between passes
PLSSC,	0	/Remainder
LPPASS,	0	/After a pass, is non-zero if another pass is needed
LPUPAS,	0	/Pass # (used to count how many times to bold the undrlns)/A092
PRBIFM,	0	/ MASK FOR #DARKNESS PASSES IF PRBIF>0			/A152
SISOFG,	0	/SHIFT IN SHIFT OUT FLAG. SET WHEN NEEDED FOR CODE 23
CHGSET,	0	/FLAG FOR CHANGING TO ORIGINAL G SET AFTER PRINTING
TCHBLD,	0	/FLAG FOR TECH CHARACTERS AND ELIMINATING BOLD INTERPRETATION.
CURPOS,	0	/CURRENT POSITION. +1 UP 1/2; 0 IS ON LINE;-1 IS	/A222
		/DOWN A HALF OF A LINE					/A222
PPUNDL,	0	/UNDERLINE PRINTED FLAG
LBADR,	"B&177+4000
/---------------
	PAGE

/IN ORDER TO FACILITATE THE MULTIPLE PASS STRATEGY, THE MODE BITS OF
/EACH CHARACTER MUST BE REARRANGED.  UPON CALL, THE MODE BITS OF EACH
/CHARACTER ARE:

/AC  2  3			AC  4
/    0  0   NORMAL		    0     NOT BOLD
/    0  1   UNDERSCORE		    1     BOLD
/    1  0   SUPERSCRIPTED
/    1  1   SUBSCRIPT


/THE MODE SETTINGS WHICH THIS CODE UNDERSTANDS ARE:

/AC  0
/    0   THIS CHARACTER IS NOT A SPACE
/    1   THIS CHARACTER IS A REAL SPACE THAT IS JUSTIFIABLE

/AC  1  2
/    0  0   ONE HIT (NORMAL TEXT)
/    0  1   TWO HITS (NON-BOLDED, EXTRA DARK TEXT)
/    1  0   THREE HITS (BOLDED, NON-EXTRA DARK TEXT)
/    1  1   FOUR HITS (BOLDED, EXTRA DARK TEXT)

/NOTICE THAT, IN ESSENCE, AC1 IS THE BOLD BIT AND AC2 IS THE DARKNESS BIT.
/THE COMBINATION OF AC1 AND AC2 ARE CALLED THE HIT BITS; TAKEN TOGETHER,
/THEY INDICATED ONE LESS THAN THE NUMBER OF PASSES IN WHICH A CHARACTER
/SHOULD BE PRINTED TO OBTAIN THE DESIRED BOLDNESS/DARKNESS.


/THE COMBINATIONS OF AC BITS 3 AND 4 ARE FOR UNDERLINING, SUPERSCRIPTING,
/AND SUBSCRIPTING. THE COMBINATIONS ARE AS FOLLOWS;
/AC  3  4
/    0  0   NO SUBSCRIPT/SUPERSCRIPT, OR UNDERLINING.
/    0  1   UNDERLINE
/    1  0   SUPERSCRIPT
/    1  1   SUBSCRIPT

/THIS LOOP PROCESSES EACH CHARACTER IN THE LINE IN TURN AND REARRANGES ITS
/MODE BITS. IT PRESERVES BIT 0 WHICH WAS PREVIOUSLY DONE.

DPLIN1,	XX
DPLI1A,	DCA	MODBTS	/CLEAR THE MODE BITS OF THE WORD TO BE BUILT	/A215

/FIRST DO SUPER AND SUB BITS						/A215
	TAD I	PLPTR	/GET THE WORD FROM THE BUFFER
	AND	(1400)	/MASK OFF SUPER AND SUB BITS			/A215
	CLL RAR		/SLIDE THEM OVER TO THE RIGHT ONE POSITION	/A215
	JMS	ADDBTS	/ADD THEM TO MODBTS				/A215

/NOW DO DARKNESS BIT							/A215
	TAD	PRQOVP	/CHECK FOR DARKNESS FLAG			/A215
	SZA CLA		/SKIP IF NOT EXTRA DARK				/A215
	TAD	(1000)	/SET THE DARKNESS BIT				/A215
	JMS 	ADDBTS	/ADD THE DARKNESS BIT				/A215

/NOW DO BOLD BIT							/A215
	TAD I	PLPTR	/GET THE CHARACTER AND CHECK FOR BOLD		/A215
	AND	(200)	/BOLD BIT MASK					/A215
	R3L		/POSITION TO BIT 1				/A215
	JMS	ADDBTS	/ADD THE BOLD BIT				/A215

/NOW DO THE JUSTIFICATION BIT. SPACES WITH BIT 0 SET CONTRIBUTE TO
/JUSTIFICATION. KEEP BIT ZERO ONLY IF CHARACTER IS A SPACE.
	TAD I	PLPTR	/GET THE CHARACTER
	AND	P177
	TAD	(-SPC)
	SZA CLA
	JMP	DPLI1B	/NOT A SPACE
	TAD I	PLPTR	/GET BIT 0 BACK
	AND	(4000)
	JMS	ADDBTS

/NOW STRIP THE OLD MODE BITS AND INSTALL THE NEW MODE BITS		/A215
DPLI1B,	TAD I	PLPTR	/GET CHR BACK					/C215
	AND	P177	/STRIP OLD MODE BITS
	TAD	MODBTS	/GET NEW MODE BITS FROM ADDBTS			/A215
	DCA I	PLPTR	/SAVE THE NEW CHARACTER WITH THE MODE BITS	/C215

/WE HAVE NOW COMPLETELY PREPROCESSED THE CHARACTER.
/GET ANOTHER AND CONTINUE THIS LOOP
	JMS	PLNXT	/POINT TO THE NEXT CHARACTER
	JMP I	DPLIN1	/THERE ARE NO MORE--LEAVE THE LOOP		/C117
	JMP	DPLI1A	/CONTINUE THE LOOP

ADDBTS,	XX
	TAD	MODBTS
	DCA	MODBTS	/EXIT WITH CLEAR AC
	JMP I	ADDBTS

MODBTS,	0	/STORAGE FOR MODEBITS

/RESET POINTERS FOR THE PRINT LINE

LPRSTP,	TAD	PRMCLM	/GET CURRENT MULTICOLUMN MARGIN			/A212
	JMS	LPIND	/INDENT THE MARGIN				/A143

	TAD	LPSSC	/RESET THE EXTRA JUSTIFY SPACE COUNT
	DCA	PLSSC

	TAD	LPSS	/RESET THE JUSTIFICATION VALUE
	DCA	PLSS

	TAD   (PRLBUF)	/RESET THE POINTER TO THE BEGGINING OF THE BUFFER
	DCA	PLPTR

	TAD	PRLBCT	/RESET THE CHARACTER COUNT
	DCA	PLCNT

	DCA	LPPASS	/CLEAR THE NEXT PASS DETECTION TEMPORARY--IF THIS
			/IS NON-ZERO AT THE END OF THE PASS, ANOTHER PASS
			/IS NECESSARY
	DCA	TCHBLD	/CLEAR THIS FLAG
	JMP	DPLIN3

/HERE FOR A CONTROL CHARACTER 21. SEE IF TEXT IS TO HOST. IF SO, THEN
/GET NEXT CHARACTER AND PRINT IT. IF NOT, CHECK FOR PROPER "G" SET SELECTED.
/IF LOCATION PCHBFO CONTAINS EITHER AN ASCII "A" OR "B", THEN PRINT
/SO,CHR,SI. IF PCHBFO DOES NOT CONTAIN EITHER "A" OR "B", THEN CHANGE TO
/B SET, PRINT SO,CHR,SI, AND RETURN TO THE OLD CHARACTER SET.

/CHECK TO SEE IF NEXT CHARACTER HAS UNDL ATTRIBUTES.
/IF SO THEN DON'T DO A THING UNTIL UNDERLINE HAS GONE.

DPLI4E,	JMS	SKNHST	/SKIP IF NOT HOST				/A235
	JMP	DPLI4M	/IS HOST					/A235

	JMS	NCFNDL
	JMP	DPLIN9	/RETN 1:  IS UNDERLINE DON'T CHANGE G SET.
	TAD	PCHFBO	/RETN 2:  NO UNDL  SEE IF CHARACTER SET CHANGE IS NEEDED.
	TAD	(-"B+200) /IF CHARACTER IS B OR A, THEN NO CHANGE NEEDED.
	SZA
	IAC
	SNA CLA
	JMP	DPLI4F	/IS A. OR B. AS ABOVE

	AC7777		/SET FLAG TO INDICATE THAT WE HAVE CHANGED.
	DCA	CHGSET
	TAD	(LBADR)	/HAVE TO CHANGE.
	JMS	PRESCS
		PCSTG1
DPLI4F,	AC7777
	DCA	SISOFG	/SET FLAG TO SPAN CHARACTER WITH SO,CHR,SI
	JMP	DPLIN8	/EXIT AND DECREMENT THE HIT BITS

DPLI4M,	JMS	PGCHAR	/GET NEXT CHARACTER				/A235
	TAD	(-57)	/MAGIC NUMBER TO TRANSFORM THE GNOME TO A DWARF	/A235

DPLI4J,	AND	P377	/MAKE 7 BITS					/MRCM/A235
	JMS	PRCHAR							/A235
	JMP	DPLIN9	/EXIT TO NEXT ONE.				/A235

/HERE IF CODE 22

DPLI4C,	JMS	SKNHST	/SKIP IF NOT HOST				/A234
	JMP	DPLI4N	/YES						/A234

DPLI4G,	JMS	NCFNDL
	JMP	DPLIN9	/RETN 1:  IS UNDERLINE DON'T CHANGE G SET.
	TAD I	PLPTR	/RETN 2:  NO UNDL  SEE IF CHARACTER SET CHANGE IS NEEDED.
	AND	P177	/MASK OFF MODE BITS
	TAD	(XSSS2-22)
	JMS	PRESCS
		PCSS	/CHANGE TO G2 OR G3
	CLA
	JMP	DPLIN8	/EXIT AND DECREMENT THE HIT BITS

DPLI4N,	JMS	PGCHAR	/GET CHARACTER					/A234
	JMS	PSETP	/ADJUST BUFFER ADDRESS				/A234
	SNA CLA								/A234
	JMP	DPLI4K							/A234
	TAD I	T1	/GET ADDRESS OF CHAR IN BUFFER			/A234
DPLI4D,	DCA	T1							/A234
DPLI4K,	TAD I	T1	/GET CHARACTER					/A234
	JMP	DPLI4J	/PRINT IT.					/A234

/HERE IF CODE 23

DPLI4H,	JMS	SKNHST	/SKIP IF NOT HOST				/A234
	SKP								/A234
	JMP	DPLI4G	/NO						/A234

	JMS	PGCHAR							/A234
	JMS	PSETP	/ADJUST BUFFER ADDRESS				/A234
	SNA CLA								/A234
	JMP	DPLI4K	/CHARACTER					/A234
	TAD I	T1	/GET ADDRESS OF CHARACTER			/A234
	IAC		/BUT WHAT WE NEED IS NEXT LOCATION		/A234
	JMP	DPLI4D							/A234
/---------------
	PAGE

	OVTYPE=OLB
OVNUM=OVNUM+1
OVADR=OVADR+400
OVRLCA=PROVA+OVTYPE
DL=DLOPRO+OVNUM		/DISK BLOCK OF THIS OVERLAY
FIELD OVNUM%20+3

RELOC
*OVADR
RELOC OVRLCA

	-OVNUM
OVDPL1=.-OVRLCA
OBDPL1=OVTYPE+OVNUM

LPSUPR,	TAD	CURPOS	/SEE IF REPOSITIONING NEEDED			/A222
	SPA		/IF +1, NOT NEEDED, IF 0, GO UP 1;IF -1, GO UP 2/A222
	JMS	MOVEUP	/GO UP TWO BECAUSE NOW AT SUBSCRIPT POSITION	/A222
	SZA CLA		/ARE WE THERE ALREADY?				/A222
	JMP	DPLIN5	/YES, EXIT AND PRINT CHARACTER			/A222
	JMS	MOVEUP	/MOVEUP CLEARS AC SO DO IT AGAIN		/A222
	JMP	DPLIN5	/EXIT AFTER TWO HALF MOVES UP.			/A222

LPSUB,	TAD	CURPOS	/SEE IF WE NEED TO GO DOWN THE PAGE		/A222
	SPA		/+1, DOWN 2; 0, DOWN 1; -1, ALREADY THERE	/A222
	JMP	DPLIN5	/EXIT						/A222
	SZA		/DOWN 1 OR 2					/A222
	JMS	MOVEDN	/GO DOWN ONE HALF LINE				/A222
	JMS	MOVEDN	/GO DOWN ANOTHER HALF LINE			/A222
	JMP	DPLIN5	/EXIT						/A222

MOVEDN,	XX		/MOVE DOWN ONE HALF LINE			/A222
	AC7777		/SUBTRACT ONE FROM CURRENT POSITION		/A222
	TAD	CURPOS							/A222
	DCA	CURPOS	/CORRECTED BY SUBTRACTING 1			/A222
	JMS	PRESCS	/CALL TO WPRINT					/A222
		PCPLD	/ESCAPE SEQUENCE AND MOVE DOWN			/A222
	CLA
	JMP I	MOVEDN	/EXIT						/A222

MOVEUP,	XX								/A222
	AC0001
	TAD	CURPOS	/GET CURRENT POSITION				/A222
	DCA	CURPOS	/TRIPLE PRECISION FLOATING DEPOSIT		/A222
	JMS	PRESCS	/CALL TO WPRINT					/A222
		PCPLU	/UP						/A222
	CLA
	JMP I	MOVEUP	/EXIT						/A222

CFUNDL,	XX
	TAD I	PLPTR
	AND	(0200)	/MASK UNDL BIT AND SUB BIT.
	SNA CLA
	JMP	CFUND1	/NO UNDERLINE, RETURN +2
	TAD I	PLPTR	/MAYBE UNDERLINE OR SUB
	AND	(0400)	/LOOK AT SUB BIT
	SZA CLA
CFUND1,	ISZ	CFUNDL	/BUMP RETURN TO +2. NO UNDERLINE ATTRIBUTES ON CHAR.
	JMP I	CFUNDL	/EXIT EITHER PLUS 1 OR 2

/THIS IS THE CHECK FOR UNDERLINE SUBROUTINE. IF THE SUCCEEDING CHARACTER IN
/THE LINE HAS AN UNDERLINE ATTRIBUTE, THEN TAKE NORMAL EXIT. IF NO UNDERLINE
/ATTRIBUTE, THEN TAKE EXIT +2.

NCFNDL,	XX		/CHECK NEXT CHARACTER FOR UNDERLINE ATTRIBUTES.
	AC7776		/SET SWITCH TO -2
	DCA	TCHBLD	/FOR A CONTROL CHARACTER, TECH CHARACTER COMBINATION
	ISZ	PLPTR	/IF RETURN +1, YES; IF RETURN +2, NO.
	JMS	CFUNDL
	SKP		/YES, UNDL ATTRIBUTES
	ISZ	NCFNDL	/NO UNDL ATTRIBUTES
	AC7777		/BACK POINTER UP
	TAD	PLPTR
	DCA	PLPTR
	JMP I	NCFNDL

/HERE TO PRINT UNDERLINES.
/PRINT THE UNDERLINE WHEN ENCOUNTERED UNTIL THE HIT COUNT EQUALS THE
/NUMBER IN "LPUPAS". LPUPAS STARTS AT ZERO AND INCREMENTS AT THE END OF
/EACH LINE. WHEN THE HIT COUNTS EQUAL THE COUNT IN LPUPAS, THEN REMOVE
/THE UNDERLINE ATTRIBUTE FROM THE CHARACTER AND CONTINUE ON NORMALLY.

PUNDL,	TAD	(UNDL)
	MQL		/LOAD MQ WITH UNDL, THE CONTENTS OF THE MQ GET PRINTED
	AC7777
	DCA	PPUNDL	/SET FLAG THAT SAYS WE PRINTED AN UNDERLINE
	TAD I	PLPTR	/NOW CHECK THE HIT COUNT AGAINST LPUPAS
	AND	(3000)	/MASK HIT BITS
	R3L		/PUT TO BITS 10,11
	CMA IAC		/NEGATE
	TAD	LPUPAS
	SZA CLA		/SKIP IF EQUAL
	JMP	PUNDL1	/NOT EQUAL, CONTINUE TO NEXT CHARACTER		/C246
	TAD I	PLPTR	/HITS EQUAL LPUPAS
	AND	(7577)	/REMOVE UNDERLINE ATTRIBUTE
	DCA I	PLPTR	/PUT BACK STRIPPED CHARACTER

PUNDL1,	DCA	PRBIC	/CLEAR BOLD INTERPRETATION FLAG			/A246
	TAD	PRBIF	/THIS IS TO GET THE CORRECT UNDERLINE IN THE	/A246	
	SZA CLA		/CORRECT FONT. MUST CHANGE FONTS IF NECESSARY	/A246
	JMS	LPBI							/A246
	JMP	DPLI5D							/A246

/THESE ROUTINES ARE USED TO SPAN A CHARACTER WITH SO,CHR,SI

/PRINT SHIFT OUT ROUTINE

PRSO,	XX		/CHECK TO SEE IF PRINT SO, CHAR, SI
	TAD	SISOFG	/IS SO,CHR,SI FLAG SET?
	SNA CLA
	JMP	PRSO1
	TAD	(SO)	/GET SHIFT OUT
	JMS	PRCHAR
PRSO1,	CLA
	JMP I	PRSO

PRSI,	XX		/DID WE PRINT SO?
	TAD	SISOFG
	SNA CLA
	JMP I	PRSI	/NO JUST EXIT

	TAD	(SI)	/GET SHIFT IN.
	JMS	PRCHAR
	CLA
	DCA	SISOFG	/CLEAR THE FLAG THAT GOT US HERE.
	TAD	CHGSET	/SEE IF WE MUST RESTORE THE OLD G SET.
	SNA CLA
	JMP I	PRSI	/NO EXIT

	DCA	CHGSET	/CLEAR IT
	TAD	(PCHFBO)
	JMS	PRESCS
		PCSTG1
	CLA
	JMP I	PRSI	/EXIT

PSETP,	XX								/A235
	AND	P177	/ADJUST CHARACTER TO SEVEN BITS			/A235
	TAD	(TCKBTB-41)	/ADJUST ADDRESS TO BEGINNING OF TABLE	/A235
	DCA	T1							/A235
	TAD I	T1							/A235
	AND	(7400)	/SEE IF IT IS THE CHARACTER OR AN ADDRESS	/MRCM/A235
	JMP I	PSETP							/A235
/------------------------
	PAGE

/***********************************************************************/
/									/
/	TCKBTB--TECHNICAL CHARACTER TO KEYBOARD CONVERSION TABLE	/
/		USED TO CONVERT TECHNICAL CHARACTERS BACK TO THE	/
/		ASCII KEY CODE WHICH WAS TYPED WHEN THEY WERE INSERTED	/
/		INTO THE WPS DOCUMENT.  USED WHEN DD=CHST, REAL HOST	/
/		APPLICATION.						/
/									/
/		NOTE THAT THERE ARE 94 ENTRIES IN THIS TABLE IN		/
/		THE RANGE FROM 41-176 OCTAL				/
/									/
/		THE LOGIC LOOKS AT THE PRECEDENCE CODE.			/
/		IF IT IS 21, SUBTRACT 57 AND OUTPUT THE NEXT CHARACTER.	/
/		IF IT IS 22 OR 23 IT READS THIS TABLE./
/		IF THE ENTRY FOUND IS AN ASCII CHR IT JUST OUTPUTS	/
/		THAT CHR.						/
/		IF THE ENTRY FOUND IS GREATER THAN 377 IT IS A POINTER	/MRCM
/		TO A TWO WORD TABLE.  THE FIRST WORD IS THE CHARACTER	/
/		TO OUTPUT IF THE PRECENCE CODE WAS 22, THE SECOND WORD	/
/		IS THE CHARACTER TO OUTPUT IF THE PRECENCE CODE WAS 23.	/
/									/
/***********************************************************************/

