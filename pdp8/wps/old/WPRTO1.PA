	TAD	PLPS		/ ACCUMULATE EXTRA DECIPOINTS/6
	TAD	PRTWDP
	DCA	PRTWDP
	ISZ	PRMODE		/ BUMP RETURN ADDRESS
PRMTW1,	DCA	UNDERL		/ RESET UNDERLINE
	JMP	PRNT2		/ GO SEE IF NEED SUPER/SUB/UNDERL SEQS

PRTWPN,		/ TWO WHEEL, PROPORTIONAL, NOT PRINTING
/	AC7777			/ FORCE CODE TO DISABLE HAMMER
/	CLL			/ CLEAR BOLD ATTRIBUTE
	AC7777 CLL
	SKP			/ NO TWHOP IF PPNL			/A242

PRNT1,
	JMS	PRTWH		/ GO OUTPUT ANY TW HOP STUFF		/A116

