////////////////////////////////////////////////////////////////
/	THE FOLLOWING EITHER SETS OR RESETS THE UNDERLINE FLAG
/
SETUND,
	JMS	VERT	/ ACC = 0, SELECT 0
/									/D046
	TAD	UNDERL		/ IF UNDERLINE = OFF
	SNA CLA
	DCA	NEWMOD		/ THEN CHANGE PRINT MODE
	IAC			/ AND SET UNDERLINE = ON
	JMP	DOPRNT		/ AND DO PRINTING

SUBSC,	IAC			/ NEWPOS WILL BE SELECT 2
SUPER,	IAC			/ NEWPOS WILL BE SELECT 1
NORMAL,	JMS	VERT		/ SELECT 0 VERTICAL
RSTUND,
/									/D046
	TAD	UNDERL		/ IF UNDERLINE = ON
	SZA CLA
	DCA	NEWMOD		/ THEN CHANGE PRINT MODE
DOPRNT,
	DCA	UNDERL		/ AND SET/RESET UNDERLINE
/									/D046
PRINT,
	TAD	PRMODB		/ GET THE CHARACTER
	BSW			/ AND PUT THE BOLD BIT INTO THE LINK
	RTR
	CLA
	TAD	PRQ2W		/ GET THE TWO WHEEL FLAG
	SNA			/ IF AC=0, NO TWO WHEEL
	JMP	PRNT1		/ JUMP TO HANDLE REGULAR PRINTING
	SMA CLA
	CML			/ SECOND PASS--CM LINK AND TWO CASES
				/ BECOME IDENTICAL
	SNL			/ SKIP IF WE DON'T NEED TO PRINT THIS PASS/C116
	JMP	PRNT1		/ TW MODE, PRINTING

/***********************************************************************/
/									/
/	PRMTWN--TWO WHEEL, NOT PRINTING					/
/		A SECTION OF CODE ADDED TO SPEED UP TWO WHEEL		/
/		PRINTING IN THE MONOSPACE CASE (NOT THEME OR		/
/		PROPORTIONAL MODE)					/
/									/
/		PART OF PRMODE ROUTINE A116				/
/									/
/***********************************************************************/

		/ PRMODE, TW NOT PRINTING
	TAD	PLPFLG		/ GET PROPORTIONAL FLAG
	SNA CLA
	JMP	PRTWPN		/ IS PROPORTIONAL, NOT PRINTING

		/ TWO WHEEL, NOT PRINTING,  NOT PROPORTIONAL
	TAD	PRMODB		/ GET THE CHARACTER
	TAD	(-SPC)		/ SEE IF SPACE				/C258
	AND	P177		/ MASK MODE BITS			/A258
	SNA CLA			/ SKIP IF NOT SPACE
	JMP	PRMTW1		/ IS SPACE, PRINT BUT DON'T UNDERLINE
				/ THIS SPACE WILL BE OUTPUT
	ISZ	PRTWHC		/ INCREMENT THE HOP COUNT
				/ FOR THIS NON PRINTING NON SPACE CHR
	TAD	PLPS		/ ACCUMULATE EXTRA DECIPOINTS/6
	TAD	PRTWDP
	DCA	PRTWDP
	ISZ	PRMODE		/ BUMP RETURN ADDRESS
PRMTW1,	DCA	UNDERL		/ RESET UNDERLINE
	JMP	PRNT2		/ GO SEE IF NEED SUPER/SUB/UNDERL SEQS

PRTWPN,		/ TWO WHEEL, PROPORTIONAL, NOT PRINTING
/	AC7777			/ FORCE CODE TO DISABLE HAMMER
/	CLL			/ CLEAR BOLD ATTRIBUTE
	AC7777 CLL
	SKP			/ NO TWHOP IF PPNL			/A242

PRNT1,
	JMS	PRTWH		/ GO OUTPUT ANY TW HOP STUFF		/A116

/ THE FOLLOWING INSTRUCTION IS RISKY SINCE PRTWH CALL PRESCS ETC.
/LINK COULD BE CLOBBERED IN THESE ROUTINES...
	RAL			/ GET HIT COUNT
	TAD	PRQOVP		/ ADD IN THE DARKNESS VALUE
	DCA	NEWHIT		/ SAVE AS NEW BOLD MODE			/A046
	TAD	NEWHIT		/ GET IT BACK				/A046
	TAD	OLDHIT		/ COMPARE AGAINST OLD BOLD MODE		/A046
	SZA CLA
	DCA	NEWMOD		/ IF DIFFERENT, DO ESCAPE STRING	/A046
/									/D046
PRNT2,	TAD	NEWMOD		/
	SZA CLA			/ IF NEWMOD=0, THEN HAVE TO CHANGE MODE
	JMP I	PRMODE		/ NO CHANGE, RETURN			/C116
	ISZ	NEWMOD		/ ELSE DO : FLAG CHANGE MADE
	TAD	NEWHIT		/          GET NEW MODE
	JMS	PRESCS		/          SEND IT
		PCBOLD
	CIA			/          MAKE NEGATIVE FOR NEXT COMPARE
	DCA	OLDHIT		/ SAVE NEW HIT CNT AS OLD HIT COUNT
	JMP I	PRMODE		/ EXIT

/***********************************************************************/
/									/
/	PRTWH---IF ARE IN TW AND THERE IS HOPPING TO BE DONE		/
/		THEN PRTWHC WILL BE NONZERO, SO WE MUST COMMAND		/
/		THE LQP02 OF SOME HORIZONTAL MOTION.  IF WE ARE		/
/		JUSTIFYING THIS LINE THEN PRTWDP MAY OR MAY NOT		/
/		BE ZERO DEPENDING ON HOW THE JUSTIFICATION ALGORTHM	/
/		CAME OUT.  IF PRTWHC IS ZERO THEN PRTWDP IS ZERO.	/
/									/
/***********************************************************************/

PRTWH,	XX			/A116
	CLA RAL			/ GET LINK				/A258
	DCA	PRSAVL		/ SAVE LINK				/A258
	TAD	PRTWHC		/ GET HOP COUNT
	SNA			/ SKIP OUTPUT IF ZERO
	JMP	PRTWHX		/ GO RESTORE THE LINK!			/A262
	JMS	PRESCS		/ ELSE OUTPUT ACCUMULATE HOP AMOUNT
		PCMRT		/
	CLA
	DCA	PRTWHC		/ CLEAR THE COUNT
	JMS	PRESCS
		PCSPUM		/ SET PUM MODE
	TAD	PRTWDP		/ GET DECIPOINT/6 COUNT
	TAD	PRTWDP		/ AND TURN IT INTO
	TAD	PRTWDP
	CLL RAL			/ DECIPOINTS BY MULT BY SIX
	JMS	PRESCS		/ AND OUTPUT EXTRA DECIPOINT MOVEMENT
		PCMRT
	CLA
	DCA	PRTWDP		/ RESET EXTRA DECIPOINT COUNT		/A258
	JMS	PRESCS		/ AND RESET PUM MODE
		PCRPUM
PRTWHX,									/A262
	TAD	PRSAVL		/ GET SAVED LINK			/A258
	CLL RAR			/ RESTORE LINK				/A258
	JMP I	PRTWH		/ AND RETURN

PRSAVL,	0			/ STORAGE FOR LINK			/A258

PRTWHC,	0			/ NUMBER OF PRINTABLE CHARACTER UNITS TO HOP OVER

PRTWDP,	0			/ EXTRA DECIPOINTS/6 TO HOP OVER
/-------------------
