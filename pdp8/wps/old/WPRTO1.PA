	DCA	NEWMOD		/ THEN CHANGE PRINT MODE
DOPRNT,
	DCA	UNDERL		/ AND SET/RESET UNDERLINE
/									/D046
PRINT,
	TAD	PRMODB		/ GET THE CHARACTER
	BSW			/ AND PUT THE BOLD BIT INTO THE LINK
	RTR
	CLA
