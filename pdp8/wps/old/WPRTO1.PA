	SZA CLA			/ IF NEWMOD=0, THEN HAVE TO CHANGE MODE
	JMP I	PRMODE		/ NO CHANGE, RETURN			/C116
	ISZ	NEWMOD		/ ELSE DO : FLAG CHANGE MADE
	TAD	NEWHIT		/          GET NEW MODE
	JMS	PRESCS		/          SEND IT
		PCBOLD
	CIA			/          MAKE NEGATIVE FOR NEXT COMPARE
	DCA	OLDHIT		/ SAVE NEW HIT CNT AS OLD HIT COUNT
