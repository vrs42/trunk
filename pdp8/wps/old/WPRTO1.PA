OVTYPE=OLB
OVNUM=OVNUM+1
OVADR=OVADR+400
OVRLCA=PROVA+OVTYPE
DL=DLOPRO+OVNUM		/DISK BLOCK OF THIS OVERLAY
FIELD OVNUM%20+3

RELOC
*OVADR
RELOC OVRLCA

	-OVNUM


/***********************************************************************/
/									/
/	OVCTR2--LQP02/03 CENTERING JUSTIFICATION OVERLAY		/
/									/
/***********************************************************************/

OVCTR2=.-OVRLCA		/ LQP02/03 CENTERING JUSTIFICATION OVLY		/A243
OBCTR2=OVTYPE+OVNUM

/ FIRST OUTPUT THE NON JUSTIFIABLE PART OF THE LINE.  WE NEED TO DO THIS
/ INCASE THE LINE CONTAINS TABBED TEXT, WHICH WILL BE TABBED RATHER THAN
/ JUSTIFIED.


	AC0001
	JMS	PLREST		/ RESET BUFFER VARIABLES FOR SCAN
	DCA	UNDERL		/ RESET UNDERLINE FLAG
	DCA	OLDPOS		/ CLEAR THE SUPER/NORMAL/SUBSCRIPT
	DCA	NEWMOD		/ RESET THE NEW MODE FLAG
	AC0001			/ WE START IN COLUMN ONE
	DCA	CTRPSN		/ RESET THE POSITION COUNTER

/IF THERE ARE NO TAB SPACES WE MUST DETECT THIS AND DO OUR POSITIONING
/IMMEDIATELY

	TAD	SOFTPT		/ SEE IF ANY TAB SPACES
	SNA CLA
	JMP	CTRIN5		/ NO, GO OUTPUT POSITIONING COMMAND

CTRIN1,	ISZ	CTRPSN		/ COUNT THIS POSITION
CTRIN2,				/ HERE IF NOT 1ST CHR OF DEAD KEY SEQ	/A265
	TAD I	PLPTR		/
	AND	(2177)		/ MASK MODE BITS 0,2,3,4		/A254
	TAD	(-TSPC)		/ SEE IF A TAB SPACE
	SNA CLA			/
	JMP	CTRIN4		/ IS TAB SPACE
	TAD I	PLPTR		/ GET THE CHARACTER
	JMS	TCLQP		/ CHECK FOR & PROCESS TECHNICAL CHRS
	JMS	PRMODE		/ PROCESS THE MODE BITS
				/ SKIP NEXT INSTRUCTION IF TW HOP
	JMS	PR2TST		/ PRINT THE CHR

CTRIN3,			/LABEL TO PROCESS NEXT CHR			/A239
	JMS	PLCHBS		/ ARE THERE MORE CHARACTERS?
	JMP	CTRINX		/ NO, WRAP UP THE LINE
	JMP	CTRIN1		/ YES, A multinational PRECEDENCE CHR	/A271
	JMP	CTRIN1		/ YES, A TECHNICAL PRECEDENCE CHR	/A233
	SKP			/ YES, IN THE SAME POSITION
	JMP	CTRIN1		/ YES, IN A NEW POSITION
	TAD	(BS		/ SEND A BACKSPACE
	JMS	PRCHAR
	JMP	CTRIN2		/ PART OF DEAD KEY SEQUENCE		/C265

CTRIN4,			/TAB SPACE SEEN					/A239
	TAD I	PLPTR		/ GET THE CHARACTER			/A256
	JMS	PRMODE		/ RESET MODE BEFORE TEST FOR TAB SPACE	/A256
	NOP			/ MAYBE TW YES				/A256
	TAD	CTRPSN		/ GET CURRENT COLUMN POSITION
	TAD	PRMCMG		/ ADD INDENT VALUE IN COLUMNS
	JMS	PRESCS		/ POSITION HEAD TO THIS COLUMN
		PCCOLA		/ ABSOLUTELY
		CLA

/ WE CHECK TO SEE IF WE HAVE REACHED THE LAST TAB SPACE.  IF SO IT
/ IS TIME TO ISSUE THE CENTERING POSITIONING COMMAND.  AFTER THAT
/ WE WILL AGAIN OUTPUT THE LINE USING THE SAME LOGIC UNTIL DONE

	TAD	PLPTR		/ COMPARE BUFFER POINTER
	CIA
	TAD	SOFTPT		/ WITH POINTER TO LAST TAB SPACE
	SZA CLA			/ SKIP IF TIME TO CENTER
	JMP	CTRIN3		/ NO, JUST GO BACK

/ WE HAVE FOUND THE RIGHTMOST TAB SPACE.  NOW DETERMINE IF WE HAVE
/ENOUGH ROOM TO CENTER.  IF THE MEASURED LENGTH OF THE LINE EXCEEDS
/OUR MEASURED WIDTH, TOUGH LUCK, WE WILL JUST VIOLATE THE RIGHT MARGIN

/IT WOULD BE NICE TO USE PUM MODE TO PERFORM THE CENTERING CALCULATION
/BUT THAT IT NOT PRACTICAL UNLESS WE INVENT SOME DOUBLE PRECISION
/MULTIPLY AND ASCOUT ROUTINES FOR THAT, SINCE THE MAX PN IN PUM MODE
/IS 720 TIMES THE LENGTH OF THE CARRIAGE IN INCHES ... 9510 FOR LQP02,
/MUCH MORE FOR A WIDE TRACK PRINTER
/THUS WE WILL ATTEMPT TO CENTER ONLY TO THE NEAREST COLUMN

CTRIN5,	TAD	PRRCH		/ GET THE LENGTH OF THE JUSTFBL PORTION
	CIA			/ NEGATE
	DCA	PRJDEF		/ PASS DIVIDEND TO PRDVID
	TAD	PLNRCS		/ GET DIVISOR
	JMS	PRDVID		/ DIVIDE
	CIA			/ NEGATE QUOTIENT
	DCA	PRJDEF		/ SAVE HERE TEMPORARILY

/SEE IF THERE IS A CENTERING MARK IN THE RULER.  IF SO USE A
/SLIGHTLY DIFFERENT CALCULATION...

	TAD	RULRCM		/ SEE IF THERE IS A CENTERING MARK
	SNA
	JMP	CTRIN6		/ NO CENTERING MARK IN RULER

	TAD	RULRCM		/ ADD IN A 2ND COPY
	JMP	CTRIN7		/ JUMP AHEAD

CTRIN6,	TAD	RULRLM		/ GET LEFT MARGIN IN COLUMN UNITS
	TAD	RULRRM		/ ADD RIGHT MARGIN IN COLUMN UNITS
CTRIN7,	TAD	PRJDEF		/ GET NEGATIVE WIDTH OF LINE IN COLUMNS
	SPA
	CLA			/ HERE IF NOT ENUF SPACE
	CLL RAR			/ DIVIDE BY 2 DISCARD REMAINDER
	TAD	PRMCMG		/ GET MULTICOLUMN MARGIN IN COLUMNS
	IAC			/ PRINT IN THE NEXT COLUMN!
	JMS	PRESCS		/ ABSOLUTLY POSITION TO THIS POSITION
		PCCOLA		/ IN PRINT UNITS
		CLA
	JMP	CTRIN3		/ GET NEXT CHR

CTRINX,
	JMS	PRMODE	/ADJUST ANY SUPER/SUBSCRIPT V-SPACE
	NOP			/ THIS LOCATION SKIPPED IF TW HOP
	DCA	PRTWHC		/ CLEAR ANY UNEXECUTED HOP AT END OFLINE
	DCA	PRTWDP		/ AND ANY ACCUMULATED EXTRA DECIPOINTS
	TAD	(CR)		/ Transmit a carriage return
	JMS	PRCHAR
	JMP	PRGSL1		/ LINE COMPLETE - DO VERTICAL SPACING

CTRPSN,	0			/ COUNTER FOR TAB SPACE POSITIONS


IFZERO .-TCLQP&4000 <TOO MUCH CODE ABOVE>
	*TCLQP	/FOR TEMPLATE MATCH					/A243
TCLQP,	XX			/ CHECK FOR & PROCESS TECH CHR		/A233
				/ CHAR TO PROCESS IS IN AC
				/ IF A TECH PRECENCE CHR THEN IGNORE IT,
				/ AND REPLACE

	AND	P177		/ MASK
	TAD	(-23)		/ SEE IF A TECH PRECEDENCE CHR
	SNA			/ test for technical precedence char	/a271
	JMP	WASTEC		/ go deal with it			/a271
	IAC			/ increment to test for multinational char/a271
	SNA			/ was it a multinat precedence char	/a271	
	JMP	WASMUL		/ was go deal withit			/a271
	IAC			/ increment to test for line drawing	/a271			
				/ precedence char			/a271
	SNA CLA			/ skip if no multec char found		/a271
	JMP 	WASTEC		/ jump if it was line precedence char	/a271
TCLQPX,	TAD I	PLPTR		/ RELOAD CHR				/a271
	JMP I	TCLQP		/ AND RETURN				/a271

WASMUL,	AC7777			/ set ac to flag mutinational		/a271
WASTEC,	JMS	BHOOK		/ call the blastr routine		/a271
	MCLQPE			/ to load reqd space or 8 bit char	/a271
	JMP	TCLQPX		/ exit					/a271
/-------------------
