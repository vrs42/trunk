/***********************************************************************/

		/ PRMODE, TW NOT PRINTING
	TAD	PLPFLG		/ GET PROPORTIONAL FLAG
	SNA CLA
	JMP	PRTWPN		/ IS PROPORTIONAL, NOT PRINTING

		/ TWO WHEEL, NOT PRINTING,  NOT PROPORTIONAL
	TAD	PRMODB		/ GET THE CHARACTER
	TAD	(-SPC)		/ SEE IF SPACE				/C258
	AND	P177		/ MASK MODE BITS			/A258
	SNA CLA			/ SKIP IF NOT SPACE
	JMP	PRMTW1		/ IS SPACE, PRINT BUT DON'T UNDERLINE
				/ THIS SPACE WILL BE OUTPUT
	ISZ	PRTWHC		/ INCREMENT THE HOP COUNT
