	PAGE


/	ADDRESS LISTS
/
/	PAIRS OF COMMAND TEXT ADDRESSES AND PROCESSING
/	ROUTINE ADDRESSES.
CMDLST,	GOS;	GO	/ GO command
	TYPES;	TYPE	/ TYPE command
	DIALS;	DIAL	/ DIAL command
	WAITS;	WAIT	/ WAIT command
	SCRENS;	SCREEN	/ SCREEN command
	NSCRNS;	NOSCRN	/ NOSCREEN command
	MENUS;	MENU	/ MENU command
	ABORTS;	ABORTC	/ ABORT command
	CXS;	CXCMND	/ CX command
	ENDS;	ENDCM	/ END command
		0	/ MUST END WITH 0

/
/	PAIRS OF TEXT ITEM TEXT ADDRESSES AND
/	PROCESSING ROUTINE ADDRESSES.
TXTLST,	CRS;	TCR	/ CR
	LFS;	TLF	/ LF
	BRKS;	TBRK	/ BRK
	DTRS;	TDTR	/ DTR
		0	/ MUST END WITH 0
/
/
/	LIST OF WAIT TEXT STRING ADDRESSES
/	MUST BE TERMINATED BY A 0.
WTSLST,	WTS1;WTS2;WTS3;WTS4;WTS5;0
/
/	LIST OF WAIT GO TO TARGET STRING ADDRESSES.
WTGLST,	WTG1;WTG2;WTG3;WTG4;WTG5
/
/	ABORT ERROR MESSAGE ADDRESSES
ABRTBL,	FOFMES			/ File open failure message.
	GHTMES			/ Gold Halt message.
	ENDMES			/ Missing END statment
	ITLMES			/ Item too long
	IVCMES			/ Invalid command
	ABRMES			/ Abort statement execution.
	TYPMES			/ Missing HOST, KBD or SCREEN		/A013
	TXTMES			/ BAD TEXT ELEMENT
	TIMMES			/ BAD TIME SPECIFICATION
	WAIMES			/ TOO MANY WAIT STRINGS
	GOWMES			/ GO/WAIT TARGET MISSING
	DNCMSG			/ DIALING NOT COMPLETED
/
/	ASCIIZ STRINGS
/
NONUM,	IFDEF ENGLSH<-12;"N;"o;" ;"n;"u;"m;"b;"e;"r;0>
	IFDEF ITALIAN<-12;"N;"e;"s;"s;"u;"n;" ;"n;"u;"m;"e;"r;"o;0>
