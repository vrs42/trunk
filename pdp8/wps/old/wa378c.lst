15675 041210* 3776          DCA     PREOF   /  ...                                          /M087
15676               
15677               /SEE IF THE PAGE COUNT IS IN THE RANGE OF THE RESTART PAGE VALUE.
15678               
15679               TOPPL0,
15680 041211* 1033          TAD     PRRSRT  /GET THE RESTART PAGE COUNT
15681 041212* 7141          CIA CLL                                                         /C156
15682 041213* 1032          TAD     PRPCNT  /COMPARE WITH THE PAGE COUNT
15683 041214* 7620          SNL CLA         /USE 13 BIT ARITHMETIC                          /C156
15684 041215* 5252          JMP     TOPPL1  /JUMP TO INHIBIT PRINTING
15685               
15686 041216* 3033          DCA     PRRSRT  /CLEAR THE RESTART COUNT
15687               
15688               /SEE IF THE PAGE NUMBER IS IN THE PROPER RANGE.  IF THE PAGE NUMBER IS TOO
15689               /LOW, SET PRYES TO INHIBIT PRINTING.  IF THE PAGE NUMBER IS TOO HIGH, JUMP
15690               /TO TERMINATE THE CURRENT COPY.
15691               
15692 041217* 1775          TAD     PRQBOT  /GET THE LOW BOUND PAGE NUMBER
15693 041220* 7141          CIA CLL         /ADDED CLL                                      /C156
15694 041221* 1031          TAD     PRPGNM  /SUBTRACT FROM THE CURRENT PAGE NUMBER
15695 041222* 7620          SNL CLA         /USE 13 BIT ARITHMETIC                          /C156
15696 041223* 5252          JMP     TOPPL1  /CURRENT PAGE IS TOO SMALL--JUMP TO TURN OFF PRINTING
15697               
15698 041224* 1774          TAD     PRQTOP  /GET THE HIGH BOUND PAGE NUMBER
15699 041225* 7450          SNA
15700 041226* 5233          JMP     TOPTEO  /THERE IS NO HIGH BOUND--JUMP TO TEST EVEN/ODD
15701 041227* 7140          CMA CLL         /                                               /C156
15702 041230* 1031          TAD     PRPGNM  /SUBTRACT FROM THE CURRENT PAGE NUMBER
15703 041231* 7630          SZL CLA         /USE 13 BIT ARITHMETIC                          /C156
15704 041232* 5252          JMP     TOPPL1  /SKIP TO TURN ON PRINTING
15705               
15706               / THE NEXT SECTION DETERMINES WHETHER OR NOT WE ARE PRINTING            /A240
15707               / ALL THE PAGES, ONLY THE ODD PAGES, OR ONLY THE EVEN PAGES             /A240
15708               / PEOPLE WISHING TO PRINT ON BOTH SIDES OF THE PAPER USE THIS FEATURE   /A240
15709               
15710 041233* 1773  TOPTEO, TAD     PRQSP           /GET WORD SPECIFYING ODD/EVEN           /A240
15711 041234* 0372          AND     (0006)          /MASK OUT OTHER BITS (SHADOW)           /A240
15712 041235* 7450          SNA                     /SEE IF ODD/EVEN                        /A240
15713 041236* 5253          JMP     TOPPL2          /NO, GO ENABLE PRINTING                 /A240
15714 041237* 7012          RTR                     /PUT EVEN BIT IN LSBIT PSN              /A240
15715 041240* 1031          TAD     PRPGNM          /ADD PAGE CURRENT PAGE NUMBER           /A240
15716                                               /BIT 11 WILL COMPLEMENT IF THE PAGE     /A240
15717                                               /NUMBER IS ODD                          /A240
15718 041241* 7010          RAR                     /PUT RESULT IN LINK                     /A240
15719 041242* 7630          SZL CLA                 /SEE WHETHER TO PRINT                   /A240
15720 041243* 5253          JMP     TOPPL2          /ENABLE PRINTING                        /A240
15721               
15722               
15723               / IF WE HAVE BEEN INSTRUCTED TO OUTPUT TWO CONSECUTIVE ODD OR EVEN      /A260
15724               / PAGES DUE TO RESET COMMANDS IN THE DOCUMENT, WE WANT TO OUTPUT        /A260
15725               / A BLANK PAGE WITH NO HEADER OR FOOTER.  THE OTHER SIDE OF THIS PAGE   /A260
15726               / WILL HAVE PRINTING ON IT.  THIS IS SO WE KEEP THE PAGES IN THE        /A260
15727               / PROPER ORDER.                                                         /A260
15728               
