8211               /**********************************************************************/
8212               /                                                                       /
8213               /       PRTST---REPLACEMENT CHR ROUTINE                                 /
8214               /               THIS IS THE BASIC ROUTINE FOR OUTPUTTING THE            /
8215               /               ACTUAL CHARACTERS TO THE PRINTER.  BEFORE WE CAN        /
8216               /               OUTPUT A CHARACTER WE HAVE TO KNOW WHETHER              /
8217               /               IT IS:                                                  /
8218               /               1)      THE REQUIRED SPACE CODE                         /
8219               /               2)      EITHER REPLACEMENT CHR (R1 OR R2)               /
8220               /               3)      A MULITEC CHARACTER REQUIRES 8 BITS             /
8221               /               IF SO, SPECIAL TREATMENT IS REQUIRED                    /
8222               /                                                                       /
8223               /***********************************************************************/
8224               
8225               PRTST,  XX      / REPLACEMENT CHR ROUTINE       
undefined             	 ^
     031272* 0000  
8226                               / THIS ROUTINE IS FOR BOTH THE LQP02 AND LQPSE
8227 031273* 2357          ISZ     REPCHAR         / examine repeat char flag              /a273
8228 031274* 5277          JMP     PRTST1          / continue if not                       /a273
8229 031275* 1356          TAD     LSTCHA          / get the last char                     /a273
8230 031276* 5316          JMP     PRTST2          / just send it again                    /a273
8231               PRTST1,                                                                 /a273
8232 031277* 1436          TAD I   PLPTR   /GET CHARACTER
8233                       AND     P177    /STRIP OFF MODE BITS
undefined       	    	   ^
undefined       	    	   ^
     031300* 0000  
8234 031301* 1370          TAD     (-RQSP) /IS IT THE REQUIRED SPACE?                      /A217
8235 031302* 7650          SNA     CLA     /                                               /A217
8236 031303* 5330          JMP     PRC3    /YES, IS REQUIRED SPACE                         /A217
8237 031304* 4332          JMS     RXTST           /TEST FOR REPLACEMTN CHRS               /A218
8238 031305* 5322          JMP     PRC1            /IS R1                                  /C218
8239 031306* 5325          JMP     PRC2            /IS R2                                  /C218
8240 031307* 1436          TAD I   PLPTR           / GET THE CHARACTER                     /C218
8241                       AND     P177            / watch those top bits                  /a271
undefined       	   	   ^
undefined       	   	   ^
     031310* 0000  
8242 031311* 1376          TAD     (200)           /SET MULTINATIONAL BIT FOR 8 BIT PRINT  /A271
8243 031312* 2077          ISZ     MNCFLG          /IS IT A MULITEC CHAR                   /A271
8244                       AND     P177            /NO DONT ADD 200                        /A271
undefined       	   	   ^
undefined       	   	   ^
     031313* 0000  
8245               PRTST3,                                                                 /a273
8246 031314* 3356          DCA     LSTCHA          / save this char                        /a273
8247 031315* 1356          TAD     LSTCHA          / get it back again                     /a273
8248               PRTST2,                                                                 /a273
8249 031316* 4767          JMS     PRCHAR          /AND PRINT IT
8250 031317* 3077          DCA     MNCFLG          / CLEAR THE MULTINATIONAL CHAR FLAG     /A271
8251 031320* 3357          DCA     REPCHAR         / clear the repchar flag                /a273
8252 031321* 5672          JMP I   PRTST           /EXIT
8253                       
8254 031322* 4766  PRC1,   JMS     PRESCS  /DO S1 SUBSTITUTION
8255 031323* 0077                  PCSUB1
8256 031324* 5672          JMP I   PRTST   /EXIT
8257               
8258 031325* 4766  PRC2,   JMS     PRESCS  /DO S2 SUBSTITUTION
8259 031326* 0100                  PCSUB2  
8260 031327* 5672          JMP I   PRTST   /EXIT
8261               
8262               PRC3,
8263               
8264               /WE HAVE DETECTED THE REQUIRED SPACE.  WE CANNOT SIMPLY OUTPUT          /A217
8265               /A SPACE CODE INSTEAD OF THE CODE FOR THE REQUIRED SPACE SINCE          /A217
8266               /THE AMOUNT OF MOTION THAT THE SPACE MOVES IS PROGRAMMABLE IF WE        /A217
8267               /ARE JUSTIFYING.  THE JUSTIFICATION LOGIC PRESUMED THAT THE SPACE       /A217
8268               /WIDTH IS CONTAINED IN PLNRCS.  THUS WE OUTPUT THAT AMOUNT OF           /A217
8269               /HORIZONTAL MOTION...                                                   /A217
8270               
8271               /HERE WE USED TO OUTPUT SPACE BACKSPACE TO TRIGGER UNDERLINE            /A268
8272               /BUT WE HAD PROBLEMS WITH JUSTIFICATION OF REQ'D SPACE SO CODE WAS DLTD /A268
8273               
8274               
8275               /FOR THE LQPSE WE MUST OUTPUT IN PRINT UNITS                            /A218
8276               /FOR THE LQP02 WE MUST OUTPUT IN COLUMN UNITS, ERGO:                    /A218
8277               
8278               /d273 delete these LQPSE bits to gain room for this edit 
8279               /d273   JMS     SKIPIF                                                  /A218
8280               /d273           LQPSE                                                   /A218
8281               /d273   JMP     PRC4            /LQP02/3                                /A218
8282               
8283               /THIS IS REQUIRED SPACE TO THE LQPSE                                    /A218
8284               /d273   TAD     PLNRCS          /GET STANDARD WIDTH ACCORDING TO PITCH  /A218
8285               /d273   JMS     PLHMOV          /CALL THE LQPSE HORZ MOTION ROUTINE     /A218
8286               /d273   JMP I   PRTST           /RETURN                                 /A218
8287               
8288               PRC4,                   /REQUIRED SPACE IN PRTST                        /A217
8289               /d273   TAD     PLDIR           /GET DIRECTION FLAG                     /A217
8290               /d273   JMS     PRESCS          /CALL ROUTINE FOR HORZ MOVE             /A217
8291               /d273           PCMRT           /HORIZONTAL MOTION HAI COLUMNS          /A217
8292               /d273           CLA                                                     /A217
8293               /d273   JMP I   PRTST           /EXIT                                   /A217
8294 031330* 1365          TAD     (240)           /get an eight bit space                 /a273
8295 031331* 5314          JMP     PRTST3          / go output it                          /a273
