15654               
15655               /THIS SECTION IS INVOKED AT THE BEGINNING OF EACH PAGE.  IT FIRST DETERMINES
15656               /WHETHER THE PAGE IS IN THE RANGE TO BE PRINTED.  IT THEN DETERMINES WHETHER
15657               /ANY TOP OF PAGE STOP IS NECESSARY, OR IF A PARTICULAR PAGE SHOULD      /C177
15658               /BE SKIPPED OVER DUE TO THE ENVELOPE OPTION STRATEGY                    /C177
15659               
15660               OVTOPP=.-OVRLCA
15661               OBTOPP=OVTYPE+OVNUM
15662               
15663 041201* 3023          DCA     PRGSVP  /CLEAR RELATIVE VERTICAL POSITION
15664 041202* 3024          DCA     PRGSAP  /CLEAR ABSOLUTE VERTICAL POSITION
15665 041203* 3777          DCA     PRGSVS  /CLEAR ACCUMULATED VERTICAL SPACING
15666               
15667               /IF WE ARE AT THE END OF THE FILE, JUMP TO THE NEW COPY CODE.
15668               
15669               /D169   TAD     PRGCBK  /ARE WE AT THE END OF THE FILE?
15670 041204* 1016          TAD     RDCHAR  /ARE WE AT THE END OF THE FILE?                 /A169
15671 041205* 7640          SZA CLA
15672 041206* 5211          JMP     TOPPL0  /NO--CONTINUE WITH TOP PROCESSING
