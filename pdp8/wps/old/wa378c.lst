16539 041476* 5756          JMP     IDRTN           / CAN'T, JUST RETURN                    /C226
16540 041477* 4763          JMS     PRESCS          / REQUEST A STATUS REPORT               /C191
16541 041500* 0060                  PCSTAT          /                                       /C191
16542 041501* 5756          JMP     IDRTN           / RETURN NORMALLY (NO ERROR)
16543               
16544               /**********************************************************************/
16545               /                                                                       /
16546               /       IDCKT2--SUBROUTINE TO CHECK THE "TIMEOUT" LOCATION IN WPSYS     /
16547               /               THIS SUBROUTINE IS FOR USE ONLY BY PRTRID, SINCE        /
16548               /               PRINTER ID (THE SUBROUTINE PRTRID DEFINED FOR THE WORLD /
16549               /               CAN BE CALLED BY THE USER JOB (LIST PROCESSING TO PRINTR/
16550               /               OR CX), AS WELL AS THE PRINTER ITSELF.  THEREFORE ANY   /
16551               /               JWAITS IT CONTAINS MAY NOT BE SHARED WITH OTHER JOBS    /
16552               /               THUS WE CANNOT USE THE SAME SUBROUTINE THE PRINTER JOB  /
16553               /               USES AS IT MAY BE IN USE BY THE PRINTER JOB             /
16554               /                                                                       /
16555               /               (IT USED TO AND DID CAUSE A SYSTEM HANG)        /A198   /
16556               /                                                                       /
16557               /***********************************************************************/
16558               
16559               IDCKT2, XX              / ROUTINE TO CHECK THE SYS FIELD "TIMOUT" VARIABLE/A198
undefined              	 ^
     041502* 0000  
16560                                       / JUST SEE IF TIMOUT IN SYS HAS ADVANCED        /A198
16561                                       / BEYOND THE VALUE WE HAVE ESTABLISHED          /A198
16562                                       / IF SO, DO A SKIP RETURN                       /A198
16563                                       / IF NOT, JWAIT AND RETURN W/O ISZ              /A198
16564               
16565 041503* 1755          TAD     PIDTMR  / GET VALUE TO COMPARE AGAINST                  /A198
16566 041504* 7040          CMA             / NEGATE AND SUBTRACT ONE SECOND OF UNCERTAINTY /A198
16567                       CDFSYS          /                                               /A198
undefined       	     ^
     041505* 0000  
16568                       TAD I   (TIMOUT / ADD CURRENT VALUE OF THE 12BIT SECOND COUNTER /A198
undefined       	     	      ^
undefined       	     	      ^
     041506* 1772  
16569 041507* 0000          CDFMYF          /                                               /A198
16570 041510* 7700          SMA CLA         / SKIP IF STILL TIMING OUT                      /A198
16571 041511* 2302          ISZ     IDCKT2  / BUMP RETURN ADDRESS--TIMED OUT                /A198
16572 041512* 4754          JMS     SQPINP  / HANDLE CHRS COMING BACK                       /A198
16573                       CIFSYS          /                                               /A198
undefined       	     ^
     041513* 0000  
16574                       JWAIT           /                                               /A198
undefined       	    ^
     041514* 0000  
16575 041515* 5702          JMP I   IDCKT2  / RETURN                                        /A198
