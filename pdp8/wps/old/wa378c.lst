15490               /                                                                       /
15491               /       OVRULR--PART OF PRRULE FOR PROCESSING RULERS                    /
15492               /               AS OF V1.2.N IT WAS FOUND THAT THIS ROUTINE NEEDS       /
15493               /               TO BE A TYPE C OVERLAY.   OTHER USES OF TYPE C OVERLAYS /
15494               /               ARE FOR THE STOP PROCESSING AND IFICATION.  RULERS      /
15495               /               ARE BY DEFINITION PROCESSED BETWEEN LINES SO WE NEED    /
15496               /               NOT WORRY ABOUT THEM.  IN GENERAL, STOP PROCESSING OCCURS
15497               /               BETWEEN LINES.                                          /
15498               /                                                                       /
15499               /               THE IMPORTANT THING TO NOT IS THAT WE MUST NOT ALLOW    /
15500               /               OURSELVES TO GO FROM HERE INTO THE STOP MENU DIRECTLY   /
15501               /               WHATEVER CALLS PRRULE MUST THEN TAKE US TO THE STOP MENU/
15502               /               ELSE WE WILL LOSE TRACK OF WHERE WE WERE                /
15503               /                                                                       /
15504               /***********************************************************************/
15505               
15506               OVRULR=.-OVRLCA
15507               OBRULR=OVTYPE+OVNUM
15508               
15509               
15510               /THIS SECTION LOOPS UNTIL THE PERTINENT SECOND HALF OF THE RULER IS FOUND.
15511               
15512 041400* 3046          DCA     RULRCM  /CLEAR CENTERING COLUMN                         /A243
15513               PRO2L1,
15514 041401* 4777          JMS     READCH  /GET NEXT CHARACTER
15515 041402* 7450          SNA
15516 041403* 5776          JMP     PRRUL3  /END OF COMMAND/END OF FILE FOUND IN MIDDLE OF
15517                                       /RULER--TREAT LIKE EOC/EOF
15518 041404* 1375          TAD     (-100)  /SECOND HALF OF RULER?
15519 041405* 7640          SZA CLA
15520 041406* 5201          JMP     PRO2L1  /NO--KEEP LOOKING
15521               
15522               /WE ARE NOW DEALING WITH THE SECOND HALF OF THE RULER.  AS NUMBERS ARE
15523               /ENCOUNTERED, THEY ARE RECORDED IN RULRT1.  THE NUMBER WHICH PRECEEDS THE
15524               /RIGHT MARGIN IS THE VALUE OF THE RIGHT MARGIN.
15525               
15526               PRO2L2,
15527 041407* 3315          DCA     RULRT1  /CLEAR THE VALUE TEMPORARY
15528 041410* 4777          JMS     READCH  /GET NEXT CHARACTER
15529 041411* 7450          SNA
15530 041412* 5776          JMP     PRRUL3  /END OF COMMAND/END OF FILE FOUND IN MIDDLE OF
15531                                       /RULER--TREAT LIKE EOC/EOF
15532 041413* 1374          TAD     (-17)   /END OF RULER?
15533 041414* 7450          SNA
15534 041415* 5773          JMP     PRRUL1  /YES--RETURN TO GET NEXT CHARACTER
15535 041416* 1372          TAD   (17-100)  /NUMBER?
15536 041417* 7500          SMA
15537 041420* 5231          JMP     PRO2L3  /NO - MUST BE SETTING
15538               
15539               /THE CHARACTER IS A NUMBER.  ADD TO THE SUM AND CONTINUE.
15540               
15541 041421* 1371          TAD   (100-60)  /MAKE A NUMBER
15542                       DCA     T1      /SAVE IN TEMPORARY
undefined       	   	 ^
undefined       	   	 ^
     041422* 3000  
15543 041423* 1315          TAD     RULRT1  /MULTIPLY SUM BY 16
15544 041424* 7006          RTL
15545 041425* 7006          RTL
15546 041426* 0370          AND     (3760)
15547                       TAD     T1      /ADD NEW DIGIT
undefined       	   	 ^
undefined       	   	 ^
     041427* 1000  
15548 041430* 5207          JMP     PRO2L2  /SAVE NEW VALUE AND GET NEXT DIGIT
15549               
15550               /THE RULER IS A SETTING.  PROCESS IT.
15551               
15552               PRO2L3,
15553 041431* 1367          TAD  (100-104)  /LEFT MARGIN?
15554 041432* 7450          SNA
15555 041433* 5261          JMP     PRO2LM  /YES
15556 041434* 1366          TAD  (104-105)  /RIGHT MARGIN?
15557 041435* 7450          SNA
15558 041436* 5277          JMP     PRO2RM  /YES
15559 041437* 1366          TAD  (105-106)  /DOUBLE SPACED LEFT MARGIN?
15560 041440* 7450          SNA
15561 041441* 5257          JMP     PRO2DM  /YES
15562 041442* 1366          TAD  (106-107)  /JUSTIFIED RIGHT MARGIN?
15563 041443* 7450          SNA
15564 041444* 5274          JMP     PRO2JM  /YES
15565 041445* 1365          TAD  (107-112)  /CENTERING MARK?                                /A243
15566 041446* 7450          SNA             /                                               /A243
15567 041447* 5312          JMP     PRO2CM  /YES                                            /A243
15568 041450* 1366          TAD  (112-113)  /ONE AND ONE-HALF SPACED LEFT MARGIN?           /C243
15569 041451* 7450          SNA
15570 041452* 5260          JMP     PRO2OM  /YES
15571 041453* 1364          TAD  (113-115)  /HALF-SPACED LEFT MARGIN?
15572 041454* 7650          SNA CLA
15573 041455* 5262          JMP     PRO2FM  /YES
15574 041456* 5207          JMP     PRO2L2  /NOT A RIGHT MARGIN--CLEAR THE VALUE
15575               
15576               PRO2DM,
15577 041457* 1363          TAD     (PRNHL) /DOUBLE SPACING
15578               PRO2OM,
15579 041460* 1363          TAD     (PRNHL) /1.5 SPACING
15580               PRO2LM,
15581 041461* 1363          TAD     (PRNHL) /SINGLE SPACING
15582               PRO2FM,
15583 041462* 1363          TAD     (PRNHL) /HALF SPACING
15584               
15585 041463* 3026          DCA     PRRLSZ  /SAVE AS LINE SIZE DEFINED BY RULER
15586               /D193   JMS     PRTRNC  /GET TOTAL LINE SIZE (TRUNCATED IF NECESSARY)
15587               
15588               /THE FOLLOWING IS EQUIVALENT TO PRTRNC, XX AND IS COPIED INLINE HERE    /A193
15589               /TO AVOID OVERLAY THRASHING AND OVERLAY TYPE CONFLICTS                  /A193
15590               
15591               /THIS ROUTINE SETS THE CURRENT VALUE OF VERTICAL SPACING (PRLLSZ)
15592               /BY ADDING THE LINE SPACING AS DEFINED BY THE RULER (PRRLSZ)
15593               /AND THE NUMBER OF EXTRA HALF LINES DEFINED IN THE PRINT MENU (PRQLSZ)
15594               /IF PRINTING A HEADER OR FOOTER, PRQLSZ IS IGNORED
15595               
15596               /MADE FUNCTIONAL FOR ALL TYPES OF PRINTERS                              /A212
15597               
15598 041464* 1042          TAD     PRFLAG  /ARE WE PRINTING A HEADER/FOOTER?               
15599 041465* 7650          SNA CLA                                                         
15600 041466* 1762          TAD     PRQLSZ  /ADD THE EXTRA LINE SPACING FROM THE PRINT MENU
15601                                       /ONLY IF PRINTING REGULAR TEXT                  
15602 041467* 1026          TAD     PRRLSZ  /ADD THE LINE SIZE DEFINED BY THE RULER
15603               
15604 041470* 3027          DCA     PRLLSZ  /SAVE AS THE LINE SIZE
15605 041471* 1315          TAD     RULRT1  /GET COLUMN OF LEFT MARGIN                      /A243
15606 041472* 3047          DCA     RULRLM  /SAVE FOR CENTERING LOGIC                       /A243
15607 041473* 5207          JMP     PRO2L2  /DO NEXT ELEMENT IN RULER
15608               
15609               PRO2JM,         /JUSTIFIED RIGHT MARGIN--CALCULATE PRRM IN PRINT UNITS
15610               
15611 041474* 1315          TAD     RULRT1  /GET THE VALUE WHICH PRECEEDED THE RIGHT MARGIN
15612 041475* 4761          JMS     PRMULT  /MULTIPLY BY CHARACTER SIZE
15613 041476* 0022                  PLNRCS
15614               
15615 041477* 3017  PRO2RM, DCA     PRRM    /SAVE AS THE RIGHT MARGIN
15616               
15617               /CALCULATE THE LARGEST RIGHT MARGIN TO DATE IN THIS COLUMN
15618               
15619 041500* 1315          TAD     RULRT1  /GET THE RIGHT MARGIN
15620 041501* 3060          DCA     RULRRM  /SAVE AS THE RIGHT MARGIN
15621               
15622 041502* 1060          TAD     RULRRM  /GET CURRENT RIGHT MARGIN SIZE
15623 041503* 7041          CIA
15624 041504* 1047          TAD     PRMCLL  /COMPARE WITH LARGEST LINE TO DATE
15625 041505* 7700          SMA CLA
15626 041506* 5207          JMP     PRO2L2  /NO NEED TO UPDATE
15627               
15628 041507* 1060          TAD     RULRRM  /UPDATE NEW LARGEST LINE
15629 041510* 3047          DCA     PRMCLL
15630 041511* 5207          JMP     PRO2L2
15631               
15632               PRO2CM,         /-C- CENTERING MARK IN RULER                            /A243
