	1
	JMS	SCGETR	/GO GET A BLOCK NUMBER
	SCBTH
	SCBOT
	SZA CLA		/SKIP IF END OF BLOCK-LIST POINTERS
	JMP	PSTBO1	/LOOP UNTIL EOF FOUND
	JMP I PSTBOT	/EXIT:AT END OF FILE
