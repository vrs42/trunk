	ISZ	SCQRX
	CIFSYS 			/ ++++
	ENQUE 			/ ++++
	SCQUBL 			/ QUEUE Q-BLOCK

SCQRX1,	CIFSYS 			/ ++++
	JWAIT 			/ WAIT FOR EVENT
	TAD	SCQBLK+RXQCOD 	/ ARE WE DONE?
	SNA
	JMP	SCQRX1 		/ NO

	SMA 			/ ++++
	CLA 			/ RETURN - IF ERROR; 0 OTHERWISE
	JMP I	SCQRX 		/ YES

SCQUBL,	DSKQUE 			/ ++++
	0 			/ ++++
