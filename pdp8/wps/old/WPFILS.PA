	-1			/ AMOUNT TO DECREMENT BY		/A003
	AC7777			/ MINUS 1 TO AC				/A003
	DCA	SCALCY		/ PUT DEC VALUE IN CALL LIST		/A003
	JMS	SCAD16		/ GO SEE IF WE NEED TO ADD 16(IN 3RD HDR/A003
	SCBTHT			/ HDR PTR				/A003
	SCBOTT			/ HDR WORD PTR				/A003
SCALCY,	0	
