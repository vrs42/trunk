GETHDR,	JMS I	XGETR		/ GO GET HEADER BLOCK NBR		/A045
	THREE			/  THIRD HEADER WHERE BLK NBRS ARE
	PTR1			/ POINTER TO WHERE BLK NBRS ARE

GTHDCK,	SNA			/ IF NON-ZERO, THE BLOCK NBR IS PRESENT	/A003
	JMP 	GTRESH		/ IF ZERO BLK NBR, THEN ALL DONE	/M045
