RDINC2,	0			/ AMOUNT TO INCREMENT BY		/A003
	JMP I	RDINC		/ RETURN				/A003

/ THIS ROUTINE WILL SEARCH FOR THE BOTTOM OF THE DOCUMENT.
/ IT IS USED TO MAKE SURE THAT THE HEADER POINTER IN THE SCROLL
/ HEADER CONTROL BLOCK IS POINTING TO THE LAST HEADER BLOCK
/ IN THE FILE SO THAT THE DE-ALLOCATION ROUTINE WON'T DE-ALLOCATE
/ ANY HEADERS THAT BELONG TO THE FILE...

PSTBOT,	0		/SAVE CALLER'S RETURN ADDR.
	AC0001		/						/A032
	DCA	SCBTH	/START WITH 1ST HEADER				/A032
	TAD	(SCBKOF	/STARTING HEADER WORD POINTER
	DCA	SCBOT	/INTO 'BOTTOM' POINTER

