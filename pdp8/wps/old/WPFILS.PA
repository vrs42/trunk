/D047	3			/ NUMBER TO BUMP UP BY			/A003
/D047			>	/ END IFNDEF STATLN			/A043


SCALCX,	JMS	SCGETR		/ GO GET BLOCK - 1			/M047
	SCBTHT			/ HDR PTR				/A003
	SCBOTT			/ HDR WORD PTR				/A003
