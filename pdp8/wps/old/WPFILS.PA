GTHDRS,	XX			/ ROUTINE TO GET HEADER BLOCK EXTENSIONS
	TAD I	GTHDRS		/ GET ADDRESS OF HDR CTL AREA		/A003
	DCA	PTR1		/ STORE IT TO INDIRECT THRU		/A003
	TAD I	PTR1		/ GET BUFFER ADDRESS			/A003
	TAD	THREE		/ POINT TO THIRD HDR BLK AREA		/A003
	DCA	PTR1		/ STORE ADDR 3RD HDR BLK		/A003
	CDFBUF								/A003
	TAD I	PTR1		/ GET 3RD HDR BLOCK NBR			/A003
	CDFMYF								/A003
	SNA CLA			/ IF NO THIRD HDR, GO BACK		/A003
	JMP	GTGOBK		/ RETURN				/A003
	TAD I	GTHDRS		/ GET ADR OF HDR CONTROL AREA
	TAD	FOUR			/ BUMP TO THIRD HDR BLK NBR	/M014
	DCA	X0		/ PUT ADR FOR AUTOINDEXING

	TAD	(RPBFCB		/TOP OF RPPGDS BLOCK-LIST		/A014
	TAD	FOUR		/PTR ABOVE 4TH ENTRY			/A104
	DCA	X1		/SAVE FOR STORE LATER			/A104

	TAD	T360		/ GET WORD WHERE EXTENSIONS ARE
