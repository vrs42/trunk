GOTMRK,	IAC
SLXMOD,	IAC
EIENTR,	IAC
EIPAGE,	IAC
EIPARA,	IAC
EITABP,	IAC
EISENT,	IAC
EIWORD,	IAC
EILINE,	IAC
EICHAR,	DCA	GRAMUN		/ SET UNIT TYPE
