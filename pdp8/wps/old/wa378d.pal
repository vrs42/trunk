/----------------------------------------
MENUTABLE,			/ table of menu options
	2000;	REPLACE		/ 'replace' option
	2012;	EDIT		/ 'edit' option
	2021;	IGNORE		/ 'ignore' option
	2032;	CONTINUE	/ 'continue' option
	2045;	FINISH		/ 'finish' option
	2056;	OVERVIEW	/ 'overview' option
ENDMENUTABLE=.			/ end of table
