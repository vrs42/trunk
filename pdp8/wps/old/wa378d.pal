MRGDNX,	CLA
	CDFMYF			/ CHANGE DATA FIELD TO THIS FIELD	  /A170
	CIFMNU			/ CHANGE INSTRUCTION FIELD TO MENU FIELD  /A170
	PGSWAP			/ AC=0, SAVE SWAP AREA & RELOAD MENU CODE /A170

	TAD	MRGDNC 		/ LOAD CONDITION CODE
	JMP	EDEXI3 		/ THEN EXIT

MRGDNC,	.-.

	X=.			/ INDICATE FIRST FREE LOCATION ON PAGE
/---------------------
	PAGE

	/ MGOVLY MOVED TO WPEDIT RESIDENT AREA BY EDIT 171

/	STRP13	SEARCH FOR NEXT LINE
/
/

ESSTPX,	CDFBUF
	TAD I	CURPTR			/FETCH FIRST CHAR
	JMP	STRP14
STRP13,	ADVSPC
	JMP	STPEX1
STRP14,	AND	P177
	ZZCASE
	STPTB3-1

/	ECNWLN;	STRP15		/NEWLINE COULD BE GOOD
/	ECNWPG;	STPEX2		/NEWPAGE HERE IS NONO
/	ECSTRL;	STPEX2		/SAME WITH RULER	
/	ECMDFL;	STRP16		/MODIFIED FLAG SKIP INC CURSOR
/	0

	ISZ	CURSOR
STRP16,	JMP	STRP13		/GO BACK AND CHECK NEXT CHARACTER	/C218

/D218	STRP16,	CURMOV
/D218	JMP	STPEX1		/EOF IS ACTUALLY CATASTROPHIC FAILURE
