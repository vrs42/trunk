	CDFMNU			/GET LAST FILENO			/SB
	TAD I	(MUBUF+MNFNO)	/IE 'RESULT' FILE			/SB
	CDFMYF			/PUT NEAR SAVED INPUT FILE		/SB
	DCA	INFNO-1		/	DCA I	(OPENER+1)	/IS CUB2+1 IN WPCUT			/SB
	TAD	7500	/	TAD I	(OPENER)	/SAVED  INPUT FILE			/SB
	CDFMNU								/SB
