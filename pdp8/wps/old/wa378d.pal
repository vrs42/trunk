/ NO RULER! INSERT ONE!

INIX03,	CDFMYF
	JMS	RLGETS
	JMS	INSRUL 		/ ELSE INSERT RULER 0
	TAD	(ECRMFL)
	JMS	INSRL1 		/ AND RLRMOD CODE
	TAD	LINE23
	DCA	CURPTR 		/ RESET TO START OF MEM

INIX02,	PUTESC 			/ SET APPLICATION KEYPAD MODE
	"=-200
	JMS	SETCUR 		/ GET TO BOTTOM LINE
	AC0003
	DCA	SCRLCT 		/ INIT TO TOP
	TAD	FORMNO 		/ AND START UP RIGHT PROCESS
	SNA CLA
	JMP	TOOVJRTN	/ CHECK AMOUNT OF ROOM ON DISK BEFORE
