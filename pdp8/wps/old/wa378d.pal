WTS4=X;X=X+WTTSIZ+2
WTS5=X;X=X+WTTSIZ+2
WTS6=X;X=X+PHNSIZ+2							/A024
/
KEY=WTS1
NUMBR=WTS6								/A024
/D024NUMBR=WTS2
