/	WAIT TARGET STRINGS
WTG1=X;X=X+LABSIZ+2
WTG2=X;X=X+LABSIZ+2
WTG3=X;X=X+LABSIZ+2
WTG4=X;X=X+LABSIZ+2
WTG5=X;X=X+LABSIZ+2
/
