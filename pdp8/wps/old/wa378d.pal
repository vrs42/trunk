DENTYP,	JMS	SPLSEL		/ CHECK IF DRIVE IS WINCHESTER OR FLOPPY
	JMP	SPLDE3		/ WINCHESTER, DISPLAY "VOLUME NOT ASSIGNED"

SPLDE2,	JMS	SPLTX2		/ PRINT "INSERT THE DISKETTE INTO DRIVE ..."
	JMS	SPLTX4		/ PRINT "OR TYPE THE DRIVE/DEVICE NUMBER ..."
	AC0001			/ SET UP FOR OPTIONAL DRIVE NUMBER
	JMS	REDSPL		/ GO HANDLE USER INPUT REQUEST
	    JMP	SPLDE2		/ USER ERROR - GO HANDLE IT
	    JMP	SPLGMR		/ USER TYPED "GOLD MENU", GO HANDLE IT
	    JMP SPLDEN		/ USER TYPED "RETURN", GO HANDLE IT

SPLDE3,	CIFMNU			/ YES, HANDLE VOLUME NOT ASSIGNED
	JMS I	IOACAL		/ CALL STANDARD MESSAGE OUTPUT ROUTINE
	    0			/ USE DEFAULT OUTPUT CHANNEL
	    SPLNAS		/ POINTER TO MESSAGE CONTROL STRING
	    0			/ ADDRESS FOR CLEAR SCREEN COMMAND
	    1020		/ SCREEN POSITION FOR FIRST TEXT LINE
	    SPLDRV		/ POINTER TO DRIVE NUMBER
	JMS	SPLTX3		/ PRINT "TYPE THE DRIVE/DEVICE NUMBER ..."
	JMS	REDSPL		/ GO HANDLE USER INPUT REQUEST
	    JMP	SPLDE3		/ USER ERROR - GO HANDLE IT
	    JMP	SPLGMR		/ USER TYPED "GOLD MENU", GO HANDLE IT
	    JMP SPLDEN		/ USER TYPED "RETURN", GO HANDLE IT

