MVBTAB,	CHRBNT
	LINBNT
	WRDBNT
	SNTBNT
	TABBNT
	PARUNT
	PAGBNT
	FLDBNT

MVCTAB,	CHRUNT
	LINUNT
	WRDUNT
	SNTUNT
	TABUNT
	PARUNT
	PAGUNT
	FLDUNT
SLCTMD=	.-MVCTAB		/ "SELECT" TYPE CODE
	SLTUNT
CNTMOD=	.-MVCTAB		/ "COUNT" TYPE CODE
	CNTUNT

ECFIEL=	76			/ CODE FOR FIELD DELIMITER (RIGHT ANGLE)

FLDBN1,	JMS	CHKUNR
FLDBNT,	AND	P177
	TAD	(-ECFIEL)
	SNA CLA
	JMP	FLDBN1
FLDBN2,	JMS	CHKUNH
FLDUNT, AND	P177
	TAD	(-ECFIEL)
