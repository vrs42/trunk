	AC7777			/ RETURN "DONE" IF SET
	CDFBUF
	JMS I	CHKUNT
	JMP I	CHKUNH

CHKUNT,	XX
MVCODE,	JMP I	.-.

SETBNT,	XX			/ SET FOR BACKUP
