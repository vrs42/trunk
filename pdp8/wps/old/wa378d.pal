/-----------

SETRV,	XX
	PUTCHR;	4000+ESC	/ Output escape sequence to set terminal attributes.
		4000+"[		/
		4000+"7		/
		"m&177		/
	JMP I	SETRV		/ Return to caller.


/-----------
/
/ CLRRV - Reset screen of all attributes.
/
/
/ CALL:	JMS	CLRRV		AC is 0 on entry & return.
/
/		ESC [ 0 m
/
/-----------

CLRRV,	XX
	PUTCHR;	4000+ESC	/ Output escape sequence to set terminal attributes.
		4000+"[		/
		4000+"0		/
		"m&177		/
	JMP I	CLRRV		/ Return to caller.


/-----------
/
/ STBOLD - set bold
/
/
/ CALL:	JMS	STBOLD		AC ignored & destroyed on return.
/
/		ESC [ 1 m
/
/-----------

STBOLD,	XX			/ return address
	PUTCHR;	4000+ESC	/ output escape sequence to the terminal
		4000+"[		/
		4000+"1		/
		"m&177		/
