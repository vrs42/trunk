	DCA	DVPACK		/TEMP LOCATION				/A034
	CDFACP			/ACP FIELD				/A034
	TAD I	DVPACK		/GET CODE				/A034
	CDFDSK			/DRIVER FIELD				/A034
	RAL			/WINNIE BIT TO LINK			/A034
	SNL			/IS WINNIE DEVICE?			/A034
