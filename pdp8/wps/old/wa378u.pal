	65+2000			/   5				/m091	/m095
	176+3000		/   ~ (tilde)				/m095
	JMP	U1BREAK		/ STOPPER
	>	/ END IFDEF CONDOR ------------------------------------	/A075

				/ HALT defines as "ESC O P halt"
	117+0			/ O					/m095
