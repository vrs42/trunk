RDRZXT,
	JMS	RDCMPT		/EMPTY OR FILL
	JMP	RZEXIT
/
/MOVE PARAMETERS FROM DATA FIELD IN RZBCDF TO WIN FIELD
/
MOVPAR,	0
	TAD	(-10		/COUNT
	DCA	RDCNT		
	TAD	RZBPTR
	DCA	MVPTR2		/BUFFER POINTER
	TAD	(CMNDBF+1	
