	JMP	DVSNOP		/SET NOP			/A015
	TAD	RZXDIR		/GET CMND			/A015
	AND	(16		/MASK FNCTION BITS		/A015
	CIA							/A015
	TAD	(2		/READ FUNCTION CODE		/A015
