/
/SCAN THE MACRO BUFFER FOR A TERMINATOR. EXIT CALL +1 IF TERMINATOR FOUND ELSE
/CALL +2 FOR NEXT READ
/

SCNBUF,	0
	JMS	IOPEN		/SET UP FOR THE READ.
SCNBF2,	JMS	GETMAC		/PROCESS UNTIL TERMINATOR SEEN
	JMP	SCNBF1		/END FOUND.
	CLA
	JMP	SCNBF2
SCNBF1,	JMS	GETMAC		/GET MACRO GRAPH NUMBER
	NOP
	CIA			/NEGATE IT
	JMS	GT2END		/LOOK FOR THE FINAL VALUE
	CLA
	JMP I	SCNBUF




/
/CLEAR ALL MACRO GRAPHS
/

CLRGRP,	0
	RDF
	TAD	(CIF CDF
	DCA	CLRGR9
	CIF CDF	TBLFLD
	TAD	(-32		/INIT THE FILL COUNTER.
	DCA	10		/USE AN AUTO INDEX AS A TEMPORARY
	TAD	(MSTACK-1		/SET UP BUFFER ADDRESS
	DCA	11
	DCA I	11		/NOW THE ACTUAL CLEAR LOOP
	ISZ	10		/UPDATE COUNTER
	JMP	.-2		/STAY IN THE LOOP TILL DONE.
	TAD	(-27		/AMOUNT OF FREE SPACE WHEN THE STATCK IS FILLED
	DCA I	11
	JMS	STTAB		/RESTORE THE NEW TABLE
	PR3
	4000+MCFLD+TABFLD	/MARK THE END OF THE TABLE
	ZZERO+1
	33
	-1
	-1
	DCA	MACSTK
CLRGR9,	HLT
	JMP I	CLRGRP		/EXIT. THE MACRO GRAPHS HAVE BEEN INITIALIZED.

/
/UPER - MAKE UPPER CASE ROUTINE (SAME CODE AS "UPPER" IN REGFLG
/
UPER,	0
/
	DCA	UPETM		/SAVE CHAR
	TAD	UPETM
	TAD	(-141		/LOWER CASE A TO Z
	SPA			/SKIP IF IT STILL LOOKS GOOD
	JMP	UPER8		/NOT LOWER CASE
	TAD	(-32		/THE RANGE OF CHARACTERS
	SMA CLA			/SKIP IF WITHIN RANGE
	JMP	UPER8		/NOT LOWER CASE CHARACTER
	TAD	UPETM		/MAKE IT UPPERCASE
	TAD	(-40		/THIS DOES IT
	DCA	UPETM		/SAVE FOR RETURN
/
UPER8,	CLA CLL
	TAD	UPETM		/GET CONVERTED CHAR
	JMP I	UPER		/RETURN WITH CHAR, NOW UPPER-CASE


/
IOPEN,	0
	DCA	GETM1		/BUFFER ADDRESS TO START READ
	STA
	DCA	MACCNT
	JMP I	IOPEN
/

CLRMAP,	0
	TAD	(MSTACK-1
	DCA	10
	TAD	(-33
	DCA	11
	DCA I	10
	ISZ	11
	JMP	.-2
	JMP I	CLRMAP
/	
LASACT,	0
MACACT,	0			/MACRO ACTIVE FLAG
MACCNT,	0
UPETM,	0
ZZERO,	-1; 0; 0; 0

