	TAD	(WINDIS			/DISMOUNT CODE
RDTRLP,
	JMS	TRLOOP		/TRANSFER
	JMP 	RZEXIT		/XIT
/
SVSPCE,	0
	DCA	RDCNT
	TAD	(CMNDBF	
	DCA	WINPTR		/SET IT
	TAD	WINFLD
	DCA	RD1SET		/SET UP FIELD PTR
	TAD	RZDRIV		/GET DRIVE #
	AND	(37		/L/O 4 BITS			/C035
	DCA	WRD1
	JMP I	SVSPCE
