COLORM,	17		/COLOR PLANE MASK WORD    (0 TO 17 OCTAL)
LINTXT,	377		/LINE TEXTURE
PATMLT,	1		/LINE PATTERN MULTIPLIER
ARETXT,	0		/AREA TEXTURE
ACHRST,	0		/AREA TEXTURE ALPHABET
NEGFLG,	0		/NEGATIVE WRITING MODE FLAG
WRMODE,	0		/WRITING MODE (0=OVERLAY, 1=REPLACE, 2=COMPLEMENT,
			/  3=ERASE)
SHDFLG,	0		/SHADE FLAG 0=OFF 1=ON
YREFLN,	0		/Y REFERENCE LINE USED FOR SHADING
YREFLG,	0		/Y REFERENCE FLAG INDICATING LINES POSITION
YREF,	0		/Y REFERENCE CLIPPED CO-ORDINATE
/
