/
/ --------------------------------------------------------------------
/ ZTABLE - DISPATCH TABLE FOR PRIMITIVE COMMANDS HANDLED IN THIS FIELD
/ --------------------------------------------------------------------
/
ZTABLE,	ZDMYSB		/00
	ZDMYSB		/01
	ZDMYSB		/02
	ZDMYSB		/03
	ZDMYSB		/04
	ZDMYSB		/05
	ZDMYSB		/06
	ZDMYSB		/07
	ZDMYSB		/08
	ZDMYSB		/09
	ZDMYSB		/10
	ZDMYSB		/11
	ZDMYSB		/12
	ZDMYSB		/13
