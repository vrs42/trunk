	CLA CLL
	TAD I	MOVE		/GET POINTER TO SOURCE
	DCA	AUTO17
	ISZ	MOVE
/
	TAD I	MOVE		/GET POINTER TO DESTINATION
	DCA	AUTO16
	ISZ	MOVE
/
	TAD I	MOVE		/GET WORD COUNT
	CIA			/2'S COMPLEMENT FOR LOOP CONTROL
	DCA	ZTEMP
	ISZ	MOVE
/
MOVE4,	TAD I	AUTO17		/GET FROM SOURCE
	DCA I	AUTO16		/PUT TO DESTINATION
	ISZ	ZTEMP		/INCREMENT COUNTER
	JMP	MOVE4		/LOOP UNTIL COUNTER EXHAUSTED
/
	JMP I	MOVE		/RETURN

