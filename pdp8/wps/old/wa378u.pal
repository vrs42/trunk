	AND	P377 		/ STRIP GARBAGE				/M160
	TAD	(-XOF) 		/ XOF?
	SNA 			/ ++++
	JMP	CHKXN1 		/ JUMP IF SO
	TAD	(XOF-XON) 	/ XON?
	SZA CLA 		/ ++++
	ISZ	CHKXNF 		/ SKIP IF SO
	JMP I	CHKXNF
CHKXN1,	AC0001 			/ ++++
	JMP I	CHKXNF
