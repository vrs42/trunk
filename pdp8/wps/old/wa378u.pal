/ INTRPT - CURVE FITTING INTERPOLATION TABLE
/------------------------------------------------------------------------------
/
DECIMAL
INTRPT,	-9
	125
	13
	-1
	-14
	117
	29
	-4
	-16
	104
	48
	-8
	-15
	87
	68
	-12
	-12
	68
	87
	-15
	-8
	48
	104
