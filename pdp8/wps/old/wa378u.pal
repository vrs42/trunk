DVER,	CLA CMA			/DIVIDE ERROR
	DCA	LORDER
	CMA
	CLL RAR
	DCA	HORDER
	TAD	HORDER
	DCA	EXP
	ISZ	FLAG
	NOP
	JMP	DEXIT
