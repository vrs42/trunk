SLPDXL,	0		/LOW WORD
SLPDYH,	0		/DOUBLE PRECISION WORD FOR DELTAY (HIGH WORD)
SLPDYL,	0		/LOW WORD
SLPOFS,	0		/INDICATES TYPE OF LINE AND DIRECTION OF SLOPE
XDIF,	0		/INDICATES X TRAVERSING DIRECTION
YDIF,	0		/INDICATES Y TRAVERSING DIRECTION

/*/*/*	WARNING - THIS TABLE MUST REMAIN IN THIS ORDER */*/*/
/
MINX,	SRNLHX		/MINIMUM VALUE OF X CO-ORDINATE
MAXX,	SRNRHX		/MAXIMUM VALUE OF X CO-ORDINATE +1 (800.)
