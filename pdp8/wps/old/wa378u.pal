HOBLK,	0	/STOREAGE OF THE H/O BLK FOR I/O
LOBLK,	0	/STOREAGE OF THE L/O BLK FOR I/O
WINPTR,	0	/TEMP POINTER AREA
RDMODE,	0	/MODE BIT FOR WINNIE I/O
RDBUFO,	0	/POINTER TO BUFFER AREA FOR WINNIE
