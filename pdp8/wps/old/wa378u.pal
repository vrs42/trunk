TIMESW,	0			/FIRST TIME SW
SYHDLR,	RX2SYS			/RX02HNDLER
SVDEN,				/SAVE DENSITY***CAUTION***/M026
INCSAV,	0	/SAVE				/A032
K1400,	1400					
K400,	400								
K2,	2								
