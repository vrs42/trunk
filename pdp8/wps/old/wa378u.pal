DIGIT,	0			/STORAGE FOR DIGIT (FP ROUTINES)
SIGN,	0			/=0 IF PLUS; = 7777 IF MINUS
DNUMBR,	0			/= NUMBER OF DIGITS
CURX,	ZBLOCK 3		/CURRENT X POSITION(FP NOTATION)
CURY,	ZBLOCK 3		/CURRENT Y POSITION(FP NOTATION)

CURACT,	
CURVEF,	0			/CURVE FUNCT NOT IN PROGRESS (CURVE TERMINATED)
				/CURVE ACTIVE FLAG. 0 SAYS NO CURVE IN PROGRESS
				/AND 3 IF CURVE ACTIVE. (USED TO CALCUALTE PRIM
				/CALL)
