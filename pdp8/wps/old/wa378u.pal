RDERROR,
WRTERROR,
TRNERR,
	CLA CLL CMA RAL		/-2 WORD COUNT+1
	DCA	RDCNT
	TAD	(CMNDBF		/PNTR
	DCA	WINPTR
	TAD	WINFLD		/FIELD
	DCA	RD1SET
	TAD	(WINERS		/GET STATUS
	JMS	TRLOOP		/GET STATUS
	TAD	WRD1		/GET IT
