	JMS I	XGETNU		/GET INPUT
	JMP	SOPCEX		/NOT A VALID NUMBER, SO EXIT
	TAD	NUMMER+2	/GET THE NUMMER
	DCA	CURSOR+1	/SAVE IT IN THE CURSOR CONTROL BLOCK

	TAD 	(CURSOR
	DCA	REPLY

SOPCEX,	TAD	CHAR		/GET THE LAST CHAR
	JMP I	SOPC		/AND RETURN WITH IT

CURSOR,	7774			/TELLS THE VT125 MODULE THIS IS A CURSOR CMD
	0			/STORAGE FOR THE ARGUMENT


