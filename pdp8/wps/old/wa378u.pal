CLKLIM,	-12 			/ ++++
	-74	/ seconds	/ ++++
	-74	/ minutes	/ ++++
	-30	/ hours		/ ++++
	0 			/ CLOCK COUNTER LIMITS

TIMER,	ZBLOCK	4		/ "BREAK TIME" "STOP TIME" TIME		/A041

