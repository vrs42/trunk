				/ (max. of 30 words, 2 entries/word)


/ Equates for Footnote Processing					/A002

ECSTFN=74		/ Start of footnote (left angle bracket)	/A002
ECNDFN=76		/ End of footnote (right angle bracket)		/A002
SUPBIT=1000		/ Superscript bit				/A002
DECIMAL
MAXCOL=238		/ Maximum column number is 238 decimal		/A005
OCTAL

