/RD3SET,	CDFSYS							/M033
/	TAD I	RDBUFO	/GET CHAR
/	CDFSYS								/M033
/	RDTD		/SEND DATA
/	ISZ	RDBUFO
/	JMP	RDFNXA
/
/RDDSTY,
/	JMS	WINCMD
/	WINSTA		/GET STATUS
/	RDTD			/GET IT
/	JMP	RZEXIT		/EXIT
