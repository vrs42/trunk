SLNMOD=JMS I .;ECSLMD		/ Footnote equivalent of some editor routines.
ADVPTR=JMS I .;ECAPTR		/  ...
BKPPTR=JMS I .;ECBPTR		/
INSCHR=JMS I .;ECICHR		/ INSCHR
INSTCH=JMS I .;ECNCHR		/ INSERT				/A005
GETCHR=JMS I .;ECGCHR		/ CURMOV & LODCHR
MOVCHR=JMS I .;CRSTMV		/ CURMOV only.
LOADCH=JMS I .;ECLOAD		/ LODCHR
UPDSCN=JMS I .;FXSCRN		/ FXSCRL
CHKSCN=JMS I .;CKSCRN		/ TSTLIM & FXSCRL
PUTCHR=JMS I .;PTCHRS		/ Output a string of 7 bit characters.

CALEDT=JMS I .;CALLAR		/ Linkage to editor 'CALLAR' routine.
NXTCHR=JMS I .;FNXCHR, 0	/ Get next char (= GETCHR /or/ ADVPTR)	/A003

MAXCHR=40			/ Maximum size of word (32 decimal).
NLINES=11			/ Number of lines within scrolling region.
FLINES=24			/ # of lines in footnote scrolling region/A003
BUF0LEN=226			/ length of correct word buffer (150 dec.)
