AREPAT,	570; 377; 377; 377; 377; 377; 377; 377; 377	/PRAM (GETS MODIFIED)
	7777
SAREA,	514
SAREP1,	22; 0; 0; 0; 0; 0; 0				/FIGS
	550						/GCHRD
	7777						/TERMINATOR
/
/
DRWPRM,	ZBLOCK	0012		/STORAGE FOR 'DRAW'S PRAM STRING
				/(THIS IS BIG ENOUGH FOR LONGEST PRAM STRING)
/
/ POSITION CURSOR
