SAVEDX,	0
	DCA	SAVETM		/SAVE THE PARAMETER
	TAD	SAVETM		/PUT LOW EIGHT BITS ON STRING
	AND	K0377
	DCA I	AUTO10
	TAD	SAVETM		/PUT HIGH FOUR BITS ON STRING (EXTEND SIGN)
	BSW
	RTR
	AND	K0017
	DCA	SAVETM
	TAD	K0010
	AND	SAVETM
	SZA CLA
	TAD	K0060
	TAD	SAVETM
	DCA I	AUTO10
	JMP I	SAVEDX
/
SAVETM,	0
K0060,	0060
