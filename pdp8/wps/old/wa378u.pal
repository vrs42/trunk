SETCNT=4		/SET BLOCK COUNT
DISCNT=2		/DISMOUNT COUNT
MNTCNT=12		/MOUNT COUNT
/************************************************************
RDNOSW,	0	
	RDSC		/SPACE SAVER TO HERE		/A032
