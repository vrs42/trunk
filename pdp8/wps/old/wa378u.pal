/
/NORMALIZE FLOATING POINT ACCUMULATOR
/
*6200
FNORM,	0
	CLA CLL
	DCA	MP1		/0 # OF SHIFTS
	DCA	MP3		/RESET SWITCH
	TAD	HORDER
	SPA			/INPUT < 0
	ISZ	MP3		/YES, SET SWITCH
	SZA CLA			/FAC = 0 ?
	JMP	GO6		/NO
	TAD	LORDER
	SZA CLA
	JMP	GO6		/NO
	TAD	OVER2
	SZA CLA
	JMP	GO6		/NO
	DCA	EXP		/YES
	JMP I 	FNORM		/EXIT
GO6,	TAD	MP3
	SZA CLA			/WAS INPUT < 0
	JMS	ACNEG		/YES
SHIFT,	TAD	HORDER
	CLL RAL
	SPA CLA			/TOO FAR ?
	JMP	NOREXT		/YES, EXIT ROUTINE
	TAD	OVER2		/NO
	CLL RAL
	DCA	OVER2		/SHIFT LEFT
	TAD	LORDER
	RAL
	DCA	LORDER
	TAD	HORDER
	RAL
	DCA	HORDER
	ISZ	MP1		/ADD 1 TO COUNT
	JMP	SHIFT		/CONTINUE
NOREXT,	TAD	MP1		/SUBTRACT COUNT FROM EXPONENT
	CMA IAC
	TAD	EXP
	DCA	EXP
	TAD	MP3		/WAS INPUT < 0 ?
	SZA CLA
	JMS	ACNEG		/YES
	JMP I	FNORM		/EXIT



