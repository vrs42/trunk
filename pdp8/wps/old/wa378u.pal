	ISZ	MONTH
	ISZ	T1
	TAD I	T1
	SPA 			/ ++++
	JMP	.-4
	CIA
	TAD I	T1
	DCA	DAMNTH 		/ AND DAY OF MONTH
	AC7777
	TAD	YEAR 		/ NOW DO DAY OF WEEK
	CLL RAR
	CLL RAR
	TAD	YEAR
	TAD	DAYEAR
