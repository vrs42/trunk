/DALBLK,	GTCSET			/PRIMITIVES COMMAND BLOCK TO PASS
/	0000			/  DISPLAY ALPHABET SELECTION


SNDPAT,	0
	TAD	PATTRN
	DCA	PATRN		/SAVE THE CURRENT PATTERN VALUE
