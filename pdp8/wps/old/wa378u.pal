RDONXT,							/A036
	JMS	RZSETA					/M037
	RD1SET						/M037
	RD2SET						/M037
	RD3SET
	RD4SET						/M037
/D037	RD5SET
	0		/TERMINATOR			/M037
	TAD	RZXDIR						/A032
	JMS	RZXJMP		/JMP SUB			/A032
	RDWRIT			/-2=WRITE A BLK			/A032
	RDREAD			/-4=READ				/A032
	RDMNT			/-6=MOUNT VOLUME
