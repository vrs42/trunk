/
/   GET DATE FROM PANEL MEMORY						/122
/
PCMDAT,									/122
	ISZ	PCMRD1		/INC PTR				/122
	JMS	PCMRD		/READ CHAR FROM P.M.			/122
	JMP	U1XLAB		/IS A CHAR				/122
