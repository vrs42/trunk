	IFDEF	WINNIE	<
/
/
/ENTRIES IN DRIVE TABLE =
/				0  =  SINGLE DENSITY OR NO ENTRY	/A034
/			      400  =  DOUBLE DENSITY RX02		/A034
/			     1400  =  -------------- RX50		/A034
