WRSEND,									/A018
	XX								/A018
	CLA								/A018
	TAD	T1		/ IF ZERO THEN ENO OF FILE		/A018
	SZA CLA								/A018
	JMP I	WRSEND							/A018
	TAD	(74)		/ END OF DOCUMENT IN UPPER CASE		/A018
	CIFFIO								/A018
	FILEIO								/A018
	XPUTSB								/A018
	CLA								/A018
	JMP I	WRSEND							/A018

