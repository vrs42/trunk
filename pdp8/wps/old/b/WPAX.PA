	DCA	.+1
	XX 			/ ROUTINE TO CALL
/
AXDS4,
	CLA
	TAD	AXDT6
	TAD	(AXPBA-1)
	DCA	AXDT4 		/ COPY THE INPUT INTO THE CORRECT AREA
