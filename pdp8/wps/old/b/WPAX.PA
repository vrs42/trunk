AXSRP1,	XX
AXSRP2,	XX
/
	JMP	AXSNOX 		/ SPFLAG RETURN
	JMP	AXSNOX 		/ TIMED OUT
/
	JMP I	AXSRPK
/
/	AXSNO2 - SEND LIST NOT IMPLEMENTED YET MESSAGE IF THE USER TRIES TO USE
/	ALIST SPECIFICATION.
/
AXSNO2,
	JMS	AXSRPK
	NOEXST
	TYPNO
/
	JMP	AXSNOX
/
