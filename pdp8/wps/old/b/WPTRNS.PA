/
/	TRNAGN - WAITS FOR THE HOST JOB TO RESPOND TO THE SPFLAG
/
TRNAGN,	AC0001 			/ SET THE FLAG INCASE IT WASNT SET
	JMS	HSTSET 		/ SET THE FLAG AND WAIT FOR THE HOST TO GET IT
	 JMP	RTNSY 		/ GO BACK TO MAIN MENU
	JMS	CLDOC 		/ CLOSE THE DOCUMENT
	JMP	TRNCN2

/
/	HSTSET -  SETS SPFLAG TO TELL THE HOST SOMETHING  AND WAITS
/	FOR HOST TO SAY IT RECEIVED IT
/
HSTSET,	XX
	DCA	SPFLAG
HSTSE2,	JMS	HLTEST 		/ ++++
	 JMP I	HSTSET
	TAD	HSFLAG 		/ SEE IF THE HOST STOPPED
	SNA CLA 		/ ++++
	 JMP	HSTSE2
	ISZ	HSTSET
	JMP I	HSTSET

/
/	RSTPRG - THE HIGH LEVEL INIT ROUTINE
/	IT WILL SEND AN INITALIZE MESSAGE EVERY
/	5 SECONDS AND WAIT FOR A INITALIZE ACK
/
RSTPRG,	TAD	(INITYP-1)
	JMS	INIBFS
	 JMP	HSTWAT 		/ SPFLAG IS SET SO WAIT
	 JMP	TIMEOU 		/ TIMED OUT
	ISZ	INIFL3 		/ SET IT SO ONLY ONE INIT IS SENT
	JMP	HSTJWT 		/ WAIT FOR OTHERS TO SEE WHAT IS DONE

/
/	CPYITM - COPY FROM THE COMMUNICATIONS KEYBOARD BUFFER TO MENU'S
