	"c-200 			/ c
	"o-200 			/ o
	"n-200 			/ n
	"n-200 			/ n
	"e-200 			/ e
	"c-200 			/ c
	"t-200 			/ t
	"e-200 			/ e
	"d-200 			/ d
	" -200 			/
	"t-200 			/ t
	"o-200 			/ o
	" -200 			/
	"a-200 			/ a
	" -200 			/
	> 			/ End IFNDEF ENGLSH

	IFDEF ITALIAN <
	"C-200
	"o-200
