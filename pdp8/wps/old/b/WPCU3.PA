/
/	DECKST - CHECK FOR START OF DEAD
/
INT8BT=62			/ EIGHT BIT INTRODUCER
DECKST,	TAD	(40-ECSTOV)	/ IS THIS A START-OF-DEAD CHAR
	SZA			/ SKIP IF SO
	JMP	DECKL3		/ ELSE IGNORE CONTROL CHARACTER
/
	JMS GETNXT		/ IF S-O-D CHECK THE NEXT 2 CHARS FOR A
				/ MNC. IGNORING ALL ELSE
/
	TAD	(-ECSPC)	/ CHECK 2ND CHAR
	SZA			/ SKIP IF ITS OK
	JMP	DENOTS		/ ELSE ITS NOT AN 8 BIT CHARACTER
/
	JMS	GETNXT
/
	TAD	(-INT8BT)	/ CHECK FOR 8 BIT INTRODUCER
	SZA			/ SKIP IF OK
	JMP	DENOTI		/ ELSE ITS NOT AN 8 BIT CHARACTER
/
	JMS	GETNXT		/ GET THE 8 BIT CHARACTER
/
	TAD	(200)		/ MAKE IT REALY 8 BIT
	JMP	DEDSOU		/ AND OUTPUT IT
/
DENOTI,	TAD	(INT8BT-ECSPC)	/ REPLACE INTRODUCED VALUE
DENOTS,	TAD	(ECSPC-40)	/ REPLACE SPACE VALUE
	SPA			/ SKIP IF PRINTABLE
	JMP	DECKL3		/ ELSE IGNORE
	TAD	(40)
	JMP	DEDSOU		/ O/P CHARACATER
/
GETNXT,	XX
	CDFBUF			/ GET A CHARACTER
	TAD I	X2
	CDFMYF
	AND	P177		/ AND MASK OFF ATTS
	JMP I	GETNXT

