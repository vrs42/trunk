/	**************************************************************
/	****                                                      ****
/	**** PLEASE UPDATE THE FOLLOWING VALUES FOR EACH REVISION ****
/	****                                                      ****
/	****    REASSEMBLE MENU MODULES IF VALUES ARE CHANGED     ****
/	****                                                      ****
/	**** DO NOT UPDATE EDIT HISTORY EVERY TIME VALUES CHANGE  ****
/	****                                                      ****
/	**************************************************************

SYSVER=	"3	/ DEFINE SYSTEM SOFTWARE VERSION NUMBER
SYSBAS=	"0	/ DEFINE SYSTEM BASE LEVEL NUMBER
SYSREV=	"E	/ DEFINE BASE LEVEL REVISION NUMBER

ROMHIG= "4	/ DEFINE SLUSHWARE VERSION HIGH DIGIT
ROMMID= "1	/ DEFINE SLUSHWARE VERSION MID  DIGIT
ROMLOW= "2	/ DEFINE SLUSHWARE VERSION LOW  DIGIT

DECIMAL
SYSTYP=	378	/ DEFINE SYSTEM TYPE (DECIMAL NUMBER REPRESENTATION)
/ENGLSH=	1	/ DEFINE SYSTEM LANGUAGE (ENGLISH)
DUTCH= 1	/ DEFINE LANGUAGE AS DUTCH
PWDECM= 1	/ DEFINE SYSTEM PRINTWHEEL DEC MULTINATIONAL

		/ ** NOTE ** DAY SHOULD BE AT LEAST 13 FOR DATE AND TIME MENU
BLDDY=	25	/ DEFINE DAY THAT SOFTWARE IS BUILT (13..31)
BLDMO=	01	/ DEFINE MONTH THAT SOFTWARE IS BUILT (01..12)
BLDYR=	85	/ DEFINE YEAR THAT SOFTWARE IS BUILT (00..99)

EXPMN=	12	/ DEFINE MONTH THAT SOFTWARE EXPIRES (01..12)
EXPYR=	85	/ DEFINE YEAR THAT SOFTWARE EXPIRES (00..99)
OCTAL		/ SOFTWARE EXPIRES ON FIRST DAY OF MONTH INDICATED

DECDEV= 1	/ Decmate Development Environment

/FLDTST=	1	/ DEFINE FIELD TEST SOFTWARE FOR MENU DISPLAY
/DEMO=	1	/ DEFINE FUNCTIONS AVAILABLE FOR CUSTOMER DEMOS ONLY
/DEVEL=	1	/ DEFINE FUNCTIONS AVAILABLE TO DEVELOPMENT GROUP ONLY
UNBUND= 1	/ ENABLE THE FEATURE UNBUNDLING CODE

