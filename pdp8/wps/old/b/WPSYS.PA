	CLA; JMS DOBIOT		/ SET COMMAND REGISTER.
	AC7777			/ clear...
	  CIFSYS		/ input buffer...
	  HS2OU			/ of any previous...
	  NOP			/ garbage...(AND ISSUE XON)
	CIFSYS			/ clear input buffer			/A064
	  HS2IN			/ OF PENDING CHARACTERS			/A064
	SKP CLA			/ SKIP WHEN ALL MT. (that's empty)	/A064
	JMP	.-3		/ GO GET THE NEXT ONE (& TOSS IT OFF).	/A064
	JMP I	CUSVL	/ exit	/

SLUAD,	0 / 000 000 00d ddd	/ DATA bits
SLUAP,	0 / 000 000 000 0pp	/ PARITY
SLUAS,	0 / 000 000 000 0ss	/ STOP bits
SLUAB,	0 / 000 000 00b bbb	/ BAUD rate

