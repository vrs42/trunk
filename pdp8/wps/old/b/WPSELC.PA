	FIELD 0
	*200
	JMP I	.+3
	JMP I	.+1
	7600
	RXLOAD
	*RXLDLS
	RXEWT=4
	RXEWT
	0
	RXQBLK=11
	RXQBLK
	.

	DLOSEL; 200;CDF 20;-DSOSEL	/WRITE OUT WPSELC	/M001
	DLOSOV;2200;CDF 30;-DSOSOV	/WRITE OUT AN OVERLAY	/MOO1
