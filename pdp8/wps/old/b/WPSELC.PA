/DISPLAY THE RECORD NO. BEING PROCESSED					/M019
DISREC,	XX								/M019
	AC0001			/ SET RECORD NUMBER FOR OUTPUT		/A019
	TAD	RECNUM
	DCA	DISRE1		/ STORE NUMBER FOR OUTPUT		/A019

	CIFMNU								/A019
	JMS I	IOACAL							/A019
	0								/A019
	DISMSG			/ ADDRESS OF TEXT STRING TO OUTPUT	/A019
	0000			/ ^P - POSITION CURSOR TO HOME		/A019
DISRE1,	.-.			/ ^D - RECORD NUMBER TO OUTPUT		/A019
				/ ^L - ERASE TO END OF LINE		/A019
	0100			/ ^P - POSITION CURSOR (LINE 1, COL. 0)	/A019
				/ ^L - ERASE TO END OF LINE		/A019
	2700			/ ^P - POSITION CURSOR (LINE 27, COL. 0)/A042

	JMP I	DISREC		/RETURN
