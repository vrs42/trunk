/013	WCE	 4-JUN-84	ADDED WRITEOUT FOR SO7 MENU PAGE
/012	GDH	27-OCT-81	RXHAN load sequence changes.
/011	AIB	22-Oct-81	added error reporting block DLMLP8
/010	GDH	28-Sep-81	added writeout of block SO5.
/009	GDH	25-Sep-81	added writeout of block CX7.
/008	GDH	 3-Sep-81	Newer write-out code conventions.
/007	GDH	 1-Sep-81	New write-out code conventions.
/006	GR	 6-AUG-81	REDEFINED ONE OF THE EDITOR BLOCKS
/005	GR	 5-AUG-81	ADD BLOCKS FOR LP MATH ERROR HANDLING
/004	WCE	13-JUL-81	ADD COMMENTS TO WRITE OUT LIST
/003	TT	09-JUL-81	REMOVE SUPERFLUOUS CONDITIONALS
/002	PHA	5-MAY-81	ADD GLOBAL SEARCH MENU
/001	AJF	15-OCT-80	ADD SORT MENU
/3.0	MSB	8-AUG-78	ADD ANOTHER COMMUNICATIONS MENU FOR TEST DOC.
/III.C	KEE	27-MAR-78	ADD 3 SYSTEM OPTIONS MENUS + 2 TD MENUS
/III.1	KEE	2/11/78 	ADD TRANSFER DOCUMENT MENUS
/2.7-D	KEE	2/1/78  	SPLIT MENU ASSEMBLIES
/2.7-2	KEE	1/5/78  	ADD MAGCRD RULER MENU 'DLMRLR'
/2.5-3	RLT	11/3/77		ADD CP2 MENU
/2.5-2	LDB	11/1/77		ADD SA AND CP MENUS FOR WT78 ONLY
/2.5-1	RLT	10/21/77	ADD LOGON MENU FOR WT78 ONLY
/2.4D+	RLT	10/18/77	ADD PS4 MENU
/2.4C+	KEE	10/12/77	ADD CI MENU
/2.P-4	KEE	9/17/77		ADD FIRST 2 CX MENUS
/2.N	KEE	9/10/77		ADD MENU 'LCK'
/2.J	KEE	8/26/77		ADD MENU PAGE 'QD1'

/
/	COMP MU<MTMPLT,MU
/	LOAD MU,RXHAN,WTMU
/

