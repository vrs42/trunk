/
/	THE FOLLOWING EQUATES ARE SET UP TO ALLOW FOR ANY CHANGE
/	IN THE TABLE LAYOUT IN DLHLP0,DLHLP1 MENU'S
/	THE EDITOR PASSES A NUMBER EQUAL TO THE POSITION
/	IN THE TABLE OF THE MENU TO DLHL01.
/	IN CASE THE TABLE IS CHANGED THE CORRESPONDING CHANGES
/	TO THESE EQUATES ARE NECESSARY.
/ ***THE SEQUENCE OF THESE CODES CORRESPOND TO THE POSITION OR
/ ****ORDER THAT THEY APPEAR ON THE SCREEN IN THE HELP MENU
/
/	THE FOLLOWING CODES ARE FOR GOLD KEYS

	Y=0
	HABBR=Y;Y=Y+1		/ GOLD: ABBREVIATION
	HADV=Y;Y=Y+1		/ GOLD: ADVANCE
	HBACK=Y;Y=Y+1		/ GOLD: BACKUP
	HBOLD=Y;Y=Y+1		/ GOLD: UN BOLD
	HBOTT=Y;Y=Y+1		/ GOLD: BOTTOM OF DOC
	HCNTR=Y;Y=Y+1		/ GOLD: CENTER
	HCMND=Y;Y=Y+1		/ GOLD: COMMAND
	HCONTS=Y;Y=Y+1		/ GOLD: CONTINUE SEARCH
	HCNTSS=Y;Y=Y+1		/ GOLD: CONTINUE SEARCH AND SELECT

	IFDEF	CONDOR	<						/A006
	HRUBS=Y;Y=Y+1		/ GOLD: RUBBOUT SENTENCE
			>	/ END IFDEF CONDOR			/A006

	HCUT=Y;Y=Y+1		/ GOLD: CUT
	HDATM=Y;Y=Y+1		/ GOLD: DATE AND TIME
	HDEAD=Y;Y=Y+1		/ GOLD: DEAD KEY
	HDELTX=Y;Y=Y+1		/ GOLD: DELETE CHARACTER
	HFILE=Y;Y=Y+1		/ GOLD: FILE DOCUMENT
	HGET=Y;Y=Y+1		/ GOLD: GET DOCUMENT
	HLHLT=Y;Y=Y+1		/ GOLD: HALT
	HHYPUL=Y;Y=Y+1		/ GOLD: HYPHEN PULL
	HINSH=Y;Y=Y+1		/ GOLD: INSERT HERE = GOLD: PASTE
	HLIBRY=Y;Y=Y+1		/ GOLD: LIBRARY
	HMENU=Y;Y=Y+1		/ GOLD: MENU
	HNEWP=Y;Y=Y+1		/ GOLD: NEW PAGE
	HPAGE=Y;Y=Y+1		/ GOLD: PAGE
	HPMARK=Y;Y=Y+1		/ GOLD: PAGE MARKER
	HPAMAR=Y;Y=Y+1		/ GOLD: PARAGRAPH MARKER
	HPASTE=Y;Y=Y+1		/ GOLD: PASTE
	HPHYP=Y;Y=Y+1		/ GOLD: PRINT HYPEN

	IFDEF	CONDOR	<						/A006
	HREMV=Y;Y=Y+1		/ GOLD: REMOVE = GOLD: CUT
			>	/ END IFDEF CONDOR			/A006

	HREPL=Y;Y=Y+1		/ GOLD: REPLACE
	HRUBL=Y;Y=Y+1		/ GOLD: RUBOUT LINE

	IFNDEF	CONDOR	<						/A006
	HRUBS=Y;Y=Y+1		/ GOLD: RUB SENT			/A006
			>	/ END IFNDEF CONDOR			/A006

	HRULER=Y;Y=Y+1		/ GOLD: RULER
	HINVPR=Y;Y=Y+1		/ GOLD: INVISIBLE PRINT SHIFT PRINT HYPEN
	HSPACE=Y;Y=Y+1		/ GOLD: NON-BREAKING SPACE
	HSRCH=Y;Y=Y+1		/ GOLD: SEARCH
	HSRCHP=Y;Y=Y+1		/ GOLD: SEARCH PAGE
	HSUBSC=Y;Y=Y+1		/ GOLD: SUBSCRIPT
	HSUPER=Y;Y=Y+1		/ GOLD: SUPER SCRIPT

	IFDEF	CONDOR	<						/A006
	HSWAP=Y;Y=Y+1		/ GOLD: SWAP
			>	/ END IFDEF CONDOR			/A006

	HTAB=Y;Y=Y+1		/ GOLD: TAB				/A007
	HTABP=Y;Y=Y+1		/ GOLD: TAB POS				/A007
	HTOPD=Y;Y=Y+1		/ GOLD: TOP DOCUMENT
	HUNDER=Y;Y=Y+1		/ GOLD: UN UNDERLINE
	HUPPER=Y;Y=Y+1		/ GOLD: UPPERCASE
	HVIEW=Y;Y=Y+1		/ GOLD: VIEW

	IFNDEF	CONDOR	<						/A006
	HRPREV=Y;Y=Y+1		/ GOLD: PREV SCREEN			/A006
	HRNEXT=Y;Y=Y+1		/ GOLD: NEXT SCREEN			/A006
			>	/ END IFNDEF CONDOR			/A006

	IFDEF	CONDOR	<						/A006
	HUPAR=Y;Y=Y+1		/ GOLD: UP ARROW
	HDNAR=Y;Y=Y+1		/ GOLD: DOWN ARROW
	HLFAR=Y;Y=Y+1		/ GOLD: LEFT ARROW (BOL)
	HRTAR=Y;Y=Y+1		/ GOLD: RIGHT ARROW (EOL)
			>	/ END IFDEF CONDOR			/A006

/ THE FOLLOWING CODES REPRESENT STANDARD EDITING KEYS

	HKADV=Y;Y=Y+1		/ ADVANCE
	HKBACK=Y;Y=Y+1		/ BACKUP
	HKBOLD=Y;Y=Y+1		/ UN BOLD
	HKCUT=Y;Y=Y+1		/ CUT
	HKDELC=Y;Y=Y+1		/ DELETE CHAR
	HKDELW=Y;Y=Y+1		/ DELETE WORD
	HKLINE=Y;Y=Y+1		/ LINE
	HKPAGE=Y;Y=Y+1		/ PAGE
	HKPARA=Y;Y=Y+1		/ PARAGRAPH
	HKPAST=Y;Y=Y+1		/ PASTE
	HKSEL=Y;Y=Y+1		/ SELECT
	HKSENT=Y;Y=Y+1		/ SENTENCE
	HKTABP=Y;Y=Y+1		/ TAB POSITION
	HKUNDE=Y;Y=Y+1		/ UNDERLINE
	HKUPPE=Y;Y=Y+1		/ UPPERCASE
	HKWORD=Y;Y=Y+1		/ WORD
	HKENTE=Y;Y=Y+1		/ ENTER

/	ARROW KEYS

	IFDEF	CONDOR	<						/A006
	HALTC=Y;Y=Y+1		/ ALT CHAR				/A007
	HRUBW=Y;Y=Y+1		/ CTRL RUBOUT=RUB WORD			/A006
	HRFIND=Y;Y=Y+1		/ FIND=GOLD SEARCH
			>	/ END IFDEF CONDOR			/A006

	HRHYPP=Y;Y=Y+1		/ HYPH PULL

	IFDEF	CONDOR	<						/A006
	HRINSH=Y;Y=Y+1		/ INSERT HERE =PASTE
	HRNEXT=Y;Y=Y+1		/ NEXT SCREEN
	HRPREV=Y;Y=Y+1		/ PREV SCREEN
	HRREMV=Y;Y=Y+1		/ REMOVE = CUT
			>	/ END IFDEF CONDOR			/A006

	HRUBC=Y;Y=Y+1		/ RUBOUT=RUB CHAR OUT			/A006

	IFDEF	CONDOR	<						/A006
	HRSEL=Y;Y=Y+1		/ SELECT=SELECT
			>	/ END IFDEF CONDOR			/A006

	IFNDEF	CONDOR	<						/A006
	HRUBW=Y;Y=Y+1		/ RUB WORD OUT				/A006
	HSWAP=Y;Y=Y+1		/ SWAP					/A006
			>	/ END IFNDEF CONDOR			/A006

	HUDK=Y;Y=Y+1		/ UDK					/A007
	HRUP=Y;Y=Y+1		/ UP ARROW
	HRDN=Y;Y=Y+1		/ DOWN ARROW

	IFDEF	CONDOR	<						/A006
	HRLF=Y;Y=Y+1		/ LEFT ARROW
	HRRT=Y;Y=Y+1		/ RIGHT ARROW
			>	/ END IFDEF CONDOR			/A006

/ DEFINES FOR THE LINE POSITION OF MESSAGES

	HLPLNS=-1		/ CONTINUE LINE
	HLPLNA=1004		/ FIRST LINE =10 POS=5
	HLPLNB=1104		/ SECOND LINE =11 POS=5
	HLPLNC=1204		/ THIRD LINE =12 POS=5
	HLPLND=1304		/ FOURTH LINE =13 POS=5


