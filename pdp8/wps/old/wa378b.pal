	JMS RTRN4		/GO INITIALIZE MATH MODULE VALUES	/A018

	CDFBUF		/STORED IN BUFFER FIELD
	AC0001			/GET FROM RECORD NUMBER
	TAD I	(SPCADR)
	DCA	T1

/	THE FROM RECORD COUNT RANGES FROM 1 TO 4095.  A FROM COUNT OF	/A042
/	ZERO MEANS START AT THE FIRST RECORD.  IN ORDER TO FACILATE THE /A042
/	COUNTING OF RECORDS AND THE RANGE CHECKS, THE FROM COUNT HAS 	/A042
/	SHIFTED DOWN BY ONE UNIT TO ALLOW FOR THE MAXIMUN OF 4095.	/A042

	TAD I	T1		/PICK UP THE FROM RECORD COUNT
	CDFMYF
	SZA			/OK IF ZERO START RECORD		/A042
	TAD	(-1		/DECREMENT THE COUNT			/A042
/D042	CIA			/NEGATE
	DCA	FRREC		/AND  STORE IT AWAY
	ISZ	T1		/GET TO RECORD NUMBER
	CDFBUF
	TAD I	T1
	CDFMYF
/D042	CIA			/NEGATE
	DCA	TOREC		/AND STORE
	CDFBUF
