	SNA CLA		/IF AC  0 				A007
	ERR002		/DISPLAY ERROR				A007
	JMP STPARS	/ELSE BEGIN PARSING NEXT LINE		A007


SPECNO,	0000
ORDWD,	0000	/USED TO SET KEY FIELD NAME DESCRIPTOR WORDS	A007
		/ORDER AND FTYPE, 1 IN ORDER MEANS SORT IS DESCENDING 	A007
		/ORDER, AND 1 IN FTYPE MEANS NUMERIC FIELD		A007
		/THIS VARIABLE IS FIRST SET TO 4000 AND THE 1 IN BIT 0	A007
		/IS SHIFTED ONCE TO RIGHT EACH TIME THROUGH PARSER	A007

FNCOUNT,0000

