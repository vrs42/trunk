	TSTUON			/ INTERRUPT CHAIN LINK			/A0068
TSTKBO,	U1TSF 			/ TEST THE OUTPUT FLAG			/M0020
	JMP I	TSTKBO-1 	/ NO OUTPUT--CONTINUE THE 'RUPT CHAIN	/M0020
