				/  BITS INTO AC10 & AC11		/A144
	BSW			/ AND BYTE SWAP THEM INTO AC4 & AC5	/A144
				/		     (MNRX7X & MNRX6X)	/A144
/d144	TAD	(MNRX6X)	/ APU BOARD PRESENT, SET THIS BIT
	TAD I	(RXTYPE		/ AND UPDATE WORD IN WPSYS
	DCA I	(RXTYPE		/
	JMP I	APUCHK		/ RETURN
>				/ END IFDEF CONDOR
