NONBNK,	0
DKACTF,	0			/THE ACTION FLAG BETWEEN THE DISK ROUTINE
				/TO THE MAIN PROG.
TSTFLG,	0			/FLAG INDICATING TEST MODE
EXRLR,	0			/FLAG USED BY DSKJOB TO TELL IF IN A RULER
RSNFLG,	0			/IF NON ZERO THIS TELLS DSKJOB TO PAUSE AND
				/WAIT FOR HT2JOB TO FINISH USING THE HOST
				/LINE FOR SENDING.


TSTACF,	0			/SET WHEN THE TEST JOB IS RUNNING.	/A013
