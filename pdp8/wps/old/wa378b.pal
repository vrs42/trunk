	156 			/ ++++
	">-200 			/ ++++
	0
DEAX2,
	"<-200 			/ ++++
	"#-200 			/ ++++
	">-200 			/ ++++
	0
DEAX3,
	"<-200 			/ ++++
	">-200 			/ ++++
	0
/
DECKDT,				/ USED TO COMPAY THE CURRENT CHARACTER IN DECKDS TO <
DEAX4,
	"<-200 			/ ++++
	0
