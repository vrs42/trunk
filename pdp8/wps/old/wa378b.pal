		CDFMYF
MSGAG1,		XX
		CDFMYF
MSGAG2,		XX
MSGFL3,	DCA	INBUFA 		/ CLEAR THE INPUT BUFFER
	JMP I	MSGFIL

CKDISF,	XX			/ 					/A039
	TAD	DISTMP		/ CK FLAG BEFORE CALL			/A039
	SZA CLA			/					/A039
	  JMP	MAINLW		/ HOST IS ACTIVE - RET AND WAIT		/A039
	TAD	CNGSCF		/ PICK UP VALUE				/A039
