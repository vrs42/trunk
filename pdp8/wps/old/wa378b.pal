WINSTF,	CAM		/IGNORE ERROR CODE(MOUNTED WINNIE CHK 		/C132
	TAD	(-GTVOL			/GET VOLUME		/A131
	DCA	WINFNC			/SET CODE		/A131
	JMP	WINNXT			/NEXT 			/A131
WINGTV,								/A131
	JMS	WININ1			/NEXT				/A131
	SMA CLA				/RETURN...  - = ERROR
	IAC				/DRIVE IS MOUNTED
	TAD	(4000			/WINNIE
	CDFACP				/ACP FIELD
	DCA I	T1			/SET IT IN TABLE		/C132
	CDFSYS				/THIS FIELD
WINNXT,							/A131
	ISZ	WINCUR			/INC DRIVE #
