	IFDEF ITALIAN<HALT=074>
	IFDEF ITALIAN<HALT1=076> /ALLOW UPPER-CASE GOLD-HALT IF ITALIAN
	IFDEF ENGCAN <HALT=047>
	IFDEF FRENCH <HALT=074>
	IFDEF FRENCH <HALT1=076> /ALLOW UPPER-CASE GOLD-HALT IF FRENCH	/A035
	IFDEF DUTCH <HALT=140>
	IFDEF GERMAN <HALT=074>
	IFDEF V30FAO <HALT=074>					/A165
	IFDEF V30FAO <HALT1=076>				/A165
	IFDEF SPANISH <HALT=074>				/A169
	IFDEF SPANISH <HALT1=076>				/A169
	IFDEF V30SWE <HALT=074>					/A166
