/
/	WAITING FOR SOMETHING TO BE SENT (RECEIVER)
/
WAITDT,
	XX
	CLA
	TAD	(MIN3) 		/ ++++
	DCA	DLYLIM
	JMP	WAITDG 		/ SEE IF THERE IS ANYTHING
WAITDW,
	CIFSYS 			/ ++++
	JWAIT
	JMS	SPTEST 		/ ++++
	JMP I	WAITDT 		/ SEE IF THE SPFLAG IS SET
	JMS	GETTM
