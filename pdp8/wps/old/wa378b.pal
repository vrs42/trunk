CONCR1,	JMS	RESPAN		/ restore panel if vt125		/a058
	JMP	CONCR		/ end of inpt screen			/a058

/***********************************************************************/a058
/ CLRPAN Clear out the first block of panel memoryry before 
/        blaSTING IF it is a VT125 GRAPHICS term emulator
/***********************************************************************/a058

CLRPAN,	XX			/ return address			/a058
	DCA	RESPAC		/ save ac				/a058
	JMS	CHK125		/ ARE WE A VT125?			/A058
	SKP			/ yes					/a058	
	JMP	CLRPN1		/ NO JUST RETURN			/A058
	JMS	BHOOK		/ CALL BLASTR				/A058
	-MVSWEN			/ MOVE OUT SWAP AREA TABLES		/A058
CLRPN1,									/A058
	TAD	RESPAC		/ restore ac				/a058
	JMP I	CLRPAN		/ RETURN		


/***********************************************************************/a058
/ RESPAN restore the fisrst block of panel memory once we have blasted	/a058
/	 if it is a VT125 emulator					/a058
/***********************************************************************/a058

RESPAN,	XX			/ RETURN ADDRESS			/A058
	DCA	RESPAC		/ save ac				/a058
	JMS	CHK125		/ ARE WE A VT125?			/A058
	SKP			/ yes					/a058
	JMP	RESPN1		/ NO JUST RETURN			/A058
	JMS	BHOOK		/ CALL BLASTR				/A058
	MVSWEN			/ MOVE BACK SWAP AREA GRAPHICS TABLES	/A058
RESPN1,									/A058
	TAD	RESPAC		/ restore ac				/a058
	JMP I	RESPAN		/ RETURN				/A058

RESPAC,	0								/a058

