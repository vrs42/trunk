	U1TSF=U1TFL+1
	U1TCF=U1TSF+1
	U1TCP=U1TCF+2
	U1TSK=U1TCP+1
	U1TLS=U1TSK+1
/
/	IFDEF FRENCH <ESC=031> 	/ ALLOW UPPER-CASE GOLD-HALT IF FRENCH /D035
	IFDEF FRENCH <ESC=033>  / ALLOW UPPER-CASE GOLT-HALT IF FRENCH /A035
/
