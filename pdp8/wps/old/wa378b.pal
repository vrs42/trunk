/

/RUBOUT OUT A CHARACTER
/WATCH OUT FOR UDK BEGINNING, BUFFER BOUNDRY, BLOCK HANDLING
/CUUDKB: STARTING BLOCK; CUUDKY: STARTING WORD

CUDRUT,
	JMS CUDRU0		/ CHECK FOR END OF BUFFER, ADJUST POINTERS

	TAD CUDNUM
	TAD (CUUDID
	CIA
	TAD I T1
	SNA CLA			/ IS CURRENT CHARACTER THE UDK ID?
	JMP CUDRBL		/ YES, SET SWITCH

	DCA I T1		/ COMMAND; LEGAL TO REMOVE CHARACTER

	CMA
	TAD T1			/ BACK UP POINTER
	DCA CUDPTR

	JMS  I	CURWUX		/ WRITE THE ALTERED BLOCK (CURWUD)	/C024
	RXEWT+2000
	CUDXBF
	CUUDKD

	JMS  I	CURWUX		/ SET UP TO REPAINT THE SCREEN (CURWUD)	/C024
	RXERD
	CUDXBF
	CUUDKB

	TAD CUUDKY		/ SET POINTER TO FIRST WORD
	TAD CUDXBC		/ (CUDXBF				/C024
	DCA CUDPTR

	TAD CUUDKB		/ RESET BLOCK POINTER
	DCA CUUDKC

