/
/Setup drive table in DSKACP for winchhester devices
/
/	4000 = WINNIE DEVICE------4001 = WINNIE DEVICE MOUNTED
/	RXTYPE----BIT <7> =DRIVE 0 = WINNIE ------------MNRX2X
/		--BIT <8> =DRIVE 1 = MOUNTED WINNIE-----MNRX3X
/		--BIT <9> =WINNIE ON LINE --------------MNRX4X
