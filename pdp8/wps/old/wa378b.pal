	CIFSYS 			/ ++++
	JWAIT
	CDFSYS 			/ ++++
	TAD I	HLTFLG 		/ ++++
	CDFMYF
	SNA CLA 		/ ++++
	 ISZ	HLTEST
	JMP I	HLTEST

