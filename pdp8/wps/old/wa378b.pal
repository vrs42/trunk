CKCOMM,	XX			/ROUTINE TO SEE IF HOST IS REQUESTED	/A018
	TAD	(H2T)		/IF SO VALIDATE HARDWARE IS PRESENT.	/A018
				/SEE IF HOST IS ANY			/A018
	JMS	CHKFLG		/OF THE DESTINATIONS.			/A018
	SKP			/SKIP IF NO. SEE IF IT IS A SOURCE.	/A018
	JMP	CKHDWR		/HOST IS A DESTINATION. CHECK HARDWARE.	/A018
	TAD	H2TFLG		/SEE IF HOST IS A SOURCE.		/A018
	SNA CLA			/SKIP IF YES. VALIDATE THE HARDWARE.	/A018
	JMP I	CKCOMM		/HST NOT SRC & NOT DST SO OK TO RETURN.	/A018
CKHDWR,	AC0001			/LOAD THE HARDWARE PRESENT BIT MASK	/A030
	CDFMNU								/C030
	AND I	(MUBUF+MNOPTC)						/C030
	CDFMYF			/SEE IF COMM HARDWARE IS PRESENT	/A018
	SZA CLA			/SKIP IF NO. REPORT ERROR.		/A018
	JMP I	CKCOMM		/HARDWARE IS PRESENT SO OK TO RETURN.	/A018
	JMP	PTERM5		/PUT OUT ERROR MESSAGE			/A030

