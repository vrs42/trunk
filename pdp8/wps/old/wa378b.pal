	IFDEF V30SWE  < TEXT '&SENASTE'>
	IFDEF DUTCH   < TEXT '&BEWERK'>
	IFDEF SPANISH < TEXT '&ULTIMO'>

CUIP11,
	IFDEF ENGLSH  < TEXT '&ELAPSED &TIME' >
	IFDEF ITALIAN < TEXT ' ' >
