	BSW			/SWAP INTO LOW SIX BITS FROM HIGH SIX BITS
	AND	(77		/MASK TO SIX BITS
	TAD	(77		/ADD OFFSET TO MAKE A REAL SIXEL DATUM
	JMS	PRCHR		/ENQUEUE FOR DISPLAY TO PRINTER
/
	ISZ	SCRDT1		/INCREMNT TO NEXT SIXEL CHAR
	ISZ	SCRDT2		/INCREMENT CHAR COUNTER
	JMP	SCRD12		/LOOP
/
	ISZ	SCRDT4		/INCREMENT TWO-PASS COUNTER
	SKP			/SKIP IF MORE TO DO
	JMP	SCRD14		/NO MORE TO DO
/
	AC0001			/POINT TO OTHER HALF (INTERDIGITATED)
	JMP	SCRDM6		/  OF GDC DATA
/
SCRD14,	TAD	(20		/POINT TO NEXT X
	TAD	RDBITS+1		/BY CHANGING CONTROL BLOCK
	DCA	RDBITS+1
/
	ISZ	SCRDT6		/INCREMENT ACROSS SCREEN
	JMP	SCRDM4		/LOOP

	TAD	(55		/SEND A GRAPHICS NEW-LINE TO PRINTER
	JMS	PRCHR
/
	TAD	K0014		/POINT TO NEXT Y
	TAD	RDBITS+2		/BY CHANGING CONTROL BLOCK
	DCA	RDBITS+2
/
	ISZ	SCRDT5		/INCREMNT DOWN SCREEN
	JMP	SCRDM2		/LOOP
/
	CLA CLL
/?	JMS	SXLPRO		/ENTER HERE FROM IDLE LOOP
/
	CLA CLL
	TAD	K0033		/TAKE PRINTER OUT OF 'SIXEL MODE'
	JMS	PRCHR		/  BY SENDING AN 'ESC \'
	TAD	K0134
	JMS	PRCHR
/
	CLA CLL
	JMP I	SCRPNT		/RETURN
