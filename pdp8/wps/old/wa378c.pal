	DISP;505;TEXT '!&ID = &IDENTIFICATION MESSAGE'			/M051
	DISP;705;TEXT '!&LD = &LOG DOCUMENT'
	DISP;1105;TEXT '!&SP = &SEND ONLY PASSWORD'
