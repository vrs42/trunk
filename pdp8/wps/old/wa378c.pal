/CLEAR A LOCATION IN THE MACRO GRPAH DEFINITION AS DEFINED BY THE AC AT INPUT
/
CLEAR1,	0
	DCA	CLR1TM
	PR3			/NULL THE MACRO IN CASE IT IS LAST IN MEMORY
	4000+MCFLD+TABFLD
	ZZERO+1
CLR1TM,	0
	-1
	-1
	JMP I	CLEAR1

