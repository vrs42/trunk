	SZA			/SKIP IF OLD BUFFER TO BE USED
	DCA	STMAC4		/BUFFER STARTING ADDRESS
	TAD	OUJMPE		/SET UP PACKING SWITCH
	DCA	OUJMP		/
	TAD	(MBUF		/BUFFER ADDRESS
