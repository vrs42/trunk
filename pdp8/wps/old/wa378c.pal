				/THE PREVIOUS MENU PR9 TO DISPLAY THIS

	DISP;700;TEXT 'X &T &I X!PX   X';PRA753
	DISP;1000;TEXT 'X &E &N X                          '
	DISP;-1;TEXT '          X   X     +'
	DISP;-1100
		TEXT 'X &R   X!PX   X     X- !&EX !CO!D (EXTRA HALF LINES)!CN' /M107
		PRA153;MNQLSZ						/M124
	DISP;1200;TEXT 'X     X     !CO!&THIS !&IS !&WHERE !&THE !&TEXT '
