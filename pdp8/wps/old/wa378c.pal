/
	IFNDEF CONDOR <
AC0001=	7301
AC0002=	7305
AC0003=	7325
AC0004=	7307
AC0006=	7327
AC0010=	7315
AC0100=	7303
AC3777=	7350
AC4000=	7330
AC7775=	7346
AC7776=	7344
AC7777=	7340
			>	/END IFNDEF CONDOR
	IFDEF CONDOR	<
	AC1=	7301
	AC100=	7303
	AC4K=	7330
	ACNEG1=	7340
			>	/END IFDEF CONDOR
/
R3L=	7014
/
GRDR=	6150		/GRAPHICS OPTION DMA READ
GRDW=	6151		/GRAPHICS OPTION DMA WRITE
GRGR=	6154		/GRAPHICS OPTION GDC READ
GRGW=	6155		/GRAPHICS OPTION GDC WRITE
