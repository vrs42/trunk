	TAD	TXTXP1		/ADD THE 'FORWARD' CONTRIBUTION
	CLL			/DIVIDE BY TWO
	SPA			/ENSURE SIGN EXTENDED PROPERLY
	CML
	RAR
/
	CIF CDF	PRGFLD		/SET UP FOR RETURN TO PRIMS MAIN FIELD
/
