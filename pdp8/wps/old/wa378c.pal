PS5S,			/ FRIENDLY LABEL TO SEARCH FOR

PS5T11,									/A035
	MXDISP;1505;X05NEP;DLMX05	/"NON EXISTENT PRINTER		/C171
	MXDISP;2205;X02PRM;DLMX02	/"PRESS RETURN ... MAIN MENU	/A171
	TRNSFR;PS1T0R;DLMPS1		/				/C171

PS5T24,	DISP;0311
	TEXT '&THE DOCUMENT DESTINATION DOES NOT MATCH THE ATTACHED^S'	/C065
			PS5TX2		/"PRINTER"			/A090
	TRNSFR;PS2C;DLMPS2						/M065

