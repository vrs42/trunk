/	XSTMID AS AN EXCAPE SEQUENCE CAN EXIST ONLY IN THIS OVERLAY	/A210
/	THERE MUST BE NO OTHER CALLS					/
/		JMS	PRESCS						/
/			PCTMID						/
/	EXCEPT IN THIS OVERLAY UNLESS XSTMID IS MOVED TO RESIDENT	/
/	...THE SAME GOES FOR XSTMRS...					/
XSTMRS,	ESC
XSTMID,	"c&177+4000
/									/
/***********************************************************************/


