GETDIG,	0
	JMS	CURLEV		/THIS LEVEL FOR PROCESSING
	TAD	(-60		/NOW SEE IF IT IS NUMERIC OR NOT.
	SPA			/SKIP IF STILL VALID
	JMP	GETDGC		/NOT NUMERIC
	TAD	(-12		/HIGH END +1
	SMA			/SKIP IF STILL VALID.
	JMP	GETDGC		/TAKE THE EXIT. COMMAND TERMINATED.
	TAD	(12		/MAKE THE CHARACTER BINARY
	ISZ	GETDIG
	JMP I	GETDIG
GETDGC,	CLL CLA
	JMP I	GETDIG


/FLOATING PUT = 6000

