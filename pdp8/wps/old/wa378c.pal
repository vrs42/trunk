	ISZ	SGNTST
	TAD	HIGH1
SGNSWT,	SMA CLA			/OR SPA CLA
	JMP I	SIGNCL
	JMS I	OPNEGS
	ISZ	SGNTST
	NOP
	JMP I	SIGNCL
/
FACNEG,	ACNEG
OPNEGS,	OPNEG
SGNTST,	0


/WRITE P SUBOPTION ROUTINE
/
WOPPO,	0
WOPPOA,	JMS	CURLEV		/GET THE LEVEL OF EXECUTION
WOPPOB,	DCA	WOPPOC		/SAVE THE CHARACTER
	JMS I	XLOOKU		/DO THE LOOKUP
WOPPOC,	0
	WRTPOT			/TABLE ADDRESS
	JMP	WOPPOA		/STAY HERE UNTIL TERMINATOR IS SEEN
	DCA	WOPPOC		/SAVE THE ROUTINE ADDRESS
	JMS I	WOPPOC
	JMP	WOPPOB		/RETURNS WITH THE CHARACTER IN THE AC
WOPPOX,	0
	JMP I	WOPPO		/TAKE THE EXIT ROUTINE AS A ")" WAS SEEN TO
				/TERMINATE THE FUNCTION.


/
/SAVE THE CURRENT X AND Y VALUE
/

SAVCUR,	0
	JMS	FL2INT
	   CURX
	JMS	FL2INT
	   CURY
	TAD	CURX+1
	DCA	TEMP1
	TAD	CURX+2
	DCA	TEMP1A
	TAD	CURY+1
	DCA	TEMP2
	TAD	CURY+2
	DCA	TEMP2A
	JMS	INT2FL
	    CURX
	JMS	INT2FL
	    CURY
	JMP I	SAVCUR


