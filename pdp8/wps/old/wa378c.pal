NOGO,	TAD	EX1
	CMA IAC
	TAD	EXP
	SMA CLA
	JMP I	ALIGN
	JMP I	.+1
	FLGTA
POINT,	0
AMOUNT,	0
NORMAL,	FNORM
OPMINS,	OPNEG
TEST1,	0030
TCON1,	SHFTOP-SHFTAC
TCON2,	SHFTAC



