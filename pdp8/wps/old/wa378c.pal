	CIA		/IF PRQ2W>0, AC=0
			/IF PRQ2W<0, AC=NUMBER OF COPIES TO MAKE
	
	DCA	PRQCPY	/PRQCPY IS SET TO THE PROPER NUMBER IF PRQ2W<0;
			/REMAINS CLEARED IF PRQ2W>0

	TAD	PRQCPY
	DCA	PRQ2W	/IF PRQ2W>0, NOW PRQ2W=0
			/IF PRQ2W<0, NOW PRQ2W>0
	JMP	NCPYL4		/CONTINUE ON NEXT PAGE OF THIS OVERLAY
