CRNTXY,	0			/ADDRESS OF WORD TO BE CONVERTED
	PTELMH			/ADDRESS OF WHERE TO STORE CURRENT X OR Y
	DBLSUB			/SUBTRACT CURRENT POSITION FROM INTERPOLATED
	PTELMH			/ADDRESS OF DOUBLE WORD TO BE SUBTRACTER
	ITELMH			/ADDRESS OF WHERE TO STORE RESULT
	CNVDBL			/CONVERT REMANING CORDS TO DOUBLE PRECISION
	REMAIN			/ADDRESS OF WORD TO BE CONVERTED
