	GTCSIZ		/OPCODE=23	CLEAR ALPHABET
	DMYSUB		/OPCODE=24	NOP (WAS CELL DISPLAY SIZE (ZOOM))
	DMYSUB		/OPCODE=25	NOP (WAS CELL ROTATION)
	DMYSUB		/OPCODE=26	NOP (WAS CELL ITALIC)
