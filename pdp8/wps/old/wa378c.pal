	AC7777		/SET THE STOP AFTER THE END OF THE PAGE FLAG
	DCA	PRSTNX


/THIS SECTION HANDLES CONTINUING PRINTING WHERE WE LEFT OFF.  HOWEVER, WHERE
/WE LEFT OFF DEPENDS ON WHAT SORT OF STOP WE JUST PROCESSED.

OVSTR=.-OVRLCA	/ R HIT FROM STOP MENU					/A103
OBSTR=OVTYPE+OVNUM

	DCA	PRACTN	/RESET USER ACTION

	TAD	PABORT	/SEE IF HANDLER HAS ABORTED			/A108
	SZA CLA								/A108
	JMP	PRST6B	/ YES, DON'T CLEAR STOP OR STATUS		/A108

	DCA	PRSTOP	/RESET STOP FLAG

