	GTWRTM		/OPCODE=10	SET WRITING MODE
	GTLTXT		/OPCODE=11	SET LINE TEXTURE
	GTSHDY		/OPCODE=12	SHADE TO Y
	GTSHDO		/OPCODE=13	TURN SHADING OFF
	SCRDMP		/OPCODE=14	SCREEN SIXEL DUMP
	DRWARC		/OPCODE=15	CENTER ARC
	CRVBGN		/OPCODE=16	CURVE BEGIN OPEN
	CRVCLS		/OPCODE=17	CURVE BEGIN CLOSED
	CRVCNT		/OPCODE=18	CURVE CONTINUE
	CRVEND		/OPCODE=19	CURVE END
