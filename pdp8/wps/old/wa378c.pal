OVSTS=.-OVRLCA	/ S HIT IN STOP MENU					/A103
OBSTS=OVTYPE+OVNUM
	DCA	PRQ2W		/CLEAR THE TWO WHEEL FLAG
	DCA	PRQCPY		/CLEAR SO THAT NO MORE COPIES PRINT	/A098
	TAD	PABORT		/SEE IF HANDLER ABORTED			/A108
	SZA CLA								/A108
	JMP	PRST8A		/YES, GO FORCE RELOAD			/A108

	JMP	PRSTL7


/THIS SECTION HANDLES MOVING BACK N PAGES AND RESTARTING.

OVSTT=.-OVRLCA	/ T HIT IN STOP MENU					/A103
OBSTT=OVTYPE+OVNUM
	TAD	PRACTV		/GET THE NUMBER OF PAGES TO MOVE BACK
	CIA CLL								/C156
	TAD	PRPCNT		/SUBTRACT FROM THE CURRENT PAGE COUNT
	SNL			/SKIP IF VALUE LESS THAN COUNT		/A156
	CLA			/ELSE RESTART AT ZERO			/A156
