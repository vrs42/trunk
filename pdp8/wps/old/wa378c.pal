	JMP I	SNDPAT		/AND EXIT
KPATBL,	PATBLK
PATBLK,	GTLTXT
PATRN,	0

CLRBMP,	0
	TAD	(LDCBLK+2	/SET UP TO CLEAR THE CHARACTER BITMAP
	DCA	10
	TAD	(-0012
	DCA	LDCHTM
CLRBM1,	DCA I	10
	ISZ	LDCHTM
	JMP	CLRBM1
