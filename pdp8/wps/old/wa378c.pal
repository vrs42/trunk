MRPREN,	-")+200			/SEVEN BIT FOR ")"
MSGLQU,	-"'+200			/SEVEN BIT FOR "'"
MDBLQU,	-""+200			/SEVEN BIT FOR '"'

/MISC STORAGE
ABSFLG,	0			/ABSOLUTE OR RELATIVE FLAG FOR INCOMING NUMERIC
				/DATA.
CIRCUM,	0			/0 SAYS END POINT IS IN THE CENTER
				/NON-ZERO IS ON THE CIRCUMFERENCE
NUMMER,	ZBLOCK 3
REPLY,	0			/RESPONSE TO CALLER
SEMIOK,	0			/-1 = OK TO PASS SEMICOLON, SPACE, AND CONTROLS
				/+1 = SEMI'S AND SPACES OK, NO CONTROLS
				/ 0 = NO SEMI'S, SPACES OR CONTROLS
TEMP1,	0
TEMP1A,	0
TEMP2,	0
TEMP2A,	0

/HLS CONSTANTS

LIGNUM,	0			/LIGHTNESS VALUE
