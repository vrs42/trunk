* .+DSMATH   ;	DLMBCD,	DSMBCD=	2	/ REST OF MATH - FIELD 6 RESIDENT
* .+DSMBCD

* .	     ;	DLOPRS,	DSOPRS=	7	/ WPPARS.
* .+DSOPRS   ;	DLOLOG,	DSOLOG=	20	/ EAZY LINK - LOGON UTILITY
