/ WPSRDF.PA - MULTI KEY SORT DEFINITIONS

/ BUFFER SIZES
/
FNSIZE=		36		/ <FIELD NAME> SIZE IS 30(10) CHARACTERS

MXFLD=		14		/ MAXIMUM NUMBER OF FIELDS, 12(10)
SOTFL=		100		/ 'OUTPUT' DRIVE AND DOCUMENT NUMBER
SLSTFL=		SOTFL+1		/ 'LIST' DRIVE AND DOCUMENT NUMBER
ORDER=		SLSTFL+1	/ SORT ORDER
				/ XXX XXX XXX XXX
				/   0 FOR ASCENDING	
				/   1 FOR DESCENDING	
				/ 0TH BIT = FIRST KEY FIELD 1ST BIT = SECOND
				/ KEY FIELD ETC.
MMRETURN=	ORDER+1		/ RETURN ADDRESS TO MAIN MENU
SDFNBUFFER=	MMRETURN+1	/ ADDRESS OF SPEC DOC <FIELD NAME> BUFFER
PARSELIST=	SDFNBUFFER+1	/ STARTING ADDRESS OF THE SORT LIST DOC PARSER
DSKID=		PARSELIST+1	/ RESULT DOC MODIFICATION/DISKETTE ID
				/ BYY NNN NNN NNN
				/ WHERE
				/ B MEANS BLANK
				/ YY STANDS FOR RESULT DOC MODIFICATION CAN BE
				/	00 FOR  ADD TO TOP
				/  	01 FOR  ADD TO BOT
				/	11 FOR OVERWRITE
				/N IS THE NEGATIVE OF THE LAST THREE DIGITS OF
				/   THE SYSTEM DISKETTE ID
FTYPE= 		DSKID+1		/FIELD TYPE FIELD NAME DESCRIPTOR
				/TTT TTT TTT TTT
				/WHERE T MEANS
				/	1= NUMERIC FIELD
				/	0= ALPHA FIELD
				/0TH BIT = FIRST FIELD  NAME,
				/1ST BIT = SECOND FIELD  NAME	ETC.
				


