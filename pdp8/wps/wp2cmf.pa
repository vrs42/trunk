	IFDEF 	SPANISH < TEXT "DOM" >


	IFDEF	ENGLSH	< TEXT "MON" >
	IFDEF	ITALIAN	< TEXT "LUN" >
	IFDEF	V30SWE	< TEXT "M\E" >
	IFDEF 	V30NOR	< TEXT "MAN" >
	IFDEF 	SPANISH	< TEXT "LUN" >
	IFDEF 	DUTCH	< TEXT "MAA" >


	IFDEF	ENGLSH	< TEXT "TUE" >
	IFDEF	ITALIAN	< TEXT "MAR" >
	IFDEF	V30SWE	< TEXT "TI"  >
	IFDEF 	V30NOR	< TEXT "TIR" >
	IFDEF 	DUTCH	< TEXT "DIN" >
	IFDEF	SPANISH < TEXT "MAR" >


	IFDEF	ENGLSH	< TEXT "WED" >
	IFDEF	ITALIAN	< TEXT "MER" >
	IFDEF	V30SWE	< TEXT "ON"  >
	IFDEF 	V30NOR	< TEXT "ONS" >
	IFDEF 	DUTCH	< TEXT "WOE" >
	IFDEF 	SPANISH	< TEXT "MIE" >

	IFDEF	ENGLSH	< TEXT "THU" >
	IFDEF	ITALIAN	< TEXT "GIO" >
