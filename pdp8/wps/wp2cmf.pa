/A040 A040A040A040A040A040A040A040A040A040A040A040A040A040A040A040A040A040A040

/********************************************************************
/ some data areas use bye TIME etc
/********************************************************************

DATEST,	ZBLOCK	27		/ ASCII list of time and date chars

	DECIMAL
TENS,	-1000
	-100
	-10
	-1
	0
