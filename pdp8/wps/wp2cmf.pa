DIGCAL,	OUTDIG			/ LOCATION OF DECIMAL STRING OUTPUT ROUTINE
PGSWAP=JMS I .			/ PSEUDO INSTRUCTION TO CALL SWAP ROUTINE
	PAGSWP			/ LOCATION OF PAGE SWAPING ROUTINE
T3,	0			/ TEMPROARY REGISTER NUMBER THREE
T2,	0			/ TEMPROARY REGISTER NUMBER TWO
T1,	0			/ TEMPROARY REGISTER NUMBER ONE

	*RXJOB			/ DEFINE RX JOB
	0;RXFLD;0;RXSTRT;0

	*U1JOB			/ DEFINE USER JOB
	0;40;0;WPCMND;0

