/D038		TAD I	(YEAR)		/ GET YEAR INPUT
/D038		TAD	(-EXPYR)	/ GET EXPIRATION YEAR
/D038		SMA SZA			/ YEAR BEYOND LIMIT?
/D038		JMP	CHKDT2		/ YES, CLOBBER DISKETTE
/D038		SZA CLA			/ TIME OUT YEAR?
/D038		JMP	CHKDT1		/ NO, MUST BE EARLIER, OK, EXIT
/D038		TAD I	(MONTH)		/ NO, EXPIRATION YEAR, CHECK MONTH
/D038		TAD	(-EXPMN)	/ GET EXPIRATION MONTH
/D038		SPA CLA			/ OK?
/D038	CHKDT1,	JMP	CUDXIT		/ YES, EXIT
/D038	CHKDT2,	CDFMYF			/ NO, TIME TO CLOBBER DISKETTE
