PRHOV,
	TAD	(SYSVER&177
	JMS	PRINS
	ISZ	EXPCNT
	TAD	(SYSBAS&177
	JMS	PRINS
	ISZ	EXPCNT
	TAD	(SYSREV&177
	JMS	PRINS
	ISZ	EXPCNT
