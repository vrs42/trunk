	TAD	(HS2IN		/SET UP CALL TO RECEIVE			/A214
	DCA	SQPNXT+1	/IN SQPINP CALLING LOCATION		/A214

PRSET4,	TAD	(OVNDOC		/
	JMS	PROV		/
		OBNDOC		/
