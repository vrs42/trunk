	JMS	IDCKT2	/ CHECK TIME OUT TIME.				/A059
	JMP	IDHNTST	/ JMP IF NOT TIME-ED OUT YET.			/A059
	ISZ	REST01	/ TAKE THE SKIP RETURN FOR "NO-ANSWER"		/M071
	JMP I	REST01	/  ...						/A071

PIDTMR,	0		/ PRINTER ID TIMER				/A198


