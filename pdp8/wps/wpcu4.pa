INSPRG,	TEXT '^P&ACTIVACI\SN EN CURSO, ESPERE ...'		/A001
INSVAL,	TEXT '^P&LA UNI. 1 NO CONTIENE UN DISK. DE &CARACTER\MSTICA V\ALIDO'

INSMS1,	TEXT '&LA CARACTER\MSTICA NO ES COMPATIBLE'/M022
INSMS2,	TEXT 'CON RSTA VERSI\SN DEL DISK. SISTEMA.  &ESTA CARACTER\MSTICA'
INSMS3,	TEXT 'REQUIERE VERSI\SN '					/M022
