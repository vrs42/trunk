	CDFMNU
	AC7777
	TAD I	(DATESP)	/ GET DATE STRING
	DCA	OVTIMX		/ SAVE PTR-1
XVTIM1,	CDFMNU
	TAD I	OVTIMX		/ GET NEXT CHAR
	SNA
	JMP 	EIFIX		/ QUIT IF NULL
	INSCHR			/ ELSE INSERT
	JMP	XVTIM1		/ AND LOOP FOR MORE
	
	OVTIMX=X5		/ STRING INDEX REGISTER



