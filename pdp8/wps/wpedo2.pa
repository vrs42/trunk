	JMP	EISWBD		/ Bad if ETX
	AND	P177
	TAD	(-ECNWLN)	/ Or if EOL
	SNA
	JMP	EISWBD		/
	TAD	(ECNWLN-ECNWPG)	/ Or if PAGE
	SNA CLA			/ 					/M229
/D229	TAD	(ECNWPG-ECSTOV)	/ Or if Overstruck
/D229	SNA CLA
	JMP	EISWBD
	ISZ	EISWPA
