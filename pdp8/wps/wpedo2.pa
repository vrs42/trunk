	JMS	CLSSET		/ INITIALIZE SCROLL VALUES FOR STATUS	/A185

	AC7777			/ SET AC = -1				/A185
	CIFMNU			/ CHANGE INSTRUCTION FIELD TO MENU FIELD/A185
	PGSWAP			/ AC=-1 SO JUST LOAD IN THE SAVE AREA	/A185

	TAD	T2		/ FINISH  - GET RETURN CODE		/A185
	SNA			/ IS CODE OR NULL(RET TO EDITOR)	/A185
	JMP	EINEXT		/ RETURN TO NORMAL EDITOR FUNCTIONS	/A185
	JMP	EINEXB		/ RETURN TO EDITOR ...WITH NEG CODE IN AC/A185



