	ISZ	COLPT2		/ GET 2ND ENTRY IN TABLE
	TAD I	COLPT2		/ SET L/ O=(3,7,1)
	DCA	HLPCL2		/ SET L/ O POS. PNTR

	TAD	HLPK04		/ 4=FIRST PRINT LINE
	TAD	HLPTM1		/ LINE OFFSET
	DCA	HLPTM1
SETCLB,	TAD	HLPKM9		/ -9
	TAD	HLPTM1
	SPA			/ IS GREATER THAN 9
	JMP	HLPST1		/ NO CONT
	DCA	HLPTM1		/ SAVE LINE #
	ISZ	HLPRW1		/ INC ROW NUMBER ASSUMES L.T.20
	JMP	SETCLB		/ REPEAT (FOR G.T. 20

HLPST1,	CLA CLL CML RAR		/ 4000
	TAD	HLPRW1
	TAD	HLPK60		/ ASCII
	DCA	HLPRW1		/ ADD ROW NUM
	CLA CLL CML RAR		/ 4000
	TAD	HLPK60		/ ASCII
	TAD	HLPTM1
	DCA	HLPRW2

