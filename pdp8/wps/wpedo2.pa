	PUTESC
	"[+4000-200
HLPRW1,	"0+4000-200		/ ROW TENS DIGIT
HLPRW2,	"1+4000-200		/ ROW L/ O DIGIT
	";+4000-200		/ SEPARATOR
	"0+4000-200		/ COL H/ O
COLCNT,
HLPCL1,	"0+4000-200		/ =0,3,6
HLPCL2,	"3+4000-200
	"H+4000-200		/ CUROR POSITION
