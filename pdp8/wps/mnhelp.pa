HELP19,	IFDEF	HELPDO	<
	DISP; 2412; TEXT '&PRESS !&ADVANCE OR !&BACKUP TO MOVE CURSOR.'
	DISP; 2512; TEXT '^S&D&O TO DO FUNCTION.'; HLPIN3
			> 	/ END IFDEF HELPDO

	IFNDEF	HELPDO	<
	DISP; 2512; TEXT '&PRESS !&ADVANCE OR !&BACKUP TO MOVE CURSOR.'
			> 	/ END IFNDEF HELPDO

	DISP; 2612; TEXT '^S!&HELP KEY FOR MORE INFORMATION ON SELECTED'
	HLPIN3

	DISP;-1; TEXT ' FUNCTION'
	DISP;2712;TEXT '^S!&RETURN !&OR &GOLD !&MENU TO RESUME EDITING.'
	HLPIN3
	RETURN

