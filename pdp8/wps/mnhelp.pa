	    HRNEXT;-1-HNNEXT;DLHL50	/ NEXT SCREEN
	    HRPREV;-1-HNPREV;DLHL50	/ PREV SCREEN
	    HRREMV;-1-HNREMV;DLHL44	/ REMOVE = CUT
			>		/ END IFDEF CONDOR		/A010

	    HRUBC;-1-HLRUBC;DLHL52	/ RUBOUT = RUB CHAR OUT		/A010

	IFNDEF	CONDOR	<						/A010
	    HRUBW;-1-HLRUBW;DLHL52	/ RUB WORD OUT			/A010
	    HSWAP;-1-HLSWAP;DLHL22	/ SWAP				/A010
			>		/ END IFNDEF CONDOR		/A010

