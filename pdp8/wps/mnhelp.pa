	Q=Q+100; DISP; Q; TEXT '!&PARA'
	Q=Q+100; DISP; Q; TEXT '!&PASTE'
	Q=Q+100; DISP; Q; TEXT '!&SEL'
	Q=Q+100; DISP; Q; TEXT '!&SENT'
	Q=Q+100; DISP; Q; TEXT '!&TAB !&POS'
	Q=Q+100; DISP; Q; TEXT '!&UNDERLINE'
	Q=Q+100; DISP; Q; TEXT '!&UPPERCASE'
	Q=Q+100; DISP; Q; TEXT '!&WORD'
