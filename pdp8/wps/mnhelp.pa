	IFNDEF	CONDOR	<
	Q=Q+100; DISP; Q; TEXT '^A (!&PREV !&SCREEN)';UPAROW
	Q=Q+100; DISP; Q; TEXT 'V (!&NEXT !&SCREEN)'			/C013
			> 	/ END IFNDEF CONDOR

	IFDEF	CONDOR	<
