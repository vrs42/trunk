/****************************************************************

	Q=Q+100; DISP; Q; TEXT '!&ABBRV'
	Q=Q+100; DISP; Q; TEXT '!&ADVANCE'
	Q=Q+100; DISP; Q; TEXT '!&BACKUP'
	Q=Q+100; DISP; Q; TEXT '!&BOLD'

