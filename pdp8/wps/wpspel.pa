	TAD	SCURSR		/ Reset cursor column address variable.
	DCA I	(CURSOR)	/  ..
	TAD	LINCNT		/ Reset cursor line address variable.
	CIA			/
	DCA I	(CURLIN)	/ "Current line number".
	CDFMYF			/   ...
	JMS	ECPSCN		/ Call SETCUR to posn the cursor.
	JMP I	POSNCU		/ return to caller.


