OPTCHR,	XX			/ return address
	JMP	OPTCH2
OPTCH1,	CIFSYS
	JWAIT
OPTCH2,	CIFSYS
	TTYOU			/ output the char
	 JMP	OPTCH1	
	JMP I	OPTCHR		/ return when done


POSNCU,	XX			/ Routine to init EDT pointers to start of
				/ word & posn screen CURSOR.
