/ MXDISP TEXT BLOCK NUMBER 5

/***************************************************************************
/****				N O T E					****
/****									****
/****		THIS BLOCK IS RESERVED FOR MXDISP TEXT STATEMENTS	****
/****									****
/****	   DO NOT PUT REGULAR MENU CODE HERE, USE ANOTHER MENU BLOCK	****
/***************************************************************************


	RELOC
	ADMX05=.
	X=DLMX05		/ INDICATE DISK BLOCK WHERE MENU IS LOADED
	RELOC 0

