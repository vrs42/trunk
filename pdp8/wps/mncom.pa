X05ERM,	TEXT ', !&MDY = '						/M035
X05ERY,	TEXT ', !&YMD = '						/M035
X05NEP,	TEXT '&NON EXISTENT PRINTER'

	XTRX05=400-.

	IFZERO	.-401&4000 <?BADPAGE LENGTH>



