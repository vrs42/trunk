				/THAT WILL START THE RECEIVE STRING TO BE EXECUTED.

SODBUF,	-1			/1 IS THE TERMINATOR FOR ALL BUFFERS
	ZBLOCK SODMAX

SOLBUF,	-1
	ZBLOCK SOLMAX

EOLBUF,	CR
	0
	-1
	ZBLOCK EOLMAX-2

EODBUF,	-1
	ZBLOCK EODMAX

PARAUF,	12
	-1
	ZBLOCK PARAAX-1

EOPBUF,	14
	-1
	ZBLOCK EOPMAX-1

TABBUF,	11
	-1
	ZBLOCK TABMAX-1

