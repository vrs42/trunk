	JMP	TOANS2		/JMP IF OLD MODE WAS VT52		/A049/M055
	IAC			/X    0     -1   -2    -3    -4	   -5	/A049/M055
/D055	AND	(1)		/X		1	0	1	/A049/M055
TOANS2,	JMS	PRQSUB		/1 = SEND ESC SEQ. FROM FUNCTION KEYS	/A049/M055
				/0 = SEND ESC/BS/LF  "     "      "	/A049/M055
	CLA								/A049
