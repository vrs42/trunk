CVTNML,	0			/LINE # TO CONVERT.
CVTNMC,	0			/COLM # TO CONVERT.

TODWNM,	IAC			/NEW MODE IS 3
TODWAM,	IAC			/NEW MODE IS 2
	JMP	TOV100		/MERGE BELOW
