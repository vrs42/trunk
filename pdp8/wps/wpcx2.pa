	DCA	VTMODE		/SET TO 0 FOR NON ANSI			/A019
/D049	AC7776								/A022
/D049	TAD	VTMOLD		/SEE IF JUST CHANGED FROM DM2		/A022
/D049	SMA			/DON'T SKIP TO SEND 0 WITH PRQ3		/A022
				/AC = 0 SEND ESC/BS/LF			/A049
	JMS	PRQSUB		/EXECUTE PRQ SUBROUTINE			/A021
