	"7&177								/A052
	"~&177								/M052
	-1								/A051
	ZBLOCK TECMAX-5							/M052

	/ Fake "buffer" for line drawing CX in 8 bit 			/A056

SLDBUF,	16			/Shift Out				/A056
SLDCHR,	0			/Line drawing character			/A056					
	17			/Shift In				/A056
	-1
	ZBLOCK SLDMAX-3		/					/A056	

FBKBUF,	0			/Two character fallback representation	/A056
	0			/is put in here				/A056
	-1								/A056
	ZBLOCK FBKMAX-3		/					/A056


SNDBUF,	-1
	ZBLOCK SNDMAX

RCVBUF,	-1
	ZBLOCK RCVMAX



