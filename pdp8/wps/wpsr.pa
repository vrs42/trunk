////////	QURX  .PA	-	 SUBROUTINES TO QUEUE RXHAN	\\\\\\\\
////////								\\\\\\\\
////////								\\\\\\\\
////////								\\\\\\\\
////////								\\\\\\\\
////////								\\\\\\\\
////////								\\\\\\\\
////////								\\\\\\\\
////////								\\\\\\\\
