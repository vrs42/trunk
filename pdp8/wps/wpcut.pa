	TEXT '^P&DOCUMENTO SPECIFICA DI SELEZIONE: (^D.^D) ^A '
	*.-1
	TEXT '^P&DOCUMENTO MODULO: (^D.^D) '
	*.-1
	TEXT ' ^A^P&DOCUMENTO USCITA '
	>

	IFDEF V30NOR <
	TEXT '^P!E^P&VELGER UT FRA LISTEDOKUMENT: (^D.^D) ^A  '
	*.-1
	TEXT '^P&BRUKER UTVALGSSPESIFIKASJON: (^D.^D) ^A  '
	*.-1
