	IFDEF ITALIAN < TEXT "INSERITO ALLA FINE DEL " >
	IFDEF V30NOR <TEXT 'TILF\XYET P\E TOPPEN AV '>			/A088
	IFDEF V30SWE < TEXT 'INSATT I SLUTET AV'>


