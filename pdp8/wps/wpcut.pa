	JMP	CULCK1		/WRONG DD				/A074

CHKHST,	CDFSYS			/CMONLN IS IN SYSTEM FIELD		/A060
	TAD I	(CMONLN)	/GET THE COMM FLAG WORD			/A060
	CDFMYF								/A060
	SZA CLA			/SKIP IF NO COMM HARDWARE		/A060
	JMP	CULRTN		/COMM PRESENT. RETURN TO CALLER.	/A044
CULCK2,	IAC			/RETURN AC = 2. NON-EXISTENT PRINTER ERROR/A044
CULCK1,	IAC			/RETURN AC = 1. PRINTER NOT ATTACHED ERROR/A044
