	TAD	CURWNO		/YES, JUST SAVE FILE NO. WITHOUT DRIVE
	AND	P377
	DCA	CURWNO
	TAD	CURWPT		/FIND NAME IN BLOCK
	TAD	CURWDF
	CLL RTL
	CLL RTL
	TAD	(CUB1)
