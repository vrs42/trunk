/ WP27F0 - ASSEMBLY PREFIX FOR WS278 (DECMATE-I)
/
/	
/
/	**************************************************************
/	****                                                      ****
/	**** PLEASE UPDATE THE FOLLOWING VALUES FOR EACH REVISION ****
/	****                                                      ****
/	****    REASSEMBLE MENU MODULES IF VALUES ARE CHANGED     ****
/	****                                                      ****
/	**** DO NOT UPDATE EDIT HISTORY EVERY TIME VALUES CHANGE  ****
/	****                                                      ****
/	**************************************************************

SYSVER=	"2	/ DEFINE SYSTEM SOFTWARE VERSION NUMBER
SYSBAS=	"2	/ DEFINE SYSTEM BASE LEVEL NUMBER
SYSREV=	"D	/ DEFINE BASE LEVEL REVISION NUMBER

DECIMAL
SYSTYP=	278	/ DEFINE SYSTEM TYPE (DECIMAL NUMBER REPRESENTATION)
ENGLSH=	1	/ DEFINE SYSTEM LANGUAGE (ENGLISH)

BLDDY=	16	/ DEFINE DAY THAT SOFTWARE IS BUILT (01..31)
BLDMO=	3	/ DEFINE MONTH THAT SOFTWARE IS BUILT (01..12)
BLDYR=	84	/ DEFINE YEAR THAT SOFTWARE IS BUILT (00..99)

EXPMN=	7	/ DEFINE MONTH THAT SOFTWARE EXPIRES (01..12)
EXPYR=	84	/ DEFINE YEAR THAT SOFTWARE EXPIRES (00..99)
OCTAL		/ SOFTWARE EXPIRES ON FIRST DAY OF MONTH INDICATED

FLDTST=	1	/ DEFINE FIELD TEST SOFTWARE FOR MENU DISPLAY
/DEMO=	1	/ DEFINE FUNCTIONS AVAILABLE FOR CUSTOMER DEMOS ONLY
/DEVEL=	1	/ DEFINE FUNCTIONS AVAILABLE TO DEVELOPMENT GROUP ONLY
/UNBUND= 1	/ ENABLE THE FEATURE UNBUNDLING CODE

