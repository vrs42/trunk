	TAD	DENIN		/INPUT DEN				/C074
	SNA 			/=RX01/02?				/C082
	JMP	FMTSY1		/ IF 8 TO 5 DON'T COPY 0, 78, OR 79	/A044
	CLL RAR								/A074
	SZA CLA			/RX50?					/A074
	JMP	FMTSD7			/ NO -WINNIE SOURCE RET	/A074
	TAD	DENOUT							/A074
	CLL RAR								/A074
	SZA CLA			/RX50?					/A074
	JMP	FMTSD7			/ NO -WINNIE SOURCE RET		/A074
