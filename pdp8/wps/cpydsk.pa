/									/
/	FMTSYS -- INITIALIZE SYSTEM DISKETTE				/
/		THIS ROUTINE IS DESIGNED TO INITIALIZE			/
/		SYSTEM DISKETTES FOR THE FOLLOWING CASES.		/
/		THERE IS NO CONDITIONALIZED CODE SO THAT THE ROUTINE	/
/		WILL RUN ON EITHER DM-I or DM-II DEPENDING WHAT IS	/
/		DETERMINED AT RUN TIME ABOUT THE SYSTEM AND DESTINATION	/
/		DISKETTES						/
/									/
/	CASES:	8" TO 8"	DECmate-I	RX01/RX02		/
/		5" to 5"	DECmate-II	RX50			/
/		8" to 5"	DECmate-II development--first 5" disk	/
/		5" to 8"	DECmate-II	not permitted		/
/									/
/***********************************************************************/

FMTSYS,				/ INITIALIZE SYSTEM DISKETTE		/A032
	JMS	FMTINI		/ GO JMS TIMMSG & COPY BOOT TO FMTBUF	/A032

				/ 8 INCH SYSTEM DISKETTES CANNOT BE MADE/A037
				/ FROM 5 INCH SYSTEM DISKETTES		/A037
