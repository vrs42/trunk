	TAD I	X0		/ READ FOURTH VALUE
	DCA	FACTOR		/ SET UP INTERLEAVE FACTOR
	TAD I	X0		/ LOAD FIFTH VALUE
	DCA	FMTQBK+RXQTRK	/ SAVE AS MINIMUM (FIRST) TRACK
	TAD I	X0		/ LOAD SIXTH VALUE
	DCA	TRKMXK		/ LOAD AS LAST TRACK NUMBER
	TAD I	X0		/ LOAD SEVENTH VALUE
