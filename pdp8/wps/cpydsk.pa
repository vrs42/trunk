IFDEF ENGLSH <
TEXT1A,	TEXT '^P!E -- &B&A&C&K&U&P &M&E&N&U --'				/C066
TEXT1B,	TEXT '^P&REMOVE THE SYSTEM DISKETTE FROM DRIVE 0.'
TEXT1C,	TEXT '^P&PLACE THE DISKETTE(S) INTO THE FOLLOWING DRIVE(S):'	/C066
TEXT1D,	/ THIS TEXT MUST BE AN EVEN NUMBER OF CHARACTERS FOR 		/A033
	/ FOR ALL TRANSLATIONS.  THE NEXT TEXT STATEMENT IS		/A033
	/ DESIGNED TO BE A CONTINUATION OF THIS TEXT BY			/A033
	/ REORIGINING TO OVERLAY THE FULL ZERO WORD TERMINATOR *.-1	/A033
	TEXT '^P&!S !D - &D&E&S&T&I&N&A&T&I&O&N !S - &THIS !S '	/C033/C066
	*.-1	/THE FOLLOWING TEXT IS A CONTINUATION OF THE ABOVE TEXT /A033
	TEXT 'WILL BE &O&V&E&R&W&R&I&T&T&E&N.'				/C033
TEXT1E,
  TEXT '^P&PLACE THE DISKETTE WHICH IS TO &R&E&C&E&I&V&E THE COPY INTO DRIVE !D.'	/C033
TEXT1F,	TEXT '^P&USE A BLANK !S OR A USED !S YOU NO LONGER NEED.'
TEXT1G,
  TEXT '^P&!S !D - &S&O&U&R&C&E !S - &THIS !S WILL BE &R&E&A&D.'	/C033/C066
TEXT1H,	TEXT '^P&PLACE THE DISKETTE WHICH IS TO BE &C&O&P&I&E&D INTO DRIVE !D.'	/C033

TEXT1I,	/ DELETED POSITION COMMAND					/C036
	TEXT '&WHEN YOU ARE READY TYPE &C&O&P&Y AND &PRESS &R&E&T&U&R&N.'
