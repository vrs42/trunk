RDXFER,	0
RDXFRA,
	RDSR		/SKIP TR READY
	SKP
	JMP I	RDXFER	/TR READY
	RDSD		/SKIP IF DONE FLAG SET
	JMP	RDXFRA	/CHECK TR READY
	ISZ	RDXFER	/SET RET
	RDSE		/SKIP ERROR
	JMP I	RDXFER	/DONE RET
	ISZ	RDXFER	/SET ERROR  RET
	JMP I	RDXFER
