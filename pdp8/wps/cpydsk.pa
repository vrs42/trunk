	JMP	XFMT5		/ GO TELL OPR NO COPY CAN BE MADE	/A032
	>			/ END IFDEF PIRATE			/A034

	JMS	CHKDST		/CHECK DEST..IF L.T. 800 BLOCKS =ERROR	/A074
				/RETURNS HERE IF RX01/02  ELSE RET+1	/A074
	JMP	XFMT8		/NO FORMAT FROM 5 TO 8			/C074
FMTD50,				/WINNIE OR RX50				/A074

