DTDEN,	XX			/					/A014
DTDEN0,	TAD	DRVSRC		/ LOAD SOURCE DRIVE NUMBER	/C033	/C035
	DCA	FMTQBK+RXQDRV	/ SET DRIVE NUMBER IN Q-BLOCK		/A032
	JMS	FMTDEN		/ GET DENSITY OF THIS DRIVE
	TAD	DENSTY		/ LOAD DENSITY
	DCA	DENSRC		/ SAVE					/C074

	IFDEF	PIRATE <						/A034
			/ NOW SEE IF THE SOURCE DISKETTE IS AN RX-50	/A032
