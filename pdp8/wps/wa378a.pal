	IFDEF V30SWE < TEXT 'INSATT I B\VRJAN AV'>


CULSBT,	IFDEF ENGLSH < TEXT 'ADDED TO THE BOTTOM OF ' >
	IFDEF ITALIAN < TEXT "INSERITO ALLA FINE DEL " >
	IFDEF V30NOR <TEXT 'TILF\XYET P\E TOPPEN AV '>			/A088
	IFDEF V30SWE < TEXT 'INSATT I SLUTET AV'>


/EACH OF THE FOLLOWING TEXT STATEMENTS MUST HAVE AN EVEN
/NUMBER OF CHARACTERS IF IT IS FOLLOWED BY A *.-1
CULS1,	IFDEF ENGLSH <
	TEXT '^P!E^P&SELECTING FROM LIST DOCUMENT: (^D.^D) ^A '
	*.-1
	TEXT '^P&USING SELECTION SPECIFICATION: (^D.^D) ^A '
	*.-1
