/D038		DCA I	X0		/ STORE VALUE IN MENU TEMP		/A037
/D038		TAD	CUDTMP+1	/ GET INTERNAL ROM  VALUE TO BE SPLIT	/A037
/D038		BSW			/ SWAP HIGH ORDER WITH LOW ORDER BYTE	/A037
/D038		AND	P77		/ MASK OFF LOW ORDER BITS		/A037
/D038		DCA I	X0		/ STORE VALUE IN MENU TEMP		/A037
