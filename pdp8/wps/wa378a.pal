	TAD	RZXVFY						/A015
	SNA CLA			/VERIFY MODE?			/A015
	JMP	DVSNOP		/SET NOP			/A015
	TAD	RZXDIR		/GET CMND			/A015
	AND	(16		/MASK FNCTION BITS		/A015
	CIA							/A015
	TAD	(2		/READ FUNCTION CODE		/A015
	SZA CLA			/IS READ?			/A015
	JMP	DVSNOP		/NO				/A015
	TAD	(NOP						/A015
	SKP			/STORE				/A015
DVSNOP,	TAD	RZVSKP		/SKIP VERIFY			/A015
