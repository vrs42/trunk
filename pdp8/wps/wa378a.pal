VBLKE1,  /HERE ON READ ERROR
  JMS  ERRORS    /FLAG BAD BLOCK FOR A COPY
  ISZ  ERRCNT    /BUMP ERROR COUNTER
  JMS  VBLKOU    /UPDATE STATUS ON SCREEN
  JMS  RDERR    /CALL THE HARD DISK ERROR DISPLAY ROUTINE/A054
  AC2000      /SET 'READ FAIL' FLAG      /A054
  JMS  IORBLK    /IN THE BLOCK LIST STATUS WORD    /A055
  AC4000      /SET 'BAD SOMEHOW' FLAG      /A056
  JMS  IORTYP    /OR IT INTO THE TYPLST STATUS WORD  /A056
  JMP  SYSBL2    /GO FINISH THE PASS THRU THE LOOP  /A055


