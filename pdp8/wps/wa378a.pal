	RAL
	TAD CHDIG1
CHUDK5,	TAD CHDIG1		/ ENTRY IF FIRST DIGIT IS ONLY ONE	/C028
	TAD CHDIG2		/ PLUS SECOND DIGIT; NO EFFECT AT CHUDK5/C028

	TAD CHRDUB		/ + START OF BUFFER
	DCA T1			/ = CORE ADDRESS IN DIRECTORY

	TAD (DLUDKS		/ READ DIRECTORY			/M028
	JMS CHRUDX							/M028

	TAD I T1		/ GET ADDRESS OF UDK FROM DIRECTORY
	SNA			/ IS A UDK DEFINED?
	JMP CHUDK7		/ NO, NOTHING TO PUT ON STACK

	CDFSYS
	DCA I U1STCX		/ PUT THE ADDRESS OF THIS UDK ON STACK
	IAC			/ SET STACK POINTER TO FIRST LOC. IN STACK
	DCA I U1STPX

	TAD I U1STCX		/ SET UP TO READ FIRST BLOCK OF UDK
	AND (7400		/ KEEP BLOCK NUMBER
	BSW
	CLL RTR
	TAD (DLUDKS+1
	CDFMNU
	JMS CHRUDX
	JMP CHUDK6		/ AND EXIT WITH UDK IN CORE

CHUDKA,	0
CHDIG1,	0
CHDIG2,	0
U1STCX,	U1STCK
U1STPX,	U1STPT



