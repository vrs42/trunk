MNMUTM, 0			/ ACCUMULATOR USED FOR CLRV, INCV, AND STOV
MNUTFN,	0			/ DRIVE & FILE NUMBER FOR UTILITY PROGRAMS /A037
MNFREE,	0			/ ** UNUSED LOCATION IN MENU AREA **

