QURX,	XX
	CIFSYS			/ CHANGE TO SYSTEM FIELD
	ENQUE			/ CAUSE QUEUE BLOCK TO BE ENQUEUED
	QUBLK			/ ADDRESS OF QUEUE BLOCK

	CIFSYS			/ CHANGE TO SYSTEM FIELD
	JWAIT			/ WAIT FOR A SIGNIFICENT EVENT
	TAD	QUQBLK+RXQCOD	/ PICK UP THE COMPLETION CODE
	SNA CLA			/ TEST AND CLEAR COMPLETION CODE	/M028
	JMP	.-4		/ IF ZERO, GO WAIT SOME MORE
	JMP I	QURX		/ DONE, RETURN TO CALLER

QUBLK,	DSKQUE			/ ++++
	0			/ ++++
	0
QUQBLK,	ZBLOCK 17

