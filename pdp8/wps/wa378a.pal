	>
	IFDEF DUTCH <
CURENC="F-200		/CURENCY SYMBOL, CAN BE CHANGED FOR DIFFERENT	/A024
			/LANGUAGES					/A024
	>
	IFDEF ITALIAN <
CURENC="#		/CURENCY SYMBOL, CAN BE CHANGED FOR DIFFERENT	/A017
			/LANGUAGES					/A017
	>
	IFDEF SPANISH <
CURENC="P-200		/START OF CURENCY SYMBOL, CHANGED FOR DIFFERENT	/A022
			/LANGUAGE					/A022
CUREN2="T-200		/REST OF CURRENCY SYMBOL USED IN BCDASC		/A022
CUREN3="S-200		/		"				/A022
	>
	IFDEF V30NOR <
CURENC="N-200		/START OF CURENCY SYMBOL, CHANGED FOR DIFFERENT	/A023
			/LANGUAGE					/A023
