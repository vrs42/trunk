/ ISSUE ENABLE - CK FOR HARDWARE PRESENT AND AUTO BAUD IF TRUE		/A030


IMINIT,	XX			/					/A030
	TAD	(4003)		/ ENABLE BITS				/A030
	H2DTR			/ IOT - TURN MODEM ON			/A030
	JMS	IMWAIT		/ WAIT FOR MODEM TO INIT ITSELF		/A030

	LAS			/ SEE IF ITS PRESENT			/A030
	AND	(4000)		/ MODEM PRESENT BIT			/A030
	SZA CLA			/ BIT <0> = 0 IF PRESENT		/A030
	JMP	IMINTE		/ NOT PRESENT - GO DISABLE		/A041

IMINTL,	CIFSYS			/ CLEAR INPUT BUFFER			/A039
	HS2IN			/					/A039
	SZA CLA			/ SKIP WHEN EMPTY			/A039
	JMP	IMINTL		/ LOOP UNTIL EMPTY			/A039

	AC0002			/ SEND A ^B TO AUTO-BAUD		/A039
	CIFSYS			/					/A030
	HS2OU			/					/A030
	CLA			/ BUFFER SHOULD HAVE ROOM		/A030
	JMP I	IMINIT		/					/A030

IMINTE,	AC0003			/ DISABLE MODEM				/A041
	H2DTR			/					/A041
	CLA			/ AC MUST BE CLEARED			/A041
	JMP I	IMINIT		/					/A041

IMWAIT,	XX			/ WAIT HERE  1 SEC.			/A030
	CLA			/					/A030
	DCA	T1		/ CLEAR STORAGE				/A030

	CDFSYS			/ FETCH CLOCK VALUE			/A030
	TAD I	(CLOCK+2)	/					/A031
	CDFMYF			/					/A030
	CIA			/					/A030
	DCA	T1		/ SAVE					/A030

IMWTLP,	CDFSYS			/ FETCH NEW VALUE			/A030
	TAD I	(CLOCK+2)	/					/A031
	CDFMYF			/					/A030
	TAD	T1		/ COMPARE WITH OLD VALUE		/A030
	SZA CLA			/ ANY CHANGE ?				/A030
	JMP I	IMWAIT		/ YES - RETURN				/A030

IMWJW,	CIFSYS			/ NO - JWAIT HERE			/A030
	JWAIT			/					/A030
	JMP	IMWTLP		/ 					/A030

