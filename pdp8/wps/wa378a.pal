	66	/PS
	10	/PI
	1	/FR
	0	/TO
	1	/IP
	0	/SPARE
	1	/AP
	1	/SPARE
	0	/SPARE
	0	/SE
	0	/SPARE
	0	/DA
	0	/TW
	0	/DD
	0	/CM
	0	/R1
	0	/R2
	0	/POSSIBLE FUTURE SPARE--POSITION 42			/A001


