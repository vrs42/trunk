	CLA CLL CML RTR		/=2000				/A015
	AND	RZXDIR		/MASK VERIFY BIT		/A015
	DCA	RZXVFY		/SET VERIFY SWITCH		/A015
	CLA CLL CML RTR		/2000				/A015
	CMA			/SET TO CLEAR SWITCH IN RZXDIR	/A015
	AND	RZXDIR						/A015
