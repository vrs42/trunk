	PAGE

CULTT0,	AC7776			/TO PRINTER?
	TAD	CULACT
	SZA CLA
	JMP	CULT1		/NO

	CIFMNU
	JMS I	IOACAL		/YES
	0
	CULS5
	JMP	CULT2

CULT1,	AC0001
	TAD	CULTBO		/GET CORRECT STRING FOR TOP, BOTTOM, OVERWRITE
	TAD	(CULSTB)
	DCA	CULT1A

	IFDEF GERMAN <
	JMS	GERPHR		/PRINT SPECIAL PHRASE
		>	/END IFDEF GERMAN

	TAD	OTFIL		/BREAK OUT FILE AND DRIVE NUMBERS
	AND	P377
