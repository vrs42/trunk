POPT,	0			/COME HERE AFTER FINDING A LEFT PAREN
/
POPT1,	JMS	CURLEV
/
POPT3,	DCA	POPT2		/SAVE FOR THE LOOKUP
	JMS I	XLOOKU		/EXECUTE THE LOOKUP
POPT2,	0
	POPTBL			/2ND LEVEL TABLE FOR POSTION
	JMP	POPT1		/NOT FOUND, GET ANOTHER
	DCA	POPT2		/ELSE SAVE THE POINTER
	JMS I	POPT2		/AND DISPATCH TO POINTER ADDRESS
/
	JMS	DOPOS		/EXECUTE THE PRIMS
/
/RETURN HERE ON W,B,E OPTIONS
/
	SNA
	JMP	POPT1		/GET ANOTHER CHARACTER
	JMP	POPT3
/
POSITX,	0
	JMP I	POPT

