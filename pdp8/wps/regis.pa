POSBLK,	POSTN1			/POSITION COMMAND
MBX,	0
MBY,	0

VECBLK,	GETVEC			/VECTOR COMMAND
VBX,	0
VBY,	0

/
/PVGEN - ROUTINE TO HANDLE GETTING POSITION AND VECTOR NUMERICS
/
PVGEN,	0

	CLA
	TAD	POSX		/SEE IF RELATIVE OR ABSOLUTE
	SNA CLA			/SKIP IF RELATIVE
	JMP	GENPX		/MOVE NEW VALUE OF X TO PLACE OF USE
	FPINT			/CALL THE FP INTERPRETTER
	FGET	CURX		/CURRENT VALUE TO FAC
	FADD	POSX+1		/ADD IT TO EXISTING VALUE
	FPUT	POSX+1		/AND RETURN IT TO NEW VALUES
	FEXT
GENPX,	FPINT			/CALL THE FP INTERPRETTER
	FGET	POSX+1
	FPUT	CURX		/STORE THE NEW VALUE OF X
	FEXT			/EXIT FLOATING POINT
/
/NOW SETUP THE NEW VALUE OF Y
/
	TAD	POSY		/SEE IF RELATIVE OR ABSOLUTE
	SNA CLA			/SKIP IF RELATIVE
	JMP	GENPY		/MOVE NEW VALUE OF Y TO PLACE OF USE
	FPINT			/CALL THE FP INTERPRETTER
	FGET	CURY		/CURRENT VALUE TO FAC
	FADD	POSY+1		/ADD IT TO THE CURRENT VALUE
	FPUT	POSY+1		/AND RETURN IT TO NEW VALUES
	FEXT
GENPY,	FPINT			/CALL THE FP INTERPRETTER
	FGET	POSY+1
	FPUT	CURY		/STORE THE NEW VALUE OF Y
	FEXT			/EXIT FLOATING POINT

	JMP I	PVGEN		/RETURN


