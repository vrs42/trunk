	DCA	SHYBLK+1	/SAVE

	CIF	PRMFLD
	TAD	(SHYBLK	
	JMS I	XPRIMS
	JMP 	WOPS10		/RETURN TO CALLER

WOPS9,	CIF	PRMFLD
	TAD	(SHOBLK		/TURN OFF SHADING
	JMS I	XPRIMS

WOPS10,	JMS	RESCUR		/RESTORE CURRENT X AND Y
	TAD	CHAR
	JMP I	WOPS		/RETURN TO CALLER

WOPSQT,	0
