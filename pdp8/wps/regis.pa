FNORM,	0
	CLA CLL
	DCA	MP1		/0 # OF SHIFTS
	DCA	MP3		/RESET SWITCH
	TAD	HORDER
	SPA			/INPUT < 0
	ISZ	MP3		/YES, SET SWITCH
	SZA CLA			/FAC = 0 ?
	JMP	GO6		/NO
	TAD	LORDER
	SZA CLA
	JMP	GO6		/NO
	TAD	OVER2
	SZA CLA
	JMP	GO6		/NO
