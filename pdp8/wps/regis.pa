	ISZ	LPRUTM		/INCRMENT THE COUNTER
	NEXT			/AND GET ANOTHER CHARACTER
	JMP I	LPRUN		/WHEN COUNT = 0 WE'RE DONE

LPRUN5,	TAD	CHAR		/GET THE CHARACTER
	TAD	MLPREN		/IS IT A LEFT PAREN
	SZA CLA			/SKIP IF YES
	NEXT			/NO, CHECK NEXT CHARACTER
	STA			/ADD -1 TO THE COUNT
	TAD	LPRUTM		/ADD TO CURRENT COUNT
	DCA	LPRUTM		/SAVE IT
	NEXT			/THEN GET NEXT CHARACTER

