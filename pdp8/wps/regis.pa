	CLA CLL
	TAD	LORDER
	RAL
	DCA	LORDER
	TAD	HORDER
	RAL	
	DCA	HORDER
	TAD	EX1
	RAL
	DCA	EX1
	JMP I	MULT2


DUBLAD,	0			/DOUBLE PRECISION ADDITION
	CLA CLL
	TAD	LORDER
	TAD	LOW1
	DCA	LORDER
	RAL
	TAD	HORDER
	TAD	HIGH1
	DCA	HORDER
	RAL
	TAD	EX1
	DCA	EX1
	JMP I 	DUBLAD


MSIGN,	0			/ROUTINE TO FORM
