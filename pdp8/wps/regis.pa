	DCA	OCLTMP		/SAVE IT FOR NOW
	DCA	FULL		/TERMINATE THE FULL CONDITION
	TAD	(377		/TERMINATOR
	JMS	STMAC		/TO THE BUFFER
OCLOS1,	TAD	OCLTMP		/GET BACK TERMINATOR VALUE
	JMS	STMAC		/TO THE BUFFER
