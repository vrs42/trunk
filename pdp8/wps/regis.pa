/MOVEP ROUTINE
/THIS ROUTINE WILL STORE THE RESULTS OF CALL +1 INTO POSX
/AND CALL+2 INTO POSY AS RELATIVE VALUES
/

MOVEP,	0
	TAD I	MOVEP		/RELATIVE VALUE OF X
	DCA	MOVEP1		/SAVE IT
	ISZ	MOVEP
	TAD	(POSX		/DO X FIRST
	DCA	MOVEP2
	TAD	(-4		/NUMBER OF WORDS, REL. FLAG + 3 FP DATA WORDS
	DCA	MOVEP3
	JMS	MOVEP4		/DO THE MOVE
	TAD I	MOVEP		/RELATIVE VALUE OF Y
	DCA	MOVEP1		/SAVE IT
	ISZ	MOVEP
	TAD	(POSY		/NOW DO Y
	DCA	MOVEP2
	TAD	(-4		/NUMBER OF WORDS
	DCA	MOVEP3
	JMS	MOVEP4		/DO THE MOVE
	JMP I	MOVEP		/EXIT

