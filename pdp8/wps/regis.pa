	CIF CDF	TBLFLD
	TAD	(-32		/INIT THE FILL COUNTER.
	DCA	10		/USE AN AUTO INDEX AS A TEMPORARY
	TAD	(MSTACK-1		/SET UP BUFFER ADDRESS
	DCA	11
	DCA I	11		/NOW THE ACTUAL CLEAR LOOP
	ISZ	10		/UPDATE COUNTER
	JMP	.-2		/STAY IN THE LOOP TILL DONE.
	TAD	(-27		/AMOUNT OF FREE SPACE WHEN THE STATCK IS FILLED
	DCA I	11
	JMS	STTAB		/RESTORE THE NEW TABLE
	PR3
	4000+MCFLD+TABFLD	/MARK THE END OF THE TABLE
	ZZERO+1
	33
	-1
	-1
	DCA	MACSTK
CLRGR9,	HLT
