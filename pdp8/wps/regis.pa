/
FLGT,	0
FLGTA,	TAD	EX1
	DCA	EXP
	TAD	HIGH1
	DCA	HORDER
	TAD	LOW1
	DCA	LORDER
	JMP	FPNTA



/FLOATING EXIT OR SUBROUTINE = 00XX

FEXIT,	0
	JMP I	FPNT

