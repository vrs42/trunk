/RESTORE THE POINT PREVIOUSLY SAVED
/

RESCUR,	0
	TAD	TEMP1		/RESTORE STARTING X
	DCA	CURX+1
	TAD	TEMP1A
	DCA	CURX+2
	TAD	TEMP2		/RESTORE STARTING Y
