/WOPN - WRITE OPTION NEGATE
/
WOPN,	0
	DCA	NEGBLK+1	/CLEAR
	JMS I	XGETNU		/SEE IF NON-ZERO
	JMP	WOPNA		/ = 0 SO GO CLEAR NEGATE MODE
	TAD	NUMMER+2
	DCA	NEGBLK+1	/SAVE IN COMMAND BLOCK
WOPNA,	CIF	PRMFLD
	TAD	(NEGBLK
	JMS I	XPRIMS

	TAD	CHAR		/GET THE CHARACTER BACK THAT TERMINATED INPUT
	JMP I	WOPN		/AND THEN RETURN
	
