	JMS	MULT2		/MULTIPLY BY TWO
	JMS	DUBLAD		/CALL DOUBLE ADD
	JMS 	MULT2
	TAD	DIGIT		/ADD LAST DIGIT RECEIVED
	DCA	LOW1
	DCA	HIGH1
	JMS	DUBLAD
	TAD	EX1		/EXIT WITH REMAINDER
	JMP I	MULT10		/IN AC
/
MULT2,	0			/MULTIPLY LORDER, HORDER BY 2
