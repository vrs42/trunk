/

POSIT,	0
POSIT1,	JMS	CURLEV		/ESTABLISH THIS LEVEL OF PROCESSING FOR
				/NEXT INCOMING CHARACTER.
/
	DCA	POSCMD		/SAVE IT FOR THE LOOKUP
	JMS I	XLOOKU		/EXECUTE A LOOKUP
POSCMD,	0
	POSTAB			/1ST LEVEL OPTION TABLE
	JMP	PCMDER		/GO HERE ON ERROR
	DCA	POSCMD		/SAVE THE POINTER HERE ON RETURNING
	JMS I	POSCMD		/AND DISPATCH TO POINTER ADDRESS
/
	SKP CLA
	JMS	DOPOS		/CALL THE PRIMS
	JMP	POSIT1		/GET NEXT CHAR AND RE-ESTABLISH THIS LEVEL

