/	NOP
/	NOP
/	NOP
/WOPFA,	TAD	CHAR		/RETURN THE CHARACTER IN THE AC
/	JMP I	WOPF
//
/PLNSEL,	GTPLNS			/PLANE SELECT COMMAND
/PMASK,	0			/PLANE SELECT MASK
/

/
/SET-UP STUFF
/
CIRSET,	0
	TAD	DXI+2		/GET THE CURRENT X POSTITION
	DCA	CIRBLK+1	/CURRENT X VALUE
	TAD	DYI+2		/Y POSITION
	DCA	CIRBLK+2

	JMP I	CIRSET		/RETURN
