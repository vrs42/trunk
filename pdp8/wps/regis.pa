/
/INPUT A DECIMAL DIGIT. RETURN CALL +2 AND AC= NUMBER IF VALID
/AND CALL PLUS ONE AC=0 IF NOT VALID.

GETDIG,	0
	JMS	CURLEV		/THIS LEVEL FOR PROCESSING
	TAD	(-60		/NOW SEE IF IT IS NUMERIC OR NOT.
	SPA			/SKIP IF STILL VALID
	JMP	GETDGC		/NOT NUMERIC
