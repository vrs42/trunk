			/  3=ERASE)
SHDFLG,	0		/SHADE FLAG 0=OFF 1=ON
YREFLN,	0		/Y REFERENCE LINE USED FOR SHADING
YREFLG,	0		/Y REFERENCE FLAG INDICATING LINES POSITION
YREF,	0		/Y REFERENCE CLIPPED CO-ORDINATE
