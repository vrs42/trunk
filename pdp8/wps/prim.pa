YFLAG2,	0		/POSITION OF Y CO-ORDINATE TO SCREEN
XTEMP1,	0		/SAVED "FROM" X CO-ORDINATE
XTEMP2,	0		/SAVED "TO"   X CO-ORDINATE
PYPOS1,	0		/PHYSICAL Y POSITION 1 ON SCREEN LOGICAL/2
PYPOS2,	0		/PHYSICAL Y POSITION 2 ON SCREEN LOGICAL/2
LININD,	0		/USED TO INDICATE WHERABOUTS OF LINE
