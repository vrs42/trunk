GTLMLT,	0
	GETPRM			/GET LINE PATTERN MULTIPLIER FROM CALLING FIELD
	SNA	SPA		/SKIP IF NUMBER GREATER THEN 0
	CLA	IAC		/WAS 0 OR LESS - DEFAULT TO 1
	DCA	PATMLT		/SAVE THE PATTERN MULTIPLIER
	JMS I	XXUPDP		/GO UPDATE THE LINE DRAWING PATTERN
	JMP  I  GTLMLT		/EXIT BACK TO CALLER
