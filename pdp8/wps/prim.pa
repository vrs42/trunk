/-------------------------------------------------------------------------------
/ CRVBGN - CURVE BEGIN OPEN
/------------------------------------------------------------------------------
/
CRVBGN,	0
	DCA	CLSCRV		/CLOSE CURVE=FALSE (CRVBGN) - TRUE (CRVCLS)
	DCA	INDEX		/INITIALIZE INDEX TO FIRST ELEMENT
	JMS	SVPOSA		/SAVE X AND Y IN POSITION ARRAY
