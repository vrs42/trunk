/ ----------------------------------
/ FULARC - DRAW A SEGMENT OF A CURVE
/ ----------------------------------
/
FULARC,	0
	DCA	ARCARY		/SAVE THE BASE ADDRESS OF THE 4 POINTS
	TAD	K0012		/INITIALIZE DRAW CURVE COUNT
	DCA	REMAIN		/SAVE IT
	TAD	K11CRV		/INITIALIZE NUMBER OF SEGMENTS TO DRAW
	DCA	SEG		/SAVE THE SEGMENT COUNTER
	JMS  I  CRVDRW		/GO INTERPOLATE AND DRAW CURVE
ARCARY,	0			/BASE ADDRESS OF 4 POINTS TO INTERPOLATE
	JMP  I  FULARC		/ARC HAS BEEN DRAWN EXIT
/
/
K11CRV,	11
CRVDRW,	XCURVE

