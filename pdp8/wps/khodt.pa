	ISZ	TEMP
	DCA I	TEMP
	ISZ	TEMP		/ end of list?
	TAD I	TEMP
	SZA CLA
	JMP	XCOL2		/ :no -- do next entry
	JMS I	[PRCTST		/ :yes -- which processor?
	JMP	XCOL3		/ :Z80
	TAD	ARGHI		/ :6120 -- set PC
	AND	(7
	MQL
	MQA
	R3L
	MQA
	DCA I	[SVFL
	TAD	ARGLO
	DCA I	[SVPC
