	JMS I	[PRCH		/ :no -- display name
	TAD	(ASCII&"=
	JMS I	[PRCH
	ISZ	TEMP		/ display reg in addr size
	TAD	TEMP
	DCA	.+2
	JMS I	[DYADR
		0
	ISZ	TEMP		/ bump to next entry
	ISZ	TEMP
	ISZ	CNTCNT		/ 8th reg?
	JMP	DYSZLP		/ :no -- do next entry
	JMS I	[CRLF		/ :yes -- begin new line
