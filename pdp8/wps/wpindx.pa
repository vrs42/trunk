/ MISCELLANEOUS CONSTANTS
	OCTAL
OFSBTM=12		/OFFSET OF INDIVIDUAL FILE POINTERS WITHIN HOME BLOCK
TAB=11
SPACE=40
BS=10			/BACK SPACE INDICATING START OF DEAD KEY
WRAPBT=2000		/WORD WRAP BIT
BELL=7			/CONTROL-G (NEEDS-WORD-WRAPPING)
