	 JMP	CUISR3	/NON-SKIP EOF RETURN
	CIA		/COMPARE WITH NEXT CHAR IN STRING
	TAD I	CUISSP	/GET THE CHAR
	SZA CLA
	 JMP	CUISR1	/NO - RE-INIT
	ISZ	CUISSP	/GET NEXT CHAR FROM STRING
	TAD I	CUISSP	/END?
	SZA CLA
	 JMP	CUISR2	/NO - CHECK NEXT CHAR
	ISZ	CUISRC	/YES - ALL DONE - SKIP RETURN
CUISR3,	ISZ	CUISRC
	JMP I	CUISRC	/RETURN

CUISSP=T2		/CHAR PTR				/A022
