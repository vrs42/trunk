NODCOPTN,
	CLA
	TAD	KBTFL1		/TAKE "TO DOCUMENT" OUT OF THIS PASS
	AND	(17)
	DCA	KBTFL1
	JMP I	KB2DOC		/RETURN TO CALLER.

