	JMP	CKTRU		/0 TYPE, RECORD MATCHED, ALL DONE
	SPA			/SEE IF 'TRUE'
	JMP	CKNEG		/PROBABLY NOT, GO MAKE SURE
	AND	P177		/GET RID OF FLAGS
