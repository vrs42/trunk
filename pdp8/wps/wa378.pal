/									/A012
/***********************************************************************/A012
MSIYDT,									/A012
	XX								/A012
	CIFMNU								/M012
	JMS I	IOACAL							/M012
	0								/M012
	TXCS2		/ G. P. CONTROL STRING, TWO SUBSTRINGS		/A037
	2105		/ POSITION OF 1ST SUBSTRING			/A037
	TXIYD		/ IF YOU DO PRESS Y, OF RETURN ETC,		/M012
	2305								/M012
	TXPRCN		/ "PRESS RETURN TO CONTINUE TO NEXT..."		/A037
	JMS	ORGOLD							/M012
		ORAR							/M012
	JMP I	MSIYDT							/A012
