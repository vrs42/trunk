	SPA
	JMP	CKNG2		/'FALSE' DOESN'T HELP
	AND	P177		/GET RID OF FLAGS
	TAD	(-1
	SNA CLA
	JMP	CHKML		/FOUND IT, START LOOKING AGAIN
	JMP	CKNG2		/NOPE, KEEP LOOKING

