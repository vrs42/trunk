	JMS I IOACAL		/CALL THE IOA DISPLAY ROUTINE		/A001
		0		/DEFAULT OUTPUT ROUTINE			/A001
		INSMS0		/ADDRESS OF TEXT CONTROL STRING		/A022
		1013		/CURSOR POSITION FOR ERROR MESSAGE	/M022
		INSMS1		/ADDRESS OF "THE FEATURE ---" MESSAGE	/M022
		1213		/CURSOR POSITION FOR ERROR MESSAGE	/M022
