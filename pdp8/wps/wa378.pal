PAND,	IFDEF ENGLSH <TAD ("A-200)>	/ SEE IF CHAR IS 'A' ?
	IFDEF ITALIAN<TAD ("E-200)>
	JMS	PCMPAR		/ COMPARE
	JMP I	PZERR		/ NO MATCH RETURN
