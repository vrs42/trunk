	PAGE

				/ REMAP BITS FROM SETUPV,TO CONFORM WITH
				/ NEW DISPLAY (NO 'CURSOR VISIBILITY')
REMAP,	CLL CLA			/ BE SURE
	TAD	SETUVL		/
	AND (7703)		/ M7703 SAVE ALL BITS BUT B7-B9
	DCA	T4		/ STORE
	TAD	SETUVL		/
	AND (0034)		/ M0034, CAPTURE B7-B9
	RAL			/ REPOSITION TO MATCH NEW DISPLAY
	TAD	T4		/ ADD IN UNCHANGED BITS
	DCA	SETUPV		/ SAVE REMAPPED BITS IN THE "REAL" SETUPVALUE
	JMP	LOOP		/ RETURN FROM 'SELECT' ROUTINE


BLANKC,	TEXT	\!P!S\		/ CONTROL STRING TO BLANK LINES

BLANKT,
