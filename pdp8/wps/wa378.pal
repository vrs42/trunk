	67
	70
/
WRITA2,	42 			/ ++++
	41
	44 			/ ++++
	43
	51 			/ ++++
	50
	55 			/ ++++
	54
	57 			/ ++++
	56
/
REDTAB,	7343 			/ ++++
	7342 			/ TABLE TO CONVERT SIXBIT TO WPW 7-BIT
	7345 			/ ++++
	7344
	7411
	7410
	7415
	7347 			/ ++++
	7346
	7412
	7414
	7351 			/ ++++
	7350
	7353 			/ ++++
	7352
	7407 			/ ILLEGAL
	133
	134
	135
	136
	137
	7407
	7416
	7417


