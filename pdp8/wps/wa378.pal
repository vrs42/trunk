	DCA	DERCTM
	TAD	(DEBUF-1) 	/ SET THE STARTING ADDRESS
	DCA	X1
DECLFG,	TAD I	DERDNM 		/ GET THE TERMINATING STRING OF A RECORD
	DCA	DETMP1
DELUP2,	CLA
	CIFFIO 			/ ++++					/M0009
	FILEIO 			/ ++++					/M0009
	XRDFNC 			/ GET A CHARACTER
	SPA 			/ ++++
	JMP	DERRO3
	SNA 			/ ++++
	JMP	DEOF 		/ REACHED END OF FILE
	JMS	DELFLT 		/ CHECK FOR NOT PRINT THINGS
	JMP	DELUP2 		/ NG
/
	AND	P177
	ISZ	DERCTM 		/ INCREMENT CHARACTER COUNT
	SKP 			/ ++++
	JMP	DERRO1
	CIA
	TAD I	DETMP1 		/ CHECK FOR A DELIMITER
	SNA 			/ ++++
	JMP	DEUPDT
	CIA 			/ ++++
