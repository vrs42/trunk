/
/	CLASIX - INITALIZE THE VALUES IN REDSIX AND WRISIX
/
CLASIX,
	XX
	CLA
	RDF 			/ IF CROSS FIELD CALLED MAKE SURE RETURNS CORRECTLY
	TAD	CIDF0
	DCA	CLASXX
/
	CDFMYF
	DCA	WRSHIF 		/ WRITE SHIFT FLAG
	DCA	WRIVBF 		/ VERTICAL BAR ESCAPE FLAG
	DCA	WRIBES 		/ ESCAPE
/
	DCA	REDNXT 		/ BUFIF RETURNING A 2 CHARACTER ESCAPE THE SECOND CHARACTER
				/ IS STORED HERE FOR NEXT CALL
	DCA	REDESF
	DCA	REDSHF
	DCA	REDSXC
/
CLASXX,	XX
	JMP I	CLASIX


