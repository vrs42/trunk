	JMS	PRIM		/GO TO PRIM				/A041
	JMP	NOBUFF		/NOW GET BACK IN LINE			/A041
TRMADR,	41			/TERMINATE GRFX OP CODE			/A041
			>/END IFDEF VT125R				/A041


