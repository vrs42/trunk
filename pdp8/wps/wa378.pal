PROCCT,				/ COUNTER INTO ROCESS RECORD STRING	/A018
THENCT,	0			/ COUNTER INTO THEN STRING		/A018

THENST,	IFDEF ENGLSH <	"T-200; "H-200; "E-200; "N-200; "P-200; 0>	/A018
	IFDEF ITALIAN<
