/
/			THIS ROUTINE GETS DENSITY
/			QBLK CONTAINS DRIVE TO PROCESS			/M032
/			ONE OF THE FOLLOWING CODES IS RETURNED		/A032
/			IN LOCATION DENSTY:				/A032
/				0	RX01/RX02 SINGLE DENSITY	/A032
/				1	RX02	  DOUBLE DENSITY	/A032
/				2	RX50	  SINGLE SIDED		/A032
/				3	RX50	  DOUBLE SIDED		/A032
/
/**************************************************************************
FMTDEN,	XX
	TAD	(RXEDN+4000)	/ GET GET DENSITY CODE		/A014
	DCA	FMTQBK+RXQFNC	/ FUNCTION TO Q-BLOCK		/A014
	JMS	FMTRXT		/ GO GET DENSITY OF DRIVE	/A014
	JMP	DRVPRB		/ ERROR--GO SEE IF DOOR WAS OPEN	/A045
	TAD	FMTQBK+RXQSPC	/ GET DENSITY CODE		/A014
	DCA	DENSTY		/ SAVE DENSITY				
	JMP I	FMTDEN		/ RETURN				

