	CASE;MNTMP1
		4;ADR7CE	/SPECIAL FOR A CREATE ERROR
		6;ADR7LG	/LOGON PROCESSOR IN GRAPHICS MODE	/A114
		7;ADR7PS	/ Print with Print screen		/A121

	DISP;2205;TEXT '&CANNOT CONNECT, '
	CASE;MNTMP1
		2;ADR7PT
		3;ADR7NP	/ NON-EXISTANT PRINTER.			/A034
		5;ADR7NH	/ NO COMM HARDWARE PRESENT.		/A042

