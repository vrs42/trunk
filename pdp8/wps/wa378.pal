/ IF FROM "CUUNDF" (UNDEFINED), AC = -3; ELSE AC = 0; USED IN LAST BLOCK

CUDILM,
	XX

	DCA CUDILA		/ SAVE CHAR. COUNT FOR END CONDITION	/A033
				/ SET = -2 BY UNDEFINED; ELSE = 0	/A033

