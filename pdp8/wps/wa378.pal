    ISDRVE    /"DRIVE"        /A054
DRVPMT,    VSNULL    /VSNULL OR "/DEVICE"      /A054
    ISDSKT    /"DISKETTE"        /A054
DSKPMT,    VSNULL    /VSNULL OR "/VOLUME"      /A050
    1505              /A027
  JMS I  IOASET    /CALL IOA SET UP      /A050
    -3    /WITH 3 ARGUMENTS      /A050
    VPRTGM    /AND PRESS RETURN      /A027
    2405    /OR PRESS GOLD MENU TO RECALL MAIN MENU  /M054
    2605              /A027
REASK,  CIFMNU                /A027
  JMS I  INACAL    /GO GET WHAT THE USER TYPED IN    /A027
    INAREA              /A027
