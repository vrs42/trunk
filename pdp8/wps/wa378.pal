	DCA I	(MUBUF+MNLOCK)	/  WILL EFFECTIVLY LOCK IT FROM UPDATE!	/A015
	CDFMYF			/ BACK TO MY FIELD			/A026
	ISZ	AXDIS 		/ OK SKIP RETURN MEANS CONTINUE
AXGLD,
	CLA 			/ IF USER TYPED GM
	TAD	(RXEWT+2000) 	/ DO A WRITE
	JMS	AXDST
/
	CDIEDT
	JMP I	AXDIS

/
/	AXLRT - UNLOCK THE LOG FILE
/
/AXLRT,	XX 								/D018
/D014;/
/D014;	IFDEF WS102 <
/D014;	CDFMYF
/D014;	CIFPRT
/D014;	JMS I	(ULKFIL)
/D014;	LOGNO
/D014;	USERNO
/D014;/
/D014;	>
/D014;/
/	CLA 								/D018
/D015;	CDFMNU			/ CHANGE TO MENU FIELD.			/A014
/D015;	DCA I	(MUBUF+MNLOCK)	/ CLEAR MENU LOCK WORD.			/A014
/	CDIEDT 								/D018
/	JMP I	AXLRT 							/D018
/
	PAGE

