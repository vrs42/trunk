	TAD	CURPTR 		/ INITIALIZE LINE 23 POINTER		/A157
	DCA	LINE23							/A157
	DCA	CURSOR 		/ CLEAR CURSOR				/A157
	DCA	LOWLIM		/ CLEAR LOLIM				/A157

	AC7777			/ A180
	CIFMNU
	PGSWAP

/ CLEAR CURRENT RULER IF NOT DOING GOTO-PAGE, GOLD:BOT, OR GOTO-RULER;	/A157
/ CLEAR "GOTO-PAGE, GOLD:BOTTOM, OR GOTO-RULER" FLAG.			/A157
	CLA CLL CML RAR		/ L,AC = 04000				/A157
	TAD	RPBIN1		/ LINK=RPBIN1 BIT 0,AC0=-RPBIN1 BIT 0	/A157
	SMA								/A157
	 DCA	RPBIN1		/ CLEAR RPBIN1 BIT 0			/A157
				/ (CLEAR "GTP, GOLD:BOT, OR GTR" FLAG,	/A157
				/  BUT FLAG LIVES ON IN LINK)		/A157

	JMP	INIX04		/ CONTINUE ON NEXT PAGE


	X=.			/ INDICATE FIRST FREE LOCATION ON PAGE
