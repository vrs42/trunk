/D029	CDFMYF			/TEMP PATCH LOC				/A029
/D029	NOP			/TEMP PATCH LOC				/A029
/D029	NOP			/TEMP PATCH LOC				/A029
/D029CLRPTR,	0		/TEMP POINTER LOC			/A029
/D029CLRCNT,	-1000			/TEMP POINTER LOC			/A029
/D029	PRQ3			/USE PANEL REQUESTS TO SEE IF GRFX IN	/A024
/D029	CP2MM+40+RCPFLD		/XFER TO MYFLD (4) FROM REGIS CP FLD	/A024
/D029	0200			/SOURCE ADR (IN CP MEM)			/A024
/D029	DEBUFR			/DESTINATION ADR (IN MM)		/A024
/D029	-10			/8 WORDS IS MORE THAN ENOUGH FOR POS ID /A024
/D029	7777			/TERMINATOR				/A024
/D029	TAD	(-3057)		/IS OCT CODE AT 0200 OF REGIS		/A024
/D029	TAD	DEBUFR		/IS LOC 0200 OF CP REGIS		/A024
