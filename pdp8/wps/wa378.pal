	TAD	OTFIL2
	SNA
	JMP	XSKOP3		/NOBODY TO OPEN, RETURN.
	MQL
	TAD	OPFLOP		/PICK UP TYPE OF OPEN (TOP, BOTTOM, OVERWRITE)
	CIFFIO
	FILEIO
	XDSKIN
	SZA CLA			/ERROR?
