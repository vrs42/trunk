/ REPOR2 WILL SET UP THE LOCATIONS IN MNUFLD AS FOLLOWS:		/A025
/	MNTMP1 = 0, MEANING "LIST PROCESSING ERRORS"			/A035
/ 	MNTMP2 = NO. OF RECORDS PROCESSED				/A025
/ 	MNTMP3 = NO. OF RECORDS SELECTED				/A025
/ 	MNTMP4 = CURRENT RECORD COUNT					/A025
/ 	MNTMP5 = ERROR OR CONTROL NUMBER				/A025

	TAD	SUCREC		/ GET NUMBER OF RECORDS SELECTED	/M035
	CDFMNU								/A025
