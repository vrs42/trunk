/
/	AXDST - WILL READ OR WRITE THE COMMUNICATIONS SETTINGS DEPENDING ON THE
/	VALUE IN THE AC.  THE AC CONTAINS THE FUNCTION TO EXECUTE.
/
AXDST,
	XX
	DCA	QUQBLK+RXQFNC 	/ SET THE FUNCTION
/
	CDFMYF
	TAD	.-1 		/ SET THE BUFFER FIELD
	DCA	QUQBLK+RXQBFD
/
/D035	TAD	USERNO 		/ SET THE DRIVE
/D035	TAD	USERNO
	DCA	QUQBLK+RXQDRV
/
	TAD	(DLDCOM) 	/ SET THE BLOCK TO READ
	DCA	QUQBLK+RXQBLK
/
	TAD	(DFCOMA) 	/ SET THE BUFFER TO READ INTO
	DCA	QUQBLK+RXQBAD
/
	JMS	QURX 		/ GET THE BLOCK
	CLA
/
	ISZ	QUQBLK+RXQBLK 	/ GET THE NEXT BLOCK
/
	TAD	(DFCOMA+400)
	DCA	QUQBLK+RXQBAD
/
	JMS	QURX
	CLA
/
	JMP I	AXDST

