		EDMENU&3777;ADR7RT	/GOLD MENU
/D097	CALL;CR1BR;DLMCR1		/"WHEN TYPING..."
	CALL; A18BR; DLMA18		/ "WHEN TYPING TO THE MENU	/A097
	COPY;MNTMP2;MNTMP1		/RESTORE MNTMP1			/A061
	GOTO;ADR7E

ADR7RT,	RETURN

ADR7LG,	DISP;2205;TEXT '&CANNOT CALL !&LOGON PROCESSOR WHILE &T&M=!&GRAPHICS.'
	GOTO;ADR7DL							/A114
ADR7CE,	DISP;2205;TEXT '&CANNOT CREATE THE DOCUMENT !A'
	MNFNAM

	GOTO;ADR7DL

