	DCA SVDFLC	/AND SAVE FOR POSSIBLE USE IF FORMAT WORD FOUND	/A007
	TAD (DFAULT	/GET DEFAULT VALUE FOR FORMAT
	JMS SYMTSZ	/OUTPUT TO SYMBOL TABLE & CHECK FOR OVERFLOW	/M005

	TAD SYMPTR	/GET POINTER TO PLACE FOR SYMBOL VALUE WORDS	/A041
	DCA SYMVAR	/SAVE POINTER TO START OF SYMBOL VALUE		/A041
	JMS CHKTYP	/DO SPECIAL CHECK FOR EDITOR MATH		/A041

	/PUT OPRND VAR VALUE ADDR & "PUSH" RTN ADDR INTO OUTPUT LST

