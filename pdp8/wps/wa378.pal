	TAD	(DERVL2)	/ ADDR OF "VOLUME			/A030
	DCA	DERST2		/ INTO PARAMETER LIST			/A030
	TAD	(DERDKV)	/ ADDR OF "DISKETTE/VOLUME		/A030
	DCA	DERST3		/ INTO PARAMETER LIST			/A030
	JMP 	DERCEX		/ BBRANCH TO EXIT			/A030

DERCT1,	TAD	(DERDS2)	/ ADDR OF "DISKETTE			/A030
