	JMS	CHKREC		/CHECK FROM - TO RECORD NUMBER		/M042
	JMP	SLBLP		/SKIP RECORD, AND LOOK FOR NEXT RECORD	/M042
	JMP	SELDNX		/DONE ALL RECORDS OR HALT FLAG DETECTED	/M042

	JMS	INCNUM		/COUNT RECORD BEING PROCESSED		/A042
	RECPRO			/POINTER TO RECORD BEING PROCESSED	/A042
	TAD	(RECBUF		/RESET PTR IN AUTO-INDEX
	DCA	RCBPTR		/AFTER FIRST '<'
FNLP,	JMS	LFLDNM		/LOAD INTO GPBUF
