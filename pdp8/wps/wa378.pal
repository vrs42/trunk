/NUMBER OF CHARACTERS IF IT IS FOLLOWED BY A *.-1
CULS1,	IFDEF ENGLSH <
	TEXT '^P!E^P&SELECTING FROM LIST DOCUMENT: (^D.^D) ^A '
	*.-1
	TEXT '^P&USING SELECTION SPECIFICATION: (^D.^D) ^A '
