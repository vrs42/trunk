RZINCR,	0			/DO INIT AFTER 5 RETRIES      /A005
	JMS	RZSEEK		/CHECK TIME TO SEEK 079		/A022
	JMP I	RZINCR		/RETURN W/O INIT		/A022
RZIO06,	RXIINI			/INIT DSK			/M033
RZIO00,	RXISDN			/WAIT DONE			/M033
	JMP 	.-1
