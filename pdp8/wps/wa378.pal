/ CHECK FOR WINCHESTER							/A030

DERCKW,	XX								/A030
	CLA		/ CLEAR AC					/A030
	CDFMNU		/ MENU FIELD					/A030
	TAD MUBUF+MNOPTN	/ OPTION WORD				/A030
	CDFMYF		/ BACK TO THIS FIELD				/A030
	DCA	DEOPTN	/ SAVE VALUE					/A030
	AC0004		/ MASK - WINCHESTER INSTALLED			/A030
	AND	DEOPTN	/ IS WINNIE BIT SET ? 				/A030
	SNA	CLA	/ YES - SKIP AND CONTINUE			/A030
	JMP	DERCT1	/ NO - INSERT TEXT - DISKETTE, DRIVE		/A030
	TAD	CUSRC6	/ CK FOR DRIVE 0				/A030
	SNA		/ NO - SKIP AND CONTINUE			/A030
	JMP	DERCT2	/ YES - INSERT TEXT - DISKETTE,DRIVE,DISK/VOL	/A030
	TAD	(-1	/ CK FOR DRIVE 1				/A030
	SZA	CLA	/ YES - SKIP AND CONTINUE			/A030
	JMP	DERCT3	/ NO - INSERT TEXT - VOLUME,DEVICE,DISK/VOL	/A030
	AC0010		/ MASK - VOLUME ASSIGNED TO 1			/A030
	AND	DEOPTN	/ IS VOLUME ASSIGNED ?				/A030
	SNA	CLA	/ YES - SKIP & INSERT TEXT - VOL,DEV,DSK/VOL	/A030
	JMP	DERCT2	/ NO - GO INSERT TEXT - DSK,DRV,DSK/VOL		/A030

DERCT3,	TAD	(DERVL1)	/ ADDR OF "VOLUME ON DEVICE		/A030
