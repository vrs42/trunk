	TAD	(7)		/ COLUMN 33(8)
	>
	IFDEF V30NOR <
	TAD	(7)		/ COLUMN 33(8)
	>
	IFDEF V30SWE <
	TAD	(7)		/ COLUMN 33(8)
	>
	IFDEF DUTCH <
	TAD 	(12)
	>
	IFDEF SPANISH <
	TAD 	(12)
	>
	DCA PRTLN5

	TAD PRTLN5		/ SET POSITION FOR ATTRIBUTES
	IFDEF ENGLSH <
	TAD	(12)		/ COLUMN 45(8)
	>
	IFDEF ITALIAN <
	TAD	(12)		/ COLUMN 45(8)
	>
	IFDEF V30NOR <
	TAD	(12)		/ COLUMN 45(8)
	>
	IFDEF V30SWE <
