	DCA	BLDDRV		/STORE THE ERROR DRIVE NUMBER		/A001
	TAD	BLDFNR		/GET POINTER TO READ MESSAGE		/M022
	DCA	BLDFNC		/SET UP FOR READING ERROR		/A001
	TAD	QUQBLK+RXQFNC	/CHECK TO SEE IF IT IS READING ERROR	/M022
	AND	BLDC77		/GET RID OF THE 4000			/A001
