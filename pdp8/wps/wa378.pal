/D026	SZA CLA	
/D026	JMP	ACCONT		/NO CONTINUE
/D026	ISZ	ACISSW		/YES SET SW
/D026	JMP I	ACCHCK		/RETURN CALL+1(SKIP-GET NEXT)
/D026ACCONT,	ISZ	ACCHCK		/SET RETURN = CALL+3
/D026ACASIS,	ISZ	ACCHCK		/SET RETURN +2 PRINT CHAR AS IS	
/D026	DCA	ACISSW		/CLEAR SW
/D026	TAD	ACSVCH		/GET CHAR
/D026	BSW
/D026	JMP I	ACCHCK		/RET
/D026ACISSW,	0			/SW TO DETERMINE IF LAST CHAR WAS 77
/D026ACSVCH,	0			/SAVE CHAR WHILE PROCESSING
/D026CON100,	100
