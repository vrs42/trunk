CRT=1				/TO THE SCREEN
LQP=2				/TO THE PRINTER
HST=4				/TO THE SECONDARY COMMUNICATIONS LINE
H2T=10				/PRIMARY COMMUNICATIONS LINE (H2T)
IBM=H2T
DOC=20				/WITH OUTPUT FILE (DISK)

ERFLG,	0			/NONZERO CORRESPONDING TO TYPE OF ERROR DETECTED
				/(LAST OF THE 4 CRITICAL LOCATIONS)
