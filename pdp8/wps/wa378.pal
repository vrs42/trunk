/		BOTH FIELDS= FIELD 0
/
/****************************************************************
SETMOV,	0		/SET UP MOVE PARAMS
	TAD I	SETMOV
	ISZ	SETMOV
	DCA	INBUF	/FROM FIELD PTR
	TAD I	SETMOV
	ISZ	SETMOV
	DCA	OUTBUF	/TO FIELD PTR
	TAD	TIMLNT				/LENGTH OF TIME FIELD	/A032
	DCA	MOVCNT	/COUNTER
/D032MOVDAT,	0		/MOVE DATA FROM ONE FIELD TO ANOTHER
INCDF,									/M032
	TAD I	INBUF						/M032
	DCA I	OUTBUF							/M032
	ISZ	INBUF							/M032
	ISZ	OUTBUF	/SET TO NEXT WORD				/M032
