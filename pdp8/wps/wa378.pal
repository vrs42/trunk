EIUPPR,				/ CASE UPPER
	DCA	CASBIT		/ SET UP/LOW SWITCH
	IAC
EIUUDL,	IAC			/ REMOVE UNDERLINE
EIUBLD,	IAC			/ REMOVE BOLD
EIUNDL,	IAC			/ UNDERLINE
EIBOLD,				/ BOLD
	TAD	(BLDMOD)
	DCA	MOVMOD+1	/ SAVE FUNCTION TYPE
	TSTSLT
	JMP	SIMCHR		/ SIMULATE CHAR BUTTON IF NOT IN SELECT MODE
				/ ELSE RETURN HERE WITH
				/ CURRENT CHAR = START OF SELECT
	MODSET
