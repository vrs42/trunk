/D157 INIX04,	TAD	CURPTR 		/ INITIALIZE LINE 23 POINTER
/D157 	DCA	LINE23
/D157 	DCA	CURSOR 		/ CLEAR CURSOR
/D157 	DCA	LOWLIM		/ CLEAR LOLIM
	/ INHIBIT CLEARING OF CURRENT RULER FOR GOTO-RULER		/A157
INIX04,	SZL CLA			/ G-T-PAGE, GOLD:BOT OR G-T-RULER?	/A157
	 JMP	INIX05		/ YES: PRESERVE CURRENT RULER		/A157
	JMS	CLRULR 		/ NO: CLEAR RULERS
	JMS	COPRUL
INIX05,	TAD	FORMNO							/M157
