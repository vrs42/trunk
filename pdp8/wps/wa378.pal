CHKID2,				/					/A057
	JMS	CLRSCR		/ CLEAR THE SCREEN
	CIFMNU
	JMS I	IOACAL
	0
	TEXTG1			/ GENERAL PURPOSE--1 SUBSTRING
		1405
		TEXT3		/ "REPLACE THE ORIGINAL SYSTEM DISK...
		3000

	JMS	PPG		/ PRINT PRESS GOLD
	JMS	WTFRGR		/ WAIT FOR ONLY GOLD MENU
	JMP	CHKID1		/ AND GO CHECK ID AGAIN			/A057

