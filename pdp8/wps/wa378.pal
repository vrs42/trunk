SSMAT,	TAD	SFFLG		/SEE IF RECORD MATCHED
	SZA CLA
	JMP	RECLP		/NO, KEEP TRUCKING
	JMS	INCNUM		/COUNT THIS RECORD AS A SELECTED RECORD	/A042
	SUCREC			/POINTER TO MERGED RECORD COUNT		/M042
