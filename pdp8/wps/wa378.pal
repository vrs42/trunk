MYFLD,	CDFMYF			/BACK HERE				/A024
	SPA			/- IS FROM GOLD MENU			/A024
	JMP	CU3GMX		/LEAVE CU3				/A024
	DCA	QUQBLK+RXQDRV	/PLUG IT IN				/A024
