	AND	P177		/LOSE CONTROL
	TAD	(-41		/NON-PRINTING CHAR ?
	SPA
	JMP	SLBLP		/YES, KEEP LOOKING FOR '<'
	TAD	(-33		/NO, SEE IF A '<'
