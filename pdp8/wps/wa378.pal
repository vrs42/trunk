	/	V035	Changed RX50 FACTOR from 7 to 2
	/	V066	ADDED RD50 ENTRY FOR DMII V1.5
	/	V067	Changed CPYNOS & CPYPSK to reflect full trk buffering
	/		& ADD SECTOR WRAP ADJUSTMENT FACTOR ENTRY
PARTBL,	/CPYNOS	CPYLNT	CPYPSK	FACTOR	RXQTRK	TRKMXK	SECMXK	SECWRP
	-26 ; 	128 ;	-1 ;	3 ;	1 ;	-76 ;	-26 ;	0	/RX01
	-26 ;	256 ;	-1 ;	5 ;	1 ;	-76 ;	-26 ;	0	/RX02
	-10 ;	512 ;	-1 ;	3 ;	0 ;	-79 ;	-10 ;	0	/RX50
	-10 ;	512 ;	-1 ;	2 ;	78;	-79 ;	-10 ;	1	/RX50 FIRMWARE
PARTBM=.+5			/POINTER TO TRKMXK ENTRY		/A074
	-16 ;	512 ;	-1 ;	9 ;	0 ;	-49 ;	-16 ;	0	/RD50 WINNIE
	-10 ;	512 ;	-1 ;	2 ;	0 ;	-0 ;	-10 ;	1	/RX50 TRACK 0
