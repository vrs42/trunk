	>

IFDEF	V30SWE <
	TEXT '!X^P!A^S^S^S^S^S^P&DOK: (!D.!D) !A!Y'			/C235
	>

LINST5,	ESC; "[; "7; "m		/ SELECT REVERSE VIDEO
	0			/ ASCII STRING TERMINATOR

LINST6,	TEXT '                           ' / GRAPHICS BAR CHARACTER

LINST7,	TEXT '!X^P!A&P: '	/ SAVE CURSOR, SET ABSOLUTE, DISPLAY PAGE /C235

LINST8,	TEXT '!X'		/ SAVE CURSOR, SET ABSOLUTE		/C235

LINST9,	TEXT '!D!3D'

LINSTA,	TEXT '!D'


LINSTB,	
	IFDEF ENGLSH <TEXT ' ^P&L: '>
	IFDEF V30NOR <TEXT ' ^P&L: '>
	IFDEF V30SWE <TEXT ' ^P&L: '>
	IFDEF SPANISH <TEXT ' ^P&L: '>					/A255
	IFDEF ITALIAN <TEXT ' ^P&R: '>
	IFDEF DUTCH <TEXT ' ^P&R: '>

LINSTC,	
	IFDEF ENGLSH <TEXT '!D  ^P&C:!Y'>						/C235
	IFDEF V30NOR <TEXT '!D  ^P&K:!Y'>						/C235
	IFDEF V30SWE <TEXT '!D  ^P&K:!Y'>						/C235
	IFDEF SPANISH <TEXT '!D  ^P&C:!Y'>				/A255
	IFDEF ITALIAN <TEXT '!D  ^P&C:!Y'>						/C235
