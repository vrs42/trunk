	3014
	IFDEF V30NOR <
	PRTRYK>								/A013
	IFDEF V30SWE <
	PRTRYK>
	IFDEF SPANISH <
	PULSE >
	ISZ	CRERSW		/ CR-RET-ERROR SW			/A004
	JMP I	WINPTE		/ ERROR RET


WINPTF,	XX			/ PASSWORD ERROR
/D008	JMS I	WINWPT		/ BELL
	CIFMNU
	JMS I	IOACAL
	0
	PRTER7			/ "READ/WRITE PASSWORD ERROR ... "
	3000
	IFDEF V30NOR <
