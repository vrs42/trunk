	CDFMYF			/BACK TO THE FUNNY FARM!		/A007
	CIFPRT			/MAP SPOOLER.				/A007
	DCA	T1		/SAVE ROUTINE ADDRESS.			/A007
	AC0001			/SAY THAT WE WANT TO TRAP THE ERROR!!!	/A014
	JMS I	T1		/CHECK THE PRINTER ID.			/A007
	SKP			/SUCCESS RETURN.			/A014
