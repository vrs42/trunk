	SPA
	JMP	SETRL1
	MQL
	TAD	RLPOSN		/ SAVE PRM, GET POSITION
	CLL RTL
	RTL
	MQA			/ RLPOSN*16+PRM
	JMP	SETRLB		/ JUMP TO STORE, GET NEXT

