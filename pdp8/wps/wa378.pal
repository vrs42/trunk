PRTLNO,	3			/ LINE NO BEING PROCESSED, SET BY
				/ WINSA, WINSAL FROM PRTL06
CLRSCX,	CLRSCR			/ CLEAR SCREEN				/A008
PRTHDX,	PRTHDR			/ PRINT HEADER FOR BOTH LISTS		/A008
WINP7X,	WINPT7			/ ERROR MESSAGE ROUTINE			/A008
WINP5X,	WINPT5								/A008
WINWFX,	WINWFT			/ RING BELL				/A008
PRTLSX,	PRTLST			/ RETURN, GOLD MENU MESSAGE		/A008

QUBLK1,	DSKQUE 			/
 	0 			/
	0
WINQBK,				/ QBLOCK-
	0			/ RXQCOD	FLAGS RETURNED HERE
	0			/ RXQFNC	FUNCTION CODE
	0			/ RXQDN1
 	0			/ RXQDN2
 	0			/ RXQENO
