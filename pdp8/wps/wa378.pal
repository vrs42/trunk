LT=	74		/ LEFT ANGLE BRACKET
LF=	12		/ <LINE FEED>
CR=	15		/ <CARRIAGE RETURN>
KVTWIDTH=121		/ 81(10) IS THE WIDTH OF A LINE OF THE VT
