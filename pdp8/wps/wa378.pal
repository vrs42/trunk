	SZA CLA		/IF THEY ARE EQUAL TELL USER TO SPECIFY ANOTHER DRIVE
	JMP DKTST	/OTHERWISE SEE IF 4 DRIVE SYSTEM		M007
NDPRMT,	JMS ERASE
	JMS TOSMALL	/TELL USER THERE IS NOT ENOUGH ROOM FOR RESULT
	CIFMNU
	JMS I IOACAL
		0
		NWDRV		/TEXT TELLING USER TO SPECIFY ANOTHER DRIVE
		1205		/DISPLAY NEXT PROMPT ON LINE 12 COLUMN 5
	NWSTR, 0000		/ ADDR OF SUBSTRING			/A030
	JMP SRCUSRG	/GO PROMPT FOR RESULT DOC AGAIN

DKTST,	CDF 0		/CHANGE DATA FIELD TO SYSTEM FIELD		  A007
	TAD I (RXONLN)	/GET NUMBER OF DISKETTES ON LINE NOTE AC IS ZERO  A007
	CDFMYF		/CHANGE DATA FIELD BACK TO MINE			  A007
	TAD (-4)	/SEE IF IT IS 4					  A007
