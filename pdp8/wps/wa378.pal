/D029	DEBUFR			/MAY AS WELL USE THIS BUFFER		/A024
/D029	-10			/NEG WORD COUNT				/A024
/D029	7777			/TERMINATOR				/A024
/D029	CLA CLL			/NEVER TRUST A COMPUTER YOU CAN'T SEE	/A024
/D029	TAD	(-3066)		/NEG VALUE OF INSTR. AT 201 OF PRIM CODE/A024
