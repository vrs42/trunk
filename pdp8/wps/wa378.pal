	SNA			/ SKIP IF: YES
	JMP	UPDRLB		/ JUST SET NEW POSITION
	MQL			/ HOLD POSITION ON LINE OF OLD RULER
				/  SETTING
	IAC			/ SET AC = NO_SETTING RULER_SETTING_TYPE
	JMS	PUTBYT		/ PUT THIS NO_SETTING CHARACTER IN RULER
	NWRUL
UPDRLB,	CDFMNU
	TAD	RLPOSN		/ STORE NEW RULER_SETTING_TYPE'S POSITION
	DCA I	T2
UPDRLA,	TAD	RLPOSN		/ SET NEW RULER SETTING IN RULER
	MQL			/ HOLD IT'S POSITION IN RULER
	TAD	RLTYP		/ GET TYPE OF SETTING
	JMS	PUTBYT		/ PUT IT IN NWRUL
	NWRUL
	JMP I	UPDRUL		/ RETURN
RLTYP,	.-.
