	TAD I	AXSRPK
	ISZ	AXSRPK
	DCA	AXSRP1
/
	TAD I	AXSRPK
	ISZ	AXSRPK
	DCA	AXSRP2
/
	JMS	AXSNP
AXSRP1,	XX
AXSRP2,	XX
/
	JMP	AXSNOX 		/ SPFLAG RETURN
	JMP	AXSNOX 		/ TIMED OUT
/
	JMP I	AXSRPK
/
