/AX MENU PROCESSOR

/THE AX MENU THAT TAKES OF ALL PROMPTS THAT NEED A DOCUMENT FOR A RESPONSE
/THAT IS LOG DOCUMENT, THE TEST LIST AND DEFAULT LIST

RELOC
ADMAD3=.
X=DLMAD3		/ INDICATE DISK BLOCK WHERE MENU IS LOADED
RELOC 0

ADR3ST,
ADR3S,	SET;3;MNTMP1							/a052
	DISP;100;TEXT '!E     '
	DISP;1220;TEXT '!&PREPARATION'
	DISP;2205;TEXT '&TYPE THE NAME OF THE LOG DOCUMENT'
	DISP;2305;TEXT 'IF ONE IS DESIRED; THEN PRESS !&RETURN'
	MXDISP;2505;X03GMM;DLMX03 / OR PRESS GOLD MENU TO RECALL THE MENU
ADR3R,	READ;MNTMP2;ADR3E	/GET DOCUMENT NAME
	FILNAM;ADR3CR;ADR3ND	/CHECK IF DOCUMENT EXISTS
	SET;1;MNTMP2
	SET;MUBUF+MNIBUF;MNPOS	/SET THE POINTER TO BEGINING OF TEXT	/M080
	RETURN

ADR3GM,	SET;7;MNTMP1
	RETURN
ADR3E,	CASE;MNSYSA			/TEST FOR "GOLD MENU" KEY	/M080
		EDMENU&3777;ADR3GM
/D097	CALL; CR1BR; DLMCR1		/ERROR - TYPE ONLY VALID KEYS
	CALL; A18BR; DLMA18		/ "WHEN TYPING TO THE MENU	/A097
	GOTO;ADR3S			/GO BACK AND TRY AGAIN FOR DOC NAME

ADR3CR,	SET;-1;MNTMP2
	RETURN

ADR3ND,	SET;MUBUF+MNIBUF;MNPOS	/RESET TO BEGINNING OF TEST FOR THE COPY IN AX/M080
	SET;0;MNTMP2
	RETURN

