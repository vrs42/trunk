/	FORMAT FOR THE MNPRTB WORD:
/	BITS		INFORMATION
/
/	0-2	TERMINAL MODE (0=VT52, 1=VT100, 2=DECMATE, 3=VT125, 4=VT227
/
/	3-6		BREAK TIME (IN TENTHS OF A SECOND).
/
/
/
/	7		PORT SELECT (0=PRIMARY, 1=ALTERNATE)
/
/	8-11		PRINTER BAUD RATE.
/
/	**********************************************************
/
/	LIMITS - VALUES THAT ARE CHECKED FOR IN THE MENU
/
/	CHARACTER SIZE - CAN BE FROM 5 - 8
/
/	PARITY - 2 = NO PARITY, 1 = ODD, 0 = EVEN
/
/	STOP BITS - 1 OR 2 NOTE: IF SET FOR 5 FOR CHARACTER SIZE AND 1 FOR STOP
/	IT WILL AUTOMATICALLY SET FOR 1.5 STOP BITS
/
/	AND BAUD:
/
/	VALUE	BAUD
/	0	50
/	1	75
/	2	110
/	3	134.5	(MAGCARD)
/	4	150
/	5	300
/	6	600
/	7	1200
/	10	1800
/	11	2000
/	12	2400
/	13	3600
/	14	4800
/	15	7200
/	16	9600
/	17	19200
/
	
*MNPRTB-X;			/ MNPRTB - See WPCU3/WPCU4 for defn of bits

IFNDEF CONDOR <	0514 >		/	Initialized for PB=4800,	/C018
				/      	Primary port (0), BT=5.		/C012
				/	TM = WS52			/C012

IFDEF CONDOR <	1254 >		/	Initialized for PB=4800,/C017	/M026
				/      	Primary port (0), BT=5.		/A012
				/	TM = VT-100			/C017

*MNCXP-X;	0		/ MNCXP - DOCUMENT NUMBER FOR CX DOCUMENT
				/         TRANSFER PROTOCOL

*MNOPTC-X;			/ MNOPTC - USED BY THE UNBUNDLING CODE	/A002

