	TAD	("R-200)	/ SEE IF CHAR IS 'R'?
	JMS	PCMPAR		/ COMPARE
	JMP I	PZERR		/ NO MATCH RETURN
	>
	JMP	PIF		/ LOOP BACK TO BEGINNING


PBUTN,	IFDEF ENGLSH <TAD ("B-200)>	/ SEE IF CHAR IS 'B' ?
	IFDEF ITALIAN<TAD ("M-200)>
	JMS	PCMPAR		/ COMPARE
