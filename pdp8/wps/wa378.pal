			/ENDING WHEN STRT BLK# = 0  AND IN
			/THE FOLLOWING ORDER
	DLFD0A				/START BLOCK ON DISKETTE
	CDFSYS				/"CDF" OF BUFFER  FLD		/M033
	0				/BUFFER ADDRESS
	-DSFD0A				/NEG BLK COUNT
