/ THIS FILE CONTAINS THE SECOND PART OF THE MENU ASSEMBLY - THAT PART
/ WITH MOST OF THE MENUS CALLED IN BY EXECUTING PROGRAMS.
/
/ TO ASSEMBLE THIS PART, THE 'MNCOM' COMMON MENUS MUST BE ASSEMBLED AT THE
/ FIRST PART OF THE ASSEMBLY.  IT WILL NOT, HOWEVER, BE WRITTEN OUT WITH
/ THE REST OF THE MENUS IN THIS ASSEMBLY.  THUS THE SPACE IT USES CAN BE
/ REUSED.
/
/ CARE SHOULD BE TAKEN THAT MENUS IN THIS FILE DON'T CALL MENUS CONTAINED
/ IN THE OTHER PART - WITH THE EXCEPTION OF THE MAIN MENU USING ENTRY 'MM1S'.
/
RELOC

FIELD 1		/REUSE SPACE USED BY PREVIOUS MENUS
	*0

/EDITOR MENUS - COPY DOCUMENT

RELOC
ADMEM1=.
X=DLMEM1		/ INDICATE DISK BLOCK WHERE MENU IS LOADED
RELOC 0


EM1S,	CASE;MNTMP1
		1;EM1S1
		2;EM1S2
		3;EM1S3	/USE THE RUNNING OUT OF ROOM MESSAGE FROM CI
		4;EM1S4	/UNINITIALIZED DISKETTE IN INDEX		/A086
	COPY;MNFNO;MNTMP4

EM1D,	DISP;0;TEXT '!E    '
	DISP;2205;TEXT '&TYPE THE NAME OF THE DOCUMENT TO BE INSERTED'
	DISP;-1;TEXT ' AND PRESS !&RETURN'
	DISP;2405;TEXT '!&OR &JUST PRESS !&RETURN TO RESUME EDITING.'

EM1RD,	READ;MNTMP1;EM1RE
	SET;0;MNTMP3
	FILNAM;EM1RT;EM1ND
	COPY;MNFNO;MNTMP3
EM1RT,	COPY;MNTMP4;MNFNO
	FBREAK;MNFNO
	RETURN

EM1RE,	CALL;CR1BR;DLMCR1
	GOTO;EM1D

EM1ND,	CALL;CR1ND;DLMCR1
	GOTO;EM1D

EM1S3,	DISP;0;TEXT '!E'
	DISP;1405;TEXT '-- &CANNOT CONTINUE --'
	GOTO;EM1RT1

EM1S1,	DISP;0;TEXT '!E'
	DISP;1405;TEXT '-- &DO NOT ADD ANY MORE TO DOCUMENT --'		/M003

EM1RT1,
/D088	DISP;1605;TEXT '&ONLY !D BLOCKS LEFT ON DISKETTE.'
/D088		MNTMP2
	DISP; 1605; TEXT '&ONLY !D BLOCKS LEFT ON '; MNTMP2		/A088
	CALL; EM4CKW; DLMEM4	/ CK FOR WINI				/A088
	DISP; -1; TEXT '.'						/A088
	DISP;2005;TEXT '^A!E&PRESS !&RETURN'				/M051
		EM1BEL
	CASE;MNTMP1;3;FILDOC	/ ARE WE ALL OUT OF ROOM?		/A040
	GOTO;EM1RD1		/ NO, GO READ WHAT THE USER TYPED IN	/A040
FILDOC,	DISP;-1;TEXT ' TO FILE DOCUMENT'				/A040
EM1RD1,	READ;MNTMP1;EM1RT1
	ARG;EM1RTX;MNTMP1
	GOTO;EM1RT1
EM1BEL,	007;0
EM1RTX,	DISP;0;TEXT '!E'						/A092
	RETURN

			/TOO LITTLE SPACE FOR GET DOCUMENT
/D088/EM1S2,	DISP;1405;TEXT '-- &NOT ENOUGH SPACE ON DISKETTE FOR COPY --'
EM1S2,	DISP; 1405; TEXT '-- &NOT ENOUGH SPACE ON '
	CALL; EM4CKW; DLMEM4	/ CK FOR WINI				/A088
	DISP; -1; TEXT ' FOR COPY --'					/A088
	GOTO;EM1RT1

EM1S4,	TRNSFR;EM3S4;DLMEM3						/A086

XTREM1=400-.

