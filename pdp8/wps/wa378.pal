	COPY;MNTMP1;MNTMP2	/ERR MSG ROUTINES USE MNTMP1		/A061
ADR72R,	READ;MNTMP1;ADR72X
	ARG;ADR72R;MNTMP1
	CALL;CR1NM;DLMCR1	/"...HAS NO MEANING HERE"
	GOTO;ADR72R

