	ISZ	WINPT3
	CIFMNU
	JMS I	IOACAL
	0
WINPT4,	0			/ ADDRESS OF OUTPUT STRING
	1405			/ CURSOR POSITION

WINPTZ,	MVLCHR
	AREANO			/ AREA NUMBER
	2700
