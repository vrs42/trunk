	PRQ3=6236							/A024
	CP2MM=5000		/PANEL REQUEST OP CODES			/A024
	MM2CP=4000		/FOR BLOCK MEM TRANSFERS		/A024
	RCPFLD=7		/PANEL FLD FOR STORING REGIS		/A024
	PCPFLD=6		/PANEL FLD FOR STORING PRIM		/A024
	ACPFLD=5		/ALFA BITS CTRL PANEL FIELD		/A024
	REGFLD=6211		/REGIS FIELD				/C032
	PRMFLD=6251		/PRIM FIELD				/C032
	PRGFLD=6261		/PRIM-REGIS COMBINATION FIELD=6		/C032
