	0			/ RXQRS1
 	0			/ RXQBAD	BUFFER ADDRESS
	CDFMYF			/ RXQBFD	BUFFER FIELD CDF
	0			/ RXQTRK	TRACK
	0			/ RXQSEC	SECTOR


	X=.			/ INDICATE FIRST FREE LOCATION ON PAGE
