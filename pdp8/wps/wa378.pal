	JMP	SLXMOD

ESLCT1,	TAD	(ECTMRK)	/ INSERT POSITION MARKER
	JMS	INSERT
DOSLCT,	TAD	(ECSLPT)	/ INSERT SELECT BREAK CHAR
	JMS	INSERT
	JMS	SVSLCR		/ SAVE CURSOR POSITION			/A209
	MODSET
