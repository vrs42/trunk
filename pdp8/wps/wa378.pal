	TAD	FMTQBK+RXQBLK	/					/M083
	CIA								/A083
	TAD	SRCSZE		/NUM BLOCKS IN SOURCE-NUM BLOCK TO BE READ/A083
	SMA SZA CLA		/IS ILLEGAL BLOCK?			/A083
CKBLN1,								/A083
	ISZ	CKBLNM		/NO SKIP ERR RET			/A083
	JMP I	CKBLNM		/RET					/A083

