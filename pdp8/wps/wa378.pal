/
	TYPYES=140 		/ THE OK PACKET TYPE
	TYPMOD=141 		/ DOCUMENT OPTIONS PACKET RESPONDED WITH AN ANSWER TO PROMPT
	TYPMES=142
	TYPSOD=144 		/ FIRST PACKET OF A DOCUMENT CONTAINING SIZE AND PRINTER SETTINGS
	TYPDOC=154 		/ PAKCET SENT BY AX TO DX TO ASK IF THE DOCUMENT SHOULD BE SENT.
				/ THIS NAME IS AN ENTRY IN THE LIST DOCUNET DX PICKED
