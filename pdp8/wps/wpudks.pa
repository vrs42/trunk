	SMA SZA CLA
	JMP CUDGL2		/ NOT {RETURN} OR DIGIT

	ISZ CUDGL0		/ FOUND DIGIT; CALL+4; AC=0; CUDGGA=CHAR.
CUDGL3,	ISZ CUDGL0
CUDGL2,	ISZ CUDGL0
CUDGL1,	CLA
	JMP I CUDGL0



