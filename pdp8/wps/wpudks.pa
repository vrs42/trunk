				/ KNOW IF THE PARAMETER BLOCK IS INVIOLATE
	TAD CUFUNC		/ TEST FOR WRITE
	AND CUDP3		/ 3=READ; (2)004=WRITE
	SZA CLA			/ SKIP IF WRITE
	JMP CURWYY		/ IS READ
	JMS I CUDIMX		/ MOVE VALUES TO BUFFER FOR WRITE
	CUDBUF+CUBFSZ-UDSYNM	/ DESTINATION				/C036
	UDSYDA			/ SOURCE
	-UDSYNM			/ COUNT					/C036
CURWYY,

