	IFDEF V30SWE <
     TEXT '^P!E   ^P&\DNDRING AV TANGENTDEF. !D. &ANV\DND GULD STOPP F\VR ATTL '
	*.-1
	TEXT 'AVSLUTA DEFINITIONEN.^P'>

	IFDEF DUTCH <
