	*.-1
	TEXT ' TERMINATE DEFINITION.^P'
	>
	IFDEF SPANISH <
	TEXT '^P!E   ^P&MODIFICANDO TECLA USUARIO !D. &PULSE &DORADA !&PARAR'
	*.-1
	TEXT ' PARA TERMINATE DEFINITION.^P'
	>


