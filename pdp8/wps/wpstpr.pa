	DERST2, 0000	/ ADDR OF SUBSTRING - SET BY DERCKW		/A030
		605
	DERST3, 0000	/ ADDR OF SUBSTRING - SET BY DERCKW		/A030
	JMS PRETURN
	JMS ORGOLD
		ORAR
	JMS KBRD	/READ INPUT
	CLA		/USER PRESSED RETURN SO
