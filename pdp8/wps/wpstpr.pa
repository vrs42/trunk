	CDFMYF		/ BACK TO THIS FIELD				/A030
	DCA	TSOPTN	/ SAVE VALUE					/A030
	AC0004		/ MASK - WINCHESTER INSTALLED			/A030
	AND	TSOPTN	/ IS WINNIE BIT SET ?				/A030
	SNA	CLA	/ YES - SKIP AND CONTINUE			/A030
	JMP	TSCTD1	/ NO - INSERT TEXT "DRIVE" ONLY			/A030
	TAD	CUSRC6	/ CK FOR DRIVE 0				/A030
	SNA		/ NO - SKIP & CONTINUE				/A030
	JMP	TSCTD2	/ YES - GO INSERT "DRIVE/DEVICE"		/A030
	TAD	(-1	/ CK FOR DRIVE 1				/A030
	SZA	CLA	/ YES - SKIP & CONTINUE				/A030
	JMP	TSCTW	/ NO - INSERT "VOLUME ON DEVICE			/A030
	AC0010		/ MASK - VOLUME ASSIGNED TO 1			/A030
	AND	TSOPTN	/ IS VOLUME ASSIGNED				/A030
	SNA	CLA	/ YES - SKIP & INSERT "VOLUME ON DEVICE		/A030
	JMP	TSCTD2	/ NO - GO INSERT "DISKETTE ON DRIVE		/A030

TSCTW,	TAD	(DERVL1)	/ ADDR OF "VOLUME ON DEVICE		/A030
	DCA	TSSTRA	/ INTO PARAMETER LIST				/A030
	TAD	(TSDEV)	/ ADDR OF "DRIVE/DEVICE				/A030
