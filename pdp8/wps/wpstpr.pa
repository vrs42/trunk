	JMP	TSCTD3	/						/A030

TSCTD2,	TAD	(TSDEV)	/ ADDR OF "DRIVE/DEVICE				/A030
	DCA	NWSTR	/ INTO LIST - "SPECIFY ANOTHER DRIVE/DEVICE	/A030
TSCTD3,	TAD	(DERDS1)	/ ADDR OF "DISKETTE IN DRIVE		/A030
	DCA	TSSTRA	/ INTO LIST					/A030
TSCKEX,	JMP I	TOSCKW	/ RETURN					/A030
TSOPTN,	0000		/ OPTION WORD					/A030

