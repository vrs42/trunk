		0
		TYPGO	/TEXT STRING TYPE GO TO BEGIN SORT
		1505
	JMS PRETURN	/AND PRESS RETURN
	JMS ORGOLD	/OR PRESS GOLD M
		ORAR
CUSGO1,									/A029
	AC0002		/SET AC TO 2 SO MENU WILL PROCESS GO PROMPT
	JMS READMU
		JMP CUSR1	/RETURN TO MM
	CDFMYF		/SET DATA FIELD TO MY FIELD
