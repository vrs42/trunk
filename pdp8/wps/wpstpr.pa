		NARG		/DO NOT DISPLAY OR			A008
	JMP INPUT		/READ INPUT AGAIN			A008

RBELL,	XX
	CIFMNU
	JMS I IOACAL
	0
	ASTRING
	BELTXT
	JMP I RBELL

