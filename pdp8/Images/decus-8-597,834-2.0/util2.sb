	ENTRY  EOF		/TEST OR  RESET THE IEOF FLAG.
        ENTRY   OPEN         /INITIALIZING AND FLAG SETTING ROUTINE
        ENTRY   GENIO
        ENTRY   EXIT            /EXIT TO DISK MONITOR SYSTEM
        ENTRY   ERROR
        ENTRY   CKIO    /USELESS ROUTINE
        OPDEF   KRS     6034
        OPDEF   KCC     6032
        OPDEF TADI 1400
        OPDEF DCAI 3400
        OPDEF   JMSI    4400
        OPDEF JMPI 5400
/
