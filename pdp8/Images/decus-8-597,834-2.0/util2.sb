/
/	****MODIFICATIONS PFL****
/       PT08  IOT'S
	IF PT08,5
	SKPDF	PKSF	6401
        OPDEF   PKRS    6404
        SKPDF   PTSF    6411
        OPDEF   PKCC    6402
        OPDEF   PTLS    6416
	IF DC02, 6
	OPDEF MTON 6117
	SKPDF PKSF 6111
	OPDEF PKRS 6114
	SKPDF PTSF 6121
	OPDEF PKCC 6112
	OPDEF PTLS 6126
/
/
/LINE PRINTER IOT'S
	IF DC02, 2
	OPDEF LTCP 6126
	SKPDF LTSF 6121
	IF ABDICK,2
        OPDEF   LTCP     6652
        SKPDF   LTSF     6651
/	***** END OF ADDITIONAL DEFINITIONS*****

        LAP

U17,    17              /*** MUST BE FIRST LOC IN PAGE ***

IOER,   1117
        0522            /"IOER" ERROR
GENIO,  BLOCK 2         /GENERAL INPUT/OUTPUT ROUTINE
        DCA     7       /SAVE ENTRY AC
GENLP,  TAD     7
        RTL
        RTL
        RAL
U200,   AND     U17
        TAD     JMPITB
        DCA     DSPACH  /INDEX JUMP TABLE BY DEVICE NUMBER
        TAD     U200
        KRS
        TAD     UM203
        SNA CLA
        NOP /***KSF      /DO NOT CHECK FOR ^C ON TELETYPE
DSPACH, NOP             /NO ^C - DISPATCH TO I/O ROUTINE
        CALL    0,EXIT

JMPITB, JMPI    DEVTAB
DEVTAB, TTYOUT
        HSPOUT
        LPTOUT
        GENOUT
        TTYIN
	PT8FJ	/FUDGE PT08 INPUT WITH ECHO...
	HSRIN	/PT08 INPUT WITH NO  ECHO....
        GENIN
        TTYFUJ          /FUDGE - SEE TELETYPE INPUT ROUTINE
        IOERR
        IOERR
        IOERR
        IOERR
        IOERR
        IOERR
        IOERR

HSPOUT,	CLA
	IF DC02, 3
	TAD (2010 /CTY: STATION 1 GROUP 0
	MTON
	CLA
	 PTSF    /PT08 OUTPUT
        JMP     GENLP
        TAD     7
        PTLS
GENRTN, CLA
        RETRN   GENIO

TTYIN,  KSF
        JMP     GENLP
        CLA CLL CML RTR /****DEPENDS ON NUMBER OF DEVICES ****
        JMP     GENLP   /TEST FOR ^C ONE LAST TIME

HSRIN,	CLA
	IF DC02, 3
	TAD (1010 /LINK: STATION 2, GROUP 0 (NO ECHO)
	MTON
	CLA
	  PKSF    /PT08 INPUT NO ECHO
        JMP     HSRIN /WAIT HERE
        PKCC PKRS
        AND (177 /FIX PARITY
        TAD (200
	IF DC02, 5
	DCA HOLDIT
	TAD (2010 /RESTORE CTY STATION 1 GROUP 0
	MTON
	CLA
	TAD HOLDIT
        JMP     GENRTN#
HOLDIT,	0 /TEMP

UM203,  -203
/SUBROUTINE LERP
/LERP--LINE PRINTER DUMP ROUTINE
/BY JAMES ELLETT MODIFIED BY PFL - MIGHT WANT TO MODIFY SO THAT
/				SEND STRAIGHT THROUGH!!
/TECHNICAL ASSOCIATES
/APRIL 20, 1970
/&
LERP,   0
        CLA CLL
/	SET GROUP/STATION TO 0/2 IF DCO2G
	IF DC02, 3
	TAD (1010
	MTON
	CLA
        TAD LLP1 /LPTBF
        DCA DATAAD
              TAD SYN         /GET SYN CODE.
        JMS SUPR        /OUTPUT IT.
        IAC             /GET SOH CODE
        JMS SUPR        /OUTPUT IT.
        TAD NEG10       /SET UP TO OUTPUT 8 NULLS.
        DCA CNTR1
ZIP1,	JMS SUPR
	ISZ CNTR1       /FINISHED?
        JMP ZIP1         /NO, OUTPUT ANOTHER NULL.
RPT,    TAD I DATAAD    /YES, GET FIRST CHARACTER.
        ISZ DATAAD      /INCR. TEXT BUFFER ADDR.
        SNA             /IS CHARACTER A 0?
        JMP EOL         /YES,BEGIN END OF LINE SEQUENCE.
        JMS SUPR        /NO, OUTPUT IT.
        ISZ CNTR1       /INCR. CHARACTER COUNT.
        JMP RPT         /GET NEXT CHARACTER.
EOL,    TAD EM          /GET EM CODE/.
        JMS SUPR        /OUTPUT IT.
        TAD CNTR1       /GET NUMBER OF CHARACTERS.
        CLL RAR
        CLL RAR         /DIVIDE BY FOUR.
        TAD NULLS       /ADD 19.
        CIA             /NEGATE IT.
        DCA CNTR1       /STORE IT.
ZIP2,        JMS SUPR        /OUTPUT A NULL.
        ISZ CNTR1       /FINISHED/
        JMP ZIP2         /NO, OUTPUT ANOTHER NULL.
	IF DC02, 3 
	TAD (2010 /RESTORE CTY:
	MTON
	CLA
        JMP I LERP      /RETURN.
SUPR,   0
ZUPPER,       LTSF             /PRINTER READY/?
        JMP ZUPPER         /NO, WAIT.
        LTCP             /YES, PRINT CHARACTER.
        CLA
        JMP I SUPR      /RETURN.
DATAAD, 0
CNTR1,  0
SYN,    26
EM,     31
NEG10,  -10
NULLS,  23
LLP1,	LPTBF /POINTER

/
