/ TERMINAL HANDLER CONFIGURATION FILE		12/1/76
/
/
/	FILE TO CONFIGURE THE TTY HANDLER
/
/
CONSOL=	1	/1 MEANS CONSOLE TTY (DEFAULT)
VT50=	1	/1 ENABLES CTRL/S AND CTRL/Q
SCOPE=	1	/1 MEANS TTY CAN DO A BACKSPACE
FILL=	4	/NUMBER OF FILL CHARACTERS, I.E. 4
WIDTH=	120	/TTY LINE WIDTH (0 MEANS INFINITE),
		/ DEFAULT IS 120
TAB=	0	/1 IF TTY HAS HARDWARE TABS
OLDTTY=	0	/1 TO USE OLD 2-PAGE TTY HANDLER
LSBOT=	0	/1 LISTS BOTH HANDLERS (DEFAULT 0)
/
/
/
/	ORIGIN AND DEVICE ASSIGNMENTS, IF NOT IN PARAM
/
/
/TASK=		/TASK NAME
/TTYFLD=	/FIELD OF TTY TASK
/TTYLOC=	/LOCATION OF TTY TASK
/TTDEV=		/PRINTER DEVICE CODE - DEFAULT IS 4
/KBDEV=		/KEYBOARD DEVICE CODE - DEFAULT IS TTDEV-1
