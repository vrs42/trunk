10 DIM C$(80)
20 PRINT\PRINT "Input Filename ";\ INPUT F$
30 PRINT "Record Length ";\ INPUT L
40 FILE#1:F$,L
50 DEFINE#1:L
100 PRINT\PRINT "# ";\ INPUT R
110 GET#1:R,C$
115 PRINT C$
120 PRINT "New Data"\ INPUT C$
130 IF C$="" GOTO 200
135 IF SEG$(C$,1,1)="Q" GOTO 990
140 PUT#1:R,C$
200 IF END#1 GOTO 800
210 GOTO 100
800 RESTORE#1
810 GOTO 100
990 CLOSE#1
999 END
