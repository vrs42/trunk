Program 	PERMUT (Input, Output);

(*  Permutation problem, in PASCAL-S [HTL-Moedling], adapted from the
   BASIC 'Permut.BA' of 5/30/74 at PAS, Jan. 1983.  Recursive.  *)

var 	level, n, firstdigit:	integer;
 	v:			array [0..10] of integer;

(*  ==================================================  *)
(*  here is the real operating code, a recursive subr.  *)

Procedure 	Descend;

var	j, tries:	integer;
(*  these are created anew at each level of recursive descent; the existing
    values are pushed onto the run-time stack for later retrieval  *)

Begin

level :=	level-1;		(*  we've descended one level  *)
v[level] :=	v[level+1];		(*  start with last value used  *)
tries :=	level;			(*  level 4 yields 4 possibilities  *)

while (level > 0) and (tries > 0) do
begin
 	v[level] := v[level]+1 ;	if v[level] > n then v[level] :=1 ;
	(*  increment v[level], wrapping around when necessary  *)

	j := level ;	Repeat j := j+1 until (j > n) or (v[j] = v[level]) ;
	(*  check to see if a higher level has used our v[level]  *)

	if j > n then	begin		(*  our v[level] hasn't been used  *)
		if tries < level then			begin
		(*  indent a new line out to our level  *)
	 	Writeln; for j := n downto level+1 do Write ('    ')
						 	end;
	Write (v[level]:4);
	tries := tries-1;
	Descend	 	 		(*  recursive call  *)
			end

end;

level := level+1			(*  return to next higher level  *)

End;
(*  ==================================================  *)

BEGIN				 	(*  official Main Program  *)

Write ('value of n is:'); read(n); level := n;

	for firstdigit := 1 to n do
	begin
	 	v[n] := firstdigit;
	 	Writeln; Writeln; Write (firstdigit:4);
	 	Descend
	end

END.
