Program	TEMPER (Input, Output);			(* PAS  5/83 *)

Type	Temperature =	record			(* We're inventing a Type *)
		Degrees:	real;
		Letter:		char
	end;

(* From here on, every variable of type  Temperature  will have 2 parts:
  (a)	ItsName.degrees, a real number,		and
  (b)	ItsName.letter,  a character like  C  or  F .			*)
	
Var	Usertypein:	Temperature;

(******************** procedure to do conversion: *******************)
Procedure	Convert ( var oldvalue:  Temperature );

(* [3wThe  VAR  in the line above causes all we do to  OLDVALUE  here
   to also be done to  USERTYPEIN  in the Main Program.		[w *)

BEGIN

oldvalue.degrees :=	oldvalue.degrees + 40.;		(* Yup. Works. *)

	If oldvalue.letter = 'C' then				begin
		oldvalue.degrees := oldvalue.degrees * 9./5.;
		oldvalue.letter  := 'F'				end
Else	If oldvalue.letter = 'F' then				begin
		oldvalue.degrees := oldvalue.degrees * 5./9.;
		oldvalue.letter  := 'C'				end
Else	oldvalue.degrees := 40.;		(* something is haywire *)

oldvalue.degrees :=	oldvalue.degrees - 40		(* Yup. Works. *)

END;
(********************************************************************)
BEGIN

Usertypein.Letter := ' ';			(* Phoney *)
While	(Usertypein.Letter <> 'C') and (Usertypein.Letter <> 'F') do

   begin
	Write ('Type degrees, one space, C or F, & Return ');
	Read (Usertypein.degrees, Usertypein.letter);	Writeln
   end;

Convert (Usertypein);					(* call our procedure *)

Writeln (Usertypein.degrees:10:2, ' ', Usertypein.letter)

END.
