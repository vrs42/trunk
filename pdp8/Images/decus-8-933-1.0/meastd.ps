Program	MEASTD (Input, Output);

var	classize:			integer;
	grade, gradesum, gradesquared:	real;
	mean, variance, stdeviation:	real;
BEGIN

classize := -1;					(* Kludge *)

gradesum := 0; gradesquared := 0; grade := 0;	(* Kludge again *)

Repeat
	classize := classize + 1;
	gradesum := gradesum + grade;
	gradesquared := gradesquared + Sqr (grade);
	Read (grade)
Until	grade < 0.0;

mean :=		gradesum / classize;
variance :=   ( gradesquared / classize ) - Sqr (mean);
stdeviation :=  Sqrt (variance);

Writeln ( '  mean =', mean:8:2, '  variance =', variance:10:2,
	  '  std. deviation =', stdeviation:8:2 )
END.
