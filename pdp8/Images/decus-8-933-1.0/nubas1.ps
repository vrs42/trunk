Program	NUBAS1 (Input, Output);

(* straightforward transcription from BASIC of base conversion
   PAS	5/83 *)

var	Remainder:  array [1..100] of integer;
	Kount, Baseinto, Quotient, Decvalue:	integer;

BEGIN

Write ('decimal integer '); Read (Decvalue);
Write ('new base is     '); Read (Baseinto);

Kount := 0;

While	Decvalue > 0 do
 begin
	Kount := Kount+1;
	Quotient := Decvalue div Baseinto;		(* integer division *)
	Remainder[Kount] := Decvalue - Baseinto * Quotient;
	Decvalue := Quotient
 end;

Writeln;

(* we could do a  'For J := Kount downto 1'  at this point, or:	*)

While	Kount > 0 do
 begin
	Write (Remainder [Kount]:3);
	Kount := Kount-1
 end;

Writeln

END.
