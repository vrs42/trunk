	COMMON FNP,FNW,RW,JW,JW3,NP,NW,NBLK,IMOV
	COMMON XP,YP,ZP,NNP,KR,XW,YW,ZW,NNW,CKCOM
	DIMENSION XP(180),YP(180),ZP(180),XW(160),YW(160),ZW(160)
	DIMENSION NNP(180),NNW(160),KR(180)
C
C	WRITE(1,901)
C901	FORMAT('ENTERING WATR33')
	IF(CKCOM-54321.)171,10,171
10	JW=JW+1
	IF(NNW(JW)+999)11,95,11
11	XC=XW(JW)
	CALL SLICE(XC)
C
	N=5
	CALL SSW(N)
	IF(N)13,13,10
13	CONTINUE
C	WRITE(1,902)XC,NP,NW,XW(1),YW(1),ZW(1),XP(1),YP(1),ZP(1)
C	WRITE(1,912)XW(NW),YW(NW),ZW(NW),XP(NP),YP(NP),ZP(NP)
C902	FORMAT('FROM SLICE ',F8.3,2I6/2(3X,3F9.3))
C912	FORMAT(2(3X,3F9.3))
C
C  CHECK DISTANCES TO OTHER WATERS
20	K=0
	DWW2=0.99999*(2.*RW)**2
	X1=XW(JW)
	Y1=YW(JW)
	Z1=ZW(JW)
	DO 30  I=1,NW
S	TAD  \I
S	7421
	IF(NNW(I)-NNW(JW))23,30,23
23	DIS=(X1-XW(I))**2 + (Y1-YW(I))**2 + (Z1-ZW(I))**2
	IF(DIS-DWW2)26,30,30
26	K=K+1
	JW3=I
30	CONTINUE
	IF(K-1)35,50,120
35	CONTINUE
C	WRITE(1,1035)NNW(JW),X1,Y1,Z1
C1035	FORMAT(I6,3F9.3)
	IMOV=0
	CALL CHAIN('WATR3R')
C
C  CONTACT, MOVE WATER AWAY (CHAIN, PASS VARIABLES)
50	CONTINUE
	CALL CHAIN('WTER33')
C
C  END
95	WRITE(1,1095)
S	HLT
	WRITE(1,1095)
1095	FORMAT('END OF WATER3')
	STOP
C
C  ERROR IF MORE THAN ONE INTERFERING WATER
120	CONTINUE
S	HLT
	WRITE(1,1120)NNW(JW),XW(JW),YW(JW),ZW(JW)
1120	FORMAT('MORE THAN ONE INTERFERING WATER AT '/I6,3F9.3)
	GO TO 10
171	CONTINUE
S	HLT
	WRITE(1,1171)
1171	FORMAT('ERROR ENTERING WATR33')
	STOP
	END
