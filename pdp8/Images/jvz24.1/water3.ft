	COMMON FNP,FNW,RW,JW,JW3,NP,NW,NBLK,IMOV
	COMMON XP,YP,ZP,NNP,KR,XW,YW,ZW,NNW,CKCOM
	DIMENSION XP(180),YP(180),ZP(180),XW(160),YW(160),ZW(160)
	DIMENSION NNP(180),NNW(160),KR(180)
C
	NPMAX=180
	NWMAX=160
	NBLK=1
1	CKCOM=54321.
	RW=1.4
	READ(1,1002)FNP
1002	FORMAT('TYPE PROTEIN ATOM COORD FILENAME: ',A6)
	READ(1,1003)FNW
1003	FORMAT('TYPE WATER COORD FILENAME: ',A6)
C
	CALL IOPEN('DSK',FNP)
	READ(4,1100)A,A
1100	FORMAT(A1)
	DO 35  I=1,NPMAX
	K=I
	READ(4,1020)NNP(I),XP(I),YP(I),ZP(I),KR(I)
1020	FORMAT(I6,3F8.2,I4)
	IF(NNP(I)+999)35,36,35
35	CONTINUE
	K=K+1
36	NP=K-1
C
	CALL IOPEN('DSK',FNW)
	READ(4,1100)A,A
	DO 45  I=1,NWMAX
	K=I
	READ(4,1022)NNW(I),XW(I),YW(I),ZW(I)
1022	FORMAT(I6,3F9.3)
	IF(NNW(I)+999)45,46,45
45	CONTINUE
	K=K+1
46	NW=K-1
C
	JW=27
	CALL CHAIN('WATR33')
	END
