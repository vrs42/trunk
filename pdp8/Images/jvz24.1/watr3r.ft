C  ROUTINE TO WRITE WATER3 LIST ON DTA1 (UNFORMATTED)
	COMMON FNP,FNW,RW,JW,JW3,NP,NW,NBLK,IMOV
	COMMON XP,YP,ZP,NNP,KR,XW,YW,ZW,NNW,CKCOM
	DIMENSION XP(175),YP(175),ZP(175),XW(175),YW(175),ZW(175)
	DIMENSION NNP(175),NNW(175),KR(175),K(10,13)
	IF(CKCOM-54321.)95,2,95
2	CALL RLINC(1,NBLK,1,K,128)
	DO 10  J=1,12
	IF(K(10,J)) 10,12,91
10	CONTINUE
	GO TO 91
12	K(1,J)=NNW(JW)
	N=XW(JW)
	K(2,J)=N
	K(3,J)=1000.*(XW(JW)-FLOAT(N))
	N=YW(JW)
	K(4,J)=N
	K(5,J)=1000.*(YW(JW)-FLOAT(N))
	N=ZW(JW)
	K(6,J)=N
	K(7,J)=1000.*(ZW(JW)-FLOAT(N))
	K(8,J)=IMOV
	K(10,J)=-1
C
	CALL WLINC(1,NBLK,1,K,128)
	IF(J-12)31,30,91
30	NBLK=NBLK+1
31	CONTINUE
	IF(NBLK-680)33,33,92
33	CONTINUE
	CALL CHAIN('WATR33')
C
91	CONTINUE
S	HLT
	WRITE(1,1091)NBLK,J
1091	FORMAT('ERROR IN WATR3R, BLK=',I5,I7)
	STOP
92	CONTINUE
S	HLT
	WRITE(1,1092)
1092	FORMAT('SPACE EXHAUSTED ON DTA1')
	STOP
95	WRITE(1,1095)
1095	FORMAT('COMMON AREA TROUBLE IN WATR3R')
	STOP
	END
