/GCHAR.SB TO RECEIVE THE CHARACTERS,WRITE CHAR AT ICHAR IN MEMORY
/IS VACTV.SB WITH THE TTY DISABLED
/PLUS MODIFICATIONS
/COMMON ICHAR,IERCT,NCHAR,NBUF(128*3=384 DECIMAL)
/DELETED SCHAR AND RCHAR SUBROUTINES FROM THIS PROG
/
/    IACTV.SB    HANDLER FOR M730 ASYCN. CONTROLLER
/     MODIFIED FOR FULL DUPLEX  R.A.E.  8-AUG-80
/  MODIFIED FOR CTRL S AND CTRL Q 19-NOV-81 D.C.T.
/
/  COMMUNICATOR I/O DEFINITIONS
/
SKPDF	CSDA  6401	/DATA AVAILABLE
SKPDF	CSTR  6403	/TMTR READY
OPDEF	CMI   6402	/INITIALIZE
OPDEF	CMT   6404	/TRANSMIT
OPDEF	CMLD  6406	/AC->M730
OPDEF	CMR   6407	/RECEIVE
/
/  INTERACTIVE SUBROUTINE
/
\ICHAR,	COMMN  1
\IERCT,	COMMN  1
\NCHAR,	COMMN  1
\INDIC,	COMMN  1	/IF INDIC = 0,PUT NEW CHAR INTO ICHAR,INC BUFO
\NBUF,	COMMN  600
/
	ENTRY  GCHAR
GCHAR,	BLOCK  2
	CLA CLL
	TAD \NCHAR	/IF NCHAR > 0 DONT CLEAR BUFFER
	SZA		/BUFFER OR FLG
	JMP ITV1
	DCA \INDIC	/CLEAR HANDLER INDICATOR
	DCA FLG		/CLEAR INTERRUPTION FLAG
/INITIALIZE POINTERS
	TAD BUFR
	DCA BUFO
	TAD BUFR
	DCA BUFI
	TAD BUFR
	TAD (577
	DCA BEND	/SET TO END OF BLK(NBUF)
ITV1,	CSDA		/CHECK IF CHARACTER RECEIVED
	JMP ITV3	/NOT REC. CHECK BUFFER AT ITV3
	JMS RCV		/GET CHARACTER
	TAD TEMP
	DCA I BUFI	/STORE IN BLK(NBUF)
	INC BUFI	/UPDATE POINTER
	INC \NCHAR	/AND COUNTER
	TAD BUFI
	CMA  IAC	/CHECK IF AT END OF BLK(NBUF)
	TAD BEND
	SZA
	JMP ITV2
	TAD BUFR	/RESET POINTER TO BEGINNING OF BLK(NBUF)
	DCA BUFI
ITV2,	CLA CLL
	TAD BUFI
	CMA  IAC	/CHECK APPROACHING OVERRUN
	TAD BUFO
	SPA SNA		/IF BUFO-BUFI>0
	JMP ITV3
	TAD (-36
	SMA CLA		/IF BUFO-BUFI<30
	JMP ITV3	
	TAD FLG		/CHECK INTERRUPTION FLAG
	SZA
	JMP ITV3
	TAD (223		/SEND ^S TO STOP VAX
	JMS TRNS
	CLA IAC
	DCA FLG		/SET FLAG
	JMP ITV3
/
/INSERT FROM HERE TO ITV31 TO SEE WHAT IS HAPPENING
/ITV3,	TSF		/CHECK TTY PRINTER READY
/	JMP ITV31	/SKIP IF READY
/	CLA
/	TAD BUFO
/	CMA IAC		/CHECK IF CAUGHT UP
/	TAD BUFI
/	SNA CLA
/	JMP ITV31
/	TAD I BUFO
/	TLS
/AT ITV3, I DONT CHECK IF PRINTER READY BUT DO CHECK IF I AM CAUGHT UP
/ AT TLS BELOW, I REPLACE BY DCA \ICHAR AND RETURN
/
/ITV31,	CLA
ITV3,	CLA
	TAD BUFO
	CMA  IAC	/CHECK IF CAUGHT UP
	TAD BUFI
	SNA CLA
	JMP ITV38
	TAD \INDIC	/DID MAIN PROG HANDLE ICHAR?
	SZA
	JMP ITV38
	CLA IAC		/INDIC WAS 0, SET TO 1, GET NEW CHAR
	DCA \INDIC
	TAD I BUFO
/	TLS		/PRINT NEXT CHARACTER (DISABLED D.C.T.)
	DCA \ICHAR	/WANT TO RETURN IF ALL ELSE OK
	CLA CLL
	INC BUFO	/UPDATE POINTER
	TAD BUFO
	CMA  IAC	/CHECK IF AT END OF BLK(NBUF)
	TAD BEND
	SZA
	JMP ITV4	/NOT AT END,LOOK AT TTY
	TAD BUFR	/RESET POINTER TO BEGINNING OF BLK(NBUF)
	DCA BUFO
	JMP ITV4	/CHECK KEYBD
ITV38,	CLA CLL
	TAD FLG		/CAUGHT UP? ROUTINE
	SNA		/CHECK INTERRUPTION FLAG
	JMP ITV4
	CLA CLL
	DCA FLG		/CLEAR INTERRUPTION FLAG
	TAD (221		/ CTRL Q TO CONTINUE ON VAX
	JMS TRNS
ITV4,	KSF		/CHECK KEYBOARD
	JMP ITV5	/WAS ITV1 D.C.T.,I EXIT IF NOTHING AT KEYBD
	JMS TTYI
	TAD (-203	/CHECK ^C
	SNA
	JMP ITV6
	TAD (-4		/CHECK ^G (BELL)
	SNA
	JMP ITV5
	TAD (-24	/CHECK ALTMODE
	SNA
	JMP ITV7
ITV44,	TAD (233	/RESTORE CHARACTER
	JMP ITV1	/CHECK FOR ANOTHER CHAR
ITV5,	RETRN GCHAR
ITV6,	CALL 0,EXIT
ITV7,	TAD BUFI	/STOP (DUMP) PRINTOUT
	DCA BUFO
/GO TO TTY ROUTINES:
	CALL 0,IACTV
	JMP ITV44
/
FLG,	0		/INTERRUPTION FLAG
/POINTERS TO TTY BUFFER (BLK=NBUF)
BUFO,	0		/OUTPUT POINTER
BUFI,	0		/INPUT POINTER
BUFR,	\NBUF		/BEGINNING OF BLK(NBUF)
BEND,	0		/END OF BLK(NBUF)
TEMP,	0
/
/  CHARACTER TRANSLATION SUBROUTINE WAS HERE
/
TTYI,	0
TIA,	KSF
	JMP TIA
	KRB
	JMP I TTYI
TTYO,	0
TOA,	TSF
	JMP TOA
	TLS
	JMP I TTYO
/
/ TRANSMIT SUBROUTINE
TRNS,	0	/ENTRY
TRA,	CSTR	/SKIP ON TMTR READY
	JMP TRA
	CMLD	/LOAD CHARACTER
	CMT	/TRANSMIT
	7421	/[MQL]
	JMP I TRNS	/RETURN
/
/ RECEIVE SUBROUTINE
RCV,	0	/ENTRY
RCVA,	CSDA	/SKIP ON CHAR AVAILABLE
	JMP RCVA
	CMR	/READ CHARACTER
	CMA
	DCA IC
	TAD IC
	AND ICX  /ISOLATE ERROR BITS
/  DISABLE ERROR CHECK
/	SZA CLA
/	JMP ERCV
	CLA
	TAD IC
RCVB,	7421	/[MQL]
	7501	/[MQA]
	DCA TEMP
	CMI	/INITIALIZE
	JMP I RCV
ERCV,	INC \IERCT  /ERROR COUNT
	TAD ERCHR  /ERROR CHARACTER
	JMP RCVB
IC,	0
ICX,	7000
ERCHR,	244	/ $
	END
