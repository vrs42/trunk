/  VAXIN.SB    CHARACTER INPUT ROUTINE
/       CALLED BY VAXCOM.FT
/        R.A.E.    12-AUG-80
/
/  COMMUNICATOR I/O DEFINITIONS
/
SKPDF	CSDA  6401	/DATA AVAILABLE
SKPDF	CSTR  6403	/TMTR READY
OPDEF	CMI   6402	/INITIALIZE
OPDEF	CMT   6404	/TRANSMIT
OPDEF	CMLD  6406	/AC->M730
OPDEF	CMR   6407	/RECEIVE
/
/  INTERACTIVE SUBROUTINE
/
	ENTRY VAXIN
	DUMMY ICNT	/CHARACTER COUNT ADDRESS
	DUMMY BUFR	/INPUT BUFFER ADDRESS
ICNT,	BLOCK 2
BUFR,	BLOCK 2
/
STARG,	ICNT
IPNT,	0
NARG,	0
NBUF,	0
CHAR1,	0
CHAR2,	0
/
VAXIN,	BLOCK 2
	TAD STARG
	DCA IPNT
	TAD(-4
	DCA NARG
L1,	TAD I VAXIN	/FIND SUBROUTINE ARGUMENTS
	DCA I IPNT	/SAVE ADDRESS
	INC VAXIN#	/NEXT ADDRESS
	INC IPNT	/NEXT SAVE ADDRESS
	ISZ NARG	/LAST ADDRESS ?
	JMP L1
/
	CLL CLA		/ZERO CHARACTER COUNT
	DCA I ICNT
/
	TAD (221	/SEND ^Q
	JMS TRNS
/
L2,	CSDA		/CHECK IF CHAR. RECEIVED
	JMP L3
	CMR		/READ CHAR.
	CMI		/INIT. ASYCH.
	CMA		/COMPLEMENT INPUT
	AND MASK	/STRIP TO SIX BITS
	DCA CHAR2	/SAVE CHAR
/
	CLL CLA
	TAD CHAR2
	TAD (-215	/CHECK FOR 'CR'
	SNA
	JMP EXT
/
	CLL CLA
	TAD CHAR1
	SZA
	JMP CHR2
/
	CLL CLA
	TAD CHAR2	/GET CHAR.
	RTL;RTL;RTL
	DCA CHAR1	/SAVE HI CHAR.
	JMP L3
/
CHR2,	CLL CLA
	TAD CHAR2	/LOAD CHAR.
	TAD CHAR1	/ADD HI CHAR.
	DCA I BUFR	/SAVE CHARS. IN BUFFER
/	INC BUFR#	/INC. BUFR. PNTR.
	INC I ICNT	/INC. CHAR. COUNT
	INC I ICNT	/INC. CHAR. COUNT
	CLL CLA		/ZERO FLAG
	DCA CHAR1	/SAVE FLAG
	JMP OUT1
/
L3,	KSF		/CHECK FOR KEYB. INTERRUPT
	JMP L2
	CLL CLA
	DCA I ICNT	/ZERO CHAR. COUNT
	INC I ICNT
	JMP OUT2
/
OUT1,	CLL CLA
	TAD(223 	/SEND ^S TO STOP INPUT
	CMI
	CMLD
	CMT
OUT2,	RETRN VAXIN
/
TRNS,	0		/TRANSMITTER OUT SUBROUTINE ENTRY
TRA,	CSTR		/SKIP ON TRNSMTR READY
	JMP TRA
	CMLD		/LOAD CHAR.
	CMT		/TRANSMIT CHAR.
	7421		/DISPLAY IN MQ
	JMP I TRNS
/
TTYO,	0		/TTY OUT SUBROUTINE
RDY,	TSF
	JMP RDY
	TLS
	JMP I TTYO
/
EXT,	CALL 0,EXIT
/
MASK,	77
	END
