C   VAXCOM.FT  COMMUNICATIONS BETWEEN THE VAX AND THE 12
	COMMON ICHAR,IERCT
	DIMENSION IBUF(40)
C
	DO 10 I=1,40
10	IBUF(I)=0
C
	WRITE(1,1000)
1000	FORMAT(' CALL VAX, ETC.')
C
50	CALL IACTV
C
	X=0.
	X=0.
C
	I=0
100	IFLG=0
	ICHR=0
	CALL VAXIN(IFLG,ICHR)
	X=0.
	X=0.
	IF(IFLG)200,200,150
150	I=I+1
	IBUF(I)=ICHR
	GOTO 100
C
200	WRITE(1,1020)I,IFLG
	WRITE(1,1010)IBUF(1)
	I=0
	IF(IFLG)100,50,100
1010	FORMAT(A80)
1020	FORMAT(2I6)
1030	FORMAT(A2)
	STOP
	END
