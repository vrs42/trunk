/  COMMUNICATOR I/O DEFINITIONS
/
SKPDF	CSDA  6401	/DATA AVAILABLE
SKPDF	CSTR  6403	/TMTR READY
OPDEF	CMI   6402	/INITIALIZE
OPDEF	CMT   6404	/TRANSMIT
OPDEF	CMLD  6406	/AC->M730
OPDEF	CMR   6407	/RECEIVE
/
/  INTERACTIVE SUBROUTINE
/
\ICHAR,	COMMN  1
\IERCT,	COMMN  1
	LAP
/BLK IS 600 WORD BUFFER FOR TTY OUTPUT
BLK,	BLOCK 200
	BLOCK 200
	BLOCK 200
	EAP
/
	ENTRY  IACTV
IACTV,	BLOCK  2
	CLA CLL
	DCA FLG		/CLEAR INTERRUPTION FLAG
/INITIALIZE POINTERS
	TAD BUFR
	DCA BUFO
	TAD BUFR
	DCA BUFI
	TAD BUFR
	TAD (577
	DCA BEND	/SET TO END OF BLK
ITV1,	CSDA		/CHECK IF CHARACTER RECEIVED
	JMP ITV3
	JMS RCV		/GET CHARACTER
	TAD \ICHAR
	DCA I BUFI	/STORE IN BLK
	INC BUFI	/UPDATE POINTER
	TAD BUFI
	CMA  IAC	/CHECK IF AT END OF BLK
	TAD BEND
	SZA
	JMP ITV2
	TAD BUFR	/RESET POINTER TO BEGINNING OF BLK
	DCA BUFI
ITV2,	CLA CLL
	TAD BUFI
	CMA  IAC	/CHECK APPROACHING OVERRUN
	TAD BUFO
	SPA SNA		/IF BUFO-BUFI>0
	JMP ITV3
	TAD (-36
	SMA CLA		/IF BUFO-BUFI<30
	JMP ITV3	
	TAD FLG		/CHECK INTERRUPTION FLAG
	SZA
	JMP ITV3
	TAD (232	/SEND ^Z
	JMS TRNS
	CLA IAC
	DCA FLG		/SET FLAG
	JMP ITV3
ITV3,	TSF		/CHECK TTY PRINTER READY
	JMP ITV4
	CLA
	TAD BUFO
	CMA  IAC	/CHECK IF CAUGHT UP
	TAD BUFI
	SNA CLA
	JMP ITV38
	TAD I BUFO
	TLS		/PRINT NEXT CHARACTER
	CLA CLL
	INC BUFO	/UPDATE POINTER
	TAD BUFO
	CMA  IAC	/CHECK IF AT END OF BLK
	TAD BEND
	SZA
	JMP ITV4
	TAD BUFR	/RESET POINTER TO BEGINNING OF BLK
	DCA BUFO
	JMP ITV4
ITV38,	TAD FLG		/CAUGHT UP
	SNA CLA		/CHECK INTERRUPTION FLAG
	JMP ITV4
	DCA FLG		/CLEAR INTERRUPTION FLAG
	TAD (215	/TO CONTINUE
	JMS TRNS
ITV4,	KSF		/CHECK KEYBOARD
	JMP ITV1
	JMS TTYI
	TAD (-203	/CHECK ^C
	SNA
	JMP ITV6
	TAD (-4		/CHECK ^G (BELL)
	SNA
	JMP ITV5
	TAD (-24	/CHECK ALTMODE
	SNA
	JMP ITV7
ITV44,	TAD (233	/RESTORE CHARACTER
	JMS TNLT
	DCA TEMP
	TAD TEMP
	TAD (-210
	SNA		/PRINT \ IF RUBOUT
	TAD (124
	TAD (210
	JMS TTYO
	CLA
	TAD TEMP
	JMS TRNS	/TRANSMIT
	JMP ITV1
ITV5,	RETRN IACTV
ITV6,	CALL 0,EXIT
ITV7,	TAD BUFI	/STOP PRINTOUT
	DCA BUFO
	JMP ITV44
/
FLG,	0		/INTERRUPTION FLAG
/POINTERS TO TTY BUFFER (BLK)
BUFO,	0		/OUTPUT POINTER
BUFI,	0		/INPUT POINTER
BUFR,	BLK		/BEGINNING OF BLK
BEND,	0		/END OF BLK
TEMP,	0
/
/SUBROUTINE SENDS THE CHARACTER STORED
/AT \ICHAR
	ENTRY SCHAR
SCHAR,  BLOCK 2
	CLA
	TAD \ICHAR
	JMS TRNS
	RETRN SCHAR
/
/SUBROUTINE RECEIVES ONE CHARACTER
/AND STORES IT AT \ICHAR
	ENTRY RCHAR
RCHAR,	BLOCK 2
RCHR1,	KSF
	JMP RCHR2
	JMS TTYI
	TAD (-203  / CHECKS ^C
	SNA CLA
	JMP ITV6
RCHR2,	CSDA
	JMP RCHR1
	JMS RCV
	RETRN RCHAR
/
/  CHARACTER TRANSLATION SUBROUTINE
/  RUBOUT -> ^H
/      ^U -> ^X
/  ALTMODE-> ^Z
TNLT,	0	/ENTRY
	TAD (-225  /^U
	SNA
	JMP TLT1
	TAD (-5  /ALTMODE
	SNA
	JMP TLT2
	TAD (-145    /RUBOUT
	SNA
	JMP TLT3
	TAD (377  /RESTORE CHARACTER
	JMP I TNLT  /RETURN
TLT1,	TAD (-2		/^X  230
TLT2,	TAD (22		/^Z  232
TLT3,	TAD (210	/^H
	JMP I TNLT
/
TTYI,	0
TIA,	KSF
	JMP TIA
	KRB
	JMP I TTYI
TTYO,	0
TOA,	TSF
	JMP TOA
	TLS
	JMP I TTYO
/
/ TRANSMIT SUBROUTINE
TRNS,	0	/ENTRY
TRA,	CSTR	/SKIP ON TMTR READY
	JMP TRA
	CMLD	/LOAD CHARACTER
	CMT	/TRANSMIT
	7421	/[MQL]
	JMP I TRNS	/RETURN
/
/ RECEIVE SUBROUTINE
RCV,	0	/ENTRY
RCVA,	CSDA	/SKIP ON CHAR AVAILABLE
	JMP RCVA
	CMR	/READ CHARACTER
	CMA
	DCA IC
	TAD IC
	AND ICX  /ISOLATE ERROR BITS
	SZA CLA
	JMP ERCV
	TAD IC
RCVB,	7421	/[MQL]
	7501	/[MQA]
	DCA \ICHAR
	CMI	/INITIALIZE
	JMP I RCV
ERCV,	INC \IERCT  /ERROR COUNT
	TAD ERCHR  /ERROR CHARACTER
	JMP RCVB
IC,	0
ICX,	7000
ERCHR,	244	/ $
	END
