02.00 C STRING INPUT
02.10 T !!"VARIABLE >";D 8;F I=,C;S VA(I)=C(I)
02.20 T !!"DECIBEL LEVEL >";D 8;I (C(1)-2).2;F I=,C;S DB(I)=C(I)
02.30 T !!"DECADE/TYPE >";D 8;I (C(1)-2).3;F I=,C;S DC(I)=C(I)
02.40 A !!"CONVERSION, TYPE 1 FOR 1/X, 2 FOR 1/(X+1)", CO

03.00 C VERFIICATION
03.10 TYPE !!,"VARIABLE ";F I=1,VA;X FOUT(VA(I))
03.20 TYPE !,"DECIBEL LEVEL ";F I=1,DB;X FOUT(DB(I))
03.30 TYPE !,"DECADE/TYPE ";F I=1,DC;X FOUT(DC(I))
03.35 TYPE !,"CONVERSION ";X FOUT(CO)
03.40 ASK "ALL CORRECT? (Y/N) ",OP;I (OP-14),2.0;I (OP-25)3.4,,3.4

04.00 C VARIABLE PARAMETER INPUT
04.10 A !" MEAN = ",MN
04.20 A !"STANDARD DEVIATION=",SD
04.30 A !" N OF CASES = ",N
04.50 C VERIFICATION
04.60 T !%7.03,"MEAN = ",MN
04.70 T !"STANDARD DEVIATION=",SD
04.80 T !,%3,"N OF CASES=",N
04.90 A !"ALL CORRECT? (Y/N)",OP;I (OP-14) ,4.0,;I (OP-25) 4.9,,4.9

06.00 C ARITHMETIC
06.10 S DF=N-1
06.20 F I=1,5;S CU(I)=MN+SD*(CV(DF,I)),CL(I)=MN-SD*CV(DF,I)
06.30 I (CO-2) .40,.60
06.40 F I=1,5;S RU(I)=1/CU(I),RL(I)=1/CL(I),GM=1/MN
06.50 G 7.00
06.60 F I=1,5;S RU(I)=1/CU(I)-1,RL(I)=1/CL(I)-1,GM=1/MN-1

07.00 C OUTPUT
07.10 O O LPT:
07.20 TYPE !!"2SD AND TL FOR ";F I=1,VA;X FOUT(VA(I))
07.25 TYPE !"AT DECIBEL LEVEL ";F I=1,DB;X FOUT(DB(I))
07.30 TYPE !"FOR DECADE/TYPE ";F I=1,DC;X FOUT(DC(I))
07.40 TYPE !%10.05," GROUP MEAN =",GM
07.50 TYPE !,"2SD   LL(-2SD)=",RL(1),"  UL(+2SD)=",RU(1)
07.60 TYPE !,"TL75% WITH P=95%","   ","UL(25%)=",RU(2)
07.70 TYPE !,"TL90% WITH P=95%","   ","UL(10%)=",RU(3)
07.80 TYPE !,"TL95% WITH P=95%","   ","UL(5%) =",RU(4)
07.81 TYPE !,"TL99% WITH P=95%","   ","UL(1%) =",RU(5)
07.85 T !"COMPUTED ON A MEAN OF",MN," DEVIATION OF",SD," N OF",%3,N
07.90 O O;Q

08.00 S I=1;C STRING INPUT ROUTINE
08.10 S C=FIN();I (C-255),.3;S C(I)=C;I (C-141),.4;S I=I+1;G .1
08.30 S I=I-1;X FOUT(136);X FOUT(160);X FOUT(136);G .1
08.40 S C=I;R
