13545  7710          SPA CLA
13546  7040          CMA             /EXTEND THE SIGN BIT
13547  7430          SZL
13550  7001          IAC             /AND ADD IN THE CARRY
13551  1051          TAD AC1H
13552  2047          ISZ OVER        /DONE?
13553  5334          JMP ADC2
13554  2045          ISZ HORD        /AC=MOST SIGNIFICANT BITS
13555  5334          JMP ADC2
13556  3045          DCA HORD

13557  4435          NORMALIZE       /EXPONENT= '27'
13560  4407          FENT
13561  3477          FDIV I FLARGP   /TAKE AVERAGE
