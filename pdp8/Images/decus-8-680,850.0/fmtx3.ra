/
/
/SUBROUTINES TO ALLOW MULTI-TASKING UNDER DEC-FORTRAN IV.
/
/WRITTEN BY:
/	R. W. PHELPS
/	DEPT. OF RADIATION BIOL & BIOPHYSICS
/	UNIVERSITY OF ROCHESTER
/	ROCHESTER, N. Y.  14620
/
/	19 JULY, 1974
/	VERSION 1.0, START4.RA - JOB SCHEDULING BY FPP
/
/	31 JULY, 1974
/	VERSION 2.0, FMTX.RA - JOB SCHEDULING BY BACKGROUND JOB.
/			FASTER UNLESS ANOTHER BACKGROUND JOB
/			E.G. SCOPE DISPLAY SHARES CPU PARTITION.
/
/	9 AUGUST, 1974
/	VERSION 2.1, FMTX2.RA - BUFFERING ADDED FOR A/D SAMPLES
/
/	VERSION 2.1.1, FMTX3.RA - AC BIT 0 CONTROLS DISPLAY IN MQ
/		1=> LAST A/D CHANNEL; 0=> SHIFTING PATTERN
/		12/29/74
/
/
/

	EXTERN #ARGER
	EXTERN #EXIT
/
/
/SUBROUTINES ADDED
/
	ENTRY RTIME	/READ TIME SINCE START (CLOCK PULSES)
	ENTRY KILL	/KILL TASK
	ENTRY START	/START TASK
	ENTRY CHANL	/INITIALIZE A/D CONVERSION & SET CHANNEL
	ENTRY RADC	/(FUNCTION) READ A/D CONVERSION
	ENTRY	WAIT	/WAIT FOR TIME OR EXTERNAL EVENT
	ENTRY EXTEVT	/SIMULATE AN EXTERNAL EVENT
	ENTRY #EVENT	/EXTERNAL LOC TO CHANGE WHEN AN
			/  EXTERNAL EVENT OCCURS
/
/
MQL=7421
MQA=7501
ASR=7415

FIELD1 FMTX
/
#XR,	ORG #XR+1	/INDEX REGISTERS FOR FPP
			/  SOME USED FOR COMMUNICATION BETWEEN
			/   BACKGROUND & FOREGROUND (SEE BELOW)
	  0;1		/INITIALIZE 2 TO NON-ZERO
	  0;0;0
	  0		/INITIALIZE XR 6 TO ZERO
	ORG #XR+10





/CLOCK AND A/D INTERRUPT SERVICE
/
/INCREMENTS TIMES FOR EACH TASK
/CONVERTS UP TO SIX A/D CHANNELS (ONE PER TASK)
/
/
M6,	-6
CLOCK,	ADDR ICLOCK+1	/DON'T USE LOCS 10-17 FOR INDIRECT REFERENCES
			/   SINCE THIS CODE MIGHT BE LOADED
			/   ON PAGE 0.
CHAN,	ADDR #CHAN+2
M20,	-20
M2000,	2000
K17AD,	17
ADPL,	ADDR ADPUT+1
TEMP,
CTIME,	ADDR DTIME+1
LCLOCK,
	ADDR DTIME+2

		/INDEX 5 USED TO SHOW <CHANL>
		/   THAT INTERRUPT SERVICE BUSY
		/   SO THAT NO CHANNEL ENABLE
		/   CONFUSION IS CAUSED BY SETTING
		/   A NEW CHANNEL.  THE CHANNEL
		/   LOCATIONS ARE ALSO USED FOR SWITCHES
		/   TO TELL WHICH TASKS REQUIRE CONVERSIONS.

KNTR=	5	/USE UNUSED INDEX REGISTERS AS POINTERS
LCHAN1=	0
LCHAN2=	ERTNO1
			/INDEX 4 USED TO RETURN A/D VALUE
			/INDEX 1 USED TO GET PARAMETERS
			/INDEX 2 NON-ZERO IF EXECUTING
			/INDEX 6 USED TO SAY ROUTINE READY
			/INDEX 7 USED AS FORTRAN INDEX
/
SAM=	0100
/
/
/CLOCK INTERRUPT SERVICE ROUTINE
/
/
#CLOCK,	0
	CLSA		/READ CLOCK STATUS & CLEAR IT
	SMA CLA
	HLT		/CLOCK FLAG NOT SET
/
	TAD M6		/SET UP COUNTER & POINTERS
	DCA KNTR
	TAD CLOCK+1
	DCA LCLOCK
	TAD CHAN+1
	DCA LCHAN1
	TAD CHAN+1
	DCA LCHAN2
	TAD ADPL+1
	DCA ADPL	/SET A/D BUFFER POINTER
/
	ISZ% CTIME+3	/INCREMENT CURRENT TIME
	SKP
	ISZ% CTIME+1
	NOP
/
L000,	TAD% LCHAN1	/CONVERSION DESIRED FOR THIS TASK?
	SPA
	JMP L002	/NO
	TAD #SAM	/YES - SET UP THE INSTRUCTION
	DCA .+3
	JMS ADINC	/INCREMENT A/D BUFFER POINTER
	LINC
	  0
	PDP
	DCA% TEMP
/
L001,	ISZ ADPL	/BUMP TO NEXT TASK WITH ACTIVE
	ISZ ADPL	/  CONVERSION REQUEST
	TAD% LCHAN2
	ISZ LCHAN2
	ISZ LCHAN2
	ISZ LCHAN2
	SPA CLA		/THIS TASK ACTIVE A/D
	JMP L001	/NO
/
L002,	CLA
	TAD LCLOCK	/BUMP THE CLOCK FOR THIS TASK
	DCA TEMP	/POINTER TO HIGH ORDER CLOCK BITS
	ISZ LCLOCK
	TAD% TEMP	/CHECK FOR NON-ZERO VALUE
	SZA CLA
	JMP L003	/HIGH ORDER NON-ZERO
	TAD% LCLOCK
	SNA CLA
	JMP L004	/BOTH WORDS ZERO - SKIP THIS TASK
/
L003,	ISZ% LCLOCK	/INCREMENT LOW ORDER WORD
	SKP
	ISZ% TEMP	/BUMP HIGH ORDER IF NECESSARY
	NOP
/
L004,	ISZ LCHAN1	/INCREMENT POINTERS
	ISZ LCHAN1
	ISZ LCHAN1
	ISZ LCLOCK
	ISZ LCLOCK
	ISZ KNTR	/MORE?
	JMP L000	/YES - REPEAT LOOP
	JMS ADINC
	LINC		/NO - GET RESULT OF LAST CONVERSION
#SAM,	SAM
	PDP
	DCA% TEMP
/
	LAS		/DISPLAY LAST CHANNEL CONVERTED IF
	SMA CLA		/  SIGN BIT=1
	JMP .+3
	TAD% TEMP	/DISPLAY MOVING PATTERN IF
	MQL		/  SIGN BIT=0
/
	CLSK		/IF CLOCK FLAG SET,
	JMP% #CLOCK
	CLL CML RTL	/2 => AC
	DCA% ERTNO1+1	/FATAL ERROR 2 - CLOCK TOO FAST FOR OVERHEAD
	JMP% #CLOCK
/
/
ADINC,	0		/INCREMENT POINTER FOR THIS A/D BUFFER
	TAD% ADPL	/GET THE POINTER
	DCA TEMP
	TAD TEMP
	AND K17AD
	SNA CLA		/HAS IT OVERFLOWED ACTUAL LENGTH?
	TAD M20		/YES - RESET IT TO ONE
	TAD% ADPL
	IAC
	DCA% ADPL
	TAD% TEMP	/MAKE SURE THIS LOCATION IS EMPTY
	TAD M2000
	SPA CLA		/HAS THE BUFFER FOR THIS CHANNEL OVERFLOWED?
	JMP% ADINC	/NO
	TAD ADPL	/DON'T LET DUMMY CHANNEL GIVE
	CIA		/  OVERFLOW ERROR
	TAD ADPL+1
	SNA CLA		/OVERFLOW?
	JMP% ADINC	/IT WAS THE DUMMY CHANNEL
	IAC		/ERROR 1 - A/D BUFFER OVERFLOW
	DCA% ERTNO1+1	/FATAL ERROR 1 - A/D BUFFER OVERFLOW
	DCA #XR+5	/RESET KNTR SO WON'T HANG IN <CHANL>
	JMP% #CLOCK	
/
ERTNO1,	ADDR ERTNO
/
/
	ORG .-1!177+1
/
/
/START THE CLOCK AND SET UP FOR INTERRUPT SERVICE
/
EXTERN ONQB
EXTERN ONQI
/
#SCLOK,	0
	LINC		/.OR. FAST SAMPLE INTO
	SFA		/  SPECIAL FUNCTIONS REGISTER
	PDP
	AND K7677
	TAD K100
	LINC
	ESF
	PDP
	CLA
	CDF 10
/
/START THE CLOCK
/
	CLAB		/0 => BUFFER PRESET
	CLLR		/0 => CLOCK CONTROL REGISTER
	TAD K100
	CLLR		/RATE=STOP; MODE=PRESET
	CLSA		/CLEAR STATUS IN CASE OF OVERFLOW
	CLA
	TAD MMSEC	/COUNTS BEFORE OVERFLOW
	CLAB		/LOAD INTO BUFFER PRESET REGISTER
	CLA
	TAD K300	/ENABLE INTERRUPT;
	CLEN		/   BUFFER=> COUNTER
	CLA
	TAD K4100	/RATE=1KHZ; MODE=PRESET
	CLLR
	CLA
/
/PUT TASK IN INTERRUPT CHAIN
/
	JMS% #ONQI+1
	  CLSK
	  ADDR #CLOCK
	JMS% #ONQB+1	/START BACKGROUND JOB
	  ADDR LOOPX
	TAD LIWORD	/CHECK THAT ALL ADDRESSES SAME FIELD
	AND K7
	CIA
	IAC
	SZA
	HLT		/ALL OF FMTX NOT IN SAME FIELD!!!!!
	CIF CDF 0
	JMP% #SCLOK
/
/
LINC=	6141
PDP=	2
CLEN=	6134
SFA=	24	/SPECIAL FCN=> AC
ESF=	4	/LOAD SPECIAL FCN REG.
CLSK=	6131	/SKIP ON CLOCK FLAG
CLAB=	6133	/C(AC) => BUFFER PRESET
CLLR=	6132	/LOAD CLOCK CONTROL REGISTAER
CLSA=	6135	/CLOCK STATUS TO AC
#ONQB,	ADDR ONQB
#ONQI,	ADDR ONQI
LIWORD,	ADDR LAST
/
MMSEC,	-62
K100,	100
K7677,	7677
K4100,	4100
K300,	300
K7,	7
/
/
RRATE,	0		/RESET CHANGED CLOCK RATE
	TAD MMSEC
	CLAB
	CLA
	CIF CDF 0
	JMP% RRATE
ICLOCK,	REPEAT 6	/HOLDS WAIT TIME FOR EACH TASK
	F 0.0
DTIME,	27; 0; 0	/CURRENT TIME
#CHAN,	REPEAT 6	/CHANNELS FOR A/D CONVERSION
	0; 0; 7777
MASK,	REPEAT 6	/HOLDS MASK FOR EACH TASK
	F 0.0
BASE,	REPEAT 6	/HOLDS RETURN LOCS FOR EACH TASK
	F 0.0
XTIME,	REPEAT 6	/POINTS TO TIME IN CALLING ROUTINE
	FNOP; JA FTEM
XMASK,	REPEAT 6	/POINTS TO RESPON IN CALLING ROUTINE
	FNOP; JA FTEM
	TEXT +FMTX  +	/TRACEBACK INFO
#RET,	SETX #XR	/RESET REGISTERS AFTER SR CALL
	SETB #BASE
	JA .+3
#BASE,	FNOP		/NEW BASE PAGE START
	JA #G0004
FTEM,	F 0.0		/USE FOR GETTING PARAMETERS
ITASK,	ORG	.+3
ITIME,	ORG .+3
RESPON,	ORG .+3
#ERRET,	ORG	.+0003	/SAVE LOCATION OF IERR IN MAIN
#LIT1,	F 1.0
J,	F 0.0
	FNOP		/RETURN - MUST BE AT
	JA #RET		/   LOCATION #BASE+30
#RTN0,	FNOP		/SAVE RETURN TO MAIN HERE
	JA #G0004	/PROTECTION IF NO CALL WAIT(0) MADE
#RTN,	FNOP
	JA #RTN
#LIT6,	F 6.0


ERROR,	TRAP4 #ARGER
	JSR #EXIT

SETUP, 	JA .		/GET PARAMETERS FOR EACH ENTRY
	BASE 0
	STARTD
	FLDA	30	/GET RETURN JUNP
	FSTA	#RTN+1,0 /SAVE IT
	FLDA	0	/GET POINTER TO PARAMETERS
	SETX	#XR
	SETB	#BASE
	BASE #BASE
	LDX	0,1
	FSTA	#BASE+3
	FLDA%	#BASE+3,1+	/GET PARAMETERS
	FSTA	ITASK
	FLDA%	#BASE+3,1+
	FSTA	ITIME
	JA SETUP


CHECK,	JA .
	FLDA% ITASK	/MAKE SURE TASK NUM IS IN RANGE
	ATX 7
	JLE ERROR	/LESS THAN 1

	FSUB #LIT6
	JGT ERROR	/GREATER THAN 6
	JA CHECK

/
/SUBROUTINE START (TASK, I)*********************************************
/
START,	JSA SETUP	/GET THE PARAMETERS
	STARTF
	FLDA%	ITIME
	ATX	7
	JLE ERROR
	FSUB #LIT6
	JGT ERROR
	FLDA%	ITASK
	FSTA	BASE-0003,7	/PUT <JSR TASK> IN BUFFER
	JA	#RTN	/RETURN

/
/	SUBROUTINE EXTEVT (EVENT) ****************************
/
EXTEVT,	JSA SETUP	/SIMULATE AN EXTERNAL EVENT
	STARTF
	FLDA% ITASK	/GET WHICH EVENT
	ALN 0		/FIX IT
	FSTA EXTWRD	/SAVE IT LOCALLY
	TRAP4 EXTOR	/OR IT IN
	JA #RTN
/
EXTWRD,	F 0.0
LIWRD1,	ADDR IWORD
LIWRD2,	ADDR IWORD+1
/
EXTOR,	0		/SUBROUTINE TO DO A DOUBLE PRECISION .OR.
	CDF 10
	IOF
	TAD EXTWRD+1
	AND% LIWRD1+1
	CMA
	AND% LIWRD1+1
	TAD EXTWRD+1
	DCA% LIWRD1+1
	TAD EXTWRD+2	/DO LOW ORDER WORD
	AND% LIWRD2+1
	CMA
	AND% LIWRD2+1
	TAD EXTWRD+2
	DCA% LIWRD2+1
	ION
	CDF CIF 0
	JMP% EXTOR
/SUBROUTINE WAIT (I, TIME, RESPON)********************************
/
WAIT,	JSA SETUP	/GET PARAMETERS

	FLDA% #BASE+3,1+
	FSTA RESPON
	STARTF
	FLDA%	ITASK
	ATX	7

	JGT L010
/
/COMES HERE WHEN CALL IS OF THE FORM:
/	SUBROUTINE WAIT (0, RATE, IERR)
/
	FLDA	#RTN	/I OUT OF RANGE --
			/   ASSUME CALLED BY MAIN
	FSTA	#RTN0	/SAVE RETURN TO MAIN
	FLDA% ITIME	/GET RATE
	FNEG
	SETX MMSEC	/TRANSFER IT TO 8-MODE PROGRAM
	ATX 0
	SETX #XR
	FLDA RESPON	/SAVE RETURN LOC FOR IERR
	FSTA #ERRET
	TRAP4 RRATE	/SET NEW RATE IN CLOCK
	JA	L060	/GO TO LOOP
L010,	FSUB	#LIT6
	JGT ERROR

	FLDA	ITIME	/SAVE LOC OF TIME
	FSTA	XTIME-3,7
	FLDA	RESPON	/SAVE LOC OF RESPON IN XMASK(I)
	FSTA	XMASK-3,7
	FLDA% ITIME
	FNEG
	ALN	0	/FIX THE VALUE
	FSTA	ICLOCK-0003,7 /ICLOCK(I)=-FIX(TIME)
	FLDA% RESPON
	ALN	0	/FIX IT
L050,	FSTA	MASK-0003,7	/MASK(I)=FIX(RESPON)
	FLDA #RTN	/SET <JA RTN> IN BASE(I)
	FSTA BASE-3,7
L060,	TRAP4 #SCLOK	/START CLOCK FIRST TIME ONLY
	FLDA #BASE
	FSTA L060,0
/
/GO TO TASK NEEDING SERVICE
/
#G0004,	LDX 0,2		/INDICATE NOT EXECUTING
	XTA 6		/READY TO GO WITH NEW TASK
	JNE L067	/WAIT FOR BGND RESTART IF
	XTA 6		/CHECK IT AGAIN SO WE DON'T MISS IT
	JNE L067
	FPAUSE		/XR 6 IS 0
	XTA 6
L067,	LDX 1,2		/INDICATE TASK BEING EXECUTED
	FSTA J
	FSUB #LIT6
	JLE L070
	FSUB #LIT1
	FSTA% #ERRET	/RETURN ERROR IF XR 6 > 7
	LDX 0,6		/RETURN TO MAIN IF XR6 > 6
	JA #RTN0
L070,	FLDA	BASE-0003,6	/GO TO BASE(J)
	STARTD
	FSTA	GOLOC
	STARTF
	FCLA
	FSTA	BASE-0003,6
	FLDA	XTIME-3,6
	FSTA	ITIME
	FLDA	ICLOCK-0003,6	/SET PARAMETERS TO RETURN
	JGE .+3
	FNEG
	FNORM		/FLOAT IT
	FSTA% ITIME
	FLDA	XMASK-3,6
	FSTA	RESPON
	FLDA MASK-3,6
	FNORM
	FSTA% RESPON
/
	XTA 4		/GET A/D VALUE IN FAC IF NEEDED
	LDX 0,6		/TELL BGND WR'RE DONE WITH SETUP
GOLOC,	JSR .		/MAY BE <JA> IF RETURN AFTER
			/   <CALL WAIT> OR <JSR> IF
			/   START AFTER <CALL START>.
	JA .+0004
	JA J		/IN CASE <CALL START>
	JA #G0004	/CONTINUE LOOP (THIS TASK DISABLED)
/CALL CHANL (ITASK, CHNL)*************************************
/
CHANL,	JSA SETUP	/GET PARAMETERS
	STARTF
	JSA CHECK	/CHECK TASK NO
CHL1,	XTA 5		/DOING CONVERSIONS NOW?
	JNE CHL1	/YES WAIT TILL DONE
	FLDA% ITIME
	ALN 0		/FIX IT
	FSTA #CHAN-3,7	/PUT CHANNEL NUMBER INTO LIST
	JLT CHL2	/JUMP IF TERMINATE COLLECTING
	FLDA #LIT1	/PUT 1 IN CLOCK REGISTER SO
	ALN 0		/FIX IT
CHL3,	FSTA ICLOCK-3,7	/  IT COUNTS & DOESN'T CAUSE
	FCLA
	FSTA MASK-3,7
	JA #RTN
/
/FUNCTION RADC (ITASK, TIME)*****************************************
/
RADC,	JSA SETUP	/GET PARAMETERS
	STARTF
	JSA CHECK	/CHECK TASK NO
	FLDA ITIME
	FSTA XTIME-3,7
ADC1,	FCLA		/ZERO THE MASK
	JA L050		/GO TO LOOP & WAIT
/
/
/
/SUBROUTINE KILL (ITASK)*******************************************
/
KILL,	JSA SETUP
	STARTF
	JSA CHECK	/CHECK TASK NO
	FCLA		/KILL IT
	FSTA BASE-3,7
	FLDA FM1X	/STOP CONVERSIONS
	FSTA #CHAN-3,7
CHL2,	FCLA
	FSTA ICLOCK-3,7	/DON'T COUNT TIME
/
	XTA 7		/CLEAR A/D BUFFER TO ALL 2000
	FMUL #LIT8
	ATX 1		/POSITION IN BUFFER OF THIS TASK
	FLDA #LIT8	/SET COUNTER
	FNEG
	ATX 3
	STARTD
	FLDA ADPUT,7	/RESET POINTERS
	FSTA ADGET-2,7
	FLDA #L2000
KIL1,	FSTA ADBUF-2,1+	/ZERO THE PROPER LOCATIONS
	JXN KIL1,3+
	STARTF
/
	XTA 6		/CLEAR XR-6 IN CASE THIS TASK GOT
			/   SET UP BEFORE BEING KILLED.
	FSUB% ITASK
	JNE #RTN	/NOT THIS TASK THAT WAS SET UP
	ATX 6		/KILL THIS TASK
	JA #RTN		/RETURN IMMEDIATELY TO CALLING PROG
FM1X,	0;0;7777
#LIT8,	F 8.0
#L2000,	2000;2000
/
/
/SUBROUTINE RTIME (TIME)********************************************
/
RTIME,	BASE 0		/RETURN TIME SINCE FMTX STARTED
	STARTD
	FLDA 30
	FSTA #RTN+1,0
	FLDA 0
	SETX #XR
	SETB #BASE
	BASE #BASE
	LDX 1,1
	FSTA #BASE+3
	FLDA% #BASE+3,1
	FSTA ITIME
	STARTF
	FLDA DTIME
	FNORM
	FSTA% ITIME
	JA #RTN
/






ADPUT,	ADDR ADBUF	/USED DURING EXTRA CONVERSION FROM
			/  FAST SAM INSTRUCTION
	ADDR ADBUF+20	/BUFFER FOR TASK 1
	ADDR ADBUF+40
	ADDR ADBUF+60
	ADDR ADBUF+100
	ADDR ADBUF+120
	ADDR ADBUF+140
ADGET,	ADDR ADBUF+20	/USED TO GET VALUES BACK
	ADDR ADBUF+40	/TASK 2
	ADDR ADBUF+60
	ADDR ADBUF+100
	ADDR ADBUF+120
	ADDR ADBUF+140
ORG .-2!17+2
ADBUF,	REPEAT 157	/SEVEN BUFFERS, EACH FROM XXX1 TO XXY0
	  2000
	  2000
BUMP,	ISZ TEMK
	JMP% LOOPX1+1	/DON'T CHANGE IT YET
	TAD TEML	/GET LINK
	CLL RAR
	TAD TEMAC	/GET OLD AC (MQ)
	CMA CML RAR	/DO LIGHT THING TO IT
	DCA TEMAC
	LAS		/DISPLAY POINTS IF SIGN=0
	SPA CLA
	JMP .+3
	TAD TEMAC
	MQL
	RAL		/GET LINK
	DCA TEML
	JMP% LOOPX1+1
/
LOOPX1,	ADDR LOOPX-1
TEMAC,	5252
TEMK,	0
TEML,	0
/
/
CONT45,	TAD% ADGL	/CHECK FOR A/D CONVERSION
	DCA TEM2
	TAD% TEM2	/GET NEXT VALUE IN PROPER TABLE
	TAD M2000A
	SMA CLA		/ANY WAITING?
	JMP% LCONT7+1	/NO
	TAD% TEM2	/RETURN IT TO FPP
	DCA% INDEX4+1	/  VIA INDEX 4
	TAD K2000	/INDICATE NOT WAITING NOW
	DCA% TEM2
	TAD TEM2		/BUMP THE POINTER
	AND K17AD2
	SNA CLA
	TAD M20A
	IAC
	TAD TEM2
	DCA% ADGL	/PUT IT BACK
	IOF
	JMP% LCONT5+1
/
/
LCONT5,	ADDR CONT5
TEM2,
LCONT7,	ADDR CONT7+1
ADGL,
INDEX4,	ADDR #XR+4
M2000A,	-2000
M20A,	-20
K17AD2,	17
K2000,	2000
/
/
ORG .-1!177+1
/
/BACKGROUND LOOP TO SET UP TASKS FROM QUEUE
/
	JMP% .+1
LOOPX,	0
	TAD% INDEX6+1	/FPP PICKED UP LAST ONE?
	SZA CLA
	JMP% BUMPX+1	/NO - BUMP LIGHTS
	ISZ KNTRA	/RESET POINTERS?
	JMP CONT0	/NO - CONTINUE
	TAD M6A
	DCA KNTRA
	TAD LBASE+1
	DCA LBASE
	TAD LCLK+1
	DCA LCLK
	TAD LMASKA+1
	DCA LMASKA
	TAD LADGL+1
	DCA% LADGL+3
	TAD FLAG
	SNA CLA		/ANY TASKS WAITING?
	JMP CONT8	/YES
	TAD% INDEX2+1	/NO
	SZA CLA		/EXECUTING?
	JMP CONT8-1	/YES
	TAD FLAG2	/NO
	SZA CLA		/TRY SECOND TIME?
	JMP RTMAIN	/NO ALREADY TRIED 2ND TIME

CONT9,	IAC
	DCA FLAG2
CONT8,	IAC
	DCA FLAG	/RESET FLAG
			/REMAINS ZERO IF RETURN TO MAIN INDICATED
CONT0,	TAD% LBASE	/THIS TASK WAITING?
	SNA CLA
	JMP CONT6	/NO - GO TO NEXT
	DCA FLAG	/SET SWITCH - SOME TASK IS WAITING
	DCA FLAG2
	TAD LMASKA
	DCA TEM
	ISZ LMASKA
	IOF
	TAD% LCLK	/IS CLOCK TIMED OUT?
	ISZ LCLK
	SZA CLA
	JMP CONT2	/NO - GO CHECK EXT. EVENT
	TAD% LCLK	/MAYBE - CHECK NEXT WORD
	SNA CLA
	JMP CONT5	/CLOCK ZERO - SETUP RETURN THIS TASK
CONT2,	ION
	TAD% TEM
	AND IWORD
	DCA TEM+1	/MASKED FIRST WORD
	TAD% LMASKA
	AND IWORD+1
	SNA
	JMP CONT3	/NO EXT. EVENT, SECOND WORD
	DCA% LMASKA	/EXT. EVENT 2ND WORD, SET BITS
	TAD TEM+1
	DCA% TEM	/RESET 1ST WORD TOO
	JMP CONT4
CONT3,	TAD TEM+1	/EVENT 1ST WORD?
	SNA
	JMP% LC45+1	/NO - NO EXT EVENT
	DCA% TEM	/YES, RESET BITS FIRST WORD
	DCA% LMASKA	/2ND WORD ZERO TO GET HERE, SET IT
CONT4,	IOF
	TAD% LMASKA	/MASK THESE BITS FROM IWORD
	CMA
	AND IWORD+1
	DCA IWORD+1
	TAD% TEM
	CMA
	AND IWORD
	DCA IWORD
CONT5,	TAD% LBASE	/MAKE SURE TASK HAS NOT BEEN
	SNA CLA		/   KILLED SINCE WE FIRST FOUND IT
	JMP CONT7	/   NOTE - IOF HERE
	TAD ERTNO	/SEE IF WE NEED AN ERROR RETURN
	SNA
	TAD KNTRA
RTMAIN,	TAD K7A
	DCA% INDEX6+1	/SET INDEX TO TELL FPP TO GO
	DCA ERTNO	/RESET ERROR FLAG
	6555		/RESTART FPP IS PAUSE MODE
	NOP
	JMP CONT7
CONT6,	ISZ LMASKA	/ENTRY FROM BASE=0,
	ISZ LCLK	/  BUMP COUNTERS NOT CKECKED
CONT7,	ION
	ISZ LMASKA	/BUMP OTHER POINTERS
	ISZ LMASKA
	ISZ LCLK
	ISZ LCLK
	ISZ LBASE
	ISZ LBASE
	ISZ LBASE
	ISZ% LADGL+3
	ISZ% LADGL+3
	JMP% BUMPX+1
/
BUMPX,	ADDR BUMP
LBASE, ADDR BASE+1
