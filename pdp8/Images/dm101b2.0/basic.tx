ine

30010	IF ERR(0) = 59 THEN IF ERL(0) = 6100 THEN  RESUME 6140
		!POS error if exclamation point is at the end of a line

30020	IF ERR(0) = 63 THEN IF ERL(0) = 11030 THEN REM >CONTINUE<
	  PRINT CUR$(22,1);
	  PRINT "?ERROR! - NO REFERENCE FOR LINE NUMBER";LINE.NUMBER
	  STOP

30030	PRINT CUR$(22,1);"?ERROR";ERR(0);"AT LINE";ERL(0)

99999 REM**99999,1**
	END
