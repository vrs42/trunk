C^  JUNE   16    1975
C	KSORT
C	WILL RESHUFFLE COLUMNS IN AN OUTLAY FILE FOR USE WITH STAT
C	INPUT FILES:
C	UNIT      CONTAINS       FORMAT
C	6	DATAFILE	OUTLAY
C	5	PARAMETERS
C			LINE 1  NGO NKO IFILL,SORT,EXTRN,LIST,MISS,MAX
C			MAIN HEADING
C			NGO HEADINGS CONDITIONALLY *
C			ETC	GO,KO,GI,KI,OPT,K2,KONTS(6I3,F10.0)
C	NGO	NUMBER OF GROUPS OUTPUT<100
C	NKO	NUMBER OF KOLUMNS OUTPUT<11
C	THE SWITCHES ARE AS FOLLOWS:
C
C	NAME	ACTION ON 0	VALUE	ACTION
C	FILL	UNSTATED COLUMNS NOT USED	1	FILLED OUT
C	SORT	NONE	0<SORT<NKO	EACH GROUP SORTED ACCORDING TO
C					KOL SORT
C	EXTRN	NONE	1	THE SUBROUTINE EXTERN CALLED #
C	LIST	NONE	1	THE "RE-AARANGEMENT TABLES " PRINTED
C	MISS	NONE	1	ANY ROW WITH MISSING DATA DELETED
C	MAX	0	0<MAX<NMAX	STOP SEARCHING AT MAX ROWS
C
C	GO	GROUP OUTPUT  &
C	KO	KOLUMN OUTPUT  &
C	GI	GROUP INPUT
C	KI	KOLUMN INPUT
C	OPT	OPTION NUMBER<CAN BE LEFT BLANK> SEE BELOW
C	NK2	KOLUMN NUMBER USED WITH OPTION<OPTIONAL>
C	KONST	KONSTANT        "    "   "       "
C	FOR THE OPTION NUMBERS SEE SUBROUTINE XFUNC
C	OUTPUT FILES
C	UNIT	WILL CONTAIN
C	7	OUTPUT DATA FILE INOUTLAY FORMAT
C	3	SUMMARY OF OUTPUT FILE+ANY FORMAL ERRORS
C
C
C	*
C	HEADINGS ARE TAKEN AS FOLLOWS
C	NGO		ACTION
C	>1	NGO,NKO FROM UNIT 5  HEADINGS FROM UNIT 5
C	0	NGO AND HEADINGS FROM UNIT 6 NKO FROM 6 IF 0 IN 5
C	<0	NGO=ABS(NGO),NKO FROM UNIT 5,HEADINGS GENERATED INTERNALLY

C	#
C	THE SUBROUTINE EXTERN IS CALLED JUST BEFORE WRITING OUTPUT
C	DATA IF EXTRN<>0
C	CALLING:
C	CALL EXTERN(NG,X,NKO,SW,TWICE,COUNT,SKIP)
C	SW  AND TWICE LOGICAL
C	NG IS CURRENT GROUP NUMBER,IF IT IS CHANGED SO ARE
C		SORT AND LIST MEANINGLESS AND INHIBITED
C	X IS THE VECTOR(NKO LONG)TO BE WRITTEN THE SUBROUTINE
C		MAY CHANGE OR RE-ORDER ANY DATA IN IT
C	SW IS SET TO FALSE IF FOR SOME REASON THE DATA 
C	SHOULD NOT BE INCLUDED
C	TWICE IS .FALSE. ON CALLING IF SET TO .TRUE.
C	THE DATA IS WRITTEN AND THEN EXTERN RE-CALLED
C	THIS PERMITTS E.G. MAKING TWO GROUPS OF ONE
C	N.B. TAKE CARE
C	DELIVER A .FALSE. AT SOME TIME OR THE PROGRAM WILL
C	LOOP INDEFINATELY(OR TILL FILE STORAGE IS EXHAUSTED)
C	COUNT IS A COUNTER OF THE NUMBER OF TIMES THAT EXTERN HAS BEEN
C	CALLED WITH THIS DATA
C	E.G. USED IN A COMPUTED GOTO IN EXTERN
C	SKIPGRP IS  SET TO TRUE IF NO MORE CALLS TO EXTERN ARE REQUIRED
C	IN THIS DATA GROUP

C	&
C	GO AND OR KO CAN BE SET TO -1 THIS IMPLIES ALL GROUPS OR COL
C
C	I.E.
C	-1,1,0,3	FOR ALL GROUPS DUPLICATE COL 1 INTO COL3
C	3,-1,3,0,2	FOR ALL COLMNS IN GROUP 3 APPLY OPERATION CODE
C			2
C	-1,-1,0,0	IS LEGAL AND IMPLIES ALL THE INPUT IS TO BE 
C			CONVERTED(E.G.SORTED)
	REAL KONST(10)
	COMMON NKO
	INTEGER TABLE(4,10),CURGRP,SORT,FILL
	INTEGER POINT(10)
	DIMENSION INOPT(6)
	EQUIVALENCE (INOPT(1),INOPT1),(INOPT(2),INOPT2)
C	NMAX MUST BE EQUAL TO DIM(XL)
	DATA NMAX/2000/
	DIMENSION XIN(20),XL(2000)
	DIMENSION R(3),R2(12)
	LOGICAL EXTRN,LIST,SW,MISS,EXT,SKIP
	DATA SKIP/.FALSE./
1000	FORMAT(6I3,F10.0)
1990	FORMAT(' GROUP NR ',I5,' >',I4,' OBSERVATIONS IGNORED')
1200	FORMAT(12A6)
1201	FORMAT(1H ,3A6)
1400	FORMAT(I3,(7E11.4))
1300	FORMAT('1               K- S O R T')
1900	FORMAT('0 GROUP NUMBER',I5,' CONTAINS ',I5,' ROWS',/
     1	' KOL   FROM   CODE     COL2    KONST     NO OF'
     2,/ 4X,'GR   COL',28X,'DATA')
1600	FORMAT(1H ,2I3,2I5,I9,F11.3,I6)
1999	FORMAT('0 ILLEGAL REQUEST STOPPING')
2000	FORMAT(' GROUP NR:',I5)
2100	FORMAT(10I10)
2200	FORMAT(' GROUP NUMBER CHANGED BY EXTERN')
2300	FORMAT(1H+,32X,'LISTING INHIBITED')
2400	FORMAT(1H+,32X,'SORTING INHIBITED')
2600	FORMAT(' *  SORTED BY THIS COLUMN')
2700	FORMAT(1H+,44X,'*')
	INTEGER COUNT
	LOGICAL CHANGE,TWICE
	DATA XIN,CHANGE/10*0.,.FALSE./
	READ(5,2100)NG,NK,FILL,SORT,EXTRN,LIST,MISS,MAX
	IF(MAX.EQ.0)MAX=NMAX
	IF(LIST)WRITE(3,1300)
	READ(6,1000)NGI,NKI
	READ(6,1200)R2
	READ(5,1200)R2
	IF(NG)10,20,30
C	NG<0 IE AUTOHEADINGS FOR ABS(NG)GROUPS)
10	NKO=NK
	NGO=IABS(NG)
	NTO=2
	GOTO 40
C	NG=0 IE NGO AND NKO AND HEADINGS FROM INPUT
20	NGO=NGI
	NTO=2
	NKO=NK
	GOTO 40
C	NK>O  IE NKO=NK AND HEADINGS FROM UNIT 6
30	NKO=NK
	NGO=NG
	NTO=NG+2
40	IF(NKO.EQ.0)NKO=NKI
	IF(NKO.GT.10.OR.NKO.LE.0)GOTO 999
	IF(NGO.GT.100.OR.NKO.LE.0)GOTO 999
	IF(SORT.GT.NKO.OR.SORT.LT.0)GOTO 999
	WRITE(7,1000)NGO,NKO
	WRITE(7,1200)R2
	DO 45 CURGRP=1,NGO
	IF(NG)41,42,43
41	WRITE(7,2000)CURGRP
	GOTO 45
42	IDEV=6
	GOTO 44
43	IDEV=5
44	READ (IDEV,1200)R
	WRITE(7,1200)R
45	CONTINUE
	NTI=NGI+2
	NK=NKO
	DO 500 CURGRP=1,NGO
	EXT=EXTRN
C	RESET AT BEGINNING OF EACH NEW GROUP
	IF(.NOT.LIST)WRITE(0,2000)CURGRP
C	JUST TOO KEEP TRACK THAT ITS ALIVE
	DO 80 J=1,NMAX
80	XL(J)=0
	REWIND 6
	REWIND 5
	DO 27 J=1,NTI
27	READ(6,1200)R
	DO 28 J=1,NTO
28	READ(5,1200)R
	DO 50 K=1,10
	KONST(K)=0
	POINT(K)=0
	TABLE(3,K)=0
	TABLE(4,K)=0
50	TABLE(2,K)=FILL*K
	DO 46 J=1,10
46	TABLE(1,J)=FILL*CURGRP
55	READ(5,1000)INOPT,X
	IF(INOPT1.EQ.0)GOTO 100
	IF(INOPT1.LT.0)INOPT(3)=CURGRP
	IF(INOPT1.LT.0)INOPT1=CURGRP
	IF(INOPT1.NE.CURGRP)GOTO55
	IF(INOPT2.GT.NKO.OR.INOPT2.EQ.0)GOTO55
	IF(INOPT2.LT.0)GOTO 70
	DO 60 J=1,4
60	TABLE(J,INOPT2)=INOPT(J+2)
	KONST(INOPT2)=X
	GOTO 55
70	 DO 75 I=1,NKO
	INOPT(4)=I
	KONST(I)=X
	DO 75 J=1,4
75	TABLE(J,I)=INOPT(J+2)
100	READ(6,1400)INGR,(XIN(J),J=1,NKI)
	IF(INGR.EQ.0)GOTO 200
	DO 150 J=1,10
	IF(INGR.NE.TABLE(1,J))GOTO 150
	X=XIN(TABLE(2,J))
	IF(TABLE(3,J).NE.0)CALL  XFUNC(X,XIN,TABLE(1,J),KONST(J))
	POINT(J)=POINT(J)+1
	IF(POINT(J)*NKO.GT.NMAX)GOTO 900
	IF(POINT(J).GT.MAX)GOTO200
	IA=(POINT(J)-1)*NKO+J
	XL(IA)=X
150	CONTINUE
	GOTO 100
200	IMAX=0
	DO 210 J=1,NKO
210	IMAX=MAX0(IMAX,POINT(J))
	IF(SORT.EQ.0)GOTO 240
	DO 230 I=1,IMAX-1
	DO 230 J=I+1,IMAX
	KI=(I-1)*NKO
	KJ=(J-1)*NKO
	IF(XL(KI+SORT).LT.XL(KJ+SORT))GOTO230
	DO 225 L=1,NKO
	X=XL(KI+L)
	XL(KI+L)=XL(KJ+L)
225	XL(KJ+L)=X
230	CONTINUE
240	IF(IMAX.EQ.0)GOTO NX
	DO 250 J=1,IMAX
	NG=CURGRP
	COUNT=1
247	TWICE=.FALSE.
	SW=.TRUE.
	SKIP=.FALSE.
	IF(EXT)CALL EXTERN(NG,XL((J-1)*NKO+1),NKO,SW,TWICE,COUNT
     *,SKIP)
C	SHOULD CALLS TO EXTERN BE INHIBITED ?
	IF(SKIP)EXT=.FALSE.
	IF(NKO.NE.NK)STOP
	COUNT=COUNT+1
	IF(NG.EQ.CURGRP)GOTO 245
	IF(NG.GT.NGO)GOTO 999
	IF(.NOT.CHANGE)WRITE(0,2200)
	IF(LIST)WRITE(3,2200)
	IF(LIST)WRITE(3,2300)
	LIST=.FALSE.
	IF(SORT.NE.0)WRITE(3,2200)
	IF(SORT.NE.0)WRITE(3,2400)
	CHANGE=.TRUE.
	SORT=0
245	IF(.NOT.MISS)GOTO 249
	DO 248 K=1,NK
248	IF(.NOT.SW.OR.XL((J-1)*NKO+K).EQ.0)SW=.FALSE.
249	IF(SW)WRITE(7,1400)NG,(XL((J-1)*NKO+K),K=1,NKO)
	IF(TWICE)GOTO 247
250	CONTINUE
	IF(.NOT.LIST)GOTO 500
	WRITE(3,1900)CURGRP,IMAX
	DO 260 J=1,NKO
	WRITE(3,1600)J,(TABLE(K,J),K=1,4),KONST(J),POINT(J)
	IF(J.EQ.SORT)WRITE(3,2700)
260	CONTINUE
	IF(SORT.NE.0)WRITE(3,2600)
	IF(EXTRN)WRITE(3,2700)
	GOTO 500
900	WRITE(3,1990)CURGRP,NMAX
500	CONTINUE
	CURGRP=0
	WRITE(7,1400)CURGRP,(XIN(CURGRP),CURGRP=1,NKO)
	CALL EXIT
999	WRITE(0,1999)
	IF(LIST)WRITE(3,1999)
	REWIND 7
	STOP
	END
