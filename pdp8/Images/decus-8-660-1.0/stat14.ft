C	STAT14
C	PART OF STAT
	SUBROUTINE STAT14
	COMMON /PARAM/NGU,NGR,LIST,ATT,LDEVE,LDEVL,MISS,NOPAGE
C	MANN WHITNEY UTEST NO 14
100	FORMAT(' MANN WHITNEY UTEST',/
     1' COLUMNS '5X,'N1',5X,'N2',7X,'U',6X'Z',12X,'2*P')
200	FORMAT(1H ,I3,I5,2I6,F12.0,F12.4,F10.3,I15)
300	FORMAT(1H ,'USE TABLE ',A1,' IN SIEGEL')
400	FORMAT(' BAD DATA <ALL TIED>')
	COMMON /DATA/XL
	COMMON IAN,KOL,NK,N
	DIMENSION XL(1),KOL(2),JL(2)
	LOGICAL STATER
	IF(STATER(4,'14'))RETURN
	WRITE(LDEVL,100)
	NT=N*NK
	IR=NT+2*N
	DO 20 K=1,2
	J=0
	K1=(KOL(K)-1)*N
	K2=(NT+(K-1)*N)
	DO 10 I=1,N
	X1=XL(K1+I)
	IF(X1.EQ.0)GOTO 10
	J=J+1
	XL(K2+J)=X1
10	CONTINUE
20	JL(K)=J
	L1=1
	IF(JL(1).GE.JL(2))GOTO 22
	J1=1
	J2=2
	GO TO 50
22	J1=2
	J2=1
50	J=JL(J1)
	K=0
	K1=NT+(J1-1)*N
	DO 30 I=1,J
	K=K+1
30	XL(IR+K)=XL(K1+I)
	J=JL(J2)
	K1=NT+(J2-1)*N
	DO 32 I=1,J
	K=K+1
32	XL(IR+K)=XL(K1+I)
70	J1=JL(J1)
	J2=JL(J2)
	CALL  UTEST(XL(IR+1),XL(NT+1),J1,J2,U,Z,IER)
	IF(IER.EQ.1)GOTO 90
	CALL NDTR(Z,P,DUMMY)
	P=2*P
	WRITE(LDEVL,200)KOL,J1,J2,U,Z,P
	IF(J2.GT.20)RETURN
	J1='K'
	IF(J2.LE.8)J1='J'
	WRITE(LDEVL,300)J1
	RETURN
90	WRITE(LDEVE,400)
	RETURN
	END
