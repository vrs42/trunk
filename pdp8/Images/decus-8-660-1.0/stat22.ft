C	STAT 22
C	SUBROUTINE STAT 22 HANDLES 3 TYPES OF REQUESTS:
C
C	22,1	SORTS FILE BY COL 1
C	22,4,3,-1	REDUCES FILE TO 3 COLUMNS IF ARG LEGAL
C	22,OK,NK,CODE	CODE OK TO NK APPLYING TRANSFORMATION CODE

	SUBROUTINE STAT22
	DIMENSION TEXT(6)
	DATA TEXT/'SQRT','EXP','ALOG','ALOG10','SQUARE','EQUAL'/
	LOGICAL DEC,ATT
	COMMON /DATA/XL
	DIMENSION XL(1)
	COMMON IAN,KOL1,KOL2,NK,N,IOPT
	COMMON /PARAM/NGU,NGR,LIST,ATT,LDEVE,LDEVL,MISS,NOPAGE
1000	FORMAT(' REDUCED  TO ',I2,' COLUMNS')
2000	FORMAT(' SORTED BY COLUMN ',I2)
3000	FORMAT(' COLUMN ',I2,' IS ',A6,' (COL',I2,')')
	EQUIVALENCE (X,X1),(X2,Y)
	K1=(IABS(KOL1)-1)*N
	K2=(KOL2-1)*N
	I=0
	IF(IOPT)100,200,300
C	REDUCE MATRIX
C	IF(ATT SET)
100	IF(.NOT.ATT)GOTO 999
C	AND IF IOPT=-1 AND KOL1 EQ.NK
	IF(KOL1.NE.NK.OR.IOPT.NE.-1)GOTO 999
C	AND IF 0<KOL2<NK
	IF(KOL2.LE.0.OR.KOL2.GE.NK)GOTO 999
C	OK HE KNOWS WHAT TO DO
	WRITE(LDEVL,1000)KOL2
	NK=KOL2
	RETURN
C
C	SORT BY COL KOL1 IF IT IS A LEGAL COLUMN NR
200	DEC=KOL1.LT.0
	KOL1=IABS(KOL1)
	IF(KOL1.EQ.0.OR.KOL1.GT.NK)GOTO 999
	WRITE(LDEVL,2000)KOL1
	DO 250 I=1,N-1
	DO 240 J=I+1,N
	X1=XL(K1+I)
	X2=XL(K1+J)
	IF(X1.EQ.0)GOTO 205
	IF(.NOT.DEC.AND.X1.LE.X2)GOTO 240
	IF(DEC.AND.X1.GE.X2)GOTO 240
	IF(X2.EQ.0)GOTO 240
205	KOL1=I-N
	KOL2=J-N
	DO 210 K=1,NK
C	TO SAVE SPACE RE-USE THE NOW FREE VARIABLES KOL1,KOL2,IOPT
	IOPT=K*N
	X1=XL(KOL1+IOPT)
	XL(KOL1+IOPT)=XL(KOL2+IOPT)
210	XL(KOL2+IOPT)=X1
240	CONTINUE
250	CONTINUE
	RETURN
C
C	DO TRANSFORMATIONS BUT CHECK FOR LEGALITY
300	I=-1
	IF(IOPT.GT.6)I=0
	IF(KOL1.LE.0.OR.KOL1.GT.NK.OR.KOL2.LE.0
     *.OR.KOL2.GT.10)I=0
	IF (I.NE.0)I=KOL2
	LOGICAL STATER
999	IF(STATER(I,'22'))RETURN
	WRITE(LDEVL,3000)KOL2,TEXT(IOPT),KOL1
	DO 400 I=1,N
	X=0
	Y=XL(K1+I)
	IF(Y.EQ.0)GOTO 355
	GOTO(301,302,303,304,305,306),IOPT
301	IF(Y.GT.0)X=SQRT(Y)
	GOTO 350
302	X=EXP(Y)
	GOTO 350
303	IF(Y.GT.0)X=ALOG(Y)
	GOTO 350
304	IF(Y.GT.0)X=ALOG(Y)/2.302585
	GOTO 350
305	X=Y*Y
	GOTO 350
306	X=Y
350	IF(X.EQ.0)X=1E-10
355	XL(K2+I)=X
400	CONTINUE
	NK=MAX0(NK,KOL2)
C	WE MIGT HAVE PRODUCED SOM MORE MISSING VALUES
	MISS=0
	DO 410 I=1,NK*N
410	IF (XL(I).EQ.0)MISS=MISS+1
	RETURN
	END
