	INTEGER A(50)
	DIMENSION X(8)
	DATA X/10,20,16,17,8,11,15,6/
	DATA N1,N2/4,4/
	NTOT=0
	N=N1+N2
	DO 10 I=1,N1
10	A(I)=I
	M=N1
	GOTO 21
20	A(M)=A(M)+1
21	IF (A(M).GT.N) GOTO 50
	NTOT=NTOT+1
	XT=0
	DO 30 K=1,N1
	XT=XT+X(A(K))
30	CONTINUE
	WRITE(3,1000)XT,(X(A(K)),K=1,N1),NTOT,(A(K),K=1,N1)
1000	FORMAT(F5.0,4F5.0,20I5)
	GOTO 20
50	M=M-1
	IF(M.EQ.0)STOP
	A(M)=A(M)+1
	IF(A(M).GT.N)GOTO 50
	J=0
	DO 55 K=M+1,N1
	J=J+1
55	A(K)=J+A(M)
	M=N1
	GOTO 21
	END
