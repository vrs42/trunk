C	KOLSUM
C	PART OF STAT
C	FILE STAT97
C
C	TABULATES DIFFERENCES IN RANKSUMS FOR APOSTERIORI
C	CONTRASTS FOLLOWING NON-PARAMETRIC ANALYSIS
C
C	ASSUMES THAT XL(IONE) TO XL(IONE+N1*NK)CONTAINS THE
C	RANKS OF THE NK KOLUMNS

	SUBROUTINE KOLSUM(IONE,N1,A)
	COMMON /PARAM/NGU,NGR,LIST,ATT,LDEVE,LDEVL,MISS,NOPAGE
	COMMON /DATA/XL
	DIMENSION XL(1)
	COMMON IAN,KOL1,KOL2,NK,N
	DIMENSION Z(10),Y(10)
	WRITE(LDEVL,3000)A
3000	FORMAT('0 DIFFERENCES BETWEEN KOL. RANK-SUMS, REF TABLE ',A2
     *, ' IN  COLQUHOUN')
	K=IONE-1
	DO 100 I=1,NK
	Z(I)=0
	DO 100 J=1,N1
	K=K+1
100	Z(I)=Z(I)+XL(K)
	WRITE(LDEVL,2000)(I,I=1,NK)
2000	FORMAT (4X,10I10)
	DO 150 I=1,NK
	DO 120 J=1,I
120	Y(J)=Z(I)-Z(J)
150	WRITE(LDEVL,1000)I,(Y(J),J=1,I)
1000	FORMAT (I5,10F10.1)
	RETURN
	END
