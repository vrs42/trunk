C^  FEBRUARY   02    1976
C	STAT7
C	PART OF STAT
C	SHEFFE NO 7
	SUBROUTINE STAT7
	COMMON /DATA/XL
	COMMON IAN,KOL1,KOL2,NK,N,IOPT
	COMMON/SHEFFE/NDC,NDT,XMS,NX(10),XM(10),FLAGS(4)
	LOGICAL FLAGS
C	FLAGS IS USED TO COMMUNICATE TO SHEFFE IF ANALYSIS
C	IS POSSIBLE THEY ARE SET AS FOLLOWS:
C
C		FLAG1	FLAG2	FLAG3	FLAG4
C	STAT0	F	F	F	F
C	STAT1	T	*			*TRUE IF NO MISSING ELSE FALSE
C   STAT1,15	TF	T
C	STAT6			T	F
C	STAT8			F	T IF NO MISSING .OR.FLAG2
C	SHEFFE OPERATES IF
C	1	FLAG3.AND.FLAG1
C  OR	2	FLAG4.AND.FLAG2
C

	DIMENSION XF(3),PROB(3)
	DATA PROB/0.05,0.01,0.001/
	COMMON /PARAM/NGU,NGR,LIST,ATT,LDEVE,LDEVL,MISS,NOPAGE
	LOGICAL ATT
	REAL LINE(10),P(4)
	INTEGER C(10)
1000	FORMAT(1H0,'GR.#   ',10I6)
2000	FORMAT(1H0,I4,6X,10A6)
5000	FORMAT(' SHEFFE ON ',I3,' COLUMNS',//,' MS =',G10.3,
     1'    NDF= ',I3,' /',I4,/,1H ' P-VALUES :',3F7.3)
C#7000	FORMAT(' *** BAD APPROXIMATION FOR THESE NDF''S
C#     * STATE F-VALUES ***')
C#6000	FORMAT(' CALCULATED F-VALUES :',3F7.3)
9000	FORMAT(3F11.00)
3000	FORMAT(1H0,I4,6X,10F6.3)
	DATA P,SPACE,DOT/'N.S.','   *','  **',' ***','      ','   .'/
	NF=IABS(KOL1)
	IF(NF.GT.3.OR.NF.EQ.0)NF=3
	IF(KOL1.NE.0)READ(4,9000)PROB
	IF(.NOT.FLAGS(3).AND..NOT.FLAGS(4))GOTO 150
	IF(FLAGS(3).AND..NOT.FLAGS(1))GOTO 150
	IF(FLAGS(4).AND..NOT.FLAGS(2))GOTO 150
	WRITE(LDEVL,5000)NK,XMS,NDC,NDT,(PROB(I),I=1,NF)
	IF(MIN0(NDC,NDT).LT.2)GOTO 150
C#	DO 200 I=1,NF
C#	IF(KOL1.LT.0)XF(I)=PROB(I)
C#	IF(KOL1.LT.0)GOTO 200
C#	IF(PROB(I).LT.0.OR.PROB(I).GT.0.5)GOTO 150
C#	XF(I)=FINV(PROB(I),NDC,NDT)
C#200	CONTINUE
C#210	WRITE(LDEVL,6000)(XF(I),I=1,NF)
C#	IF(KOL1.GE.0.AND.(NDC.LT.3.OR.NDT.LT.15))WRITE(LDEVL,7000)
	WRITE(LDEVL,1000)(I,I=1,NK-1)
C	THE FOLLOWING LINES MARKED WITC C# ARE FROM STAT VERSION 6
C	THE SUBSTITUTED LINES GIVE A BETTER APPROXIMATION
C#	DO 100 K=1,NK
C#	DO 10 J=1,10
C#	LINE(J)='    '
C#	C(J)=0
C#10	CONTINUE
C#	C(K)=1
C#	DO 50 L=1,NK
C#	H=0
C#	V=0
C#	SV=0
C#	IF(L.LT.K)GOTO 15
C#	IF(L.GT.K) LINE(L)=SPACE
C#	IF (L.EQ.K) LINE(L)=DOT
C#	GOTO 50
C#15	C(L)=-1
C#	IR=NF+1
C#	DO 20 J=1,NK
C#	H=H+C(J)*XM(J)
C#	V=V+C(J)*C(J)*XMS/NX(J)
C#20	CONTINUE
C#30	IR=IR-1
C#	IF(IR.EQ.0) GOTO 35
C#	SV=(NK-1)*XF(IR)
C#	XX=SQRT(SV*V)
C#	U=H+XX
C#	D=H-XX
C#	IF (D*U.LE.0) GOTO 30
C#35	C(L)=0
C#	LINE(L)=P(IR+1)
	DO 100 K=1,NK
	DO 50 J=1,K
	IF(J.EQ.K)LINE(J)=DOT
	IF(J.EQ.K)GOTO 50
	F=XM(K)-XM(J)
	F=F*F/(XMS*(1./NX(K)+1./NX(J))*(NK-1))
	LINE(J)=P(1)
	F=PVALUE(F,NDC,NDT)
	DO 10 I=1,NF
10	IF(F.LT.PROB(I))LINE(J)=P(I+1)
50	CONTINUE
	WRITE(LDEVL,2000)K,(LINE(M),M=1,K)
100	CONTINUE
	WRITE(LDEVL,1000)(I,I=1,NK-1)
	DO 500 I=2,NK
	DO 400 J=1,I-1
	F=(XM(I)-XM(J))
	F=F*F/(XMS*(1./NX(I)+1./NX(J))*(NK-1))
400	LINE(J)=PVALUE(F,NDC,NDT)
500	WRITE(LDEVL,3000)I,(LINE(J),J=1,I-1)
	RETURN
150	X=STATER(0,'7')
	RETURN
	END
