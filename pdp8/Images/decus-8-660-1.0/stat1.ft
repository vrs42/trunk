C	STAT1
C	PART OF STAT
	SUBROUTINE STAT1
C	MEANS SEM AND RANGES	STAT1
C	STAT1 ALSO CHECKS FOR ANY EMPTY COLUMNS AND ADJUSTS
C	NK TO THE MAX NON-EMPTY COLUMN
C	THIS FEATURE MAKES IT POSSIBLE TO ALWAYS REQUEST
C	MAXIMAL COLUMN INPUT IN A FILE WITH VARYING NUMBER OF
C	COLUMNS IF STAT1 IS CALLED FIRST SO WILL ALWAYS THE
C	 COLUMN NUMBER BE CORRECT
	COMMON /PARAM/NGU,NGR,LIST,ATT,LDEVE,LDEVL,MISS,NOPAGE
	COMMON /DATA/XL
	COMMON IAN,KOL1,KOL2,NK,N
C	THE FOLLOWING AREA IS USED BY SHEFFE (STAT7)
C	SEE THAT
	COMMON/SHEFFE/DUM(3),NX(10),XM(10),FLAGS(4)
1000	FORMAT(1H ,I3,2X,G12.5,X,G12.4,2X,I5,3X,G10.3,X,F5.2,
     *,2X,G10.3,2X,G10.3)
2000	FORMAT(' COL. ',4X,'MEAN',6X,'STAND.DEV.',5X,'-N-',
     1,3X,' S E M   ',3X,'CV',5X'MINIMUM',5X,'MAXIMUM')
3000	FORMAT (30X,'  N REDUCED',/,30X,'IF MISSING DATA')
4000	FORMAT(1H ,24X,3H-X-,12X,3H-Y-,11X,4H-XY-,12X,3HX-Y)
5000	FORMAT(4H SUM,11X,4(5X,G10.3))
6000	FORMAT(15H SUM OF SQUARES,2(5X,G10.3),20X,G10.3)
7000	FORMAT(3H N=,I3)
	LOGICAL SKIP,STATER,FLAGS,LMISS
	EQUIVALENCE (FLAGS(2),SKIP)
	DIMENSION XL(1)
	SKIP=KOL1.EQ.15
	K=-1
	IF(KOL1.EQ.0.OR.SKIP)GOTO 5
	IF(KOL1.GT.NK.OR.KOL2.GT.NK)K=0
	IF(STATER(K,'1'))RETURN
	IA=(KOL1-1)*N+1
	IB=(KOL2-1)*N+1
	IF (KOL2.GT.0) GOTO 4
	CALL QSUM(N,1,XL(IA),Z,SUM,SUMQ,NA,D,D,D,D,D)
	WRITE(LDEVL,5000)SUM
	WRITE(LDEVL,6000)SUMQ
	WRITE(LDEVL,7000)NA
	RETURN
4	CALL QSUM(N,2,XL(IA),XL(IB),SUM,SUMQ,NT,SUMY,SUMQY,SUMD
     X,SUMDQ,SUMXY)
	WRITE(LDEVL,4000)
	WRITE(LDEVL,5000)SUM,SUMY,SUMXY,SUMD
	WRITE(LDEVL,6000)SUMQ,SUMQY,SUMDQ
	WRITE(LDEVL,7000)NT
	RETURN
5	WRITE(LDEVL,2000)
	FLAGS(1)=.NOT.FLAGS(2)
	NKT=0
	IF(SKIP)WRITE(LDEVL,3000)
	DO 100 I=1,NK
	S=0
	SS=0
	VMIN=1.E25
	VMAX=-1.E25
	N1=0
	K1=(I-1)*N
	DO 20 J=1,N
	IF(.NOT.SKIP)GOTO 35
	DO 30 K=1,NK
	XT=XL((K-1)*N+J)
	IF(XT.EQ.0)GOTO 20
30	CONTINUE
35	X=XL(K1+J)
	IF(X.EQ.0)GOTO 20
	S=S+X
	SS=SS+X*X
	N1=N1+1
	IF(X.LT.VMIN)VMIN=X
15	IF(X.GT.VMAX)VMAX=X
20	CONTINUE
	FN=N1
	SM=0
	SEM=0
	SD=0
	IF(N1.GT.2)GOTO 21
	VMIN=0
	VMAX=0
	GOTO 100
21	IF (SS.LE.S*S/FN)GOTO 22
	SD=SQRT((SS-S*S/FN)/(FN-1.))
	SEM=SD/SQRT(FN)
22	SM=S/FN
	CV=(SD/SM)*100
	IF(SM.NE.0)CV=0.1E+07
90	WRITE(LDEVL,1000)I,SM,SD,N1,SEM,CV,VMIN,VMAX
	XM(I)=SM
	NX(I)=N1
	IF(I.GT.NKT)NKT=I
100	CONTINUE
C	IF WE REDUCE NK WE SHOULD ALSO REDUCE MISS
	NT=N*NKT
	MISS=0
	DO 200 I=1,NT
	IF(XL(I).EQ.0)MISS=MISS+1
200	CONTINUE
	WRITE(LDEVL,8000)MISS
	NK=NKT
8000	FORMAT(I8,' MISSING DATA')
	FLAGS(2)=SKIP.OR.MISS.EQ.0
	RETURN
	END
