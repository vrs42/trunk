	SUBROUTINE STAT23
	COMMON/PARAM/NGU,NGR,ATT,LDEVE,LDEVL,MISS,NOPAGE
	COMMON IAN,KOL1,KOL2,NK,N
	DIMENSION XL(1)
	LOGICAL STATER
	L=-1
	IF(N.GT.10)L=0
	IF(STATER(L,'23'))RETURN
	WRITE(4,10)N,NK,NK,N
10	FORMAT(' ',I2,' ROWS',I3,' COLUMNS IN'
     */' ',I2,' ROWS',I3,' COLUMNS OUT')
	M=100
	DO 20 I=1,N
	DO 20 J=1,NK
	M=M+1
	XL(M)=XL(((J+1)*N)+I)
20	CONTINUE
	DO 30 I=1,NK*N
	XL(I)=XL(I+100)
30	CONTINUE
	J=N
	N=NK
	NK=J
	RETURN
	END
