C	PROGRAM FOR POLYNOMIAL FIT
C
	COMMON /SPEC/ XBAR,STD,SUMSQ,ISAVE,ANS
	DIMENSION X(175),DI(16),D(28),B(6),E(6),SB(6),T(6),XBAR(7)
	DIMENSION STD(7),COE(7),SUMSQ(7),ISAVE(7),ANS(10),P(120),HEAD(3)
  210	WRITE(4,100)
	READ(4,101) M
	IF(M.EQ.0)CALL EXIT
	WRITE(4,115)
	READ(4,101) NSG
	WRITE(4,116) 
	READ(4,118) NC1,NC2
   17	WRITE(4,114)
   	READ(4,101) N
	IF(N.LE.40) GO TO 3
	WRITE(4,117)
	GO TO 17
  100	FORMAT(1H0,//,5X,"SPECIFY DEGREE OF POLYNOMIAL:  ",$)
  101	FORMAT(I3)
  114	FORMAT(1H0,5X,'NUMBER OF OBSERVATIONS:  ',$)
  115	FORMAT(1H0,5X,'GROUP NUMBER?   ',$)
  116	FORMAT(1H0,5X,'COULUMN NUMBERS:  ',$)
  117	FORMAT(1H0,' ***** TO MANY! ! ! MAX. 40 OBS. ALLOWED. *****')
  118	FORMAT(2I3)
    3	REWIND 6
	READ (6,104) NG,NK,HEAD
  104	FORMAT(2I3,/,3A6)
	CALL DATE (I,J,K)
	K=K-1900
	WRITE(3,106)HEAD,K,I,J
  106	FORMAT(1H1,5X,3A6,2X,'DATE: ',3I2)
	DO 50 I=1,NG
	READ (6,108) DUM
	IF(I.EQ.NSG)SHEAD=DUM
   50	CONTINUE
  108	FORMAT(A6)
	N1=0
	L=N*M
    2	READ(6,110)I,(P(K),K=1,NK)
 110	FORMAT(I3,7(F11.0))
	IF(I.EQ.0)GOTO 4
	IF(I.NE.NSG)GO TO 2
	N1=N1+1
	IF(N1.GT.40) GO TO 4
	J=L+N1
	X(N1)=P(NC1)
	X(J)=P(NC2)
	GO TO 2
   4	WRITE(3,112)SHEAD,N1,N,NC1,NC2
 112	FORMAT(1H0,1X,A6,2H: ,'NUMBER OF ROWS READ:',I3,'  SPECIFIED:',I3,
     1	 '   COLUMNS:',2I5,/)
	CALL GDATA (N,M,X,XBAR,STD,D,SUMSQ)
	MM=M+1
	SUM=0.0
	NT=N-1
	DO 200 I=1,M
	ISAVE(I)=I
	CALL ORDER (MM,D,MM,I,ISAVE,DI,E)
	CALL MINV (DI,I,DET,B,T)
	CALL MULTR(N,I,DI,E,B,SB,T)
	WRITE (3,5) I
	IF(ANS(7)) 140,130,130
  130	SUMIP=ANS(4)-SUM
	IF(SUMIP) 140,140,150
  140	WRITE (3,13)
	GO TO 220
  150	WRITE (3,6) ANS(1)
	WRITE (3,7) (B(J),J=1,I)
	WRITE (3,8) I
	WRITE (3,9)
	SUM=ANS(4)
	WRITE (3,10) I,ANS(4),ANS(6),ANS(10),SUMIP
	NI=ANS(8)
	WRITE (3,11) NI,ANS(7),ANS(9)
	WRITE (3,12) NT,SUMSQ(MM)
	WRITE(3,16) SUMIP
   16	FORMAT(1H0,5X,'INPROVEMENT IN SUM OF SQUARES: ',F10.5,//)
	COE(1)=ANS(1)
	DO 160 J=1,I
  160	COE(J+1)=B(J)
	LA=I
  200	CONTINUE
  220	NP3=N+N
	DO 230 I=1,N
	NP3=NP3+1
	P(NP3)=COE(1)
	L=I
	DO 230 J=1,LA
	P(NP3)=P(NP3)+X(L)*COE(J+1)
  230	L=L+N
	N2=N
	L=N*M
	DO 240 I=1,N
	P(I)=X(I)
	N2=N2+1
	L=L+1
  240	P(N2)=X(L)
	WRITE (3,5) LA
	WRITE (3,14)
	NP2=N
	NP3=N+N
	DO 250 I=1,N
	NP2=NP2+1
	NP3=NP3+1
	RESID=P(NP2)-P(NP3)
  250	WRITE (3,15) I,P(I),P(NP2),P(NP3),RESID
	GO TO 210
    5	FORMAT(32H0POLYNOMIAL REGRESSION OF DEGREE,I3)
    6	FORMAT(12H0 INTERCEPT,F12.6)
    7	FORMAT(26H0 REGRESSION COEFFICIENTS,//,(6F12.6))
   8	FORMAT(1H0,15X,'ANALYSIS OF VARIANCE FOR ',I2,
     1   ' DEGREE POLYNOMIAL',/)
    9	FORMAT(1H0,5X,19HSOURCE OF VARIATION,7X,9HDEGREE OF,7X,6HSUM OF,
     1	9X,4HMEAN,10X,1HF,9X,20HINPROVEMENT IN TERMS/33X,7HFREEDOM,
     2	8X,7HSQUARES,7X,6HSQUARE,7X,5HVALUE,8X,17HOF SUM OF SQUARES)
   10	FORMAT(20H0 DUE TO REGRESSION,12X,I6,F17.5,F14.5,F13.5,F20.5)
   11	FORMAT('   DEVIATION ABOUT REGRESSION   ',I6,F17.5,F14.5)
   12	FORMAT(8X,5HTOTAL,19X,I6,F17.5///)
   13	FORMAT(16H0 NO IMPROVEMENT)
   14	FORMAT(1H0//27X,18HTABLE OF RESIDUALS//16H OBSERVATION NO.,5X,
     1	'X VALUE',7X,'Y VALUE',7X
     2	,'Y ESTIMATE',7X,'RESIDUAL')
   15	FORMAT(1H0,3X,I6,F18.5,F14.5,F17.5,F15.5)
	END
