C^  APRIL   15    1975
C	BIGLIS
C	LISTMODULE TO THE BIGSTA PROGRAM
	SUBROUTINE BIGLIS
	COMMON /PARAMS/DEV4,NG,NK,CURGR,TEMP(5),NREK,NKOL,ONEOR
     *,NPAR,AUTO,IFILL
	COMMON NALL(20),NIND(20),HEAD(12),AND(10),INS(10),LIM(2,10)
     *,KOLS(10),ALL,KOL(10)
	INTEGER DEV
	LOGICAL ALL,ONEOR,INS,AND,IFILL
C	DEFINE UNIT FOR OUTPUT
	DEV=TEMP(1)
	WRITE(DEV,1000)NG,NK,CURGR
1000	FORMAT(' OUTPUT FILE TO CONTAIN ',I3,' GROUPS  AND ',I3,'
     * COLUMNS',/,' PRESENT GROUP IS ',I3)
	IF(ALL)WRITE(DEV,1100)
1100	FORMAT(' ALL INPUT RECORDS CONSIDERED')
	IF (ALL)GOTO 50
	LOGICAL L
	L=.TRUE.
	DO 10 I=1,20,2
	IF(NALL(I).EQ.0)GOTO 20
	IF(L)WRITE(DEV,1250)
1250	FORMAT(' RECORDS BETWEEN :')
	L=.FALSE.
10	WRITE(DEV,1200)NALL(I),NALL(I+1)
1200	FORMAT(I5,' TO',I5)
20	DO 30 I=1,20
	I1=I
	IF(NIND(I).EQ.0)GOTO 40
30	CONTINUE
40	I1=I1-1
	IF(I1.EQ.0)GOTO 50
	WRITE(DEV,1400)(NIND(I),I=1,I1)
1400	FORMAT(' ALSO RECORDS NO :',/,1X,20I4)
50	IF(KOL(1).EQ.0)GOTO 80
	WRITE(DEV,1350)
1350	FORMAT(' COLUMNS SPECIFIED:')
	DO 70 I=1,10
	IF(KOL(I).EQ.0.OR.KOL(I).EQ.86)GOTO 70
1450	FORMAT(2I6)
	WRITE(DEV,1450)I,KOL(I)
70	CONTINUE
	IF(IFILL)WRITE(DEV,1470)NK
1470	FORMAT(' COLUMN NR ',I4,' IS RECORD NO')
80	IF(NPAR.EQ.0)RETURN
	WRITE(DEV,1500)
1500	FORMAT(' LIMITS SPECIFIED')
 	ALIST='(OR)'
	IF(ONEOR)ALIST='     '
	DO 100 I=1,NPAR
	IF(I.GT.1)ALIST='     '
	BLIST='   OUT'
	IF(INS(I))BLIST='    IN'
	CLIST=' OR'
	IF(AND(I))CLIST=' AND'
100	WRITE(DEV,1600)KOLS(I),(LIM(J,I),J=1,2),BLIST,CLIST,ALIST
1600	FORMAT(' KOL: ',I3,' FROM ',F7.2,' TO',F7.2,A6,'SIDE LIMITS ',
     *2A6)
	RETURN
	END
