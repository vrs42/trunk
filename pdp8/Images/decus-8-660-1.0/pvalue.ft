C^  JANUARY   21    1976
	FUNCTION PVALUE(GIJ,M,N)
	G=ABS(GIJ)
	IF(G.LE.0)GOTO 999
	IF(M.GT.0)GOTO 10
	G=G*G
	M=1
10	P=1.
	IF(G.LT.1.)GOTO 20
	IA=M
	IB=N
	F=G
	GOTO 30
20	IA=N
	IB=M
	F=1./G
30	B=IB
	A1=2./(9.*IA)
	B1=2./(9.*IB)
	Z=ABS((1.-B1)*F**0.333333-1.+A1)
	Z=Z/SQRT(B1*F**0.666667+A1)
	IF(IB.LT.4.) Z=Z*(1.+0.08*Z**4/B**3)
	P=(1.+Z*(0.196854+Z*(0.115194+Z*(0.000344+Z*0.019527))))**4
	P=0.5/P
	IF(G.LT.1.)P=1.-P
	PVALUE=AINT(100000.*P)/100000.
999	RETURN
	END
