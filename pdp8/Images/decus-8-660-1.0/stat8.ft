C	STAT8
C	PART OF STAT
	SUBROUTINE STAT8
	COMMON/DATA/XL
	COMMON /PARAM/NGU,NGR,LIST,ATT,LDEVE,LDEVL,MISS,NOPAGE
	COMMON IAN,KOL1,KOL2,NK,N
	COMMON/SHEFFE/NDC,NDE,MSE,DUM(20),FLAGS(4)
	LOGICAL FLAGS
	DIMENSION SK(10),X2(10),XL(1)
	REAL MSR,MSE,MSC
1000	FORMAT(' ANOVA TWO SIDED',/,
     1' SOURCE',5X,'SS',8X,'DF',6X,'MS',14X,'F',14X,'P',/,
     2' ROWS   ',3X,G10.3,I5,2(3X,G10.3),3X,F10.3,/,
     3' COLS   ',3X,G10.3,I5,2(3X,G10.3),3X,F10.3,/,
     4' ERROR  ',3X,G10.3,I5,3X,G10.3,/,
     5' TOTAL  ',3X,G10.3,I5)
1200	FORMAT(' ERROR IN ANOVA <EMPTY COL>')
	SR=0
	N1=0
	ST=0
	XT=0
	FLAGS(3)=.FALSE.
	FLAGS(4)=.FALSE.
	DO 10 J=1,10
10	SK(J)=0
	DO 100 I=1,N
	SRX=0
	DO 20 J=1,NK
	X1=XL((J-1)*N+I)
	IF(X1.EQ.0)GOTO 100
20	X2(J)=X1
	DO 30 J=1,NK
	SK(J)=SK(J)+X2(J)
	SRX=SRX+X2(J)
	XT=XT+X2(J)
30	ST=ST+X2(J)*X2(J)
	SR=SRX*SRX/NK+SR
	N1=N1+1
100	CONTINUE
	IF(N1.LE.2)GOTO 500
	SC=0
	DO 150 I=1,NK
150	SC=SC+SK(I)*SK(I)/N1
	NT=N1*NK
	CT=XT*XT/NT
C	DEBUGS
C	WRITE(0,1010)ST,SR,SC,NT,CT,SK
C1010	FORMAT(1H ,5G12.5)
	SR=SR-CT
	SC=SC-CT
	ST=ST-CT
	SE=ST-SR-SC
	NDR=N1-1
	NDC=NK-1
	NDT=NT-1
	NDE=NDT-NDR-NDC
	MSR=SR/NDR
	MSC=SC/NDC
	MSE=SE/NDE
	FR=MSR/MSE
	FC=MSC/MSE
	PR=PVALUE(FR,NDR,NDE)
	PC=PVALUE(FC,NDC,NDE)
	WRITE(LDEVL,1000)SR,NDR,MSR,FR,PR,SC,NDC,MSC,FC,
     1 PC,SE,NDE,MSE,ST,NDT
	FLAGS(4)=.TRUE.
	RETURN
500	WRITE(LDEVE,1200)
	RETURN
	END






