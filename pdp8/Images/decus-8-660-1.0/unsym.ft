C	UNSYMMETRIC ANALYSIS OF VARIANSE
C	ACCORDING TO SNEDECOR'FITTING OF CONSTANTS'
C	INPUT
C	OUTLAY FILE
C	MAIN HEADING IGNORED
C	THEN NUMBER OF ROWS,COLUMNS AND
C	REPLICATES(MAX)ON EACH 3 FOLLOWING
C	THE DATA AS FOR SYMMETRIC ANOVA BUT MISSINGA DATA =0
C	
C	
C	VARIABLES
C	NK AND NR ARE SET TO 10	ORIGINALLY
C	NAME	DIMENSION	USAGE
C	X	1000	HOLDS INPUT DATA
C	NR	1		ROWS
C	NK	1		COLUMNS
C	N	NR,NK	NUMBER/CELL
C	S	"		SUM/CELL
C	Q	"		SUM SQUARE/CELL
C	SR	NR	SUM OF THE ROW
C	SQ	NR	SUM OF THE COL
C	NT	TOTAL NO OBSERVATIONS
C	ST			TOTAL SUM X
C	QT			TOTAL SUM X*X
C	QS	SUBGR*SUBGR/N
C	CT	CORRECTION TERM
C	QRW	SUM2 ROWS
C	QCO	SUM2 COLMS
C	SSR	SUM SQUARE ROWS
C	NDR	DEGREES OF FREEDOM ROWS
C	MSR	MEAN SQUARE ROWS
C	FR	F-VALUE ROWS
C	FR	F VALUE ROWS
C		AND EQUIVALENT C I W T
C	
C	
	DIMENSION X(1000),N(10,10),SC(10),SR(10),A(100)
	DIMENSION S(10,10),SS(10,10)
	DIMENSION B(10),V(10),B2(10),NTR(10),NTC(10)
	LOGICAL LAST
	DATA N,SC,SR,NTR,NTC,NT,ST,QT,QRW,QCO/145*0/
	DATA X/1000*0/
C
C
1000	FORMAT(2I3,/,A6)
1100	FORMAT(I3)
1200	FORMAT(A6)
1400	FORMAT(3X,(7E11.4))
1750	FORMAT('1PRELIMINARY ANOVA')
1700	FORMAT('0SOURCE',13X,'SS',12X,' DF',12X,' MS',18X,'F',
     */,' ROWS',F22.2,I8,F20.2,F20.4/,,' COLUMNS',F19.2,I8,F20.2,F20.4
     *,/,' INTERACTION',F15.2,I8,F20.2,F20.4,
     */,' GROUPS ',F19.2,I8,F20.2,
     *,/' WITHIN',F20.2,I8,
     *,/,' TOTAL',F21.2,I8)
1800	FORMAT(' FACTORS:',/,15X,10G15.5)
1900	FORMAT(1X,11G15.5)
2300	FORMAT('0 GRAND MEAN:',G15.5,3X,'REDUCTION',G15.5)
2100	FORMAT('0FINAL ANOVA')
2200	FORMAT('0 CONSTANTS AND ADJUSTED MEANS :',/,16X,10G15.5)
	REAL MSR,MSC,MSW,MSI,MSG
	READ(6,1000)NGI,NKI,Z
	READ(6,1100)NR,NK,NP
	J=NGI-3
	IF(J.LE.0)GOTO 10
	READ(6,1200)(X(K),K=1,J)
10	NTOT=NR*NK*NP
	J=1
	L=NR*NK
	M=1
	DO 100 K=1,L
60	K1=J+NKI-1
	IF(K1.GT.M*NP)K1=M*NP
	READ(6,1400)(B(I),I=1,NKI)
	K2=0
	DO 70 I=J,K1
	K2=K2+1
70	X(I)=B(K2)
	J=K1+1
	IF(J.LT.(K)*NP)GOTO 60
100	M=M+1
	L=0
	DO 200 I=1,NR
	DO 190 J=1,NK
	NTEMP=0
	STEMP=0
	SST=0
	DO 180 K=1,NP
	L=L+1
	IF(X(L).EQ.0)GOTO 180
	NTEMP=NTEMP+1
	XT=X(L)
	STEMP=STEMP+XT
	SST=SST+XT*XT
180	CONTINUE
	IF(NTEMP.EQ.0)STOP
	NTR(I)=NTR(I)+NTEMP
	SR(I)=SR(I)+STEMP
	NTC(J)=NTC(J)+NTEMP
	SC(J)=SC(J)+STEMP
	N(I,J)=NTEMP
	S(I,J)=STEMP
	SS(I,J)=SST
	NT=NT+NTEMP
	ST=ST+STEMP
	QT=QT+SST
190	CONTINUE
	QRW=QRW+SR(I)*SR(I)/NTR(I)
200	CONTINUE
	CT=ST*ST/NT
	SSUB=0
	QCO=0
	DO 220 I=1,NK
	TEMP=0
	DO 210 J=1,NR
	SSUB=SSUB+S(J,I)*S(J,I)/N(J,I)
210	TEMP=TEMP+S(J,I)
220	QCO=QCO+TEMP*TEMP/NTC(I)
	SST=QT-CT
	SSR=QRW-CT
	SSC=QCO-CT
	SSUB=SSUB-CT
	SSW=SST-SSUB
	SSI=SSUB-SSR-SSC
	NDR=NR-1
	NDC=NK-1
	NDT=NT-1
	NDI=NDR*NDC
	NDSUB=NR*NK-1
	NDW=NT-NR*NK
	LAST=.FALSE.
	WRITE(3,1750)
230	MSR=SSR/NDR
	MSC=SSC/NDC
	MSI=SSI/NDI
	MSW=SSW/NDW
	FR=MSR/MSW
	FC=MSC/NDC
	FI=MSI/MSW
	WRITE(3,1700)SSR,NDR,MSR,FR,SSC,NDC,MSC,FC,SSI
     *,NDI,MSI,FI,SSW,NDW,MSW,SSUB,NDSUB,SST,NDT
	IF(LAST)STOP
C	CALCULATE FACTORS
	DO 300 I=1,NK
	S1=0
	DO 280 J=1,NK
	S2=0
	DO 250 K=1,NR
	S2=S2+FLOAT(N(K,I)*N(K,J))/NTR(K)
	IF(J.EQ.1)S1=S1+N(K,I)*SR(K)/NTR(K)
250	CONTINUE
	S1=S1-SC(I)
	IF(I.EQ.J)S2=S2-NTC(I)
	IF(J.EQ.1)B(I)=S1
	L=(I-1)*NK+J
	A(L)=S2
280	CONTINUE
300	CONTINUE
	DO 290 I=1,NK
	J=(I-1)*NK+1
290	A(J)=1
	B(1)=0
	CALL SIMQ(A,B,NK,IER)
	IF(IER.GT.1)PAUSE 1
	S1=0
	DO 320 I=1,NR
	STEMP=SR(I)/NTR(I)
	DO 310 J=1,NK
310	STEMP=STEMP-N(I,J)*B(J)/NTR(I)
	B2(I)=STEMP
320	S1=S1+S
	S1=S1/NR
	RED=-CT
	DO 340 I=1,NR
	RED=RED+B2(I)*SR(I)
340	CONTINUE
	DO 350 I=1,NK
	RED=RED+B(I)*SC(I)
350	CONTINUE
	CT=SSR+SSC-RED
	SSR=SSR-CT
	SSC=SSC-CT
	STOT=ST/NT
	WRITE(3,2200)(B(I),I=1,NK)
	DO 380 I=1,NR
	DO 360 J=1,NK
360	V(J)=B(J)+B2(I)
380	WRITE(3,1900)B2(I),(V(K),K=1,NK)
	WRITE(3,2300)STOT,RED
	WRITE(3,2100)
	LAST=.TRUE.
	GOTO 230
	END

