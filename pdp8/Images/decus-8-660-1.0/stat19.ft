C	STAT19
C	PART OF STAT
C	IF KOL1=0 GIVES MEDIANS OF ALL KOL
C	IF MISS<>0 ALSO MEDIANS FOR 'ADJUSTED'ROWS
C	IF KOL1 <>0 PRINTS THE RANKS FOR THE OBSERVATIONS IN KOL1
	SUBROUTINE STAT19
	COMMON /DATA/XL
	COMMON IAN,KOL1,KOL2,NK,N
	COMMON /SIZE/MAXXL
	COMMON /PARAM/NGU,NGR,LIST,ATT,LDEVE,LDEVL,MISS,NOPAGE
	DIMENSION XL(1),P(10)
1000	FORMAT('0MEDIANS =',/,1X,10G13.4)
2000	FORMAT('0TIESUM 1=',F8.1,'  TIESUM 2=',F8.1)
3000	FORMAT('0     X',10X,'RANK')
4000	FORMAT(1H ,G13.4,F8.1)
	NT=N*NK
	LOGICAL STATER
	IF(STATER(2,'19'))RETURN
	IF(KOL1.NE.0)GOTO 210
	DO 205 IL=1,2
	DO 200 I=1,NK
	IF(IL.EQ.2.AND.MISS.EQ.0)GOTO 205
	N1=0
	DO 2 J=1,N
	X1=XL((I-1)*N+J)
	IF (X1.EQ.0)GOTO 2
	IF(IL.EQ.1)GOTO 1
	DO 3 K=1,NK
	IF(XL((K-1)*N+J).EQ.0)GOTO 2
3	CONTINUE
1	N1=N1+1
	XL(NT+N1)=X1
2	CONTINUE
	DO 10 J=1,N1
	DO 10 K=J,N1
	IF(XL(NT+J).LE.XL(NT+K))GOTO 10
	XT=XL(NT+J)
	XL(NT+J)=XL(NT+K)
	XL(NT+K)=XT
10	CONTINUE
	K=(N1+1)/2
	L=(N1+2)/2
	P(I)=(XL(NT+K)+XL(NT+L))/2.
200	CONTINUE
	WRITE(LDEVL,1000)(P(I),I=1,NK)
205	CONTINUE
20	RETURN
210	N1=0
	DO 100 J=1,N
	X1=XL((KOL1-1)*N+J)
	IF(X1.EQ.0)GOTO 100
	N1=N1+1
	XL(NT+N1)=X1
100	CONTINUE
	CALL RANK(XL(NT+1),XL(NT+N+1),N1)
	DO 110 I=1,2
110	CALL TIE(XL(NT+N+1),N1,I,P(I))
	WRITE(LDEVL,2000)P(1),P(2)
	WRITE(LDEVL,3000)
	DO 600 I=1,N1
600	WRITE(LDEVL,4000)XL(NT+I),XL(NT+N+I)
	RETURN
	END
