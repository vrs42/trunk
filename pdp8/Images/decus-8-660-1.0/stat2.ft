C	STAT2
C	PART OF STAT
	SUBROUTINE STAT2
	DIMENSION XL(1)
	COMMON /DATA/XL
	COMMON IAN,KOL1,KOL2,NK,N,IOPT
	COMMON /PARAM/NGU,NGR,LIST,ATT,LDEVE,LDEVL,MISS,NOPAGE
1200	FORMAT(' T-TEST TYPE ',I5,' BETWEEN',2I5,
     1' FAILED'/' NUMBERS IN THE COL:'2I5)
1000	FORMAT(' T-TEST TYPE :',I2,' BETWEEN ',I3
     1,' &', I3,'  T=',F6.3,'   2*P=',F6.3,'  D.F.=',I5)
	ANS=0
	IA=(KOL1-1)*N+1
	IB=(KOL2-1)*N+1
	IF(IOPT.GT.2)GOTO 100
	IF(IOPT.LE.0)GOTO 200
	CALL QSUM(N,1,XL(IA),Z,S1,S2,NA,D,D,D,D,D)
	CALL QSUM(N,1,XL(IB),Z,S3,S4,NB,D,D,D,D,D)
	IF(NA.LE.2.OR.NB.LE.2)GOTO 200
	AMEAN=S1/NA
	BMEAN=S3/NB
	SA=(S2-S1*S1/NA)/(NA-1)
	SB=(S4-S3*S3/NB)/(NB-1)
	GOTO(10,20),IOPT
10	NDF=NA+NB-2
	S=SQRT(((NA-1)*SA+(NB-1)*SB)/NDF)
	ANS=((BMEAN-AMEAN)/S)*(1./SQRT(1./NA+1./NB))
	GOTO 90
20	ANS=(BMEAN-AMEAN)/SQRT(SA/NA+SB/NB)
	A1=(SA/NA+SB/NB)**2
	A2=(SA/NA)**2./(NA+1)+(SB/NB)**2./(NB+1)
	NDF=A1/A2-2.0+0.5
	GOTO 90
100	IF(IOPT.NE.3)GOTO 200
	CALL QSUM(N,2,XL(IA),XL(IB),D,D,NB,D,D,S1,S2,D)
	IF(NB.LE.2)GOTO 200
	SD=SQRT((S2-S1*S1/NB)/(NB-1))
	SD=SD/SQRT(NB)
	ANS=(S1/NB)/SD
	NDF=NB-1
90	M=0
	P=PVALUE(ANS,M,NDF)
	WRITE(LDEVL,1000)IOPT,KOL1,KOL2,ANS,P,NDF
	RETURN
200	WRITE(LDEVE,1200)IOPT,KOL1,KOL2,NA,NB
	RETURN
	END
