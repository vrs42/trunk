C	STAT4
C	PART OF STAT
	SUBROUTINE STAT4
	COMMON /PARAM/NGU,NGR,LIST,ATT,LDEVE,LDEVL,MISS,NOPAGE
C	BARTLETTS 3-GROUP REGRESSION LINE SE SOKAL PAGE 483
	COMMON /DATA/XL
	COMMON IAN,KOL1,KOL2,NK,N,IOPT
	DIMENSION XL(1)
	LOGICAL STATER
	INTEGER Y1,Y0,X0
	DIMENSION PROBT(3),T(3),SUM(3),SUMY(3),K(3),K2(4)
	DATA K2/4*0/

	DATA PROBT,S1,S2,S3,S4,S5,S6,S7,S8/0.05,0.01,0.001,8*0/
1000	FORMAT(' BARTLETTS 3-GROUP REGRESSION KOLUMNS ',I3,' 
     */ ',I3,/,1H ,
     *  'Y=',G15.4,'+X*',G15.5)
2000	FORMAT(3F10.0)
3100	FORMAT(' CONFIDENCE LIMITS FOR B :')
3000	FORMAT(' AT P='F6.3,'
     *  UPPER=',G11.4,'LOWER=',G11.5,'CALC. T =',F7.2)
4000	FORMAT(' IMPOSSIBLE AT P=',F8.4)
	IF(STATER(2,'4'))RETURN
	NT=N*NK
	X0=NT+1
	Y0=NT+N+1
	Y1=Y0-1
	CALL MOVE(NT)
	I=-1
	IF(NT.LT.9)I=0
	IF(STATER(I,'4'))RETURN
	CALL SORT(NT)
	K(1)=NT/3
	IF(NT-K(1)*3.EQ.2)K(1)=K(1)+1
	K(3)=K(1)
	K(2)=NT-K(1)-K(3)
	K2(2)=K(1)
	K2(3)=K(1)+K(2)
	DO 200 I=1,3
	CALL QSUM(K(I),2,XL(X0+K2(I)),XL(Y0+K2(I)),SUM(I),
     * S1A,L,SUMY(I),S2A,D,D,S3A)
	S1=S1+S1A
	S2=S2+S2A
	S3=S3+S3A
	S4=S4+SUM(I)*SUM(I)/K(I)
	S5=S5+SUMY(I)*SUMY(I)/K(I)
	S6=S6+SUM(I)*SUMY(I)/K(I)
	S7=S7+SUM(I)
	S8=S8+SUMY(I)
200	CONTINUE
	B=(SUMY(3)-SUMY(1))/(SUM(3)-SUM(1))
	A=S8/NT-B*S7/NT
	WRITE(LDEVL,1000)KOL1,KOL2,A,B
	NZ=IOPT
	IF(NZ.LE.0.OR.NZ.GT.3)NZ=3
	IF(IOPT.GT.0)READ(4,2000)PROBT
	WRITE(LDEVL,3100)
	DO 300 I=1,NZ
	IF(PROBT(I).LT.0.OR.PROBT(I).GT.0.5)GOTO 900
300	T(I)=TINV(PROBT(I)/2.,NT-3)
	S3=S3-S6
	S1=S1-S4
	S2=S2-S5
	S6=(SUM(1)-SUM(3))*(SUM(1)-SUM(3))*(NT-3)/FLOAT(2*K(1))
	DO 400 I=1,NZ
	C=S6/T(I)/T(I)
	A=C*(B*B*S1+S2-2.*B*S3)-S1*S2-S3*S3
	IF(A.GT.0)GOTO 320
	WRITE(LDEVL,4000)PROBT(I)
	GOTO 400
	REAL LOWER
320	A=SQRT(A)
	UPPER=(B*C-S3+A)/(C-S1)
	LOWER=(B*C-S3-A)/(C-S1)
	WRITE(LDEVL,3000)PROBT(I),UPPER,LOWER,T(I)
400	CONTINUE
	RETURN
900	A=STATER(0,'4')
	RETURN
	END
