C^  AUGUST   29    1977
C	***OUTLAY***
C	UPDATED TO USE LINPUT
C	BUT RE-UPDATED TO USE FRTS AFTER JIM C MODIFICATIONS
C	MUST HAVE FRTS VERSION NX FOR USAGE
C	UNIT NUMBERS
C	OUTPUT FILE 5
C	LISTS > 3 LINES UNIT 3
C
C	VERSION 4 /A LOGIC IMPLEMENTED
C	TTY INPUT OUTPUT UNIT 4
C	OTHER INPUT UNIT NUMBERS 6-9 CAN USED
	LOGICAL ONEGR,KEYBRD,SLASHA
C	KEYBRD IS SET TO TRUE ON TTY INPUT(UNIT 4) AFTR WHICH NO
C	FILE INPUT ALLOWED
	DATA KEYBRD/.FALSE./
C*****
	DATA VERSIO/4.1/
C****
CINITIALIZE VARIABLES FOR A POSSIBLE /A LOGIC
	DATA INDEV,NG,NT,NGROUP/0,1,10,1/
	DIMENSION V(12),IG(100)
	DIMENSION X(100,10),RUBRIK(12),TEXT(100,3)
	DATA X/1000*0/
3000	FORMAT('1OUTLAY VERSION 'F5.2' ON  ',I4,2('-',I2))
3200	FORMAT(' BAD INPUT LINE TRY AGAIN')
1910	FORMAT(' FILE CONTAINS MORE GROUPS THAN INPUT',
     1/'I WILL IGNORE EXXESSIVE')
C2200	FORMAT(' ONLY 1 GROUP PER INPUT <UNFORMATED>')
2300	FORMAT(' GROUP NR <=',I5,2X,':',$)
2400	FORMAT(' INPUT X-VALUES FOR GROUP ',I5
     *,'  AND FINISH WITH EOF<^Z>')
2010	FORMAT(2I3,15F10.0)
2000	FORMAT(11F10.0)
1900	FORMAT(' TOTAL ',I5,' ROWS',/,' I WILL CALL OS/8 MONITOR')
995	FORMAT(' WRONG !')
1950	FORMAT(' ENTER GROUP NR AND X VALUES',' END WITH BLANK LINE')
1800	FORMAT(' NEW INPUT ?')
1810	FORMAT(' ONLY TTY (UNIT 4) ALLOWED ',$)
1820	FORMAT(' [TTY=4;OTHERS STATE UNIT NR ] ',$)
1700	FORMAT(I3,(7E11.4))
1600	FORMAT(' INPUT DATA END',/,I4,' ROWS TOTAL',I6,' ROWS IN BUFFER')
1500	FORMAT(' ERRORS ? ',/,' ROW,COL,VALUES...<END=ROW 0>')
1320	FORMAT(I4,I3,10G12.4)
1300	FORMAT(I4,I3,9F7.2,/,1H ,2F10.2)
1350	FORMAT(' LIST ?<0/1> ',$)
1200	FORMAT(' CURRENT BUFFER FULL [=',I4,' ROWS]')
1000	FORMAT(12A6)
1201	FORMAT(A3)
1002	FORMAT(' INPUT FILE UNIT NO <0 IF NONE> ? ',$)
1100	FORMAT(3I3)
1004	FORMAT (' UNIT ' $)
1001	FORMAT(' WAIT')
990	FORMAT(' NOTE !!'/' YES(JA) =1  (>1)',/
     1,' NO(NEJ) =0  (BLANK LINE)')
901	FORMAT('0 STATE NO OF GROUPS AND NO OF COLUMNS')
902	FORMAT(' MAIN HEADING :')
903	FORMAT(I5,'  GROUP HEADINGS ON SEPERATE LINES')
2500	FORMAT(' GROUP NR ',I5)
900	FORMAT(' HEADINGS & GROUPS FROM UNIT NR '$)
	CALL CMDOPT(0,SLASHA)
	CALL DATE(IM,ID,IY)
	WRITE(0,3000)VERSIO,IY,IM,ID
C	INITIALIZING READING NK FROM TTY OR FILE
C	LOOPNR CONTROLS THE EXECUTION OF THE -6,0 SYNTAX
	DATA MAXR,LOOPNR/100,0/
	LOGICAL NEWPAG
	DATA ONEGR,NEWPAG/2*.FALSE./
3	WRITE(4,990)
	IF(.NOT.SLASHA)GOTO 35
	WRITE(4,900)
	CALL CHKEOF(ERR)
	READ(4,1700)INDEV
	IF(ERR.NE.0)GOTO 3
7	IF(INDEV.NE.0.AND.INDEV.NE.4)GOTO 1
35	WRITE(4,901)
1	CALL CHKEOF(ERR)
	READ(INDEV,1100)NG,NT
	IF(ERR.NE.0)GOTO 7
	IF(NG.LE.MAXR.AND.NT.LE.10)GOTO 8
	WRITE(4,995)
	GOTO 1
C	READING HEADINGS
8	IF(INDEV.EQ.4.OR.INDEV.EQ.0)WRITE(4,902)
	READ(INDEV,1000)RUBRIK
	IF(INDEV.EQ.0)GOTO 11
	IF(INDEV.EQ.4)WRITE(4,903)NG
	DO 10 I=1,NG
10	READ(INDEV,1000)(TEXT(I,J),J=1,3)
	REWIND INDEV
11	IST=1
	NCUR=0
	NTOT=0
	WRITE(4,1001)
	WRITE(5,1100)NG,NT
	WRITE(5,1000)RUBRIK
	DO 12 I =1,NG
	IF(INDEV.EQ.0)WRITE(5,2500)I
	IF(INDEV.NE.0)WRITE(5,1000)(TEXT(I,J),J=1,3)
12	CONTINUE
	IF (.NOT.SLASHA)GOTO 100
C	NOW HANDLE ANY POSSIBLE INPUT FILE
15	WRITE(4,1002)
	CALL CHKEOF(ERR)
	READ(4,1100)INDEV,NGROUP
	IF(ERR.NE.0)GOTO 15
	IF(IABS(INDEV).EQ.4)GOTO 10300
	IF(INDEV.LE.5)GOTO 100
	WRITE(4,1001)
	READ(INDEV,1100)NGF,NTF
	IF(NGF.GT.NG)WRITE(4,1910)
	K=NGF+1
	READ(INDEV,1201)(V(I),I=1,K)
40	READ(INDEV,1700)I,(V(J),J=1,NTF)
	IF(I.LE.0)GOTO 90
	IF(I.GT.NG)GOTO 40
	NTOT=NTOT+1
	NCUR=NCUR+1
	DO 25 J=1,NTF
25	X(NCUR,J)=V(J)
	IG(NCUR)=I
	IF(NCUR.LT.MAXR)GOTO 40
200	IST=2
201	WRITE(4,1200)NCUR
C	WE GET HERE
C	1 ON FULL BUFFER AND 2 ON INPUT END <FILE OR UNFORMATED>
C	IST=
C	1	ON BUFFER FULL IN FILE
C	2	ON INPUT FILE END <BUT MAYBE MIORE TO COME>
C	3	ON UNFORMATED INPUT END
C	4	SET AT /A LOGIC EXITS AFTER ONE INPUT ROUND
C	FIRST HANDLE LISTS
C	LISTS LONGER THAN 3 LINES TO UNIT 3
C	DEFAULTS FOR LIST ARE FROM 1 TO NCUR
205	WRITE(4,1350)
	CALL CHKEOF(ERR)
	READ(4,1100)K,L,I
	IF(ERR.NE.0)GOTO 205
	IF(K.LE.0)GOTO 300
	IF(L.EQ.0)L=NCUR
	IF(I.GT.0)GOTO 230
	DO 250 I=K,L
250	WRITE(4,1300)I,IG(I),(X(I,J),J=1,NT)
	GOTO 300
230	IF(NEWPAG)GOTO 231
	WRITE(3,3000)VERSIO,IY,IM,ID
	NEWPAG=.TRUE.
231	DO 235 I=K,L
235	WRITE(3,1320)I,IG(I),(X(I,J),J=1,NT)
C	NOW HANDLE ANY ERRORS IN DATA
300	WRITE(4,1500)
	IM=1
315	CALL CHKEOF(ERR)
	READ(4,2010)I,K,V
	IF(ERR.EQ.0)GOTO10315
	WRITE(4,3200)
	GOTO 315
C	I=0 END OF CORRECTIONS
10315	IF(I.LE.0)GOTO(400,205),IM
	IM=2
	IF(I.GT.NCUR)GOTO 399
C	K=0 CORRECTION TO GROUP NR
	IF(K.GT.0)GOTO 340
	L=V(1)
C	IF K>0 & V(1)=0 REMOVE(ZERO)THE LINE
	IF(L.GT.0)GOTO 310
	DO 320 J=1,NT
320	X(I,J)=0
	GOTO 315
C	ERROR IN CORRECTION INPUT
399	WRITE(4,995)
	GO TO 315
C	CORRECTION TO GROUP NUMBER
310	IF (L.GT.NG)GOTO 399
	IG(I)=L
	K=1
	L=2
	GOTO 390
C	CORRECTIONS TO SOME OR MORE DATA
340	IF(K.LT.1.OR.K.GT.NT)GOTO399
	X(I,K)=V(1)
	L=1
390	DO 395 J=K,NT
	IF(V(L).EQ.0)GOTO 395
	X(I,J)=V(L)
395	L=L+1
	GOTO 315
90	J=NTOT
	WRITE(4,1600)J,NCUR
	IST=1
	GO TO 205
C	ON NO ERRORS DATA IS WRITTEN TO FILE UNIT 5
400	WRITE(4,1001)
	DO 410 I=1,NCUR
410	WRITE(5,1700)IG(I),(X(I,J),J=1,NT)
	NCUR=0
99	GOTO(15,40,100,910),IST
C	THIS HANDLES THE UNFORMATED INPUT
C	THIS MUCH BE DONE HERE FOR TWO REASONS
C	1 NO HEADINGS ARE INPUT HERE
C	2 THE FILE FORMAT REQUIRES 2 LINES WHEN NK>7 WHICH IS A NUSIANSE
C	FRO KEYBOARD
100	IF(INDEV.GT.5)GOTO 115
	IF(ONEGR)GOTO 102
	INDEV=4
	IF(SLASHA)GOTO 10100
	IF(NTOT.GT.0)GOTO 910
	INDEV=-4
	GOTO 10300
10100	WRITE(4,1800)
10200	IF(.NOT.KEYBRD)WRITE(4,1820)
	IF(KEYBRD)WRITE(4,1810)
	IST=3
	CALL CHKEOF(ERR)
	READ(4,1100)DEV,NGROUP
	INDEV=DEV
	IF(ERR.NE.0)GOTO 10100
10300	LOOPNR=0
	IF(IABS(INDEV).LE.3)GOTO 910
	IF(KEYBRD.AND.(IABS(INDEV).GT.4))GOTO 10200
	KEYBRD=KEYBRD.OR.IABS(INDEV).EQ.4
C	ONE GROUP INPUT ROUTINE IF :
C	1 INDEV IS NEGATIVE OR
C	2 ONE INPUT GROUP FROM KEYBOARD
	ONEGR=(INDEV.LE.0).OR.(INDEV.EQ.4.AND.NG.EQ.1)
	INDEV=IABS(INDEV)
	IF(.NOT.ONEGR)GOTO 102
	IF(NGROUP.GT.NG)GOTO 100
	IF(NGROUP.NE.0)GOTO 102
	IF(NTOT.GT.0)GOTO 100
	LOOPNR=1
102	IF(LOOPNR.GT.0)NGROUP=LOOPNR
	IF(INDEV.LE.5)GOTO 107
	WRITE(4,1001)
	GOTO 115
107	IF(ONEGR)GOTO 110
	WRITE(4,1950)
	GOTO 115
110	WRITE(4,2400)NGROUP
115	IF(ONEGR)GOTO 117
	CALL CHKEOF(ERR)
	READ(INDEV,2000)Y,(V(J),J=1,NT)
	IF(ERR.EQ.0)GOTO 10115
	WRITE(4,3200)
	GOTO 115
10115	I=Y
C	THIS CONSTRUCTION GIVES A CHANCE TO DETECT
C	MISSING GROUP NUMBERS
	IF(I.NE.0)GOTO 150
120	IF(INDEV.GT.5)WRITE(4,1600)NTOT,NCUR
	IF(LOOPNR.GT.0)LOOPNR=LOOPNR+1
	IF(LOOPNR.LE.NG.AND.LOOPNR.GT.0)GOTO102
	INDEV=1
	IST=3
	GOTO 205
117	I=NGROUP
	CALL CHKEOF(ERR)
	READ(INDEV,2000)(V(J),J=1,NT)
	IF(ERR)10126,10125,120
10126	WRITE(4,3200)
	GOTO 117
10125	IF(V(1).GE.1E10)GOTO 120
	GOTO 125
150	IF(I.LE.NG.AND.I.GT.0.AND.I.EQ.Y)GOTO 125
	WRITE(4,995)
	IF(INDEV.GT.5)WRITE(4,1300)NCUR,I,Y,(V(I),I=1,NT)
	GO TO 115
125	NCUR=NCUR+1
	NTOT=NTOT+1
	IG(NCUR)=I
	DO 160 I=1,NT
160	X(NCUR,I)=V(I)
	IF(NCUR.GE.MAXR)GOTO 201
	GOTO 115
C	END RUTINE
910	WRITE(4,1001)
	IF(NCUR.EQ.0)GOTO 925
	DO 920 I=1,NCUR
920	WRITE(5,1700)IG(I),(X(I,J),J=1,NT)
925	I=0
930	WRITE(5,1700)I,(V(J),J=1,NT)
	WRITE(4,1900)NTOT
	CALL EXIT
	END
