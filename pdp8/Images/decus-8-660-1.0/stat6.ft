C	STAT6
C	PART OF STAT
	SUBROUTINE STAT6
	COMMON /DATA/XL
	COMMON IAN,KOL1,KOL2,NK,N
	COMMON /PARAM/NGU,NGR,LIST,ATT,LDEVE,LDEVL,MISS,NOPAGE
	COMMON/SHEFFE/NDM,NDW,MSW,DUM(20),FLAGS(4)
	LOGICAL FLAGS
	DIMENSION XL(1)
	REAL MSM,MSW,MST
1000	FORMAT(' ANOVA',/,' SOURCE',5X,'SS',9X,'DF',7X,'MS',11X,'F'
     F ,14X,'P'
     1/,' WHITHIN',3X,G10.3,I5,2(3X,G10.3,)3X,F10.3
     2,/,' AMONG  ',3X,G10.3,I5,3X,G10.3,
     3,/,' TOTAL  ',3X,G10.3,I5)
1200	FORMAT(' ERROR IN ANOVA KOL:',I5,' EMPTY')
	FLAGS(3)=.FALSE.
	FLAGS(4)=.FALSE.
	ST=0
	XT2=0
	XT=0
	NT=0
	DO 100 I=1,NK
	S=0
	N1=0
	K1=(I-1)*N
	DO 10 J=1,N
	X1=XL(K1+J)
	IF(X1.EQ.0)GOTO 10
	S=S+X1
	N1=N1+1
	XT=XT+X1
	XT2=XT2+X1*X1
10	CONTINUE
	IF(N1.EQ.0)GOTO 200
	FLAGS(3)=.TRUE.
	NT=NT+N1
	ST=ST+S*S/N1
100	CONTINUE
	CT=XT*XT/NT
	SM=ST-CT
	ST=XT2-CT
	SW=ST-SM
	NDM=NK-1
	NDT=NT-1
	NDW=NDT-NDM
	MSM=SM/NDM
	MSW=SW/NDW
	F=MSM/MSW
	P=PVALUE(F,NDM,NDW)
	WRITE(LDEVL,1000)SM,NDM,MSM,F,P,SW,NDW,
     1MSW,ST,NDT
	RETURN
200	WRITE(LDEVE,1200)I
	RETURN
	END
