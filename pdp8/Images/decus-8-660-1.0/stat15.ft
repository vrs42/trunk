C	STAT15
C	KRUSKAL WALLIS NONPARAMETRIC ANALYSIS OFF VARIANCE
C	IF KOL1=1 PERFORMED ONLY ON ROWS WITH NO MISSIND DATA
	SUBROUTINE STAT15
1000	FORMAT(' KRUSKAL WALLIS ANOVA ',/' H=',F10.1)
3000	FORMAT(' NDF=',I5,' GROUP SIZES:',10I5)
2000	FORMAT(1H ,'TABLE ',A1,' IN SIEGEL')
	COMMON /DATA/XL
	DIMENSION XL(1)
	COMMON IAN,KOL1,KOL2,NK,N
	COMMON /PARAM/NGU,NGR,LIST,ATT,LDEVE,LDEVL,MISS,NOPAGE
	LOGICAL MOVE,REDUCE
	DIMENSION END(10)
	REDUCE=KOL1.EQ.1
	MOVE=(.NOT.MISS.EQ.0)
	I=NK
	IF(MOVE)I=NK+NK
	LOGICAL STATER
	IF(NK.LT.3)I=0
999	IF(STATER(I,'15'))RETURN
	NT=N*NK
	DO 10 I=1,NK
10	END(I+1)=I*N+NT
	END(1)=NT
	INDX=1
	IF(.NOT.MOVE)GOTO 100
C	MOVE DATA INTO LOCATIONS NT+1 AND UPWARDS
C	W
C	REQUIRED IF THERE IS MISSIN DATA IN THE MATRIX
	INDX=NT
	L=1
	L1=NT+1
	DO 35 I=1,NK
	END(I+1)=0
	DO 30 J=1,N
	IF(XL(L).EQ.0)GOTO 30
	IF(.NOT.REDUCE)GOTO 20
	DO 15 I2=1,NK
	IF(XL((I2-1)*N+J).EQ.0)GOTO 30
15	CONTINUE
20	XL(L1)=XL(L)
	END(I+1)=L1
	L1=L1+1
30	L=L+1
35	CONTINUE
	END(1)=NT+L
	INDX=NT+1
	NT=L1-NT-1
	I=0
	IF(NT.EQ.0)GOTO 999
	DO 40 I=1,NK
40	END(I+1)=END(I+1)+NT
	END(1)=INDX+NT-1
100	CALL RANK(XL(INDX),XL(INDX+NT),NT)
	CALL TIE(XL(INDX+NT),NT,1,T)
	T=1-T*12./(NT*NT*NT-NT)
	RT=0
	I2=INDX+NT
	DO 200 I=1,NK
	J=END(I)+1
	K=END(I+1)
	RS=0
	DO 150 L=J,K
	RS=RS+XL(I2)
150	I2=I2+1
200	RT=RT+RS*RS/(K-J+1)
	RT=(12./FLOAT(NT*(NT+1))*RT-3*(NT+1))/T
	WRITE(LDEVL,1000)RT
	I='C'
	IF(NK.EQ.3.AND.NT.LE.15)I='O'
	WRITE(LDEVL,2000)I
	DO 400 I=1,NK
400	END(I)=END(I+1)-END(I)
	L=NK-1
	WRITE(LDEVL,3000)L,(END(I),I=1,NK)
350	IF(MISS.GT.0.AND..NOT.REDUCE)RETURN
	CALL KOLSUM(INDX+NT,NT/NK,'A7')
	RETURN
	END
