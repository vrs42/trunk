C	STATMV
C	MOVE
C	MOVES KOL1 AND KOL2 INTO NK+1 AND NK+2 AS A PREPEARTION FOR
C	NONPARAMETRIC ANALYSES
C	ALSO COUNTS NUMBER OF NON-ZERO PAIRS
	SUBROUTINE MOVE(NT)
	COMMON /PARAM/NGU,NGR,LIST,ATT,LDEVE,LDEVL,MISS,NOPAGE
	COMMON /DATA/XL
	DIMENSION XL(1)
	COMMON IAN,KOL1,KOL2,NK,N
	K1=(KOL1-1)*N
	K2=(KOL2-1)*N
	KX=NK*N
	KY=(NK+1)*N
	NT=0
	DO 100 I=1,N
	X=XL(K1+I)
	Y=XL(K2+I)
	IF(X.EQ.0.OR.Y.EQ.0)GOTO 100
	NT=NT+1
	XL(KX+NT)=X
	XL(KY+NT)=Y
100	CONTINUE
	RETURN
	END
