C^  FEBRUARY   02    1976
C	STAT99
C	PART OF STAT
C	FILE STAT99.FT
C	CALLED TO ANALYSE THE REQUEST FOR A SPECIFIED ANALYSIS NO
	SUBROUTINE STAT99
	COMMON /DATA/XL
	COMMON IAN,KOL1,KOL2,NK,N,IOPT
	COMMON /PARAM/NGU,NGR,LIST,ATT,LDEVE,LDEVL,MISS,NOPAGE
	COMMON /SHEFFE/DUM(23),FLAGS(4)
	LOGICAL FLAGS
	LOGICAL LIST,ATT
	INTEGER ANALY(22)
C	THE ANALY TABLE CONTAINS A 0 FOR NOT IMPLEMENTED
C	AND A NUMBER TO SIGNAL NO OF ARG REQUIRED FOR
C	AN IMPLEMENTED ANALYSIS
C	CAN BE 1 FOR NO ARGUMENTS
C	CAN BE 2 FOR 2 KOL NRS
C	        3 FOR KOL + ARG
	DATA ANALY/1,3,2,2,4*1,4*0,2*2,1,2,1,2,1,2*2,1/
2300	FORMAT(I5,$)
2200	FORMAT(12A6)
	DIMENSION TEXT(12)
2100	FORMAT(///)
2000	FORMAT(1H1)
1100	FORMAT(10I3)
1105	FORMAT(1H ,10I3)
1300	FORMAT(/'0 ANALYSIS NO ',I5,' NOT IMPLEMENTED')
1310	FORMAT(////' ANALYSIS NO ?  ',$)
1050	FORMAT(' EXIT OS8')
1	IF(ATT)WRITE(0,1310)
	READ(4,1100)IAN,KOL1,KOL2,IOPT,IN,IN2
	IF(LIST)WRITE(LDEVL,1105)IAN,KOL1,KOL2,IOPT,IN,IN2
	IF(IAN)200,150,10
10	IF(IAN.EQ.50)GOTO 50
	IF(IAN.EQ.48)GOTO 48
	IF(IAN.EQ.49)GOTO 49
	WRITE(LDEVL,2100)
	IF(IAN.GT.22.OR.IAN.LT.-1)GOTO 60
	IN=ANALY(IAN)
	IF(IN.EQ.0)GOTO 60
	IF(IN.EQ.1)RETURN
	IF(MAX0(KOL1,KOL2).GT.NK)GOTO 40
	IF(MIN0(KOL1,KOL2).LT.1)GOTO 40
	IF(IN.EQ.2)RETURN
	IF(IOPT.GT.0)RETURN
40	IN=STATER(0,'99')
	GOTO 1
50	NGR=IABS(NGR)
	IF(NGR.GT.0.AND.NGR.LT.NGU)GOTO 100
	WRITE(LDEVL,1050)
	WRITE(LDEVL,2000)
	CALL EXIT
60	WRITE(LDEVE,1300)IAN
	GOTO 1
100	REWIND 4
	NGR=NGR+1
	IAN=0
	RETURN
C	COMMENT HANDLING FORTRAN ALWAYS LOOPS ONCE
48	DO 481 I=1,KOL1
	IF(ATT)WRITE(0,2300)I
	READ(4,2200)TEXT
481	WRITE(LDEVL,2200)TEXT
	GOTO 1
C	THE ORDER OF THE FLAGS ON THE CARD ARE:
C	ATT,LDEVL,LDEVE,NOPAGE,LIST
C	SET THE FLAGS FOR VARIUS PARAMETERS
C	THE VARIOS POSSIBILITIES ARE:
C	TYPE			COMMENT		ATT	LDEVL	LDEVE
C	49			REST BLANK	FALSE	NOT CHANGED----
C	49,1				TRUE	0	0
C	49,X,3					T/F((1/0)	3	0
C	THE EQUIVALENCES TO THE READPOSITIONS ARE:
C	ATT	KOL1
C	LDEVL	KOL2
C	LDEVE	IOPT
C	NOPAGE	IN
C	LIST	IN2
49	ATT=KOL1.EQ.1
	LIST=IN2.EQ.1
	NOPAGE=IN.EQ.1
C	YOU MUST STATE DEVICE 4 NOT 0 TO CHANGE TO TERMINAL
	IF(KOL2.NE.0)LDEVL=KOL2
C	ONLY DEVICES 3 4 0 LEGAL
	IF(LDEVL.NE.3)LDEVL=0
	IF(IOPT.NE.0)LDEVE=IOPT
	IF(LDEVE.NE.3)LDEVE=0
	GOTO 1
150	DO 160 I=1,4
160	FLAGS(I)=.FALSE.
	MISS=0
	IF(NGR.GT.1)GOTO 100
200	RETURN
	END
