C	STAT20
C	TABULATION AND PLOTS
	SUBROUTINE STAT20
	COMMON /PARAM/NGU,NGR,LIST,ATT,LDEVE,LDEVL,MISS,NOPAGE
	COMMON /DATA/XL0
	COMMON IAN,KOL1,KOL2,NK,N,IOPT
1300	FORMAT(' CROSS-TABULATION   VERTICAL =KOL ',I2,
     *'  HORISONTAL=KOL',I2,/,' NO OF DATA =',I5//)
	DIMENSION XL0(1)
	DIMENSION N0(50),X0(11)
	EQUIVALENCE (N0(1),X0(1))

1100	FORMAT(1X,G10.3,/,13X,3H  :,10(I7,'  :'))
1200	FORMAT(1X,G10.3,/,11X,11G10.3)
2100	FORMAT(1X,G10.3,5X,50A1)
2200	FORMAT(1X,G10.3,5X,6('+.........'),/,13X,6G10.3)
2300	FORMAT('1SCATTER PLOT  VERTICAL =KOL',I3,' HORISONTAL =
     *KOL',I3,/,' NO OF POINTS =',I5///)
	LOGICAL PLOT
	PLOT=IAN.EQ.21
	XIN(KZ1,KZ)=XL0((KZ1-1)*N+KZ)
	XMAX=-1E50
	XMIN=-XMAX
C	STEP NUMBERS AS FOLLOWS DEFAULTS()
C
C	NXST		NYST
C
CPLOT	50		IOPT(50)
C
CNOT PLOT
C
CKOL1<>KOL2
C	IOPT(5)		IOPT(5)
C
CKOL1=KOL2
C	IOPT(5)		1
	LOGICAL STATER
	J=2
999	IF (STATER(J,'20'))RETURN
	KX=NK+1
	KY=KX+1
	IF(PLOT)GOTO 10
	IF (IOPT.LT.3.OR.IOPT.GT.10)IOPT=5
	NXST=IOPT
	NYST=IOPT
	IF(KOL1.EQ.KOL2)NYST=1
	GOTO 20
10	IF(IOPT.LT.5.OR.IOPT.GT.50)IOPT=25
	NXST=50
	NYST=IOPT
20	K=0
	J=N*NK
	NT=0
	DO 50 I=1,N
	X=XIN(KOL1,I)
	Y=XIN(KOL2,I)
	IF(X.EQ.0.OR.Y.EQ.0)GOTO50
	J=J+1
	NT=NT+1
	XL0(J)=X
	XL0(J+N)=Y
	IF(X.GT.XMAX)XMAX=X
	IF(X.LT.XMIN)XMIN=X
50	CONTINUE
	J=0
	IF(NT.LT.3)GOTO 999
	DO 70 I=1,NT-1
	DO 70 J=I+1,NT
	Y1=XIN(KY,I)
	Y2=XIN(KY,J)
	IF (Y1.GT.Y2)GOTO 70
	XL0((KY-1)*N+I)=Y2
	XL0((KY-1)*N+J)=Y1
	Y1=XIN(KX,I)
	XL0((KX-1)*N+I)=XIN(KX,J)
	XL0((KX-1)*N+J)=Y1
70	CONTINUE
	NTT=4*NT
	YMAX=XIN(KY,1)
	YMIN=XIN(KY,NT)
	IF(.NOT.PLOT)WRITE(LDEVL,1300)KOL2,KOL1,NT
	IF(PLOT)WRITE(LDEVL,2300)KOL2,KOL1,NT
	XST=(XMAX-XMIN)/NXST
	YST=(YMAX-YMIN)/NYST
	YU=YMAX+YST
	DO 200 I=1,NYST
	YU=YU-YST
	YL=YU-YST
	XL=XMIN-XST
	DO 100 J=1,NXST
	N0(J)=0
	IF(PLOT)N0(J)=' '
100	IF(PLOT)N0(1)='.'
	XL=XL+XST
	L=1
	LM=1
	DO 60 K=L,NT
	X=XIN(KX,K)
	Y=XIN(KY,K)
	IF(Y.LT.YL.AND.I.NE.NYST)GOTO 90
	IF(Y.GE.YU.AND.I.NE.1)GOTO 60
	J=(X-XMIN)/XST+1.
	IF(J.GT.NXST)J=NXST
	IF(.NOT.PLOT)N0(J)=N0(J)+1
	IF(PLOT.AND.N0(J).EQ.'*')N0(J)='#'
	IF(PLOT.AND..NOT.N0(J).EQ.'#')N0(J)='*'
	LM=K
60	CONTINUE
90	L=LM
	IF(.NOT.PLOT)WRITE(LDEVL,1100)YU,(N0(K),K=1,NXST)
	IF(.NOT.PLOT)GOTO 200
	DO 190 K=1,50
	KM=51-K
	IF(N0(KM).NE.' ')GOTO 195
190	CONTINUE
195	WRITE(LDEVL,2100)YU,(N0(K),K=1,KM)
200	CONTINUE
	K=NXST+1
	X0(1)=XMIN
	IF(PLOT)GOTO 300
	DO 210 I=1,NXST
210	X0(I+1)=XMIN+XST*I
	WRITE(LDEVL,1200)YMIN,(X0(I),I=1,K)
	RETURN
300	DO 310 I=1,6
310	X0(I+1)=XMIN+XST*I*10
	WRITE(LDEVL,2200)YMIN,(X0(I),I=1,6)
	RETURN
	END
