C	STATSK
C	PART OF STAT
C	CALLED TO SKIP ALL CARDS BELOGING TO THE PRESENT ANALYSIS
C	RETURNS WITH K=0 OR 50
CK	ON 50 SO HAS UNIT 4 BEEN BACSPACED 1
	SUBROUTINE STATSK(K)
	COMMON /PARAM/D(3),ATT
	LOGICAL ATT
3000	FORMAT(' INPUT 0 OR 50 TO RESTART ',$)
1000	FORMAT(2I3,3X,I3)
2000	FORMAT(A6)
	IF(ATT)WRITE(0,3000)
10	READ(4,1000)K,KOL1,KOL2
C	THE FOLLOWING GUARS AGAINST THE NONANALYSISCARDS THAT MIGHT
C	FOLLOW IN SOME CASES 
C	THESE ARE
C	ANALYSIS 7,N	FOLLOWEBY PVALUES
C	ANALYSIS -1,0	FOLLOWD BY FORMATT
C	ANALYSIS 21,K,K,-N	FOLLOWED BY PLOTSCALE
	IF((K.EQ.7.AND.KOL1.GT.0)
     *.OR.(K.EQ.4.AND.KOL2.GT.0)
     *.OR.(K.EQ.-1.AND.KOL1.EQ.0)
     *.OR.(K.EQ.21.AND.KOL2.LT.0))READ(4,2000)KOL1
	IF (K.EQ.48)GOTO 48
	IF(K.EQ.0)RETURN
	IF(K.NE.50)GOTO 10
	IF(ATT)STOP
	BACKSPACE 4
	RETURN
48	DO 481 I=1,KOL1
481	READ(4,2000)K
	GOTO 10
	RETURN
	END
