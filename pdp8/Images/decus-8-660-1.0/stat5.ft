C	STAT5
C	PART OF STAT
	SUBROUTINE STAT5
	COMMON /PARAM/NGU,NGR,LIST,ATT,LDEVE,LDEVL,MISS,NOPAGE
	COMMON /DATA/XL
	COMMON IAN,KOL1,KOL2,NK,N
	DIMENSION XL(1)
	DIMENSION NONZ(10,10)
	DIMENSION XT(10)
	VAR(A1,B1,C1,NQ)=A1-B1*C1/NQ
1200	FORMAT(' CORRELATION MATRIX')
1300	FORMAT(//' NUMBERS OF OBSERVATIONS')
1400	FORMAT(1H ,10I8)
1610	FORMAT(1H ,3I3)
1700	FORMAT(' ALL GROUPS',I5,' OBSERVATIONS')
1250	FORMAT(1H ,10F8.3)
10	WRITE(LDEVL,1200)
	LOGICAL EQUAL
	EQUAL=.TRUE.
	NT=0
	DO 50 I=1,NK
	DO 30 J=1,NK
	IA=(I-1)*N+1
	IB=(J-1)*N+1
	CALL QSUM(N,2,XL(IA),XL(IB),S1,S2,NZ,
     1S3,S4,D,D,S5)
	A=1.E25
	B=1
	C=1
	NONZ(I,J)=NZ
	IF(NT.NE.0.AND.NZ.NE.NT)EQUAL=.FALSE.
	NT=NZ
	IF(NZ.LE.2)GOTO30
	A=VAR(S5,S1,S3,NZ)
	B=VAR(S2,S1,S1,NZ)
	C=VAR(S4,S3,S3,NZ)
	XT(J)=0
30	IF(B*C.NE.0)XT(J)=A/SQRT(B*C)
50	WRITE(LDEVL,1250)(XT(J),J=1,NK)
	IF(.NOT.EQUAL)GOTO 75
	WRITE(LDEVL,1700)NT
	RETURN
75	WRITE(LDEVL,1300)
	DO 60 J=1,NK
60	WRITE(LDEVL,1400)(NONZ(J,I),I=1,NK)
	RETURN
	END
