C^  MARCH   20    1975
C	BIGMAK
C	THIS ROUTINE PERFORMS TWO SEPARATE FUNCTIONS DEPENDING ON THE
C	INPUT SWITHCES AS SET BY /A /B
C	THE INFORMATION IS TRANSMITTED HERE BY TEMP(1)
	SUBROUTINE BIGMAK
	COMMON /PARAMS/DEV4,NG,NK,CURGR,TEMP(5),NREK,NKOL,ONEOR,NPAR
	NR=TEMP(2)
C	HANDLING OF FORMATS

C	THE FOLLOWING ARE THE TWO DEFAULT FORMATS FOR /A(1)AND /B(2)
C	IF /F SO IS THE 1 OVERREAD AND USED AS INPUT FROM UNIT 5
	DIMENSION FORMS(12,2),FORM1(12),FORM2(12)
	EQUIVALENCE (FORMS(1,1),FORM1(1)),(FORMS(1,2),FORM2(1))
	DATA FORM1/'(10F7.0)'/
	DATA FORM2/'(I5,10(3X,F7.2))'/
	LOGICAL F,DEV4
	CALL CMDOPT(5,F)
1000	FORMAT(I10,12A6)
	IF(DEV4.AND.F)WRITE(0,3000)
3000	FORMAT(' STATE NUMBER OF COL &  FORMAT ')
	IF(F)READ(5,1000)NR,FORM1
	DIMENSION X(85)
	IF(TEMP(1).NE.1)GOTO 500
C	THE MAKE PART
C	INPUT DATA IS IN THE FORM NG,NK,NR(NUMBER PER LINE,DEFAULT IS 20)
	WRITE(6'1)NREK,NKOL
	DO 100 I=1,NREK
	READ(8,FORM1)(X(L),L=1,NKOL)
	WRITE(0,1100)I
1100	FORMAT(I5,' WRITTEN')
100	WRITE(6'I+1)X
	STOP
500	L=2
	IF(F)L=1
	IF(NR.LE.0)NR=10
	N1=(NKOL+NR-1)/NR
	N2=NKOL/N1
	DO 600 I=1,N1
	K1=(I-1)*(N2+1)+1
	K2=K1+N2
	IF(K2.GT.NKOL)K2=NKOL
	WRITE(3,2000)NREK,NKOL,K1,K2
2000	FORMAT('1FILE CONTAINS ',I3,' RECORDS AND
     *',I3,' COLUMNS',/,' THIS IS COLUMNS :',I3,' TO',I3)
	DO 550 J=1,NREK
	READ(6'J+1)X
	DO 510 K=1,NKOL
510	IF(X(K).EQ.0)X(K)=1E100
	WRITE(3,FORMS(1,L))J,(X(K),K=K1,K2)
550	CONTINUE
600	CONTINUE
	STOP
	END
