C	INIT
C	PART OF STAT
C	FILE STAT98.FT
	SUBROUTINE INIT
C	AS WE SAVE THE DATA IN CORE IN A SIMULATED N BY NK
C	MATRIX WE MUST KNOW N<THE NUMBER OF ROWS>BEFORE
C	WE START TO READ THE DATA
C	<OR ELSE RESHUFFLE THE DATA AFTER READIN BUT THIS
C	REQUIRES MORE CORE>
C	INIT IS CALLED AS THE PROGRAM STARTS TO READ THE INPUT FILE
C	AND FIND THE NUMBER OF ROWS IN EACH OF THE POSSIBLE 100
C	GROUPS
	COMMON /PARAM/NGU,NGR,LIST,ATT,LDEVE,LDEVL,MISS,NOPAGE
	COMMON /SIZE/MAXXL, NOKOLL(100)
	COMMON VERS(4)
	DIMENSION Z(10)
1000	FORMAT(2I3)
1100	FORMAT(A6)
1200	FORMAT(I3,7(E11.4))
1300	FORMAT(' FILE FORMATED WRONGLY(ERROR IN NG OR NK)')
1400	FORMAT(' ERROR IN INPUT FILE (GROUP NR > NG)')
1500	FORMAT(' HASSLE STAT VERSION ',F5.2,' EDITED  '
     *,A2,'-',A2,'-',A2)
	WRITE(LDEVL,1500)VERS
	READ (6,1000)NG,NK
	IF(NG.GT.100.OR.NK.GT.10)GOTO 99
	DO 2 I=1,NG
2	NOKOLL(I)=0
	NGT=NG+1
	DO 5 I=1,NGT
5	READ(6,1100)X
10	READ(6,1200)NG1,(Z(I),I=1,NK)
	IF(NG1.GT.NG)GOTO 991
	IF(NG1.EQ.0)RETURN
	NOKOLL(NG1)=NOKOLL(NG1)+1
	GOTO 10
99	WRITE(LDEVE,1300)
	STOP
991	WRITE(LDEVE,1400)
	STOP
	END
