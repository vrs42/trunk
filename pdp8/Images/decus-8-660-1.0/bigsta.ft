C^  APRIL   14    1975
C	BIGSTAT
C	MAIN PROGRAM TO BIGSTAT FOR HANDLING
C	LARGER>10 KOLUMNS STAT FILES
C	THE FILE IS IN THE FORMAT
C	DEFINE FILE N(NR+1,NK)
C	1ST RECORD IS NO OF ROWS(RECORDS)
C	NK NO OF COLUMNS


C	COMMON
	COMMON NALL(20),NIND(20),HEAD(12),AND(10),INS(10)
     *,LIM(2,10),KOLS(10),ALL,KOL(10)
	LOGICAL NALL,NAND,AND,INS,ALL
C	NALL(I,J)   UPPER LOWER LIMIT FOR PAT NOS
C	NIND	    INDIVIDUAL PAT NOS
C	HEAD MAIN HEADING DEFAULT FOLLOWS
	DATA HEAD/'DATA E','XTRACT','ED FRO','M BIG ','FILE ',7*'      '/
C	AND	    TRUE IF VARIABLE ANDED
C	INS	    TRUE IF VARIABLE INSIDE
C	LIM(L,I)LIM(U,I)   LOWER/UPPER LIMIT FOR I
C	KOLS	    KOLUMNS TO ASSOCIATE WITH VARIABLE
C	ALL	    TRUE IF ALL RECORDS ARE TO BE SEARCHED
C	KOL	    KOLUMN NOS TO BE USED FOR OUTPUT
	COMMON/PARAMS/DEV4,NG,NK,CURGR,TEMP(5),NREK,NKOL,ONEOR
     *,NPAR,AUTO,IFILL
	LOGICAL IFILL
C	DEV4 TRUE IF FILE UNIT 5 IS 0
	DATA DEV4,TEMP(2),AUTO,ALL,IFILL/2*.FALSE.,3*.TRUE./
C	NG NO OF GROUPS
C	NK NO OF COULMNS
C	CURGR CURRENT OUTPUT GROUP
	DATA KOL(1),CURGR,NG,NALL,NIND/43*0/
C	TEMP SIMPLY INTERN SUBROUTINE COMMUNICATION
C	ONEOR SET TO TRUE IF AT LEAST ONE OR DETECTED IS FALSE
C	FORCES AND(1) TO FALSE AS SEARCHING BEGINS
C	NPAR NO OF SEARCH PARAMETERS
C	AUTO HEADINGS INTERNALLY GENERATED
C	IFILL IF <>0 KOL(IFILL)=RECORD NO
C	NREK NO OF RECORDS IN INPUT FILE
C	NKOL NO OF KOLUMNS IN INPUT FILE
C	INITIALIZE
	CALL BIGONE(K)
	DEFINE FILE 6(NREK+1,85,U,IX)
	IF (K.EQ.0)CALL BIGMAK
10	CALL BIGINI(K)
	IF(K.EQ.2)CALL BIGLIS
	IF(K.EQ.1)CALL BIGSRC
	GOTO 10
	END
 