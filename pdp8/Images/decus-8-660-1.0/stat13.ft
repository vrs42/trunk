C	STAT13
C	PART OF STAT
	SUBROUTINE STAT13
	COMMON /PARAM/NGU,NGR,LIST,ATT,LDEVE,LDEVL,MISS,NOPAGE
C	WILCOXON PAIRED RANKS NO 13
500	FORMAT(' WILCOXON MATCHED-PAIRS SIGNED RANKS TEST'
     1/' COLUMNS',5X,'N',6X,'T',5X,'Z',7X,'2*P')
600	FORMAT(1H ,I3,I5,I6,F8.1,2F8.3)
800	FORMAT(1H ,'USE TABLE G IN SIEGEL')
900	FORMAT(' BAD DATA <NO DIFFERENCES>')
	COMMON /DATA/XL
	COMMON IAN,KOL1,KOL2,NK,N
	DIMENSION XL(1)
	LOGICAL STATER
	IF(STATER(5,'13'))RETURN
	WRITE(LDEVL,500)
	CALL MOVE(J)
	NT=NK*N+1
	I=-1
	IF(NT.LT.6)I=0
	IF(STATER(I,'13'))RETURN
	CALL MPAIR(J,XL(NT),XL(NT+N),NDF,T,Z,P,XL(NT+2*N)
     1,XL(NT+3*N),XL(NT+4*N),IE)
	IF(IE.EQ.1)GOTO 90
	P=2.*P
	WRITE(LDEVL,600)KOL1,KOL2,NDF,T,Z,P
	IF(NDF.LT.25)WRITE(LDEVL,800)
	RETURN
90	WRITE(LDEVE,900)
	RETURN
	END
