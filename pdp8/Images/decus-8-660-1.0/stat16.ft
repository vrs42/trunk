C	STAT16
C	PART OF STAT
	SUBROUTINE STAT16
	COMMON /PARAM/NGU,NGR,LIST,ATT,LDEVE,LDEVL,MISS,NOPAGE
C	SPEARMAN RANK ANALYSIS NO 16
100	FORMAT(' SPEARMAN RANK CORRELATION',/
     1' COLUMNS',5X,'N',7X,'RS',11X,'T',10X,'2*P',6X,'D F')
200	FORMAT(1H ,I3,I5,I6,2F12.4,F10.3,I8)
300	FORMAT(1H ,'USE TABLE P IN SIEGEL')
	COMMON/DATA/XL
	COMMON IAN,KOL1,KOL2,NK,N
	DIMENSION XL(1)
	LOGICAL STATER
	IF(STATER(5,'16'))RETURN
	WRITE(LDEVL,100)
	CALL MOVE(J)
	NT=N*NK+1
	I=-1
	IF(J.LT.4)I=0
	IF(STATER(I,'16'))RETURN
	CALL SRANK(XL(NT),XL(NT+N),XL(NT+2*N),J,RS,T,NDF,0)
	M=0
	P=PVALUE(T,M,NDF)
	WRITE(LDEVL,200)KOL1,KOL2,J,RS,T,P,NDF
	IF(NDF.LT.25)WRITE(LDEVL,300)
	RETURN
	END
