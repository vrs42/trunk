C^  FEBRUARY   02    1976
C	STAT3
C	PART OF STAT
	SUBROUTINE STAT3
	COMMON /DATA/XL
	COMMON IAN,KOL1,KOL2,NK,N,IOPT
	COMMON /PARAM/NGU,NGR,LIST,ATT,LDEVE,LDEVL,MISS,NOPAGE
	DIMENSION XL(1)
	DIMENSION XT(10)
	VAR(A1,B1,C1,NQ)=A1-B1*C1/NQ
1600	FORMAT(' REGRESSION OF ONTO     INTERCEPT     SD INTERCEPT')
1650	FORMAT('                        SLOPE         SD SLOPE    
     F     D F')
1700	FORMAT(1H ,I5,3G13.3)
1900	FORMAT(1H ,12X,'X',12X,'Y',10X,'Y-CALC')
1300	FORMAT(' EXPLAINED SUM OF SQUARES  UNEXPL.SUM OF SQUARES
     F           S2YX')
1400	FORMAT(1H ,7X,G13.3,11X,G13.3,8X,G13.3,
     F/'0FOR SLOPE  T=',G13.3,5X,'2*P=',F10.3/)
1500	FORMAT(1H ,I12,I5,2X,2G13.3)
1550	FORMAT(1H ,19X,2G13.3,6X,I5/)
1800	FORMAT(1H ,I12,I5,'  BAD DATA')
	WRITE(LDEVL,1600)
	IA=(KOL1-1)*N+1
	IB=(KOL2-1)*N+1
	CALL QSUM(N,2,XL(IA),XL(IB),S1,S2,NZ,S3,S4,D,D,S5)
	IF(NZ.EQ.0)GOTO 100
	XY=VAR(S5,S1,S3,NZ)
	X2=VAR(S2,S1,S1,NZ)
	B=XY/X2
	A=S3/NZ-S1/NZ*B
C	EXPLAINED SUM OF SQUARES
	S=XY*XY/X2
	ESS=S
C	UNEXPLAINED SUM OF SQUARES
	S=VAR(S4,S3,S3,NZ)-S
	USS=S
C	NZ=DF
	NZ=NZ-2
C	S2Y.X
	S=S/NZ
	SYX=S
C	SEM OF A
	XM=S1/(NZ+2)
	SA=S*(1./(NZ+2)+XM*XM/X2)
	IF(SA.LT.0)GOTO 100
	SA=SQRT(SA)
C	SEM OF B
	S=S/X2
	IF(S.LT.0)GOTO 100
	S=SQRT(S)
C	T-VALUE OF SLOPE
	T=B/S
	M=0
	P=PVALUE(T,M,NZ)
	WRITE(LDEVL,1500)KOL1,KOL2,A,SA
	WRITE(LDEVL,1650)
	WRITE(LDEVL,1550)B,S,NZ
	WRITE(LDEVL,1300)
	WRITE(LDEVL,1400)ESS,USS,SYX,T,P
	IF(IOPT.EQ.0)RETURN
	WRITE(LDEVL,1900)
	J=0
	DO 10 I=1,N
	X=XL((KOL1-1)*N+I)
	Y=XL((KOL2-1)*N+I)
	IF (X.EQ.0.OR.Y.EQ.0)GOTO 10
	J=J+1
	Z=B*X+A
	WRITE(LDEVL,1700)J,X,Y,Z
10	CONTINUE
	RETURN
100	WRITE(LDEVE,1800)KOL1,KOL2
	RETURN
	END

