C^  APRIL   14    1975
C	BIGSRCH
C	THE SEARCH MODULE TO THE BIGSTAT PROGRAM
	SUBROUTINE BIGSRC
	COMMON NALL(2,10),NIND(20),HEAD(12),AND(10),INS(10),LIM(2,10)
     *,KOLS(10),ALL,KOL(10)
	COMMON /PARAMS/DEV4,NG,NK,CURGR,TEMP(5)
     *,NREK,NKOL,ONEOR,NPAR,AUTO,IFILL
	LOGICAL IFILL
C	USAGE OF TEMP
C	1	N U
C	2	INHIBITS OUTPUT IF .TRUE.
	EQUIVALENCE (TEMP(2),NOOUT)
	LOGICAL NOOUT
C	3
C	4
C	5
	LOGICAL AND,INS,ALL,DEV4,ONEOR,OK(10),XL,OK2
	DIMENSION X(87)
	X(86)=0
C	IF ALL ARE SET TO AND CHANGE 1ST TO OR
	IF(.NOT.ONEOR)AND(1)=.FALSE.
C	INITIALIZE
	TYPE=1
	LINES=0
	IF(.NOT.ALL)TYPE=2
	ASSIGN 100 TO LOOP
	IF(.NOT.ALL)ASSIGN 125 TO LOOP
C	BAD BUT WE MUST STAY WITHIN K LOOP IF TYPE 2
C
C	IF LESS THAN 10 KOL OUT MAKE SURE REST ARE SET TO 0
	XL=.FALSE.
	DO 10 I=1,10
	IF(KOL(I).EQ.0)XL=.TRUE.
10	IF(XL)KOL(I)=86
C	IF IFILL DEFINED POINT TO KOLNR VIA X(87)
	IF(IFILL)KOL(NK)=87
C	INDEX IS RECORD INDEX FOR TYPE 1
C	OR INDEX INTO AREAS FOR TYPE 2 AND 3
50	INDEX=0
	IF(TYPE.EQ.1)INDEX=1
100	INDEX=INDEX+1
	K=NALL(1,INDEX)-1
C	FETCH A RECORD FIRST DETERMINE WHICH
	GOTO(110,120,130),TYPE
C	ALL
110	K=INDEX
	IF(INDEX.GT.NREK)GOTO 900
	GOTO 150
C	LIMITS
120	IF(INDEX.LT.11)GOTO 125
122	TYPE=3
	ASSIGN 100 TO LOOP
	GOTO 50
125	IF(NALL(1,INDEX).EQ.0)GOTO 122
	K=K+1
	IF(K.LE.NALL(2,INDEX))GOTO 150
	GOTO 100
130	IF(INDEX.GT.20)GOTO 900
	K=NIND(INDEX)
	IF(K.EQ.0)GOTO 900
150	READ(6'K+1)(X(I),I=1,NKOL)
	X(87)=K
C	OK NOW WE HAVE THE RECORD THE SEARCH LOGIC STARTS
	DO 200 I=1,10
200	OK(I)=.FALSE.
	OK2=.FALSE.
	DO 300 I=1,NPAR
	XT=X(KOLS(I))
	IF(XT.EQ.0)GOTO 300
C	IGNORE IF MISSING VALUE
C	FOUND AN OR  CHECK LIMITS
	XL=XT.GT.LIM(1,I).AND.XT.LT.LIM(2,I)
	IF(XL.NE.INS(I))GOTO 300
C	SEEMS OK
	OK(I)=.TRUE.
	OK2=OK2.OR..NOT.AND(I)
300	CONTINUE
C	MISSING ANYTHING ?
	IF(.NOT.OK2)GOTO LOOP
	DO 400 I=1,NPAR
	IF(AND(I).AND..NOT.OK(I))GOTO LOOP
400	CONTINUE
C	OK !
	LINES=LINES+1
	IF(.NOT.NOOUT)WRITE(7,1000)CURGR,(X(KOL(I)),I=1,NK)
	GOTO LOOP
1000	FORMAT(I3,7(E11.4))
900	IF(.NOT.DEV4)WRITE(3,1100)CURGR,LINES
	IF(DEV4)WRITE(0,1100)CURGR,LINES
1100	FORMAT('0 GROUP NR ',I4,' FOUND ',I4,' RECORDS')
	RETURN
	END
	