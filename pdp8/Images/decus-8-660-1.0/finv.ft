C^  DECEMBER   09    1974
C	RETURNS F VALUE CORRESPONDING TO GIVEN P
C	USES ZINV
C	FROM ABRANOWITZ 26.6.16 & 26.5.22
C
	FUNCTION FINV(P,N1,N2)
	A=1./(N2-1.)
	B=1./(N1-1.)
	H=2./(A+B)
	Y=ZINV(P)
	REAL LAMBDA
	LAMBDA=(Y*Y-3.)/6.
	W=Y*SQRT(H+LAMBDA)/H-(B-A)*(LAMBDA+5./6.-2./3./H)
	FINV=EXP(2.*W)
	RETURN
	END
