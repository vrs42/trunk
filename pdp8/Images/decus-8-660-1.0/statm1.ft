C	STATM1
C	PART OF STAT
	SUBROUTINE STATM1
C	LISTING PROGRAM  STAT-1
C	IF KOL1=0 MUST BE FOLLOWED BY FORMAT
C	IF KOL1 = 1-3 USES INTERNAL FORMATS
C	3 SHOULD NOT BE USED IF MISSING DATA ARE PRESENT
	COMMON /PARAM/NGU,NGR,LIST,ATT,LDEVE,LDEVL,MISS,NOPAGE
	COMMON /DATA/XL
	COMMON  IAN,KOL1,KOL2,NK,N
	DIMENSION D(14,4),D0(14),D1(14),D2(14),D3(14)
	DIMENSION Z(10)
	EQUIVALENCE (D(1,1),D0(1)),(D(1,2),D1(1)),(D(1,3),D2(1))
     *,(D(1,4),D3(1))
	DIMENSION XL(1)
CTHIS DOES NOT QUITE ACHIEVE THE 70 COLUMNS CRITERION BUT
CWHO USES 10 KOLUMNS WITHOUT A LINEPRINTER
	DATA D1/'(1X,10(F6.1,1X))'/
	DATA D2/'(1X,10(F10.4,3X))'/
	DATA D3/'(1X,10(G11.4,2X))'/
1000	FORMAT(14A6)
2000	FORMAT(///)
	I=-1
	IF(KOL1.LT.0.OR.KOL1.GT.3)I=0
	IF(KOL1.EQ.3.AND.MISS.GT.0)I=0
	LOGICAL STATER
	IF(STATER(I,'M1'))RETURN
	WRITE(LDEVL,2000)
	IF(KOL1.EQ.0)READ (4,1000)D0
	IF(N*NK.EQ.0)RETURN
	DO 100 I=1,N
	DO 10 J=1,NK
	IF(XL((J-1)*N+I))8,7,8
7	Z(J)=1.E25
	GOTO 10
8	Z(J)=XL((J-1)*N+I)
10	CONTINUE
	L=KOL1+1
	IF(D(1,L).EQ.' ')L=2
	WRITE(LDEVL,D(1,L))(Z(J),J=1,NK)
100	CONTINUE
	RETURN
	END
