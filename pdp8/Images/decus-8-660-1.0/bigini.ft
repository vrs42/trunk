C^  APRIL   14    1975
C	BIGINI
	SUBROUTINE BIGINI(K)
C	INITIALIZER BUILDS UP THE QUESTION
	COMMON NALL(20),NIND(20),HEAD(12),AND(10),INS(10),LIM(2,10)
     *,KOLS(10),ALL,KOL(10)
	REAL LIM
	COMMON /PARAMS/DEV4,NG,NK,CURGR,TEMP(5),NREK,NKOL,ONEOR,
     *NPAR,AUTO,IFILL
C	USAGE OF THE TEMP VECTOR
C	1	SENDS DEVICE FOR LIST TO BIGLIS
C	2	SET TO .TRUE.	ON S0 FALSE ON ST
	EQUIVALENCE (TEMP(2),NOOUT)
	LOGICAL NOOUT,IFILL
C	3
C	4
C	5

	LOGICAL AND,INS,ALL,DEV4,ONEOR,AUTO
	DIMENSION LIST(30),TEXT(3)
	EQUIVALENCE (LIST(1),L1),(LIST(2),L2),(LIST(3),L3)
	DIMENSION CODES(7)
	DATA NCODES,CODES/18,'CRCONA','NISTEX','LISCMH','SHIOIA'
     *,'OOOAOK','S0RN'/
C	CODES ARE	LINE NO
C	CR	100	CREATE
C	CO	400	COLUMNS
C	NA	500	NUMBERS ALL
C	NI	600	NUMBERS INDIVIDUALLY
C	ST	700	START SEARCHING
C	EX	300	EXIT	*
C	LI	800	LIST
C	SC	900	SCRATCH	*
C	MH	1000	MAIN HEADING
C	SH	1100	SUBHEADING
C	IO	1200	INSIDE OR
C	IA	1200	INSIDE AND
C	OO	1200	OUTSIDE OR
C	OA	1200	OUTSIDE AND
C	OK	1600	OK REQUIRED ON * IF  DEV4 IS TRUE
C	S0	1700	SEARCH BUT NO OUTPUT
C	RN	1800	RECORD NO SET KOL(ARG)TORECORD NO INIBIT ON 0
C
C	IF K=2 WE ARE RETURNING FROM A LISTING
C	IF NOOUT WE ARE RETURNING FROM A NO-OUTPUT SEARCH
C	IN EITHER CASE DO NOT SCRATCH THE QUESTION
	IF(K.EQ.2.OR.NOOUT)GOTO 70
C	SCRATCH
	CURGR=CURGR+1
	IF(CURGR.GT.NG.AND.NG.NE.0)GOTO 310
10	NPAR=0
	ONEOR=.FALSE.
	NAND(1)=0
	NIND(1)=0
	ONEOR=.FALSE.
	ASSIGN 999 TO OK


C	INPUT ROUTINE
70	IF(DEV4)WRITE(0,10000)
75	READ(5,12000)A,LIST
	IF(A.NE.'OK')ASSIGN 999 TO OK
	IER=100
	CALL CGET(A,1,K)
	CALL CGET(A,2,K0)
	IF(NG.EQ.0)GOTO 100
C	FIRST CARD MUST BE CR ILLEGAL LATER
	DO 80 J=1,NCODES*2,2
	CALL CGET(CODES,J,L)
	CALL CGET(CODES,J+1,L0)
	IF(K.EQ.L.AND.K0.EQ.L0)GOTO (100,400,500,600,700,300,800,900
     *,1000,1100,1200,1200,1200,1200,1600,1700,1800),(J+1)/2
80	CONTINUE
C	ERROR CODE NOT FOUND
	IER=100
999	CALL BIGERR(IER)
C	WE ONLY COME HERE IF DEV4=TRUE
	GOTO 70
C	CR CREATE MUST BE FIRST CARD ILLEGAL LATER
100	IER=0
	IF(A.NE.'CR')GOTO999
	IF(NG.GT.0)GOTO 999
	IF(L1.GT.100.OR.L1.LT.0.OR.L2.GT.10.OR.L2.LT.0)GOTO 999
	NG=L1
	NK=L2
	GOTO 75
C	EXIT REQUIRES AN OK
300	ASSIGN 310 TO OK
	GOTO 1610
310	IF(DEV4)WRITE(0,13100)
	WRITE(7,14000)
	STOP
C
C	COLUMNS TO USE ELEMENTARY DEAR WATSON
400	IER=1
	KOL(1)=0
	IF(L1.GT.NKOL.OR.L1.LE.0)GOTO 999
	IF(LIST(NK+1).NE.0)GOTO 999
	DO 420 I=1,10
	K=LIST(I)
	IF(K.LT.0.OR.K.GT.NKOL)GOTO  999
C	IF LAST COLUMN IS SPECIFIED DO NOT USE RECORD NO
	IF(LIST(NK).NE.0)IFILL=.FALSE.
420	IF(I.GT.1)KOL(I)=K
	KOL(1)=LIST(1)
	GOTO 75
C	NA NUMBERS ALL
500	IER=2
C	SET EVEN NUMBERS TO NREK IF CORRESPONDIG ODD IS >0
C	IE ALLOW 1, AS BEING ALL
	DO 501 I=2,21,2
501	IF(LIST(I).EQ.0.AND.LIST(I-1).NE.0)LIST(I)=NREK
	L=1
	L0=1
505	NALL(L0)=0
	DO 510 I=2,20
	L=L+1
	K=LIST(I)
	IF(K.EQ.0)GOTO 510
	IF(K.LE.LIST(I-1))GOTO 999
	IF(K.GT.NREK.OR.K.LT.0)GOTO 999
510	NALL(L)=K
	NALL(L0)=L1
550	ALL=.FALSE.
	GOTO 75
C	NI NUMBERS INDIVIDUALLY
600	IER=3
	L=21
	L0=21
	GOTO 505
C	START SEARCHING
700	IER=10
	NOOUT=.FALSE.
	IF(KOL(1).EQ.0.OR.NPAR.EQ.0)GOTO 999
	IF(DEV4)WRITE(0,10700)CURGR
710	K=1
	IF(.NOT.AUTO)RETURN
	AUTO=.FALSE.
	WRITE(7,10710)NG,NK,HEAD,(I,I=1,NG)
	RETURN
C	S0	SEARCH ONLY COUNT NUMBERS
1700	NOOUT=.TRUE.
	K=1
	IER=10
	IF(KOL(1).EQ.0.OR.NPAR.EQ.0)GOTO 999
	RETURN
C	RECORD NO
1800	IER=11
	IF(KOL(NK).NE.0.AND.L1.NE.0)GOTO 999
	IFILL=L1.NE.0
	KOL(NK)=0
	GOTO 75
C	LIST
800	K=2
	TEMP(1)=3
	IF(DEV4)TEMP(1)=4
C	DEVICE FOR LIST
	IF(L1.EQ.4.OR.L1.EQ.3)TEMP(1)=L1
	RETURN
C	SCRATCH
900	IER=4
	ASSIGN 910 TO OK
	GOTO 1610
910	KOL(1)=0
	ALL=.TRUE.
	GOTO 10
C	MH MAIN HEADING
1000	IF(DEV4)WRITE(0,11000)
	READ(5,11500)HEAD
	GOTO 70
1100	IER=10
	IF(.NOT.AUTO)GOTO 999
	WRITE(7,10715)NG,NK,HEAD
C	SH SUBHEADINGS
	DO 1110 I=1,NG
	IF(DEV4)WRITE(0,11100)I
	READ(5,11500)TEXT
	WRITE(7,11500)TEXT
1110	CONTINUE
	AUTO=.FALSE.
	GOTO 70
C	OK ONLY LEGAL WHEN REQUESTED
1600	GOTO OK
1610	IF(.NOT.DEV4)GOTO OK
	WRITE(0,13000)
	GOTO 75
C	THE SEARCH PARAMETERS
C	IO IA OO OA
1200	IER=7
	IF(NPAR.EQ.10)GOTO 999
	IER=8
	IF(L1.LE.0.OR.L1.GT.NKOL)GOTO 999
	IF(L3.LT.L2.AND.L3.NE.0)GOTO 999
	NPAR=NPAR+1
	IF(DEV4)WRITE(0,11200)NPAR
	KOLS(NPAR)=L1
	INS(NPAR)=K.EQ.9
	AND(NPAR)=K0.EQ.1
	ONEOR=ONEOR.OR..NOT.AND(NPAR)
	DO 1210 I=1,2
1210	LIM(I,NPAR)=LIST(1+I)
	IF(L3.EQ.0)LIM(2,NPAR)=1E45
	GOTO 70
10000	FORMAT(' ENTER REQUEST')
12000	FORMAT(A2,30F10.0)
10700	FORMAT(' SEARCHING FOR GROUP',I8)
11000	FORMAT(' ENTER HEADER LINE')
11100	FORMAT(' GROUP ',I5,' :',$)
10710	FORMAT(2I3,/,12A6,/(,' GROUP NR',I3))
11500	FORMAT(12A6)
13000	FORMAT(' OK ??!')
11200	FORMAT(' QUESTION NR',I5)
14000	FORMAT(///)
10715	FORMAT(2I3,/12A6)
13100	FORMAT(' EXIT OS8')
	END
