C^  MARCH   19    1975
C	BIGERR
C	ERROR FUNCITON TO THE BIGSTA PROGRAM
C	ERRORS ARE FATAL IF NOT MANUAL QUESTIONS
C	ERROR CODES
C
C	100	NON EXISTENT CODE
C	0	CR NOT 1ST CARD OR CR AFTER 1ST CARD
C	1	BAD COLUMNS
C	2	BAD LIMITS ON LA
C	3	BAD LIMITS ON LI	ERROR 2 OR 3 NEGATES ALL LA LI
C	4	SC IN FILE
C	5	LATE MH
C	6	LATE SH
C	7	TOO MANY PARAMETERS
C	8	BAD CODE IN LI
C	9	LU<LL
C	10	NPAR=0 OR NO OUTPUT COLMS
	SUBROUTINE BIGERR(I)
	COMMON /PARAMS/DEV4
	LOGICAL DEV4
	WRITE(0,100)I
100	FORMAT('0ERROR CODE:',I5)
	IF(DEV4)RETURN
	WRITE(3,100)I
	REWIND 7
	STOP
	END
