C^  FEBRUARY   05    1976
C	STAT20
C	TABULATION AND PLOTS
	SUBROUTINE STAT20
	COMMON /PARAM/NGU,NGR,LIST,ATT,LDEVE,LDEVL,MISS,NOPAGE
	COMMON /DATA/XL0
	COMMON IAN,KOL1,KOL2,NK,N,IOPT
3000	FORMAT(1H0,15X,'E-LOGS OFF DATA')
1300	FORMAT(' CROSS-TABULATION   VERTICAL =KOL ',I2,
     *'  HORISONTAL=KOL',I2,/,' NO OF DATA =',I5//)
	DIMENSION XL0(1)
	DIMENSION XT(4),XYVAL(4)
	DIMENSION N0(51),X0(11)
	EQUIVALENCE (N0(1),X0(1),XT(1))
	EQUIVALENCE (XYVAL(1),XMIN),(XYVAL(2),YMIN)
     *,(XYVAL(3),XMAX),(XYVAL(4),YMAX)

1100	FORMAT(1X,G10.3,/,13X,3H  :,10(I7,'  :'))
1200	FORMAT(1X,G10.3,/,11X,11G10.3)
2100	FORMAT(1X,G10.3,5X,75A1)
2200	FORMAT(1X,G10.3,5X,6('+.........'),/,13X,6G10.3)
2000	FORMAT(1H1)
2300	FORMAT(' SCATTER PLOT  VERTICAL =KOL',I3,' HORISONTAL =
     *KOL',I3,/,' NO OF POINTS =',I5///)
2400	FORMAT(' PRESENT COORDINATES ARE:(X0,Y0,X1,Y1)',/,1X,4G12.4)
2500	FORMAT(' INPUT NEW COORDINATES IN SAME ORDER')
2600	FORMAT(4F10.0)
	LOGICAL PLOT,LOG,REQ,ATT,NOPAGE
	PLOT=IAN.EQ.21
	REQ=IOPT.LT.0.AND.PLOT
	IOPT=IABS(IOPT)
	LOG=IOPT.GE.100.AND.PLOT
	IF(IOPT.GE.100)IOPT=IOPT-100
	K1=(KOL1-1)*N
	K2=(KOL2-1)*N
	KX=NK*N
	KY=KX+N
	XMAX=-1E50
	XMIN=-XMAX
C	STEP NUMBERS AS FOLLOWS DEFAULTS()
C
C	NXST		NYST
C
CPLOT	50		IOPT(50)
C
CNOT PLOT
C
CKOL1<>KOL2
C	IOPT(5)		IOPT(5)
C
CKOL1=KOL2
C	IOPT(5)		1
	LOGICAL STATER
	K=2
999	IF (STATER(K,'20'))RETURN
	IF(PLOT)GOTO 10
	IF (IOPT.LT.3.OR.IOPT.GT.10)IOPT=5
	NXST=IOPT
	NYST=IOPT
	IF(KOL1.EQ.KOL2)NYST=1
	GOTO 20
10	IF(IOPT.LT.5.OR.IOPT.GT.50)IOPT=25
	NXST=50
	NYST=IOPT
20	K=0
	J=N*NK
	NT=0
	K=0
	DO 50 I=1,N
	X=XL0(K1+I)
	Y=XL0(K2+I)
	IF(X.EQ.0.OR.Y.EQ.0)GOTO50
	IF((X.LT.0.OR.Y.LT.0).AND.LOG)GOTO 999
	J=J+1
	NT=NT+1
	XL0(J)=X
	IF(LOG)XL0(J)=ALOG(X)
	XL0(J+N)=Y
	IF(X.GT.XMAX)XMAX=X
	IF(X.LT.XMIN)XMIN=X
50	CONTINUE
	IF(NT.LT.3)GOTO 999
	IF(LOG)XMAX=ALOG(XMAX)
	IF(LOG)XMIN=ALOG(XMIN)
	DO 70 I=1,NT-1
	DO 70 J=I+1,NT
	Y1=XL0(KY+I)
	Y2=XL0(KY+J)
	IF (Y1.GT.Y2)GOTO 70
	XL0(KY+I)=Y2
	XL0(KY+J)=Y1
	Y1=XL0(KX+I)
	XL0(KX+I)=XL0(KX+J)
	XL0(KX+J)=Y1
70	CONTINUE
	NTT=4*NT
	YMAX=XL0(KY+1)
	YMIN=XL0(KY+NT)
	IF(.NOT.REQ)GOTO 80
	WRITE(LDEVE,2400)XYVAL
	IF(ATT)WRITE(0,2500)
	READ(4,2600)XT
	DO 75 I=1,4
	IF(I.LT.3)XYVAL(I)=AMIN1(XT(I),XYVAL(I))
	IF(I.GT.2)XYVAL(I)=AMAX1(XT(I),XYVAL(I))
75	CONTINUE
80	IF(.NOT.PLOT)WRITE(LDEVL,1300)KOL2,KOL1,NT
	IF(PLOT.AND..NOT.NOPAGE)WRITE(LDEVL,2000)
	IF(PLOT)WRITE(LDEVL,2300)KOL2,KOL1,NT
	XST=(XMAX-XMIN)/NXST
	YST=(YMAX-YMIN)/NYST
	YU=YMAX+YST
	DO 200 I=1,NYST
	YU=YU-YST
	YL=YU-YST
	XL=XMIN-XST
	NXST1=NXST+1
	DO 100 J=1,NXST1
	N0(J)=0
	IF(PLOT)N0(J)=' '
100	IF(PLOT)N0(1)='.'
	XL=XL+XST
	L=1
	LM=1
	DO 60 K=L,NT
	X=XL0(KX+K)
	Y=XL0(KY+K)
	IF(Y.LE.YL.AND.I.NE.NYST)GOTO 90
	IF(Y.GT.YU.AND.I.NE.1)GOTO 60
	J=(X-XMIN)/XST+1.
	IF(J.GT.NXST1)J=NXST+1
	IF(.NOT.PLOT)N0(J)=N0(J)+1
	IF(PLOT.AND.N0(J).EQ.'*')N0(J)='#'
	IF(PLOT.AND..NOT.N0(J).EQ.'#')N0(J)='*'
	LM=K
60	CONTINUE
90	L=LM
	IF(.NOT.PLOT)WRITE(LDEVL,1100)YU,(N0(K),K=1,NXST)
	IF(.NOT.PLOT)GOTO 200
	DO 190 K=1,NXST1
	KM=NXST1+1-K
	IF(N0(KM).NE.' ')GOTO 195
190	CONTINUE
195	WRITE(LDEVL,2100)YU,(N0(K),K=1,KM)
200	CONTINUE
	K=NXST1
	X0(1)=XMIN
	IF(PLOT)GOTO 300
	DO 210 I=1,NXST
210	X0(I+1)=XMIN+XST*I
	WRITE(LDEVL,1200)YMIN,(X0(I),I=1,K)
	RETURN
300	DO 310 I=1,6
310	X0(I+1)=XMIN+XST*I*10
	WRITE(LDEVL,2200)YMIN,(X0(I),I=1,6)
	IF(LOG)WRITE(LDEVL,3000)
	RETURN
	END
