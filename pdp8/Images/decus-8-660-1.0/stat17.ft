C	STAT17
C	FRIEDMANS VARIANCE BY RANKS
	SUBROUTINE STAT17
	COMMON /PARAM/NGU,NGR,LIST,ATT,LDEVE,LDEVL,MISS,NOPAGE
	COMMON /DATA/XL
	DIMENSION XL(1)
	COMMON IAN,KOL1,KOL2,NK,N
C	IF THERE ARE MISSING DATA WE MUST "PACK THE MATRIX
1000	FORMAT(' FRIEDMANS ANALYSIS OF VARIANCE:'
     *,/' CHI-TWO-R=',F10.2,'  N.DF.=',I5' NUMBER IN KOL:',I5)
2000	FORMAT(1H ,'USE TABLE ',1A1,' IN SIEGEL')
	I=NK
	IF(MISS.GT.0)I=NK+NK
	LOGICAL STATER
	IF(NK.LT.3)I=0
999	IF(STATER(I,'17'))RETURN
	NT=N*NK
	INDX=1
	IF (MISS.EQ.0)GOTO 100
	L1=NT+1
	INDX=NT+1
	NT=0
	DO 30 I=1,NK
	K1=(I-1)*N
	DO 20 J=1,N
	DO 15 I2=1,NK
	IF(XL((I2-1)*N+J).EQ.0)GOTO 20
15	CONTINUE
	XL(L1)=XL(K1+J)
	L1=L1+1
	NT=NT+1
20	CONTINUE
30	CONTINUE
100	INDX2=INDX+NT
	I=0
	IF(NT.EQ.0)GOTO 999
	N1=NT/NK
	CALL TWOAV(XL(INDX),XL(INDX2),N1,NK,XL(INDX2+NT),XR,NDF,0)
	WRITE(LDEVL,1000) XR,NDF,N1
	I='C'
	IF(NK.EQ.3.AND.N1.LE.9.OR.NK.EQ.4.AND.N1.LE.4)I='N'
	WRITE(LDEVL,2000)I
	CALL KOLSUM(INDX2,N1,'A8')
	RETURN
	END
