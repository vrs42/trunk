C	ANOVA
C	JAN 74
C	ANOVA FROM SSP MANUAL
C	ADAPTED TO USE FILES IN OUTLAY FORMAT
C	THE INPUT FILE <UNIT 6> IS AN OUTLAY FILE WITH THE FOLLOWING
C	RESTRICTIONS
C
C	CARD 1 GROUPS=LEVELS
C	KOLUMNS USED FOR READING ONLY
C	CARD 2 MUST CONTAIN
C		CONVERSION CODE		COL 1
C		MAIN HEADING(OPTIONAL)COL 2-13
C
C	THE GROUP HEADING CARDS SHOULD GIVE A ONE LETTER
C	IDENTIFICATION CODE IN POS 1
C	AND A NUMBER OF OBSERVATIONS IN LEVEL IN 2-5
C	GROUP NUMBERS IN INPUT DATA ARE IGNORED
C
	DIMENSION X(1000),P(2)
	DIMENSION SUMSQ(31),NDF(31),SMEAN(31)
	DIMENSION IHEAD(5),LEVEL(5),ISTEP(15),LASTS(5)
	DIMENSION MT(10)
1	FORMAT(2I3,/,2A6,I1,/,(A1,I4))
2	FORMAT('1ANALYSIS OF VARIANCE....',2A6,/
     1,' DATE ',I4,'-',I2,'-',I2,10X,'CONVERSION CODE   ',I3,//)
3	FORMAT(' LEVELS OF FACTORS'/(3X,A1,7X,I4))
4	FORMAT(//' GRAND MEAN'F20.5////)
5	FORMAT(' SOURCE OF'13X,'SUMS OF',4X,'DEGREES OF'
     1,9X,'MEAN',/,' VARIATION',13X,'SQUARES'5X,'FREEDOM'
     210X,'SQUARES')
6	FORMAT(1X,10A1,F20.5,4X,I6,F20.5)
7	FORMAT(' TOTAL',5X,F20.5,I10)
8	FORMAT(3X,(7E11.4))
	DATA X,IBLANK/1000*0.,1H /
100	READ(6,1)K,NK,P,IOPT,(IHEAD(I),LEVEL(I),I=1,K)
101	N=LEVEL(1)
	DO 102 I=2,K
102	N=N*LEVEL(I)
	IOPT=IOPT+1
	J=1
60	K1=J+NK-1
	READ(6,8)(X(I),I=J,K1)
	J=J+NK
	IF(J.LE.N)GOTO 60
	DO 80 I=1,N
	XT=X(I)
C	1=NO CHANGE
C	2=LN(X)
C	3=LN(X+1)
C	4=SQRT(X)
C	5=SQRT(X+0.5)
C	6=ARCSIN(SQRT(X))
C	7=ARCSIN(SQRT(X/100))
	GOTO(80,71,72,73,74,75,76),IOPT
72	XT=XT+1.
71	XT=ALOG(XT)
	GOTO 80
74	XT=XT+0.5
73	XT=SQRT(XT)
	GOTO80
76	XT=XT/100.
75	XT=SQRT(XT)
	XT=ATAN(XT/SQRT(1.-XT*XT))
80	X(I)=XT
	CALL AVDAT(K,LEVEL,N,X,L,ISTEP,KOUNT)
	CALL AVCAL(K,LEVEL,X,L,ISTEP,LASTS)
	CALL MEANQ(K,LEVEL,X,GMEAN,SUMSQ,NDF,SMEAN,ISTEP)
	IOPT=IOPT-1
	CALL DATE(IM,ID,IY)
	WRITE(3,2)P,IY,IM,ID,IOPT
	WRITE(3,3)(IHEAD(I),LEVEL(I),I=1,K)
	WRITE(3,4)GMEAN
	WRITE(3,5)
	LL=(2**K)-1
	ISTEP(1)=1
	DO 105 I=2,K
105	ISTEP(I)=0
	DO 110 I=1,10
110	MT(I)=IBLANK
	NN=0
	SUM=0.0
120	NN=NN+1
	L=0
	DO 140 I=1,K
	MT(I)=IBLANK
	IF(ISTEP(I))130,140,130
130	L=L+1
	MT(L)=IHEAD(I)
140	CONTINUE
	WRITE(3,6)(MT(I),I=1,10),SUMSQ(NN),NDF(NN),SMEAN(NN)
	SUM=SUM+SUMSQ(NN)
	IF (NN-LL)145,170,170
145	DO 160 I=1,K
	IF(ISTEP(I))147,150,147
147	ISTEP(I)=0
	GO TO 160
150	ISTEP(I)=1
	GOTO 120
160	CONTINUE
170	N=N-1
	WRITE(3,7)SUM,N
200	CALL EXIT
	END
