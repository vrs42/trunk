C	STAT
C	FILE STAT0.FT
C	PART OF STAT
	SUBROUTINE STAT
C	STAT MAIN INPUT X UNIT
C	CORE BUILD UP SEE BATCH FILES
C
C	IO UNITS
C	0	ERROR MESSAGES OUT ALWAYS TTY
C	3	RESULTS
C	4	PARAMETERS INPUT STB4 FORMAT
C	6	DATA INPUT OUTLAY FORMAT
	COMMON  IAN,KOL1,KOL2,NK1,N
	COMMON /DATA/XL
	COMMON /PARAM/NGU,NGR,LIST,ATT,LDEVE,LDEVL,MISS,NOPAGE
	LOGICAL ATT
	LOGICAL LIST,NOPAGE
	COMMON /SHEFFE/DUM(23),FLAGS(4)
	DIMENSION XL(1)
	COMMON /SIZE/MAXXL,NOKOLL(100)
C	NOKOLL IS FILLED BY INIT
	DIMENSION K1(10),IG1(100),X(10)
	DIMENSION T1(12),T2(3)
	EQUIVALENCE (T1,T2)
2020	FORMAT(///)
2010	FORMAT(1H1)
1301	FORMAT(1H ,25I3)
1300	FORMAT(25I3)
1100	FORMAT(2I3,/,12A6)
1200	FORMAT(' HASSLE STAT ',5X,I4,1H-,I2,1H-,I2,5X,'MAIN
     * HEADING: '/,1X,12A6)
1000	FORMAT(1H ,I5,'  ',3A6,I7,' ROWS')
1500	FORMAT(3A6)
1700	FORMAT(I3,7(F11.0))
1810	FORMAT(' JOB ABORTED')
1800	FORMAT(' MORE THAN ',I7,' OBSERVATIONS TOTAL')
1900	FORMAT(I5,'  ROWS',I6,'  COLMS :  ',10I4)
2000	FORMAT(I8,' MISSING DATA')
2200	FORMAT(' GROUPS?')
2100	FORMAT(' KOLUMNS?')
1	REWIND 6
	MISS=0
	READ(6,1100)NG,NK,T1
	IF(ATT)WRITE(0,2200)
	READ(4,1300)NG1,(IG1(I),I=1,NG1)
	IF(NG1.LT.0)GOTO 300
	IF(NGR.GT.0)GOTO 998
50	IF(NG1.GT.NG)NG1=NG
45	DO 100 I=1,NG1
	IF(IG1(I).LE.0)IG1(I)=I
	IF(IG1(I).GT.NG)GOTO 990
100	CONTINUE
	IF(LIST)WRITE(0,1301)NG1,(IG1(I),I=1,NG1)
	IF(ATT)WRITE(0,2100)
	READ(4,1300)NK1,(K1(I),I=1,NK1)
	IF(NK1.GT.NK)NK1=NK
	DO 110 I=1,NK1
	IF(K1(I).LE.0)K1(I)=I
	IF(K1(I).GT.NK)GOTO 990
110	CONTINUE
	IF(LIST)WRITE(0,1301)NK1,(K1(I),I=1,NK1)
C	NOW COUNT NUMBER OF ROWS IN REQUESTED DATA
	N=0
	DO 10 I=1,NG
	DO 10 J=1,NG1
	IF(I.NE.IG1(J))GOTO 10
	N=N+NOKOLL(I)
10	CONTINUE
C	NOW N IS TOTAL NO OF ROWS IN MATRIX
	IF(N.EQ.0)GOTO 998
	IF (.NOT.NOPAGE)WRITE(LDEVL,2010)
	CALL DATE(I,J,K)
	IF(.NOT.NOPAGE)WRITE(LDEVL,1200)K,I,J,T1
	IF(NOPAGE)WRITE(LDEVL,2020)
	DO 9 I=1,NG
	READ(6,1500)T2
	DO 9 J=1,NG1
	IF(I.NE.IG1(J))GOTO 9
	WRITE(LDEVL,1000)I,T2,NOKOLL(I)
9	CONTINUE
	IF(N*NK1.GT.MAXXL)GOTO 99
	L1=0
2	READ(6,1700)I,(X(K),K=1,NK)
	IF(I.LE.0)GOTO 5
3	DO 30 J=1,NG1
	IF(I.NE.IG1(J))GOTO 30
	L1=L1+1
26	DO 27 K=1,NK1
	L=(K-1)*N+L1
C	WE SAVE THE DATA IN A SIMULATED N BY NK MATRIX
	XL(L)=X(K1(K))
	IF(XL(L).EQ.0)MISS=MISS+1
27	CONTINUE
30	CONTINUE
	IF(L1.LT.N)GOTO 2
C	WE MIGHT FIND ALL DATA BFORE READING ALL THE FILE
C	SO SAVE SOME TIME
5	WRITE(LDEVL,1900)N,NK1,(K1(I),I=1,NK1)
	WRITE(LDEVL,2000)MISS
	RETURN
99	WRITE(LDEVL,1800)MAXXL
999	WRITE(LDEVE,1810)
C	SKIP CARDS ON ERROR
C	RETURNS WITH I=0 OR 50
C	BACSPACED IF I=50
998	CALL STATSK(I)
	IF(I.EQ.50.AND.NGR.EQ.0)STOP
	IF(I.EQ.0)GOTO 1
	RETURN
990	L1=STATER(0,' ')
	GOTO 999
300	NG1=1
C	WE CANNOT READ THE ARGUMENTS AS NGR=-1
C	SO WE MUST RE-READ THE CARD
	BACKSPACE 4
	READ(4,1300)I,J,K
	IF(NGR.EQ.0)NGR=-MAX0(1,J)
	NGU=NG
	IF(K.GT.0)NGU=K
	IG1(1)=IABS(NGR)
	GOTO 50
	END
