C	STAT 18
C	PART OF STAT
C	ASSUMING KOL1 TO BE X AND KOL2 TO BE
C	Y STAT18 CALCULATES AREA UNDER CURVE
C	AREA IS CALCULATED BY OVERLAPPING PARABOLAS
C	BUT ON IOPT<>0 ALSO BY A SIMPLE
C	TRAPETS FORMULA
C	* IS PRINTED IF AREAS DIFFER BY MORE THAN DIFF %
C	IF IOPT =0 PRINTS ONLY TOTAL AREA
C	ELSE ALL PARTIAL AREAS
	SUBROUTINE STAT18
	COMMON /PARAM/NGU,NGR,LIST,ATT,LDEVE,LDEVL,MISS,NOPAGE
	COMMON /DATA/XL
	COMMON IAN,KOL1,KOL2,NK,N,IOPT
	DATA DIFF/10.0/
	DIMENSION XL(1)
1000	FORMAT('0X = KOL ',I3,' Y= KOL',I3
     *,/'  TOTAL AREA BY PARABOLA ='G15.4,'BY TRAPEZE ',G15.4)
2000	FORMAT(1H0,8X,1HX,14X,1HY,13X,4HAREA,7X,'TRAPEZE '
     *,6X,'CUM AREA',5X,'>',F5.1,'%')
4000	FORMAT(1H ,5G15.4,A6)
	NT=NK*N
	KX=NT
	KY=NT+N
	K1=(KOL1-1)*N
	K2=(KOL2-1)*N
	K4=NT+2*N
	K5=NT+3*N
	LOGICAL STATER
	I=4
999	IF(STATER(I,'18'))RETURN
	X1=-1E10
	N1=0
	IY=NT+N
	DO 100 I=1,N
	X=XL(K1+I)
	Y=XL(K2+I)
	IF(X.EQ.0.OR.Y.EQ.0)GOTO 100
	IF(X.LE.X1)GOTO 100
	N1=N1+1
	X1=X
	XL(NT+N1)=X
	XL(IY+N1)=Y
100	CONTINUE
	I=0
	IF(N1.LE.3)GOTO 999
	CALL NUMINT(N1,XL(NT+1),XL(IY+1),XL(K4+1))
	XT=0
	ZT=0
	XL(K5+1)=0
	DO 150 I=2,N1
	XT=XT+XL(K4+I)
	X1=XL(KX+I-1)
	X2=XL(KX+I)
	Y1=XL(KY+I-1)
	Y2=XL(KY+I)
	A=AMAX1(Y1,Y2)
	B=AMIN1(Y1,Y2)
	Z=(X2-X1)*(B+(A-B)/2.)
	ZT=ZT+Z
150	XL(K5+I)=Z
	WRITE(LDEVL,1000)KOL1,KOL2,XT,ZT
	IF(IOPT.EQ.0)RETURN
	WRITE(LDEVL,2000)DIFF
	ZT=0
	XT=0
	DO 200 I=1,N1
	X=' '
	Z=XL(K5+I)
	X1=XL(2*N+NT+I)
	XT=XT+X1
	IF(I.EQ.1)GOTO 200
	IF(ABS(Z-X1)/((X1+Z)/2.)*100..GT.DIFF)X='*'
200	WRITE(LDEVL,4000)(XL((J-1)*N+NT+I),J=1,4),XT,X
	RETURN
	END
