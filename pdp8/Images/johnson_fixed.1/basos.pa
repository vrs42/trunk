	DCA HANDAD
	CLA IAC		/AC=0001
	JMP RGETPG	/NOW GET PROGRAM TO BE RUN
GDEVNO,	0		/GET DEV NUM VIA USR
	JMS I [MINCOR	/LOCK USR INTO CORE
	JMS I GNAME	/GET SPEC
	JMP I [KMER4	/NONE-"TOO FEW ARGS"
