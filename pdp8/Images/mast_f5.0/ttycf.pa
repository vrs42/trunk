/	VERS=	4
/
/
/EDIT HISTORY:
/
/01-AUG-77: (LHN)
/	1)  CREATED THIS DATE.
/
/12-JUN-91	(LHN)		VERSION 4
/	1)  DELETED EPLTEST FLAG CONDITIONALS
/	2)  ENABLED CTRL/Q AND CTRL/S
/

/
/	FILE TO CONFIGURE THE RTS/8 TERMINAL HANDLER
/
/
/	THE PARAMETERS CONTAINED HERE CAN BE DEFINED HERE
/	OR  THEY  CAN BE DEFINED IN THE PARAMETER FILE OR
/	THEY CAN BE DEFINED DIRECTLY IN THE TTY.PA SOURCE
/	FILE. (BUT, THEY MUST BE DEFINED SOMEWHERE!)
/
/	USERS WHO WISH TO USE MORE THAN ONE  TTY  HANDLER
/	CAN  MAKE  MULTIPLE  COPIES OF THIS CONTROL FILE,
/	EDITING EACH COPY FOR THE TERMINAL  CONFIGURATION
/	DESIRED.  EACH  CONTROL  FILE  IS  THEN ASSEMBLED
/	WITH PARAM.PA AND TTY.PA TO GENERATE THE REQUIRED
/	TERMINAL HANDLERS.
/
/	THE TERMINAL  HANDLER  CONFIGURATION  DEFINITIONS
/	BELOW  DEFAULT  TO 0 (IN TTY.PA) UNLESS OTHERWISE
/	SPECIFIED.  PARAMETERS NOT EQUATED HERE SHOULD BE
/	DELETED OR COMMENTED OUT.
/
/
/	TERMINAL HANDLER CONFIGURATION DEFINITIONS
/
CONSOL=	1	/1 MEANS CONSOLE TTY (DEFAULT)
VT50=	1	/1 ENABLES CTRL/S AND CTRL/Q FUNCTIONS
SCOPE=	0	/1 MEANS TTY CAN DO A BACKSPACE
FILL=	0	/NUMBER OF FILL CHARACTERS, I.E. 4
WIDTH=	120	/TTY LINE WIDTH (0 MEANS INFINITE),
		/ DEFAULT IS 120(8) OR 80(10)
TAB=	0	/1 IF TTY HAS HARDWARE TABS
OLDTTY=	0	/1 TO USE OLD 2-PAGE TTY HANDLER
LSBOT=	0	/1 TO LIST BOTH HANDLERS (DEFAULT 0)
/
/
/	ORIGIN AND DEVICE ASSIGNMENTS, IF NOT IN PARAM.PA
/
/TASK=		/TASK NAME FOR THIS COPY OF THE TTY
		/ HANDLER, DEFAULT IS "TTY".
/TTYFLD=	/FIELD OF THIS TTY TASK
/TTYLOC=	/LOCATION OF THIS TTY TASK
/TTDEV=		/PRINTER DEVICE CODE - DEFAULT IS 04
/KBDEV=		/KEYBOARD DEVICE CODE - DEFAULT IS TTDEV-1

