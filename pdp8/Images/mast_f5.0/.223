/
/
/	MOVE TEXT TO ANOTHER BUFFER/
/	CALLING EXAMPLE:
/
/	JMS GETTXT
/	  ARG1 => ADDRESS OF THE SOURCE TEXT BUFFER.
/	  ARG2 => ADDRESS OF THE DESTINATION TEXT BUFFER.
/	  ARG3 => LENGTH OF TEXT TO MOVE.
/
/
TXMOVE, 0
	CLB
	TAD I TXMOVE	/GET THE ADDRESS OF THE TEXT TO
	ISZ TXMOVE	/ MOVE.
	DCA TXMA
	TAD I TXMOVE	/GET THE DESTINATION ADDRESS FOR
	ISZ TXMOVE	/ THE TEXT.
	DCA TXMB
	TAD I TXMOVE	/GET THE LENGTH OF TEXT TO MOVE.
	ISZ TXMOVE
	CIA
	DCA TXMC

TXM1,	TAD I TXMA	/MOVE A WORD OF TEXT.
	ISZ TXMA
	DCA I TXMB
	ISZ TXMB
	ISZ TXMC	/MORE TO DO ?
	JMP TXM1	/YES, DO IT AGAIN.

	JMP I TXMOVE

TXMA,	0		/LOCAL TEMPORARIES.
TXMB,	0
TXMC,	0

	PAGE

