/
EORREJ,	42		/178 MM CHOP LENGTH
	37		/198
	32		/238
/	24		/296
	24		/298
	21		/354
	17		/398
/	16		/430

/
/
/	NUMBER OF SAMPLES FOR START/END ROLL SAMPLING
/
/
EORSAM,	5		/178 MM CHOP LENGTH
	5		/198
	4		/238
/	3		/296
	3		/298
	3		/354
	2		/398
/	2		/430

/
/
/	NUMBER OF REJECTS FOR IN-ROLL SPLICE SAMPLING
/
/
INRREJ,	11		/178 MM CHOP LENGTH
	10		/198
	6		/238
/	5		/296
	5		/298
	4		/354
	4		/398
/	4		/430

/
/
/	NUMBER OF SAMPLES FOR IN-ROLL SPLICE SAMPLING
/
/
INRSAM,	5		/178 MM CHOP LENGTH
	5		/198
	4		/238
/	3		/296
	3		/298
	3		/354
	2		/398
/	2		/430

	PAGE
	NOPUNCH
	XLIST 1

