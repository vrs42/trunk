LDATA=7757	/LIST THE DATAAREA
LCONFG=7767	/LIST THE CONFIGURATION PART
LLOCAL=7773	/LIST ALL LOCAL INSERTED CODE
LFPP=7775	/LIST FPP EMULATOR
