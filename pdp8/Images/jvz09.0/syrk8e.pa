	VERSION="F&77

	*0
	-3

	DECIMAL;RKLEN=3248;OCTAL

	DEVICE RK8E;DEVICE SYS;4231;6007;0;RKLEN
	DEVICE RK8E;DEVICE RKA0;4431;5007;0;RKLEN
	DEVICE RK8E;DEVICE RKB0;4431;SHNDL1&177+5000;0;RKLEN%4
/ONE RK8E IS TREATED AS TWO LOGICAL DISKS: 'SYS' OR 'RKA0' IS
/3248 OS/8 BLOCKS, WHILE 'RKB0' IS 1/4TH OF THAT.  WHICH 4TH
/IS DETERMINED BY THE USER THROUGH AN '.AS DSK 0-3' COMMAND.

/THIS HANDLER CONTAINS ENTRY POINTS FOR THE SYSTEM DEVICE
/AND RKB0.  THIS VERSION ALLOWS BOOTING UP ON EITHER UNIT.

/MAINTENANCE RELEASE CHANGES:

/1.	FIXED BUG RE INTERACTION WITH NON-SYSTEM HANDLER
/	[APRIL DSN]
/
/2.	MODIFIED BOOTSTRAP CODE TO NOT CHANGE DATE ON
/	BOOTSTRAP.	[SIMPLIFIED BY JVZ, 5-AUG-80]
/	IDEA BY R. MURPHY:  DEC, SOFTWARE OPERS GROUP
/	2525 AUGUSTINE DRIVE, SANTA CLARA, CA.	95051
/
/3.	MADE PROVISION IN BOOTSTRAP FOR PUTTING PRIMARY
/	BOOT AT LOCATION 40 INSTEAD OF LOCATION 30.
/	[EASIER TO MANIPULATE THE SWITCHES ON AN 8/E...]
/	ADDED 2-SEP-79 BY JIM VAN ZEE:	LAB DATA SYSTEMS
/	10320 RAVENNA AVENUE N.E., SEATTLE, WASH.  98125
	BOOT-BLAST	/LENGTH OF BOOTSTRAP (FOR BUILD)

	RELOC 0

BOOT,	TAD I BOOTX1	/RELOCATE 200 TO 07600
	DCA I BOOTX2
	CDF 20
	TAD I BOOTX3	/& 27447 TO 17647, ETC.
	ISZ BM20
	CDF 10		/SKIPPED AT LOCN 17666
	DCA I BOOTX4
	CDF 0
	ISZ BM177	/-200 WILL STORE 07777
	JMP BOOT
	JMP I B7605	/BOOT TO OS/8

BOOTX1,	177		/MUST BE HERE TO BE AUTO-INDEX!!
BOOTX2,	7577
BOOTX3,	7446
BOOTX4,	7646

BM20,	7646-7666	/SKIPS AT 17666
BM177,	-200		/PROTECTS 07777

PART2,	JMS I B207	/USE HANDLER TO READ PATCH
	0220
	7400
	0066		/BLOCK 66 HAS FIELDS 1 & 2
	HLT
	JMP BOOT	/NOW MOVE FIELD 0,1 CODE
B207,	SHNDLR&377

	ZBLOCK	30-.	/DSKP GOES OVER 30
	DSKP		/LOADS OVER TOGGLE-IN.
	JMP .-1
BOOT32,	AND RK6
	DCA I RKUNIT
	JMP PART2

RK6,	6
RKUNIT,	SYSUNT&377	/CHANGED BEFORE IT IS MOVED
B7605,	07605

	ZBLOCK 40-.	/ALTERNATE BOOT LOCATION
	DSKP		/EASIER TO ENTER ON 8/E:
	JMP .-1		/LOC 40: 6743
	JMP BOOT32	/LOC 41: 5041
BLAST,	RELOC
/THE BOOTSTRAP IS RK8E ONLY
/	30	6743
/	31	5031

/LOAD ADDRESS 30 AND START

/BOOTSTRAP FOR OTHER UNITS:

/	25	7604
/	26	6746
/	27	6743
/	30	7604
/	31	5031

/SET UNIT NUMBER IN SW 9,10
/LOAD ADDRESS 25 AND START

/FOR EASE IN SETTING THE SWITCH REGISTER
/THESE BOOTSTRAPS MAY BE RELOCATED BY 10
/I.E.

/	40	6743
/	41	5041

/LOAD ADDRESS 40 AND START

/OR, FOR BOOTING UP RKB0:

/	36	6746
/	37	1042
/	40	6743
/	41	5041
/	42	6260

/LOAD ADDRESS 36 AND START
/(REQUIRES PATCH TO SYSTEM ON RKB0)


/	DISK INSTRUCTIONS

	DSKP=6741
	DCLR=6742
	DLAG=6743
	DLCA=6744
	DRST=6745
	DLDC=6746
	DMAN=6747

	RKEBLK=7750	/12 BITS OF BLOCK NUMBER
	SERRCT=7751	/HOLDS RETRY COUNT
	PAGCNT=7752	/PAGE COUNT
	RKECMD=7753	/BASE OF DLDC COMMAND
	CHKHED=7754	/CHECK HEADER FLAG
	GT7777=7755	/M.S. CYLINDER BIT
	*200
	RELOC 7600

	ZBLOCK 7
SHNDLR,	VERSION		/SYSTEM HANDLER ENTRY POINT
	CLA CLL		/GUARD AGAINST RANDOM AC
SCIF,	CIF 0		/FOR RESTORING USERS FIELD
IFNZRO	.-7612 <ERROR1, BARF>
	3		/FLAG FOR 'TWO-PAGE' HANDLER
	TAD SHNDLR
	DCA SHNDL1	/SETUP COMMON EXIT AND PARM ADDR'S
SHNDC,	DCA SHNDLR	/SET BLOCK OFFSET FOR SYS OR RKB0
	RAL
	DCA GT7777
	CLA CLL CMA RTL	/AC=-3
	DCA SERRCT	/RETRY COUNT
	RDF
	TAD SCIF
	DCA SFIELD	/RESET USER INST FIELD FOR EXIT
RETRY,	TAD SHNDL1	/AC=-2 IF ERROR ENTRY
	DCA SHNDL1
	TAD I SHNDL1	/GET ARG1
	AND S4070	/GET R/W AND DF BITS
	TAD SYSUNT
	TAD GT7777
	DCA RKECMD	/BASE COMMAND TO RK8E(DLDC)
	TAD I SHNDL1	/GET ARG1 AGAIN
	ISZ SHNDL1	/POINT TO ARG2
	AND S3700
	JMP CONTD	/JUMP TO COMMON CODE

S4070,	4070		/USED TO GET READ/WRITE AND DF BITS

IFNZRO .-7641 <ERROR1, DOUBLE BARF>
SHNDL1,	VERSION		/2ND E.P. FOR RKB0 AND TEMPORARY
	CIF 20		/MUST BE AT 7642
	JMP SPLIT	/SPLIT 'RKB0' INTO 4 PIECES

S7600,
RKDONE,	CLA I		/NORMAL RETURN
	ISZ SHNDL1
SFIELD, HLT		/RESET USERS INST FIELD
	ISZ SHNDL1	/IF JUMPED TO HERE- ERROR RETURN
	JMP I SHNDL1	/EXIT

CONTD,	SNA
	STL CLA RAR	/4000
	DCA PAGCNT	/SAVE PAGE COUNT
	TAD I SHNDL1	/GET ARG2
	ISZ SHNDL1	/POINT TO ARG3
	DLCA		/LOAD CURRENT ADDRESS REGISTER
	TAD I SHNDL1	/GET ARG3
	CLL	
	TAD SHNDLR	/SYS OR RKB0 DISPLACMENT
	DCA RKEBLK	/LOW PART OF RK8E BLOCK NUMBER
	SZL		/STILL OFF IF BELOW BLOCK 10000
OVRFLO,	ISZ RKECMD	/TURN ON EXTENDED BIT IF OVERFLOWED
RELOOP,	DCA CHKHED	/SET CHECK HEADER FLAG TO EITHER 0 OR
			/4000(WHICH GETS RTR'D BEFORE USED) AND
			/CAUSES EITHER A "DATA" OR "ALL" TRANSFER
	TAD PAGCNT	/TEST TO SEE IF ONLY 1 PAGE WANTED
	AND S7600
	SNA CLA
	TAD S400	/100 WAS IN PAGCNT
	TAD CHKHED	/ADD IN CHECK HEADER FLAG
	CLL RTR		/SHIFT TO CORRECT BITS
	TAD RKECMD	/ADD IN BASE COMMAND
	DLDC		/LOAD COMMAND REGISTER
	TAD RKEBLK
	DLAG		/LOAD BLOCK REGISTER AND GO
IFNZRO .-7700 <ERROR2, TRIPLE BARF>
SYSUNT,	0		/SYSTEM DEV UNIT # (SET BY BOOTSTRAP)
			/PROTECTION AGAINST JMS I 7700 FIELD 0
	DSKP		/WAIT ON FLAG
	JMP .-1
	DRST		/READ COMPLETION REGISTER
	CLL RAL		/GET RID OF SUCCESS BIT
	SZA CLA		/AND SEE IF ANYTHING LEFT
	JMP SERROR	/AN ERROR
	TAD PAGCNT
	TAD S7600
	SPA SNA
	JMP RKDONE
	DCA PAGCNT
	TAD RKEBLK
	CMA
	AND S37		/IF BLOCK IS AT A 37 MAKE
			/NEXT OPERATION DO A CHECK HEADER
	SZA CLA
	STL RAR		/SET AC TO "ALL" FLAG
	ISZ RKEBLK	/BUMP BLOCK NUMBER
	JMP RELOOP	/TRANSFER SOME MORE
	JMP OVRFLO	/PAST BLOCK 7777-SET EXTENDED BIT

			/RECALIBRATE ON ALL ERRORS
SERROR, DCLR		/CLEAR STATUS REGISTER
	STL RTL		/AC=2
	DCLR		/RECALIBRATE DRIVE
	DSKP		/WAIT ON FLAG
	JMP .-1
	DCLR		/CLEAR STATUS REGISTER
	DRST		/WAIT FOR STATUS TO CLEAR
	SZA CLA
	JMP .-3		/V3C STILL DOING RECALIBRATE
	CLA CLL CMA RAL /AC=-2
	ISZ SERRCT	/SKIP IF WE TRIED 3 TIMES
	JMP RETRY	/TRY AGAIN
	JMP SFIELD	/ERROR EXIT
S37,	37		/USED TO CHECK FOR CYLINDER CHANGE
S400,	400		/ " FOR 128 WORD TRANSFER MODE(RTR'D IN CODE)
S3700,	3700		/ " TO GET PAGE COUNT
	RELOC
	PAGE
NOPUNCH;FIELD 2;ENPUNCH	/FIELD 2 CODE
RELOC	7600
SPLIT,	CLA I		/CODE TO DIVIDE RKB0 IN 4 PARTS
	RDF
	TAD RKCDF
	DCA XCDF
	CDF 10		/LOOK AT LOCATION 17742
	TAD I S7742
XCDF,	HLT		/RESTORE DATA FIELD
	AND RK300
	CLL RTR
	RTR
	RTR
	CMA CLL
	DCA XCDF	/SET COUNTER
	TAD OFSET
	TAD RK812
	ISZ XCDF
	JMP .-2
	CIF 0
	JMP SHNDC	/RETURN WITH OFFSET
RKCDF,	CDF
RK300,	300
RK812,	6260%4		/SPLIT RKB0 INTO 4 PIECES
OFSET,	6260%4^3
S7742,	7742
	RELOC

/HERE IS HOW THIS SCHEME WORKS:

/'RKB0' MAY BE EQUATED WITH ANY ONE OF 4 AREAS ON THE
/'SECOND HALF' OF THE DISK, EACH OF WHICH IS 1/4 THE
/SIZE OF 'RKA0'.  TO SELECT THE FIRST AREA ('AREA 0')
/USE THE '.ASSIGN' COMMAND TO 'ASSIGN DSK 0':
/
/	.AS DSK 0
/
/TO SWITCH TO 'AREA 1', JUST SAY '.AS DSK 1', AND SO
/ON FOR 'DSK 2' AND 'DSK 3'.  ALTERNATIVELY, A USER
/PROGRAM CAN PUT A VALUE (0,100,200,300) IN LOCATION
/17742 TO SWITCH AREAS DYNAMICALLY.  THIS LOCATION IS
/MODIFIED BY ODT WHEN USING THE BREAK-POINT FEATURE!

/THE 'DEVICE TYPE' FOR 'RKB0' HAS BEEN CHANGED FROM
/'23' TO '43'.  PIP.SV MUST BE PATCHED AT LOCATION
/'13643' TO HAVE 6324 (-^D3248/4 USING FUTIL).
	$
