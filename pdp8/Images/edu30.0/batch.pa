	COLMAX=50

GETLINE,0
NEWLINE,TAD L200
	KRS
	TAD L7403
	SNA CLA
	KSF
	SKP
	JMP KEYX
	RCSE		/START CARD IF READY
	JMP NOTRDY	/NO CARD READY GO ASK ABOUT IT
	DCA LCTR	/INIT CHAR COUNT TO ZERO
	DCA BADFLG	/CLEAR BAD CHAR COUNT
	DCA INVFLG	/CLEAR INVALID CHAR COUNT
	DCA CFLG	/CLEAR COMMAND FOUND FLAG
	DCA COL		/INIT CARD COLUMN COUNT TO ZERO

NEXTC,	TAD CONST	/INIT COUNTERS FOR TIMEOUT LOOP
	DCA TEMP1
	DCA I PRDTIM
TEST,	RCSF		/IS NEXT COLUMN READY?
	JMP EOC		/NO, GO SEE IF CARD IS DONE
	RCRB		/READ THE CHAR AND SAVE IT
	DCA CHAR
	TAD COL
	TAD (COLMAX
	SPA CLA
	JMS I (TRANS
	ISZ COL
	JMP NEXTC

