/
/  TABLE OF SYSTEM COMMANDS
/
/  FORMAT OF ENTRY
/	1ST WORD:  -(FIRST TWO LETTERS OF COMMAND NAME)
/	2ND WORD:  -(LEFT-JUSTIFIED THIRD LETTER OF COMMAND NAME)
/	3ND WORD:  (ADDR. OF PROCESSING ROUTINE)^2 + P
/		IF P=0 COMMAND IS PRIVILEGED
/		IF P=1 COMMAND IS NOT PRIVILEGED
/
PTRCOM,	.
	-1714;-0400; OLD^2+1
	-1605;-2700; NEW^2+1
	-2225;-1600; RUN^2+1
	-1501;-3000; MAX^2+0
	-1417;-0700; LOG^2+0	/IF NO BATCH LOG:  WHAT^2+0
	-1420;-2400; LPT^2+1	/IF NO LP08 PRINTER:  WHAT^2+0
	-2424;-3100; TTY^2+1
	-2301;-2600; SAVE^2+0
	-2205;-2300; RESEQUENCE^2+1
