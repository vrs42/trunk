/   "DEBUG"  -  HANDLE VARIOUS DEBUGGING FUNCTIONS
/      CONTROL-INPUT IS VIA "COMMANDER-CODY"

DBGST,	CLL CLA
	JMS I [TCRLF
	JMS I (EXTOUT
	MPEQ		/ "P = "
	JMS PRTPC	/ GO PRINT P-COUNTER
