STBKP,	TAD R1
	CLL RAR
	MQL
	TAD R2
	RAR
	CIA
	DCA BKP+1
	MQA
	CLL RTL
	RAL
	TAD (CDF 0
	CIA
	DCA BKP
	DCA STEP	/ TURN OFF STEP MODE
WKBK,	TAD (TAD STEP
