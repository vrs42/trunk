C ROUTINE TO WAIT FOR BEGINNING
C OF NEXT LINE.
C FOR COM3.FT
	SUBROUTINE BOL(I)
	COMMON ICHAR,IERCT
	I=0
	N=0
	M=16
2	N=N+1
	IF(N-M)3,3,9
3	CALL RCHAR
	IF(ICHAR-43)4,11,4
4	IF(ICHAR-10)5,6,5
5	IF(ICHAR-42)2,12,2
6	N=12
	GO TO 2
9	I=1
11	RETURN
12	CALL RCHAR
	IF(ICHAR-42)9,13,9
13	N=-60
	GO TO 2
	END
