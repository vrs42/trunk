	COMMON FNP,FNW,RW,JW,JW3,NP,NW,NBLK,IMOV
	COMMON XP,YP,ZP,NNP,KR,XW,YW,ZW,NNW,CKCOM
	DIMENSION XP(180),YP(180),ZP(180),XW(160),YW(160),ZW(160)
	DIMENSION NNP(180),NNW(160),KR(180)
C
C	WRITE(1,901)
C901	FORMAT('ENTERING WTER33')
	IF(CKCOM-54321.)191,5,191
5	CONTINUE
	NTRY=1
C
C  FIND PARENT ATOM
	NJW=NNW(JW)
	DO 20  I=1,NP
	IF(NNP(I)-NJW)20,21,20
20	CONTINUE
S	HLT
C	WRITE(1,1021) NJW
C1021	FORMAT('COULD NOT FIND PARENT ATOM',I6)
	STOP
21	X2=XP(I)
	Y2=YP(I)
	Z2=ZP(I)
	R2=FLOAT(KR(I))/100.
C
	KTOT=0
	X1=XW(JW)
	Y1=YW(JW)
	Z1=ZW(JW)
	R1=RW
22	X3=XW(JW3)
	Y3=YW(JW3)
	Z3=ZW(JW3)
	R3=RW
C  PATCH TO AVOID TROUBLE IF X2=X3
222	IF(X2-X3)24,23,24
23	X3=X3+.0003
24	CONTINUE
C  MOVE WATER AWAY FROM INTERFERING ATOM
C	WRITE(1,903)R1,R2,R3,X1,Y1,Z1,X2,Y2,Z2,X3,Y3,Z3
C903	FORMAT('CALLING MOVWAT',3F5.2,3(/2X,3F9.3))
	R3=R3+.001
	CALL MOVWAT(R1,R2,R3,X1,Y1,Z1,X2,Y2,Z2,X3,Y3,Z3,X,Y,Z)
C
C  CHECK DISTANCES TO OTHER WATERS
	K=0
	KPW=0
	DISI=0
	DWW2=0.99999*(2.*RW)
	DO 34  I=1,NW
S	TAD  \I
S	7421
	IF(I-JW3)30,34,30
30	IF(I-JW)31,34,31
31	DIS=(X-XW(I))**2 + (Y-YW(I))**2 + (Z-ZW(I))**2
	DIS=SQRT(DIS)
C  D IS OVERLAP DISTANCE 
	D=DWW2-DIS
	IF(D)34,34,32
32	K=K+1
	IF(DISI-D)33,34,34
33	DISI=D
	JI=I
	KPW=1
34	CONTINUE
C
C  CHECK DISTANCES TO PROTEIN ATOMS
	DO 38  I=1,NP
S	TAD  \I
S	7421
	RA=FLOAT(KR(I))/100.
	DWA2=0.99999*(RW+RA)
	IF(NNP(I)-NJW)35,38,35
35	DIS=(X-XP(I))**2 + (Y-YP(I))**2 + (Z-ZP(I))**2
	DIS=SQRT(DIS)
	D=DWA2-DIS
	IF(D)38,38,36
36	K=K+1
	IF(DISI-D)37,38,38
37	DISI=D
	JI=I
	KPW=-1
38	CONTINUE
C
	KTOT=KTOT+K
	WRITE(1,1738)K
1738	FORMAT(I3,' CONTACTS')
	IF(K)40,40,60
40	XW(JW)=X
	YW(JW)=Y
	ZW(JW)=Z
C	WRITE(1,1040)NNW(JW),X,Y,Z
C1040	FORMAT(I6,' MOVED TO',3F9.3)
	IMOV=1
	CALL CHAIN('WATR3R')
C
60	CONTINUE
	IF(KPW)66,61,61
C  PATH IF WATER INTERFERED
61	NTRY=NTRY+1
62	IF(KTOT-15)63,70,70
63	JW3=JI
	X1=X
	Y1=Y
	Z1=Z
	GO TO 22
C
C  PATH IF PROTEIN ATOM INTERFERED
66	NTRY=NTRY+1
67	IF(KTOT-15)68,70,70
68	X3=XP(JI)
	Y3=YP(JI)
	Z3=ZP(JI)
	X1=X
	Y1=Y
	Z1=Z
	R3=FLOAT(KR(JI))/100.
	GO TO 222
C
C70	WRITE(1,1060)NNW(JW),X1,Y1,Z1,NNW(JW3),X3,Y3,Z3
C1060	FORMAT(I6,3F9.3,'  I',I6,3F9.3)
C
C  ELIMINATE UNMOVABLE WATER (ONLY ON SECOND RUN)
70	CONTINUE
C	XW(JW)=9000.
	IMOV=2
80	CALL CHAIN('WATR3R')
C
C191	WRITE(1,1191)
C1191	FORMAT('ERROR ENTERING WTER33')
191	CONTINUE
	STOP
	END
