	COMMON IX,IY
	DIMENSION IX(1745),IY(1745),IZ(1745),NN(6),DD(10),SUMD(10)
	NJ1=1
	DO 4  K=2,6
4	SUMD(K)=0
	CALL IOPEN('DSK','CHYMCD')
	READ(4,1004)T,NA
1004	FORMAT(A1/I6)
	DO 20  I=1,1745
S	TAD  \I
S	7421
	READ(4,1010)NA,X,Y,Z
1010	FORMAT(I5,8X,3F8.2)
	IX(I)=X*10.
	IY(I)=Y*10.
	IZ(I)=Z*10.
20	CONTINUE
C
	CALL IOPEN('DSK','CHYMW3')
	CALL OOPEN('DSK','CHDIST')
	READ(4,1004)T,NA
	DO 50  I=1,875
S	TAD  \I
S	7421
	MM=KEYBD(0)
	IF(MM)91,27,91
27	READ(4,1030)NW,XW,YW,ZW
1030	FORMAT(I5,3F8.3)
	DO 31  K=2,6
31	DD(K)=1000.
	NJJ1=NJ1
	DO 40  J=NJJ1,1745
	X=FLOAT(IX(J))/10.
	IF(X-XW-6.)33,33,32
32	NJ1=J
	GO TO 40
33	IF(X-XW+6.)41,34,34
34	Y=FLOAT(IY(J))/10.
	Z=FLOAT(IZ(J))/10.
	DIS=SQRT((X-XW)**2+(Y-YW)**2+(Z-ZW)**2)
	DO 39  K=2,6
	IF(DIS-DD(K))36,39,39
36	DD(K-1)=DD(K)
	DD(K)=DIS
39	CONTINUE
40	CONTINUE
41	CONTINUE
	WRITE(4,1040)NW,DD(6),DD(5),DD(4),DD(3),DD(2)
1040	FORMAT(I6,5F8.2)
	DO 45  K=2,6
45	SUMD(K)=SUMD(K)+DD(K)
50	CONTINUE
C
91	CONTINUE
	DO 55  K=2,6
55	SUMD(K)=SUMD(K)/875.
	WRITE(4,1055)SUMD(6),SUMD(5),SUMD(4),SUMD(3),SUMD(2)
1055	FORMAT(6X,5F8.2)
	CALL OCLOSE
	STOP
	END
