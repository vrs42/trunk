	SUBROUTINE LIMIT(NTOT,IY,INDIC)
C	LIMIT.FT CALLED FROM PLTSEQ.FT
C	CALLS AXIS,PLOTER SUBROUTINES
C
	COMMON X,Y
	DIMENSION X(100),Y(100)
	DIMENSION IXY(2,100),IY(100)
C
	IF(INDIC)20,10,20
10	DO 15 I=1,NTOT
	X(I)=I
15	Y(I)=IY(I)
C
C	FIND YMN,YMAX
C
20	XMAX=X(1)
	XMIN=X(1)
	YMIN=Y(1)
	YMAX=Y(1)
	DO 100 I=1,NTOT
	IF(Y(I)-YMIN)60,70,70
60	YMIN=Y(I)
70	IF(Y(I)-YMAX)85,85,80
80	YMAX=Y(I)
85	IF(X(I)-XMAX)95,95,90
90	XMAX=X(I)
95	IF(X(I)-XMIN)97,97,100
97	XMIN=X(I)
100	CONTINUE
	WRITE(1,2000)YMIN,YMAX,XMAX,XMIN
	MAG=ALOG(YMAX)/2.303-1.
	DENOM=10.**MAG
	MAX=YMAX/DENOM+1.
	MIN=YMIN/DENOM
	NHL=MAX-MIN
	YMIN=FLOAT(MIN)*DENOM
	YMAX=FLOAT(MAX)*DENOM
	WRITE(1,2000)YMIN,YMAX,XMAX,XMIN
	READ(1,1009)XMAX
1009	FORMAT('MAX X (F12.4):'F12.4)
	READ(1,1011)XMIN
1011	FORMAT('MIN X:'F12.4)
	READ(1,1010)DELC
1010	FORMAT('DELTA X:'F12.4)
2000	FORMAT('Y-MIN =',F12.4/'Y-MAX =',F12.4/'X-MAX =',F12.4/'
	1X-MIN =',F12.4/)
	READ(1,1006)P
1006	FORMAT('SET NEW LIMITS?'A6)
	IF(P-'YES   ')105,300,105
300	READ(1,1007)YMAX,YMIN
1007	FORMAT('YMAX, YMIN (2F4.0):'2F4.0)
	NHL=(YMAX-YMIN)/DENOM
C	NOW GET REASONABLE # H.L. IF POSSIBLE
105	IF(NHL-15)350,350,310
310	IF(NHL/2-15)320,320,340
320	NHL=NHL/2
	IR=IREM(0)
	IF(IR)350,350,330
330	YMAX=YMAX+DENOM
	NHL=NHL+1
	GO TO 350
340	NHL=NHL/5
	IR=IREM(0)
	IF(IR)350,350,345
345	YMAX=YMAX+FLOAT(5-IR)*DENOM
	NHL=NHL+1
350	RINCR=(YMAX-YMIN)/FLOAT(NHL)
	WRITE(1,1008)RINCR
1008	FORMAT('Y-AXIS INCREMENT =',F12.4)
	YMULT=500./(YMAX-YMIN)
	XMULT=500./(XMAX-XMIN)
	DO 110 I=1,NTOT
	X(I)=(X(I)-XMIN)*XMULT
110	Y(I)=(Y(I)-YMIN)*YMULT-250.
	CALL AXIS(YMAX,YMIN,XMAX,NHL,DELC)
	DO 120 I=1,NTOT
	IXY(1,I)=X(I)
120	IXY(2,I)=Y(I)
	CALL PLOTER(NTOT,IXY)
	RETURN
	END
