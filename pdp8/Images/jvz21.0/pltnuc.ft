C	PLTSEQ.FT TO PLOT PROBABILITIES OF
C	SEC STRUCTURE USING TABLES MADE
C	BY CHOU AND FASMAN
C	BIOCHEMISTRY 13,222(1974)
C	AND C.CLOTHIA NATURE 1975 FOR BURIED RESIDUES
C
C	PRESENTLY RESTRICTED TO 100 RESIDUES
C	IF MORE, A RECYCLING MUST BE WRITTEN
	COMMON X,Y
	COMMON IPT,IPAL,IPBET,FRES
	COMMON LRES,MRES,NRES,MPAL,NPBET,IPTRN,ITEMP
	DIMENSION IPBET(100),IPT(100),IPAL(100)
	DIMENSION LRES(20),MRES(20),KRES(20),MPAL(20),NPBET(20),IPTRN(20)
	DIMENSION X(100),Y(100),IY(100)
	DIMENSION IRES(100),FRES(20,4)
	DIMENSION VOL(20)
C
C	READ SEQUENCE
	READ(1,1000)FMSG
1000	FORMAT('TYPE SEQUENCE TITLE:'A6)
	WRITE(1,2000)
2000	FORMAT('"DELTA X" S.B. LARGE ENUF S.T. THERE ARE L.T. 40 PIPS')
2001	FORMAT(/'ALFA')
2002	FORMAT(/'BETA')
2003	FORMAT(/'FREQ.TURNS')
2004	FORMAT(/'TURNS')
2005	FORMAT(/'BURIED')
	CALL IOPEN('DTA1',FMSG)
	READ(4,1005)NRES
1005	FORMAT(I3)
C	BELOW MUST BE REWRITTEN FOR G.T. 100 RES
	IF(NRES-100)7,7,5
5	NRES=100
7	READ(4,1006)(IRES(I),I=1,NRES)
1006	FORMAT(30A1)
C	READ P-ALFA VALUES
	CALL IOPEN('DTA1','PALFA')
	READ(4,1007)(MRES(I),MPAL(I),I=1,20)
1007	FORMAT(A1,I4)
	DO 20 I=1,NRES
	DO 10 J=1,20
	IF(IRES(I)-MRES(J))10,20,10
10	CONTINUE
20	IPAL(I)=MPAL(J)
C	LIMIT CALLS AXIS AND PLOTER SUBROUTINES
C	READ BETA
	CALL IOPEN('DTA1','PBETA')
	READ(4,1007)(MRES(I),NPBET(I),I=1,20)
	DO 220 I=1,NRES
	DO 210 J=1,20
	IF(IRES(I)-MRES(J))210,220,210
210	CONTINUE
220	IPBET(I)=NPBET(J)
C	GET HELIX NUCLEATION BY 6 POINT AVERAGE OF P-ALFA/P-BETA
C	AND ALSO PLOT 6 POINT AVERAGE OF P-ALFA.
	N=NRES-5
	DO 300 I=1,N
	K=I+5
	SUMA=0.
	SUMB=0.
	DO 290 J=I,K
	SUMA=SUMA+FLOAT(IPAL(J))
290	SUMB=SUMB+FLOAT(IPBET(J))
	X(I)=FLOAT(I)+2.5
300	Y(I)=SUMA/SUMB
	WRITE(1,2001)
	WRITE(1,2006)
2006	FORMAT('RATIO')
	CALL LIMIT(N,IPAL,1)
	DO 310 I=1,N
	K=I+5
	SUMA=0.
	DO 305 J=I,K
305	SUMA=SUMA+FLOAT(IPAL(J))
	X(I)=FLOAT(I)+2.5
310	Y(I)=SUMA/6.
	WRITE(1,2001)
	WRITE(1,2007)
2007	FORMAT('AVE PROBAB')
	CALL LIMIT(N,IPAL,1)
C	NOW GET BETA
	N=NRES-4
	DO 320 I=1,N
	K=I+4
	SUMA=0.
	SUMB=0.
	DO 315 J=I,K
	SUMA=SUMA+FLOAT(IPAL(J))
315	SUMB=SUMB+FLOAT(IPBET(J))
	X(I)=I+2
320	Y(I)=SUMB/SUMA
	WRITE(1,2002)
	WRITE(1,2006)
	CALL LIMIT(N,IPBET,1)
C	NOW PLOT AVERAGE
	DO 330 I=1,N
	K=I+4
	SUMB=0.
	DO 325 J=I,K
325	SUMB=SUMB+FLOAT(IPBET(J))
	X(I)=I+2
330	Y(I)=SUMB/5.
	WRITE(1,2001)
	WRITE(1,2007)
	CALL LIMIT(N,IPBET,1)
400	CALL IOPEN('DTA1','VBARDA')
	READ(4,1008)(MRES(I),VOL(I),I=1,20)
1008	FORMAT(5XA1,30XF6.1)
	DO 420 I=1,NRES
	DO 410 J=1,20
	IF(IRES(I)-MRES(J))410,420,410
410	CONTINUE
420	IPBET(I)=VOL(J)+.5
	WRITE(1,2008)
2008	FORMAT('5 PT VOL AVE')
	N=NRES-4
	DO 430 I=1,N
	K=I+4
	SUMV=0.
	DO 425 J=I,K
425	SUMV=SUMV+FLOAT(IPBET(J))
	X(I)=I+2
430	Y(I)=SUMV/5.
	SUMV=0.
	DO 440 I=1,NRES
440	SUMV=SUMV+FLOAT(IPBET(I))
	SUMV=SUMV/FLOAT(NRES)
	WRITE(1,2009)SUMV
2009	FORMAT('AVE VOL ='F12.4)
	CALL LIMIT(N,IPBET,1)
	END
