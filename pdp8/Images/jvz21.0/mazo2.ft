C**PROGRAM TO CALC EXACT FRICTN OF PLANE POLYGONS
C**PAUL AND MAZO - COMPARE TO KIRKWOOD
C
	DIMENSION X(30),Y(30),S(3)
	READ(1,1000)NMAX
1000	FORMAT('NMAX:'I2)
	WRITE(1,2001)
	A=1.
	TPI=2.*3.14159265
	PIETA=.01*3.14159265
	STOKE=3.*TPI*.01
	DO 999 IJK=3,NMAX
	PHI=TPI/FLOAT(IJK)
	R=1./SIN(PHI/2.)
C**GET COORDINATES
	DO 10 I=1,IJK
	SI=I-1
	X(I)=R*COS(SI*PHI)
	Y(I)=R*SIN(SI*PHI)
10	CONTINUE
	NSTOP=IJK-1
	DO 20 K=1,3
	FK=K
	S(K)=0.
	DO 15 IP=1,NSTOP
	FCT=PHI*FLOAT((K-1)*IP)
	P2=0.5*FLOAT(IP)
15	S(K)=S(K)+(SIN(FCT)+COS(FCT))*.5/SIN(P2*PHI)
20	S(K)=S(K)/R
	F1=6.*PIETA
	FN=IJK
	FN=EXP(2.*ALOG(FN)/3.)
	FMAZ=(1.+S(1)-3.*S(2)**2/(4.*(8.+9.*S(3))))/FN
	FTRY=(1.+S(1))/FN
C	FTRY I THINK WILL BE F-KIRK
C**FMAZ IS F-MAZO
C** NOW MEASURE ALL DISTANCES
	SUMD=0.
	DO 25 L=1,IJK
	K=L+1
	DO 25 M=K,IJK
	DIST=SQRT((X(L)-X(M))**2+(Y(L)-Y(M))**2)
25	SUMD=SUMD+1./DIST
	GN=IJK
	FKIRK=(1.+2.*SUMD/GN)/FN
	RAT=FMAZ/FKIRK
	DO 40 I=1,2
40	WRITE(1,2000)IJK,FMAZ,FKIRK,RAT,FTRY
2000	FORMAT(I5,4F15.5)
	WRITE(1,2001)
2001	FORMAT(///)
999	CONTINUE
	END
