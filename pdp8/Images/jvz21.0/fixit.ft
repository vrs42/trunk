	SUBROUTINE FIXIT(NRES,JNDIC)
C	PUT P-VALUES INTO PLACES OCCUPIED BY ZER0S
C	CALLED BY PREDIK.FT
C
	COMMON IALF,IBET,IPT,IPAL,IPBET
	DIMENSION IALF(300),IPBET(300),IPT(300),IBET(300),IPAL(300)
	DIMENSION JNDIC(300)
C
839	DO 865 I=1,NRES
	IF(IALF(I))845,845,840
840	IF(IBET(I))841,841,845
841	IBET(I)=IPBET(I)
845	IF(IBET(I))855,855,850
850	IF(IALF(I))851,851,855
851	IALF(I)=IPAL(I)
855	IF(IPT(I))865,865,860
860	IF(IALF(I))861,861,862
861	IALF(I)=IPAL(I)
862	IF(IBET(I))863,863,865
863	IBET(I)=IPBET(I)
865	CONTINUE
C	REZERO IPAL
	DO 870 I=1,300
870	IPAL(I)=JNDIC(I)
	RETURN
	END
