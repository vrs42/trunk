C	OSEEN2.FT YAMAKAWA AND TANAKA RODS VIA
C	EXTENDED OSSEEN TENSOR
C	J CHEM PHYS 57,1537-1542 (1972).
C	SPECIFICALLY, P1538, EQ 10-22
C
	DIMENSION A(10,10),B(10),C(10),S(2)
	DIMENSION D(10)
	DIMENSION FD(10),FC(10),X(10),Y(10)
C
1	AL=3./8.
C	AL = LAMBDA ; USE STOKES LAW
C	EQ 17 IS LAMBDA
	READ(1,1000)XI
1000	FORMAT('XI (F3.2):'F3.2)
C	EQ 18 IS XI
	XI=XI**2
	DO 1999 N=2,10
C	CALC PHI EQ 19
	DO 30 K=1,N
	B(K)=1.
	DO 30 L=1,N
	IF(K-L)20,10,20
10	A(K,L)=1.
	GO TO 30
20	DV=IABS(K-L)
	A(K,L)=AL*(1.+XI/(6.*DV**2))/DV
30	CONTINUE
	CALL MATINV(A,B,C,N)
	DO 40 K=1,N
	C(K)=0.
	DO 40 L=1,N
40	C(K)=C(K)+A(K,L)*B(L)
C	C(K) ARE PHI(K) EQ 19
C	GET PSI =D(K)
	DO 70 K=1,N
	B(K)=1.
	DO 70 L=1,N
	IF(K-L)60,50,60
50	A(K,L)=1.
	GO TO 70
60	DV=IABS(K-L)
	A(K,L)=2.*AL*(1.-XI/(6.*DV**2))/DV
70	CONTINUE
	CALL MATINV(A,B,D,N)
	DO 80 K=1,N
	D(K)=0.
	DO 80 L=1,N
80	D(K)=D(K)+A(K,L)*B(L)
C	D(K) ARE PSI(K) EQ 19
C	GET SUMS S(1,N),S(2,N)=S(PHI,N),S(PSI,N)
C
	S(1)=0.
	DO 90 K=1,N
90	S(1)=S(1)+C(K)
	S(2)=0.
	DO 100 K=1,N
100	S(2)=S(2)+D(K)
	SM=(2./S(1)+1./S(2))/3.
	TSM=SM*FLOAT(N)
	AN=N
	FACT=EXP(2.*ALOG(AN)/3.)
	FN=TSM/FACT
	WRITE(1,2000)N,SM,TSM,FN
2000	FORMAT(I3,3F15.6)
	FD(N)=FN
	FC(N)=(ALOG(AN)+.5772*(1.+ALOG(1.+1./AN)))/FACT
1999	CONTINUE
	DO 110 I=2,10
	DEL=FD(I)-FC(I)
110	WRITE(1,2000)I,FD(I),FC(I),DEL
	GO TO 1
	END
