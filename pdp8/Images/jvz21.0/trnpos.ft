C	HISPD1 PROGRAM TO START CALCN OF HI SPEED SED EQUIL EXPERIMENTS
C	AS INITIALLY FORMAULATED NEEDS:
C	LSQ,QUAD,DISPLY,SMOOTH SUBROUTINES
C	SMOOTH DERIVED FROM QSMOOT.FT
C	JAN. 1974
	COMMON AMAG,AST,NPOIT,SUM,XM,FMSG
	COMMON X,Y,CLN,PHI
	DIMENSION X(150),Y(150),CLN(150),PHI(150)
C	READ DATA
1	READ(1,1000)FMSG
1000	FORMAT('TYPE INPUT TITLE (A6):',A6)
	READ(1,1002)AMAG
1002	FORMAT('AMAG (F7.7):',F7.7)
	AMAG=.01*AMAG
C	READ(1,1003)AST
C	1003	FORMAT('RT/(1-VP)W^2  (E12.5):',E12.5)
	READ(1,1006)RM1,RB1
1006	FORMAT('ORIGIN: X(M),X(B) (2F4.0):'2F4.0)
	READ(1,1007)RM2,RB2
1007	FORMAT('DESTINATION: X(M),X(B) (2F4.0):'2F4.0)
	RM1=(5.6262+AMAG*RM1)**2
	RM2=(5.6262+AMAG*RM2)**2
	RB1=(5.6262+AMAG*RB1)**2
	RB2=(5.6262+AMAG*RB2)**2
	READ(1,1008)GMSG
1008	FORMAT('OUTPUT TITLE, A6:'A6)
	CALL IOPEN('DTA1',FMSG)
	READ(4,1004)NPOIT,SEPR
1004	FORMAT(I4,F6.1)
	NSTART=1
	NSTOP=2
	DO 10 I=1,NPOIT
	READ(4,1005)X(I),Y(I)
1005	FORMAT(2F6.0)
	X(I)=5.6262+AMAG*X(I)
10	Y(I)=(Y(I)-1.)/SEPR
	XM=X(1)
	DO 12 I=1,NPOIT
12	X(I)=X(I)-XM
	INDIC=0
	COLD=0.
15	DO 35 I=1,NPOIT
	IF(Y(I)-.1)20,20,30
20	NSTART=I
30	IF(Y(I)-1.)40,40,45
40	NSTOP=I
35	CONTINUE
C	PRELIMINARY MENISCUS CONCN
45	DO 50 I=NSTART,NSTOP
50	CLN(I)=ALOG(Y(I))
	DO 100 J=1,20
	CALL LSQ(AI,BS,NSTART,NSTOP,X,CLN)
	CNEW=EXP(AI)
	DELC=CNEW-COLD
	IF(ABS(DELC)-1.E-04)120,60,60
60	DO 70 I=1,NPOIT
	Y(I)=Y(I)+DELC
70	CLN(I)=ALOG(Y(I))
100	COLD=CNEW
120	WRITE(1,2000)J,CNEW
2000	FORMAT(I4,' ITERATIONS T0 C(M) = ',F8.4)
C	SMOOTH DATA PUT CLN INTO Y
	CALL SMOOTH(15,1,NPOIT,CLN,Y)
C	MODIFY QSMOOT FOR THIS
C	CHECK INTERVAL AS 11 ,13,15
	DO 130 I=1,NPOIT
	CLN(I)=Y(I)
130	Y(I)=EXP(Y(I))
	INDIC=INDIC+1
	IF(INDIC-1)15,15,140
140	DELX=X(2)-X(1)
	SL=(RB2-RM2)/(RB1-RM1)
	ALNSL=ALOG(SL)
	DO 145 I=1,NPOIT
	X(I)=(X(I)+XM)**2
145	PHI(I)=SL*(X(I)-RB1)-(X(I)-RB1)
C	FIRST POINT IS SPECIAL
	BS=(CLN(2)-CLN(1))/(X(2)-X(1))
	Y(1)=CLN(1)+ALNSL+BS*PHI(1)
	Y(1)=EXP(Y(1))
	DO 150 I=2,NPOIT
	K=I-1
	BS=(CLN(I)-CLN(K))/(X(I)-X(K))
	Y(I)=CLN(I)+ALNSL+BS*PHI(I)
150	Y(I)=EXP(Y(I))
C	NOW PUT X(I) TO NEW VALUES
	CALL OOPEN('DTA1',GMSG)
	WRITE(4,1004)NPOIT
	DO 155 I=1,NPOIT
	X(I)=SQRT(PHI(I)+X(I)-RB1+RB2)
155	WRITE(4,1009)X(I),Y(I)
1009	FORMAT(F7.4,F7.3)
	CALL OCLOSE
	GO TO 1
	END
