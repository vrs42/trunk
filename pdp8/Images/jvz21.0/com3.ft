C  PROGRAM COM3.  CDC TO PDP-12 ALPHANUMERIC TRANSMISSION.
C  RECEIVES 100 LINE BLOCKS FROM CDC, UP TO 80
C  CHARACTERS PER LINE.  REQUIRES ACOM, BOL,IACTF,MEMR.
C  ERIC SWANSON    MARCH 27,1977
C
	COMMON ICHAR,IERCT,KSUM,ITITL,IDATA
	DIMENSION IDATA(40),L(100),ITITL(40)
C  EFFECTIVE 100*40 ARRAY VIA MEMR ROUTINES
C
	WRITE(1,1001)
1001	FORMAT('PROGRAM COM3'/'MOUNT DATA TAPE ON UNIT 1')
	READ(1,1002) FNAME
1002	FORMAT('TYPE OUTPUT FILENAME (A6): ',A6)
	CALL OOPEN('DTA1',FNAME)
	WRITE(1,1004)
1004	FORMAT('CALL CDC, ETC.')
	CALL IACTV
C
	LR=0
	LW=0
	IEND=0
	CALL MEMI
C
20	CONTINUE
C  SEND /GO TO INITIATE TRANSMISSION
	ITITL(1)=463
	CALL ACOM(1)
C
	DO 69  LINE=1,100
C  WAIT FOR BEGINNING OF LINE.
	CALL BOL(K)
	IF(K)301,30,301
30	IERCT=0
C  GET TWO COUNT CHARACTERS, COMPUTE ICNT
	CALL RCHAR
	IF(ICHAR-42)32,80,32
32	LR=LR+1
	NLINE=LINE
	ICHAR=ICHAR-65
	IF(ICHAR)301,33,33
33	IF(ICHAR-8)34,301,301
S\34,	TAD \ICHAR
S	AND (07
S	CLL RTL;RTL
S	DCA ITMP
	CALL RCHAR
	ICHAR=ICHAR-65
	IF(ICHAR)301,38,38
38	IF(ICHAR-16)39,301,301
S\39,	TAD \ICHAR
S	AND (17
S	TAD ITMP
S	DCA \ICNT
	LL=ICNT
	KSUM=0
	I=0
	J=0
C  I COUNTS CHARACTERS RECEIVED
C  J COUNTS WORDS FOR STORAGE
C  READ REST OF LINE
50	J=J+1
	CALL RCHAR
S	TAD \ICHAR
S	TAD \KSUM
S	AND (17
S	DCA \KSUM
S	TAD \ICHAR
S	AND (77
S	CLL RTL;RTL;RTL
S	DCA ITMP
	I=I+1
	IF(ICNT-I)499,56,52
52	CALL RCHAR
	IF(I-69)54,53,54
S\53,	TAD	\ICHAR
S	SNA
S	JMP	\52	/AFTER 72ND CHARACTER,
S	TAD	(-12	/IGNORE CR, LF AND DELAY CHARS
S	SNA
S	JMP	\52
S	TAD	(-3
S	SNA CLA
S	JMP	\52
S\54,	TAD \ICHAR
S	TAD \KSUM
S	AND (17
S	DCA \KSUM
S	TAD \ICHAR
S	AND (77
S	TAD ITMP
S	DCA \ITEMP
	LJ=J*100+LINE
	CALL MEMST(LJ,ITEMP)
	I=I+1
	IF(ICNT-I)499,60,50
S\56,	TAD ITMP
S	TAD (40		/PAD WITH SPACE
S	DCA \ITEMP
	LJ=J*100+LINE
	CALL MEMST(LJ,ITEMP)
60	LL=J
C  EVALUATE CHECKSUM
61	CALL RCHAR
	IF(I-69)63,62,63
S\62,	TAD	\ICHAR
S	SNA
S	JMP	\61
S	TAD	(-12
S	SNA
S	JMP	\61
S	TAD	(-3
S	SNA CLA
S	JMP	\61
63	ICHAR=ICHAR-65
	IF(ICHAR-KSUM)66,65,66
65	IF(IERCT)499,67,66
66	LL=LL+1024
67	CONTINUE
C
	L(LINE)=LL
69	CONTINUE
C
	CALL BOL(K)
	IF(K)301,71,301
71	CALL RCHAR
	IF(ICHAR-42)301,80,301
C
C  * PATH
80	CALL RCHAR
	IF(ICHAR-66) 81,100,81
81	IF(ICHAR-69)310,85,310
85	IEND=1
C
100	WRITE(1,1100) NLINE
1100	FORMAT(I6,' LINES RECEIVED.')
	DO 120  LINE=1,NLINE
	LW=LW+1
	LL=L(LINE)
	IF(LL-1024) 104,102,102
102	LL=LL-1024
	WRITE(1,1102)LW
1102	FORMAT('ERROR IN LINE',I5)
104	DO 106  J=1,LL
	LJ=J*100+LINE
106	IDATA(J)=MEMR(LJ)
	WRITE(4,1104)(IDATA(J), J=1,LL)
1104	FORMAT(40A2)
120	CONTINUE
C
	IF(IEND)499,20,122
122	CALL OCLOSE
	ITITL(1)=96
	CALL ACOM(1)
	CALL IACTV
	CALL EXIT
C
C  ERROR EXIT--SEND $A TO KILL RUN.
301	ICHAR=154
	CALL SCHAR
	WRITE(1,1301)
1301	FORMAT('FATAL TRANSMISSION ERROR.')
	ICHAR=65
	CALL SCHAR
310	CALL IACTV
	IF(NW-150)312,311,311
311	CALL OCLOSE
312	CALL EXIT
S\499,	HLT	/INTERNAL ERROR
SITMP,	0
	END
