	SUBROUTINE COMPUT
C
C  THIS ROUTINE DOES THE MATRIX COMPUTATIONS.
C  NEEDS MEMR.RL 
C
	COMMON NS1,NS2,LD,KSEQ,KSQN,KPRG,NVOL,TTAB,LIST,LISTX,ITAB,IS1,
     1  IS2,IP,STTL,COFF,NR,TITLE
	DIMENSION IS1(30),IS2(120),IP(122),ITAB(27,27),
     1  LIST(22),LISTX(22,5),TITLE(6)
C  EFFECTIVE M(32,121) FROM MEMR ROUTINES
C
C  COMPUTE COMPARISON MATRIX
	CALL MEMI
C
	DO 49  J=1,NS2
S	TAD  \J
S	7421	/MQ SHOWS J
	JJ=IS2(J)
S	TAD  \JJ
S	CLL RTR;RTR;RTR
S	AND  (77
S	TAD  (-33
S	SMA SZA
S	CLA
S	TAD  (33
S	DCA  \JJ
C
	IPP=0
	IF(IP(J)+2016)20,22,20
20	IF(IP(J)+1120)21,22,21
21	IPP=-1
22	CONTINUE
	DO 47  I=1,NS1
	II=IS1(I)
S	TAD  \II
S	CLL RTR;RTR;RTR
S	AND  (77
S	TAD  (-33
S	SMA SZA
S	CLA
S	TAD  (33
S	DCA  \II
37	MM=ITAB(II,JJ)
	IF(IPP)41,46,41
41	MM=-1
C		M(I,J)=MM
C		IJ=J*32+I
S\46,	TAD  \J
S	CLL RTL;RTL;RAL
S	TAD  \I
S	DCA  \IJ
	CALL MEMST(IJ,MM)
47	CONTINUE
49	CONTINUE
C
C  COMPUTE SANKOF V0 MATRIX
	JJM=0
	DO 59  J=2,NS2
S	TAD  \J
S	CLL RTL;RTL;RAL
S	DCA  \JJ
S	CLA CLL CMA 
S	TAD  \J
S	CLL RTL;RTL;RAL
S	DCA  \JJM
	DO 58  I=2,NS1
C	M(I,J)=M(I-1,J-1)+M(I,J)
S	TAD  \JJ
S	TAD  \I
S	DCA  \IJ
S	CLA CLL CMA 
S	TAD  \JJM
S	TAD  \I
S	DCA  \IJK
	MM=MEMR(IJ)+MEMR(IJK)
	CALL MEMST(IJ,MM)
58	CONTINUE
59	CONTINUE
C
C  DO DIAGONAL SEARCH
	J2=NS2-LD+1
	I2=NS1-LD+1
	DO 79  JJ=1,J2
	J=JJ-1
S	TAD  \J
S	7421	/MQ SHOWS J
	DO 78  II=1,I2
	I=II-1
	ISC=0
	K=2
	IF(I) 63,63,61
61	IF(J) 63,63,62
C 62		ISC=M(I,J)
S\62,	TAD  \J
S	CLL RTL;RTL;RAL
S	TAD  \I
S	DCA  \IJ
	ISC=MEMR(IJ)
C 63		ISC=M(I+LD,J+LD)-ISC
S\63,	TAD  \J
S	TAD  \LD
S	CLL RTL;RTL;RAL
S	TAD  \I
S	TAD  \LD
S	DCA  \IJ
	ISC=MEMR(IJ)-ISC
64	KM1=K-1
	IF(ISC-LIST(K)) 70,70,66
66	LIST(KM1)=LIST(K)
	DO 67  IK=1,5
67	LISTX(KM1,IK)=LISTX(K,IK)
	K=K+1
	GO TO 64
70	IF(K-2) 78,78,71
71	LIST(KM1)=ISC
	LISTX(KM1,1)=NVOL
	LISTX(KM1,2)=KSEQ
	LISTX(KM1,3)=KSQN
	LISTX(KM1,4)=II
	LISTX(KM1,5)=JJ+(KSQN-1)*100
78	CONTINUE
79	CONTINUE
	KPRG=2
	RETURN
	END
