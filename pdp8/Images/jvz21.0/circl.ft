	SUBROUTINE CIRCL(IX,IY,IR)
C  DISPLAYS CIRCLE CENTERED AT (IX,IY) WITH RADIUS IR
	DIMENSION JXY(2,100)
	IF(IR-IRP)4,30,4
4	IRP=IR
	R=FLOAT(IR)
	R2=R**2
	N=IR+3
	NN2=2*N
	NN4=4*N
C  CALC Y FOR X:  (0, 0.33, 0.67, 1.0, 1.33)-R
	X=-R
	DO 15  I=1,5
	Y=SQRT(R2-X**2)
	JXY(1,I)=ROUND(X)
	JXY(2,I)=ROUND(Y)
	X=X+0.333333
15	CONTINUE
C  CALC Y FOR X=(2,N)-R
	X=1.-R
	DO 19  I=6,N
	X=X+1.
	Y=SQRT(R2-X**2)
	JXY(1,I)=X
	JXY(2,I)=ROUND(Y)
19	CONTINUE
C  CALC OTHER QUADRANTS
	DO 29  I=1,N
	JXY(1,NN4-I+1)=JXY(1,I)
	JXY(2,NN4-I+1)=-JXY(2,I)
	JXY(1,NN2-I+1)=-JXY(1,I)
	JXY(2,NN2-I+1)=JXY(2,I)
	JXY(1,NN2+I)=-JXY(1,I)
	JXY(2,NN2+I)=-JXY(2,I)
29	CONTINUE
	IXP=0
	IYP=0
C
30	IF(IX-IXP)33,31,33
31	IF(IY-IYP)33,40,33
33	DO 38  I=1,NN4
	JXY(1,I)=JXY(1,I)+IX-IXP
38	JXY(2,I)=JXY(2,I)+IY-IYP
	IXP=IX
	IYP=IY
C
40	CALL DSP1S(NN4,JXY)
	RETURN
	END
