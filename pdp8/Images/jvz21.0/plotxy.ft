C	PLOTM.FT, A PROGRAM TO PLOT MOL WT OUTPUT FROM HISPD2
C	THIS VERSION NEEDS AXIS,PENUP,PENDN,PLOTER SUBS
	COMMON X,Y
	DIMENSION X(100),Y(100)
	DIMENSION IXY(2,100)
C
1	READ(1,1000)FMSG
1000	FORMAT('INPUT TITLE:'A6)
	CALL PENDN(2000)
	CALL IOPEN('DSK',FMSG)
	DO 15 I=1,100
	READ(4,1003)TITL,AM,S,V
	IF(AM-999.)10,16,10
10	X(I)=ALOG(AM)/2.303
	AM=EXP(2.*ALOG(AM)/3.)
	AV=EXP(ALOG(V)/3.)
	Y(I)=AV*S*1.E+13/((1.-V*.99823)*AM)
	IF(ISENS(0))15,11,15
11	WRITE(1,2003)TITL,X(I),Y(I)
2003	FORMAT(A6,2F13.4)
15	CONTINUE
1003	FORMAT(A6,F9.0,E13.6,13XF6.4)
C
C	FIND YMN,YMAX
C
16	NTOT=I-1
	XMAX=X(1)
	XMIN=X(1)
	YMIN=Y(1)
	YMAX=Y(1)
	DO 100 I=1,NTOT
	IF(Y(I)-YMIN)60,70,70
60	YMIN=Y(I)
70	IF(Y(I)-YMAX)85,85,80
80	YMAX=Y(I)
85	IF(X(I)-XMAX)95,95,90
90	XMAX=X(I)
95	IF(X(I)-XMIN)97,97,100
97	XMIN=X(I)
100	CONTINUE
	DO 200 I=1,NTOT
	DO 200 J=1,NTOT
	IF(X(J)-X(I))200,210,210
210	XSWAP=X(J)
	YSWAP=Y(J)
	X(J)=X(I)
	Y(J)=Y(I)
	X(I)=XSWAP
	Y(I)=YSWAP
200	CONTINUE
	WRITE(1,2000)YMIN,YMAX,XMAX,XMIN
	MAG=ALOG(ABS(YMAX))/2.303-1.
	DENOM=10.**MAG
	MAX=YMAX/DENOM+1.
	MIN=YMIN/DENOM
	NHL=MAX-MIN
	YMIN=FLOAT(MIN)*DENOM
	YMAX=FLOAT(MAX)*DENOM
	WRITE(1,2000)YMIN,YMAX,XMAX,XMIN
	READ(1,1009)XMAX
1009	FORMAT('MAX X (F12.4):'F12.4)
	READ(1,1011)XMIN
1011	FORMAT('MIN X:'F12.4)
	READ(1,1010)DELC
1010	FORMAT('DELTA X:'F12.4)
2000	FORMAT('Y-MIN =',F12.4/'Y-MAX =',F12.4/'X-MAX =',F12.4/'
	1X-MIN =',F12.4/)
	READ(1,1006)P
1006	FORMAT('SET NEW LIMITS?'A6)
	IF(P-'YES   ')105,300,105
300	READ(1,1007)YMIN
1007	FORMAT('YMIN (F12.4):'F12.4)
	READ(1,1020)YMAX
1020	FORMAT('YMAX:'F12.4)
	NHL=(YMAX-YMIN)/DENOM
C	NOW GET REASONABLE # H.L. IF POSSIBLE
105	IF(NHL-15)350,350,310
310	IF(NHL/2-15)320,320,340
320	NHL=NHL/2
	IR=IREM(0)
	IF(IR)350,350,330
330	YMAX=YMAX+DENOM
	NHL=NHL+1
	GO TO 350
340	NHL=NHL/5
	IR=IREM(0)
	IF(IR)350,350,345
345	YMAX=YMAX+FLOAT(5-IR)*DENOM
	NHL=NHL+1
350	RINCR=(YMAX-YMIN)/FLOAT(NHL)
	WRITE(1,1008)RINCR
1008	FORMAT('Y-AXIS INCREMENT =',F12.4)
	READ(1,1012)P
1012	FORMAT('SET NEW INCREMENT?'A6)
	IF(P-'YES   ')400,360,400
360	READ(1,1013)RINCR
1013	FORMAT('Y-INCREMENT (F12.4):'F12.4)
	NHL=(YMAX-YMIN)/RINCR +.5
400	CALL LSQSE(AI,SEA,BS,SEB,1,NTOT,X,Y)
	WRITE(1,2001)AI,SEA,BS,SEB
2001	FORMAT('A ='F13.6' +/-'F13.6/'B ='F13.6' +/-'F13.6)
	SUMXY=0.
	SUMX=0.
	DO 410 I=1,NTOT
	SUMX=SUMX+X(I)**2
410	SUMXY=SUMXY+X(I)*Y(I)
	BS=SUMXY/SUMX
	WRITE(1,2002)BS
2002	FORMAT('SLOPE (0 INT.) ='F13.6)
	YMULT=500./(YMAX-YMIN)
	XMULT=500./(XMAX-XMIN)
	DO 110 I=1,NTOT
	X(I)=(X(I)-XMIN)*XMULT
110	Y(I)=(Y(I)-YMIN)*YMULT-250.
	CALL AXIS(YMAX,YMIN,XMAX,NHL,DELC)
	DO 120 I=1,NTOT
	IXY(1,I)=X(I)
120	IXY(2,I)=Y(I)
	CALL PLOTER(NTOT,IXY,1)
	CALL PENDN(2000)
	END
