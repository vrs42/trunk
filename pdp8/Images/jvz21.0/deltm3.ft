C	DELTAM.FT NOW NAMED DELTM3.FT
C	PROGRAM INTERPOLATES TRANSPOSED CONCN FILES TO GET C-BAR
C	NEEDS POLATE.FT SUBROUTINE
C	NEEDS LINSMO,DERIVS ALSO
C
	COMMON AMAG,AST,NPOIT,RIR,ROR
	COMMON DX,DY,X1,X2,Y1,Y2,CLN1,CLN2
	DIMENSION DX(150),DY(150),X1(150),Y1(150),CLN1(150)
	DIMENSION X2(150),Y2(150),CLN2(150)
	READ(1,1000)GMSG
1000	FORMAT('TYPE "SOLUTION" TITLE,A6:'A6)
	READ(1,1001)HMSG
1001	FORMAT('TYPE "SOLVENT" TITLE,A6:',A6)
2000	FORMAT(I4)
2001	FORMAT(F7.4,F7.3)
	CALL IOPEN('DTA1',GMSG)
	READ(4,2000)NPT1
	DO 20 I=1,NPT1
	READ(4,2001)X1(I),Y1(I)
20	CLN1(I)=ALOG(Y1(I))
	CALL IOPEN('DTA1',HMSG)
	READ(4,2000)NPT2
	DO 30 I=1,NPT2
	READ(4,2001)X2(I),Y2(I)
30	CLN2(I)=ALOG(Y2(I))
C	FIND MINIMUM X(LAST)
	XMIN=X1(NPT1)
	IF(DX(NPOIT)-XMIN)40,40,50
40	XMIN=DX(NPOIT)
50	IF(X2(NPT2)-XMIN)60,70,70
60	XMIN=X2(NPT2)
C	MAX OF DX(1),X1(1),X2(1)
C	SO THAT DELTA-C(M) IS INTERPOLATED,NOT EXTRAPOLATED.
70	XMAX=DX(1)
	IF(X1(1)-XMAX)220,220,210
210	XMAX=X1(1)
220	IF(X2(1)-XMAX)250,250,230
230	XMAX=X2(1)
250	DO 260 I=1,NPOIT
	IF(DX(I)-XMAX)260,270,270
260	CONTINUE
270	K=I-1
	NPOIT=NPOIT-I+1
	DO 280 I=1,NPOIT
	K=K+1
	DX(I)=DX(K)
280	DY(I)=DY(K)
	DO 90 I=1,NPOIT
	IF(DX(I)-XMIN)80,80,100
80	CALL POLATE(I,X1,CLN1,VAL,NPT1)
	Y1(I)=VAL
	CALL POLATE(I,X2,CLN2,VAL,NPT2)
	Y2(I)=VAL
90	CONTINUE
100	NPOIT=I-1
	AMAG=Y1(1)-Y2(1)
	DO 110 I=1,NPOIT
	CLN1(I)=ALOG(Y1(I))
	CLN2(I)=ALOG(Y2(I))
	DY(I)=DY(I)+AMAG
110	X1(I)=(Y1(I)+Y2(I))*.5
	DO 120 I=1,NPOIT
	IF(X1(I)-.35)120,120,130
120	CONTINUE
130	NSTAR=I
	NTIME=NPOIT-NSTAR+1
	DELX=(DX(7)-DX(2))/5.
	CALL LINSMO(13,NSTAR,NTIME,CLN1,X2)
	CALL DERIV(A2,A3,X2,CLN1,13,NSTAR,NTIME)
	CALL LINSMO(13,NSTAR,NTIME,CLN2,X2)
	CALL DERIV(A2,A3,X2,CLN2,13,NSTAR,NTIME)
	CALL OOPEN('DTA1','DIFFMW')
	AMAG='DIFFMW'
	J=0
	WRITE(4,2000)NTIME
	DO 140 I=NSTAR,NPOIT
	J=J+1
	AM1=AST*CLN1(I)/(DX(I)*DELX)
	AM2=AST*CLN2(I)/(DX(I)*DELX)
	WRITE(4,2002)J,DX(I),X1(I),Y1(I),AM1,Y2(I),AM2
140	WRITE(1,2002)J,DX(I),X1(I),Y1(I),AM1,Y2(I),AM2
2002	FORMAT(I3,F7.4,F7.3,2(F7.3,F9.0))
	CALL OCLOSE
	CALL CHAIN('DELTM4')
	END
