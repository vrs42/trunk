C  SEQUENCE ALIGNMENT VALUE CALCULATION
C  FINDS ALIGNMENT SCORES AND TOTAL VALUE
C  FOR 2 SEQUENCES ALIGNED JUST AS TYPED.
C  MAX 40 POSITIONS.
C  IF SSW 0 IS SET, PROGRAM LOOPS BACK FOR 
C  NEW SCORING TABLE
C
	DIMENSION IS1(40),IS2(40),ITAB(27,27),TITLE(6),ISCR(40)
	GO TO 10
9	WRITE(1,1009)
1009	FORMAT('MAX 40')
10	READ(1,1010)NS1,NS2
1010	FORMAT('TYPE SEQUENCE LENTGHS (2I2):  ',2I2)
	IF(NS1-40)12,12,9
12	IF(NS2-40)13,13,9
C
13	IF(NS2)10,14,15
14	NS2=NS1
15	WRITE(1,1013)
1013	FORMAT('TYPE FIRST SEQUENCE')
	READ(1,1014)(IS1(I), I=1,NS1)
	WRITE(1,1015)
1015	FORMAT('TYPE SECOND SEQUENCE')
	READ(1,1014)(IS2(I), I=1,NS2)
1014	FORMAT(40A1)
C
18	READ(1,1020)TTAB
1020	FORMAT('TYPE SCORING TABLE TITLE (A6):',A6)
	CALL IOPEN('DSK',TTAB)
	READ(4,1022) TITLE
	WRITE(1,1022) TITLE
1022	FORMAT(6A6)
	DO 25  J=1,27
25	READ(4,1025)(ITAB(I,J), I=1,27)
1025	FORMAT(27I2)
C
	J=NS1
	IF(NS2-J)31,32,32
31	J=NS2
32	CONTINUE
C
	ITOT=0
	DO 39  I=1,J
	II=IS1(I)
S	TAD  \II
S	RTR;RTR;RTR
S	AND  (77
S	TAD  (-33
S	SMA SZA
S	CLA
S	TAD  (33
S	DCA  \II
C
	JJ=IS2(I)
S	TAD  \JJ
S	RTR;RTR;RTR
S	AND  (77
S	TAD  (-33
S	SMA SZA
S	CLA
S	TAD  (33
S	DCA  \JJ
C
	ISCR(I)=ITAB(II,JJ)
	ITOT=ITOT+ISCR(I)
39	CONTINUE
C
	N=20
	IF(N-NS1)42,42,41
41	N=NS1
42	WRITE(1,1042)(IS1(I), I=1,N)
1042	FORMAT(20(2X,A1))
	N=20
	IF(N-NS2)44,44,43
43	N=NS2
44	WRITE(1,1042)(IS2(I), I=1,N)
C
	N=20
	IF(N-J)46,46,45
45	N=J
46	WRITE(1,1045)(ISCR(I), I=1,N)
1045	FORMAT(20I3)
	WRITE(1,1046)
1046	FORMAT(1X)
C
	IF(J-21)60,50,50
50	WRITE(1,1042)(IS1(I), I=21,NS1)
	WRITE(1,1042)(IS2(I), I=21,NS2)
	WRITE(1,1045)(ISCR(I), I=21,J)
	WRITE(1,1046)
C
60	WRITE(1,1060) ITOT
1060	FORMAT('TOTAL=',I5)
	NSW=0
	CALL SSW(NSW)
	IF(NSW)70,70,18
70	STOP
	END
