C	PROGRAM GETSEQ.FT
C	GET SEQUENCES FROM DIAL-MS TAPE AND WRITE
C	PS/8 FILES
C
	COMMON ISEQ,IAL
	DIMENSION ISEQ(256),IAL(512)
1	READ(1,1000)FMSG
1000	FORMAT('OUTPUT TITLE,A6:'A6)
	READ(1,1001)IBLK
1001	FORMAT('BLOCK #:'I3)
	CALL RLINC(1,IBLK,1,ISEQ,256)
C	NOW EDIT DATA TO
C	A) GET OUT HALF-WORDS
C	B) DELETE SPACES
C	C) FIND END OF FILE (#).
2000	FORMAT(15A2)
	K=0
	DO 100 I=3,256
	J=ISEQ(I)
S	CLA CLL
S	TAD \J
S	AND (7700
S	RTR
S	RTR
S	RTR
S	DCA \L
	K=K+1
	IF(L-32)10,5,10
5	K=K-1
	GO TO 30
10	IF(L-35)15,5,15
15	IF(L)20,120,20
20	IAL(K)=64*L
30	CONTINUE
S	CLA CLL
S	TAD \J
S	AND (0077
S	DCA \L
	K=K+1
	IF(L-32)60,55,60
55	K=K-1
	GO TO 100
60	IF(L-35)65,55,65
65	IF(L)70,120,70
70	IAL(K)=64*L
100	CONTINUE
	CALL EXIT
120	NPOIT=K-1
	CALL OOPEN('DSK',FMSG)
	WRITE(1,2001)NPOIT
	WRITE(4,2001)NPOIT
2001	FORMAT(I3)
	WRITE(1,2002)(IAL(I),I=1,NPOIT)
	WRITE(4,2002)(IAL(I),I=1,NPOIT)
2002	FORMAT(30A1)
	CALL OCLOSE
	END
