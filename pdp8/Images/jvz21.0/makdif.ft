C	MAKDIF.FT
C	WRITEOUTPUT DIFFERENCE DISTRIBUTION FILE
C	FOR DIFFERENCE SED EQUIL
C
	COMMON CP,CN,XP,XN,IXY
	DIMENSION CP(150),CN(150),XP(150),XN(150)
	DIMENSION IXY(2,150)
1	READ(1,1000)FMSG
1000	FORMAT('TYPE NEGATIVE TITLE, A6:'A6)
	READ(1,1001)GMSG
1001	FORMAT('TYPE POSITIVE TITLE, A6:'A6)
	READ(1,1002)HMSG
1002	FORMAT('OUTPUT TITLE, A6:'A6)
	CALL IOPEN('DTA1',FMSG)
	READ(4,2000)NPOIT,SEPR
	READ(4,2001)XIR,XOR
2000	FORMAT(I4,F6.1)
	DO 10 I=1,NPOIT
10	READ(4,2001)XN(I),CN(I)
2001	FORMAT(4F6.0)
	CALL IOPEN('DTA1',GMSG)
	READ(4,2000)NPPOS,SEPR
	READ(4,2001)XIR,XOR
	DO 20 I=1,NPPOS
20	READ(4,2001)XP(I),CP(I)
	IF(XP(1)-XN(1))30,40,30
30	WRITE(1,2002)
2002	FORMAT('DIFFERENT X-COORDS,TRY AGAIN')
	GO TO 1
40	IF(NPPOS-NPOIT)50,60,60
50	NPOIT=NPPOS
60	YMIN=0.
	YMAX=0.
	XMIN=XP(1)
	XMULT=500./(XP(NPOIT)-XMIN)
	CALL OOPEN('DTA1',HMSG)
	WRITE(4,2000)NPOIT,SEPR
	WRITE(4,2001)XIR,XOR
	DO 100 I=1,NPOIT
	DC=CP(I)-CN(I)+1.
	WRITE(4,2001)XP(I),DC
	IXY(1,I)=IFIX((XP(I)-XMIN)*XMULT)
	IF(DC-YMIN)70,80,80
70	YMIN=DC
80	IF(DC-YMAX)100,100,90
90	YMAX=DC
100	CONTINUE
	CALL OCLOSE
	YMULT=500./(YMAX-YMIN)
	DO 110 I=1,NPOIT
110	IXY(2,I)=IFIX((CP(I)-CN(I)+1.-YMIN)*YMULT)-250
120	CALL DISP1(NPOIT,IXY)
	CALL DISP2(NPOIT,IXY)
	CALL DISP5(0)
	IF(KEYBD(0))120,120,1
	CALL EXIT
	END
