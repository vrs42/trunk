	SUBROUTINE NEWTON(CNEW,BS,NSTART,NSTOP,ITER)
C
C	NEWTON-RAPHSON ITERATION OF MENISCUS CONCN
C	CALLED BY HISPD1
C
	COMMON AMAG,AST,NPOIT,RIR,ROR
	COMMON X,Y,CLN,PHI
	DIMENSION X(150),Y(150),CLN(150),PHI(150)
	DIMENSION GMSG(9),HMSG(9)
C
	ITER=0
5	Y1=0.
	Y2=0.
	X11=0.
	X12=0.
	X22=0.
	DO 10 I=NSTART,NSTOP
	EX=EXP(BS*X(I))
	D=-Y(I)+CNEW*(EX-1.)
	DC=EX-1.
	DB=CNEW*X(I)*EX
	Y1=Y1+D*DC
	Y2=Y2+D*DB
	X11=X11+DC*DC
	X12=X12+DC*DB
10	X22=X22+DB*DB
	DELC=(Y1*X22-Y2*X12)/(X11*X22-X12**2)
	DELB=(Y1*X12-Y2*X11)/(X12**2-X11*X22)
	CNEW=CNEW-DELC
	BS=BS-DELB
	ITER=ITER+1
	IF(ITER-20)15,15,20
15	IF(ABS(DELC)-1.E-4)20,5,5
20	RETURN
	END
