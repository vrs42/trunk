C	AAMW.FT GETS MW FROM AA ANALYSIS
C	REQUIRES VBARDA.DA ON DSK
C	M.DELAAGE,BBA (168(1968),573-575.
C
C
	DIMENSION AA(20),AM(20),AN(20),W(20)
C
	CALL IOPEN('DSK','VBARDA')
	DO 5 I=1,20
5	READ(4,1000)AA(I),AM(I)
1000	FORMAT(5XA1,10XF10.4)
	SNM=0.
	SN=0.
	READ(1,1500)FMSG
1500	FORMAT('A.A.ANAL. FILE:'A6)
	WRITE(1,2000)
2000	FORMAT('INPUT MOLES AA F6.2')
	CALL IOPEN('DSK',FMSG)
	DO 10 I=1,20
	READ(4,1002)AN(I),W(I)
	AN(I)=10.*AN(I)+.5
	J=AN(I)
	AN(I)=FLOAT(J)/10.
	WRITE(1,1001)AA(I),AN(I)
1001	FORMAT(1XA1,':',F7.2)
1002	FORMAT(F6.2,F6.3)
	SN=SN+AN(I)
10	SNM=SNM+AN(I)*AM(I)
C	GET RID OF ZERO VALUES
	IELIM=0.
	IST=1
20	DO 30 I=IST,20
	IF(AN(I))40,40,30
30	CONTINUE
	GO TO 60
40	IST=I
	DO 50 I=IST,19
	AA(I)=AA(I+1)
	AM(I)=AM(I+1)
	W(I)=W(I+1)
50	AN(I)=AN(I+1)
	IELIM=IELIM+1
	GO TO 20
60	NPOIT=20-IELIM
	DO 70 I=1,NPOIT
70	AN(I)=AN(I)/SNM
C	AN(I) ARE NOW MOLE FRACTIONS; I.E. MOLE AA/MOLE PROT.
	DO 200 I=1,NPOIT
	IF(W(I))210,210,200
210	W(I)=1./AN(I)
200	W(I)=1./W(I)
	READ(1,1003)AMIN,AMAX
1003	FORMAT('MIN,MAX M.W. (2F6.0):'2F6.0)
	READ(1,1004)DELM
1004	FORMAT('DELTA-M:'F6.0)
	WRITE(1,2002)
	NTIME=(AMAX-AMIN)/DELM+1.5
	PN=NPOIT
	AMIN=AMIN-DELM
	YNU=0.5
	YNMOL=AMIN
	YMIN=.5
	YMOL=AMIN
	YWMIN=.5
	YWMOL=AMIN
	DO 90 JK=1,NTIME
	AMIN=AMIN+DELM
	SUMY=0.
	SUMWY=0.
	SUMW=0.
	SUMNU=0.
	DO 80 I=1,NPOIT
	FN=AMIN*AN(I)
	N=FN+.5
	GN=N
	TERM=(1.-FN/GN)**2
	SUMY=SUMY+TERM
	SUMW=SUMW+W(I)
	SUMNU=SUMNU+(FN-GN)**2
80	SUMWY=SUMWY+TERM*W(I)
	SUMY=SQRT(SUMY/PN)
	SUMWY=SQRT(SUMWY/SUMW)
	SUMNU=SQRT(SUMNU/PN)
	IF(SUMY-YMIN)100,100,110
100	YMIN=SUMY
	YMOL=AMIN
110	IF(SUMWY-YWMIN)120,120,130
120	YWMIN=SUMWY
	YWMOL=AMIN
130	IF(SUMNU-YNU)140,140,90
140	YNU=SUMNU
	YNMOL=AMIN
90	WRITE(1,2001)AMIN,SUMY,SUMWY,SUMNU
2001	FORMAT(F9.0,3F10.6)
2002	FORMAT('     M(1)      DEV.  WTD.DEV.  NEW DEV.')
	WRITE(1,2003)
2003	FORMAT(////)
	WRITE(1,2005)
	DO 150 I=1,NPOIT
	Y1=YMOL*AN(I)
	Y2=YWMOL*AN(I)
	Y3=YNMOL*AN(I)
150	WRITE(1,2004)I,AA(I),Y1,Y2,Y3
2004	FORMAT(I3,2XA1,3F9.2)
2005	FORMAT('  I AA   NUMBER OF MOLES OF A.A')
	END
