	SUBROUTINE SLICE(XC)
C  PREPARES A SLICE OF COORD FILES, WHICH INCLUDES (AT LEAST)
C  6.0 ANG ON EACH SIDE OF XC
C
	COMMON FNP,FNW,RW,JW,JW3,NP,NW,NBLK,IMOV
	COMMON XP,YP,ZP,NNP,KR,XW,YW,ZW,NNW,CKCOM
	DIMENSION XP(180),YP(180),ZP(180),XW(160),YW(160),ZW(160)
	DIMENSION NNP(180),NNW(160),KR(180)
	NPMAX=180
	NWMAX=160
C
	XMAX=XC+6.
	XMIN=XC-6.
5	IF(NP-NPMAX)100,8,8
8	IF(XMIN-XP(NPMAX)) 10,10,100
C  FIND FIRST XP(I) .LE. XMAX
10	DO 12  I=1,NP
	IF(XP(I)-XMAX)13,13,12
12	CONTINUE
S	HLT
	WRITE(1,1012)
1012	FORMAT('SUBR SLICE:  COULD NOT FIND XP(I).LE.XMAX')
	STOP
C  PUSH ARRAY DOWN TO ELIMINATE UNNEEDED ATOMS
13	N=I-1
	NN=NPMAX-N
	DO 15  I=1,NN
	J=I+N
	XP(I)=XP(J)
	YP(I)=YP(J)
	ZP(I)=ZP(J)
	KR(I)=KR(J)
15	NNP(I)=NNP(J)
C
C  READ INTO FILE TO NEXT (NEW) COORD
20	CALL IOPEN('DSK',FNP)
	READ(4,1100)A,A
1100	FORMAT(A1)
22	READ(4,1020)NA,X,Y,Z
1020	FORMAT(I6,3F8.2,I4)
	IF(X-XP(NN))22,23,22
23	IF(Y-YP(NN))22,24,22
24	IF(Z-ZP(NN))22,25,22
25	CONTINUE
C
30	NN=NN+1
	DO 35  I=NN,NPMAX
	K=I
	READ(4,1020)NNP(I),XP(I),YP(I),ZP(I),KR(I)
	IF(NNP(I)+999)35,36,35
35	CONTINUE
	NP=K
	IF(XMIN-XP(NP)) 201,37,37
36	NP=K-1
37	CONTINUE
C
C  REPEAT PROCEDURE FOR WATER FILE
100	CONTINUE
105	IF(NW-NWMAX)180,108,108
108	IF(XMIN-XW(NWMAX)) 110,110,180
110	DO 112  I=1,NW
	IF(XW(I)-XMAX)113,113,112
112	CONTINUE
S	HLT
	WRITE(1,1112)
1112	FORMAT('SUBR SLICE:  COULD NOT FIND XW(I).LE.XMAX')
	STOP
113	N=I-1
	NN=NWMAX-N
	DO 115  I=1,NN
	J=I+N
	XW(I)=XW(J)
	YW(I)=YW(J)
	ZW(I)=ZW(J)
115	NNW(I)=NNW(J)
	JW=JW-N
C
120	CALL IOPEN('DSK',FNW)
	READ(4,1100)A,A
122	READ(4,1022)NA,X,Y,Z
1022	FORMAT(I6,3F9.3)
	IF(X-XW(NN))122,123,122
123	IF(Y-YW(NN))122,124,122
124	IF(Z-ZW(NN))122,125,122
125	CONTINUE
C
	NN=NN+1
130	CONTINUE
	DO 135  I=NN,NWMAX
	K=I
	READ(4,1022)NNW(I),XW(I),YW(I),ZW(I)
	IF(NNW(I)+999)135,136,135
135	CONTINUE
	NW=K
	IF(XMIN-XW(NW))203,137,137
136	NW=K-1
137	CONTINUE
180	RETURN
C
201	CONTINUE
S	HLT
	WRITE(1,1201)NPMAX
1201	FORMAT('SUBR SLICE:  MORE THAN',I4,' ATOMS IN SLICE')
	WRITE(1,1202)
1202	FORMAT('OF PROTEIN FILE.')
	STOP
203	CONTINUE
S	HLT
	WRITE(1,1201)NWMAX
	WRITE(1,1203)
1203	FORMAT('OF WATER FILE')
	STOP
	END
