	SUBROUTINE LSQSE(AI,SEA,BS,SEB,NSTART,NSTOP,X,Y)
C	MODIFIED FROM PH.D. THESIS FOR
C	LO SPEED EQUIL APRIL 1973 D.C.T.
C	THIS VERSION CALLED BY DIFUSC.FT
C	LSQSE DOES STD ERRORS OF BS AND AI
	DIMENSION X(200),Y(200)
C	STRAIGHT LINE LEAST SQUARES
	N=NSTOP-NSTART+1
	FN=N
	SUMX=0.
	SUMY=0.
	SUMXQ=0.
	SUMXY=0.
	SUMYQ=0.
	J=NSTART-1
	DO 10 I=1,N
	J=J+1
	XJ=X(J)
	YJ=Y(J)
	SUMX=SUMX+XJ
	SUMY=SUMY+YJ
	SUMXQ=SUMXQ+XJ**2
	SUMYQ=SUMYQ+YJ**2
10	SUMXY=SUMXY+XJ*YJ
	SXY=SUMXY-SUMX*SUMY/FN
	SXX=SUMXQ-SUMX*SUMX/FN
	BS=SXY/SXX
	AI=SUMY/FN-BS*SUMX/FN
	SYY=SUMYQ-SUMY*SUMY/FN
	FN2=N-2
	SEB=SQRT((SYY-SXY**2/SXX)/(FN2*SXX))
	SEA=SEB*SQRT(SUMXQ/FN)
	RETURN
	END
