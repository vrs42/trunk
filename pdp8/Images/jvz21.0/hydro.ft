C	HYDRO.FT
C	FILE OF HYDRODYNAMIC DATA TO BE CONTINUALLY UPDATED
C	OUTPUT IS CPD NAME,M,S,D,V-BAR
	COMMON ANAME,AM,S,D,VB
	DIMENSION ANAME(200),AM(200),S(200),D(200),VB(200)
	WRITE(1,1000)
1000	FORMAT('RESPONSE TO "INDIC:" IS 1 FOR M,S,VBAR;')
	WRITE(1,1998)
1998	FORMAT('2 FOR D(25,W),M,MOLAR V;999 TO EXIT')
	CALL IOPEN('DTA1','HYDROD.DA')
	DO 10 I=1,200
	READ(4,2001)ANAME(I),AM(I),S(I),D(I),VB(I)
	IF(AM(I)-999.)10,20,10
10	CONTINUE
20	NDAT=I-1
30	NDAT=NDAT+1
	N=NDAT
35	READ(1,1004)INDIC
1004	FORMAT('INDIC:'I3)
	IF(INDIC-2)40,50,999
40	READ(1,1005)ANAME(N)
1005	FORMAT('NAME (A6):'A6)
	READ(1,1006)AM(N)
1006	FORMAT('M:'F6.0)
	READ(1,1007)S(N)
1007	FORMAT('S (F6.3):'F6.3)
	READ(1,1008)VB(N)
1008	FORMAT('V-BAR (F4.4):'F4.4)
	S(N)=S(N)*1.E-13
	RT=293.15*8.3144E+7
	D(N)=RT*S(N)/(AM(N)*(1.-VB(N)*.99823))
	GO TO 30
50	READ(1,1005)ANAME(N)
	READ(1,1009)D(N)
1009	FORMAT('D(25,W) X 10^7 (F7.3):'F7.3)
	D(N)=D(N)*1.E-7
	D(N)=D(N)*293.15*.8855/298.15
	READ(1,1006)AM(N)
	READ(1,1010)AV
1010	FORMAT('MOLAR VOLUME (F7.2):'F7.2)
	VB(N)=AV/AM(N)
	RT=293.15*8.3144E+7
	S(N)=D(N)*AM(N)*(1.-VB(N)*.99823)/RT
	GO TO 30
999	S(N)=0.
	D(N)=0.
	VB(N)=0.
	AM(N)=INDIC
	ANAME(N)='END   '
C	REORDER ACC TO MOL WT
	NP=N-1
	DO 200 I=1,NP
	DO 200 J=1,NP
	IF(AM(J)-AM(I))200,210,210
210	ASWAP=ANAME(J)
	BSWAP=AM(J)
	CSWAP=S(J)
	DSWAP=D(J)
	ESWAP=VB(J)
	ANAME(J)=ANAME(I)
	AM(J)=AM(I)
	S(J)=S(I)
	D(J)=D(I)
	VB(J)=VB(I)
	ANAME(I)=ASWAP
	AM(I)=BSWAP
	S(I)=CSWAP
	D(I)=DSWAP
	VB(I)=ESWAP
200	CONTINUE
	DO 100 I=1,N
	SS=S(I)*1.E+13
	DD=D(I)*1.E+7
100	WRITE(1,2000)I,ANAME(I),AM(I),SS,DD,VB(I)
2000	FORMAT(I3,1XA6,F9.0,2F8.3,1XF6.4)
	READ(1,1011)P
1011	FORMAT('EDIT ANY DATA? (YES OR NO):'A6)
	IF(P-'YES   ')120,110,120
110	READ(1,1012)N
1012	FORMAT('COMPOUND #:'I3)
	NDAT=NDAT-1
	GO TO 35
120	CALL OOPEN('DTA1','HYDROD.DA')
	WRITE(4,2001)(ANAME(I),AM(I),S(I),D(I),VB(I),I=1,NDAT)
2001	FORMAT(A6,F9.0,2E13.6,F6.4)
	CALL OCLOSE
	END
