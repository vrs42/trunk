C  SCOM1B.FT   V1.4
C  SECOND PROGRAM MODULE--SETS UP DATA FOR COMPUT.
C  USER SUBROUTINES COMPUT,INTRPT,RESUME,SSW ARE NEEDED.
C  ENTRY IS CHAIN FROM SECOM1 OR SCOM1A, NORMAL EXIT BY
C  CHAIN TO SCOM1R.
C
	COMMON NS1,NS2,LD,KSEQ,KSQN,KPRG,NVOL,TTAB,LIST,LISTX,ITAB,IS1,
     1  IS2,IP,STTL,COFF,NR,TITLE
	DIMENSION IS1(32),IS2(120),IP(122),ITAB(27,27),
     1  STTL(6),LIST(22),LISTX(22,5),TITLE(8)
C
	GO TO (1,24,100),KPRG
1	NVOL=1
19	GO TO (20,21,22,23),NVOL
20	CALL IOPEN('DSK','SEQUV1')
	GO TO 24
21	CALL IOPEN('DSK','SEQUV2')
	GO TO 24
22	CALL IOPEN('DSK','SEQUV3')
	GO TO 24
23	CALL IOPEN('DSK','SEQUV4')
C
24	CONTINUE
C
	I=1
	CALL INTRPT(I)
C
	READ(4,1025) KSEQ,KSQN,NS2,MM,KSL,KDD,KYY
1025	FORMAT(I5,I2,I4,1X,I2,A1,I2,1X,I2)
	WHEN=FLOAT((MM-1)*31+KDD-1)+FLOAT(KYY-70)*366.
	I=0
	CALL SSW(I)
	IF(I)28,28,29
28	WRITE(1,1706)NVOL,KSEQ,KSQN,NS2
29	CONTINUE
1706	FORMAT('*1706*',4I6)
	IF(KSEQ) 80,36,36
36	IF(KSL+1056)171,37,171
37	IF(NS2-120)38,41,38
38	READ(4,1026)(IS2(I),IP(I), I=1,NS2),ISTAR
1026	FORMAT(5X,60A1)
	IF(ISTAR+1376)160,49,160
C
41	READ(4,1026)(IS2(I),IP(I), I=1,NS2)
C
49	CONTINUE
	IF(COFF) 51,52,52
51	WHEN=-WHEN
52	IF(NS2-LD)24,53,53
53	IF(WHEN-COFF)24,54,54
54	CALL COMPUT
	GO TO 24
	STOP
80	NVOL=NVOL+1
	I=0
	CALL INTRPT(I)
	IF(NVOL-4)19,19,81
81	CONTINUE
C  RESULTS OUT HERE
	CALL CHAIN('SCOM1R')
C
C  RESUME PATH
100	CALL RESUME
	GO TO 24
C
160	WRITE(1,1160)
1160	FORMAT('ERROR--COULD NOT FIND * AT END OF SEQUENCE')
	WRITE(1,1706)NVOL,KSEQ,KSQN,NS2
	CALL OOPEN('DSK','RESULT')
	WRITE(4,1160)
	WRITE(4,1706)NVOL,KSEQ,KSQN,NS2
	CALL OCLOSE
	CALL EXIT
171	WRITE(1,1171)
1171	FORMAT('PROGRAM ERROR STOP 171')
	CALL OOPEN('DSK','RESULT')
	WRITE(4,1171)
	CALL OCLOSE
	CALL EXIT
	END
