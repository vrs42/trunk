C	DELTM1.FT TO COMPUTE MOLECULAR WEIGHT DIFFERENCES
C	DERIVED FROM HISPD1 TO TRNPOS TO THIS PROG
C	AS INITIALLY FORMAULATED NEEDS:
C	LSQ,SMOOTH,NEWTON SUBROUTINES
C	SMOOTH DERIVED FROM QSMOOT.FT
C	CHAINS TO DELTM2.FT
C	MAR. 1974 D.C.T.
	COMMON AMAG,AST,NPOIT,RIR,ROR
	COMMON X,Y,CLN,PHI
	DIMENSION X(150),Y(150),CLN(150),PHI(150)
	WRITE(1,2020)
2020	FORMAT('"ORIGIN" IS PRESENT CHANNEL')
	WRITE(1,2022)
2022	FORMAT('"DESTINATION" IS DIFFERENCE CHANNEL')
	WRITE(1,2021)
2021	FORMAT('X(M) AND X(B) REFER TO ACTUAL VALUES IN STEPS')
	READ(1,1002)AMAG
	AMAG=.01*AMAG
	READ(1,1003)AST
	DO 2 JJK=1,2
C	READ DATA
1	READ(1,1000)FMSG
1000	FORMAT('TYPE INPUT TITLE (A6):',A6)
1002	FORMAT('AMAG (F7.7):',F7.7)
1003	FORMAT('RT/(1-VP)W^2  (E12.5):',E12.5)
1006	FORMAT('ORIGIN: X(M),X(B) (2F4.0):'2F4.0)
	READ(1,1008)GMSG
1007	FORMAT('DESTINATION: X(M),X(B) (2F4.0):'2F4.0)
	READ(1,1006)RM1,RB1
	READ(1,1007)RM2,RB2
1008	FORMAT('OUTPUT TITLE, A6:'A6)
	CALL IOPEN('DTA1',FMSG)
	READ(4,1004)NPOIT,SEPR
	READ(4,1005)RIR,ROR
	XREF=6.5-.5*AMAG*(RIR+ROR)
	RM1=(XREF+AMAG*RM1)**2
	RM2=(XREF+AMAG*RM2)**2
	RB1=(XREF+AMAG*RB1)**2
	RB2=(XREF+AMAG*RB2)**2
1004	FORMAT(I4,F6.1)
	NSTART=1
	NSTOP=2
	DO 10 I=1,NPOIT
	READ(4,1005)X(I),Y(I)
1005	FORMAT(2F6.0)
	X(I)=XREF+AMAG*X(I)
10	Y(I)=(Y(I)-1.)/SEPR
	XM=X(1)
	DO 12 I=1,NPOIT
12	X(I)=X(I)-XM
	INDIC=0
	COLD=0.
15	DO 35 I=1,NPOIT
	IF(Y(I)-.25)20,20,30
20	NSTART=I
30	IF(Y(I)-1.)40,40,35
40	NSTOP=I
35	Y(I)=Y(I)-COLD
C	PRELIMINARY MENISCUS CONCN
45	DO 50 I=NSTART,NSTOP
50	CLN(I)=ALOG(Y(I))
	CALL LSQ(AI,BS,NSTART,NSTOP,X,CLN)
	CNEW=EXP(AI)
	CALL NEWTON(CNEW,BS,NSTART,NSTOP,ITER)
60	DO 70 I=1,NPOIT
	Y(I)=Y(I)+CNEW
70	CLN(I)=ALOG(Y(I))
100	COLD=CNEW
120	WRITE(1,2000)ITER,CNEW
2000	FORMAT(I4,' ITERATIONS T0 C(M) = ',F8.4)
C	SMOOTH DATA PUT CLN INTO Y
	CALL SMOOTH(15,1,NPOIT,CLN,Y)
C	MODIFY QSMOOT FOR THIS
C	CHECK INTERVAL AS 11 ,13,15
	DO 130 I=1,NPOIT
	CLN(I)=Y(I)
130	Y(I)=EXP(Y(I))
	INDIC=INDIC+1
	IF(INDIC-1)15,15,140
140	DELX=X(2)-X(1)
	SL=(RB2-RM2)/(RB1-RM1)
	ALNSL=ALOG(SL)
	DO 145 I=1,NPOIT
	X(I)=(X(I)+XM)**2
145	PHI(I)=SL*(X(I)-RB1)-(X(I)-RB1)
C	FIRST POINT IS SPECIAL
	BS=(CLN(2)-CLN(1))/(X(2)-X(1))
	Y(1)=CLN(1)+ALNSL+BS*PHI(1)
	Y(1)=EXP(Y(1))
	DO 150 I=2,NPOIT
	K=I-1
	BS=(CLN(I)-CLN(K))/(X(I)-X(K))
	Y(I)=CLN(I)+ALNSL+BS*PHI(I)
150	Y(I)=EXP(Y(I))
C	NOW PUT X(I) TO NEW VALUES
	CALL OOPEN('DTA1',GMSG)
	WRITE(4,1004)NPOIT
	DO 155 I=1,NPOIT
	X(I)=SQRT(PHI(I)+X(I)-RB1+RB2)
155	WRITE(4,1009)X(I),Y(I)
1009	FORMAT(F7.4,F7.3)
2	CALL OCLOSE
	CALL CHAIN('DELTM2')
C	LATER WILL WANT TO JOIN THIS DATA TO HISPD2
	END
