C**CORELATE PROPERTIES OF ASNASES WITH OTHERS
C**NEEDS COREL8.FT
C
	DIMENSION AN(10,8),DEV(8,8),SUM(8)
	DIMENSION X(10),Y(10)
	READ(1,1001)NP
1001	FORMAT('TYPE # PROT:'I2)
	CALL IOPEN('DSK','PROPER')
	DO 10 I=1,NP
	READ(4,1000)(AN(I,J),J=1,5)
10	WRITE(1,1000)(AN(I,J),J=1,5)
1000	FORMAT(F6.0,F6.1,F7.3,F5.1,F6.3)
	DO 30 K=1,5
	DO 30 J=1,5
	DO 20 I=1,NP
	X(I)=AN(I,K)
20	Y(I)=AN(I,J)
	CALL COREL8(X,Y,NP,COR)
30	DEV(K,J)=COR
	DO 40 K=1,5
40	WRITE(1,2000)K,(DEV(K,J),J=1,5)
2000	FORMAT(/I2,5F8.2)
	WRITE(1,2001)
2001	FORMAT(///)
	END
