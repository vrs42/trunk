	SUBROUTINE PLOTER(N,IXY,INDIC)
C	INDIC=0 IS HLT
C	INDIC=1 CALLS PENUP,PENDN
	DIMENSION IXY(2,100),IDIS(2,2)
	DO 240 I=1,N
	IF(IXY(2,I)-250)220,220,210
210	IXY(2,I)=250
220	IF(IXY(2,I)+250)230,240,240
230	IXY(2,I)=-250
240	CONTINUE
1000	FORMAT('PEN DOWN, THEN "CONT"')
C	PUT 1 ST POINT INTO IDIS
	IDIS(1,1)=IXY(1,1)
	IDIS(2,1)=IXY(2,1)
	CALL DISP1(1,IDIS)
	DO 250 I=1,5
250	CALL PENUP(2000)
C	IS DELAY FOR PEN AND ARM MOTION
	IF(INDIC)241,241,242
241	WRITE(1,1000)
S	HLT
242	CALL PENDN(500)
C	
C	PRESUMABLY PEN IS NOW DOWN AND PLOTTER SET UP
C
	DO 100 I=2,N
	K=I-1
	NSTEP=IXY(1,I)-IXY(1,K)+1
	DE=FLOAT(NSTEP-1)
	B=0.
	A=0.
	IF(DE)10,20,10
10	B=FLOAT(IXY(2,I)-IXY(2,K))/DE
	A1=FLOAT(IXY(2,K))*FLOAT(IXY(1,I))
	A2=FLOAT(IXY(2,I))*FLOAT(IXY(1,K))
	A=(A1-A2)/DE
20	M=IXY(1,K)
	NSTEP=IABS(NSTEP)
	IF(NSTEP-1)100,100,30
30	CALL PENUP(500)
	DO 50 J=1,NSTEP
C	COMPUT # STEPS BETWEEN POINTS
	BUFF1=M+J-1
	IBUFF2=IFIX(A+B*BUFF1)
	IDIS(1,1)=BUFF1
	IDIS(2,1)=IBUFF2
	DO 50 L=1,100
50	CALL DISP1(1,IDIS)
	IF(INDIC)58,58,57
C	CLOSE RELAY
57	CALL PENDN(500)
58	IF(IABS(IBUFF2)-250)55,100,100
55	DO 60 JJ=1,2
	LJ=(-1.)**JJ
	DO 60 L=1,2
	IDIS(2,1)=IDIS(2,1)+LJ*L
	IDIS(1,1)=IDIS(1,1)-LJ*L
	DO 60 LL=1,200
	CALL DISP1(1,IDIS)
60	CONTINUE
	DO 70 JJ=1,2
	LJ=(-1.)**JJ
	DO 70 L=1,2
	IDIS(2,1)=IDIS(2,1)-LJ*L
	IDIS(1,1)=IDIS(1,1)+LJ*L
	DO 70 LL=1,200
	CALL DISP1(1,IDIS)
70	CONTINUE
	DO 80 JJ=1,2
	LJ=(-1.)**JJ
	DO 80 L=1,2
	IDIS(2,1)=IDIS(2,1)+LJ*L
	IDIS(1,1)=IDIS(1,1)+LJ*L
	DO 80 LL=1,200
	CALL DISP1(1,IDIS)
80	CONTINUE
	DO 90 JJ=1,2
	LJ=(-1.)**JJ
	DO 90 L=1,2
	IDIS(2,1)=IDIS(2,1)-LJ*L
	IDIS(1,1)=IDIS(1,1)-LJ*L
	DO 90 LL=1,200
	CALL DISP1(1,IDIS)
90	CONTINUE
100	CONTINUE
	IF(INDIC)101,101,102
101	WRITE(1,1002)
1002	FORMAT('PEN UP,THEN "CONT"')
S	HLT
102	CALL PENUP(2000)
	RETURN
	END
