C  SCOM1A.FT   V1.4  MULTIPLE RUNS
C  THIS ROUTINE GETS RUN PARAMETERS FROM THE SECOMZ.DA FILE,
C  AND CHAINS TO SCOM1B.
C
	COMMON NS1,NS2,LD,KSEQ,KSQN,KPRG,NVOL,TTAB,LIST,LISTX,ITAB,IS1,
     1  IS2,IP,STTL,COFF,NR,TITLE
	DIMENSION IS1(32),IS2(120),IP(122),ITAB(27,27),
     1  STTL(6),LIST(22),LISTX(22,5),TITLE(8)
C
	N=NR
	NR=NR+1
	CALL IOPEN('DSK','SECOMZ')
	IF(N)11,11,5
5	DO 9  I=1,N
	READ(4,1009)A
1009	FORMAT(A6)
	IF(A-'GOGOGO')91,7,91
7	READ(4,1009)A,A,A
9	CONTINUE
C
11	READ(4,1009)A
	IF(A-'GOGOGO')99,13,99
13	READ(4,1011)TTAB,NS1,LD,COFF,TITLE
	READ(4,1012)(IS1(I), I=1,NS1)
1011	FORMAT(A6,2I3,F10.0/8A6)
1012	FORMAT(32A1)
C
	CALL IOPEN('DSK',TTAB)
	READ(4,1014)STTL
1014	FORMAT(6A6)
	DO 15  J=1,27
15	READ(4,1015)(ITAB(I,J), I=1,27)
1015	FORMAT(27I2)
C
	DO 22  I=1,21
	DO 21  J=1,4
21	LISTX(I,J)=0
22	LIST(I)=0
	LIST(22)=2047
	KPRG=1
	CALL CHAIN('SCOM1B')
	STOP
C
91	WRITE(1,1091)
1091	FORMAT('ERROR 91 IN SCOM1A')
99	STOP
	END
