	SUBROUTINE POLATE(I,X,CLN,VAL,NPOIT)
C
C	INTERPOLATE CONCN VALUES INTO DX SCALE
C
	COMMON AMAG,AST,NPT,RIR,ROR
	COMMON DX
	DIMENSION DX(150),X(150),CLN(150)
	XP=DX(I)
	DO 10 J=2,NPOIT
	IF(X(J)-XP)10,10,20
10	CONTINUE
20	K=J-1
	VAL=CLN(K)+(CLN(J)-CLN(K))*(XP-X(K))/(X(J)-X(K))
	VAL=EXP(VAL)
	RETURN
	END
