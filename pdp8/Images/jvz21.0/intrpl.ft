	SUBROUTINE INTRPL(J,COR,NBAS)
	COMMON X,Y,X1,DELB,NPOIT,RIR,ROR
	COMMON IY,IB
	DIMENSION X(150),IY(150),IB(150)
	DIMENSION Y(150)
C	FIND X.GE.XB,XB=BASELINE X
	N=NBAS-1
	DO 10 I=1,NBAS
	XB=X1+DELB*FLOAT(I-1)
	IF(XB-X(J))10,10,5
5	COR=FLOAT(IB(I-1))+FLOAT(IB(I)-IB(I-1))*(X(J)-XB+DELB)/DELB
	GO TO 20
10	CONTINUE
15	WRITE(1,100)XB,X(J)
100	FORMAT('XB(MAX)<X(J):'2F6.0)
	COR=IB(NBAS)
20	RETURN
	END
