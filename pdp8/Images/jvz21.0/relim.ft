	COMMON NRNUM
	DIMENSION A(6),NRNUM(1000)
	READ(1,1001)FRACT
1001	FORMAT('TYPE FRACTION TO RETAIN: ',F6.0)
2	READ(1,1002)IR
1002	FORMAT('TYPE RANDOM INTEGER, 1 TO 999 (I3):',I3)
	IF(IR-999)3,3,2
3	CALL IOPEN('SYS','RANNUM')
	READ(4,1003)A
1003	FORMAT(3A1)
	READ(4,1004)NRNUM
1004	FORMAT(10I5)
	IR1=NRNUM(IR)
	IR2=NRNUM(IR+1)
C
	CALL IOPEN('DSK','CHMW3E')
	CALL OOPEN('DSK','CHMW3P')
	READ(4,1006)T,NA
1006	FORMAT(A1/I6)
	WRITE(1,1007)NA
1007	FORMAT('NA=',I6)
	NW=0
	CALL RNSET(IR1)
	DO 20  I=1,NA
	IF(I-400)12,11,12
11	CALL RNSET(IR2)
12	READ(4,1012)A
1012	FORMAT(6A6)
	R=RANF(R)
	IF(R-FRACT)8,8,20
8	NW=NW+1
	WRITE(4,1012)A
20	CONTINUE
	WRITE(1,1030)NW
	WRITE(4,1999)
1999	FORMAT(' -999')
	CALL OCLOSE
1030	FORMAT('NW=',I6)
	STOP
	END
