C	PREDIK.FT PREDICTS SECONDARY STRUCTURE OF PROTEINS
C	BY THE METHOD OF CHOU AND FASMAN
C	BIOCHEMISTRY 13,222(1974)
C	NEEDS FORWRD,BAKWRD SUBROUTINES
C	NEEDS SUMMAR ALSO
C
	COMMON IALF,IBET,IPT,IPAL,IPBET,FRES
	COMMON LRES,MRES,NRES,MPAL,NPBET,IPTRN,ITEMP,JNDIC
	DIMENSION IALF(300),IPBET(300),IPT(300),IBET(300),IPAL(300)
	DIMENSION LRES(20),MRES(20),KRES(20),MPAL(20),NPBET(20),IPTRN(20)
	DIMENSION ITEMP(4),IRES(300),FRES(20,4),JNDIC(300)
C
	DO 5 I=1,300
	IALF(I)=0
5	IBET(I)=0
C	READ SEQUENCE
	READ(1,1000)FMSG
1000	FORMAT('TYPE SEQUENCE TITLE:'A6)
	CALL IOPEN('DTA1',FMSG)
	READ(4,1005)NRES
1005	FORMAT(I3)
	READ(4,1006)(IRES(I),I=1,NRES)
1006	FORMAT(30A1)
C	READ P-ALFA VALUES
	CALL IOPEN('DTA1','PALFA')
	READ(4,1007)(MRES(I),MPAL(I),I=1,20)
1007	FORMAT(A1,I4)
	DO 20 I=1,NRES
	DO 10 J=1,20
	IF(IRES(I)-MRES(J))10,20,10
10	CONTINUE
20	IPAL(I)=MPAL(J)
C	READ BETA
	CALL IOPEN('DTA1','PBETA')
	READ(4,1007)(KRES(I),NPBET(I),I=1,20)
	DO 220 I=1,NRES
	DO 210 J=1,20
	IF(IRES(I)-KRES(J))210,220,210
210	CONTINUE
220	IPBET(I)=NPBET(J)
C	GET ALFA HELIX NUCLEATION SITES
	WRITE(1,1016)
1016	FORMAT(/'NUCLEATION')
	N=NRES-5
	DO 130 I=1,N
	ISTOP=I+5
	IH=0
	II=0
	IB=0
	ISA=0
	ISB=0
	DO 80 J=I,ISTOP
	ISA=ISA+IPAL(J)
	ISB=ISB+IPBET(J)
	IF(IPAL(J)-112)40,30,30
30	IH=IH+1
	GO TO 80
40	IF(IPAL(J)-100)60,50,50
50	II=II+1
	GO TO 80
C	CHECK FOR PRO,ASP,ARG NUCLEATION
60	NN=IRES(J)/64
C	PRO?
	IF(NN-16)62,61,62
61	II=II+1
	ISA=ISA+45
	GO TO 80
C	ASP?
62	IF(NN-4)64,63,64
63	II=II+1
	ISA=ISA+6
	GO TO 80
C	ARG?
C	NOTE I HAVENT USED DIRECTIONALITY HERE
64	IF(NN-18)66,65,66
65	II=II+1
	ISA=ISA+25
	GO TO 80
66	IF(IPAL(J)-73)70,70,80
70	IB=IB+1
80	CONTINUE
	IF(IH+II/2-4)130,90,90
90	IF(IB-2)100,130,130
100	IF(IH-3)130,110,110
110	IF(ISA-ISB)130,130,115
115	DO 120 J=I,ISTOP
120	IALF(J)=IPAL(J)
	WRITE(1,1010)I,ISTOP
130	CONTINUE
	INDIC=1
	CALL FORWRD(NRES,IALF,IPAL,INDIC,IRES)
	CALL BAKWRD(NRES,IALF,IPAL,INDIC,IRES)
C	GET BETA NUCLEATION SITES
	N=NRES-4
	WRITE(1,1016)
	DO 330 I=1,N
	ISTOP=I+4
	IH=0
	IB=0
	ISA=0
	ISB=0
	DO 280 J=I,ISTOP
	ISA=ISA+IPAL(J)
	ISB=ISB+IPBET(J)
	IF(IPBET(J)-119)240,230,230
230	IH=IH+1
	GO TO 280
240	IF(IPBET(J)-74)270,270,280
270	IB=IB+1
280	CONTINUE
	IF(IH-3)330,300,300
300	IF(IB-2)310,330,330
310	IF(ISB-ISA)330,330,315
315	DO 320 J=I,ISTOP
320	IBET(J)=IPBET(J)
	WRITE(1,1010)I,ISTOP
330	CONTINUE
C	EXTEND BETA
	INDIC=2
	CALL FORWRD(NRES,IBET,IPBET,INDIC,IRES)
	CALL BAKWRD(NRES,IBET,IPBET,INDIC,IRES)
C	NOW GET TURNS
	N=NRES-3
	CALL IOPEN('DTA1','FTURNS')
	READ(4,1008)(LRES(I),(FRES(I,J),J=1,4),IPTRN(I),I=1,20)
1008	FORMAT(A1,4F6.3,I4)
	DO 590 I=1,NRES
590	IPT(I)=0
	DO 640 I=1,N
	M=0
	J=I+3
	PROD=1.
	DO 620 L=I,J
	M=M+1
	DO 610 K=1,20
	IF(IRES(L)-LRES(K))610,615,610
610	CONTINUE
615	ITEMP(M)=IPTRN(K)
620	PROD=PROD*FRES(K,M)
	PROD=PROD/(.07**4)
	IF(PROD-2.)640,640,630
630	M=0
	DO 635 L=I,J
	M=M+1
635	IPT(L)=ITEMP(M)
640	CONTINUE
C	NOW OUTPUT SEC. STRUCTURE
	DO 870 I=1,300
870	JNDIC(I)=0
	N=NRES-3
	WRITE(1,1009)
1009	FORMAT(/'TURNS')
	DO 700 I=1,N
	J=I+3
	ISA=0
	ISB=0
	IST=0
	DO 710 K=I,J
	ISA=ISA+IALF(K)
	ISB=ISB+IPBET(K)
710	IST=IST+IPT(K)
	IF(ISA-360)720,720,700
720	IF(IST-ISB)700,700,730
730	WRITE(1,1010)I,J
	DO 735 K=I,J
735	JNDIC(K)=3
1010	FORMAT(2I4)
700	CONTINUE
	N=NRES-4
	WRITE(1,1011)
1011	FORMAT(/'BETA')
	DO 750 I=1,N
	J=I+4
	ISA=0
	ISB=0
	DO 760 K=I,J
	ISA=ISA+IALF(K)
760	ISB=ISB+IBET(K)
	IF(ISB-525)750,770,770
770	IF(ISB-ISA)750,780,780
780	WRITE(1,1010)I,J
	DO 785 K=I,J
785	JNDIC(K)=2
750	CONTINUE
	N=NRES-5
	WRITE(1,1012)
1012	FORMAT(/'ALPHA')
	DO  800 I=1,N
	J=I+5
	ISA=0
	ISB=0
	DO 810 K=I,J
	ISA=ISA+IALF(K)
810	ISB=ISB+IPBET(K)
	IF(ISA-618)800,820,820
820	IF(ISA-ISB)800,830,830
830	WRITE(1,1010)I,J
	DO 835 K=I,J
835	JNDIC(K)=1
800	CONTINUE
C	NOW LINE UP ALFA,BETA,TURN P-VALUES
	CALL FIXIT(NRES,JNDIC)
C	NOW WRITE OUT ALL DATA
	NTIME=NRES/15+1
	K=-14
	DO 900 I=1,NTIME
	K=K+15
	N=K+14
	IF(N-NRES)920,920,910
910	N=NRES
920	WRITE(1,1015)
	WRITE(1,1014)(L,L=K,N)
	WRITE(1,1013)(IRES(L),L=K,N)
1013	FORMAT(15(3XA1))
	WRITE(1,1014)(IALF(L),L=K,N)
1014	FORMAT(15I4)
	WRITE(1,1014)(IBET(L),L=K,N)
	WRITE(1,1014)(IPT(L),L=K,N)
	WRITE(1,1015)
1015	FORMAT(/)
900	CONTINUE
	WRITE(1,1015)
	CALL SUMMAR(NRES,IRES)
	END
