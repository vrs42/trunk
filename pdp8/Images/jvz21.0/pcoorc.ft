C  PCOORC.FT
C  PROGRAM TO DISPLAY 3-D COORDINATES BY SLICES
C  X AXIS MUST BE ORDERED, Y AND Z AXES ARE DISPLAYED
C  KNOB 4 CONTROLS SCON THROUGH X-AXIS
C  KNOBS 3 AND 7 CONTROL CURSORS, WHICH ARE SWITHED BY SENSE SW 0.
C  TELETYPE COMMANDS:
C    E-WRITE OUTPUT FILE
C    T-SPECIFY NEW THICKNESS
C    X-TYPE X AXIS RANGE
C    Z-ZAP ATOM AT CURSOR POSITION
C    ?-IDENTIFY ATOM AT CURSOR POSITION
C    C-PLOT CIRCLES BY VDW RADIUS
C
	COMMON NATOM,X
	DIMENSION TITLE(10),X(480),IYZ(2,480),NATOM(480),NZAP(40)
	DIMENSION KYZ(2,2),KR(480)
C
	NMAX=480
	YOFF=128.
	ZOFF=256.
	EXPF=1.1
	CALL PENUP(1)
	KYZ(1,2)=0
	KYZ(2,2)=0
	READ(1,1002) FNM
1002	FORMAT('TYPE COORD FILENAME (A6):',A6)
	CALL IOPEN('DSK',FNM)
	READ(4,1004) TITLE,NA
1004	FORMAT(10A6/I6)
	WRITE(1,1007) TITLE,NA
1007	FORMAT(10A6/'NATOM=',I5)
	IF(NA-NMAX)7,7,91
C
7	NZ=1
	DO 10  I=1,NA
S	TAD  \I
S	7421
	READ(4,1010) NATOM(I),X(I),Y,Z,R
1010	FORMAT(I5,3F8.3,F6.2)
	IF(R)8,8,9
8	R=1.4
9	KR(I)=R*100.
	IYZ(1,I)=(Y*5.0+YOFF)*EXPF
10	IYZ(2,I)=(Z*5.0+ZOFF)*EXPF
C
16	READ(1,1016) TH
1016	FORMAT('SLICE THICKNESS, ANG:',F10.0)
	IF(TH-99.)17,17,16
17	NOLD=-1
C
C  KNOB 4 CONTROLS BEGINNING OF SLICE (MIN X VALUE)
21	KDS=1
22	N=KNOB(4)+513
	IF(IABS(N-NOLD)-1)30,30,23
C    DELAY LOOP
23	DO 231  I=1,50
231	Y=5.*5.
	N=KNOB(4)+513
	NOLD=N
	IF(N-NA)25,25,24
24	N=NA
25	I1=N
	DO 26  I=I1,NA
	IF(X(N)-X(I)-TH)26,26,27
26	CONTINUE
27	I2=I-1
C  I2 POINTS TO LAST COORD IN SLICE
C
C  CHECK TTY KEYBOARD
C  SIGNALS:  E-WRITE OUTPUT FILE; T-SPECIFY NEW THICKNESS;
C  X-TYPE X-AXIS RANGE;  Z-ZAP ATOM AT POSITION MARKED BY CURSORS
C  C-PLOT CIRCLES; ?-IDENTIFY ATOM AT CURSORS POSITION
C
30	M=KEYBD(0)
	IF(M)31,40,31
31	IF(M-212)32,16,32
32	IF(M-218)33,50,33
33	IF(M-197)34,70,34
34	IF(M-191)35,60,35
35	IF(M-216)36,66,36
36	IF(M-195)37,80,37
37	CONTINUE
C
40	N=I2-I1+1
	CALL DISP1(N,IYZ(1,I1))
	IY=KNOB(3)/2+256
	IZ=KNOB(7)/2
	IF(KDS)21,21,41
41	IF(IY)22,22,42
42	IF(IZ+256)22,22,43
43	CALL DISP5(IZ)
	CALL DISP6(IY)
	KDS=0
	GO TO 22
C
C  PATH TO ZAP ATOM
50	CONTINUE
	N=0
	DO 55  I=I1,I2
	K=IABS(IYZ(1,I)-IY)-1
	IF(K)52,52,55
52	K=IABS(IYZ(2,I)-IZ)-1
	IF(K)53,53,55
53	NZAP(NZ)=I
	NZ=NZ+1
	IF(NZ-41)54,92,92
54	IYZ(1,I)=0
	IYZ(2,I)=0
	N=1
55	CONTINUE
	IF(N)22,56,22
56	DO 57  I=1,500
57	CALL DISP9(-240,0,'NO')
	WRITE(1,1056)
1056	FORMAT('NO')
	GO TO 22
C
C  PATH TO IDENTIFY ATOM AT MARKED POSITION
60	DO 65  I=I1,I2
	K=IABS(IYZ(1,I)-IY)-1
	IF(K)62,62,65
62	K=IABS(IYZ(2,I)-IZ)-1
	IF(K)63,63,65
63	Y=((FLOAT(IYZ(1,I))/EXPF)-YOFF)/5.0
	Z=((FLOAT(IYZ(2,I))/EXPF)-ZOFF)/5.0
	WRITE(1,1064)NATOM(I),X(I),Y,Z
1064	FORMAT(I5,3F8.2)
65	CONTINUE
	GO TO 22
C
66	XX=XN-TH
	WRITE(1,1066)XX,XN
1066	FORMAT(' X AXIS:',F6.1,' TO',F6.1)
	GO TO 22
C
C  PATH TO DISPLAY CIRCLES
C
80	CONTINUE
	DO 88 I=I1,I2
	KYY=IYZ(1,I)
	KZZ=IYZ(2,I)
	IRAD=FLOAT(KR(I))/20.*EXPF +0.5
	KYZ(1,1)=KYY-IRAD
	KYZ(2,1)=KZZ
	DO 85  K=1,1000
85	CALL DISP1(1,KYZ)
	CALL PENDN(500)
	CALL CIRCL(KYY,KZZ,IRAD)
	CALL PENUP(800)
	M=KEYBD(0)
	IF(M)22,88,22
88	CONTINUE
	GO TO 22
C
C  PATH TO WRITE OUTPUT FILE
70	CONTINUE
	CALL IOPEN('DSK',FNM)
	READ(1,1071) FNM2
1071	FORMAT('TYPE OUTPUT FILENAME, A6:',A6)
	CALL OOPEN('DSK',FNM2)
	READ(4,1004) TITLE,NA
	I=NA-NZ+1
	WRITE(4,1004) TITLE,I
	DO 75  I=1,NA
	READ(4,1072) N,(TITLE(K),K=1,5)
1072	FORMAT(I5,5A6)
	DO 74  J=1,NZ
	IF(I-NZAP(J))74,75,74
74	CONTINUE
	WRITE(4,1072)N,(TITLE(K), K=1,5)
75	CONTINUE
	WRITE(4,1075)
1075	FORMAT(' -999')
	CALL OCLOSE
	WRITE(1,1076)
1076	FORMAT('END')
	CALL EXIT
91	WRITE(1,1091)
1091	FORMAT('ARRAY SPACE INSUFFICIENT')
	STOP
92	WRITE(1,1091)
	WRITE(1,1092)
1092	FORMAT('RERUN PROGRAM ON OUTPUT FILE TO DO MORE EDITING.'/
	1'TYPE E NOW.')
	GO TO 22
	END
