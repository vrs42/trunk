/ ROUTINES TO SUPPORT LARGE MATRIX STORAGE ON DISK.
/ THIS SECTION INCLUDES:
/	SUBROUTINE BMATI(I,J)
/	SUBROUTINE BMATW(I,J,V)
/	FUNCTION BMAT(I,J)
/
	SECT	#BMAT
#XR,	ORG	.+10
	TEXT	+#BMAT +
#RET,	SETX	#XR
	SETB	#BASE
	JA	.+3
#BASE,	ORG	.+6
I,	ORG	.+3
J,	ORG	.+3
V,	ORG	.+3
	ORG	#BASE+30
	FNOP
	JA	#RET
	FNOP
#RTN,
#GOBAK,	0;0
#VAL,	ORG	.+6
IFL,	ORG	.+0003
IMAX,	ORG	.+0003
I12,	ORG	.+0003
JJ,	ORG	.+0003
JMAX,	F	-1.
JPW,	ORG	.+0003
NA1,	ORG	.+0003
NA2,	ORG	.+0003
#LIT,	0001
	2000
	0000
	0002
	2000
	0000
	0002
	3000
	0000
	0003
	2000
	0000
	0003
	3000
	0000
	0004
	2000
	0000
	0011
	2000
	0000
	0012
	2000
	0000
	0023
	2000
	0000
A1,	ORG	.+3000
A2,	ORG	.+3000
B,	ORG	.+3000
	BASE	#BASE
/
/ ENTRY POINT FOR FUNCTION BMAT(I,J)
/
	ENTRY	BMAT
BMAT,	STARTD
	0210
	FSTA	#GOBAK,0
	0200
	SETX	#XR
	SETB	#BASE
	LDX	0,1
	FSTA	#BASE
	FLDA%	#BASE,1+
	FSTA	I
	FLDA%	#BASE,1+
	FSTA	J
	STARTF
	LDX	0001,0
	FLDA%	I
	ATX	7		/XR 7 CONTAINS I
	FLDA%	J
	JLE	#391
	FSTA	JJ		/JJ CONTAINS J
	FSUB	JMAX
	JGT	#391
	FLDA	JJ
	FSUB	JPW
	JEQ	#40
	FLDA	JJ
	FSUB	NA1
	JNE	#5
	FLDA	A1-0003,7	/ENTRY IS IN A1(I)
	EXTERN	#NE
	JA	#RTN
 
#5,	FLDA	JJ
	FSUB	NA2
	JNE	#10
	FLDA	A2-0003,7	/ENTRY IS IN A2(I)
	JA	#RTN
 
#10,	FLDA	I12
	JNE	#20
	EXTERN	#RDAO
	TRAP3	#RDAO		/READ ROW INTO A1
	JA	#LIT+0017
	JA	JJ
	FLDA	IMAX
	FNEG
	ATX	1
	LDX	0,2
#G0002,	EXTERN	#RSVO
	TRAP3	#RSVO
	FSTA	A1-3,2+
	JXN	#G0002,1+
	EXTERN	#RENDO
	TRAP3	#RENDO
	FLDA	A1-0003,7
	FSTA	#VAL
	FLDA	JJ
	FSTA	NA1
	FLDA	#LIT+0000
	FSTA	I12
	FLDA	#VAL
	JA	#RTN
 
#20,	EXTERN	#RDAO
	TRAP3	#RDAO		/READ ROW INTO A2
	JA	#LIT+0017
	JA	JJ
	FLDA	IMAX
	FNEG
	ATX	1
	LDX	0,2
#G0004,	EXTERN	#RSVO
	TRAP3	#RSVO
	FSTA	A2-3,2+
	JXN	#G0004,1+
	TRAP3	#RENDO
	FLDA	A2-0003,7
	FSTA	#VAL
	FLDA	JJ
	FSTA	NA2
	FCLA
	FSTA	I12
	FLDA	#VAL
	JA	#RTN
 
#40,	FLDA	B-0003,7	/ENTRY IS IN B(I)
	JA	#RTN
 
/
/ ENTRY POINT FOR SUBROUTINE BMATW(I,J,V)
/
	ENTRY	BMATW
BMATW,	STARTD
	0210
	FSTA	#GOBAK,0
	0200
	SETX	#XR
	SETB	#BASE
	LDX	0,1
	FSTA	#BASE
	FLDA%	#BASE,1+
	FSTA	I
	FLDA%	#BASE,1+
	FSTA	J
	FLDA%	#BASE,1+
	FSTA	V
	STARTF
	LDX	0010,0
#105,	FLDA%	J
	JLE	#391
	FSTA	JJ
	FSUB	JMAX
	JGT	#391
	FLDA	JPW
	JLE	#145		/FIRST TIME ENTRY
	FSUB	JJ
	JEQ	#150
	EXTERN	#WDAO
	TRAP3	#WDAO		/WRITE PREVIOUS ROW FROM B
	JA	#LIT+0017
	JA	JPW
	FLDA	IMAX
	FNEG
	ATX	1
	LDX	0,2
#G0005,	FLDA	B-3,2+
	TRAP3	#RSVO
	JXN	#G0005,1+
	TRAP3	#RENDO
 
#130,	LDX	0,2
	FLDA	JJ
	FSUB	NA1
	JEQ	#140
	FLDA	JJ
	FSUB	NA2
	JEQ	#145
 
	EXTERN	#RDAO
	TRAP3	#RDAO		/READ CURRENT ROW INTO B
	JA	#LIT+0017
	JA	JJ
	FLDA	IMAX
	FNEG
	ATX	1
	LDX	0,2
#G0007,	EXTERN	#RSVO
	TRAP3	#RSVO
	FSTA	B-3,2+
	JXN	#G0007,1+
	TRAP3	#RENDO
	JA	#148
 
#140,	FLDA	IMAX
	FNEG
	ATX	1
	FLDA	A1-3,2+
	FSTA	B-3,2
	JXN	.-4,1+
	JA	#148
 
#145,	FLDA	IMAX
	FNEG
	ATX	1
	FLDA	A2-3,2+
	FSTA	B-3,2
	JXN	.-4,1+
 
#148,	FLDA	JJ
	FSTA	JPW
 
#150,	FLDA%	I
	ATX	7
	FLDA%	V
	FSTA	B-0003,7
	FLDA	JJ
	FSUB	NA1
	JNE	.+5		/CHECK IF ENTRY BELONGS IN A1
	FLDA%	V
	FSTA	A1-0003,7
	FLDA	JJ
	FSUB	NA2
	JNE	.+5		/OR A2
	FLDA%	V
	FSTA	A2-0003,7
	JA	#RTN
/
/ ENTRY POINT FOR SUBROUTINE BMATI(I,J)
/ INITIALIZATION ROUTINE
/
	ENTRY	BMATI
BMATI,	STARTD
	0210
	FSTA	#GOBAK,0
	0200
	SETX	#XR
	SETB	#BASE
	LDX	0,1
	FSTA	#BASE
	FLDA%	#BASE,1+
	FSTA	I
	FLDA%	#BASE,1+
	FSTA	J
	STARTF
	FLDA%	I
	FSTA	IMAX
	FSUB	#LIT+0025
	JGT	#391		/CHECK IMAX.LE.512
	FLDA%	J
	FSTA	JMAX
	FMUL	IMAX
	FSUB	#LIT+0030
	JGT	#391
	EXTERN	#DEF
	TRAP3	#DEF		/DEFINE FILE ROUTINE
	JA	#LIT+0017
	JA	JMAX
	JA	IMAX
	JA	IFL
	FLDA	#LIT+0000
	FNEG
	FSTA	NA1
	FSTA	NA2
	FSTA	JPW
	JA	#RTN
 
#391,	EXTERN	#WRITO		/ERROR EXIT
	TRAP3	#WRITO
	JA	#LIT+0011
	JA	#1391+2
	TRAP3	#RENDO
 
#1391,	JA	.+0027
/	' ERROR IN #BMAT--I OR J OUT OF RANGE'
	5047
	4005
	2222
	1722
	4011
	1640
	4302
	1501
	2455
	5511
	4017
	2240
	1240
	1725
	2440
	1706
	4022
	0116
	0705
	5647
	5100
	EXTERN	#EXIT
	JSR	#EXIT
	END
