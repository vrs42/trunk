C	PROGRAM TO OUTPUT DIFFERENCE FILE IN FORM
C	COMPATIBLE WITH LATER PROGS
C	NOTE THAT IT CAN BE CHAINED TO TRNPOS.FT
	COMMON X,Y
	DIMENSION X(150),Y(150),IXY(2,150)
1	READ(1,1000)FMSG
1000	FORMAT('TYPE INPUT DELTS-C TITLE,A6:'A6)
	READ(1,1001)GMSG
1001	FORMAT('OUTPUT TITLE:'A6)
	READ(1,1002)AMAG
1002	FORMAT('AMAG (F7.7):'F7.7)
	AMAG=.01*AMAG
	CALL IOPEN('DTA1',FMSG)
	READ(4,2000)NPOIT,SEPR
2000	FORMAT(I4,F6.1)
	YMIN=0.
	YMAX=0.
	DO 40 I=1,NPOIT
	READ(4,2001)X(I),Y(I)
2001	FORMAT(2F6.0)
	X(I)=X(I)*AMAG+5.6262
	Y(I)=(Y(I)-1.)/SEPR
	IF(Y(I)-YMIN)10,20,20
10	YMIN=Y(I)
20	IF(Y(I)-YMAX)40,40,30
30	YMAX=Y(I)
40	CONTINUE
	YMULT=500./(YMAX-YMIN)
	XMIN=X(1)
	XMAX=X(NPOIT)
	XMULT=500./(XMAX-XMIN)
	DO 50 I=1,NPOIT
	IXY(1,I)=IFIX((X(I)-XMIN)*XMULT)
50	IXY(2,I)=IFIX((Y(I)-YMIN)*YMULT)-250
C	PUT ROUTINES FOR GETTING ZERO DELTA C,SMOOTHING HERE
	L2=IFIX(-YMIN*YMULT)-250
60	CALL DISP1(NPOIT,IXY)
	CALL DISP2(NPOIT,IXY)
	CALL DISP5(L2)
	IF(KEYBD(0))60,60,70
70	CALL OOPEN('DTA1',GMSG)
	WRITE(4,2000)NPOIT
	DO 80 I=1,NPOIT
80	WRITE(4,2002)X(I),Y(I)
2002	FORMAT(F7.4,F7.3)
	CALL OCLOSE
	GO TO 1
	END
