C	RECOVR.FT
C	PROGRAM TO READ EQUIL DATA AND WRITE IT AGAIN
C	TO RECOVER FROM FMT2 TYPE ERRORS ENCOUNTERED IN
C	PROG1
C
	COMMON X,IY,ISEP
	DIMENSION X(150),IY(150),ISEP(150)
	READ(1,1000)FMSG
1000	FORMAT('TITLE(A6):'A6)
	READ(1,1001)XL
1001	FORMAT('TYPE LAST GOOD X (F6.0)'F6.0)
	CALL IOPEN('DTA1',FMSG)
	READ(4,1002)XIR,YIR
	READ(4,1002)XOR,YOR
1002	FORMAT(F6.0,F7.1)
	DO 10 I=1,150
	READ(4,1003)X(I),IY(I),ISEP(I)
1003	FORMAT(F6.0,2I4)
	IF(X(I)-XL)10,20,20
10	CONTINUE
20	NPOIT=I+1
	X(NPOIT)=9999.
	IY(NPOIT)=999
	ISEP(NPOIT)=999
	CALL OOPEN('DTA1',FMSG)
	WRITE(4,1002)XIR,YIR
	WRITE(4,1002)XOR,YOR
	DO 30 I=1,NPOIT
30	WRITE(4,1003)X(I),IY(I),ISEP(I)
	CALL OCLOSE
	CALL EXIT
	END
