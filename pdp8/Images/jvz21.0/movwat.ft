C  SUBROUTINE TO FIND NEW POSITION OF 'BUMPED' WATER
	SUBROUTINE MOVWAT(R1,R2,R3,X1,Y1,Z1,X2,Y2,Z2,X3,Y3,Z3,X,Y,Z)
C
C  R1 IS WATER RADIUS, R2 IS PARENT PROTEIN ATOM RADIUS
C  R3 IS INTERFERING ATOM RADIUS
C  (X1,Y1,Z1) IS WATER TO BE MOVED
C  (X2,Y2,Z2) IS PARENT PROTEIN ATOM
C  (X3,Y3,Z3) IS INTERFERING ATOM
C
C  COMPUT PLANE BETWEEN PARENT ATOM AND INTERFERING ATOM,
C  ON WHICH LIES A CIRCLE THAT IS THE LOCUS OF POINTS
C  1.4A FROM THE SURFACE OF BOTH SPHERES
	A1=2.*(X3-X2)
	B1=2.*(Y3-Y2)
	C1=2.*(Z3-Z2)
	D1=X2**2-X3**2+Y2**2-Y3**2+Z2**2-Z3**2  -(R1+R2)**2+(R1+R3)**2
C
C  COMPUT PLANE ON WHICH ALL THREE ATOMS LIE
	CALL PLANEQ(X1,Y1,Z1,X2,Y2,Z2,X3,Y3,Z3,A2,B2,C2,D2)
C
C  COMPUT LINE OF INTERSECTION OF PLANES
	CALL LINEPQ(A1,B1,C1,D1,A2,B2,C2,D2)
	XA=A1
	XB=A2
	YA=B1
	YB=B2
	ZA=C1
	ZB=C2
C
C  USING PARAMETRIC EQUATIONS OF LINE,
C  FIND COORDS OF MOVED ATOM (TWO SOLUTIONS)
	AA=XB**2+YB**2+ZB**2
	BB=2.*(XA*XB-XB*X3+YA*YB-YB*Y3+ZA*ZB-ZB*Z3)
	CC=XA**2+X3**2-2.*XA*X3+YA**2+Y3**2-2.*YA*Y3+ZA**2+Z3**2-2.*ZA*Z3
	CC=CC-(R1+R3)**2
C
	T1=(-BB+SQRT(BB**2-4.*AA*CC))/(2.*AA)
	T2=(-BB-SQRT(BB**2-4.*AA*CC))/(2.*AA)
C
	XT1=XA+XB*T1
	YT1=YA+YB*T1
	ZT1=ZA+ZB*T1
	XT2=XA+XB*T2
	YT2=YA+YB*T2
	ZT2=ZA+ZB*T2
C
C  COMPUT DISTANCES MOVED FOR EACH SOLUTION
	DIS1=(X1-XT1)**2+(Y1-YT1)**2+(Z1-ZT1)**2
	DIS2=(X1-XT2)**2+(Y1-YT2)**2+(Z1-ZT2)**2
C  DESIRED SOLUTION IS SMALLER DISTANCE
	DIS1=SQRT(DIS1)
	DIS2=SQRT(DIS2)
	WRITE(1,1733)DIS1,DIS2
1733	FORMAT(2F8.4)
	X=XT1
	Y=YT1
	Z=ZT1
	IF(DIS2-DIS1)41,44,44
41	X=XT2
	Y=YT2
	Z=ZT2
44	RETURN
	END
