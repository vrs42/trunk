C	SVM.FT
C	CALC SV^1/3/(1-VP) VS M^2/3 FOR CPDS
C
	COMMON ANAME,AM,S,D,VB
	DIMENSION ANAME(200),AM(200),S(200),D(200),VB(200)
	CALL IOPEN('DTA1','HYDROD.DA')
	DO 10 I=1,200
	READ(4,1000)ANAME(I),AM(I),S(I),D(I),VB(I)
1000	FORMAT(A6,F9.0,2E13.6,F6.4)
	IF(AM(I)-999.)10,20,10
10	CONTINUE
20	NPOIT=I-1
	AV=0.
	SIG=0.
	CALL OOPEN('DTA1','DATA.DA')
	WRITE(4,2020)NPOIT
2020	FORMAT(I4)
	DO 50 I=1,NPOIT
	S(I)=S(I)*1.E+13
	V3=EXP(ALOG(VB(I))/3.)
	AM23=EXP(2.*ALOG(AM(I))/3.)
	Y=S(I)*V3/(1.-VB(I)*.99823)
	X=AM23
	AK=Y/X
	AV=AV+AK
	SIG=SIG+AK**2
	AK=100.*AK
	ALNM=.43429*ALOG(AM(I))
	WRITE(4,2021)ALNM,AK
2021	FORMAT(2F12.4)
50	WRITE(1,2000)I,ANAME(I),AM(I),Y,X,AK
2000	FORMAT(I3,1XA6,F9.0,2F10.3,F8.4)
	FN=NPOIT
	CALL OCLOSE
	SIG=(SIG-AV*AV/FN)/(FN-1.)
	SIG=SQRT(SIG)
	AV=AV/FN
	WRITE(1,2001)AV,SIG
2001	FORMAT('K ='E13.6' +/-'E13.6/////)
	END
