C	INVERT.FT
C	PROGRAM TO INVERT BASELINE AND DELTA-M
C	EQUIL DATA SO IT CAN BE HANDLED BY PROG1
C
	COMMON X,IY,ISEP
	DIMENSION X(150),IY(150),ISEP(150)
	WRITE(1,2000)
2000	FORMAT('INVERT BASE AND EQUIL DATA IN DELTA-M')
1	READ(1,1000)FMSG
1000	FORMAT('TITLE(A6):'A6)
	CALL IOPEN('DTA1',FMSG)
	READ(4,1004)RIR,ROR
1004	FORMAT(2F6.0)
	READ(4,1002)XIR,YIR
	READ(4,1002)XOR,YOR
1002	FORMAT(F6.0,F7.1)
	DO 10 I=1,150
	READ(4,1003)X(I),IY(I),ISEP(I)
1003	FORMAT(F6.0,2I4)
	IF(X(I)-9999.)10,20,20
10	CONTINUE
20	NPOIT=I
	X(NPOIT)=9999.
	IY(NPOIT)=-999
	ISEP(NPOIT)=999
	YIR=-YIR
	YOR=-YOR
	CALL OOPEN('DTA1',FMSG)
	WRITE(4,1004)RIR,ROR
	WRITE(4,1002)XIR,YIR
	WRITE(4,1002)XOR,YOR
	DO 30 I=1,NPOIT
	IY(I)=-IY(I)
30	WRITE(4,1003)X(I),IY(I),ISEP(I)
	CALL OCLOSE
	GO TO 1
	CALL EXIT
	END
