/ ROUTINES TO SUPPORT LARGE MATRIX STORAGE ON DISK.
/ DOUBLE PRECISION ROUTINE
/ THIS SECTION INCLUDES:
/	SUBROUTINE DMATI(I,J)
/	SUBROUTINE DMATW(I,J,V)
/	FUNCTION DMAT(I,J)
/
/ NOW ALLOWS OVERLAY WITH BIGMD8
/
	SECT	#DMAT2
	DPCHK
#XR,	ORG	.+10
	TEXT	+#DMAT2+
#RET,	SETX	#XR
	SETB	#BASE
	JA	.+3
#BASE,	ORG	.+6
I,	ORG	.+3
J,	ORG	.+3
V,	ORG	.+3
	ORG	#BASE+30
	FNOP
	JA	#RET
	FNOP
#RTN,
#GOBAK,	0;0
#VAL,	ORG	.+6
IFL,	ORG	.+0003
I12,	ORG	.+0003
JJ,	ORG	.+0003
NA1,	F	-1.
NA2,	F	-1.
#LIT,	0001
	2000
	0000
	0002
	2000
	0000
	0002
	3000
	0000
	0003
	2000
	0000
	0003
	3000
	0000
	0004
	2200
	0000
	0011
	2000
	0000
	0012
	2000
	0000
	0023
	2000
	0000
A1,	ORG	.+6000
A2,	ORG	.+6000
	BASE	#BASE
/
/ ENTRY POINT FOR FUNCTION BMATD(I,J)
/
	ENTRY	DMAT2
DMAT2,	STARTD
	0210
	FSTA	#GOBAK,0
	0200
	SETX	#XR
	SETB	#BASE
	LDX	0,1
	FSTA	#BASE
	FLDA%	#BASE,1+
	FSTA	I
	FLDA%	#BASE,1+
	FSTA	J
	STARTF
	LDX	0001,0
	FLDA%	I
	ATX	7		/XR 7 CONTAINS I
	FLDA%	J
	JLE	#391
	FSTA	JJ		/JJ CONTAINS J
	FSUB	JMAX
	JGT	#391
	FLDA	JJ
	FSUB	JPW
	JEQ	#40
	FLDA	JJ
	FSUB	NA1
	JNE	#5
	STARTE
	FLDA	A1-0006,7	/ENTRY IS IN A1(I)
	EXTERN	#NE
	JA	#RTN
 
#5,	FLDA	JJ
	FSUB	NA2
	JNE	#10
	STARTE
	FLDA	A2-0006,7	/ENTRY IS IN A2(I)
	JA	#RTN
 
#10,	FLDA	I12
	JNE	#20
	EXTERN	#RDAO
	TRAP3	#RDAO		/READ ROW INTO A1
	JA	#LIT+0017
	JA	JJ
	FLDA	IMAX
	FNEG
	ATX	1
	LDX	0,2
#G0002,	EXTERN	#RSVO
	TRAP3	#RSVO
	FSTA	A1-3,2+
	JXN	#G0002,1+
	EXTERN	#RENDO
	TRAP3	#RENDO
	STARTE
	FLDA	A1-0006,7
	FSTA	#VAL
	STARTF
	FLDA	JJ
	FSTA	NA1
	FLDA	#LIT+0000
	FSTA	I12
	STARTE
	FLDA	#VAL
	JA	#RTN
 
#20,	EXTERN	#RDAO
	TRAP3	#RDAO		/READ ROW INTO A2
	JA	#LIT+0017
	JA	JJ
	FLDA	IMAX
	FNEG
	ATX	1
	LDX	0,2
#G0004,	EXTERN	#RSVO
	TRAP3	#RSVO
	FSTA	A2-3,2+
	JXN	#G0004,1+
	TRAP3	#RENDO
	STARTE
	FLDA	A2-0006,7
	FSTA	#VAL
	STARTF
	FLDA	JJ
	FSTA	NA2
	FCLA
	FSTA	I12
	STARTE
	FLDA	#VAL
	JA	#RTN
 
#40,	STARTE
	FLDA	B-0006,7	/ENTRY IS IN B(I)
	JA	#RTN
 
/
/ ENTRY POINT FOR SUBROUTINE BMATWD(I,J,V)
/
	ENTRY	DMATW2
DMATW2,	STARTD
	0210
	FSTA	#GOBAK,0
	0200
	SETX	#XR
	SETB	#BASE
	LDX	0,1
	FSTA	#BASE
	FLDA%	#BASE,1+
	FSTA	I
	FLDA%	#BASE,1+
	FSTA	J
	FLDA%	#BASE,1+
	FSTA	V
	STARTF
	LDX	0010,0
#105,	FLDA%	J
	JLE	#391
	FSTA	JJ
	FSUB	JMAX
	JGT	#391
	FLDA	JPW
	JLE	#130		/FIRST TIME ENTRY
	FSUB	JJ
	JEQ	#150
	EXTERN	#WDAO
	TRAP3	#WDAO		/WRITE PREVIOUS ROW FROM B
	JA	#LIT+0017
	JA	JPW
	FLDA	IMAX
	FNEG
	ATX	1
	LDX	0,2
#G0005,	FLDA	B-3,2+
	TRAP3	#RSVO
	JXN	#G0005,1+
	TRAP3	#RENDO
 
#130,	LDX	0,2
	FLDA	JJ
	FSUB	NA1
	JEQ	#140
	FLDA	JJ
	FSUB	NA2
	JEQ	#145
 
	EXTERN	#RDAO
	TRAP3	#RDAO		/READ CURRENT ROW INTO B
	JA	#LIT+0017
	JA	JJ
	FLDA	IMAX
	FNEG
	ATX	1
#G0007,	EXTERN	#RSVO
	TRAP3	#RSVO
	FSTA	B-3,2+
	JXN	#G0007,1+
	TRAP3	#RENDO
	JA	#148
 
#140,	FLDA	IMX2		/GET ROW FROM A1
	ATX	1
	STARTE
	FLDA	A1-6,2+
	FSTA	B-6,2
	JXN	.-4,1+
	STARTF
	JA	#148
 
#145,	FLDA	IMX2		/GET ROW FROM A2
	ATX	1
	STARTE
	FLDA	A2-6,2+
	FSTA	B-6,2
	JXN	.-4,1+
	STARTF
 
#148,	FLDA	JJ
	FSTA	JPW
 
#150,	FLDA%	I
	ATX	7
	STARTE
	FLDA%	V
	FSTA	B-0006,7
	STARTF
	FLDA	JJ
	FSUB	NA1
	JNE	.+7		/CHECK IF ENTRY BELONGS IN A1
	STARTE
	FLDA%	V
	FSTA	A1-0006,7
	STARTF
	FLDA	JJ
	FSUB	NA2
	JNE	.+7		/OR A2
	STARTE
	FLDA%	V
	FSTA	A2-0006,7
	STARTF
	JA	#RTN
/
/ ENTRY POINT FOR SUBROUTINE BMATID(I,J)
/ INITIALIZATION ROUTINE
/
	ENTRY	DMATI2
DMATI2,	STARTD
	0210
	FSTA	#GOBAK,0
	0200
	SETX	#XR
	SETB	#BASE
	LDX	0,1
	FSTA	#BASE
	FLDA%	#BASE,1+
	FSTA	I
	FLDA%	#BASE,1+
	FSTA	J
	STARTF
	LDX	0020,0
	FLDA%	I
	FSTA	IMAX
	FSUB	#LIT+0025
	JGT	#391		/CHECK IMAX.LE.512
	FLDA%	J
	FSTA	JMAX
	FMUL	IMAX
	FSUB	#LIT+0030
	JGT	#391
	FLDA	IMAX
	FNEG
	FSTA	IMX2
	FLDA	IMAX
	FADDM	IMAX
	EXTERN	#DEF
	TRAP3	#DEF		/DEFINE FILE ROUTINE
	JA	#LIT+0017
	JA	JMAX
	JA	IMAX
	JA	IFL
	FLDA	#LIT+0000
	FNEG
	FSTA	NA1
	FSTA	NA2
	FSTA	JPW
	JA	#RTN
 
#391,	EXTERN	#WRITO		/ERROR EXIT
	TRAP3	#WRITO
	JA	#LIT+0011
	JA	#1391+2
	TRAP3	#RENDO
 
#1391,	JA	.+0027
/	' ERROR IN #BMAT--I OR J OUT OF RANGE'
	5047
	4005
	2222
	1722
	4011
	1640
	4302
	1501
	2455
	5511
	4017
	2240
	1240
	1725
	2440
	1706
	4022
	0116
	0705
	5647
	5100
	EXTERN	#EXIT
	JSR	#EXIT
/
/ FOLLOWING COMMON ALLOWS OVERLAY WITH BIGMD8
	COMMON	MDCOM
	ORG	.+14
IMAX,	ORG	.+3
IMX2,	ORG	.+3
JMAX,	F	-1.
JPW,	F	-1.
	ORG	.+6000
B,	ORG	.+6000
	END
