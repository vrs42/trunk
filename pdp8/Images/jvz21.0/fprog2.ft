C	FPROG2.FT NEEDS NO SUBROUTINES
C	IS PROG TO EDIT HIGH END OF DELTA-M DATA
C	DERIVED FROM PROG2.FT
C	D.C.T. 3/30/74
C
	COMMON X,Y,SEPR,DELX,NPOIT,RIR,ROR
	COMMON IXY
	DIMENSION X(150)
	DIMENSION Y(150),IXY(2,150)
	XMIN=X(1)
	XMAX=X(NPOIT)
	YMAX=0.
	YMIN=0.
	DO 40 I=1,NPOIT
	IF(Y(I)-YMAX)10,10,20
20	YMAX=Y(I)
10	IF(Y(I)-YMIN)30,40,40
30	YMIN=Y(I)
40	CONTINUE
C	WANT ONLY TO EDIT THE HIGH END;
C	DELTM4.FT DOES THE LOW END LATER.
	XMULT=500./(XMAX-XMIN)
	YMULT=500./(YMAX-YMIN)
	DO 50 I=1,NPOIT
	IXY(1,I)=IFIX((X(I)-XMIN)*XMULT)
50	IXY(2,I)=IFIX((Y(I)-YMIN)*YMULT)-250
	WRITE(1,1000)
1000	FORMAT('"C" TO SET LAST POINT,"Q" TO CONTINUE')
60	M1=IABS(NALOG(0))
	CALL DISP1(NPOIT,IXY)
	CALL DISP2(NPOIT,IXY)
	CALL DISP6(M1)
	L=KEYBD(0)
	IF(L-195)60,70,120
70	DO 100 I=1,NPOIT
	IF(IXY(1,I)-(M1+1))100,110,100
100	CONTINUE
	WRITE(1,2000)
2000	FORMAT('WRONG INDEX, TRY AGAIN')
	GO TO 60
110	NPOIT=I
	GO TO 60
120	READ(1,1001)FMSG
1001	FORMAT('TYPE OUTPUT DELTA-M TITLE:'A6)
	CALL OOPEN('DTA1',FMSG)
	WRITE(4,2002)NPOIT,SEPR
	WRITE(4,2003)RIR,ROR
2002	FORMAT(I4,F6.1)
	DO 130 I=1,NPOIT
130	WRITE(4,2003)X(I),Y(I)
2003	FORMAT(2F6.0)
	CALL OCLOSE
	WRITE(1,2004)
2004	FORMAT('DONE!, NOW CHAINING DELTM1')
	CALL CHAIN('DELTM1')
	END
