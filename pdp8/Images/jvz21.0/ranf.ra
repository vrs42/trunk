/  FUNCTION RANF(R)
/  RANDOM NUMBER GENERATOR
/  USES MULTIPLICATIVE CONGRUENTIAL GENERATOR
/  CYCLES EVERY 524288 ITERATIONS
/	FUNCTION RANF(R)
/	DOUBLE PRECISION P,X1
/	DATA X1/1067405.D0/
/	P=2028371D0*X1
/	K=IDINT(P/2097152.D0)
/	X1=P-2097152.D0*K
/	RANF=X1/2097152.D0
/	RETURN
/
	SECT8	#RANF
	EXTERN	#FIX
#XR,	ORG	.+1
	TEXT	+RANF  +
#RET,	SETB	#BASE
	JA	.+3
#BASE,	ORG	.+6
R,	ORG	.+3
	ORG	#BASE+30
	FNOP
	JA	#RET
	FNOP
#RTN,
#GOBAK,	0;0
	DPCHK
P,	ORG	.+0006
X1,	ORG	.+0006
#TMP,	ORG	.+006
#LIT,	0025		/2028371
	3674
	6514
	0000
	0000
	0000
	0026		/2**21
	2000
	0000
	0000
	0000
	0000
	BASE	#BASE
	ENTRY RANF
RANF,	STARTD
	0210
	FSTA	#GOBAK,0
	0200
	SETB	#BASE
	#G0001=.
	ORG	X1+0000
	0025;2022;3064;0000;0000;0000
	ORG	#G0001
	STARTE
	FLDA	#LIT
	FMUL	X1
	FSTA	P
	FDIV	#LIT+6
	FSTA	#TMP
	STARTF
	FLDA	#TMP+0000
	JSA	#FIX
	STARTE
	FMUL	#LIT+6
	FNEG
	FADD	P
	FSTA	X1
	FDIV	#LIT+6
	STARTF
	JA	#RTN
/
	ENTRY	RANSET
RANSET,	STARTD
	0210
	FSTA	#GOBAK,0
	0200
	SETX	#XR
	SETB	#BASE
	LDX	0,1
	FSTA	#BASE
	FLDA%	#BASE,1+
	FSTA	R
	STARTF
	FLDA%	R
	FSTA	R
	TRAP4	RNSET
	JA	#RTN
/
RNSET,	0
	TAD	M25	/SET EXPONENT
	DCA	X1
	TAD	R+1	/FORCE POSITIVE
	AND	M3777
	DCA	X1+1
	TAD	R+2
	AND	M7774
	DCA	X1+2
	CDF CIF 0
	JMP%	RNSET
M25=#LIT
M3777,	3777
M7774,	7774
	END
