C	DELTM5.FT
C	PLOTS DC/C-BAR VS LOG C TO GET
C	AVERAGE DM/M
C	NEEDS LSQSE.FT
C	CHAINED BY DELTM4
C	8/14/75
C
	COMMON AMAG,AST,NPOIT,RIR,ROR
	COMMON X,DY,YBAR,DYDX,IXY
	DIMENSION X(150),DY(150),YBAR(150),DYDX(150),IXY(2,150)
	DIMENSION CS(100),AMS(100),CR(100),AMR(100)
	CALL IOPEN('DTA1',AMAG)
	READ(4,2002)NPOIT
	DO 150 I=1,NPOIT
	READ(4,2002)I,X(I),DYDX(I),YBAR(I),DY(I),CS(I),SIG1,CR(I),SIG2
	AMS(I)=SIG1
	AMR(I)=SIG2
150	CONTINUE
2002	FORMAT(I4,F7.4,F8.4,F7.3,F9.0,2(F7.3,F9.5))
	SUMM=0.
	SUMC=0.
	SUMMS=0.
	SUMMR=0.
	CUMCS=0.
	SUMCR=0.
	DELX=(X(NPOIT)-X(1))/FLOAT(NPOIT-1)
	DO 160 I=2,NPOIT
	K=I-1
	Y1=YBAR(I)*X(I)
	Y2=YBAR(K)*X(K)
	DELC=.5*DELX*(Y1+Y2)
	DELM=DY(I)*Y1+DY(K)*Y2
	SUMC=SUMC+DELC
	SUMM=SUMM+.5*DELX*DELM
	Y1=CS(I)*X(I)
	Y2=CS(K)*X(K)
	DELC=.5*DELX*(Y1+Y2)
	DELM=AMS(I)*Y1+AMS(K)*Y2
	SUMCS=SUMCS+DELC
	SUMMS=SUMMS+.5*DELX*DELM
	Y1=CR(I)*X(I)
	Y2=CR(K)*X(K)
	DELC=.5*DELX*(Y1+Y2)
	DELM=AMR(I)*Y1+AMR(K)*Y2
	SUMCR=SUMCR+DELC
	SUMMR=SUMMR+.5*DELX*DELM
160	CONTINUE
	SUMM=SUMM/SUMC
	SUMMS=SUMMS/SUMCS
	SUMMR=SUMMR/SUMCR
	WRITE(1,2005)SUMM,SUMMS,SUMMR
2005	FORMAT('MASS AVERAGE',14XF9.0,2(7XF9.5))
	DO 170 I=1,NPOIT
	X(I)=.5*X(I)**2
	CS(I)=ALOG(CS(I))
170	CR(I)=ALOG(CR(I))
	CALL LSQSE(AI,SEA,BS,SEB,1,NPOIT,CS,DYDX)
	CALL LSQSE(AI,SEA,DS,SED,1,NPOIT,CR,DYDX)
	CALL LSQSE(AI,SEA,ES,SEE,1,NPOIT,X,DYDX)
	ES=AST*ES
	SEE=AST*SEE
	WRITE(1,2003)ES,BS,DS
	WRITE(1,2004)SEE,SEB,SED
2003	FORMAT('VOL. AVERAGE',14XF9.0,2(7XF9.5))
2004	FORMAT('+/-         ',14XF9.0,2(7XF9.5))
	END
