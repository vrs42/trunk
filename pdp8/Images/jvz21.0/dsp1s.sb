/  DSP1S.SB
/  MODIFIED FROM DISP1 IN PLOT1.SB
/PLOT1.SB  (8/16/71 - C.M.MOORE, RICE U., HOUSTON)
/
/
ABSYM POINT 10 /POINT MUST BE AN AUTO-INDEX REGISTER
/
OPDEF TADI 1400
OPDEF JMPI 5400
/
/ENTRYP DOES THE FOLLOWING
/1)SAVES LINC INSTRUCTION FIELD LOCATION 1 IN SAVE1.
/2)MOVES ENTRY POINT POINTERS TO DISP1
/3)CALLS GETARG TO FETCH 1ST ARG ADDRESS, THEN FETCHES ARG.
N,
ENTRYP,	0
	CLA CMA CLL RTL /SET AC=-3
	TAD ENTRYP
	DCA TEM /POINTS TO ENTRY POINT OF CALLING PROG.
	6141 /LINC
	2001 /ADD 1
	1060 /STA I
SAVE1,	0
	0002 /PDP
	CLA CLL CML RTL /SET AC=2
	TADI TEM
	DCA CDFCIF /SET UP FOR QUICK RETURN
	TADI TEM
	INC TEM
	DCA CDFDIS
	TADI TEM
	DCA DSP1S#
	JMS GETARG /GET 1ST ARG ADDRESS
	TADI POINT /FETCH 1ST ARG
	JMPI ENTRYP
/
/GETARG FETCHES ADDRESS OF NEXT ARG POINTED TO BY DSP1S
Y,
GETARG,	0
CDFDIS,	0 /CHANGE TO DF OF DISP1
	TADI DSP1S#
	INC DSP1S#
	DCA TEM
	CLA CMA
	TADI DSP1S#
TEM,	0 /CHANGE TO DF OF ARG
	INC DSP1S#
	DCA POINT /AUTO-INDEX REGISTER
	JMPI GETARG
/
/SUBROUTINE DSP1S(N,IXY)
	ENTRY DSP1S
DSP1S,	BLOCK 2
	JMS ENTRYP /GET N
	CIA
	DCA N
	JMS GETARG /GET IXY
/PLOT LOOP
PLUP1,	CLA
	TADI POINT /AUTO-INDEX
	JMS STC1 /STORE IN LOC 1.
	TADI POINT
	6141 /LINC
	0141 /DIS 1
	0002 /PDP
	CLA
/  DELAY LOOP
	TAD  (-3000
	DCA  CNT
PLW1,	CLA CLL IAC RTL
	CMA
PLW2,	IAC
	SPA
	JMP PLW2
	ISZ  CNT
	JMP  PLW1
/
	ISZ N
	JMP PLUP1
JBACK,	CLA
	TAD SAVE1
	JMS STC1 /RESTORE I.F. LOC 1.
CDFCIF,	HLT /CHANGE TO DF&IF OF CALLING PROG.
	JMPI DSP1S# /QUICK RETURN
CNT,	0
/
/
/STC1 STORES AC INTO LINC-MODE INSTRUCTION FIELD LOCATION 1.
STC1,	0
	6141 /LINC
P4001,	4001 /STC 1
	0002 /PDP
	JMPI STC1
	END
