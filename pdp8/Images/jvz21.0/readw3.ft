C  ROUTINE TO READ UNFORMATTED LIST WRITTEN DURING
C  WATER3 RUN.
	DIMENSION K(10,13),AMOV(2)
	AMOV(1)='      '
	AMOV(2)=' MOVED'
	NBLK=0
5	NBLK=NBLK+1
2	CALL RLINC(1,NBLK,1,K,128)
	DO 10  J=1,12
	IF(K(10,J)) 10,12,12
10	CONTINUE
	J=12
12	DO 20  I=1,J
	N=K(1,I)
	X=FLOAT(K(2,I)) +FLOAT(K(3,I))/1000.
	Y=FLOAT(K(4,I)) +FLOAT(K(5,I))/1000.
	Z=FLOAT(K(6,I)) +FLOAT(K(7,I))/1000.
	IX=K(8,I)+1
	WRITE(1,1020)N,X,Y,Z,AMOV(IX)
1020	FORMAT(I6,3F9.3,1X,A6)
20	CONTINUE
	IF(J-12)25,5,5
25	STOP
	END
