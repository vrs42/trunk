	SUBROUTINE SEPCOR(NPOIT)
C	SUBROUTINE FOR PROG1.FT WHICH CORRECTS FOR
C	BAD FRINGE DISCONTINUITIES
C
	COMMON X,Y,SEPR,DELX,NBAS,RIR,ROR,IY,IB,IXY
	DIMENSION X(150),Y(150),IY(150),IB(150),IXY(2,150)
	WRITE(1,2003)
2003	FORMAT('E TO CORRECT PTS FROM CURSOR TO RIGHT,Q TO CONT')
	WRITE(1,2004)
2004	FORMAT('1,2,..I, TO ADD I*SEPRN;-1,-2,..-I TO SUBTRACT')
	MULT=3
	IF(NPOIT-85)10,10,20
10	MULT=6
20	DO 30 I=1,NPOIT
30	IXY(1,I)=MULT*I
	N=(NPOIT*2)/3
33	YMAX=Y(NPOIT)
	DO 40 I=N,NPOIT
	IF(Y(I)-YMAX)40,40,35
35	YMAX=Y(I)
40	CONTINUE
	YMULT=500./(YMAX-1.)
	DO 50 I=1,NPOIT
50	IXY(2,I)=IFIX(YMULT*(Y(I)-1.))-250
60	M1=IABS(NALOG(0))-1
	CALL DISP1(NPOIT,IXY)
	CALL DISP2(NPOIT,IXY)
	CALL DISP6(M1)
	L=KEYBD(0)
	IF(L-197)60,70,100
70	K=M1/MULT+1
	READ(1,1005)FI
1005	FORMAT('CORRECTION:'F3.0)
	DO 80 I=K,NPOIT
80	Y(I)=Y(I)+FI*SEPR
	GO TO 33
100	RETURN
	END
