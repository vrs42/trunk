	COMMON NATM
	DIMENSION T(8),NATM(2047)
C
	DO 2  I=1,2047
2	NATM(I)=0
	CALL IOPEN('DSK','CHYMCC')
	READ(1,1002)FN
1002	FORMAT('TYPE OUTPUT FILENAME (COORD):  ',A6)
	READ(1,1003)FNW
1003	FORMAT('TYPE OUTPUT FILENAME (WATER):  ',A6)
	CALL OOPEN('DSK',FN)
4	READ(1,1004)X1,X2
1004	FORMAT('TYPE X AXIS RANGE (2F6.0):  ',2F6.0)
	IF(X1-X2)5,4,4
5	WRITE(1,1005)X1,X2
1005	FORMAT(2F8.2)
C
	READ(4,1010)T,NA
1010	FORMAT(8A6/I6)
	WRITE(1,1012)NA
1012	FORMAT('NATOM=',I6)
	NWR=0
	WRITE(4,1010)T,NWR
	DO 50  I=1,NA
	READ(4,1020)N,X,Y,Z,R
1020	FORMAT(I5,3F8.3,F5.2)
	IF(X-X2)21,21,50
21	IF(X-X1)51,22,22
22	WRITE(4,1020)N,X,Y,Z,R
	NATM(N)=1
	NWR=NWR+1
50	CONTINUE
51	WRITE(4,1999)
1999	FORMAT(' -999')
	WRITE(1,1012)NWR
	CALL OCLOSE
C
	NWR=0
	CALL IOPEN('DSK','CHMW3E')
	CALL OOPEN('DSK',FNW)
	WRITE(4,1010)T,NWR
	READ(4,1010)T,NW
	WRITE(1,1012)NW
	DO 66  I=1,NW
	READ(4,1060)N,(T(J),J=1,5)
	IF(NATM(N))66,66,62
62	NWR=NWR+1
	WRITE(4,1060)N,(T(J),J=1,5)
66	CONTINUE
1060	FORMAT(I5,5A6)
	WRITE(4,1999)
	CALL OCLOSE
	WRITE(1,1012)NWR
	STOP
	END
