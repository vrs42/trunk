C	PROGRAM ISOMV2.FT TO CALC FRICTIONAL COEFFICIENT
C  FOR MULTIPLE RUNS
C	FROM ATOMIC COORDINATES
C	LAST REVISION AUG 22,1975
C	NOW READS TITLE LINE, AND NALFA,RW (ANGSTROMS) FROM INPUT FILE
C
	COMMON IXYZ,NATOM
	DIMENSION NATOM(910),IXYZ(3,910),XB(3),TITLE(10),FMSG(8)
	WRITE(1,1111)
1111	FORMAT('PROGRAM ISOMV2')
11	READ(1,1101)NRUN
1101	FORMAT('TYPE NUMBER OF RUNS: ',I2)
	IF(NRUN-8)1,1,11
1	DO 4  I=1,NRUN
4	READ(1,1000)FMSG(I)
1000	FORMAT('INPUT TITLE:  DSK:'A6)
	READ(1,1003)GMSG
1003	FORMAT('OUTPUT TITLE(A6) DSK:'A6)
	CALL OOPEN('DSK',GMSG)
	READ(1,1004)NEXPS
1004	FORMAT('TYPE NUMBER OF EXPANSIONS:',I2)
	NEXPS=NEXPS+1
C
	SPI=6.*3.1415927*.01002
C
	DO 200  IRUN=1,NRUN
	CALL IOPEN('DSK',FMSG(IRUN))
	READ(4,1011) TITLE
	WRITE(1,1011) TITLE
1011	FORMAT(10A6)
	READ(4,1014)NALFA,RW
1014	FORMAT(I6,F7.3)
	WRITE(1,1044)NALFA,RW
1044	FORMAT('NALFA=',I6,'    RW=',F8.3)
	IF(NALFA-910)3,3,5
3	DO 10 I=1,NALFA
	READ(4,1002)NATOM(I),X,Y,Z
1002	FORMAT(I5,3F8.3)
	IXYZ(1,I)=X*10.
	IXYZ(2,I)=Y*10.
	IXYZ(3,I)=Z*10.
	IF(NATOM(I)+999)10,5,10
10	CONTINUE
	GO TO 14
5	WRITE(1,1005)
1005	FORMAT('CANNOT READ ENTIRE COORD FILE')
	STOP
C
C	COMPUTE CENTER OF SHELL
14	DO 100 K=1,3
	SUM=0.
	DO 90 I=1,NALFA
90	SUM=SUM+FLOAT(IXYZ(K,I))
100	XB(K)=SUM/FLOAT(NALFA)
C
C	MOVE ORIGIN TO CENTER AND COMPUTE DISTANCES TO CENTER
	DO 110 I=1,NALFA
	DO 110 K=1,3
	XYZ=IXYZ(K,I)
	R=0.5
	IF(XYZ)108,110,110
108	R=-R
110	IXYZ(K,I)=(XYZ-XB(K))+R
C
	FACT=1.
	WRITE(4,1110)TITLE,NALFA,RW
1110	FORMAT(/10A6/'NALFA=',I5,'    RW=',F8.3)
C
	DO 1500 IJK=1,NEXPS
C
C	COMPUTE FRICTION
C	NOW PARTIAL SUMS ARE USED TO AVOID TRUNCATION ERROR.
C
	SUM=0.
	I2=NALFA-1
	DO 55 I=1,I2
S	TAD  \I
S	7421	/SHOW I IN MQ
C  'E' EXITS
	K=KEYBD(0)
	IF(K-197)29,1505,29
29	SSUM=0
	M=I+1
	DO 50 J=M,NALFA
	DIS=0.
	DO 30 K=1,3
	DXYZ=IXYZ(K,I)-IXYZ(K,J)
30	DIS=DIS+DXYZ**2
	DIS=SQRT(DIS)
50	SSUM=SSUM+1./DIS
55	SUM=SUM+SSUM
	SUM=SUM*10.
C
	FN=NALFA
	FRICT=SPI*FN*RW
	FRICT=FRICT/(1.+2.*RW*SUM/FN)
	WRITE(4,2000)IJK,FRICT,SUM
2000	FORMAT(I3,'  FRICTIONAL COEFF ='F10.6/'DBL SUM ='E15.7)
	WRITE(4,2001)FACT
2001	FORMAT('EXPANSION FACTOR ='F10.6)
C
C	COMPUTE MEAN DIS TO CENTER
	SMEAN=0
	DO 140 I=1,NALFA
	SUM=0.
	DO 135 K=1,3
135	SUM=SUM+FLOAT(IXYZ(K,I))**2
140	SMEAN=SMEAN+SQRT(SUM)
	SMEAN=0.1*SMEAN/FLOAT(NALFA)
	WRITE(4,2002)SMEAN
2002	FORMAT('MEAN DIS ='F9.4/)
C
C  MOVE OUT FROM CENTER BY FACT
	FACT=FACT*1.03
	DO 170  I=1,NALFA
	DO 170  K=1,3
	XYZ=IXYZ(K,I)
	R=0.5
	IF(XYZ)169,170,170
169	R=-R
170	IXYZ(K,I)=XYZ*1.03+R
1500	CONTINUE
C
200	CONTINUE
	WRITE(4,1511)
1511	FORMAT('END OF ISOMOV')
1505	CALL OCLOSE
S	HLT
	END
