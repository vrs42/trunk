/BIGMD4.RA
/
/ ROUTINES TO SUPPORT LARGE MATRIX STORAGE ON DISK.
/ DIRECT DISK ACCESS (FAST), NOT UNDER OS/8 CONTROL.
/ MAY OVERWRITE OS/8 FILES.
/
/ DOUBLE PRECISION ROUTINE
/
/ THIS SECTION INCLUDES:
/	SUBROUTINE DMATI(I,J)
/	SUBROUTINE DZERO
/	SUBROUTINE DMATW(I,J,V)
/	FUNCTION DMAT(I,J)
/
/ X REGISTRER 0 TRACEBACK CODES:
/	0100	DMATI
/	0200	DZERO
/	0300+N  DMAT
/	0400+N	DMATW
/	N IS BLOCK NUMBER
/
/
	SECT	#DMAT
	DPCHK
#XR,	ORG	.+10
	TEXT	+#DMAT +
#RET,	SETX	#XR
	SETB	#BASE
	JA	.+3
#BASE,	ORG	.+6
I,	ORG	.+3
J,	ORG	.+3
V,	ORG	.+3
	ORG	#BASE+30
	FNOP
	JA	#RET
	FNOP
#RTN,
#GOBAK,	0;0
#VAL,	ORG	.+6
EXD0,	ORG	.+3
IFL,	ORG	.+0003
IMAX,	ORG	.+3
IMX2,	ORG	.+3
I12,	ORG	.+0003
JJ,	ORG	.+0003
JMAX,	F	-1.
JPW,	F	-1.
NA1,	F	-1.
NA2,	F	-1.
NREC,	ORG	.+3
SPR,	ORG	.+3
/
F1,	F	1.
F2,	F	2.
F4,	F	4.
FD99,	F	.99
F252,	F	252.
F42H,	F	42.5
F546,	F	546.
F4095,	F	4095.
F6479,	F	6479.
F6495,	F	6495.
FMAX,	F	268800.
/
A1,	ORG	.+6314
A2,	ORG	.+6314
B,	ORG	.+6314
 
	BASE	#BASE
/
/ ENTRY POINT FOR FUNCTION DMAT(I,J)
/
	ENTRY	DMAT
DMAT,	STARTD
	0210
	FSTA	#GOBAK,0
	0200
	SETX	#XR
	SETB	#BASE
	LDX	0,1
	FSTA	#BASE
	FLDA%	#BASE,1+
	FSTA	I
	FLDA%	#BASE,1+
	FSTA	J
	STARTF
	LDX	0300,0
	FLDA%	I
	ATX	7		/XR 7 CONTAINS I
	FLDA%	J
	FSTA	JJ		/JJ CONTAINS J
	FSUB	JPW
	JEQ	#40
	FLDA	JJ
	FSUB	NA1
	JNE	#5
	STARTE
	FLDA	A1-0006,7	/ENTRY IS IN A1(I)
	EXTERN	#NE
	JA	#RTN
 
#5,	FLDA	JJ
	FSUB	NA2
	JNE	#10
	STARTE
	FLDA	A2-0006,7	/ENTRY IS IN A2(I)
	JA	#RTN
 
#10,	FLDA	JJ
	JLE	#391
	FSTA	NREC
	FSUB	JMAX
	JGT	#391
	TRAP4	CPUIN
	FLDA	I12
	JNE	#20
	JSA	RDSK1		/READ ROW INTO A1
	SETX	#XR
	STARTE
	FLDA	A1-0006,7
	FSTA	#VAL
	STARTF
	FLDA	JJ
	FSTA	NA1
	FLDA	F1
	FSTA	I12
	TRAP4	CPOUT
	STARTE
	FLDA	#VAL
	JA	#RTN
 
#20,	JSA	RDSK2		/READ ROW INTO A2
	SETX	#XR
	STARTE
	FLDA	A2-0006,7
	FSTA	#VAL
	STARTF
	FLDA	JJ
	FSTA	NA2
	FCLA
	FSTA	I12
	TRAP4	CPOUT
	STARTE
	FLDA	#VAL
	JA	#RTN
 
#40,	STARTE
	FLDA	B-0006,7	/ENTRY IS IN B(I)
	JA	#RTN
 
/
/ ENTRY POINT FOR SUBROUTINE DMATW(I,J,V)
/
	ENTRY	DMATW
DMATW,	STARTD
	0210
	FSTA	#GOBAK,0
	0200
	SETX	#XR
	SETB	#BASE
	LDX	0,1
	FSTA	#BASE
	FLDA%	#BASE,1+
	FSTA	I
	FLDA%	#BASE,1+
	FSTA	J
	FLDA%	#BASE,1+
	FSTA	V
	STARTF
	LDX	0400,0
#105,	FLDA%	J
	JLE	#391
	FSTA	JJ
	FSUB	JMAX
	JGT	#391
	FLDA	JPW
	JLE	#130		/FIRST TIME ENTRY
	FSTA	NREC
	FSUB	JJ
	JEQ	#150
	TRAP4	CPUIN
	JSA	WDSK1		/WRITE PREVIOUS ROW FROM B
	SETX	#XR
	TRAP4	CPOUT
 
#130,	LDX	0,2
	FLDA	JJ
	FSUB	NA1
	JEQ	#140
	FLDA	JJ
	FSTA	NREC
	FSUB	NA2
	JEQ	#145
 
	TRAP4	CPUIN
	JSA	RDSK3	/READ CURRENT ROW INTO B
	SETX	#XR
	TRAP4	CPOUT
	JA	#148
 
#140,	FLDA	IMX2		/GET ROW FROM A1
	ATX	1
	STARTE
	FLDA	A1-6,2+
	FSTA	B-6,2
	JXN	.-4,1+
	STARTF
	JA	#148
 
#145,	FLDA	IMX2		/GET ROW FROM A2
	ATX	1
	STARTE
	FLDA	A2-6,2+
	FSTA	B-6,2
	JXN	.-4,1+
	STARTF
 
#148,	FLDA	JJ
	FSTA	JPW
 
#150,	FLDA%	I
	ATX	7
	STARTE
	FLDA%	V
	FSTA	B-0006,7
	STARTF
	FLDA	JJ
	FSUB	NA1
	JNE	.+7		/CHECK IF ENTRY BELONGS IN A1
	STARTE
	FLDA%	V
	FSTA	A1-0006,7
	STARTF
	FLDA	JJ
	FSUB	NA2
	JNE	.+7		/OR A2
	STARTE
	FLDA%	V
	FSTA	A2-0006,7
	STARTF
	JA	#RTN
/
/ ENTRY POINT FOR SUBROUTINE DMATI(I,J)
/ INITIALIZATION ROUTINE
/
	ENTRY	DMATI
DMATI,	STARTD
	0210
	FSTA	#GOBAK,0
	0200
	SETX	#XR
	SETB	#BASE
	LDX	0,1
	FSTA	#BASE
	FLDA%	#BASE,1+
	FSTA	I
	FLDA%	#BASE,1+
	FSTA	J
	STARTF
	LDX	0020,0
	FLDA%	I
	FSTA	IMAX
	FSUB	F546
	JGT	#391		/CHECK IMAX.LE.546
	FLDA%	J
	FSTA	JMAX
	FMUL	IMAX
	FSUB	FMAX	/TOTAL SIZE CHECK (<268801)
	JGT	#391
	FLDA	IMAX
	FDIV	F42H
	FADD	FD99		/+.99 TO ROUND UP
	EXTERN	#FIX
	JSA	#FIX
	FSTA	SPR		/SECTORS/RECORD
	FLDA	IMAX
	FNEG
	FSTA	IMX2		/-IMAX
	FLDA	SPR
	FMUL	JMAX
	FSTA	#VAL
	EXTERN	#WRITO
	TRAP3	#WRITO		/SECTORS REQUIRED MESSAGE
	JA	F4
	JA	#1390
	FLDA	#VAL
	FADD	F6495
	FSUB	F6479
	EXTERN	#RSVO
	TRAP3	#RSVO
	EXTERN	#RENDO
	TRAP3	#RENDO
	FLDA	#VAL
	FNEG
	FADD	F6479
	JLE	#391
	FSTA	EXD0		/STARTING DISK ADDRESS
	FLDA	F4
	FNEG
	FSTA	NA1
	FSTA	NA2
	FSTA	JPW
	TRAP4	CPUIN
	TRAP4	DISKI
	TRAP4	CPOUT
	JA	#RTN
#1390,	TEXT	+(' #DMATI--',I5,' SECTORS REQUIRED')+
 
#391,	EXTERN	#WRITO		/ERROR EXIT
	TRAP3	#WRITO
	JA	F4
	JA	#1391
	EXTERN	#RENDO
	TRAP3	#RENDO
	EXTERN	#EXIT
	JSR	#EXIT
 
#1391,	TEXT	+(' ERROR IN #DMAT--I OR J OUT OF RANGE')+
/
/
	ENTRY	DZERO		/ZERO ARRAY AREA
DZERO,	STARTD
	0210
	FSTA	#GOBAK,0
	0200
	SETX	#XR
	SETB	#BASE
	LDX	0,1
	FSTA	#BASE
	STARTF
	LDX	0200,0
	FLDA	JMAX
	FNEG
	ATX	4
	LDX	-1042,5		/-546
	LDX	0,6
	FCLA
	STARTE
	FSTA	B-6,6+		/ZERO B
	JXN	.-2,5+
	STARTF
	FSTA	NREC
G0301,	FLDA	F1
	FADDM	NREC		/NREC=NREC+1
	JSA	WDSK1		/WRITE ZERO RECORD
	SETX	#XR
	JXN	G0301,4+
	JA	#RTN
/
/
/
/ DIRECT DISK ACCESS ROUTINES
/
/
/ ROUTINE TO READ RECORD INTO B
RDSK3,	JA	.
	SETX	XR
	LDX	0300,0
	FLDA	NREC
	FMUL	SPR
	FADD	EXD0
	ATX	1	/STARTING DISK ADDRESS
	FSUB	F4095	/CHECK FOR EXTENDED BIT
	LDX	0,2
	JLE	.+4
	LDX	1,2
	FLDA	SPR
	FNEG
	ATX	4	/ -# SECTORS/RECORD
	LDX	0,5
G0021,	TRAP4	DISKR		/READ
	LDX	-125,6
	LDX	0,7
	FLDA	BUFR-3,7+
	FSTA	B-3,5+
	JXN	.-4,6+
	JXN	.+4,4
	JA	G0023
G0022,	TRAP4	DISKR
	LDX	-125,6
	LDX	0,7
	FLDA	BUFR2-3,7+
	FSTA	B-3,5+
	JXN	.-4,6+
	JXN	G0021,4
	LDX	-125,6
	LDX	0,7
	FLDA	BUFR-3,7+
	FSTA	B-3,5+
	JXN	.-4,6+
	JA	RDSK3
G0023,	LDX	-125,6
	LDX	0,7
	FLDA	BUFR2-3,7+
	FSTA	B-3,5+
	JXN	.-4,6+
	JA	RDSK3
/
/
/ ROUTINE TO WRITE RECORD FROM B
WDSK1,	JA	.
	SETX	XRW
	LDX	0400,0
	FLDA	SPR
	FNEG
	ATX	4	/ -# SECTORS/RECORD
	FLDA	NREC
	FMUL	SPR
	FADD	EXD0
	ATX	1	/STARTING DISK ADDRESS
	FSUB	F4095
	LDX	0,2
	JLE	.+4
	LDX	1,2
	LDX	0,5
G0033,	LDX	-125,6
	LDX	0,7
	FLDA	B-3,5+
	FSTA	BUFR-3,7+
	JXN	.-4,6+
	TRAP4	DISKW		/WRITE
	JXN	.+4,4
	JA	G0034
	LDX	-125,6
	LDX	0,7
	FLDA	B-3,5+
	FSTA	BUFR2-3,7+
	JXN	.-4,6+
	TRAP4	DISKW
	JXN	G0033,4
G0034,	JA	WDSK1
/
/
/ ROUTINE TO READ RECORD INTO A1
RDSK1,	JA	.
	SETX	XR
	LDX	0300,0
	FLDA	NREC
	FMUL	SPR
	FADD	EXD0
	ATX	1	/STARTING DISK ADDRESS
	FSUB	F4095
	LDX	0,2
	JLE	.+4
	LDX	1,2
	FLDA	SPR
	FNEG
	ATX	4	/ -# SECTORS/RECORD
	LDX	0,5
G0001,	TRAP4	DISKR		/READ
	LDX	-125,6
	LDX	0,7
	FLDA	BUFR-3,7+
	FSTA	A1-3,5+
	JXN	.-4,6+
	JXN	.+4,4
	JA	G0003
G0002,	TRAP4	DISKR
	LDX	-125,6
	LDX	0,7
	FLDA	BUFR2-3,7+
	FSTA	A1-3,5+
	JXN	.-4,6+
	JXN	G0001,4
	LDX	-125,6
	LDX	0,7
	FLDA	BUFR-3,7+
	FSTA	A1-3,5+
	JXN	.-4,6+
	JA	RDSK1
G0003,	LDX	-125,6
	LDX	0,7
	FLDA	BUFR2-3,7+
	FSTA	A1-3,5+
	JXN	.-4,6+
	JA	RDSK1
/
/
/ ROUTINE TO READ RECORD INTO A2
RDSK2,	JA	.
	SETX	XR
	LDX	0300,0
	FLDA	NREC
	FMUL	SPR
	FADD	EXD0
	ATX	1	/STARTING DISK ADDRESS
	FSUB	F4095
	LDX	0,2
	JLE	.+4
	LDX	1,2
	FLDA	SPR
	FNEG
	ATX	4	/ -# SECTORS/RECORD
	LDX	0,5
G0011,	TRAP4	DISKR
	LDX	-125,6
	LDX	0,7
	FLDA	BUFR-3,7+
	FSTA	A2-3,5+
	JXN	.-4,6+
	JXN	.+4,4
	JA	G0013
G0012,	TRAP4	DISKR
	LDX	-125,6
	LDX	0,7
	FLDA	BUFR2-3,7+
	FSTA	A2-3,5+
	JXN	.-4,6+
	JXN	G0011,4
	LDX	-125,6
	LDX	0,7
	FLDA	BUFR-3,7+
	FSTA	A2-3,5+
	JXN	.-4,6+
	JA	RDSK2
G0013,	LDX	-125,6
	LDX	0,7
	FLDA	BUFR2-3,7+
	FSTA	A2-3,5+
	JXN	.-4,6+
	JA	RDSK2
/
/
	SECT8	#CPUIN
CPUIN,	0			/DISABLES CPU LOCKOUT
	IOF
	CDF	0
	TAD%	XADDR
	SNA
	HLT
	AND	CM7360		/CHECKS FOR 400 OR 410
	SZA
	HLT
	TAD%	XADDR
	DCA	CPTMP		/SAVE RESTART CODE
	TAD	CM400
	DCA%	XADDR	/FORCES CPU IN ON RESTART
	CIF	0
	ION
	JMP%	CPUIN
CPOUT,	0			/ALLOWS CPU LOCKOUT AGAIN
	IOF
	CDF	0
	TAD	CPTMP
	DCA%	XADDR
	CIF	0
	ION
	JMP%	CPOUT
CM400,	400
CM7360,	7360
CPTMP,0
XADDR,	5776		/FRTS LOCATION FOR FPP COMMAND REGISTER VALUE
/			 WHEN RESTARTED AFTER A TRAP
/
/
	DSKP=6741
	DCLR=6742
	DRST=6745
	DLDC=6746
	DLAG=6743
	DLCA=6744
/
/
	SECT8	#DISKR
DISKR,	0		/READ ROUTINE
	IOF
	ISZ	XR
D002,	DSKP		/WAIT FOR PREVIOUS TRANSFER
	JMP	.-1
	DRST		/CHECK READY
	TAD	N4000
	SZA
	JMS	ERR1	/TO ERROR ROUTINE
	DCLR
	TAD	D1	/D1 TELLS WHICH BUFFER TO USE
	SZA CLA
	JMP	.+5
	TAD	BUFAD
	DCA	TMP1
	TAD	BUFAD+1
	JMP	.+4
	TAD	BFAD2
	DCA	TMP1
	TAD	BFAD2+1
	DCA	SVLCA
	TAD	SVLCA
	DLCA		/LOAD BUFFER MEMORY ADDRESS
	TAD	TMP1	/FIELD OF BUFFER
	CLL RTL
	RAL
	TAD	EXDAD	/EXTENDED CYL ADDRESS BIT
	TAD	RCMD
	DCA	SVLDC
	TAD	SVLDC
	DLDC		/SET COMMAND REGISTER
	TAD	DADDR	/BLOCK ADDRESS
	AND	M17	/CONVERT TO DISK ADDRESS
	CLL RAL
	DCA	TMP1
	TAD	DADDR
	AND	M20
	CLL RTR;RTR
	TAD	TMP1	/SECTOR ADDRESS
	DCA	TMP1
	TAD	DADDR
	AND	M7740
	TAD	TMP1	/DISK ADDRESS
	DCA	SVLAG
	TAD	SVLAG
	DLAG		/READ!
/
D004,	ISZ	SCNT
	SKP
	JMP	D010	/IF LAST SECTOR
	ISZ	DADDR	/NEXT SECTOR/TRACK
	JMP	.+2
	ISZ	EXDAD
	TAD	D1	/SWITCH D1
	SZA CLA
	CMA
	IAC
	DCA	D1
	ISZ	D3	/FIRST SECTOR?
	SKP
	JMP	D002	/GO BACK TO INITIATE NEXT TRANSFER
D007,	CDF CIF 0
	ION
	JMP%	DISKR
D010,	DSKP		/LAST SECTOR, WAIT
	JMP	.-1
	DRST		/CHECK STATUS
	TAD	N4000
	SZA
	JMS	ERR1	/TO ERROR ROUTINE
	DCA	D1
	CMA
	DCA	D3	/=-1
	JMP	D007	/RETURN
/
ERR1,	0		/ERROR RECOVERY
	AND	M7767	/CRC ERROR?
	SZA
	JMP	ERR2
	TAD	SVLCA	/RECOVER DISK REGISTERS
	DLCA
	TAD	SVLDC
	DLDC
	TAD	SVLAG
	DLAG		/READ AGAIN
	DSKP
	JMP	.-1	/WAIT
	DRST
	TAD	N4000
	SNA
	JMP	ERR3	/GOOD NOW
	ISZ	ERRCNT
	JMP	ERR1+1
ERR2,	7421		/NOT RECOVERABLE
	CDF CIF	0
	JMP%	USRERR+1
ERR3,	TAD	N10
	DCA	ERRCNT
	JMP%	ERR1
/
BUFAD,	ADDR	BUFR
BFAD2,	ADDR	BUFR2
D1,	0
D3,	-1
ERRCNT,	-10
M10,	10
M17,	17
M20,	20
N4000,
M4000,	4000
M7740,	7740
M7767,	7767
N10,	-10
RCMD,	0
SVLCA,	0
SVLDC,	0
SVLAG,	0
TMP1,	0
XR,			   /X REG
	0			/0
DADDR,	0			/1
EXDAD,	0			/2
	0			/3
SCNT,	0			/4
	ORG	XR+10
	EXTERN	#UE
USRERR,	JA	#UE
/
/
/
	SECT8	#DSKW
DISKW,	0		/WRITE ROUTINE
	IOF
/
	DSKP
	JMP	.-1
	DRST		/CHECK READY
	TAD	N4000W
	SZA
	JMP	ERR1W	/ERROR
	DCLR
	ISZ	XRW
	TAD	D1W	/D1W TELLS WHICH BUFFER TO USE
	SZA CLA
	JMP	.+5
	TAD	BUFADW
	DCA	TMP1W
	TAD	BUFADW+1
	JMP	.+4
	TAD	BFAD2W
	DCA	TMP1W
	TAD	BFAD2W+1
	DLCA		/LOAD BUFFER MEMORY ADDRESS
	TAD	TMP1W	/FIELD OF BUFFER
	CLL RTL
	RAL
	TAD	EXDADW	/EXTENDED CYL ADDRESS BIT
	TAD	WCMD
	DLDC		/SET COMMAND REGISTER
	TAD	DADDRW	/BLOCK ADDRESS
	AND	M17W	/CONVERT TO DISK ADDRESS
	CLL RAL
	DCA	TMP1W
	TAD	DADDRW
	AND	M20W
	CLL RTR;RTR
	TAD	TMP1W	/SECTOR ADDRESS
	DCA	TMP1W
	TAD	DADDRW
	AND	M7740W
	TAD	TMP1W	/DISK ADDRESS
	DLAG		/WRITE!
/
	CLA CMA
	ISZ	SCNTW
	CLA
	DCA	D2W	/=-1 IF LAST SECTOR
	ISZ	DADDRW	/NEXT SECTOR/TRACK
	JMP	.+2
	ISZ	EXDADW
	TAD	D1W
	SZA CLA		/SWITCH D1W
	CMA
	IAC
	DCA	D1W
	ISZ	D2W
	JMP	.+4
	DCA	D1W
	DSKP		/WAIT IF LAST SECTOR
	JMP	.-1
	CDF CIF 0
	ION
	JMP%	DISKW
/
ERR1W,	7421		/ERROR EXIT
	CDF CIF 0
	JMP%	USRERW+1
/
BUFADW,	ADDR	BUFR
BFAD2W,	ADDR	BUFR2
	EXTERN	#UE
USRERW,	JA	#UE
D1W,	0
D2W,	0
TMP1W,	0
WCMD,	4000
M10W,	10
M17W,	17
M20W,	20
M1000W,  1000
N4000W,
M4000W,	4000
M7740W,	7740
XRW,			    /X REG
	0			/0
DADDRW,	0			/1
EXDADW,	0			/2
	0			/3
SCNTW,	0			/4
	ORG	XRW+10
/
/
DISKI,	0		/INITIAL DISK CHECK
	IOF
	DCLR		/CLEAR STATUS REG
	TAD	DII+2
	DLCA		/CURRENT ADDRESS=BUFR
	TAD	DII+1
	CLL RTL
	RAL
	DLDC		/LOAD COMMAND REG
	TAD	DII
	DLAG		/READ
/ SET PROGRAM TIMER (300 MSEC)
	TAD	DII+5
	DCA	DII+3
	CLA
	IAC
	SPA
	JMP	.+4
	DSKP		/DONE
	JMP	.-4
	JMP	.+4
	ISZ	DII+3
	JMP	.-10
	JMP	DSKI2	/TIMED OUT
	DRST
	TAD	DII+4
	SZA
	JMP	DSKI2
	CDF CIF 0
	ION
	JMP%	DISKI	/RETURN
DSKI2,	CDF CIF 0	/ERROR EXIT
	JMP%	USRERW+1
	
DII,	1323
	ADDR	BUFR
	0
	-4000
	-20
/
/
/ONE SECTOR BUFFERS FOR READ AND WRITE ROUTINES
	SECT8	DISKX
BUFR,	ZBLOCK	400
	SECT8	DISKX2
BUFR2,	ZBLOCK	400
	END
