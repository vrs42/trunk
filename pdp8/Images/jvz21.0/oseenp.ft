C**PROGRAM TO CALC EXACT FRICTN OF PLANE POLYGONS
C**PAUL AND MAZO - COMPARE TO KIRKWOOD
C**CALC EXTENDED OSEEN OF YAMAKAWA AND TANAKA
C::J.C.P.57,1542-1546(1972)
C
	DIMENSION X(100),Y(100),S(3)
	READ(1,1000)NMAX
1000	FORMAT('NMAX:'I2)
	A=1.
	TPI=2.*3.14159265
	PIETA=.01*3.14159265
	STOKE=3.*TPI*.01
	AL=.375
	READ(1,1001)XI
1001	FORMAT('XI (F3.1):'F3.1)
	XI=XI**2
	DO 999 IJK=3,NMAX
	PHI=TPI/FLOAT(IJK)
	R=1./SIN(PHI/2.)
C**GET COORDINATES
	DO 10 I=1,IJK
	SI=I-1
	X(I)=R*COS(SI*PHI)
	Y(I)=R*SIN(SI*PHI)
10	CONTINUE
	NSTOP=IJK-1
	P0=0.
	P2=0.
	Q=0.
	R=0.
	DO 20 IP=1,NSTOP
	FP=IP
	CP=SIN(PHI/2.)/SIN(FP*PHI/2.)
	P0=P0+CP*(3.-XI*CP**2/6.)
	P2=P2+CP*(3.-XI*CP**2/6.)*COS(2.*FP*PHI)
	Q=Q+CP*(1.-.5*XI*CP**2)*COS(FP*PHI)
	R=R+CP*(1.+XI*CP**2/6.)
20	CONTINUE
	P0=P0*.5*AL
	P2=P2*.5*AL
	Q=Q*.5*AL
	R=R*AL
	FN=IJK
	FPAR=((1.+P0)*(1.+P2)-Q**2)/(1.+P2)
	FPAR=FPAR
	FPERP=(1.+R)
	FAV=(2.*FPAR+FPERP)/3.
	FACT=EXP(2.*ALOG(FN)/3.)
	FAV=FAV/FACT
	F1=6.*PIETA
C	FAV IS F-EXACT??
C** NOW MEASURE ALL DISTANCES
	SUMD=0.
	DO 25 L=1,IJK
	K=L+1
	DO 25 M=K,IJK
	DIST=SQRT((X(L)-X(M))**2+(Y(L)-Y(M))**2)
25	SUMD=SUMD+1./DIST
	GN=IJK
	FKIRK=(1.+SUMD*2./GN)/FACT
	FCONT=11.*(ALOG(GN)+1.522*(1.-ALOG(1.+1./GN)))
	FCONT=FCONT/(12.*FACT)
	DEV=(FCONT-FAV)/FAV
40	WRITE(1,2000)IJK,FAV,FKIRK,FCONT,DEV
2000	FORMAT(I5,4F10.5)
2013	FORMAT(5X,2F15.5)
999	CONTINUE
	END
