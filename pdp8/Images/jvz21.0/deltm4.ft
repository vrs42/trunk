C	IS PRESENTLY MODIFIED TO TEST MOVING PROCEDURES
C	TO CHANGE SIMPLY CHAIN TO DELTM1
C	MAY WANT TO LEAVE LIKE THIS HOWEVER
C	3/31/74
C	DELTM4.FT TO COMPUTE DELTA M(W) FROM DIFFERENCE EQUIL
C	CHAINED BY DELTM3
C	REQUIRES DERIVS.FT AS SUBROUTINE
C	NEED LINSMO.FT TO SMOOTH
C
	COMMON AMAG,AST,NPOIT,RIR,ROR
	COMMON X,DY,YBAR,DYDX,IXY
	DIMENSION X(150),DY(150),YBAR(150),DYDX(150),IXY(2,150)
	DIMENSION CS(100),AMS(100),CR(100),AMR(100)
C
	WRITE(1,2000)
2000	FORMAT('C TO STRIP OFF DATA, Q TO CONTINUE')
C	STRIP OFF DATA BELOW .35 FRINGE IN YBAR
	DO 10 I=1,NPOIT
	IF(YBAR(I)-.35)10,10,20
10	CONTINUE
20	NPOIT=NPOIT-I+1
	K=I-1
	YMAX=0.
	YMIN=0.
	DO 70 I=1,NPOIT
	K=K+1
	X(I)=X(K)
	DY(I)=DY(K)
	YBAR(I)=YBAR(K)
	DY(I)=DY(I)/YBAR(I)
	IF(DY(I)-YMIN)40,50,50
40	YMIN=DY(I)
50	IF(DY(I)-YMAX)70,70,60
60	YMAX=DY(I)
70	CONTINUE
	CALL IOPEN('DTA1',AMAG)
	READ(4,2002)NPT
	DO 75 I=1,NPT
75	READ(4,2005)CS(I),AMS(I),CR(I),AMR(I)
	XMIN=X(1)
	XMAX=X(NPOIT)
	XMULT=500./(XMAX-XMIN)
	YMULT=500./(YMAX-YMIN)
	DO 80 I=1,NPOIT
	IXY(1,I)=IFIX((X(I)-XMIN)*XMULT)
80	IXY(2,I)=IFIX((DY(I)-YMIN)*YMULT)-250
90	M1=IABS(NALOG(0))
	CALL DISP1(NPOIT,IXY)
	CALL DISP2(NPOIT,IXY)
	CALL DISP6(M1)
	L=KEYBD(0)
	IF(L-195)90,100,140
100	DO 110 I=1,NPOIT
	IF(IXY(1,I)-(M1+1))110,120,110
110	CONTINUE
	WRITE(1,2001)
2001	FORMAT('WRONG INDEX ON SCREEN, TRY AGAIN')
	GO TO 90
120	NPOIT=NPOIT-I+1
	J=I-1
	DO 130 I=1,NPOIT
	J=J+1
	X(I)=X(J)
	DY(I)=DY(J)
	YBAR(I)=YBAR(J)
	CS(I)=CS(J)
	AMS(I)=AMS(J)
	CR(I)=CR(J)
	AMR(I)=AMR(J)
130	IXY(2,I)=IXY(2,J)
	GO TO 90
140	CALL LINSMO(13,1,NPOIT,DY,DYDX)
C	SMOOTHS DY INTO DYDX
	CALL DERIV(A2,A3,DYDX,DY,13,1,NPOIT)
C	DY IS NOW SLOPE, DYDX IS DELTA-C/C
C	SETUP FOR OUTPUT
	READ(1,1000)FMSG
1000	FORMAT('TYPE OUTPUT TITLE:'A6)
	CALL OOPEN('DTA1',FMSG)
	WRITE(4,2002)NPOIT
	WRITE(1,2004)
2004	FORMAT(/'   I   X(I)  D(C)/C  C-BAR  DELTA-M   C(S)  DM/M(S)
	1   C(R)  DM/M(R)')
	DELX=(X(7)-X(2))/5.
	DO 150 I=1,NPOIT
	DY(I)=AST*DY(I)/(X(I)*DELX)
C	CORRECTION FACTOR:
	DY(I)=DY(I)/(1.-.25*DYDX(I)**2)
	SIG1=DY(I)/AMS(I)
	SIG2=DY(I)/AMR(I)
	WRITE(1,2002)I,X(I),DYDX(I),YBAR(I),DY(I),CS(I),SIG1,CR(I),SIG2
	WRITE(4,2002)I,X(I),DYDX(I),YBAR(I),DY(I),CS(I),SIG1,CR(I),SIG2
150	CONTINUE
2005	FORMAT(17X,2(F7.3,F9.0))
2002	FORMAT(I4,F7.4,F8.4,F7.3,F9.0,2(F7.3,F9.5))
	CALL OCLOSE
	AMAG=FMSG
	CALL CHAIN('DELTM5')
	END
