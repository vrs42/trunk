C	PROGRAM TO SIMULATE HI SPD EQUIL EXPTS
	COMMON X,C
	DIMENSION X(150),C(150),H(10),W(10),AM(10)
	READ(1,999)FMSG
999	FORMAT('TYPE TITLE, A6:',A6)
	READ(1,1000)RM,RB,C0,RPM
1000	FORMAT('TYPE:R(M),R(B),C(0),RPM (3F3.1,F6.0):',3F3.1,F6.0)
	READ(1,1004)VOLM
1004	FORMAT('1-VP  [F5.4]:'F5.4)
	RPM=VOLM*(.10472*RPM)**2/((8.3144E+7)*293.15)
	RBRM=RB**2-RM**2
	READ(1,1003)AMAG
1003	FORMAT('AMAG (F7.7):',F7.7)
	AMAG=.01*AMAG
	READ(1,1001)NCOMP
1001	FORMAT('# COMPONENTS (I2):',I2)
	DO 10 I=1,NCOMP
	READ(1,1002)W(I),AM(I)
1002	FORMAT('W(I),M(I) [F4.3,F6.0]:',F4.3,F6.0)
10	H(I)=RPM*AM(I)*RBRM/4.
	XIR=.0738/AMAG
	XOR=1.6738/AMAG
2014	FORMAT('XM ='F6.0/'XB ='F6.0)
	XM=(RM-5.6262)/AMAG
	XB=(RB-5.6262)/AMAG
	WRITE(1,2014)XM,XB
	DELX=10.
	NPOIT=IFIX((XB-XM)/DELX)+1
	IF(NPOIT-150)50,50,20
20	IDELX=IFIX((XB-XM)/149.+1.)
	DELX=FLOAT(IDELX)
	NPOIT=IFIX((XB-XM)/DELX)+1
50	WRITE(1,2000)DELX
2000	FORMAT('STEPSIZE =',F5.0)
	DELR=AMAG*DELX
	AST=1./RPM
	RBPRM=RB**2+RM**2
	WRITE(1,2010)FMSG
2010	FORMAT('TITLE:',2XA6)
	SEPR=280.
	WRITE(1,2011)SEPR
2011	FORMAT('SEPN:',F5.0)
	ZMAG=100.*AMAG
	WRITE(1,2012)ZMAG
2012	FORMAT('AMAG:',F9.7)
	WRITE(1,2013)AST
2013	FORMAT('RT/(1-VP)W^2 :',2XE12.5)
	DO 100 I=1,NCOMP
	W(I)=W(I)*C0*SEPR
100	WRITE(1,2002)I,W(I),AM(I),H(I)
2002	FORMAT( I3,' COMP HAS C(0) =',F9.1,'  M = ',F9.0,' AND H = ',F7.3)
	HST=4.*AST/RBRM
	LL=1
	DO 200 I=1,NPOIT
	SUMC=0.
	SUMN=0.
	SUMW=0.
	SUMZ=0.
	R=(RM+FLOAT(I-1)*DELR)**2
	Z=(2.*R-RBPRM)/RBRM
	DO 150 J=1,NCOMP
	SINHH=.5*(EXP(H(J))-EXP(-H(J)))
	DELC=W(J)*H(J)*EXP(Z*H(J))/SINHH
	SUMC=SUMC+DELC
	SUMN=SUMN+DELC/H(J)
	SUMW=SUMW+DELC*H(J)
150	SUMZ=SUMZ+DELC*H(J)**2
	AMN=HST*SUMC/SUMN
	AMW=HST*SUMW/SUMC
	AMZ=HST*SUMZ/SUMW
	X(I)=XM+DELX*FLOAT(I-1)
	C(I)=SUMC
	SUMC=SUMC/SEPR
	R=SQRT(R)
	IF(I-LL)200,160,200
160	WRITE(1,2003)I,R,SUMC,AMN,AMW,AMZ
	LL=LL+5
200	CONTINUE
2003	FORMAT(I4,F8.4,F7.3,3F9.0)
C	DELETE DATA FOR GRADIENT GT 400 FRINGE/CM
	DO 210 I=2,NPOIT
	J=I-1
	IF((C(I)-C(J))/(DELR*SEPR)-250.)210,210,220
210	CONTINUE
220	NPOIT=I
	CALL OOPEN('DTA1',FMSG)
	CM=C(1)-1.
	WRITE(4,2004)NPOIT,SEPR
2004	FORMAT(I4,F6.1)
	WRITE(4,2005)XIR,XOR
	DO 230 I=1,NPOIT
	C(I)=C(I)-CM
230	WRITE(4,2005)X(I),C(I)
2005	FORMAT(2F6.0)
	CALL OCLOSE
	END
