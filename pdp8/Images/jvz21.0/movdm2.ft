C	SPECIAL PROG TO TEST GOODNESS OF MOVING DATA
C	CALLED MOVDM2.FT; DERIVED FROM DELTM2.FT
C	NO SUBROUTINES
C	MAKE DELTA-C DATA
C	COMPATIBLE WITH LATER PROGS
C	NOTE THAT IT CAN BE CHAINED TO TRNPOS.FT
C	NOW DELTM1.FT AND CHAINED
C
	COMMON AMAG,AST,NPOIT
	COMMON X,Y,DUMMY,IXY
	DIMENSION X(150),Y(150),IXY(2,150)
	DIMENSION DUMMY(300)
	READ(1,1001)AMAG
1001	FORMAT('AMAG (F7.7):'F7.7)
	AMAG=.01*AMAG
	READ(1,1002)AST
1002	FORMAT('RT/(1-VP)W^2 (E12.5):'E12.5)
1	READ(1,1000)FMSG
1000	FORMAT('TYPE INPUT DELTA-C TITLE,A6:'A6)
	CALL IOPEN('DTA1',FMSG)
	READ(4,2000)NPOIT,SEPR
2000	FORMAT(I4,F6.1)
	YMIN=0.
	YMAX=0.
	DO 40 I=1,NPOIT
	READ(4,2001)X(I),Y(I)
2001	FORMAT(2F6.0)
	X(I)=X(I)*AMAG+5.6262
	Y(I)=(Y(I)-1.)/SEPR
	IF(Y(I)-YMIN)10,20,20
10	YMIN=Y(I)
20	IF(Y(I)-YMAX)40,40,30
30	YMAX=Y(I)
40	CONTINUE
	YMULT=500./(YMAX-YMIN)
	XMIN=X(1)
	XMAX=X(NPOIT)
	XMULT=500./(XMAX-XMIN)
	DO 50 I=1,NPOIT
	IXY(1,I)=IFIX((X(I)-XMIN)*XMULT)
50	IXY(2,I)=IFIX((Y(I)-YMIN)*YMULT)-250
C	PUT ROUTINES FOR GETTING ZERO DELTA C,SMOOTHING HERE
C	SKIP SMOOTH UNTIL LINEARIZED IN DELTM3 OR 4
	L2=IFIX(-YMIN*YMULT)-250
60	CALL DISP1(NPOIT,IXY)
	CALL DISP2(NPOIT,IXY)
	CALL DISP5(L2)
	IF(KEYBD(0))60,60,70
70	CALL CHAIN('DELTM3')
	END
