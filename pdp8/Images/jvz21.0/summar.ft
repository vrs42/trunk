	SUBROUTINE SUMMAR(NRES,IRES)
C	CALLED BY PREDIK.FT
C	MAKES SUMMARY OF FIT TO SEC STRUCT.
C
	COMMON IALF,IBET,IPT,IPAL
	DIMENSION IALF(300),IBET(300),IPT(300),IPAL(300)
	DIMENSION IRES(300),SUM(3)
	DO 500 IJK=1,5
	M=IJK-1
2001	FORMAT('START STOP <P-A> <P-B> <P-T>')
	GO TO (110,120,130,140,110)IJK
110	WRITE(1,1000)
1000	FORMAT(/'COIL')
	WRITE(1,2001)
	M=0
	INDIC=1
	GO TO 100
120	WRITE(1,1001)
1001	FORMAT(/'ALPHA')
	WRITE(1,2001)
	INDIC=6
	GO TO 100
130	WRITE(1,1002)
1002	FORMAT(/'BETA')
	WRITE(1,2001)
	INDIC=5
	GO TO 100
140	WRITE(1,1003)
1003	FORMAT(/'TURNS')
	WRITE(1,2001)
	INDIC=4
100	JSTAR=1
	JSTOP=1
5	DO 10 I=JSTAR,NRES
	IF(IPAL(I)-M)10,20,10
10	CONTINUE
	GO TO 500
20	JSTAR=I
	DO 30 I=JSTAR,NRES
	IF(IPAL(I)-M)40,30,40
30	CONTINUE
40	JSTOP=I-1
	IF(JSTOP-JSTAR+1-INDIC)80,45,45
80	DO 90 I=JSTAR,JSTOP
90	IPAL(I)=0
45	DO 50 I=1,3
50	SUM(I)=0.
	FN=0.
	DO 60 I=JSTAR,JSTOP
	FN=FN+100.
	SUM(1)=SUM(1)+FLOAT(IALF(I))
	SUM(2)=SUM(2)+FLOAT(IBET(I))
60	SUM(3)=SUM(3)+FLOAT(IPT(I))
	DO 70 K=1,3
70	SUM(K)=SUM(K)/FN
	WRITE(1,2000)JSTAR,JSTOP,(SUM(K),K=1,3)
2000	FORMAT(2I5,3F6.2)
	JSTAR=JSTOP+1
	IF(JSTOP-NRES)5,5,500
500	CONTINUE
	RETURN
	END
