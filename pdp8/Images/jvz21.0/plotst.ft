C	CALLING PROGRAM TO TEST PLOTTING ROUTINE, PLOTER.
	DIMENSION X(150),Y(150),IXY(2,150)
1	READ(1,1000)NPT
1000	FORMAT('TYPE # OF POINTS:',I4)
	READ(1,1001)N
1001	FORMAT('TYPE FUNCTION DEPENDENCE (Y=X^N),N:'I2)
	XMAX=0.
	XMIN=0.
	YMAX=0.
	YMIN=0.
	DO 20 I=1,NPT
	X(I)=I-1
	Y(I)=X(I)**N
	IF(Y(I)-YMIN)5,5,10
5	YMIN=Y(I)
10	IF(Y(I)-YMAX)20,20,15
15	YMAX=Y(I)
20	CONTINUE
	XMAX=X(NPT)
	XMIN=0.
	XMULT=500./(XMAX-XMIN)
	YMULT=500./(YMAX-YMIN)
	DO 50 I=1,NPT
	IXY(1,I)=IFIX((X(I)-XMIN)*XMULT)
50	IXY(2,I)=IFIX((Y(I)-YMIN)*YMULT)-250
	CALL PLOTER(NPT,IXY)
	GO TO 1
	END
