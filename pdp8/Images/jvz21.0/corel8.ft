	SUBROUTINE COREL8(X,Y,N,COR)
C	CORRELATE Y AND X FOR N OBSERVATIONS
C	ENTER WITH X,Y, AND N;  LEAVE WITH COR
C
	DIMENSION X(20),Y(20)
	SX=0.
	SY=0.
	SXQ=0.
	SYQ=0.
	SXY=0.
	FN=N
	DO 10 I=1,N
	SX=SX+X(I)
	SY=SY+Y(I)
	SXQ=SXQ+X(I)**2
	SYQ=SYQ+Y(I)**2
	SXY=SXY+X(I)*Y(I)
10	CONTINUE
	SXY=SXY-SX*SY/FN
	SXX=SXQ-SX**2/FN
	SYY=SYQ-SY**2/FN
	COR=SXY/SQRT(SXX*SYY)
	RETURN
	END
