/
/	FUNCTION MM(I,J)
/	RETREIVES JTH WORD FROM ARRAY MM(64,64)
/	FIELD 5 STORAGE
/
OPDEF	TADI 1400
OPDEF	DCAI 3400
	ENTRY MM
	DUMMY	\I
	DUMMY	\J
\I,	BLOCK	2
\J,	BLOCK 2
MM,	BLOCK 2
	TAD MM
	DCA MR1
	JMS MMAR
	DCA ADDR
	JMS MMAR
	CLL RTL;RTL;RTL
	TAD ADDR
	DCA ADDR
CDFL,	HLT		/CHANGE TO DF 5
	TADI ADDR	/GET ENTRY
RDFL,	NOP		/RESET DF
	RETRN MM
/
MMAR,	0
MR1,	HLT
	TADI MM#
	DCA  MR2
	INC  MM#
	TADI MM#
	DCA  TEMP
	INC  MM#
MR2,	HLT
	TADI TEMP
	JMP I MMAR
ADDR,	BLOCK 1
\MM,	BLOCK 1
/
/SUBROUTINE MMST(I,J,N)
/ STORES N AS I,JTH WORD IN ARRAY
ENTRY	MMST
	DUMMY \N
\N,	BLOCK 2
MMST,	BLOCK 2
	TAD MMST
	DCA MST1
	JMS MSTAR	/GET I
	DCA ADDR
	JMS MSTAR	/GET J
	CLL RTL;RTL;RTL
	TAD ADDR
	DCA ADDR
	JMS MSTAR	/GET N
/
CDF2,	HLT		/CHANGE TO DF 5
	DCAI ADDR
RDF2,	NOP		/RESET DF
	RETRN MMST
/
MSTAR,	0
MST1,	HLT		/FOR CDF
	TADI MMST#
	DCA  MST2
	INC MMST#
	TADI MMST#
	DCA  TEMP
	INC MMST#
MST2,	HLT
	TADI TEMP
	JMP I MSTAR
TEMP,	0
/
/ INITIALIZATION ROUTINE
	ENTRY MMI
MMI,	BLOCK 2
	TAD  (6251	/TO USE DF 5
	DCA  CDFL
	TAD  (6251
	DCA  CDF2
	6214		/READ CURRENT DF
	TAD  (6201	/TO RESTORE
	DCA  RDFL
	TAD  RDFL
	DCA  RDF2
	RETRN MMI
	END
