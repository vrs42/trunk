C PCORDD.FT  IS CHAINED FROM AND FINISHES PCOORD  PROGRAM
	COMMON FNM,NZ,NZAP,NATOM,X
	DIMENSION TITLE(10),TL(5),X(892),IYZ(2,892),NATOM(892),NZAP(140)
	NMAX=892
C
C  PATH TO WRITE OUTPUT FILE
70	CONTINUE
	CALL IOPEN('DSK',FNM)
	READ(1,1071) FNM2
1071	FORMAT('TYPE OUTPUT FILENAME, A6:',A6)
	CALL OOPEN('DSK',FNM2)
	READ(4,1004) TITLE,NA
1004	FORMAT(10A6/I6)
	I=NA-NZ+1
	WRITE(4,1004) TITLE,I
	DO 75  I=1,NA
	READ(4,1072) N,(TITLE(K),K=1,5)
1072	FORMAT(I5,5A6)
	DO 74  J=1,NZ
	IF(I-NZAP(J))74,75,74
74	CONTINUE
	WRITE(4,1072)N,(TITLE(K), K=1,5)
75	CONTINUE
	WRITE(4,1075)
1075	FORMAT(' -999')
	CALL OCLOSE
	WRITE(1,1076)
1076	FORMAT('END')
	CALL EXIT
	END
