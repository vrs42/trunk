	SUBROUTINE ACOM(NN)
	COMMON ICHAR,IERCT,KSUM,MSG
	DIMENSION MSG(40)
C  FIND LAST NON-BLANK CHARACTER PAIR
	DO 4  I=1,NN
	N=NN+1-I
	IF(MSG(N)) 3,4,3
3	IF(MSG(N)+2016) 5,4,5
4	CONTINUE
5	CONTINUE
C  SEND SLASH IDENTIFIER
	ICHAR=175
	CALL SCHAR
	DO 20  I=1,N
	ITEM=MSG(I)
S	TAD \ITEM
S	RTR;RTR;RTR
S	DCA \ICHAR
	DO 18  J=1,2
S	TAD \ICHAR
S	AND MASK
S	DCA \ICHAR
	IF(ICHAR-32) 12,13,13
12	ICHAR=ICHAR+64
13	CALL SCHAR
	ICHAR=ITEM
18	CONTINUE
20	CONTINUE
C  SEND RETURN
	ICHAR=141
	CALL SCHAR
C  WAIT FOR LINE FEED
	CALL RCHAR
S	TAD \ICHAR
S	AND (177
S	DCA \ICHAR
	IF(ICHAR-10) 27,22,27
C  WAIT FOR ANY OTHER RESPONSE FROM CDC
22	DO 24  I=1,200
	DO 23  K=1,50
23	CONTINUE
S	6401
S	JMP	\24
S	JMP	\27
24	CONTINUE
25	RETURN
27	CALL IACTV
	GO TO 25
SMASK,	77
	END
