	SUBROUTINE LINSMO(NPT,ISTART,NTIME,X,Y)
C	SMOOTH X INTO Y
C	NPT IS # POINTS,NTIME IS NPOIT-ISTART+1
	DIMENSION X(150),Y(150)
	M=(NPT-1)/2
	AM=FLOAT(M)
	G1=2.*AM+1.
	G2=(AM+1.)*(2.*AM+1.)/3.*AM
C	HERE IS TROUBLE NOTED BY ME IN CH 7 OF HILDEBRAND
	JTIME=NTIME-2*M
	JSTART=ISTART-1
	DO 100 K=1,JTIME
	JSTART=JSTART+1
	JM=JSTART+M
	JSTOP=JSTART+NPT-1
	A1=0.
	A2=0.
	T=-(AM+1.)
	DO 30 I=JSTART,JSTOP
	T=T+1.
	A1=A1+X(I)
30	A2=A2+X(I)*T
	A1=A1/G1
	A2=A2/G2
	IF(K-1)50,50,60
50	T=-(AM+1.)
	DO 55 I=JSTART,JM
	T=T+1.
55	Y(I)=A1+A2*T
60	Y(JSTART+M)=A1
	IF(K-JTIME)100,70,70
70	T=0.
	N=JSTART+M+1
	DO 75 I=N,JSTOP
	T=T+1.
75	Y(I)=A1+A2*T
100	CONTINUE
	RETURN
	END
