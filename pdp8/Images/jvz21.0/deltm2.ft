C	DELTM2.FT NEEDS NO SUBROUTINES
C	MAKE DELTA-C DATA
C	COMPATIBLE WITH LATER PROGS
C	NOTE THAT IT CAN BE CHAINED TO TRNPOS.FT
C	NOW DELTM2.FT AND CHAINED
C
	COMMON AMAG,AST,NPOIT,RIR,ROR
	COMMON X,Y
	DIMENSION X(150),Y(150),IXY(2,150)
1	READ(1,1000)FMSG
1000	FORMAT('TYPE INPUT DELTA-C TITLE,A6:'A6)
	CALL IOPEN('DTA1',FMSG)
	READ(4,2000)NPOIT,SEPR
2000	FORMAT(I4,F6.1)
	READ(4,2001)RIR,ROR
	XREF=6.5-.5*AMAG*(RIR+ROR)
	WRITE(1,1001)
	DO 2 I=1,NPOIT
	READ(4,2001)X(I),Y(I)
2001	FORMAT(2F6.0)
	X(I)=X(I)*AMAG+XREF
2	Y(I)=(Y(I)-1.)/SEPR
5	YMIN=0.
	YMAX=0.
	DO 40 I=1,NPOIT
	IF(Y(I)-YMIN)10,20,20
10	YMIN=Y(I)
20	IF(Y(I)-YMAX)40,40,30
30	YMAX=Y(I)
40	CONTINUE
	YMULT=500./(YMAX-YMIN)
	XMIN=X(1)
	XMAX=X(NPOIT)
	XMULT=500./(XMAX-XMIN)
	DO 50 I=1,NPOIT
	IXY(1,I)=IFIX((X(I)-XMIN)*XMULT)
50	IXY(2,I)=IFIX((Y(I)-YMIN)*YMULT)-250
C	PUT ROUTINES FOR GETTING ZERO DELTA C,SMOOTHING HERE
C	SKIP SMOOTH UNTIL LINEARIZED IN DELTM3 OR 4
1001	FORMAT('C TO SET Y = 0; Q TO CONT')
	L2=IFIX(-YMIN*YMULT)-250
60	M2=NALOG(1)/2
	CALL DISP1(NPOIT,IXY)
	CALL DISP2(NPOIT,IXY)
	CALL DISP5(L2)
	CALL DISP5(M2)
	L=KEYBD(0)
	IF(L-195)60,70,200
70	CZER=(250.+FLOAT(M2))/YMULT+YMIN
	DO 80 I=1,NPOIT
80	Y(I)=Y(I)-CZER
	GO TO 5
200	CALL CHAIN('DELTM3')
	END
