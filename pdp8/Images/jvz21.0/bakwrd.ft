	SUBROUTINE BAKWRD(NRES,IALF,IPAL,INDIC,IRES)
C	CALLED BY PREDIK.FT
C	GET HELIX AND BETA TERMINATION LIMITS
	DIMENSION IALF(300),IPAL(300),IRES(300)
	N=NRES-1
	I=NRES+1
	DO 600 K=1,N
	I=I-1
	IF(IALF(I))600,600,510
510	J=I-3
	IF(J-1)600,520,520
520	IF(IALF(J))530,530,600
530	ISUM=0
	IH=0
	DO 560 L=J,I
	GO TO (532,550)INDIC
532	IRE=IRES(L)/64
C	IS IT PRO?
	IF(IRE-16)540,535,540
535	IALF(L)=104
	ISUM=ISUM+45
C	IS IT ASP?
540	IF(IRE-4)550,545,550
545	IALF(L)=104
	ISUM=ISUM+6
550	IPA=IPAL(L)
	IF(IPA-110)560,560,555
555	IH=IH+IPA
560	ISUM=ISUM+IPA
	IF(ISUM-400)600,600,565
565	IF(IH-220)600,600,570
570	DO 580 L=J,I
	IF(IALF(L))575,575,580
575	IALF(L)=IPAL(L)
580	CONTINUE
600	CONTINUE
	RETURN
	END
