C	DELTAM.FT
C	PROGRAM INTERPOLATES TRANSPOSED CONCN FILES TO GET C-BAR
C	NEEDS POLATE.FT SUBROUTINE
C
	COMMON DX,DY,X1,X2,Y1,Y2,CLN1,CLN2
	DIMENSION DX(150),DY(150),X1(150),Y1(150),CLN1(150)
	DIMENSION X2(150),Y2(150),CLN2(150)
	WRITE(1,1000)
1000	FORMAT('AT ":" INPUT DELTA-C,C-1,C-2 FILES (A6)')
	READ(1,1001)FMSG
1001	FORMAT(':'A6)
	READ(1,1001)GMSG
	READ(1,1001)HMSG
	READ(1,1002)EMSG
1002	FORMAT('TYPE OUTPUT TITLE,A6:'A6)
	CALL IOPEN('DTA1',FMSG)
	READ(4,2000)NPOIT
2000	FORMAT(I4)
	DO 10 I=1,NPOIT
10	READ(4,2001)DX(I),DY(I)
2001	FORMAT(F7.4,F7.3)
	CALL IOPEN('DTA1',GMSG)
	READ(4,2000)NPT1
	DO 20 I=1,NPT1
	READ(4,2001)X1(I),Y1(I)
20	CLN1(I)=ALOG(Y1(I))
	CALL IOPEN('DTA1',HMSG)
	READ(4,2000)NPT2
	DO 30 I=1,NPT2
	READ(4,2001)X2(I),Y2(I)
30	CLN2(I)=ALOG(Y2(I))
C	FIND MINIMUM X(LAST)
	XMIN=X1(NPT1)
	IF(DX(NPOIT)-XMIN)40,40,50
40	XMIN=DX(NPOIT)
50	IF(X2(NPT2)-XMIN)60,70,70
60	XMIN=X2(NPT2)
70	DO 90 I=1,NPOIT
	IF(DX(I)-XMIN)80,80,100
80	CALL POLATE(I,X1,CLN1,VAL,NPT1)
	Y1(I)=VAL
	CALL POLATE(I,X2,CLN2,VAL,NPT2)
	Y2(I)=VAL
90	CONTINUE
100	NPOIT=I-1
	CALL OOPEN('DTA1',EMSG)
	WRITE(4,2000)NPOIT
	DO 110 I=1,NPOIT
	X1(I)=(Y1(I)+Y2(I))*.5
	R2=.5*DX(I)**2
	DCONC=DY(I)/X1(I)
	WRITE(4,2002)DX(I),DY(I),X1(I)
2002	FORMAT(F7.4,2F7.3)
110	WRITE(1,2010)I,DX(I),DY(I),X1(I),R2,DCONC
2010	FORMAT(I4,F7.4,2F8.3,2F8.4)
	CALL OCLOSE
	CALL EXIT
	END
