	SUBROUTINE FORWRD(NRES,IALF,IPAL,INDIC,IRES)
C	CALLED BY PREDIK.FT
C	GET HELIX AND BETA TERMINATION LIMITS
	DIMENSION IALF(300),IPAL(300),IRES(300)
	N=NRES-3
	DO 490 I=1,N
	IF(IALF(I))490,490,410
410	J=I+3
430	ISUM=0
	IH=0
	DO 450 L=I,J
	GO TO (432,532)INDIC
432	NN=IRES(L)/64
C	IS IT ARG?
	IF(NN-18)437,433,437
433	IALF(L)=104
	ISUM=ISUM+25
	GO TO 437
532	NN=IRES(L)/64
C	IS IT TRP?
	IF(NN-23)437,537,437
537	IALF(L)=69
	ISUM=ISUM-50
437	IPA=IPAL(L)
	IF(IPA-112)450,440,440
440	IH=IH+IPA
450	ISUM=ISUM+IPA
	IF(ISUM-400)490,490,460
460	IF(IH-240)490,490,470
470	DO 485 L=I,J
	IF(IALF(L))480,480,485
480	IALF(L)=IPAL(L)
485	CONTINUE
490	CONTINUE
C	NOW DELETE C-TERMINAL PRO
	DO 600 I=1,N
	J=I+3
	IF(IALF(I))600,600,610
610	NN=IRES(J)/64
	IF(NN-16)600,620,600
C	DELETE STRUCTURE UNTIL 0 IS HIT
620	DO 630 L=J,NRES
	IF(IALF(L))600,600,630
630	IALF(L)=0
600	CONTINUE
	RETURN
	END
