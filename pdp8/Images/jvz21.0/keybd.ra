/  FUNCTION KEYBD(0)
/
/  M=KEYBD(0) SETS M EQUAL TO ANY CHARACTER RECEIVED FROM
/  THE KEYBOARD.  THE CHARACTER IS SEVEN BITS WITH LEFT ZEROS.
/  IF NO KEY HAS BEEN STRUCK, SETS M=0.  THIS ROUTINE DOES
/  NOT WAIT ON THE KEYBOARD.
/  THE TTY INTERRUPT IS TURNED OFF WHEN KEYBD IS CALLED, 
/  AND IS REENABLED AFTER ANY CHARACTER IS RECEIVED.
/  THE TTY INTERRUPT CAN ALSO BE ENABLED BY CALLING
/  SUBROUTINE TTYION:
/
/	CALL TTYION
/
/  IT IS ESSENTIAL TO HAVE THE TTY INTERRUPT ON TO DO 
/  ANY ORDINARY TELETYPE I/O, OTHERWISE THE PROGRAM HANGS.
/
	SECT8	KEYBRD
	EXTERN	#EXIT
#XR,	ORG	.+2
	TEXT	+KEYBD +
#RET,	SETX	#XR
	SETB	#BASE
	JA	.+3
#BASE,	ORG	.+6
N,	ORG	.+3
	ORG	#BASE+30
	FNOP
	JA	#RET
#RTN,	XTA	0
#GOBAK,	0;0
	BASE	#BASE
#F3,	F	3.
/
	ENTRY KEYBD
KEYBD,	STARTD
	0210
	FSTA	#GOBAK,0
	0200
	SETX	#XR
	SETB	#BASE
	LDX	0,1
	FSTA	#BASE
	STARTF
	TRAP4	KEYB2
	XTA	0
	FSUB	#F3	/^C CHECK
	JNE	#RTN
	JSR	#EXIT
/
	ENTRY TTYION
TTYION,	STARTD
	0210
	FSTA	#GOBAK,0
	0200
	SETX	#XR
	SETB	#BASE
	LDX	0,1
	FSTA	#BASE
	STARTF
	TRAP4	TTION
	JA	#GOBAK
/
KEYB2,	0
	IOF
	CLA CLL
	6141
	 024		/GET SPECIAL FUNCTIONS
	1620		/TTY INTERRUPT OFF
	  40
	 004		/ESF
	 002
	CLA CLL
	KSF
	JMP	KEYB3
	KRB		/GET CHARACTER
	AND	M177	/7 BITS
	DCA	#XR
	6141
	 024		/GET SPECIAL FUNCTIONS
	1560
	  40		/TTY INTERRUPT ON AGAIN
	 004		/ESF
	 002
	CLA CLL
	CDF CIF 0
	ION
	JMP%	KEYB2
KEYB3,	DCA	#XR
	JMP	.-4
M177,	177
/
TTION,	0		/TO REENABLE TTY INTERRUPT
	IOF
	6141
	 024
	1560		/KEEP SPECIAL FUNCTIONS
	  40
	 004
	 002
	CLA CLL
	CDF CIF 0
	ION
	JMP%	TTION
	END
