C  COM2.FT
C  PDP-12 TO CDC GENERAL ALPHANUMERIC COMMUNICATIONS PROGRAM
C  REQUIRES IACTF.SB
C
C  ERIC SWANSON
C  LAST REVISION MARCH 17, 1977
C  TESTED AND APPROVED FOR 1200 BAUD TRANSMISSION.
C
	COMMON ICHAR,IERCT
	DIMENSION LINE(40)
	WRITE(1,1001)
1001	FORMAT('PDP-12 TO CDC COMMUNICATIONS.')
	READ(1,1004)FNAME
1004	FORMAT('TYPE INPUT TITLE:',A6)
	CALL IOPEN('DSK',FNAME)
	READ(1,1005)NLINE
1005	FORMAT('TYPE NUMBER OF LINES:',I5)
	WRITE(1,1007)
1007	FORMAT('CALL CDC, ETC.')
	CALL IACTV
C
	DO 50  L=1,NLINE
	READ(4,1010)LINE
1010	FORMAT(40A2)
C  FIND LAST NON-BLANK CHARACTER PAIR
	DO 10  I=1,39
	NC=41-I
	IF(LINE(NC))8,10,8
8	IF(LINE(NC)+2016)12,10,12
10	CONTINUE
12	CONTINUE
C
C  FIRST CHAR SENT IS /, THEN TEXT CHARS, THEN CHECKSUM CHAR, THEN CR.
	ICHAR=175
	CALL SCHAR
C
	KSUM=0
	DO 20  I=1,NC
	ITEM=LINE(I)
S	TAD  \ITEM
S	TAD  \KSUM
S	DCA  \KSUM
S	TAD  \ITEM
S	RTR;RTR;RTR
S	TAD  \KSUM
S	DCA  \KSUM
20	CONTINUE
C
	DO 39  I=1,NC
	ITEM=LINE(I)
S	TAD  \ITEM
S	RTR;RTR;RTR
S	DCA  \ICHAR
	DO 37  J=1,2
S	TAD  \ICHAR
S	AND  (77
S	DCA  \ICHAR
	IF(ICHAR-32)32,33,33
32	ICHAR=ICHAR+64
33	CALL SCHAR
	ICHAR=ITEM
37	CONTINUE
C
C  CHECK IF CHARACTER RECEIVED (ERROR)
	KK=0
S	6401
S	INC  \KK
	IF(KK)39,70,39
39	CONTINUE
C
C  SEND CHECKSUM CHARACTER
S	TAD  \KSUM
S	AND  (17
S	TAD  (100
S	DCA  \ICHAR
	CALL SCHAR
C  SEND CR, WAIT FOR LF
	ICHAR=141
	CALL SCHAR
	CALL RCHAR
S	TAD  \ICHAR
S	AND  (177
S	DCA  \ICHAR
	IF(ICHAR-10)70,41,70
C WAIT FOR MESSAGE FROM CDC
41	K=(L/25)*25-L
	N=50
	IF(K)43,42,43
42	N=1000
43	CONTINUE
	DO 45  I=1,N
	DO 44  K=1,50
44	CONTINUE
S	6401
S	JMP  \45
S	JMP  \70
45	CONTINUE
50	CONTINUE
C
C  SEND END SIGNAL:  *E
	ICHAR=170
	CALL SCHAR
	ICHAR=69
	CALL SCHAR
	ICHAR=141
	CALL SCHAR
C  EXIT TO IACTV
70	CALL IACTV
	STOP
	END
