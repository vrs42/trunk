	SUBROUTINE AXIS(YMAX,YMIN,XMAX,NHL,VL)
	DIMENSION IDIS(2,1)
C
C	PLOT AXES
C	THIS VERSION CALLED FROM PLOTSM
C	SET UP PLOTTER
	WRITE(1,2000)
2000	FORMAT('SET UP PLOTTER, PEN DOWN, PRESS CONT')
	IDIS(1,1)=0
	IDIS(2,1)=-250
	CALL DISP1(1,IDIS)
S	HLT
	Z=XMAX/VL
15	ICOUNT=500./Z+.5
	JCOUNT=ICOUNT
	DO 50 J=1,501
	K=J-1
	IDIS(1,1)=K
	IDIS(2,1)=-250
	IF(K-JCOUNT)40,20,40
20	JCOUNT=JCOUNT+ICOUNT
	M=-250
	DO 30 L=1,10
	M=M+1
	DO 30 LL=1,10
	IDIS(1,1)=K
	IDIS(2,1)=M
30	CALL DISP1(1,IDIS)
C	MOVE BACK
	DO 35 L=1,10
	M=M-1
	DO 35 LL=1,10
	IDIS(1,1)=K
	IDIS(2,1)=M
35	CALL DISP1(1,IDIS)
40	DO 50 L=1,100
50	CALL DISP1(1,IDIS)
C	ABOVE MAY BE TOO FAST
	WRITE(1,2001)
2001	FORMAT('RAISE PEN, PRESS CONT')
S	HLT
	IDIS(1,1)=0
	IDIS(2,1)=-250
	CALL DISP1(1,IDIS)
C	NOW DO ORDINATE
C	GET STEPS BETWEEN HL
	ICOUNT=500./FLOAT(NHL)
	JCOUNT=ICOUNT
	WRITE(1,2002)
2002	FORMAT('PEN DOWN, PRESS CONT')
S	HLT
	DO 100 J=1,501
	K=J-1
	IDIS(1,1)=0
	IDIS(2,1)=K-250
	IF(K-JCOUNT)90,70,90
70	JCOUNT=JCOUNT+ICOUNT
	M=0
	DO 80 L=1,10
	M=M+1
	DO 80 LL=1,10
	IDIS(1,1)=M
	IDIS(2,1)=K-250
80	CALL DISP1(1,IDIS)
C	MOVE BACK
	DO 85 L=1,10
	M=M-1
	DO 85 LL=1,10
	IDIS(1,1)=M
	IDIS(2,1)=K-250
85	CALL DISP1(1,IDIS)
90	DO 100 L=1,100
100	CALL DISP1(1,IDIS)
	WRITE(1,2001)
S	HLT
	RETURN
	END
