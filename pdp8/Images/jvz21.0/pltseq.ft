C	PLTSEQ.FT TO PLOT PROBABILITIES OF
C	SEC STRUCTURE USING TABLES MADE
C	BY CHOU AND FASMAN
C	BIOCHEMISTRY 13,222(1974)
C	AND C.CLOTHIA NATURE 1975 FOR BURIED RESIDUES
C
C	PRESENTLY RESTRICTED TO 100 RESIDUES
C	IF MORE, A RECYCLING MUST BE WRITTEN
	COMMON X,Y
	COMMON IPT,IPAL,IPBET,FRES
	COMMON LRES,MRES,NRES,MPAL,NPBET,IPTRN,ITEMP
	DIMENSION IPBET(100),IPT(100),IPAL(100)
	DIMENSION LRES(20),MRES(20),KRES(20),MPAL(20),NPBET(20),IPTRN(20)
	DIMENSION X(100),Y(100),IY(100)
	DIMENSION IRES(100),FRES(20,4)
C
C	READ SEQUENCE
	READ(1,1000)FMSG
1000	FORMAT('TYPE SEQUENCE TITLE:'A6)
	WRITE(1,2000)
2000	FORMAT('"DELTA X" S.B. LARGE ENUF S.T. THERE ARE L.T. 40 PIPS')
2001	FORMAT(/'ALFA')
2002	FORMAT(/'BETA')
2003	FORMAT(/'FREQ.TURNS')
2004	FORMAT(/'TURNS')
2005	FORMAT(/'BURIED')
	CALL IOPEN('DTA1',FMSG)
	READ(4,1005)NRES
1005	FORMAT(I3)
C	BELOW MUST BE REWRITTEN FOR G.T. 100 RES
	IF(NRES-100)7,7,5
5	NRES=100
7	READ(4,1006)(IRES(I),I=1,NRES)
1006	FORMAT(30A1)
C	READ P-ALFA VALUES
	CALL IOPEN('DTA1','PALFA')
	READ(4,1007)(MRES(I),MPAL(I),I=1,20)
1007	FORMAT(A1,I4)
	DO 20 I=1,NRES
	DO 10 J=1,20
	IF(IRES(I)-MRES(J))10,20,10
10	CONTINUE
20	IPAL(I)=MPAL(J)
C	LIMIT CALLS AXIS AND PLOTER SUBROUTINES
	WRITE(1,2001)
	CALL LIMIT(NRES,IPAL,0)
C	READ BETA
	CALL IOPEN('DTA1','PBETA')
	READ(4,1007)(MRES(I),NPBET(I),I=1,20)
	DO 220 I=1,NRES
	DO 210 J=1,20
	IF(IRES(I)-MRES(J))210,220,210
210	CONTINUE
220	IPBET(I)=NPBET(J)
	WRITE(1,2002)
	CALL LIMIT(NRES,IPBET,0)
C	NOW GET TURNS
	N=NRES-3
	CALL IOPEN('DTA1','FTURNS')
	READ(4,1008)(LRES(I),(FRES(I,J),J=1,4),IPTRN(I),I=1,20)
1008	FORMAT(A1,4F6.3,I4)
	DO 590 I=1,NRES
590	IPT(I)=0
	DO 640 I=1,N
	M=0
	J=I+3
	PROD=1.
	DO 620 L=I,J
	M=M+1
	DO 610 K=1,20
	IF(IRES(L)-LRES(K))610,615,610
610	CONTINUE
615	IPT(L)=IPTRN(K)
620	PROD=PROD*FRES(K,M)
	PROD=100.*PROD/(.07**4)
	X(I)=FLOAT(I)+1.5
	Y(I)=PROD
640	IY(I)=PROD+.5
	WRITE(1,2003)
	CALL LIMIT(N,IY,1)
	WRITE(1,2004)
	CALL LIMIT(NRES,IPT,0)
C	NOW GET BURIED RES
	CALL IOPEN('DTA1','PBURED')
	READ(4,1007)(MRES(I),MPAL(I),I=1,20)
	DO 120 I=1,NRES
	DO 110 J=1,20
	IF(IRES(I)-MRES(J))110,120,110
110	CONTINUE
120	IY(I)=MPAL(J)
	WRITE(1,2005)
	CALL LIMIT(NRES,IY,0)
C	NOW WRITE OUT ALL DATA
	NTIME=NRES/15+1
	K=-14
	DO 900 I=1,NTIME
	K=K+15
	N=K+14
	IF(N-NRES)920,920,910
910	N=NRES
920	WRITE(1,1015)
	WRITE(1,1014)(L,L=K,N)
	WRITE(1,1013)(IRES(L),L=K,N)
1013	FORMAT(15(3XA1))
	WRITE(1,1014)(IPAL(L),L=K,N)
1014	FORMAT(15I4)
	WRITE(1,1014)(IPBET(L),L=K,N)
	WRITE(1,1014)(IPT(L),L=K,N)
	WRITE(1,1014)(IY(L),L=K,N)
	WRITE(1,1015)
1015	FORMAT(//)
900	CONTINUE
	END
