	DIMENSION ITAB(27,27),IS1(10,63),IS2(10,63)
	DIMENSION TITLE(6),ISEQ(500)
C
	CALL MMI
	WRITE(1,1000)
1000	FORMAT(' SEQUENCE COMPARISON PROGRAM')
	READ(1,1001)TTAB
1001	FORMAT('TYPE SCORING TABLE TITLE (A6): ',A6)
	CALL IOPEN('DSK',TTAB)
	READ(4,1004)TITLE
1004	FORMAT(6A6)
	WRITE(1,1004)TITLE
	DO 5  J=1,27
5	READ(4,1005)(ITAB(I,J), I=1,27)
1005	FORMAT(27I2)
C
	READ(1,1020)FN1
1020	FORMAT('TYPE FIRST  SEQUENCE FAMILY FILENAME: ',A6)
	CALL IOPEN('DSK',FN1)
	READ(4,1022)NS1
1022	FORMAT(I5)
	IF(NS1-10)21,21,190
21	READ(1,1023) NST1,NSTP
1023	FORMAT('START, STOP POSITIONS (2I3): ',2I3)
	L1=NSTP-NST1+1
	IF(L1)21,21,22
22	IF(L1-63)23,23,21
23	DO 26  J=1,NS1
	READ(4,1022)LS1
	READ(4,1024)(ISEQ(K), K=1,LS1)
1024	FORMAT(30A1)
	K=0
	DO 24  I=NST1,NSTP
	ITMP=ISEQ(I)
S	TAD	\ITMP
S	CLL RTR;RTR;RTR
S	AND	(77
S	TAD	(-33
S	SMA SZA
S	CLA
S	TAD	(33
S	DCA	\ITMP
	K=K+1
24	IS1(J,K)=ITMP
26	CONTINUE
C
	READ(1,1030)FN2
1030	FORMAT('TYPE SECOND SEQUENCE FAMILY FILENAME: ',A6)
	CALL IOPEN('DSK',FN2)
	READ(4,1022)NS2
	IF(NS2-10)31,31,190
31	READ(1,1023) NST2,NSTP
	L2=NSTP-NST2+1
	IF(L2)31,31,32
32	IF(L2-63)33,33,31
33	DO 36  J=1,NS2
	READ(4,1022)LS2
	READ(4,1024)(ISEQ(K), K=1,LS2)
	K=0
	DO 34  I=NST2,NSTP
	ITMP=ISEQ(I)
S	TAD	\ITMP
S	CLL RTR;RTR;RTR
S	AND	(77
S	TAD	(-33
S	SMA SZA
S	CLA
S	TAD	(33
S	DCA	\ITMP
	K=K+1
34	IS2(J,K)=ITMP
36	CONTINUE
C
C
	DO 59  II=1,L1
	DO 57  JJ=1,L2
S	TAD	\II
S	CLL RTL;RTL;RTL
S	TAD	\JJ
S	7421
	M=0
	NC=0
	DO 52  I=1,NS1
	IS=IS1(I,II)
	IF(IS-27)40,52,40
40	DO 50  J=1,NS2
	JS=IS2(J,JJ)
	IF(JS-27)44,50,44
44	M=M+ITAB(IS,JS)
	NC=NC+1
50	CONTINUE
	IF(M)51,51,52
51	M=-1
	GO TO 56
52	CONTINUE
	IF(M)54,54,55
54	M=-1
	GO TO 56
55	M=(M+NC/2)/NC
56	CALL MMST(II,JJ,M)
57	CONTINUE
59	CONTINUE
C
	CALL OOPEN('DSK','SCOMMM')
	WRITE(4,1060)NS1,NS2,NST1,L1,NST2,L2,FN1,FN2
1060	FORMAT(6I5,2(1X,A6))
	DO 66  J=1,L2
	DO 64  I=1,L1
64	ISEQ(I)=MM(I,J)
66	WRITE(4,1064)(ISEQ(I), I=1,L1)
1064	FORMAT(20I3)
	CALL OCLOSE
C
190	STOP
	END
