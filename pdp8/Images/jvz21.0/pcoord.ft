C  PCOORD.FT
C  PROGRAM TO DISPLAY 3-D COORDINATES BY SLICES
C  X AXIS MUST BE ORDERED, Y AND Z AXES ARE DISPLAYED
C  KNOB 4 CONTROLS SCON THROUGH X-AXIS
C  KNOBS 3 AND 7 CONTROL CURSORS, WHICH ARE SWITHED BY SENSE SW 0.
C  TELETYPE COMMANDS:
C    E-WRITE OUTPUT FILE
C    T-SPECIFY NEW THICKNESS
C    X-TYPE X AXIS RANGE
C    Z-ZAP ATOM AT CURSOR POSITION
C    ?-IDENTIFY ATOM AT CURSOR POSITION
C
	COMMON FNM,NZ,NZAP,NATOM,X
	DIMENSION TITLE(10),TL(5),X(892),IYZ(2,892),NATOM(892),NZAP(140)
	NMAX=892
C
	YOFF=256.
	ZOFF=-256.
	EXPF=1.0
C
	READ(1,1002) FNM
1002	FORMAT('TYPE COORD FILENAME (A6):',A6)
	CALL IOPEN('DSK',FNM)
	READ(4,1004) TITLE
1004	FORMAT(10A6)
	READ(4,1006) NA,(TL(I),I=1,5)
1006	FORMAT(I6,5A6)
	WRITE(1,1007) TITLE,NA
1007	FORMAT(10A6/'NATOM=',I5)
	IF(NA-NMAX)7,7,91
C
7	NZ=1
	DO 10  I=1,NA
S	TAD  \I
S	7421
	READ(4,1010) NATOM(I),X(I),Y,Z
1010	FORMAT(I5,3F8.2)
	IYZ(1,I)=(Y*5.+YOFF)*EXPF
10	IYZ(2,I)=(Z*5.+ZOFF)*EXPF
C
16	READ(1,1016) TH
1016	FORMAT('SLICE THICKNESS, ANG:',F6.0)
	IF(TH-99.)17,17,16
17	NOLD=-1
C
C  KNOB 4 CONTROLS BEGINNING OF SLICE (MIN X VALUE)
21	KDS=1
22	N=KNOB(4)+513
	IF(IABS(N-NOLD)-1)30,30,23
23	DO 231  I=1,50
231	Y=5.*5.
	N=KNOB(4)+513
	NOLD=N
	IF(N-NA)25,25,24
24	N=NA
25	I1=N
	DO 26  I=I1,NA
	IF(X(N)-X(I)-TH)26,26,27
26	CONTINUE
27	I2=I-1
C  I2 POINTS TO LAST COORD IN SLICE
C
C  CHECK TTY KEYBOARD
C  SIGNALS:  E-WRITE OUTPUT FILE; T-SPECIFY NEW THICKNESS;
C  X-TYPE X-AXIS RANGE;  Z-ZAP ATOM AT POSITION MARKED BY CURSORS
C  ?-IDENTIFY ATOM AT CURSORS POSITION
C
30	M=KEYBD(0)
	IF(M)31,40,31
31	IF(M-212)32,16,32
32	IF(M-218)33,50,33
33	IF(M-197)34,70,34
34	IF(M-191)35,60,35
35	IF(M-216)36,66,36
36	CONTINUE
C
40	N=I2-I1+1
	CALL DISP1(N,IYZ(1,I1))
	IY=KNOB(3)/2+256
	IZ=KNOB(7)/2
	IF(KDS)21,21,41
41	IF(IY)22,22,42
42	IF(IZ+256)22,22,43
43	CALL DISP5(IZ)
	CALL DISP6(IY)
	KDS=0
	GO TO 22
C
C  PATH TO ZAP ATOM
50	CONTINUE
	N=0
	DO 55  I=I1,I2
	K=IABS(IYZ(1,I)-IY)-1
	IF(K)52,52,55
52	K=IABS(IYZ(2,I)-IZ)-1
	IF(K)53,53,55
53	NZAP(NZ)=I
	NZ=NZ+1
	IF(NZ-141)54,92,92
54	IYZ(1,I)=0
	IYZ(2,I)=0
	N=1
55	CONTINUE
	IF(N)22,56,22
56	DO 57  I=1,500
57	CALL DISP9(-240,0,'NO')
	WRITE(1,1056)
1056	FORMAT('NO')
	GO TO 22
C
C  PATH TO IDENTIFY ATOM AT MARKED POSITION
60	DO 65  I=I1,I2
	K=IABS(IYZ(1,I)-IY)-1
	IF(K)62,62,65
62	K=IABS(IYZ(2,I)-IZ)-1
	IF(K)63,63,65
63	Y=((FLOAT(IYZ(1,I))/EXPF)-YOFF)/5.
	Z=((FLOAT(IYZ(2,I))/EXPF)-ZOFF)/5.
	WRITE(1,1064)NATOM(I),X(I),Y,Z
1064	FORMAT(I5,3F8.2)
65	CONTINUE
	GO TO 22
C
66	XX=XN-TH
	WRITE(1,1066)XX,XN
1066	FORMAT(' X AXIS:',F7.2,' TO',F7.2)
	GO TO 22
C
C  CHAIN TO PCORDD TO WRITE OUTPUT FILE.
70	CALL CHAIN('PCORDD')
C
91	WRITE(1,1091)NMAX
1091	FORMAT('ARRAY SPACE INSUFFICIENT',I6,' MAX')
	STOP
92	NMAX=140
	WRITE(1,1091) NMAX
	WRITE(1,1092)
1092	FORMAT('RERUN PROGRAM ON OUTPUT FILE TO DO MORE EDITING.'/
	1'TYPE E NOW.')
	GO TO 22
	END
