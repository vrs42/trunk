M2,	7776
M3,	7775
M6,	7772
M40,	7740
M190,	7502
M215,	7563
M260,	7520
MONEV,	7464
MASK,	0077
K1,	0001
K3,	0003
K212,	0212
K215,	0215
K240,	0240
K340,	0340
N,	0000
T,	0000
M,	0000
K,	0000
L,	0000
P,	0000
NN,	0000
LL,	0000
QCOUNT,	0000
