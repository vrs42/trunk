	DCA TT		/TEMP STORE
	TAD TT
	AND [40		/FOR TYPE
	SNA CLA		/SKIP IF 200 CODE
	TAD [100	/IS 300 CODE
	TAD [200	/PARITY IN
	TAD TT		/RESTORE CHAR
