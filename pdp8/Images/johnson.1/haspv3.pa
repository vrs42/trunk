	AND [20		/MASK /H BIT
	SZA CLA
	JMP I [SLASHH	/SETUP FOR HASP
	TAD I [MPARAM+1	/NOW FOR /N
	CDF 0
	AND [2000	/MASK /N
	SZA CLA
	JMP I [SLASHN
SWMONC,	CDF 10
	TAD I [7620	/GET FILE START
	CDF 0
	SNA
	JMP I [7605	/FILES DONT START AT ZERO
	DCA I [FBLOK
	CDF 10
	TAD I [7617
	DCA TMP1	/STASH FOR LATER
	TAD TMP1
	CDF 0
	AND [17
	SNA
