/"$" FOUND = END LINE LIKE ALTMODE

CDDOLR,	JMS I GCRET	/IGNORE REST OF LINE
	CLA STL RAR	/SET ALTMODE BIT
	CDF 10		/IN CD PARAM AREA
	DCA I PARMM1	/LIKE OLD XGLINE DOES
	CDF 0		/BACK TO THIS FIELD
	JMP CDEOLN	/AND END THE LINE


M107,	-107
M215,	-215
CRMDOL,	215-"$
