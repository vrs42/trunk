	ISZ NXTP2	/ON READ NEW BLOCK.
	ISZ NXTCNT	/SKIP WHEN DONE
	JMP .-5		/KEEP MOVING
	JMS I SYSH	/AND READ COMMON BACK DOWN
	 100		/ONLY ONE PAGE
	 1400
	 RESEXP+1	/BACK IN
	HLT		/HLT ON ERRORS
