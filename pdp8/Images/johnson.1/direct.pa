PNBLK,	0
	TAD OPT1	/B
	RTL
	SNL CLA
	JMP SKPBLK
	JMS CONVTP
	TAD BLOCK
	JMS OPRNT
SKPBLK,	TAD OPT1	/F
	AND G100
	SNA CLA
	ISZ PNBLK
