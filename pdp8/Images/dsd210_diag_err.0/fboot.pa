/ MINIMAL BOOTSTRAP FOR DSD-210 FLOPPY DRIVE 0.
/ FBOOT.PA

LCDR=6751
XDR=6752
STRF=6753
SDNF=6755

	*31	/ START HERE ONLY WHEN CALLING IN

	START,	HLT	/ USED FOR CALLING IN ONLY.
		JMP	33


/ AFTER LOADING < 33-35 > <45-60> HIT CLEAR AND
/ START AT 33.

STARTBOOT,

CKDN,	SDNF
	JMP	XFSUB+1
	JMP	UNLOAD-1

*45
	CLA STL RTL	/ SET AC = 2
UNLOAD,	LCDR
DATLP,	JMS	XFSUB
	DCA	2
	ISZ	.-1
	JMP	DATLP

XFSUB,	STRF	/ CAN BE ANYTHING!!!
	STRF
	JMP	CKDN
	XDR
	JMP I XFSUB

SELCT,	7004 / FOR DRIVE 0.
/	7024   FOR DRIVE 1.
$	$	$	$

