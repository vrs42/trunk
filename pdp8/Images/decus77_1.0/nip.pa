START,	IFNDEF SKIMP < 	JMS I (RESET >
	JMS I (GETLINE	/GET INPUT FROM OPERATOR
	JMS I (ASSIG	/ASSIGN LOG DEVICE
	JMS I (SET	/GET READY TO ACCESS 'NETTAB'
	NETTAB
	CDF NSPFLD
	10		/***
	JMS I (GET	/GET NSP VERSION #
	0
	DCA NSPV
