	>
	JMS I (ERRINF	/YES
	IFDEF LPT <
	IFZERO LOG-LPT <
	TAD (14		/FORMFEED
	JMS I (PRINT
	JMS I (OUT
	>
	>
	JMS I (DASSIG	/NO
	CAL
	SUSPND+FREE
	JMP START

NSPV,	0		/NSP VERSION #
NSPPAT,	0		/NSP PATCH LEVEL
DDCV,	0		/DDCMP VERSION #
DDCPAT,	0		/DDCMP PATCH LEVEL

OURNOD,	0		/OUR NODE NUMBER
OURNAM,	ZBLOCK 3;4000	/OUR NODE NAME
	IFNDEF SKIMP <
