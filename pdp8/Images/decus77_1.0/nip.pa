	TAD ("]
	JMS I (PRINT
	JMP I NSPVM
	>
PCSTAT,	0		/PRINT CHANNEL STATE
	JMS I (SPACE
	2
	DCA USEFLG
	JMS I (GET
	CCBSTA		/GET STATE WORD FROM CCB
	SNA
	JMP G4		/NOT IN USE
	RAL
	SPA
	JMP G5		/IN USE
	RTR
	RTR
	SNL CLA
	JMP G6		/STARTING UP
	JMS I (LIST	/BOOT MODE
	BOTMOD		/PRINT MESSAGE
/	ISZ USEFLG	/*** CHECK WITH JIM
	JMP I PCSTAT
G4,	JMS I (LIST	/NOT IN USE MESSAGE
	NOTMOD
	JMP I PCSTAT
G5,	CLA
	JMS I (LIST	/PRINT IN-USE MESSAGE
	USEMOD
	ISZ USEFLG	/NOTE FACT THAT CCB IS IN USE
	JMP I PCSTAT
G6,	JMS I (LIST
	STRMOD		/PRINT "STARTING"
	JMP I PCSTAT

USEFLG,	0		/1 IF CHANNEL IS IN USE
	PAGE
$
