	TAD ("]
	JMS I (PRINT
	>
TC,	JMS I (OUT
	JMS I (CRLF	/SKIP A LINE
	TAD (-MAXLIN
	DCA COUNT	/MAXLIN LINES
	DCA LINENO	/START AT LINE 0
	JMS I (LIST	/PRINT PART 1 OF HEADING
	PHYHED
