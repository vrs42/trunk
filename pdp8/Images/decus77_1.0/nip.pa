	LSTATE
	AND	(3	/JR MASK ONLY PROTOCOL STATE BITS
	DCA LINST
	TAD LINENO
	JMS I (PRINT2	/PRINT LINE NUMBER
	JMS I (PRNDNM	/PRINT NODE NAME ON OTHER SIDE OF THIS LINE
