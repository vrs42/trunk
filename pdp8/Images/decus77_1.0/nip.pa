	JMS I (GET
	7
	JMS I (FIXNUL
	DCA OURNAM+2
	IFNDEF SKIMP <
	CDF 0
	TAD I (DATE	/GET TODAY'S DATE
	DCA TODAY
	TAD I (TODL	/AND TIME
	DCA TIMEL
	TAD I (TODH
	DCA TIMEH
	CDF CUR
	JMS I (SKIPE
	JMP TA
	JMS I (LIST
	TTLMSG		/PRINT TITLE
	JMP TB
	>
TA,	JMS I (LIST	/PRINT BRIEF TITLE
	TTLMSF
TB,	JMS I (LIST	/PRINT NIP VERSION #
	VERMSG
/*** PRINT OUR NODE NAME AND NUMBER
	JMS I (OUT
	JMS I (CRLF	/PRINT BLANK LINE
	IFNDEF SKIMP <
	TAD I (PFLAG
	SZA CLA		/DO WE WANT PHYSICAL INFORMATION?
	>
	JMS I (PHYINF	/YES
