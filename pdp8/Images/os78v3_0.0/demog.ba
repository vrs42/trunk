10 REM BAR GRAPH DEMO
20 REM 8-JUN-77 DS
29 DIM A(12)
30 PRINT PNT(27);"H";PNT(27);"J";	\ REM ERASE SCREEN
40 PRINT \ PRINT
60 PRINT ,,"N E T   P R O F I T"
70 PRINT \ PRINT
80 PRINT "THOUSANDS"
81 PRINT PNT(27);"F";			\ REM ENTER GRAPHICS MODE
82 FOR K=1 TO 12
83 READ A(K)
84 NEXT K
86  GOSUB 1000				\ REM HORIZONTAL LINE
100 FOR X=550 TO 0 STEP -50
110 PRINT X,
120 FOR K=1 TO 12
130 IF A(K)<X THEN 170			\ REM DISPLAY THIS BAR?
140 REM DISPLAY THE BAR
150 PRINT PNT(97);PNT(97);PNT(97);" ";	\ REM 97 IS RECTANGLE
160 GOTO 190
170 REM DISPLAY NO BAR
180 PRINT "    ";
190 NEXT K
200 PRINT				\ REM END OF LINE
210 NEXT X
220  GOSUB 1000				\ REM HORIZONTAL LINE
230 PRINT ,"JUL AUG SEP OCT NOV DEC ";
231 PRINT "JAN FEB MAR APR MAY JUN"
250 PRINT,, "FISCAL YEAR 1977"
252 PRINT
255 PRINT PNT(27);"G";			\ REM EXIT GRAPHICS MODE
260 STOP
999 REM
1000 REM HORIZONTAL LINE
1010 FOR K=1 TO 62
1020 PRINT "-";
1025 NEXT K
1030 PRINT
1040 RETURN
2000 REM
2001 DATA 200,150,250,300,300,350,400,500,550,500,400,350
3000 END
