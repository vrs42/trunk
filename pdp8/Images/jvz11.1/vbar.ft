C	VBAR.FT TO CALC V-BAR FROM A.A.COMPOSITION
C	ALSO COMPUTES 0' IN 6 M GHCL
C	ALSO GETS PACKING VOLUME IN A^3
C
C
	DIMENSION AA(20),VB(20),AM(20),VM(20),VP(20),H(20),AN(20)
C
	WRITE(1,998)
998	FORMAT(' THIS VERSION USES INPUT FILE')
	CALL IOPEN('DSK','VBARDA')
	READ(4,1000)(AA(I),VB(I),AM(I),VM(I),VP(I),H(I),I=1,20)
1000	FORMAT(5XA1,3F10.4,F6.1,F4.1)
	SNM=0.
	SNH=0.
	SNMV=0.
	SN=0.
	SVP=0.
	READ(1,1302)FMSG
1302	FORMAT(' INPUT FILE TITLE:',A6)
	WRITE(1,2000)
2000	FORMAT('INPUT MOLES AA F5.0')
	CALL IOPEN('DSK',FMSG)
	DO 10 I=1,20
	WRITE(1,1001)AA(I)
1001	FORMAT(1XA1':')
	READ(4,1002)AN(I)
	WRITE(1,1002)AN(I)
1002	FORMAT(2X,F5.0)
C1002	FORMAT(F5.0)
	SN=SN+AN(I)
	SNM=SNM+AN(I)*AM(I)
	SNMV=SNMV+AN(I)*VM(I)
	SNH=SNH+AN(I)*H(I)
10	SVP=SVP+AN(I)*VP(I)
	VBAR=SNMV/SNM
	SNM=SNM+18.016
	WRITE(1,2001)VBAR,SNM
2001	FORMAT(//'V-BAR ='F7.4/'M ='F11.1)
C	NOW GET GHCL PHI'
	SAROM=AN(9)+AN(14)+AN(18)+AN(19)
	A3=95.54*(.5*(SN-1.)+SAROM)/SNM
	A1=SNH*18.016/SNM
	G3=1.007
	RHO=1.1418
	V3=.763
	T2=(1./RHO-V3)*(A3-G3*A1)
	PHI=VBAR-T2
	TERM=1.-PHI*RHO
	WRITE(1,2002)PHI,TERM
2002	FORMAT('PHI" ='F7.4/'1-V*RHO ='F7.4)
	WRITE(1,2003)RHO
2003	FORMAT('RHO USED WAS:'F8.4)
	VPAK=SVP/SNM
	WRITE(1,2004)SVP,VPAK
2004	FORMAT('V(PACK) ='F10.0' A^3/MOLE'/'V ='F9.4' A^3/GM')
	END
