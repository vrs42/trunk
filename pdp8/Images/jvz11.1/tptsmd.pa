	/TESTS MAJOR INFORMATION FLOW
	/THROUGH THE USE OF THE MAINTENANCE INST
	/REGISTERS TESTED IN ORDER ARE:
	/TAC
	/TB
	/RWB
	/TBN
	/TMA
	/TMA SETUP
	/ALSO ADDITION OD TB+TAC TO TAC
	/ALSO SHIFT OF RWB
	/SENSE SWITCHES 0-2 CONTROL THE MODE OF OPERATION DESIRED
	/SNS 0-2 = 0 LOOP ENTIRE PROGRAM
	/SNS 0   = 1 LOOP REGISTER TRANSFER TESTS
	/SNS 1   = 1 LOOP ADDITION TEST (TBTAC)
	/SNS 2   = 1 LOOP SHIFT RWB TEST (SHRWB)
/26
	LMODE
	*20
	HLT
/TTAC TEST - TRANSFER CONTENTS OF THE
/PROCESSOR AC TO THE TAPE ACCUMULATOR
/READ IT BACK AND TEST FOR DISCREPENCY
/THE BIT PATTERN IS DETERMINED BY THE 
/LEFT SWITCHES
/PROCEED TO NEXT TEST IF NO ERROR
TTAC,	CLR		/CLEAR THE AC
	LDA I		/LOAD THE AC
	1000		/BIT 2 SET
	IOB		/EXECUTE IN 8 MODE
	6151		/TRANSFER OF AC TO TAPE MAINTENENCE REGISTER
	LSW		/SELECT BIT PATTERN DESIRED WITH THE LEFT SWITCHES
	STA		/STORE A COPY OF THE BIT PATTERN
	10		/IN REGISTER 10
	IOB		/EXECUTE IN 8 MODE
	5154		/TRANSFER OF AC TO TAC
	CLR		/CLEAR THE AC
	TAC		/TRANSFER THE TAC TO THE AC
	SAE		/COMPARE THE BIT PATTERN IN THE AC
	10		/WITH THE COPY IN IR 10
	HLT		/ERROR-THE CONTENTS OF THE AC NOT EQUAL TO IR 10
	NOP		/CAN INSERT JMP COMMAND TO LOOP TEST
/63
/TB - TRANSFER THE CONTENTS OF THE
/PROCESSOR AC TO THE TAPE BUFFER
/READ IT BACK AND TEST FOR DISCREPENCY
/THE BIT PATTERN IS DETERMINED BY THE 
/LEFT SWITCHES
/PROCEED TO NEXT TEST IF NO ERRORS
TB,	CLR		/CLEAR THE AC
	IOB		/EXECUTE IN 8 MODE
	6151		/TRANSFER OF CLEARED AC TO MAINTENANCE REGISTER
	LSW		/SELECT BIT PATTERN DESIRED WITH THE LEFT SWITCHES
	STA		/STORE A COPY OF THE BIT PATTERN
	10		/IN IR 10
	IOB		/EXECUTE IN 8 MODE
	6154		/TRANSFER OF AC TO TB
	LDA I		/LOAD THE AC
	3000		/BITS 1 AND 2 SET
	IOB		/EXECUTE IN 8 MODE
	6151		/TRANSFER OF AC TO MAINTENANCE REGISTER
	CLR		/CLEAR THE AC
	IOB		/EXECUTE IN 8 MODE
	6154		/TRANSFER OF TB TO AC
	SAE		/COMPARE THE BIT PATTERN IN THE AC
	10		/WITH THE ORIGINAL BIT PATTERN IN IR 10
	HLT		/ERROR - CONTENTS OF AC NOT EQUAL TO IR 10
	NOP		/CAN INSERT JMP COMMAND TO LOOP TEST
/120
/RWB - TRANSFER OF CONTENTS OF PROCESSOR
/AC TO TAPE BUFFER
/TRANSFER TAPE BUFFER TO
/TAPE READ WRITE BUFFER
/TRANSFER TAPE READ WRITE BUFFER TO
/PROCESSOR AC
/TEST BIT PATTERN RECEIVED FOR DISCREPENCY
/THE BIT PATTERN IS DETERMINED BY THE
/LEFT SWITCHES
/IF NO ERRORS CONTINUE TO NEXT TEST
RWB,	CLR		 /CLEAR THE AC
	IOB		 /EXECUTE IN 8 MODE
	6151		 /TRANSFER OF CLEARED AC TO MAINTENANCE REGISTER
	LSW		 /SELECT BIT PATTERN DESIRED WITH LEFT SWITCHES
	STA		 /STORE A COPY OF BIT PATTERN
	10		 /IN IR 10
	IOB		 /EXECUTE IN 8 MODE
	6154		 /TRANSFER OF AC TO TAPE BUFFER
	LDA I		 /LOAD THE AC
	1000		 /BIT 2 SET
	IOB		 /EXECUTE IN 8 MODE
	6152		 /TRANSFER OF TB TO RWB
	LDA I		 /LOAD THE AC
	3400		 /BITS 1, 2, AND 3 SET
	IOB		 /EXECUTE IN 8 MODE
	6151		 /TRANSFER OF AC TO TAPE MAINTAINENCE REGISTER
	CLR		 /CLEAR THE AC
	IOB		 /TRANSFER IN 8 MODE
	6154		 /TRANSFER OF RWB TO AC
	SAE		 /COMPARE THE BIT PATTERN IN THE AC
	10		 /WITH THE ORIGINAL BIT PATTERN IN IR 10
	HLT		 /ERROR - CONTENTS OF AC NOT EQUAL TO IR 10
	NOP		 /CAN INSERT JMP COMMAND TO LOOP TEST
/165
/TBN - TRANSFER CONTENTS OF PROCESSOR
/AC TO TAPE BLOCK NUMBER REGISTER (TBN)
/READ IT BACK AND TEST FOR DISCREPENCY
/THE BIT PATTERN IS DETERMINED BY THE
/LEFT SWITCHES
/PROCEED TO NEXT TEST IF NO ERROR
TBN,	CLR		 /CLEAR AC
	LDA I		 /LOAD THE AC
	400		 /BIT 3 SET
	IOB		 /EXECUTE MAINTENANCE INSTRUCTION IN 8 MODE
	6151		 /TRANSFER OF AC TO TAPE MAINTENANCE REGISTER
	LSW		 /SELECT BIT PATTERN DESIRED WITH THE LEFT SWITCHES
	STA		 /STORE A COPY OF BIT PETTERN
	10		 /SELECTED IN IR 10
	IOB		 /8 MODE EXECUTE
	6154		 /TRANSFER OF AC TO TBN
	LDA I		 /LOAD THE AC
	2400		 /BITS 1 AND 3 SET
	IOB		 /EXECUTE IN 8 MODE
	6151		 /TRANSFER OF AC TO TAPE MAINTENANCE REGISTER
	CLR		 /CLEAR THE AC
	IOB		 /EXECUTE IN 8 MODE
	6154		 /TRANSFER OF TBN TO AC
	SAE		 /COMPARE THE BIT PATTERN IN THE AC
	10		 /WITH THE ORIGINAL BIT PATTERN IN IR 10
	HLT		 /ERROR - AC NOT EQUAL TO IR 10
	NOP		 /CAN INSERT JMP COMMAND TO LOOP TEST
/224
/TTMA - TRANSFER CONTENTS OF PROCESSOR
/AC TO TAPE MEMORY ADDRESS REGISTER (TMA)
/READ IT BACK AND TEST FOR DISCREPENCY
/THE BIT PATTERN IS DETERMINED BY THE
/LEFT SWITCHES
/PROCEED TO NEXT TEST IF NO ERRORS
TTMA,	CLR		 /CLEAR THE AC
	LDA I		 /LOAD THE AC
	1400		 /BITS 1 AND 3 SET
	IOB		 /EXECUTE IN 8 MODE
	6151		 /TRANSFER OF AC TO TAPE MAINTENANCE REGISTER
	LSW		 /SELECT BIT PATTERN DESIRED WITH LEFT SWITCHES
	STA		 /STORE A COPY OF THE BIT PATTERN
	10		 /SELECTED IN IR 10
	IOB		 /EXECUTE IN 8 MODE
	6154		 /TRANSFER TMA TO AC
	LDA I		 /LOAD THE AC
	7000		 /BITS 0, 1, AND 2 SET
	IOB		 /EXECUTE IN 8 MODE
	6151		 /TRANSFER OF AC TO TAPE MAINTENANCE REGISTER
	CLR		 /CLEAR THE AC
	IOB		 /EXECUTE IN 8 MODE
	6154		 /TRANSFER OF TMA TO AC
	SAE		 /COMPARE THE BIT PATTERN IN THE AC
	10		 /WITH THE ORIGINAL BIT PATTERN IN IR 10
	HLT		 /ERROR - AC NOT EQUAL TO IR 10
	NOP		 /CAN INSERT JMP COMMAND TO LOOP TEST
/263
/TMAS - TRANSFER CONTENTS OF PROCESSOR
/AC TO TMA SETUP REGISTER (TMAS)
/READ IT BACK AND TEST FOR DISCREPENCY
/THE BIT PATTERN IS DETERMINED BY THE
/LEFT SWITCHES
/PROCEED TO NEXT TEST IF NO ERRORS
TMAS,	CLR		 /CLEAR THE AC
	LSW		 /SELECT BIT PATTERN DESIRED WITH THE LEFT SWITCHES
	STA		 /STORE A COPY OF THE BIT PATTERN
	10		 /SELECTED IN INDEX REGISTER 10
	TMA		 /TRANSFER AC TO TMA SETUP REGISTER
	LDA I		 /LOAD THE AC
	2000		 /BIT 1 SET
	IOB		 /EXECUTE IN 8 MODE
	6151		 /TRANSFER OF AC TO TAPE MAINTENANCE REGISTER
	CLR		 /CLEAR THE AC
	IOB		 /EXECUTE IN 8 MODE
	6154		 /TRANSFER OF TMA SETUP REGISTER TO AC
	SAE		 /COMPARE THE BIT PATTERN IN THE AC
	10		 /WITH THE COPY IN INDEX REGISTER 10
	HLT		 /ERROR - THE CONTENTS OF THE AC NOT EQUAL TO IR 10
	SNS I 0		 /IS SENSE SWITCH 0 SET
	JMP TTAC	 /YES, LOOP THROUGH ALL PREVIOUS TESTS AGAIN
/316
/TBTAC - ENTER TEST IF SSW 0 
/NOT DEPRESSED
/TRANSFER CONTENTS OF PROCESSOR AC
/AS DETERMINED BY THE LEFT SWITCHES
/TO THE TAPE BUFFER (TB)
/THEN TRANSFER CONTENTS OF PROCESSOR AC
/AS DETERMINED BY THE RIGHT SWITCHES 
/TO THE TAPE ACCUMULATOR (TAC)
/NOW ADDITION OF TB TO TAC IS DONE
/THE SUM IS READ BACK AND TESTED FOR
/DISCREPENCY AGAINST A COMPUTED SUM
/STORED IN INDEX REGISTER 12
/IF THERE ARE ANY ERRORS THE PROGRAM
/WILL HALT
/IF SENSE SWITCH 1 IS DEPRESSED
/THE PROGRAM WILL LOOP ON THIS TEST
/OTHERWISE IT WILL CONTINUE WITH THE
/NEXT TEST
TBTAC,	CLR		/CLEAR AC
	IOB		/EXECUTE IN 8 MODE
	6151		/TRANSFER OF AC TO TAPE MAINTENANCE REGISTER
	LSW		/SELECT TB BIT PATTERN WITH LEFT SWITCHES
	STA		/STORE COPY OF TB BIT PATTERN SELECTED
	10		/IN REGISTER 10
	IOB		/EXEC 8 MODE
	6154		/TRANSFER OF AC TO TB
	LDA I		/LOAD THE AC
	1000		/BIT 2 SET
	IOB		/EXEC 8 MODE
	6151		/TRANSFER OF AC TO TAPE MAINTENANCE REGISTER
	RSW		/SELECT TAC BIT PATTERN DESIRED WITH RIGHT SWITCHES
	STA		/STORE A COPY OF TAC BIT PATTERN
	11		/IN INDEX REGISTER 11
	IOB		/EXEC 8 MODE
	6154		/TRANSFER OF AC TO TAC
	LAM		/ADD CONTENTS OF INDEX REGISTER 10
	10		/TO THE AC (2S COMPLEMENT ADDITION)
	STA		/STORE THE COMPUTED SUM OF TB ADDED TO TAC
	12		/IN INDEX REGISTER 12
	LDA I		/LOAD THE AC
	400		/BIT 3 SET
	IOB		/EXEC 8 MODE
	6152		/THE TB IS ADDED TO THE TAC AND THE SUM IS IN THE TAC
	CLR		/CLEAR THE AC
	TAC		/TRANSFER THE TAC TO THE AC
	SAE		/COMPARE THE BIT PATTERN IN THE AC
	12		/WITH THE COMPUTED SUM IN INDEX REGISTER 12
	HLT		/ERROR - THE CONTENTS OF AC NOT EQUAL TO IR 12
	SNS I 1		/IS SENSE SWITCH 1 DEPRESSED
	JMP TBTAC	/YES,LOOP TBTAC TEST AGAIN
/404
/SHRWB - ENTER TEST IS SENSE SWITCH 1 IS NOT DEPRESSED
/TRANSFER CONTENTS OF PROCESSOR AC TO TAPE BUFFER (TB)
/THEN TAPE BUFFER IS TRANSFERRED TO READ WRITE BUFFER (RWB)
/THE RWB IS NOW SHIFTED
/ONE BIT POSITION AND ITS CONTENTS READ
/BACK TO THE AC AND COMPARED WITH A
/SIMULATED SHIFT IN THE PROCESSOR
/IF AN ERROR OCCURS THE PROGRAM WILL HALT
/THE THREE BITS SHIFTED OUT FROM UNDER
/THE READ WRITE HEAD ARE MASKED OUT AS
/THEY COULD BE EITHER SET OR RESET
/IF SENSE SWITCH 2 IS DEPRESSED YOU WILL
/LOOP THIS TEST.  OTHERWISE YOU WILL GO
/BACK TO THE BEGINNING OF THE PROGRAM
/AND START THRU AGAIN
SHRWB,	CLR		/CLEAR AC
	IOB		/EXEC 8 MODE
	6151		/AC - MAIN REG
	LSW		/SELECT BIT PATTERN DESIRED FROM THE LEFT SWITCHES
	IOB		/EXEC IN 8 MODE
	6154		/TRANSFER OF AC TO TB
	ROL I 1		/ROTATE RIGHT 1 PLACE MSB LOST
	BCL I		/CLEAR BITS THAT WILL BE SHIFTED IN FROM TAPE READ HEAD
	0421		/BITS 3,7, AND 11
	STA		/STORE A COPY OF THE BIT PATTERN
	10		/IN IR 10
	LDA I		/LOAD THE AC
	1000		/BIT 2 SET
	IOB		/EXEC 8 MODE
	6152		/TRANSFER OF TB TO RWB
	LDA I		/LOAD AC
	2000		/BIT 1 SET
	IOB		/EXEC 8 MODE
	6152		/SHIFT RWB
	LDA I		/LOAD THE AC
	3400		/BITS 1,2,AND 3 SET
	IOB		/EXEC 8 MODE
	6151		/TRANSFER AC TO TAPE MAINTENANCE REGISTER
	CLR		/CLEAR AC
	IOB		/EXEC 8 MODE
	6154		/TRANSFER OF RWB TO AC
	BCL I		/CLEAR OUT BITS THAT WERE UNDER R-W HEAD
	0421		/BITS 3,7, AND 11
	SAE		/COMPARE BIT PATTERN IN THE AC
	10		/WITH THE ORIGINAL IN IR 10
	HLT		/ERROR - CONTENTS OF AC NOT EQUAL TO INDEX REGISTER 10
	SNS I 2		/IS SENSE SWITCH 2 DEPRESSED
	JMP SHRWB	/YES, LOOP THIS TEST
	JMP TTAC	/NO, LOOP TO BGIN PROGRAM AGAIN
/471	JMP TTAC IS END
