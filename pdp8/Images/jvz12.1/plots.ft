	SUBROUTINE PLOTER(N,IXY)
C  NEEDS: PENUP,PENDN,MOVE
	COMMON REAL1,REAL2,REAL3
	COMMON IDIS
	DIMENSION IXY(2,500),IDIS(2,2)
C  MOVE TO FIRST POINT
	CALL PENUP(10)
	IDIS(1,2)=IXY(1,1)
	IDIS(2,2)=IXY(2,1)
	CALL MOVE
	CALL PENDN(100)
C  CHECK VALUES:
	DO 240 I=1,N
	IF(IXY(2,I)-250)220,220,210
210	IXY(2,I)=250
220	IF(IXY(2,I)+250)230,240,240
230	IXY(2,I)=-250
240	CONTINUE
C	PUT 1 ST POINT INTO IDIS
	IDIS(1,1)=IXY(1,1)
	IDIS(2,1)=IXY(2,1)
	CALL DISP1(1,IDIS)
	IX=IDIS(1,1)
	IY=IDIS(2,1)
C	PRESUMABLY PEN IS NOW DOWN AND PLOTTER SET UP
290	DO 100 I=2,N
	K=I-1
	DX=IXY(1,I)-IXY(1,K)
	DY=IXY(2,I)-IXY(2,K)
	DIST=SQRT(DX*DX+DY*DY)
	NSTEP=DIST+.5
	DO 50 J=1,NSTEP
	FX=FLOAT(J)/FLOAT(NSTEP)
	JX=FX*DX
	IDIS(1,1)=IXY(1,K)+JX
	JY=FX*DY
	IDIS(2,1)=IXY(2,K)+JY
	IBUFY=IDIS(2,1)
	DO 50 L=1,25
50	CALL DISP1(1,IDIS)
	IF(IABS(IBUFY)-250)55,100,100
55	IX=IDIS(1,1)
	IY=IDIS(2,1)
100	CONTINUE
	CALL PENUP(2000)
	RETURN
	END
