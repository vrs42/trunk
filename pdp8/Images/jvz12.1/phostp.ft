C  PHOSTP.FT
C  WRITE OUTPUT FILE TEMPXX.DA
C	GELSCN.FT TO SCAN GELS AND OTHER THINGS
C	NEEDS TRHS, STAGE SUBROUTINES
C  D.C.T.2-27-79
C  D.C.T. 4-OCT-88
C
	COMMON BR,DX,DY,IDIS
	COMMON IXY,IYY
	DIMENSION IDIS(2,2),IZ(10)
	DIMENSION IXY(2,500),IYY(500)
1	READ(1,1000)INCY
1000	FORMAT(' STEP INCREMENT ALONG Y:'I4)
	READ(1,1001)TITLE
1001	FORMAT(' FILE TITLE:',A6)
C  OPEN FILE:
	CALL OOPEN('DSK',TITLE)
	WRITE(1,2002)
2002	FORMAT(/' POSITION PLATE:' ,/,'  1) AT START OF SCAN' )
	CALL RHS
	XSUM=0.
	YSUM=0.
	WRITE(1,2003)
2003	FORMAT('  2) AT END OF SCAN' )
	CALL RHS
	XSUM=DX
	YSUM=DY
	XF=DX
	CALL STEP(XSUM,0)
	CALL STEP(YSUM,2)
	IF(YSUM)5,10,5
5	WRITE(1,2001)
2001	FORMAT(' CAUTION! SCANS ALONG X ONLY' )
C	NOW GET NO. TIMES TO CALL STAGE
10	X=0.
	MAG3=3*INCY
	MAG2=2*INCY
11	DO 30 I=1,10
	IF(I-1)12,12,15
12	X1=X
15	X=X+1.
C  MOVE STAGE -3*INCY:
	CALL STAGE(MAG3,4)
C  READ LOOP:
	SUM=0.
	DO 20 J=1,5
	CALL STAGE(INCY,3)
S	6141
S	0114
S	0002
S	DCA \K
20	SUM=SUM-FLOAT(K)
	SUM=SUM/5.
	IZ(I)=SUM
C  MOVE STAGE TO Y=0:
	CALL STAGE(MAG2,4)
C  INCREMENT X OF STAGE:
	CALL STAGE(1,1)
C  CHECK END:
	IF(X-XSUM)30,30,40
30	CONTINUE
	N=10
	GO TO 45
40	N=I
45	WRITE(4,1045)X1,(IZ(I),I=1,N)
1045	FORMAT(F10.0,10I6)
	IF(X-XSUM)11,11,50
50	CALL OCLOSE
C  RETURN STAGE TO ORIGIN:
	CALL STEP(X,0)
	STOP
	END
