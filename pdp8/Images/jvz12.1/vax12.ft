C  VAX TO PDP-12 COMMUNICATIONS
C  TRANSMIT FILE FROM VAX TO PDP-12
C  NEEDS IACTV.SB MODIFIED FOR CTRL S AND CTRL Q (VACTV.SB)
C  NEEDS EXTENDED MEMORY ROUTINE MEMR.SB
C  VAX SENDS CTRL Z AT END OF FILE
C  D.C.T. 19-NOV-81
C
	COMMON ICHAR,IERCT,NCHAR,INDIC,NBUF
	DIMENSION NBUF(384),L(100),IDATA(80)
C  READ OUTPUT FILE NAME:
C  INITIALIZE M730:
S	6402
	ICR=13
	LF=10
	IQ=17
	IS=19
C  DELAY FOR 364 LOOP
	IDLA=25
1	READ(1,1000)FNAME
1000	FORMAT(' FILE NAME ON PDP-12:'A6)
	CALL OOPEN('DSK',FNAME)
C
C  INITIALIZE MEMORY
C	CALL MEMI
C
C  CALL VAX
C  USE IACTV TO SET UP ON VAX
C  USE CTRL G TO START
C
	WRITE(1,1001)
1001	FORMAT(' CALL VAX,LOGIN,START WITH CTRL G')
	CALL IACTV
C  COMES BACK FROM IACTV AFTER ^G
C  IN VAX, CHECK THAT LINES ARE LT 2047
C  NOW SEND "GO" TO VAX
	NBUF(1)='GO'
	ICNT=1
C  SEND MESSAGE TO VAX:
	DO 100 J=1,ICNT
C  FIRST CHAR
	ICHAR=NBUF(J)
S	CLL CLA
S	TAD \ICHAR
S	AND (7700
S	RTR;RTR;RTR
S	DCA \ICHAR
	IF(ICHAR-32)60,70,70
60	ICHAR=ICHAR+64
70	CALL SCHAR
C  SECOND CHARACTER
	ICHAR=NBUF(J)
S	CLL CLA
S	TAD \ICHAR
S	AND (77
S	DCA \ICHAR
	IF(ICHAR-32)80,90,90
80	ICHAR=ICHAR+64
90	CALL SCHAR
100	CONTINUE
C  SEND LF THEN CR
	ICHAR=10
	CALL SCHAR
	ICHAR=13
	CALL SCHAR
C  NOW READY TO HANDLE CHARACTERS
C
C  VAX SENDS @,@,LF,CR,LF,CR AS INITIALIZATION
	ICNT=6
110	CALL RCHAR
	ICNT=ICNT-1
	IF(ICNT)200,200,110
C  START POINT:
C  MAKE IEND=26 AT ^Z OR $
C  TCNT COUNTS TOTAL CHAR WRITTEN
	TCNT=0.
200	NCHAR=0
C  INDIC IS A HANDLER INDICATOR USED BY GCHAR. EVERY TIME I DISPOSE OF
C  ICHAR, RESET INDIC TO 0
	INDIC=0
	LINE=0
C  START LINE
210	IEND=0
	J=0
	ITMP=0
C  GET CHAR 1:
	IF(NCHAR)219,220,221
219	NCHAR=0
220	CALL GCHAR
	IF(NCHAR)700,220,221
C  SELF JMP IF NO CHARS; HANDLE IF THERE ARE:
221	NCHAR=NCHAR-1
	INDIC=0
S	TAD \ICHAR
S	AND (377	/8-BIT MASK
S	DCA \ICHAR
C  TEST LETTERS, DUMP @
	IF(ICHAR-64)230,220,260
C  TEST $
230	IF(ICHAR-36)231,250,231
C  CHAR NUMERIC, SYMBOL,CR,LF,CTRL Z, ETC:
231	IF(ICHAR-26)240,250,260
C  CR,LF, NON-DEFINED CTRL:
C  VAX SENDS CR AT END OF LINE, THEN (AFTER PDPCOM DELAY),LF
240	IF(ICHAR-ICR)242,241,242
241	IEND=2
	GO TO 350
242	IF(ICHAR-LF)260,243,260
243	IEND=1
C  DMP CR,LF,TEST IEND:
	IF(IEND-1)220,220,350
C  CTRL Z OR $:
250	IEND=26
	GO TO 358
260	J=J+1
C  STRIP TO 6 BITS:
S	CLA CLL
S	TAD \ICHAR
S	AND (77
S	RTL;RTL;RTL
S	TAD (40		/ADD SPACE
S	DCA \ITMP
350	IF(J)210,210,355
355	IDATA(J)=ITMP
	IF(J-80)358,360,360
358	IF(IEND-1)220,220,360
C  END OF LINE, WRITE BUFFER(IDATA)
C  CALL SCHAR WITH CTRL S THEN GCHAR UNTIL NCHAR STOPS CHANGING FOR 100
C  CALLS  THEN WRITE LINE:
360	ICHAR=IS
	CALL SCHAR
C///////////////
C	ANOTHER WAY?
	DO 364 I=1,IDLA
	CALL GCHAR
364	CONTINUE
C///////////////
365	WRITE(4,1360)(IDATA(I),I=1,J)
	LINE=LINE+1
	FJ=J
	TCNT=TCNT+FJ
1360	FORMAT(80A1)
C	WRITE(1,1361)LINE
C1361	FORMAT(' LINE:'I6)
C	WRITE(1,1360)(IDATA(I),I=1,J)
	ICHAR=IQ
	CALL SCHAR
	IF(IEND-26)210,370,210
370	CALL OCLOSE
	LINE=LINE-1
	WRITE(1,1370)LINE
1370	FORMAT(I6,'LINES RECEIVED')
	FJ=LINE
	TCNT=TCNT+FJ
	WRITE(1,1371)TCNT
1371	FORMAT(F9.0' CHARACTERS RECEIVED')
C  SEND CTRL Q:
C	ICHAR=IQ
C	CALL SCHAR
	CALL IACTV
	CALL EXIT
700	WRITE(1,1700)NCHAR
1700	FORMAT(' NCHAR NEGATIVE:'I5)
	END
