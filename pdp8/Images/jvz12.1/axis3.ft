	SUBROUTINE AXIS(ZMIN,ZMAX,NHL)
C SPECIAL PURPOSE AXIS PLOTTING SUBROUTINE
C  CALLED BY GELSCN.FT
C	NHL IS NUMBER OF PIPS
C	ZMAX AND ZMIN ARE FOUND BY MAINLINE; CAN BE ANY VALUES
C	IDIR IS DIRECTION:
C	IDIR	LINE	ORIGIN	PIP DIR.
C	1	HORIZ.	0,-250	 +VE Y
C  SEE AXIS.FT FOR OTHER VALUES, SCRUBBED FROM THIS PROG
C
C  COME IN WITH IDIS(1,1),IDIS(2,1) OF PREVIOUS
C	VALUES
C  INITIAL CALL TO "MOVE" GOES TO ORIGIN OF THIS CALL
C
C  D.C.T.1/7/78
C
	COMMON REAL1,REAL2,REAL3
	COMMON IDIS
	DIMENSION IDIS(2,2)
C
C** SETUP
	IDIR=1
	CALL PENUP(2000)
10	ISIN=1
C  USE ORIGIN AS 0 RF FOR GELSCN:
C  YANK IDIS(1,1) AND IDIS(2,1) FROM COMMON FOR ORIGIN
	M0=IDIS(2,1)
	ITOT=IDIS(1,1)
	IT=1
	IM=2
C** MOVE TO ORIGIN:
100	IDIS(IT,2)=ITOT
	IDIS(IM,2)=M0
	CALL MOVE
	CALL PENDN(2000)
C** CALCULATE:
	ZMULT=1.
	ZINC=(ZMAX-ZMIN)/FLOAT(NHL)
	ZOLD=ZMIN
	DO 250 JHL=1,NHL
	ZNEW=ZOLD+ZINC
	ICOUNT=ZMULT*(ZNEW-ZOLD)+.5
	ZOLD=ZNEW
C  MOVE PEN ICONT TIMES:
	DO 230 J=1,ICOUNT
	ITOT=ITOT+1
	IDIS(IT,1)=ITOT
	IDIS(IM,1)=M0
	DO 230 L=1,50
230	CALL DISP1(1,IDIS)
C  MAKE PIP
	M=M0
	DO 240 L=1,10
	M=M+ISIN
	DO 240 LL=1,10
	IDIS(IT,1)=ITOT
	IDIS(IM,1)=M
240	CALL DISP1(1,IDIS)
C  MOVE BACK
	DO 245 L=1,10
	M=M-ISIN
	DO 245 LL=1,10
	IDIS(IT,1)=ITOT
	IDIS(IM,1)=M
245	CALL DISP1(1,IDIS)
C PAUSE:
	DO 250 L=1,100
250	CALL DISP1(1,IDIS)
C  MOVE BACK TO ORIGIN:
	CALL PENUP(2000)
	IDIS(IT,2)=0
	IDIS(IM,2)=-250
	CALL MOVE
	RETURN
	END
