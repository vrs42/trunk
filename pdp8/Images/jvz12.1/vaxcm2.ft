C  VAXCM2.FT - TRANSMIT FILE FROM PDP-12 TO VAX
C    CALLS IACTV.SB
C    READS INPUT FILE ON UNIT 4
C
	COMMON ICHAR,IERCT
	DIMENSION NBUF(40)
C
	READ(1,2000)FNAME
	CALL IOPEN('DSK',FNAME)
	READ(1,2010)NLINE
2000	FORMAT(' ENTER FILE NAME ',A6)
2010	FORMAT(' ENTER NUMBER OF LINES ',I6)
C
	WRITE(1,1000)
1000	FORMAT(' CALL VAX, ETC.'/)
	CALL IACTV
C
	DO 500 I=1,NLINES
C
C  INIT. BUFFER
	DO 10 J=1,40
10	NBUF(J)=-2016
C
	READ(4,2020)NBUF
C
C  FIND FIRST NON-BLANK CHARS.
	ICNT=41
30	ICNT=ICNT-1
	IF(ICNT)500,500,40
40	IF(NBUF(ICNT)+2016)50,30,50
C
50	DO 200 J=1,ICNT
C  FIRST CHAR.
	ICHAR=NBUF(J)
S	CLL CLA
S	TAD \ICHAR
S	AND (7700
S	RTR;RTR;RTR
S	DCA \ICHAR
	IF(ICHAR-32)110,120,120
110	ICHAR=ICHAR+64
120	CALL SCHAR
C  SECOND CHAR.
	ICHAR=NBUF(J)
S	CLL CLA
S	TAD \ICHAR
S	AND (77
S	DCA \ICHAR
	IF(ICHAR-32)130,140,140
130	ICHAR=ICHAR+64
140	CALL SCHAR
200	CONTINUE
C
C  END OF LINE - SEND 'LF','CR'
C	ICHAR=10
C	CALL SCHAR
	ICHAR=13
	CALL SCHAR
500	CONTINUE
C
C  END OF FILE - SEND ^Z
	ICHAR=154
	CALL SCHAR
	CALL IACTV
2020	FORMAT(40A2)
	STOP
	END
