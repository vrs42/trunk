	SUBROUTINE MOVE
C  MOVE THE PEN FROM IXY(OLD) TO IXY(NEW)
C  DOES NOT CHANGE STATE OF PEN (UP OR DOWN)
C
C	COMMON REAL1,REAL2,REAL3
	COMMON IXY
C  COMMON OF REAL VAR IS FOR GELSCN.FT
	DIMENSION IXY(2,2),IDIS(2,1)
C
C  COMPUTE DISTANCE:
	I=2
	K=1
	DX=IXY(1,I)-IXY(1,K)
	DY=IXY(2,I)-IXY(2,K)
	IDIS(1,1)=IXY(1,1)
	IDIS(2,1)=IXY(2,1)
	DIST=SQRT(DX*DX+DY*DY)
	NSTEP=DIST+.5
	STEP=NSTEP
	IX=IXY(1,K)
	IY=IXY(2,K)
	IF(NSTEP-3)100,100,30
30	DO 70 J=1,NSTEP,3
	FX=FLOAT(J)/STEP
	JX=FX*DX
	IDIS(1,1)=IX+JX
	JY=FX*DY
	IDIS(2,1)=IY+JY
70	CALL DISP1(1,IDIS)
100	IXY(1,1)=IDIS(1,1)
	IXY(2,1)=IDIS(2,1)
	CALL DISP1(1,IXY)
	RETURN
	END
