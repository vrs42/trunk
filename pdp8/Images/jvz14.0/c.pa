TITLE	AS	135		ROOM FOR THE TITLE LINE
INMSG	DC	'T,'A,'B,'L,'E,' ,'O,'F,' ,'C,'O,'N,'T,'E,'N,'T,'S,0
HPOINTS	QUT	%*,*		HYPHENATION POINT HALF-WORD TABLE
	ORG	*+128		ALLOCATE ROOM FOR TABLE
/
/	HERE FOR THE COMMAND TABLE
/
/	FIRST WORD CONTAINS ASCII CHARACTER OF COMMAND
/	SECOND WORD CONTAINS THE DISPATCH ADDRESS FOR THE COMMAND
/
COMTAB	DC	'C,CCOM		CENTRED LINE
	DC	'D,DCOM		GENERATE TEXT SPRING WITH TODAY'S DATE
	DC	'F,FCOM		PAGE FORMAT COMMAND
	DC	'H,PGHEAD	SETUP PAGE HEADING (TITLE LINE)
	DC	'J,JCOM		RESUME JUSTIFICATION
	DC	'L,LCOM		SET THE LINE FEED SIZE
	DC	'M,MCOM		SET RIGHT-HAND MARGIN
	DC	'N,NCOM	␀␀␀␀␀␀␀	NO JUSTIFICATION
	DC	'O,OCOM		OUTPUT DURING PASS ZERO COMMAND
	DC	'P,PAGEJ	GENERATE PAGE EJECT
	DC	'R,RCOM		LINE AT RIGHT MARGIN
	DC	'V,VCOM		DO VERTICAL TAB
	DC	'W,WCOM		SPACE OUT LINE TO FULL WIDTH
	DC	' ,FSPACE	FIXED SPACE
	DC	'[,SPECIAL	GENERATE ]
	DC	'[,SPECIAL	GENERATE ]
	DC	'/,SPECIAL	GENERATE /
	DC	'@,SPECIAL	GENERATE @
	DC	'-,SPECIAL	GENERATE - (NOT AS A HYPHEN)
	DC	'^,SUPERSC	GENERATE A SUPERSCRIPT
	DC	'_,SUBSCRP	GENERATE A SUBSCRIPT
	DC	'<,BACKSP	GENERATE A BACK SPACE
	DC	'$,ESCAPE	GENERATE ESCAPE SEQUENCE
	DC	'=,SREF		SYMBOLIC REFERENCE
	DC	'~,CTILDE	SPECIFY FONT NUMBER
	DC	'`,CAPOSTR	SPECIFY FONT NUMBER
	DC	'{,CLBRACE	SPECIFY FONT NUMBER
	DC	'},CRBRACE	SPECIFY FONT NUMBER
	DC	0		SENTINEL ON COMMAND TABLE
/
/	TITLE COMMAND TABLE
/
TITLTAB	DC	'T,TOT		INSERT TOTAL PAGES
	DC	'P,PG		INSERT PAGE NUMBER
	DC	'W,WD		INSERT WIDTH
	DC	'D,DA		INSERT DATE
	DC	0		TERMINATOR
/
/	MAIN LOOP SEARCH TABLE
/
MLTAB	DC	' ,BLANK	HANDLE SPACE
	DC	LF,EOL		LINE FEED END OF LINE
	DC	'[,COMMAND	HANDLE OPEN BRACKET COMMAND
	DC	'],MLOOP	CLOSE BRACKET END OF COMMAND
	DC	'-,REALH	HANDLE REAL HYPHEN
	DC	'~,TILDE	TILDE CHARACTER FONT SELECT
	DC	'`,APOSTR	APOSTROPE CHARACTER FONT SELECT
	DC	'{,LBRACE	LEFT BRACE CHARACTER FONT SELECT
	DC	'},RBRACE	RIGHT BRACE CHARACTER FONT SELECT
	DC	DHYPHEN,DISCRET	DISCRESIONARY HYPHEN
	DC	CTLZ,EOF	CNTRL/Z END OF FILE
	DC	0		TERMINATOR
/
	TITLE	INPUT AND OUTPUT BUFFER REGION
/////////////////////////////////////////////////////////////////////////
/									/
/	INPUT AND OUTPUT BUFFER REGION					/
/									/
INBUF	QUT	%*,*		INPUT BLOCK BUFFER			/
	ORG	*+IBUFL*256	ALLOCATE SPACE FOR BUFFER		/
/									/
INBUFE	QUT	%*,*		LAST SLOT + 1 IN INPUT BUFFER		/
/									/
OUTBUF	QUT	%*,*		OUTPUT BLOCK BUFFER			/
	ORG	*+256		ALLOCATE SPACE FOR THE OUTPUT BUFFER	/
OUTBUFE	QUT	%*,*		LAST SLOT +1 IN THE OUTPUT BUFFER	/
/									/
/////////////////////////////////////////////////////////////////////////
	TITLE	OS/8 FILE ENTER & CLOSE ROUTINES
	ISEC	0		RE-ENABLE AUTO-PAGING NOW
/
/	HERE TO CLOSE OUT THE OUTPUT FILE IF WE HAD ONE
/
	CID	00		ALWAYS RETURN TO FIELD ZERO ON EXIT
CLOSE	SUB
	CLA	
	CDF	%ODEV		TO FIELD OF OUTPUT DEVICE
	TADI	=ODEV		WAS THERE AN OUTPUT FILE?
	SNA CLA			SKIP IF SO
	JMP	CLOSE-2		NO OUTPUT FILE - SO NOTHING TO DO HERE
	TADI	=OVBLK		GET THE CURRENT LENGTH OF THE OUTPUT FILE
	CDF	%*		BACK TO CURRENT FIELD
	DCA	CLOSE2		AND STORE IN USR CALLING SEQUENCE
	TADI	=$07600		GET THE DEVICE NUMBER FOR OUTPUT FILE
	AND	=017		EXTRACT IT
	ROOM	9
	JMS	USR		CALL USR TO CLOSE OUT THE F␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ILE
	DC	4		(CLOSE OPERATION)
	DC	07601		LOCATION OF NAME OF OUTPUT FILE
CLOSE2	DC	0		LENGTH OF OUTPUT FILE STORED HERE
	JMP	*+2		ERROR SOME KIND ON CLOSE FUNCTION
	JMP	CLOSE-2		NO ERROR - RETURN TO CALL NOW
/
/	HERE WHEN THERE WAS AN ERROR ON A CLOSE FUNCTION
/
FAIL	CLA
	JMS	USR,7,8		LOG USR ERROR 8 FOR THE ERROR MESSAGE
/
/	HERE FOR THE OS/8 ENTER ROUTINE. MUST LOAD THE DEVICE HANDLER
/	AND SET UP THE OUTPUT DEVICE DRIVER PARAMETERS.
/
	CID	0		ONLY CALLED FROM FIELD 0
ENTER	SUB
	CDF	1
	TADI	=$07604		EXAMINE OUTPUT FILE EXTENSION
	SNA			SKIP IF EXTENSION SPECIFIED
	TAD	="JJ		ELSE DEFAULT EXTENSION TO .JJ
	DCAI	=$07604		...
	TADI	=$07600		GET THE OUTPUT DEVICE NUMBER
	SNA			SKIP IF WE HAVE AN OUTPUT DEVICE HERE
	JMP	ENTER-2		NO OUTPUT DEVICE SPECIFIED HERE
/
	ROOM	9
	JMS	USR		LOAD THE DEVICE HANDLER FOR THIS FILE
	DC	1		(LOAD DEVICE HANDLER FUNCTION)
	DC	ODRIVER+1	LOCATION -- 2 PAGE HANDLER IS ALLOWED
	JMP	FAIL		ERROR -- CAN NOT LOAD OUTPUT DEVICE DRIVER
	TAD	*-2		GET THE ADDRESS OF THE DEVICE DRIVER
	CDF	%ODEV		TO MAIN FIELD
	DCAI	=ODEV		STORE ADDRESS OF DRIVE ENTRY POINT
	CDF	1	
/
/	NOW PERFORM THE ENTER OPERATION ON THIS DEVICE
/
	TADI	=$07600		GET THE OUTPUT DEVICE INFORMATION
	ROOM	9
	JMS	USR
	DC	3		(FUNCTION 3 = DO FILE ENTER)
ENT1	DC	07601		LOCATION OF NAME OF OUTPUT FILE
ENT2	DC	0		DUMMY ARGUMENTS
	JMP	NO:ENTER	ERROR - ENTER FUNCTION FAILED
/
	TAD	ENT1		GET THE STARTING BLOCK FOR OUTPUT FILE
	CDF	%OSBLOK		SET FIELD
	DCAI	=OSBLOK		STORE THE OUTPUT STARTING BLOCK NOW
	CDF	%*		BACK TO CURRENT FIELD NOW
	TAD	ENT2		GET THE SPACE AVAILABLE FOR THE OUTPUT FILE
	CDF	%OMLENGTH	BACK TO MAIN FIELD
	DCAI	=OMLENGTH	STORE THE MINUS LENGTH OF SPACE AVAILABLE
	JMP	ENTER-2		RETURN TO CALLER NOW
/
/	HERE WHEN THE OS/8 ENTER FUNCTION FAILED FOR SOME REASON
/
NO:ENTER CLA
	JMS	USR,7,7		USR ERROR 7 IS ENTER FAILED
	TITLE	SYMBOL TABLE AREA (AND ONCE ONLY CODE)
/////////////////////////////////////////////////////////
/	HERE IS THE START OF THE SYMBOL TABLE		/
/	EVERYTHING BEYOND THIS POINT IS TEMPORARY	/	
/////////////////////////////////////////////////////////
	DSEC			TURN OFF PAGING
SYMTAB	QUT	%*,*		START OF SYMBOL TABLE FOR REFERENCES
/
/	THE FOLLOWING TEXT IS POTENTIALLY USED ONLY DURING
/	INITILIZATION AND IS THEREFORE SAFE IN THE SYMBOL TABLE AREA
/
SPECIFM	.TEXT	<+PLEASE SPECIFY THE PAGES TO BE PRINTED+%>
THANK	.TEXT	<+THANK YOU+%>
/
/	HERE IS THE MAIN HELP MESSAGE FOR THE ACID PROGRAM
/
BIGMSG	QUT	%*,*
	.TEXT	<A C I D  -  V5L	JY5L++>
	.TEXT	<+RUN-TIME OPTIONS:++>
	.TEXT	<  /A -  OUTPUT 10 PITCH FRACTIONAL JUSTIFICATION FILE+>
	.TEXT	<  /B -  OUTPUT 12 PITCH FRACTIONAL JUSTIFICATION FILE+>
	.TEXT	<  /D -  FORCE DOUBLE STRIKE ON ALL PAGE TITLES+>
	.TEXT	<  /E -  FORCE DOUBLE STRIKE ON ALL PAGE, PARAGRAPH TITLES+>
	.TEXT	<  /H -  NO HYPHENATION ATTEMPTED IF LINE UNDERSET+>
	.TEXT	<  /I -  INHIBIT SYMBOL TABLE (NO INDEX, NO [-] REFERENCES+>
	.TEXT	<  /N -	 NO SYMBOLIC REFERENCES (SKIP PASS 1)+>
	.TEXT	<  /S -  SPECIFY PAGE NUMBERS TO BE OUTPUT+>
	.TEXT	<  /0-9 -ALLOW ASSOCIATED TEXT ON [S] COMMAND TO APPEAR+>
	.TEXT	<  =N -  SET FLOATING LEFT-HAND MARGIN TO SPECIFIED VALUE+>
	.TEXT	<+>
	.TEXT	<DEFAULT CELL SETTINGS:++>
	.TEXT	<  0000 -  MAXIMUM LINE WIDTH+>
	.TEXT	<  0001 -  TOP MARGIN DROP+>
	.TEXT	<  0002 -  MAXIMUM # OF LINES ON PAGE+>
	.TEXT	<  0003 -  # OF LINES IN BOTTOM MARGIN (0= FORM FEED+>
	.TEXT	<  0007	-  # OF SPACES IN FLOATING MARGIN+>
	.TEXT	<+ACID COMMANDS:++>
	.TEXT	<  [/]		- PRINTS THE "/" CHARACTER+>
	.TEXT	<  [[]		- PRINTS THE "[" CHARACTER+>
	.TEXT	<  []]		- PRINTS THE "]" CHARACTER+>
	.TEXT	<  [ ]		- PRINTS FIXED (NON-JUSTIFYING SPACES+>
	.TEXT	<  [@]		- PRINTS THE "@" CHARACTER+>
	.TEXT	<  [-]		- GENERATES '-' NOT TREATED AS A HYPHEN+>
	.TEXT	<  [^]		- GENERATES A SUPERSCRIPT OF ONE HALF LINE+>
	.TEXT	<  [^NN]	- GENERATES A SUPERSCRIPT OF NN INCREMENTS+>
	.TEXT	<  [_]		- GENERATES A SUBSCRIPT OF ONE HALF LINE+>
	.TEXT	<  [_NN]	- GENERATES A SUBSCRIPT OF NN INCREMENTS+>
	.TEXT	<  [<]		- GENERATES A BACKSPACE COMMAND+>
	.TEXT	<  [<NN]	- GENERATES A BACKSPACE OF NN INCREMENTS+>
	.TEXT	<  [$ABC]	- GENERATES AN ESCAPE SEQUENCE+>
	.TEXT	<  [D]		- GENERATES TODAY'S DATE VIZ, SEPT. 12, 1976+>
   	.TEXT	<  [J]		- RESUME JUSTIFICATION OF LINES+>
	.TEXT	<  [N]		- NO JUSTIFICATION (SET RAGGED RIGHT+>
	.TEXT	<  [1]		- GENERATE SECTION LEVEL (1=DIGIT 1-9)+>
	.TEXT	<  [P]		- GENERATE UNCONDITIONAL PAGE EJECT+>
	.TEXT	<  [L]		- RESET LINE FEED SIZE TO 6 LINES/INCH+>
	.TEXT	<  [LNN]	- SET LINEFEED SIZE TO NN INCREMENTS(3) MAX)+>
	.TEXT	<  [P12]	- EJECT IF LESS THAN 12 LINES LEFT ON PAGE+>
	.TEXT	<  [M60]	- SETS RIGHT-HAND MARGIN AT LINE 60+>
	.TEXT	<  [V25]	- PERFORMS VERTICAL TAB TO LINE 25+>
	.TEXT	<  [C]		- CENTRE PRIOR TEXT+>
	.TEXT	<  [R]		- SET PRIOR TEXT FLUSH TO RIGHT MARGIN+>
	.TEXT	<  [=LABEL]	- REPLACE WITH SECTION & PAGE # OF REFERENCE+>
	.TEXT	<  [W]		- SPACE OUT LINE TO FULL WIDTH+>
	.TEXT	<  [FA.B.C]	- FORMAT PAGE. A=DROP FROM TITLE LINE,+>
	.TEXT	<		  B= NUMBER OF LINES PER OUTPUT PAGE+>
	.TEXT	<		  C= BOTTOM MARGIN, 0 = DO FORM FEED INSTEAD+>
	.TEXT	<  [S#]		- SWITCHED TEXT (LISTING OFF IF /# SET+>
	.TEXT	<  [S]		- UNCONDITIONAL END OF SWITCHED TEXT+>
	.TEXT	<  [NNN]	- GENERATE OCTAL CODE 'NNN' WITH NO WIDTH+>
	.TEXT	<  [P] (TITLE)  - GENERATES PAGE NUMBER (TITLE LINE ONLY)+>
	.TEXT	<  [T] (TITLE)  - GENERATES TOTAL # OF PAGES (TITLE ONLY)+>
	.TEXT	<%>		END OF MESSAGE
	END			THAT ALL !
