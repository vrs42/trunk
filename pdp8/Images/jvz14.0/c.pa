/	HERE FOR MESSAGES
/
ERMESS	.TEXT	< ERROR - %>
E0MS	.TEXT	<LINE BUFFER OVERFLOWED%>
E1MS	.TEXT	<UNDEFINED COMMAND IN "[]"%>
E2MS	.TEXT	<NO '[' AT END OF COMMAND%>
E3MS	.TEXT	<LINE TO JUSTIFY HAS NO SPACES%>
E4MS	.TEXT	<[D] COMMAND BUT NO OS/8 DATE ENTERED%>
E5MS	.TEXT	<OUTPUT FILE OVERFLOW (FATAL)%>
E6MS	.TEXT	<NUMERIC SYNTAX ERROR IN COMMAND%>
E7MS	.TEXT	<LABEL REFERENCE TABLE OVERFLOWED (FATAL)%>
E8MS	.TEXT	<[=] TYPE REFERENCE NOT FOUND%>
E9MS	.TEXT	<HYPHENATION TABLE OVERFLOW (FATAL)%>
E10MS	.TEXT	<SECTION HEADER OVERFLOWED COLUMN%>
E11MS	.TEXT	<SECTION REFERENCE IS NOT UNIQUE%>
