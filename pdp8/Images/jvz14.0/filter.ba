10 PRINT "SPECIFY OUTPUT DEVICE" \INPUT A$
20 FILEV#1: A$
30 PRINT#1:
100 PRINT "MULTIPLE FEEDBACK BANDPASS FILTER PROGRAM"\PRINT
110 PRINT "BANDPASS FREQUENCY ?  (IN HZ)" \INPUT W
115 LET W = 2*W*3.14259
120 PRINT "BANDPASS GAIN ?" \INPUT H
130 PRINT "FILTER Q ?" \INPUT Q
140 PRINT "RESISTOR LIMITS IN K OHMS" \INPUT X,Y
145 LET X=X*1000 \LET Y=Y*1000
146 PRINT#1: "FREQUENCY = ",W/(2*3.14259)
147 PRINT#1: "GAIN = ",H
148 PRINT#1: "FILTER Q = ",Q \PRINT#1:
150 PRINT "FILTER COMPONENT TABLE" \PRINT
160 PRINT#1: "C3,C4 PF       R1 K OHMS     R2 K OHMS     R5 K OHMS"
165 PRINT#1:
170 FOR I=1 TO 97
180 READ C \LET C=C*1E-12
190 LET R1=Q/(H*W*C) \IF R1<X THEN 230 \IF R1>Y THEN 230
200 LET R2=Q/((2*Q^2-H)*W*C) \IF R2<X THEN 230 \IF R2>Y THEN 230
210 LET R5=2*Q/(W*C) \IF R5<X THEN 230 \IF R5>Y THEN 230
220 PRINT#1: INT(C*1E12+.6),R1/1000,R2/1000,R5/1000
230 NEXT I
240 CLOSE#1 \RESTORE \GOTO 10
2000 DATA 10,12,15,20,22,24,27,30,33,39
2010 DATA 39,43,47,56,62,68,75,82,91,100
2020 DATA 120,130,150,160,180,200,220,240,270,300
2030 DATA 330,360,390,430,470,510,560,620,680,750
2040 DATA 820,910,1000,1100,1200,1300,1500,1600,1800,2000
2050 DATA 2200,2400,2500,2700,3000,3300,3600,4300,4700,5000
2060 DATA 5100,5600,6200,6800,7500,8200,9100,10E3,11E3,12E3
2070 DATA 13E3,15E3,16E3,18E3,20E3,22E3,24E3,27E3,30E3,33E3
2080 DATA 36E3,39E3,43E3,47E3,50E3,51E3,56E3,62E3,68E3,75E3
2090 DATA 82E3,91E3,10E4,15E4,22E4,33E4,47E4
3000 END
