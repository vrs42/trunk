	AND C177
	TAD (-40
	SMA		/CONTROL-CHAR ?
	 ISZ I X	/NO, COUNT IT
	NOP
	TAD (40-12	
	SZA		/WAS IT LINEFEED ?
	 TAD M3		/(12-15
	SNA CLA		/WAS IT CR ?
