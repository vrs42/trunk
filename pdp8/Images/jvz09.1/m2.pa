READ,	AC0004		/TURN SILO- INTO READ/WRITE COMMAND
	TAD RFUNC
	JMS RXCOMM
	TAD SECTR	/LOAD SECTOR #
	STR
	JMP .-1
	XDR
	AC0001		/START AT TRACK 1!
	TAD RXTRCK
	STR
	JMP .-1
	XDR
	ISZ BLOCK	/NEXT LOGICAL RECORD
	JMS I (CALC	/CALC TRACK/SECTOR (CLEARS AC)
