	AND C2		/EXTRACT THE 'DISK' BIT >
	DCA HEAD	/SET DISK AND HEAD INITIALLY
	TAD SYSGET
	DCA 13		/
	TAD I 13	/AUTO-INDEX !
	DCA SYSDTV	/
SYSCDF,	HLT		//HERE COMES THE CORRECT CDF
	TAD I SYSDTV
	AND C3700	//GET TRANSFER LENGTH
	SNA		/4K TRANSFER ?
	 AC4000		//DO SO
	BSW		//MAKE PAGE COUNT
	CIA		//
	DCA PCNT	//
	TAD I SYSDTV	//GET FUNCTION AGAIN
	AND (4070	//FIELD AND READ/WRITE BIT
	TAD (2002	//ADD INT. ENABLE AND "DATA"BIT
	DCA CMR		//SAVE FOR COMMAND REGISTER
	TAD I SYSDTV	//GET FUNCTION WORD AGAIN
	AND C7		//EXTRACT UNIT NUMBER
	TAD (-3		//
	SMA		//WHICH HEAD ?
	 ISZ HEAD	//SECOND HEAD
	SPA		//UNIT MODULO 3
	 TAD (3		//
	SNA		//UNIT 0 ?
	 JMP UNIT0	//YES
	CLL RTR		//
	SMA CLA		//UNIT 1 ?
	 TAD (202	//YES
	TAD (202	//
UNIT0,	DCA OFFSET	//SET TRACK OFFSET
	ISZ SYSDTV	//
