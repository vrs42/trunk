	ISZ CMR		/YES, SET HALF/SECTOR BIT
	ACM1		/BACKUP PCNT
	DCA PCNT	/
BWTR,	AC0004		/GET DMA-ENABLE BIT
	TAD CMR		/PLUS COMMAND
	LCRE		/START DMA XFER
	JMS I (SYSWAT	/WAIT FOR INTERRUPT
	TAD CMR		/WAS IT READ OR WRITE?
	SPA CLA		/
	 JMP DONE	/WRITE, DONE
	TAD (-27	/READ, WAIT TILL FIFO EMPTY
	IAC		/
	SZA		/
	 JMP .-2	/
DONE,	CLFW		/CLEAR FLAG AND WRITE BIT
	CWCO		/CLEAR WCO
	TAD C240	/SEND TERMINATE COMMAND
	WBTD		/
	JMS I (SYSWAT	/WAIT FOR FLAG
	CLFW		/CLEAR FLAG
	RBFD		/READ STATUS BYTE
	AND (160	/EXAMINE SOME ERROR BITS
