	JMP I (DNE	/GO GIVE COMPLETION

HEAD,	O
OFFSET,	0
SYSGET,	SYSQ
SYSDTV,	0
PCNT,	0	/PAGE COUNTER
CMR,	0	/SOFT COMMAND REGISTER

