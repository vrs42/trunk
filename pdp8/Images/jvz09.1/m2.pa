IFDEF SYHB08 <
	CWCO=6600	/CLEAR WCO FLAG
	SKDF=6601	/SKIP ON "FLAG"
	SKWO=6602	/SKIP ON WCO OR FLAG
	LADR=6603	/LOAD CA, CLEAR WCO, CLA
	LCRE=6604	/LOAD COMMAND, CLEAR FLAG, CLA
	WBTD=6605	/WRITE BYTE TO DISK (AC4-11)
	RBFD=6606	/READ BYTE FROM DISK, (AC4-11)
	CLFW=6607	/CLEAR FLAG, WRITE-BIT IN CMND REG, CLA

SYSWAT,	SYIGNR
	CLA CLL		///JUST TO BE SURE
	JMP I SWITCH	///RETURN FROM SYSDO OR TO INTERRUPT

SWITCH,	0		///
	JMP I SYSWAT	///CONTINUE HANDLER CODE

SYIGNR,	CLFW		///CLEAR FLAG
	CWCO		///AND WCO
	JMP I ZFSTEXT	///QUIT

SYSINT,	JMS SWITCH	///HERE GOES THE INTERRUPT !!!
	JMP I ZFSTEXT	///RETURN FROM INTERRUPT

ERR,	DCA ERSTAT	///SET LAST ERROR STATUS
	ISZ ERRLOG	///COUNT ALL ERRORS
	ISZ SYERCNT	///WILL WE DO ANOTHER RETRY ?
	 JMP I (SYSTRY	///YES, GO THERE
	AC0004		///NO, FATAL
DNE,	DCA SYSTAT	///SET/CLEAR COMPLETION STATUS
	AC0002		///BUMP QUEUE POINTERS
	TAD I (SYSGET	///
	AND (-SYSMAX-1^2+1 ///
	DCA I (SYSGET	///
	ACM3		///RESET RETRY COUNTER !
	DCA SYERCNT	///(BUGFIX 3-AUG-81)
	TAD (JMP I CONTAB+SYS-1 ///#
	DCA I (SKPEND	///# KLUDGE # TO GET BACK FROM SOFINT
	TAD (SYNEXT	///#
	DCA CONTAB+SYS-1///#
	TAD SYSLOT	///GET COMPLETION EVENT NUMBER
	JMS I ZSOFINT	///
SYSTAT,	   0		///

SYNEXT,	CLA CLL		///AC MAY BE DIRTY HERE
	TAD SYNEXT	///RESTORE SKPEND
	DCA I (SKPEND	///
	TAD (SYIGNR	///
	DCA SYSWAT	//IGNORE SPRIOUS INTERRUPTS
	ISZ SYSCNT	///MORE IN THE QUEUE ?
	 JMS I (SYSDO	///YES, START A NEW TRANSFER
	JMP I ZFSTEXT	///AND RTI

SYERCNT,-3	///ERROR COUNTER
SYSLOT,	0	///CURRENT SLOT#
ERRLOG,	0	///TOTAL DISK ERRORS
ERSTAT,	0	///LAST ERROR STATUS

