	TAD TTSAV
	AND C177
	TAD (-11
	SNA		/TAB ?
	 JMP TTTAB	/YES, GO EXPAND IT
	IAC
	SZA CLA		/BACKSPACE ?
	 JMP TT0	/NOT BACKSPACE
	ACM1		/BACKSPACE, BACKUP POSITION COUNTER
	TAD TTCOUNT
