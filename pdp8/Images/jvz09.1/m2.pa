TTCHAR,	0	/THE CHARACTER WE GOT FROM THE CALLER
TTCOUNT,0	/THE CURRENT POSITION
TTBACK,	T1BACK-210
TTFCHR,	-T1CHAR	/MINUS CHARACTER THAT NEEDS FILLERS
