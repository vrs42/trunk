IFNZRO BGMAX <
*TRAP^4+SKPBAS
	SINT		///TEST USER INTERRUPT FLAG
	 JMP .+3	///
	JMP I .+1	///JUMP TO CENTRAL EMULATOR
	TRAPINT		///>
IFDEF LE8E <
O=LE8E&77^10
*LPT^4+SKPBAS
IFZERO O <
	6661		///TEST LINEPRINTER FLAG
	 JMP .+3	///
	6662		///CLEAR PRINTER FLAG
	JMS I ZHRDINT	///
