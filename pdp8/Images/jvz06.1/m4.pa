	215;O+"D;O+"A;O+"T;O+"E;O+215
	ZBLOCK BG4IN+44-.
BG4OUT,	BG4OLN;26;0;26
	0;"M;"U;"L;"T;"I;"8;" ;"V;VERSHI;VERSLO
