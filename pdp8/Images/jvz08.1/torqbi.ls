        FORTRAN IV  4BAAA   19-FEB-80             PAGE  ONE 

	C  TORQUE.F4  CALLED MAIN.F4 FOR WORKING COPY
	C  MOD FOR BATCH INPUT 2/20/80 D.C.T.
	C**SEIDEL ITERATION FOR FORCE VECTOR COMPUTATION (WITH ROTATION)
	C** NEEDS 3 X 3 MATRIX INVERSION MAT3IN.F4; CALLED AS MATINV
	C**WITH 3 X 3 DIMENSION (SINGLE PRECISION) OF MATRIX TO BE INVERTED
	C**KIRKBI.F4 IS KIRKWOOD APPROX SUBROUTINE OF OLD TORQUE PROGRAM
	C  IS NEEDED AS SUBR
	C  SEIDL.F4 SUBR IS ALSO NEEDED FOR THE SEIDEL ITERATIONS
	C       D.C.T.11/4/76     R.A.E. 2-21-79
	C  MODIFIED TO INCLUDE OVERLAPPING BEAD COMPUTATION
	C  (ROTNE + PRAGER)
	C
	C  FILES:
	C       1-ITERATIONS
	C       2-READ OLD ITERATIONS
	C       5-COORDINATES
	C       6-RESTART FILE FROM PREVIOUS RUN
	C       7-SAVE FILE FOR PROGRAM INTERRUPTION
	C
	C  SENSE SWITCH SETTINGS:
	C       4-INHIBIT PROGRAM CONVERGENCE TEST STOP
	C       5-INTERRUPT PROGRAM
	C
	C DIMENSION XYZ(3,555),CEN(3),FV1(1665),FV2(1665),FV3(1665)-- 72KCORE REQ.
0002	        DIMENSION XYZ(3,480),CEN(3),FV1(1440),FV2(1440),FV3(1440)
0003	        DIMENSION SUMV(3,3),T(8),U(2),AIJ(3,3)
0004	        DIMENSION OLDT(3,3),OLDF(3,3)
0005	        DOUBLE PRECISION SV(3,3),SUMF(3,3),SX(3,3),SUMT(3,3)
0006	        LOGICAL NSW
0007	        DATA SPI/0.1888726/
0010	        COMMON /BLOCK1/SUMV,T,U,AIJ,OLDT,OLDF,SV,SUMF,SX,SUMT,NSW
	C  CEN(X,Y, AND Z)=CENTER OF ROTATION   DEFAULT=
0011	        CEN(1)=0.
0012	        CEN(2)=0.
0013	        CEN(3)=0.
	C  ITR:   0=TRANSLATION   1=ROTATION   DEFAULT=
0014	        ITR=0.
	C
0015	        WRITE(4,1001)
0016	1001    FORMAT(' FORCE RESIST. VECTOR BY SEIDEL ITER'//)
	C
	C**READ INPUT TEST SPHERE COORD
	C
0017	        READ(5,1000)T,N,R
0020	1000    FORMAT(8A6/I6,F9.5)
0021	        WRITE(4,1000)T,N,R
0022	        IF(N.GT.480) STOP
0023	        DO 10 I=1,N
0024	        READ(5,1005)NA,(XYZ(K,I),K=1,3)
0025	1005    FORMAT(I5,3F10.5)
	C       WRITE(4,1005)NA,(XYZ(K,I),K=1,3)
0026	10      CONTINUE
0027	        READ(5,1002)A
0030	1002    FORMAT(A1)
0031	        N3=3*N
        FORTRAN IV  4BAAA   19-FEB-80             PAGE  TWO 

0032	        R2=R**2
0033	        IF(A.EQ.1HY) GO TO 230
	C
0034	        CALL KIRK(ITR,N,R,XYZ,CEN,FV1,FV2,FV3)
	C
0035	2000    FORMAT(8A6/I6,F9.5/' ',2A6/3F9.5)
0036	2006    FORMAT(/' ',2A6/' CENTER = ',3F9.5)
	C
0037	229     WRITE(4,1330)
0040	        DO 228 L=1,3
0041	        DO 228 M=1,3
0042	        AIJ(L,M)=SUMT(L,M)
0043	228     OLDF(L,M)=SUMF(L,M)
0044	1330    FORMAT(/' INITIAL TORQUE MATRIX')
0045	        WRITE(4,1070)((AIJ(L,M),L=1,3),M=1,3)
0046	1070    FORMAT(3B13.6)
0047	        WRITE(4,1335)
0050	1335    FORMAT(' INITIAL FORCE MATRIX')
0051	        WRITE(4,1070)((OLDF(L,M),L=1,3),M=1,3)
0052	        IJK1=1
0053	        I1=1
0054	        GO TO 250
	C
	C FOR RESTART, READ FORCE VECTOR HERE
0055	230     READ(6) T,NN,ITR,IJK1,I1,SUMDEV,SUMT,SUMF
0056	        WRITE(4,1337) IJK1,I1,T,NN
0057	1337    FORMAT(' RESTART AT ITERATION ',I4,',I=',I4/8A6/I7)
0060	        IF(N.NE.NN) STOP
0061	        K1=-27
0062	231     K1=K1+28
0063	        K2=K1+27
0064	        IF(K2.GT.N3) K2=N3
0065	        READ(6)(FV1(K),FV2(K),FV3(K), K=K1,K2)
0066	        IF(K1.LT.N3) GO TO 231
	C
	C  SKIP TO END OF EXTRAPOLATION FILE
0067	        REWIND 1
0070	        READ(2,2000)T,N,A,U,(CEN(I),I=1,3)
0071	        IF(A.NE.R)WRITE(4,2001)A,R
0072	2001    FORMAT(' RAD. CHNGE; OLD R =',F9.5' NEW R ='F9.5/)
0073	        WRITE(1,2000)T,N,R,U,(CEN(I),I=1,3)
0074	240     READ(2,1398)K,TX,TY,TZ,FX,FY,FZ
0075	1398    FORMAT(I6,6F13.6)
0076	        WRITE(1,1398)K,TX,TY,TZ,FX,FY,FZ
0077	        IF(K.LT.IJK1-1)GOTO 240
0100	        WRITE(4,2006)U,(CEN(I),I=1,3)
	C
	C
	C       ITERATE TO REFINE FORCE VECTOR  FV
0101	250     CONTINUE
	C
0102	        CALL SEIDL(ITR,N,R,XYZ,CEN,FV1,FV2,FV3,YN,SUMDEV,IJK1,I1)
	C
	C  YN COMES BACK AS FOLLOWS:
	C       ITR=0 AND YN=0   THEN DONT INVERT SUMT(OLDT)
        FORTRAN IV  4BAAA   19-FEB-80             PAGE  THREE 

	C       ITR=1 AND YN=0   THEN DONT INVERT SUMF(OLDF)
	C
0103	500     REWIND 7
0104	        IF(I1.EQ.1) GO TO 502
0105	501     I=I1+1
0106	        IJK=IJK1
0107	        WRITE(4,1500) IJK,I
0110	1500    FORMAT(' INTERRUPTION AT ITERATION',I4,', I=',I4)
0111	        GO TO 503
	C  502 MEANS CONVERGED UNLESS SUMDEV IS LARGE; WRITE O.P. FILES
0112	502     IF(SUMDEV.GT.0.0002*N)GO TO 501
0113	        I=1
0114	        IJK=IJK1+1
0115	503     WRITE(7) T,N,ITR,IJK,I,SUMDEV,SUMT,SUMF
0116	        K1=-27
0117	504     K1=K1+28
0120	        K2=K1+27
0121	        IF(K2.GT.N3) K2=N3
0122	        WRITE(7)(FV1(K),FV2(K),FV3(K), K=K1,K2)
0123	        IF(K1.LT.N3) GO TO 504
	C
	C   USE LAST COMPLETE ITERATION IF INTERRUPTED
0124	        DO 408 L=1,3
0125	        DO 408 M=1,3
0126	        SUMT(L,M)=OLDT(L,M)
0127	        SUMF(L,M)=OLDF(L,M)
0130	408     CONTINUE
	C
0131	        WRITE(4,1410)
0132	1410    FORMAT(/' TORQUE MATRIX')
0133	        WRITE(4,1070)((SUMT(L,M), M=1,3), L=1,3)
0134	        WRITE(4,1415)
0135	1415    FORMAT(/' FORCE MATRIX')
0136	        WRITE(4,1070)((SUMF(L,M), M=1,3), L=1,3)
0137	        IF(ITR.EQ.1)GO TO 416
0140	        IF(YN.LE.1.E-8)GO TO 555
0141	416     DO 550 L=1,3
0142	        DO 550 M=1,3
0143	550     AIJ(L,M)=SUMT(L,M)
0144	        CALL  MATINV(AIJ,3)
0145	        WRITE(4,1420)
0146	1420    FORMAT(/' INV. TORQUE MATRIX')
0147	        WRITE(4,1070)((AIJ(L,M),M=1,3),L=1,3)
0150	555     IF(ITR.EQ.0)GO TO 565
0151	        IF(YN.LE.1.E-8)GO TO 570
0152	565     DO 560 L=1,3
0153	        DO 560 M=1,3
0154	560     AIJ(L,M)=SUMF(L,M)
0155	        CALL MATINV(AIJ,3)
0156	        WRITE(4,1425)
0157	1425    FORMAT(/' INV.FORCE MATRIX')
0160	        WRITE(4,1070)((AIJ(L,M),M=1,3),L=1,3)
0161	570     STOP
0162	        END
