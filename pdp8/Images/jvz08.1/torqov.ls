        FORTRAN IV  4BAAA    2-FEB-80             PAGE  ONE 

	C  TORQUE.F4  CALLED MAIN.F4 FOR WORKING COPY
	C**SEIDEL ITERATION FOR FORCE VECTOR COMPUTATION (WITH ROTATION)
	C** NEEDS 3 X 3 MATRIX INVERSION MAT3IN.F4; CALLED AS MATINV
	C**WITH 3 X 3 DIMENSION (SINGLE PRECISION) OF MATRIX TO BE INVERTED
	C**KIRK.F4 IS KIRKWOOD APPROX SUBROUTINE OF OLD TORQUE PROGRAM
	C  IS NEEDED AS SUBR
	C  SEIDL.F4 SUBR IS ALSO NEEDED FOR THE SEIDEL ITERATIONS
	C       D.C.T.11/4/76     R.A.E. 2-21-79
	C  MODIFIED TO INCLUDE OVERLAPPING BEAD COMPUTATION
	C  (ROTNE + PRAGER)
	C
	C  FILES:
	C       1-ITERATIONS
	C       2-READ OLD ITERATIONS
	C       5-COORDINATES
	C       6-RESTART FILE FROM PREVIOUS RUN
	C       7-SAVE FILE FOR PROGRAM INTERRUPTION
	C
	C  SENSE SWITCH SETTINGS:
	C       4-INHIBIT PROGRAM CONVERGENCE TEST STOP
	C       5-INTERRUPT PROGRAM
	C
0002	        DIMENSION XYZ(3,555),CEN(3),FV1(1665),FV2(1665),FV3(1665)
0003	        DIMENSION SUMV(3,3),T(8),U(2),AIJ(3,3)
0004	        DIMENSION OLDT(3,3),OLDF(3,3)
0005	        DOUBLE PRECISION SV(3,3),SUMF(3,3),SX(3,3),SUMT(3,3)
0006	        LOGICAL NSW
0007	        DATA SPI/0.1888726/
0010	        COMMON /BLOCK1/SUMV,T,U,AIJ,OLDT,OLDF,SV,SUMF,SX,SUMT,NSW
	C  CEN(X,Y, AND Z)=CENTER OF ROTATION   DEFAULT=
0011	        CEN(1)=0.
0012	        CEN(2)=0.
0013	        CEN(3)=0.
	C  ITR:   0=TRANSLATION   1=ROTATION   DEFAULT=
0014	        ITR=0.
	C
0015	        WRITE(4,1001)
0016	1001    FORMAT(' FORCE RESIST. VECTOR BY SEIDEL ITER'//
	     1  ' CONT PREV COMP? '$)
0017	        READ(4,1002) A
0020	1002    FORMAT(A1)
	C
	C**READ INPUT TEST SPHERE COORD
	C
0021	        READ(5,1000)T,N,R
0022	1000    FORMAT(8A6/I6,F9.5)
0023	        WRITE(4,1000)T,N,R
0024	        IF(N.GT.555) STOP
0025	        DO 10 I=1,N
0026	        READ(5,1005)NA,(XYZ(K,I),K=1,3)
0027	1005    FORMAT(I5,3F10.5)
	C       WRITE(4,1005)NA,(XYZ(K,I),K=1,3)
0030	10      CONTINUE
0031	        N3=3*N
0032	        R2=R**2
        FORTRAN IV  4BAAA    2-FEB-80             PAGE  TWO 

0033	        IF(A.EQ.1HY) GO TO 230
	C
0034	        CALL KIRK(ITR,N,R,XYZ,CEN,FV1,FV2,FV3)
	C
0035	2000    FORMAT(8A6/I6,F9.5/' ',2A6/3F9.5)
0036	2006    FORMAT(/' ',2A6/' CENTER = ',3F9.5)
	C
0037	229     WRITE(4,1330)
0040	        DO 228 L=1,3
0041	        DO 228 M=1,3
0042	        AIJ(L,M)=SUMT(L,M)
0043	228     OLDF(L,M)=SUMF(L,M)
0044	1330    FORMAT(/' INITIAL TORQUE MATRIX')
0045	        WRITE(4,1070)((AIJ(L,M),L=1,3),M=1,3)
0046	1070    FORMAT(3B13.6)
0047	        WRITE(4,1335)
0050	1335    FORMAT(' INITIAL FORCE MATRIX')
0051	        WRITE(4,1070)((OLDF(L,M),L=1,3),M=1,3)
0052	        IJK1=1
0053	        I1=1
0054	        GO TO 250
	C
	C FOR RESTART, READ FORCE VECTOR HERE
0055	230     READ(6) T,NN,ITR,IJK1,I1,SUMDEV,SUMT,SUMF
0056	        WRITE(4,1337) IJK1,I1,T,NN
0057	1337    FORMAT(' RESTART AT ITERATION ',I4,',I=',I4/8A6/I7)
0060	        IF(N.NE.NN) STOP
0061	        K1=-27
0062	231     K1=K1+28
0063	        K2=K1+27
0064	        IF(K2.GT.N3) K2=N3
0065	        READ(6)(FV1(K),FV2(K),FV3(K), K=K1,K2)
0066	        IF(K1.LT.N3) GO TO 231
	C
	C  SKIP TO END OF EXTRAPOLATION FILE
0067	        REWIND 1
0070	        READ(2,2000)T,N,R,U,(CEN(I),I=1,3)
0071	        WRITE(1,2000)T,N,R,U,(CEN(I),I=1,3)
0072	240     READ(2,1398)K,TX,TY,TZ,FX,FY,FZ
0073	1398    FORMAT(I6,6F13.6)
0074	        WRITE(1,1398)K,TX,TY,TZ,FX,FY,FZ
0075	        IF(K.LT.IJK1-1)GOTO 240
0076	        WRITE(4,2006)U,(CEN(I),I=1,3)
	C
	C
	C       ITERATE TO REFINE FORCE VECTOR  FV
0077	250     CONTINUE
	C
0100	        CALL SEIDL(ITR,N,R,XYZ,CEN,FV1,FV2,FV3,YN,SUMDEV,IJK1,I1)
	C
	C  YN COMES BACK AS FOLLOWS:
	C       ITR=0 AND YN=0   THEN DONT INVERT SUMT(OLDT)
	C       ITR=1 AND YN=0   THEN DONT INVERT SUMF(OLDF)
	C
0101	500     REWIND 7
        FORTRAN IV  4BAAA    2-FEB-80             PAGE  THREE 

0102	        IF(I1.EQ.1) GO TO 502
0103	501     I=I1+1
0104	        IJK=IJK1
0105	        WRITE(4,1500) IJK,I
0106	1500    FORMAT(' INTERRUPTION AT ITERATION',I4,', I=',I4)
0107	        GO TO 503
	C  502 MEANS CONVERGED UNLESS SUMDEV IS LARGE; WRITE O.P. FILES
0110	502     IF(SUMDEV.GT.0.0002*N)GO TO 501
0111	        I=1
0112	        IJK=IJK1+1
0113	503     WRITE(7) T,N,ITR,IJK,I,SUMDEV,SUMT,SUMF
0114	        K1=-27
0115	504     K1=K1+28
0116	        K2=K1+27
0117	        IF(K2.GT.N3) K2=N3
0120	        WRITE(7)(FV1(K),FV2(K),FV3(K), K=K1,K2)
0121	        IF(K1.LT.N3) GO TO 504
	C
	C   USE LAST COMPLETE ITERATION IF INTERRUPTED
0122	        DO 408 L=1,3
0123	        DO 408 M=1,3
0124	        SUMT(L,M)=OLDT(L,M)
0125	        SUMF(L,M)=OLDF(L,M)
0126	408     CONTINUE
	C
0127	        WRITE(4,1410)
0130	1410    FORMAT(/' TORQUE MATRIX')
0131	        WRITE(4,1070)((SUMT(L,M), M=1,3), L=1,3)
0132	        WRITE(4,1415)
0133	1415    FORMAT(/' FORCE MATRIX')
0134	        WRITE(4,1070)((SUMF(L,M), M=1,3), L=1,3)
0135	        IF(ITR.EQ.1)GO TO 416
0136	        IF(YN.LE.1.E-8)GO TO 555
0137	416     DO 550 L=1,3
0140	        DO 550 M=1,3
0141	550     AIJ(L,M)=SUMT(L,M)
0142	        CALL  MATINV(AIJ,3)
0143	        WRITE(4,1420)
0144	1420    FORMAT(/' INV. TORQUE MATRIX')
0145	        WRITE(4,1070)((AIJ(L,M),M=1,3),L=1,3)
0146	555     IF(ITR.EQ.0)GO TO 565
0147	        IF(YN.LE.1.E-8)GO TO 570
0150	565     DO 560 L=1,3
0151	        DO 560 M=1,3
0152	560     AIJ(L,M)=SUMF(L,M)
0153	        CALL MATINV(AIJ,3)
0154	        WRITE(4,1425)
0155	1425    FORMAT(/' INV.FORCE MATRIX')
0156	        WRITE(4,1070)((AIJ(L,M),M=1,3),L=1,3)
0157	570     STOP
0160	        END
