C  SOL20 TO PDP12  COMMUNICATIONS
C
	COMMON ICHAR,IERCT,LINE,MSG
	DIMENSION MSG(80),L(80)
C
	READ(1,1000) FN
1000	FORMAT('TYPE FILENAME (A6): ',A6)
	CALL IOPEN('DSK',FN)
4	READ(1,1001) NLINE
1001	FORMAT('TYPE # OF LINES TO SEND: ',I3)
	IF(NLINE-999)5,5,4
5	N1=176
	N2=176
	N3=176
S	TAD	\NLINE
SAA,	TAD	(-144
S	SPA
S	JMP	AB
S	ISZ	\N1
S	JMP	AA
SAB,	TAD	(144
SAC,	TAD	(-12
S	SPA
S	JMP	AD
S	ISZ	\N2
S	JMP	AC
SAD,	TAD	(12
S	TAD	\N3
S	DCA	\N3
11	CALL RCHAR
	IF(ICHAR-63)11,12,11
12	ICHAR=N1
	CALL SCHAR
	ICHAR=N2
	CALL SCHAR
	ICHAR=N3
	CALL SCHAR
	ICHAR=141
	CALL SCHAR
C
	DO 50  LINE=1,NLINE
	READ(4,1010)L
1010	FORMAT(80A1)
C  FIND LAST NON-BLANK CHARACTER
	NN=80
	DO 14  I=1,NN
	N=NN+1-I
	IF(L(N)) 13,14,13
13	IF(L(N)+2016) 15,14,15
14	CONTINUE
15	CONTINUE
	K=0
C  REMOVE BLANKS, INSERT COMMAS
	KOMMA=1
	DO 30  I=1,80
	IF(L(I)-191) 21,22,21
21	K=K+1
	MSG(K)=L(I)
	KOMMA=0
	GO TO 30
22	IF(KOMMA-1)23,24,23
23	K=K+1
	MSG(K)=-736
	KOMMA=1
24	CONTINUE
30	CONTINUE
	CALL ACOM(80)
50	CONTINUE
	CALL IACTF
	END
