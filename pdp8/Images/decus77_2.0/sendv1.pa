	AND	(377
	DCA	MSG
	CAL
	SENDW		/SEND
	NSP
	TRMSG		/
	TAD	TRMSG+3	/STATUS
	SZA CLA		/SKIP OK
	JMP	OOPS	/ASSUME A DISCONNECT!!
	ISZ	JOBC1
	SKP
