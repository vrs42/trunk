	SZA CLA
	JMP I	(GOTINM	/GOT INTERRUPT MESSAGE
GOTSLM,	TAD	CCBRH	/GOT SOLICITED MESSAGE
	SNA CLA
	JMP I	(BADFMT	/ERROR IF UNEXPECTED
