	/CHECK FOR VALID DSTADR
	/IF OUT OF RANGE, FORMAT ERROR
	/EXIT TO CALL+1 IF NO LINK ACTIVE, JUST IGNORE IT
	/EXIT TO CALL+2 IF OK, BRING IN CCB

CHKDST,	0
	TAD	DSTADR
	SZA		/DISALLOW NULL DSTADR
	TAD	(-MAXLNK-1
L7700,	SMA CLA
	JMP I	(BADFMT	/ERROR
	TAD	DSTADR
