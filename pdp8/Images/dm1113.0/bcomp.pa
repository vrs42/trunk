	DCA	BLOCK
	TAD	TMPBLK+1/ALSO THE SIZE
	DCA I	(OUSIZE
	JMP I	(GETDEV	/GO FETCH DEVICE HANDLER

BRTCHN,	CIF	10	/DO A RESET ON CHAIN FROM BRTS
	JMS I	(200	/TO FORGET ANY UNCLOSED FILES
	13		/RESET
	JMP	STRT3	/GO ENTER TEMPORARY FILE

