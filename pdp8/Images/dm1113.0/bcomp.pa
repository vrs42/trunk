	WGOTO
	JMP I	(ONSNTX	/Jmp if neither
	IAC		/JUMP = GOSUB+1
ONGOSUB,TAD	(JSUB
	DCA	ONTEMP	/Save the branch opcode
ONLUP,	JMS I	QSNUM	/Get a line number
	JMP I	(ONSNTX	/Syntax error if none
	TAD	TEMP	/Make branch opcode
	TAD	ONTEMP
	JMS I	QOUTWRD	/Emit itIC.UF LOOKUP
	CDF	10
	DCA I	X10
	DCA I	X10	/CLEAR UNUSED WORDS
	DCA I	X10
STRT3,	CDF
