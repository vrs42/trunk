/
/
/	FILE TO CONFIGURE THE ODT/8 DEBUGGING TASK
/
/
/ EDIT HISTORY:
/
/ 12-JUL-78: (LHN)
/	1)  CREATED THIS DATE.
/ 23-SEP-81: (LHN)
/	1)  UPDATED FOR RTS/8 VERSION 3 AND MACREL
/
/
/
/
/
/  THE PARAMETERS CONTAINED HERE CAN BE DEFINED HERE
/  OR  THEY  CAN BE DEFINED IN THE PARAMETER FILE OR
/  THEY CAN BE DEFINED DIRECTLY IN THE ODT/8  SOURCE
/  FILE. (BUT, THEY MUST BE DEFINED SOMEWHERE !)
/
/
/
/
/
/ ODTFLD	MEMORY FIELD FOR ODT/8.
/ ODTLOC	ODT/8 PROGRAM ORIGIN.
/
/ RTS8VER	VERSION OF RTS/8 ODT/8 WILL RUN UNDER:
/		  =2 FOR VERSIONS 1 AND 2, AND =3 FOR
/		  VERSION 3.
/ ASMVER	VERSION OF ASSEMBLER TO BE USED:
/		  =0 FOR PAL8, =1 FOR MACREL.
/
/ ODTCDV	USER TERMINAL TASK NUMBER.
/ ODTLDV	LISTING DEVICE TASK NUMBER.
/
/ ODTFUL	=1 TO ASSEMBLE ALL ODT/8 FUNCTIONS.
/


/ODTFLD=	DEFINED IN MSTPAR
/ODTLOC=	DEFINED IN MSTPAR

RTS8VER= 2
ASMVER=  0
ODTCDV=  TTY
ODTLDV=  LPT
ODTFUL=  1
/
/
/ ODT/8 USES THE FOLLOWING SYSTEM DEFINITIONS, WHICH 
/ ARE USUALLY FOUND IN THE PARAMETER FILE.
/
/
/ HGHFLD	THE HIGHEST USEABLE MEMORY FIELD.
/ NTASKS	MAXIMUM NUMBER OF TASKS IN THE SYSTEM.
/ MQ		1 IF THE CPU HAS AN M/Q REGISTER.
/ EAE		1 IF THE CPU HAS EAE HARDWARE.
/
/ KT8A		1 IF THE CPU HAS KT8A MEMORY MANAGEMENT.
/ OMNI		1 FOR PDP8E OR PDP8A CPU'S, OTHERWISE 0
/		  (VERSION 3).
/ RTFLD		THE MEMORY FIELD OF THE RTS/8 EXECUTIVE
/		  TIMES 10(8) (VERSION 3).
/ MQSV		1 IF THE M/Q IS SAVED DURING CONTEXT 
/		  SWITCHING (VERSION 3).
/ EAESV		1 IF THE EAE STEP COUNTER IS SAVED
/		  DURING CONTEXT SWITCHING (VERSION 3).
/
/ MCRSTR	1 IF MCR HAS BEEN ASSEMBLED TO SAVE TASK
/		  STARTING ADDRESSES AS PART OF ITS NAME
/		  TABLE (VERSION 3).
/
/

IFNDEF	RTFLD	<RTFLD=0>
IFNDEF	RTCDF	<RTCDF=RTFLD^10>
IFNDEF	KT8A	<KT8A=0>

IFNDEF	PDP8E	<PDP8E=0>
IFNDEF	PDP8A	<PDP8A=0>
IFNDEF	VT78	<VT78=0>
IFNDEF	OMNI	<OMNI=PDP8E+PDP8A+VT78>

IFNDEF	MQ	<MQ=0>
IFNDEF	MQSV	<MQSV=0>
IFNDEF	EAE	<EAE=0>
IFNDEF	EAESV	<EAESV=0>
IFNDEF	MCRSTR	<MCRSTR=0>
/
/
/ DEFAULT SYMBOLIC DEFINITIONS
/
/
IFNDEF	ODTFLD	<ODTFLD=10>
IFNDEF	ODT	<ODT=10>	/FOR TEST
IFNDEF	ODTLOC	<ODTLOC=200>

IFNDEF	ODTCDV	<ODTCDV=TTY>	/USER TERMINAL.
IFNDEF	ODTLDV	<
	IFDEF  LPT <ODTLDV=LPT>	/LIST DEVICE.
	IFNDEF LPT <ODTLDV=TTY>
		>

IFNDEF	ODTFUL	<ODTFUL=1>	/FULL ODT.


IFNDEF	RTS8VER	 <RTS8VER=2>	/RTS/8 VERSION 2
IFNDEF	ASMVER	 <ASMVER=0>	/USE PAL8
IFNDEF	TASKNAME <TASKNAME=0>	/CANNOT USE TASKNAMES

