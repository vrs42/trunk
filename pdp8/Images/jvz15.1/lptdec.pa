/ OS/8 "LPT" HANDLER FOR A DEC WRITER
/
	LSF=6661	/LINEPRINTER SKIP ON FLAG
	LLS=6666	/LOAD & PRINT
/
	*0
	-001		/1 DEVICE HANDLER
	0405		/GROUP NAME
	0327		/"DECW"
	1420		/PERMANENT DEVICE NAME
	2400		/"LPT"
	1040		/"DCB" DEVICE CONTROL BLOCK
	0003		/ENTRY OFFSET	200+3
	0000		/ALWAYS ZEROES
	0000
/
*200
LPWDTH, -205		/132 CHARECTERS / LINE
LTERMC,	0014
LPLPTR, 0000
LPT,	0003		/ENTRY POINT & VERSION NUMBER
	CLA STL RAR	/SET 4000 BIT TO BUMP R/W BIT INTO LINK
	TAD I LPT	/GET ARG1	R/W BIT INTO LINK
	AND LP7700	/GET WORD COUNT
	CMA
	DCA LPTWC	/SAVE -(WC+1)
LPT214,	RDF		/DATA FIELD STILL HAS CALLING FIELD
	TAD LPTCIF	/ADD CDF CIF
	DCA LPTXIT	/SAVE FOR EXIT
	TAD I LPT	/ARG1 AGAIN
	AND (70		/MASK DATA FIELD OF LPT BUFFER
	TAD (CDF	/GET CDF
	DCA LPTCDF	/SAVE BUFFER FIELD
	ISZ LPT
	TAD I LPT	/GET ARG2
	DCA LPTCA	/SAVE BUFFER ADDRESS
	ISZ LPT
	TAD I LPT	/GET BLOCK NUMBER
	ISZ LPT		/BUMP POINTER TO ERROR RETURN
LPTCDF, HLT		/NOT HALT BUT SETS UP BUFFER DATA FEILD
	SNL CLA		/TEST ATTEMPT TO INPUT FROM PRINTER
	JMP LPTERR	/TAKE ERROR EXIT IF SO
	JMP LPTELP	/ENTER AC=0 & INIT LINE WIDTH
LPTLP,	STL		/SETUP LINK FLAG FOR THIRD CHAR
LPROTL, RTL		/LINK BIT IS IN 4000 BIT FOR THIRD
	RTL
	SPA		/TEST THIRD CHAR
	JMP LPTELP	/PRINT THIRD CHAR
	DCA LPTCDF	/NOT THIRD SAVE TEMPORARY
	TAD I LPTCA	/GET BUFFER
	JMS LPTPCH	/PRINT THIS CHARECTER
	TAD I LPTCA	/GET BUFFER
	ISZ LPTCA	/BUMP BUFFER POINTER
LP7400, 7400		/NO OPP
	AND LP7400	/MASK HALF OF THIRD CHAR
	CLL RAL		/USE FOUR BITS OF IT
	TAD LPTCDF	/GET OTHER PART OF IT
	JMP LPROTL	/GO TEST FOR THIRD & PRINT CHAR
LPTELP, JMS LPTPCH	/PRINT THIRD CHAR
	ISZ LPTWC	/TEST FOR END FILE
	JMP LPTLP	/GO SETUP UNPACK
	ISZ LPT		/SKIP ERROR EXIT
LPTXIT, HLT		/CONTAINS CDF CIF
	JMP I LPT	/NORMAL EXIT
LPTERR, CLA STL RAR	/ERROR EXIT
	JMP LPTXIT
LPTWC,	0
LPTCA,	0
/
LPTPCH, 0		/TEST THEN PRINT
	AND (177	/MASK TO 6 BIT
	TAD (-175
	SMA
	JMP LPFLSH	/IGNORE 175 TO 177
	TAD (175-32
	SNA		/TEST CNTRL/Z
	JMP LPTXIT-1	/CNTRL/Z IS END OF FILE PRINT FF & EXIT
	TAD (32-11
	SNA		/TEST TAB
	JMP LPTTAB	/TAKE CARE OF TAB
	TAD (11
LPSPAC, SZA		/IGNORE ZEROES
	JMS LPCHAR	/CHAR PASSES TESTS PRINT IT
	TAD LPLPTR	/TEST CURRENT POSITION
	SMA		/IF DONE RE INIT TO WIDTH
LPTFUL, TAD LPWDTH
	DCA LPLPTR
LPFLSH, SMA CLA		/DOESN T SKIP JUST CLEARS
LP7700=LPFLSH
	JMP I LPTPCH	/ZEROES 175 TO 177
LPCHAR,	0		/BASIC PRINT ROUTINE
	TAD (-14
	SNA
	JMP FORM
	TAD LPT214
	LLS
	TAD (-6200
	AND (7770	/PREPARE FOR FEED TEST
	TAD (7770
	SNA		/TEST FOR CR, LF, FF, VT, ETC
	DCA LPLPTR	/RESET WIDTH	TO BE FIXED .-14
	SNA CLA
	ISZ LNCTR
LPCTCL, KRS		/TEST CNTRL/C
	TAD (-203
	SZA CLA
	JMP .+3
LPTCIF, CIF CDF 0
	JMP I LP7600	/RETURN TO MONITOR
	LSF		/TEST PRINTER FLAG
	JMP LPCTCL	/WAIT LOOP IN CNTRL/C TEST
	ISZ LPLPTR	/LPT READY
	JMP I LPCHAR
	JMP LPTFUL	/RESET WIDTH CARRY ON PRINTING
LPTTAB, TAD LPSPAC	/SIMULATE TABS
	JMS LPCHAR	/PRINT SPACE
	TAD LPWDTH
	CMA
	TAD LPLPTR	/HOW FAR TO NEXT TAB STOP?
	AND (7
	SZA CLA
	JMP LPTTAB	/SEND SPACES TIL DONE
	JMP I LPTPCH	/DONE
/
FORM,	TAD LF		/GET LINE FEED
	LLS
	LSF
	JMP .-1
LP7600,	7600		/CLEAR & CONSTANT
	ISZ LNCTR	/DONE YET?
	JMP FORM	/NOT D0NE YET
	TAD LPWDTH	/2 X (-PAGE LENGTH) -1	= -205
	DCA LNCTR
	JMP LPCTCL
LNCTR,	7573
LF,	212		/LINE FEED
$
