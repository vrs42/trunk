/   SI-DISK NON-"SYS" FOR OS/8 VER 3.0
/   PARAMETERIZABLE FOR BOTH THE BIG AND SMALL DISCS
/      ALSO FOR EITHER DEVICE-CODE 50 (STANDARD SI-ISSUE) OR 60


/   THERE ARE EIGHT CO-RESIDENT DRIVERS
BIGDSK=1
DSKDEV=600


/   DSKDEV SHOULD BE EITHER 500 OR 600
IFNDEF DSKDEV <DSKDEV=500>	/ DEFAULT DEVICE-CODE
IFNDEF BIGDSK <BIGDSK=0>	/ DEFAULT IS SMALL DISK

/   FIRST WE START WITH A TABLE OF SI-OPCODES

	DSDD=6001+DSKDEV
	DLCR=6002+DSKDEV
	DCSR=6004+DSKDEV
	DRSR=6005+DSKDEV
	DSDE=6011+DSKDEV
	DLSR=6012+DSKDEV
	DSRR=6013+DSKDEV
	DLTR=6014+DSKDEV
	DLTW=6015+DSKDEV
	DWCA=6017+DSKDEV
EJECT
/   NOW, WE NEED A HEADER BLOCK FOR "BUILD"

*0
	-10		/ EIGHT ENTRY-POINTS IN THIS DRIVER
/   FIRST, WE SET UP FOR A MODEL 30 WITH DEVICE CODE = 50

IFZERO DSKDEV-500 <
	IFZERO BIGDSK <
		DEVICE SN35 ; DEVICE DSK0 ; 4230 ; D0-200 ; ZBLOCK 2
		DEVICE SN35 ; DEVICE DSK1 ; 4230 ; D1-200 ; ZBLOCK 2
		DEVICE SN35 ; DEVICE DSK2 ; 4230 ; D2-200 ; ZBLOCK 2
		DEVICE SN35 ; DEVICE DSK3 ; 4230 ; D3-200 ; ZBLOCK 2
		EJECT
		DEVICE SN35 ; DEVICE DSK4 ; 4230 ; D4-200 ; ZBLOCK 2
		DEVICE SN35 ; DEVICE DSK5 ; 4230 ; D5-200 ; ZBLOCK 2
		DEVICE SN35 ; DEVICE DSK6 ; 4230 ; D6-200 ; ZBLOCK 2
		DEVICE SN35 ; DEVICE DSK7 ; 4230 ; D7-200 ; ZBLOCK 2
		EJECT
	>

/   NOW, A SET FOR THE MODEL 40 ON DEVICE-CODE 50

	IFNZRO BIGDSK <
		DEVICE SN45 ; DEVICE DSK0 ; 4230 ; D0-200 ; ZBLOCK 2
		DEVICE SN45 ; DEVICE DSK1 ; 4230 ; D1-200 ; ZBLOCK 2
		DEVICE SN45 ; DEVICE DSK2 ; 4230 ; D2-200 ; ZBLOCK 2
		DEVICE SN45 ; DEVICE DSK3 ; 4230 ; D3-200 ; ZBLOCK 2
		EJECT
		EJECT
		DEVICE SN45 ; DEVICE DSK4 ; 4230 ; D4-200 ; ZBLOCK 2
		DEVICE SN45 ; DEVICE DSK5 ; 4230 ; D5-200 ; ZBLOCK 2
		DEVICE SN45 ; DEVICE DSK6 ; 4230 ; D6-200 ; ZBLOCK 2
		DEVICE SN45 ; DEVICE DSK7 ; 4230 ; D7-200 ; ZBLOCK 2
	>
>

/   NOW, ONE FOR THE MODEL 30 ON DEVICE CODE 60
/   HOWEVER, NONE IS CURRENTLY NEEDED
IFZERO DSKDEV-600 <
	IFZERO BIGDSK <DERR,BARF>


/   NOW ONE FOR THE MODEL 40 ON DEVICE-CODE 60

	IFNZRO BIGDSK <
		DEVICE SN46 ; DEVICE DSK0 ; 4230 ; D0-200 ; ZBLOCK 2
		DEVICE SN46 ; DEVICE DSK1 ; 4230 ; D1-200 ; ZBLOCK 2
		DEVICE SN46 ; DEVICE DSK2 ; 4230 ; D2-200 ; ZBLOCK 2
		DEVICE SN46 ; DEVICE DSK3 ; 4230 ; D3-200 ; ZBLOCK 2
		EJECT
		DEVICE SN46 ; DEVICE DSK4 ; 4230 ; D4-200 ; ZBLOCK 2
		DEVICE SN46 ; DEVICE DSK5 ; 4230 ; D5-200 ; ZBLOCK 2
		DEVICE SN46 ; DEVICE DSK6 ; 4230 ; D6-200 ; ZBLOCK 2
		DEVICE SN46 ; DEVICE DSK7 ; 4230 ; D7-200 ; ZBLOCK 2
	>
>
/   THIS IS NOT THE ENTRY-CHAIN (SEE BELOW)

*200
DKDRLP,	DLCR		/ BREAK-FIELD FOR "DWCA" (ZERO)
	TAD (WDCNT
	DWCA		/ AC = 7XXX
	AND ARG1	/ LOAD FIELD-BITS (AMONG OTHERS)
	AND (7000	/ KILL THE "OTHERS"
	DLCR		/ SET BUFFER-FILED
	CLL CLA
	TAD ARG3
	AND (17
	DLSR		/ SECTOR-ADDRESS
	CIA
	TAD ARG3	/ JUST TRACK-BITS
	CLL RTR
	RTR
TOFF,	HLT		/ ADD IN OFFSET FROM TABLE
DKINST,	HLT		/ EITHER A READ OR A WRITE
	DSDD		/ HAS THE OPERATION FINISHED?
	JMP .-1		/ NO, KEEP THE PATIENT UNDER ANESTHESIA
			/ WAS THAT AN AETHERIAL REMARK
	CLL CLA
	DSDE		/ WAS THERE AN ERROR
	JMP DKXIT	/ NO
	ISZ ERRCNT
	JMP DKDRLP	/ TRY AGAIN?
	CLL CML
	SKP		/ AVIOD NORMAL-EXIT FIXER

DKXIT,	ISZ PNT
	TAD (ISZ DSKNO
DKRISZ,	HLT		/ RE-STORE "ISZ"
	DCA DSKNO	/ RE-CLEAR UNIT NUMBER
DKCDF,	HLT		/ RESET TO CALLER'S FIELDS
	RAR		/ PASS BACK ERROR-FLAG
	JMP I PNT	/ RETURN TO SENDER
EJECT
/   TRACK-OFFSET TABLE
TABL,	0		/ "DSK0"
	314		/ "DSK1"
IFNZRO BIGDSK <
	630		/ "DSK2"
	1144		/ "DSK3"
	2000		/ "DSK4"
	2314		/ "DSK5"
	2630		/ "DSK6"
	3144		/ "DSK7"
>

IFZERO BIGDSK <
	2000		/ "DSK2"
	2314		/ "DSK3"
	4000		/ "DSK4"
	4314		/ "DSK5"
	6000		/ "DSK6"
	6314		/ "DSK7"
>
EJECT
/   THIS IS THE REAL ENTRY-CHAIN

D0,	0
D1,	ISZ DSKNO
D2,	ISZ DSKNO
D3,	ISZ DSKNO
D4,	ISZ DSKNO
D5,	ISZ DSKNO
D6,	ISZ DSKNO
D7,	ISZ DSKNO


M7600,	7600
	TAD DSKNO
	CIA
	TAD (TAD D7
	DCA DKFTCH	/ GENERATE ENTRY-FETCHER
	TAD DKFTCH
	TAD (TABL-D0
	DCA TOFF	/ GENERATE TRACK-OFFSET FETCHER
	CLL CLA CML RTR	/ 2000
	TAD DKFTCH
	DCA DKRISZ	/ ISZ RESTORER
	RDF
	TAD (CDF CIF 0
	DCA DKCDF	/ CALLER-FIELD RESTORER
EJECT
DKFTCH,DSKNO,ARG1,	0	/ GET ACTUALL CALLER-ADDRESS
	DCA PNT		/ PUT IN A CANNONICAL PLACE
	TAD I PNT
	DCA ARG1
	ISZ PNT
	TAD I PNT
	DCA ARG2
	ISZ PNT
	TAD I PNT
	DCA ARG3	/ GET ARGS
	ISZ PNT
	CDF 0		/ DRIVER NEEDS DATA-FILED = 0
	TAD ARG1
	RAL
	AND M7600
	DCA I (WDCNT	/ FORM X-FER WORD-COUNT
	RAL
	TAD (DLTR
	DCA DKINST	/ FORM EITHER A READ OR A WRITE INSTRUCTION
	TAD ARG1
	BSW
	DCA ARG1	/ PUT BUFFER-FIELD IN RIGHT-PLACE
	TAD ARG2
	DCA I (CORADR	/ SET BUFFER-ADDRESS
/   NOTE:  SI-HARDWARE LEAVES -WC- AND -CA- ALONE
/   NOTE (ALSO):  THE CANNONICAL USE OF 7750 AND 7751 FOR -WC- AND -CA-
	TAD (WDCNT	/ 7750
	DCA ERRCNT
	JMP DKDRLP	/ GO DO REAL WORK
EJECT
ARG2,	0
ARG3,	0
ERRCNT,	0
PNT,	0

	WDCNT=7750
	CORADR=7751




$
