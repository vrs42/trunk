	DCA Q
	TAD (57
	DCA TENCNT	/TENS INITAILLY=0
	TAD Q		/GET THE DIGITS
DECMOR,	ISZ TENCNT
	TAD (-12
	SMA
	JMP DECMOR	/COUNT TENS
	TAD (72		/60+12
	DCA Q
	TAD P1		/SPLIT ACROSS WORDS?
