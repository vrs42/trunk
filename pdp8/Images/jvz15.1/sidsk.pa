/OS/8 SYSTEM HANDLER FOR DIABLO DISK
/WITH SYSTEMS INDUSTRIES MODEL 3010 CONTROLLER
/
	VERSION=1
	DCB=4430	/DEVICE CONTROL WORD
	DECIMAL; DSKLEN=3248; OCTAL
/
	*0
	-3		/THREE HANDLERS
	DEVICE DIA	/GROUP NAME
	DEVICE SYS	/PERMANENT NAME
	DCB
	DISK-200+2000	/ENTRY OFFSET
	0		/ALWAYS ZERO
	DSKLEN		/DEVICE LENGTH
/
	DEVICE DIA
	DEVICE RKA0
	DCB
	DISK-200+1000	/ENTRY SAME AS SYS
	0
	DSKLEN		/DEVICE LENGTH
/
	DEVICE DIA
	DEVICE RKB0
	DCB
	DISK2-200+1000
	0
	DSKLEN
/
	BOOTS-RESTRT-1		/BOOTSTRAP LENGTH
/
DCODE=50		/DEVICE CODE OF CONTROLLER
/
DSDD=10^DCODE+6001	/SKIP ON DISK DONE
DLCR=10^DCODE+6002	/LOAD CONTROL REGISTER
DCSR=10^DCODE+6004	/CLEAR STATUS REGISTER
DRSR=10^DCODE+6005	/READ STATUS REGISTER
DSDE=10^DCODE+6011	/SKIP ON DISK ERROR
DLSR=10^DCODE+6012	/LOAD SECTOR REGISTER
DSRR=10^DCODE+6013	/READ SECTOR REGISTER
DLTR=10^DCODE+6014	/LOAD TRACK REGISTER
DWCA=10^DCODE+6017	/INITIATE WC & CA
/
/	THE TOGGLE IN BOOTSTRAP
/
/	0000 6502	DLCR		/SET INTERFACE FIELD = 0
/	0001 0000			/CURRENT ADDRESS
/	0002 6517	DWCA		/LOAD WC PTR
/	0003 6512	DLSR		/LOAD SECTOR ZERO
/	0004 6514	DLTR		/TRACK ZERO READ
/	0005 5005	JMP .		/WAIT HERE FOR OVERLAY
/
/
/BLOCK ZERO BOOTSTRAP
/
	RELOC 0		/RELOCATE TO RUN AT LOCATION 0
/
BOOTS,	ZBLOCK 4	/OVERLAYS THE TOGGLE TO SELF START
	DSDD		/WAIT FOR THE DISK
	JMP .-1
	DSDE		/CHECK FOR ERRORS
	JMP BOOT	/GO RESTORE THE MONITOR
	DRSR		/QUIT NOW WITH STATUS IN AC
	JMP .-1
/
SOURC0,	177		/AUTO INDEX POINTERS
DEST0,	7577
SOURC1,	46
DEST1,	7646
/
BOOT,	TAD I SOURC0	/REFRESH THE OS/8 RESIDENT CODE
	DCA I DEST0	/STOW THE CODE IN 07600 & UP
	TAD I SOURC1	/GET THE FIELD 1 RESIDENT
	CDF 10
	DCA I DEST1	/STOW IT
	CDF 0
	TAD DEST0
	SZA CLA		/DONE YET ?
	JMP BOOT	/KEEP MOVING
	JMP I RESTRT	/GO TRY THE NEW MONITOR
RESTRT,	7605
/
	RELOC		/BACK TO NORMAL ADDRESSING
/
/
/	MODIFY PIP.SV
/
/	13643/ 0000 1520
/
/
/NOW THE ACTUAL HANDLER ROUTINE
/
	*200
/
	ZBLOCK 7	/LEAVE ROOM FOR OS/8 CALL
DISK,	VERSION		/ENTRY POINT
	CLL CLA
	DCA OFFSET	/CLEAR TRACK OFFSET
	TAD I DISK
	DCA FUNC	/STOW FUNCTION WORD
	ISZ DISK
	TAD I DISK	/GET DATA BUFER ADDRESS
	DCA CA
	ISZ DISK
	TAD I DISK
	DCA BLKNO	/GET DISK BLOCK NUMBER
	ISZ DISK	/PARTIALLY FIX EXIT
	RDF		/THE DATA FIELD IS THE RETURN FIELD
	TAD CDFCIF	/FORM A CDF CIF RETURN FIELD
	DCA RFIELD	/SET UP FIELD FOR EXIT
	TAD FUNC	/GET THE FUNCTION WORD
	AND M3700	/USE ONLY 5 BITS
	SNA
	JMP EXIT	/TAKE NORMAL EXIT ON ZERO WORD COUNT
	CLL RAL		/CONVERT PAGE COUNT TO WORD COUNT
	DCA WC
	TAD KM20	/RETRY ERRORS 16 TIMES
	DCA ERRCNT	/INITIALIZE RETRY COUNTER
RETRY,	DLCR		/CONTROLLER FIELD = CURRENT
	DCSR		/CLEAR STATUS REGISTER
	JMS .+1		/FIND OUT WHERE WE ARE
LOC,	0
	TAD LOC		/GET THAT LOCATION
	TAD DIFF	/DIFF=WC-LOC
	DWCA		/TELL INTERFACE WHERE TO FIND WC & CA
	CLA CLL
	TAD LTRACK	/FORM A LOAD TRACK & READ COMMAND
	DCA RWINST	/SET UP ACTUAL I/O READ
	TAD FUNC	/GET THE FUNCTION WORD
	SPA		/TEST THE R/W BIT
	ISZ RWINST	/INCREMENT TO FORM A WRITE INSTRUCTION
	BSW		/GET THE BUFFER FIELD
	AND M7000	/USE ONLY THREE BITS
	DLCR		/LOAD DATA BUFFER FIELD
	TAD BLKNO	/GET THE BLOCK NUMBER
	AND M17		/MASK THE SECTOR BITS
	DLSR		/LOAD SECTOR ADDRESS REGISTER
	CLL CLA
	TAD BLKNO	/GET THE BLOCK NUMBER
	RTR; RTR	/USE THE TRACK BITS
	AND M377	/DEVELOP TRACK ADDRESS
	TAD OFFSET	/ADD OFFSET FOR SECOND LOGICAL DEVICE
RWINST,	DLTR		/LOAD TRACK AND READ OR WRITE GOES HERE
	CLL CLA		/ROUTINE TO WAIT FOR THE DISK
	DSDD		/SKIP ON DISK DONE
	JMP .-1		/WAIT FOR OPERATION TO FINISH
	DSDE		/WAS THERE AN ERROR?
	JMP EXIT	/NO, GO EXIT
	ISZ ERRCNT	/BUMP ERROR COUNTER
	JMP RETRY	/RETRY UNTIL COUNT EXPIRES
	CLL CML		/SET LINK FOR ERROR RETURN
	SKP
EXIT,	ISZ DISK	/BUMP EXIT ADDRESS TO TAKE NORMAL EXIT
	CLA RAR		/SET AC NON-ZERO IF ERROR
RFIELD,	HLT		/RESET FIELDS TO THOSE OF CALLER
	JMP I DISK	/EXIT
/
/ENTRY FOR THE SECOND HALF OF THE DISK
/
DISK2,	VERSION		/SECOND ENTRY POINT
	CLL CLA
	TAD DISK2	/GET RETURN ADDRESS
	DCA DISK	/SET UP FAKE JMS DISK
	TAD KOFSET	/SET SECOND LOGICAL UNIT OFFSET
	JMP DISK+2	/GO ENTER NORMAL DISK
/
BLKNO,	0		/BLOCK NUMBER
CDFCIF,	CDF CIF
WC,	0		/WORD COUNT
CA,	0		/CURRENT ADDRESS
DIFF,	WC-LOC
ERRCNT,	0		/NUMBER OF ERROR RETRYS LEFT
FUNC,	0		/FUNCTION WORD
KOFSET,	314		/TRACK OFFSET FOR SECOND DEVICE
KM20,	-20		/RETRY ERRORS 16 TIMES
LTRACK,	DLTR		/A LOAD TRACK & READ COMMAND
M17,	17
M377,	377
M3700,	3700
M7000,	7000
OFFSET,	0		/OFSET FOR SECOND LOGICAL DEVICE
	$$$
