/LQP HANDLER FOR A DIABLO PRINTER
/
/	LETTER QUALITY PRINTER
/
/MODIFIED TO SUPPORT FRACTIONAL JUSTIFICATION
/MODIFIED TO SUPPORT ELASTIC LINE FEEDS		JULY 21/77
/CHARACTERS LESS THAN 200 ARE TREATED AS SPACE ARGUMENTS
/BIT 5 IS THE Y-AXIS BIT
/BITS 6-11 CONTAIN THE MOVE MAGNITUDE IN EXCESS 40 FORMAT
/THE HORIZONTAL RESOLUTION IS 1/60 OF AN INCH
/THE VERTICAL RESOLUTION IS 1/48 OF AN INCH
/PIP FORCES THE PARITY BIT FOR ASCII TRANSFERS
/SO NORMAL OPERATION IS NOT AFFECTED
/IF THE FILE STARTS WITH A CNTRL/Z THE SECOND WORD OF THE FILE
/WILL BE TAKEN AS THE CHARACTER PITCH
/THE FILE WILL THEN START WITH THE THIRD WORD
/FRACTIONAL JUSTIFICATION FILES SHOULD BE TRANSFERED IMAGE MODE
/
/THE PRINTING WILL PAUSE FOR ANY KEYSTROKE AFTER A FORM FEED
/IF THE SWITCH REGISTER IS NON-ZERO
/
/	MODIFIED JANUARY 19 1978 J.Y.
/	TO SETUP PAGE LINKS ON EVERY ENTRY
/	BECAUSE FOTP.SV CALLS THE USR TO "CLOSE" ALL 
/	OUTPUT FILES (EVEN ON NON FILE STRUCTURED DEVICES).
/	IT WILL THUS CALL THIS HANDLER WITH NONZERO BLOCK
/	NUMBERS FOR THE FIRST TIME.
/
/	MODIFIED MARCH 27 1979 J.Y.
/	TO OPTIMIZE THE CARRIAGE RETURN AND FORM FEED ROUTINES.
/	CR'S ARE NOW ABSORBED LIKE TABS SO UNECESSARY RETURNS
/	TO LEFT MARGIN HAVE BEEN ELIMINATED.
/
	*0
	-1		/1 DEVICE HANDLER
	DEVICE DIAB	/GROUP NAME
	DEVICE LQP	/PERMANENT DEVICE NAME
	1040		/"DCB" DEVICE CONTROL BLOCK
	LPT-200+4000	/ENTRY OFFSET +2PG BIT
	0000		/ALWAYS ZEROES
	0000
/
	DECIMAL;PAGEL=66	/LINES PER PAGE
	PITCH=10 ;OCTAL		/10 CHARACTERS PER INCH
	LDEVC=66		/PRINTER DEVICE CODE
	PDEVC=15		/PLOTTER DEVICE CODE
	LSF=LDEVC^10+6001	/LINEPRINTER SKIP ON FLAG
	LCF=LDEVC^10+6002	/CLEAR FLAG
	LLS=LDEVC^10+6006	/LOAD & PRINT
	PLX=PDEVC^10+6001	/MOVE X INCREMENTS
	PLY=PDEVC^10+6002	/MOVE Y INCREMENTS
	PLC=PDEVC^10+6004	/PLOT A CHARACTER
	RESTORE=PDEVC+1^10+6004	/RESTORE DIABLO TO LEFT MARGIN
/
	*200
/
LPT,	0004		/ENTRY POINT & VERSION NUMBER
	CLA STL RAR	/SET AC BIT 0
	TAD I LPT	/GET ARG1, R/W BIT INTO LINK
M377,	AND (3700	/GET WORD COUNT
	CMA
	DCA WC		/SAVE -(WC+1)
	RDF		/DATA FIELD STILL HAS CALLING FIELD
	TAD CIFCDF	/ADD CDF CIF
	DCA EXIT	/SAVE FOR EXIT
	TAD I LPT	/ARG1 AGAIN
	AND (70		/MASK DATA FIELD OF LPT BUFFER
	TAD CCDF	/GET CDF
	DCA SETFLD	/SAVE BUFFER FIELD
	TAD SETFLD	/GET THE BUFFER FIELD
	DCA SETF	/TO GET FIRST FILE WORD
	ISZ LPT
	TAD I LPT	/GET ARG2
	DCA CA		/SAVE BUFFER ADDRESS
	ISZ LPT		/BUMP TO BLOCK NUMBER
	TAD I LPT	/GET BLOCK NUMBER
	DCA WAIT	/SAVE THE BLOCK NUMBER FOR LATER
	ISZ LPT		/BUMP POINTER TO ERROR RETURN
	JMS LOC		/FIND OUT WHERE WE ARE
LOC,	0		/SAVE IT HERE
	TAD LOC		/GET THE LOCATION
	AND (7600	/FORM PAGE NUMBER
	TAD (200	/BUMP TO BEGINNING OF NEXT PAGE
	DCA LINK	/SAVE LINK TO NEXT PAGE
	TAD LINK
	TAD EXITP	/FORM POINTER FOR EOF EXIT
	CDF 0		/TO HANDLER FIELD
	DCA I LINK	/STOW IT START OF NEXT PAGE
	TAD LINK	/ADD PAGE NUMBER
	TAD WAITP	/GET PAGE ADDRESS OF FLAG WAIT ROUTINE
	ISZ LINK	/BUMP POINTER
	DCA I LINK	/STOW IN NEXT PAGE
	TAD KWAITP	/PAGE ADDRESS OF KWAIT ROUTINE
	TAD LINK
	ISZ LINK	/BUMP POINTER TO KWAIT POINTER
	DCA I LINK	/STOW POINTER IN NEXT PAGE
	ISZ LINK	/BUMP POINTER TO PITCH WORD
	TAD WAIT	/GET THE BLOCK NUMBER
	SZA CLA		/BLOCK IN AC=0?
	JMP NORM	/NO DON'T RESTORE THIS TIME
	LCF		/CLEAR FLAG FIRST
	RESTORE		/YES, IF FIRST CALL RESTORE DIABLO
SETF,	0		/CHANGE TO BUFFER FIELD
	TAD I CA	/GET THE FIRST WORD OF THE FILE
	TAD (-232	/SUBTRACT - CNTRL/Z
	SZA CLA		/DOES THE FILE START WITH A EOF CHAR ?
	JMP NORM	/NO IT IS A NORMAL FILE
	ISZ CA		/BUMP ADDRESS
	TAD I CA	/GET THE PITCH WORD
CCDF,	CDF 0
	DCA I LINK	/STOW PITCH IN THE NEXT PAGE
	ISZ CA		/SKIP THE WIDTH WORD
	ISZ WC		/WE USED TWO WORDS BUMP THE WC
NORM,	ISZ LINK	/BUMP POINTER TO PRINT ROUTINE
SETFLD, 0		/SET UP BUFFER DATA FIELD
	JMP THIRD	/ENTER AC=0 & INIT LINE WIDTH
UNPAC,	STL		/SETUP LINK FLAG FOR THIRD CHAR
ROTL,	RTL		/LINK BIT IS IN 4000 BIT FOR THIRD
	RTL
	SPA		/TEST THIRD CHAR
	JMP THIRD	/PRINT THIRD CHAR
	DCA SETFLD	/NOT THIRD SAVE TEMPORARY
	TAD I CA	/GET BUFFER
	JMS PRINTC	/PRINT THIS CHARACTER
	TAD I CA	/GET WORD FROM BUFFER
	ISZ CA		/BUMP BUFFER POINTER
M7400,	7400		/NO OPP
	AND M7400	/MASK HALF OF THIRD CHAR
	CLL RAL		/USE FOUR BITS OF IT
	TAD SETFLD	/GET OTHER PART OF IT
	JMP ROTL	/GO TEST FOR THIRD & PRINT CHAR
THIRD,	JMS PRINTC	/PRINT THIRD CHAR
	ISZ WC		/TEST FOR END FILE
	JMP UNPAC	/GO SETUP UNPACK
	ISZ LPT		/SKIP ERROR EXIT
EXIT,	0		/CONTAINS CDF CIF
	JMP I LPT	/NORMAL EXIT
/
WAIT,	0		/WAIT FOR THE FLAG
	DCA LOC		/SAVE THE AC
TEST,	KRS		/READ STATIC
	AND (177	/DROP PARITY
	TAD (-3		/TEST CNTRL C
	SNA CLA
	KSF		/EXIT IF CNTRL/C AND KYBD FLAG UP
	JMP .+3		/NO FLAG WAIT FOR THE PRINTER
CIFCDF,	CIF CDF 0	/OS/8 FIELD
	JMP I (7600	/BACK TO OS/8
	LSF
	JMP TEST	/TRY AGAIN
	LCF		/CLEAR IT FOR NEXT TIME
	TAD LOC		/RESTORE THE AC
	JMP I WAIT
/
KWAIT,	0		/WAIT FOR A KEYSTROKE ON EITHER KYBD
	LAS		/ANY SWITCH MEANS WAIT
	SNA CLA		/SKIP IF SET
	JMP I KWAIT	/DON'T WAIT CARRY ON
	KCC		/CLEAR KYBD FLAG & AC
	KSF		/ANY KEY WILL DO
	JMP .-1		/WAIT FOR ANY KEYSTOKE
	JMP I KWAIT	/EXIT
/
PRINTC,	0		/TEST THEN PRINT
	AND M377	/MASK OUT THE EXTRA STUFF
	SZA		/IGNORE NULLS
	TAD (-377	/TEST RUBOUT
	SNA
	JMP I PRINTC	/PURGE NULLS, RUBOUTS
	JMS I LINK	/GO TEST AND PRINT
	JMP I PRINTC	/EXIT
/
CA,	0
WC,	0
LINK,	PRINT		/LINK TO THE NEXT PAGE
EXITP,	177&EXIT-1+7600
KWAITP,	177&KWAIT-1+7600
WAITP,	177&WAIT+7600
/
	PAGE
/
EXITT,	0		/POINTER TO EOF EXIT
WAITT,	0		/POINTER TO FLAG WAIT ROUTINE
KWAITT,	0		/POINTER TO OPTION TEST & WAIT ROUTINE
	DECIMAL
CWIDTH,	60%PITCH ;OCTAL	/CHARACTER PITCH
/
PRINT,	0		/TEST THEN PRINT
	TAD (377-200	/CHECK FOR <200
	SMA		/<200 IS SPACE INCREMENT
	JMP CHR		/IT MUST BE A NORMAL CHARACTER
	CLL		/ASSURE CLEAR
	TAD (100	/BUMP Y BIT TO THE LINK
	AND (77		/EXTRACT THE ACTUAL ARG
	SZL		/SKIP IF X ARG
	JMP YAXIS	/GO HANDLE A Y-ARG
	TAD (-40	/EXCESS 40 TO TWOS COMP CONVERSION
	SKP		/SKIP ENTRY FOR SPACE
SP,	TAD CWIDTH	/GET STANDARD SPACE INCREMENT
	TAD XMOVE	/UPDATE MOVE MAGNITUDE FOR LATER
	DCA XMOVE
	JMP COUNT	/EXIT NOW
/
CHR,	TAD (200-212	/TEST FOR LINE FEED
	SNA
	JMP LF
	IAC		/TEST TAB
	SNA
	JMP TAB		/GO HANDLE TAB
	TAD (211-215	/TEST FOR CARRIAGE RETURN
	SNA
	JMP CR
	IAC		/TEST FOR FORM FEED
	SNA
	JMP FORM	/GO HANDLE FORM FEED
	TAD (214-232	/TEST CNTRL/Z END OF FILE
	SNA
	JMP I EXITT	/EXIT TO PREVIOUS PAGE
	TAD (232-240	/TEST FOR REGULAR SPACE
	SNA
	JMP SP		/GO UPDATE XMOVE IF SPACE
	SPA		/SKIP IF OKAY
	JMP EXCLA	/PURGE ANY OTHER CNTRL CODES
	TAD (240	/RESTORE THE CHAR
	DCA TEMP	/SAVE FOR LATER
	TAD CWIDTH	/GET STANDARD CHAR WIDTH
	JMS MOVE	/GO HANDLE THE MOVES
	TAD TEMP	/GET THE CHAR
	PLC		/PLOT IT
COUNT,	ISZ XCOUNT	/CHAR COUNT FOR TAB CALCULATION
	JMP EXCLA	/CLEAR & EXIT
/
/	GENERAL PURPOSE MOVE ROUTINE
/	THIS ROUTINE IS CALLED ONLY IN RESPONSE TO A PRINTING
/	CHARACTER OR FORM FEED. THIS COMPRESSES ALL MOVES UNTIL
/	THEY ARE ABSOLUTELY NECESSARY.
/
MOVE,	0		/GENERAL MOVE ROUTINE
	TAD XMOVE	/ADD ANY PREVIOUS SPACES
	JMS I WAITT	/WAIT FOR PRINTER
	JMS SGNFIX	/CONVERT TO SIGN MAGNITUDE
	PLX		/MOVE X INCREMENTS
	CLA		/CLEAR THE STRANGE FORMAT
	TAD MAGN	/GET THE REAL MAGNITUDE
	TAD XPOS	/UPDATE THE CURRENT X POSITION
	DCA XPOS
	DCA XMOVE	/ZERO, MOVE INITIATED
	TAD YMOVE	/GET THE Y MOVE ARG
	JMS SGNFIX	/CONVERT TO SIGN MAGNITUDE
	PLY		/INITIATE THE MOVE
	CLA
	TAD MAGN	/GET THE REAL MAGNITUDE
	CIA		/SUBTRACT IT FROM THE PAGE LENGTH
	TAD YPOS
	DCA YPOS	/STORE THE NEW POSITION
	DCA YMOVE	/ZERO, MOVE INITIATED
	JMP I MOVE	/RETURN
/
TAB,	TAD CWIDTH	/GET STANDARD CHAR WIDTH
	TAD XMOVE	/ACCUMULATE FOR LATER
	DCA XMOVE
	ISZ XCOUNT	/COUNT A SPACE
	TAD XCOUNT	/GET THE CURRENT CHAR POSITION
	CIA
	AND (7		/MASK DISTANCE TO TAB STOP
	SNA CLA		/TEST ARRIVAL AT NEXT TAB STOP
	JMP I PRINT	/EXIT DONE
	JMP TAB		/CONTINUE
/
CR,	TAD XPOS	/GET THE CURRENT POSITION
	CIA		/BACKUP THAT AMOUNT
	DCA XMOVE	/PURGE ANY INCOMPLETE MOVES
	DCA XCOUNT	/ZERO CHARACTER COUNT
EXCLA,	CLA		/CLEAR AC, ALSO CONSTANT
	JMP I PRINT
/
LF,	TAD (40+10	/STANDARD SPACE + 40
YAXIS,	TAD (-40	/EXCESS 40 TO TWOS COMP
	TAD YMOVE	/UPDATE Y MOVEMENT
	DCA YMOVE
	JMP EXCLA	/CLEAR & EXIT
/
FORM,	TAD YPOS	/GET PAGE LENGTH LEFT
	DCA YMOVE	/SETUP A MOVE OF THAT LENGTH
	JMS MOVE	/GO DO IT
	JMS I WAITT	/FINISH ANY PREVIOUS ACTION
	RESTORE		/RESTORE TO LEFT MARGIN
	JMS I KWAITT	/GO WAIT FOR A KEY STROKE
	TAD LINES	/GET NEW PAGE LENGTH
	DCA YPOS
	DCA YMOVE	/MOVE COMPLETE ZERO IT
	JMP EXCLA
/
SGNFIX,	0		/CONVERT TO SIGN MAGNITUDE FORMAT
	DCA MAGN	/SAVE THE ARGUMENT
	TAD MAGN
	SNA		/TEST FOR ZERO
	ISZ SGNFIX	/SKIP PLOT IF ZERO
	SMA		/LEAVE POSITIVE ALONE
	JMP I SGNFIX	/EXIT
	CIA RAL		/SIGN TO THE LINK
	STL RAR		/SET IT
	JMP I SGNFIX	/EXIT
/
DECIMAL
LINES,	PAGEL^8
MAGN,	0
␀TEMP,	0
XCOUNT, 0
XMOVE,	0
XPOS,	0
YPOS,	PAGEL^8
YMOVE,	0
	$$
