/   SI-DISK "SYS" FOR OS/8 VER. 3.0
/   PARAMETERIZABLE FOR BOTH THE BIG AND SMALL DISK
/      ALSO FOR EITHER DEVICE-CODE 50 (STANDARD SI-ISSUE) OR 60

/   THERE ARE FOUR CO-RESIDENT DRIVERS
/      "SYS" IS THE SAME AS "DSK0"



/   DSKDEV SHOULD BE EITHER 500 OR 600
IFNDEF DSKDEV <DSKDEV=600>	/DEFAULT DEVICE CODE
IFNDEF BIGDSK <BIGDSK=1>	/ DEFAULT IS SMALL DISC

/   FIRST WE START WITH THE SI-DISK OP-CODES


	DSDD=6001+DSKDEV
	DLCR=6002+DSKDEV
	DCSR=6004+DSKDEV
	DRSR=6005+DSKDEV
	DSDE=6011+DSKDEV
	DLSR=6012+DSKDEV
	DSRR=6013+DSKDEV
	DLTR=6014+DSKDEV
	DLTW=6015+DSKDEV
	DWCA=6017+DSKDEV
EJECT
/   THEN, WE MIX IN A HEADER-BLOCK FOR THIS DRIVER

*0
	-5		/ ENTRY-POINTS IN DRIVER

/   FIRST, WE HAVE A SET FOR THE MODEL 30 WITH DEVICE-CODE = 50

IFZERO DSKDEV-500 <
	IFZERO BIGDSK <
		DEVICE SS35 ; DEVICE SYS ; 4230 ; 2007 ; 0 ; 6260
		DEVICE SS35 ; DEVICE DSK0 ; 4230 ; 1007 ; ZBLOCK 2
		DEVICE SS35 ; DEVICE DSK1 ; 4230 ; 1011 ; ZBLOCK 2
		DEVICE SS35 ; DEVICE DSK2 ; 4230 ; 1012 ; ZBLOCK 2
		DEVICE SS35 ; DEVICE DSK3 ; 4230 ; 1013 ; ZBLOCK 2
		EJECT
	>

/   NEXT, A HEADER FOR MODEL 40 WITH DEVICE-CODE = 50

	IFNZRO BIGDSK <
		DEVICE SS45 ; DEVICE SYS ; 4230 ; 2007 ; 0 ; 6260
		DEVICE SS45 ; DEVICE DSK0 ; 4230 ; 1007 ; ZBLOCK 2
		DEVICE SS45 ; DEVICE DSK1 ; 4230 ; 1011 ; ZBLOCK 2
		DEVICE SS45 ; DEVICE DSK2 ; 4230 ; 1012 ; ZBLOCK 2
		DEVICE SS45 ; DEVICE DSK3 ; 4230 ; 1013 ; ZBLOCK 2
		EJECT
	>
>


/   NEXT COULD BE A HEADER FOR A MODEL 30 ON DEVICE-CODE 60, HOWEVER
/      WHY BOTHER?

IFZERO DSKDEV-600 <
	IFZERO BIGDSK <DERR,BARF>

/   LASTLY, WE GET A HEADER FOR A MODEL 40 ON DEVICE-CODE 60

	IFNZRO BIGDSK <
		DEVICE SS46 ; DEVICE SYS ; 4230 ; 2007 ; 0 ; 6260
		DEVICE SS46 ; DEVICE DSK0 ; 4230 ; 1007 ; ZBLOCK 2
		DEVICE SS46 ; DEVICE DSK1 ; 4230 ; 1011 ; ZBLOCK 2
		DEVICE SS46 ; DEVICE DSK2 ; 4230 ; 1012 ; ZBLOCK 2
		DEVICE SS46 ; DEVICE DSK3 ; 4230 ; 1013 ; ZBLOCK 2
	>
>
EJECT
/   NOW MIX IN ONE BOOTSTRAP

	BOOT-BLAST	/ LENGTH OF BOOTSTRAP

RELOC 0			/ GET THE SYMBOLS DEFINED CORRECTLY
BOOT,	NOP
	NOP
	NOP
	NOP		/ PADDING TO GET TO KEYED IN BOOTSTRAP
	DSDD
	JMP .-1		/ WAIT FOR INITIAL LOAD TO FINISH
	DSDE		/ ANY ERRORS?
	JMP BOOTLP	/ 'TAIN'T NONE, GO ONWARD
	DRSR
	HLT		/ QUIT WITH STATUS IN AC
	JMP .-1		/ IMPERTERBABLE HALT


BXR1,	177		/ DEFINE AUTO-INDICES FOR BOOTSTRAP
BXR2,	7577
BXR3,	7777
BXR4,	7577


/   MOVE  FIRST PAGE TO FIELD ONE, AND SECOND PAGE TO FIELD ZERO

BOOTLP,	TAD I BXR1
	DCA I BXR2
	TAD I BXR3
	CDF 10
	DCA I BXR4
	CDF 0
	TAD BXR2
	SZA CLA		/ HAVE WE FINISHED MOVE?
	JMP BOOTLP	/ NO, MOVE ON BUB!
	JMP I .+1	/ GO TO MONITIO RE-READ ROUTINE
	7605

BLAST,	RELOC
/   THIS IS THE RESIDENT DRIVER (PRIMARILY EVIL) (IT MURMURS A LOT)
/   SEE THE DIRVER.  OH, OH, LOOK AT THE DRIVER!
/		ISN'T IT A FUN DRIVER?
/		NO?!!?  YOU BETCHEM' RED-RIDER

*200
	ZBLOCK 7	/ FOR "BUILD"'S BENIFIT

RELOC 7607		/ FOR MY BENIFIT

SHNDLR,	0		/ "DSK0" ("SYS")
	ISZ DSKNO	/ WASTED (DUE TO "DTA0")
	ISZ DSKNO	/ "DSK1"
	ISZ DSKNO	/ "DSK2"
	ISZ DSKNO	/ "DSK3"


M7600,	7600		/ "CLA"
	TAD DSKNO
	CIA
	TAD KTM76	/ (TAD M7600-1
	DCA SHNST1	/ FORM (TAD "ENTRY")
	TAD SHNST1
	TAD KOFF	/ (TABL-SHNDLR
	DCA SHNST2	/ FORM (TAD "TABL")
	CLL CLA CML RTR	/ 2000
	TAD SHNST1
	DCA SHNST3	/ FORM (DCA "ENTRY")
	RDF
	TAD KCDIF
	DCA SHCDF	/ FORM EXIT FIELD-CHANGER

SHNST1,DSKNO,ARG1,	0
/   THIS BECOMES ENTRY-WORD FETCHER
/   NOTE: THIS WORD (I. E., "DSKNO") IS ZERO BEFORE EACH ENTRY

	DCA SHNDLR	/ STORE CALLING-ADDRESS IN CANNONICAL LOCATION (BOOM)
	TAD SHNDLR
	DCA SAVPNT	/ SAVE CALLING-ADDRESS
	TAD KWDCT	/ 7750
	DCA ERRCNT
EJECT
/   FINALLY, WE GET TO SOME USEFUL CODE!!!

SHNDLP,	TAD I SHNDLR
	RAL
	AND M7600
	DCA WDCNT	/ NUMBER OF WORDS TO TRANSFER
	RAL
	TAD KDINST
	DCA DKINST	/ FORM A READ OR A WRITE INSTRUCTION
	TAD I SHNDLR
	BSW		/ PUT BUFFER-FIELD IN UPPER AC
	DCA ARG1
	ISZ SHNDLR
	TAD I SHNDLR
	DCA CORADR
	ISZ SHNDLR
	DLCR		/ BREAK-FIELD FOR "DWCA" (ZERO)
	TAD KWDCT
	DWCA		/ AC = 7XXX
	AND ARG1	/ LOAD FIELD-BITS (AMONG OTHERS)
	AND M7000	/ KILL THE "OTHERS"
	DLCR		/ SET BUFFER-FIELD
	CLL CLA
	TAD I SHNDLR
	AND M17
	DLSR		/ SECTOR ADDRESS
	CIA
	TAD I SHNDLR	/ JUST TRACK BITS
	CLL RTR
	RTR
SHNST2,	HLT		/ ADD IN TRACK-OFFSET
DKINST,	HLT		/ EITHER A "DLTR" OR A "DLTW" GOES HERE
	JMP MORSHN	/ AVOID -USR- KLUDGE


M7000,	7000		/ NICE PLACE TO HIDE A CONSTANT

IFNZRO .-7700 <E7700,BARF>	/ BETTER BE AT 7700
EJECT
	HLT		/ KLUDGE TO CATCH THE DUMMY...
	HLT		/...WHO CALLS -USR- WITHOUT THE CIF 10
/   REAL CODE RESUMES HERE

MORSHN,	DSDD
	JMP .-1		/ WAIT FOR THE OPERATION TO FINISH
	CLL CLA		/ -AC- IS STILL TRASHY
	DSDE		/ WAS THERE AN ERROR?
	JMP SHXIT	/ NO

	TAD SAVPNT
	DCA SHNDLR	/ RESTORE CALLING ADDRESS
	ISZ ERRCNT
	JMP SHNDLP	/ LOOP 'TIL RETRY-COUNT EXPIRES
			/ WITH A STAKE IN HIS HEART?
	CLL STA


SHXIT,	TAD K4		/ IF ERROR-EXIT, THIS IS THREE WITH LINK ON
			/ IF NORMAL-EXIT, THIS IS FOUR WITH LINK OFF
	TAD SAVPNT
	DCA SAVPNT	/ SET POINTER FOR EXIT
	TAD KISZ
SHNST3,	HLT		/ RESTORE ENTRY "ISZ"
	DCA DSKNO	/ CLEAR UNIT-NUMBER

SHCDF,	HLT		/ RESET TO CALLER'S FIELDS
	RAR		/ PASS BACK ERROR-FLAG
	JMP I SAVPNT	/ RETURN TO CALLER
EJECT
KDINST,	DLTR
KTM76,	TAD M7600-1
KOFF,	TABL-SHNDLR
KCDIF,	CDF CIF 0
KWDCT,	WDCNT
M17,	17
KISZ,	ISZ DSKNO


/   NOW, A TABLE OF ADDRESS-OFFSETS
TABL,	0		/ "DSK0" ("SYS")
K4,	4		/ SLOT IS OTHERWISE UNUSED ("DTA0")
	314		/ "DSK1"
	IFNZRO BIGDSK <630>
	IFZERO BIGDSK <2000>	/ "DSK2"
	IFNZRO BIGDSK <1144>
	IFZERO BIGDSK <2314>	/ "DSK3"


/   FINALLY, SOME SCRATCH-LOCATION DEFINITIONS

	WDCNT=7750
	CORADR=7751
	ERRCNT=7752
	SAVPNT=7753

$
