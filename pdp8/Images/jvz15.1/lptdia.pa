/LPT HANDLER FOR A DIABLO PRINTER
/
	*0
	-1		/1 DEVICE HANDLER
	DEVICE DIAB	/GROUP NAME
	DEVICE LPT	/PERMANENT DEVICE NAME
	1040		/"DCB" DEVICE CONTROL BLOCK
	LPT-200		/ENTRY OFFSET
	0000		/ALWAYS ZEROES
	0000
/
	LDEVC=66		/PRINTER DEVICE CODE
	PDEVC=15		/PLOTTER DEVICE CODE
	LSF=LDEVC^10+6001	/LINEPRINTER SKIP ON FLAG
	LCF=LDEVC^10+6002	/CLEAR FLAG
	LLS=LDEVC^10+6006	/LOAD & PRINT
	PLY=PDEVC^10+6002	/MOVE Y INCREMENTS
	RESTORE=PDEVC+1^10+6004	/RESTORE DIABLO TO LEFT MARGIN
/
	*200
/
WIDTH,	-205		/132 CHARACTERS / LINE
LNCTR,	7573
LPTR,	0000
/
LPT,	0003		/ENTRY POINT & VERSION NUMBER
	CLA STL RAR	/SET 4000 BIT TO BUMP R/W BIT INTO LINK
	TAD I LPT	/GET ARG1	R/W BIT INTO LINK
	AND M7700	/GET WORD COUNT
	CMA
	DCA WC		/SAVE -(WC+1)
FEED,	RDF		/DATA FIELD STILL HAS CALLING FIELD
	TAD CIFCDF	/ADD CDF CIF
	DCA EXIT	/SAVE FOR EXIT
	TAD I LPT	/ARG1 AGAIN
	AND M0070	/MASK DATA FIELD OF LPT BUFFER
	TAD CCDF	/GET CDF
	DCA SETFLD	/SAVE BUFFER FIELD
	ISZ LPT
	TAD I LPT	/GET ARG2
	DCA CA		/SAVE BUFFER ADDRESS
	ISZ LPT
	TAD I LPT	/GET BLOCK NUMBER
	ISZ LPT		/BUMP POINTER TO ERROR RETURN
SETFLD, 0		/SET UP BUFFER DATA FIELD
	SNL		/TEST ATTEMPT TO INPUT FROM PRINTER
	JMP ERROR	/TAKE ERROR EXIT IF SO
	SNA CLA		/BLOCK IN AC=0?
	RESTORE		/YES	IF FIRST CALL RESTORE DIABLO
	JMP THIRD	/ENTER AC=0 & INIT LINE WIDTH
UNPAC,	STL		/SETUP LINK FLAG FOR THIRD CHAR
ROTL,	RTL		/LINK BIT IS IN 4000 BIT FOR THIRD
	RTL
	SPA		/TEST THIRD CHAR
	JMP THIRD	/PRINT THIRD CHAR
	DCA SETFLD	/NOT THIRD SAVE TEMPORARY
	TAD I CA	/GET BUFFER
	JMS PRINT	/PRINT THIS CHARACTER
	TAD I CA	/GET BUFFER
	ISZ CA		/BUMP BUFFER POINTER
M7400,	7400		/NO OPP
	AND M7400	/MASK HALF OF THIRD CHAR
	CLL RAL		/USE FOUR BITS OF IT
	TAD SETFLD	/GET OTHER PART OF IT
	JMP ROTL	/GO TEST FOR THIRD & PRINT CHAR
THIRD,	JMS PRINT	/PRINT THIRD CHAR
	ISZ WC		/TEST FOR END FILE
	JMP UNPAC	/GO SETUP UNPACK
	ISZ LPT		/SKIP ERROR EXIT
EXIT,	0		/CONTAINS CDF CIF
	JMP I LPT	/NORMAL EXIT
ERROR,	CLA STL RAR	/ERROR EXIT
	JMP EXIT
PRINT,	0		/TEST THEN PRINT
	AND M0177	/MASK TO 6 BIT
	TAD N0175
	SMA
	JMP IGNORE	/IGNORE 175 TO 177
	TAD C143	/(175-32
	SNA		/TEST CNTRL/Z
	JMP EXIT-1	/CNTRL/Z IS END OF FILE PRINT FF & EXIT
	TAD C21		/(32-11
	SNA		/TEST TAB
	JMP TAB		/TAKE CARE OF TAB
	TAD C11
SPACE,	SZA		/IGNORE ZEROES
	JMS TYPE	/CHAR PASSES TESTS PRINT IT
	TAD LPTR	/TEST CURRENT POSITION
	SMA		/IF DONE RE-INIT TO WIDTH
LINFUL, TAD WIDTH
	DCA LPTR
IGNORE, SMA CLA		/DOESN T SKIP JUST CLEARS
	JMP I PRINT	/ZEROES 175 TO 177
TYPE,	0		/BASIC PRINT ROUTINE
	TAD N14		/-14
	SNA
	JMP FORM
	TAD FEED
	LLS
	TAD N6200
	AND M7770	/PREPARE FOR FEED TEST
	TAD M7770
	SNA		/TEST FOR CR, LF, FF, VT, ETC
	DCA LPTR	/RESET WIDTH	TO BE FIXED .-14
	SNA CLA
	ISZ LNCTR
CNTRLC, KRS		/TEST CNTRL/C
	TAD CTRLC
	SZA CLA
	JMP .+3
CIFCDF, CIF CDF 0
	JMP I P7600	/RETURN TO MONITOR
	LSF		/TEST PRINTER FLAG
	JMP CNTRLC	/WAIT LOOP IN CNTRL/C TEST
	ISZ LPTR	/LPT READY
	JMP I TYPE
	JMP LINFUL	/RESET WIDTH CARRY ON PRINTING
TAB,	TAD SPACE	/SIMULATE TABS
	JMS TYPE	/PRINT SPACE
	TAD WIDTH
	CMA
	TAD LPTR	/HOW FAR TO NEXT TAB STOP?
	AND M0007
	SZA CLA
	JMP TAB		/SEND SPACES TIL DONE
	JMP I PRINT	/DONE
/
FORM,	TAD LNCTR	/GET NUMBER OF LINES LEFT
	CIA		/MAKE IT POSITIVE
	CLL RTL		/MULTIPLY BY 4
	RESTORE		/RESTORE AFTER EACH FORM FEED
	PLY		/MOVE Y INCREMENTS
P7600,	7600
	TAD WIDTH	/2 X (-PAGE LENGTH) -1	= -205
	DCA LNCTR
	JMP CNTRLC
/
CA,	0
C11,	11
C21,	21
C143,	143
CCDF,	CDF
CTRLC,	-203
M0007,	7
M0070,	70
M0177,	177
M7700,		7700
M7770,7770
N14,	-14
N0175,	-175
N6200,	-6200
WC,	0
	$$
