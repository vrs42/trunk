/LPT HANDLER FOR A DATA PRINTER V132C
/
/	JUNE 18 1977 J.Y.
/	CONTAINS THE TRANSLATION TABLE FOR THE FUNNY CODE
/
/	MODIFIED JUNE 20 1977 J.Y.
/	TO WAIT FOR THE PRINTER TO BE TURNED ON
/
/	MODIFIED JANUARY 19 1978 J.Y.
/	TO SETUP PAGE LINKS ON EVERY ENTRY
/	BECAUSE FOTP.SV CALLS THE USR TO "CLOSE" ALL 
/	OUTPUT FILES (EVEN ON NON FILE STRUCTURED DEVICES).
/	IT WILL THUS CALL THIS HANDLER WITH NONZERO BLOCK
/	NUMBERS FOR THE FIRST TIME.
/	ALSO MODIFIED TO FORCE PARITY BECAUSE FOTP.SV WON'T.
/
/	MODIFIED MARCH 7 1978	J.Y.
/	TO INITIALIZE "PRINTER POWER ON" TEST ROUTINE
/	ON EACH ENTRY TO THE HANDLER.
/
/	NOW THE CCL .LIST COMMAND WILL WORK !
/
/
	*0
	-1		/1 DEVICE HANDLER
	DEVICE DATA	/GROUP NAME
	DEVICE LPT	/PERMANENT DEVICE NAME
	1040		/"DCB" DEVICE CONTROL BLOCK
	LPT-200+4000	/ENTRY OFFSET +2PG BIT
	0000		/ALWAYS ZEROES
	0000
/
	LDEVC=64
	LSF=LDEVC^10+6002	/LINEPRINTER SKIP ON FLAG
	LLS=LDEVC^10+6003	/LOAD DATA
	LST=LDEVC^10+6004	/STROBE DATA
	LCF=LDEVC^10+6007	/CLEAR FLAG
/
	*200
/
LPT,	4		/ENTRY POINT & VERSION NUMBER
	CLA STL RAR	/SET AC BIT 0
	TAD I LPT	/GET ARG1, R/W BIT INTO LINK
	AND (3700	/GET WORD COUNT
	CMA
	DCA WC		/SAVE -(WC+1)
	RDF		/DATA FIELD STILL HAS CALLING FIELD
	TAD CIFCDF	/ADD CDF CIF
	DCA EXIT	/SAVE FOR EXIT
	TAD I LPT	/ARG1 AGAIN
	AND (70		/MASK DATA FIELD OF LPT BUFFER
	TAD CCDF	/GET CDF
	DCA SETFLD	/SAVE BUFFER FIELD
	ISZ LPT
	TAD I LPT	/GET ARG2
	DCA CA		/SAVE BUFFER ADDRESS
	ISZ LPT
	TAD I LPT	/GET BLOCK NUMBER
	ISZ LPT		/BUMP POINTER TO ERROR RETURN
	DCA TEMP	/SAVE BLOCK NUMBER FOR LATER TEST
	SNL		/TEST ATTEMPT TO INPUT FROM PRINTER
	JMP ERROR
	CDF 0		/HANDLER FIELD
	JMS LOC		/FIND OUT WHERE WE ARE
LOC,	0		/SAVE IT HERE
	TAD LOC		/GET THE LOCATION
	AND (7600	/FORM PAGE NUMBER
	TAD (200	/BUMP TO BEGINNING OF NEXT PAGE
	DCA LINK	/SAVE LINK TO NEXT PAGE
	TAD LINK
	TAD EXITP	/FORM POINTER FOR EOF EXIT
	DCA I LINK	/STOW IT START OF NEXT PAGE
	TAD LINK	/ADD PAGE NUMBER
	TAD CNTRLP	/GET PAGE ADDRESS OF CNTRL/C ROUTINE
	ISZ LINK	/BUMP POINTER
	DCA I LINK	/STOW IN NEXT PAGE
	ISZ LINK	/BUMP POINTER TO PRINT ROUTINE
	TAD TEMP	/GET THE BLOCK NUMBER
	SZA CLA		/BLOCK IN AC=0?
	JMP SETFLD	/NO DON'T INITIALIZE THIS TIME
	TAD (-5		/INITIALIZE ON EACH ENTRY
	DCA TEMP1
STIMUL,	LCF		/CLEAR THE FLAG JUST IN CASE
	ISZ TEMP2	/WAIT FOR TRANSIENTS
	JMP .-1
	TAD (4060	/GET A SPACE
	LLS		/LOAD THE COMMAND
	LST		/SEND THE SPACE
	JMS CNTRLC	/STALL & TEST FOR CNTRL/C
	CLA CLL
	LLS		/CLEAR THE COMMAND
LSKP,	LSF		/WAIT FOR A RESPONSE
	JMP TIMEUP	/GO TEST FOR TIME EXPIRED
	ISZ TEMP1	/DO THIS FIVE TIMES
	JMP STIMUL	/TO LET TRANSIENTS SETTLE
	JMP SETFLD	/FINALLY DONE 5 TIMES
TIMEUP,	JMS CNTRLC	/STALL FOR TIME
	ISZ TEMP2	/HAS OUR TIME EXPIRED?
	JMP LSKP	/NO, NOT YET
	JMP STIMUL	/YES, GIVE ANOTHER KICK
SETFLD, 0		/SET UP BUFFER DATA FIELD
	JMP THIRD	/ENTER AC=0 & INIT LINE WIDTH
UNPAC,	STL		/SETUP LINK FLAG FOR THIRD CHAR
ROTL,	RTL		/LINK BIT IS IN 4000 BIT FOR THIRD
	RTL
	SPA		/TEST THIRD CHAR
	JMP THIRD	/PRINT THIRD CHAR
	DCA TEMP1	/NOT THIRD SAVE TEMPORARY
	TAD I CA	/GET BUFFER
	JMS I LINK	/PRINT THIS CHARACTER
	TAD I CA	/GET BUFFBR
	ISZ CA		/BUMP BUFFER POINTER
M7400,	7400		/NO OPP
	AND M7400	/MASK HALF OF THIRD CHAR
	CLL RAL		/USE FOUR BITS OF IT
	TAD TEMP1	/GET OTHER PART OF IT
	JMP ROTL	/GO TEST FOR THIRD & PRINT CHAR
THIRD,	JMS I LINK	/PRINT THIRD CHAR
	ISZ WC		/TEST FOR END FILE
	JMP UNPAC	/GO SETUP UNPACK
	ISZ LPT		/SKIP ERROR EXIT
EXIT,	0		/CONTAINS CDF CIF
	JMP I LPT	/NORMAL EXIT
/
ERROR,	CLA STL RAR	/(4000
	JMP EXIT	/EXIT WITH ERROR
/
CNTRLC,	0		/CHECK FOR CNTRL/C
	DCA TEMP	/SAVE THE AC
TEST,	KRS		/READ STATIC
	AND (177	/DROP PARITY
	TAD (-3		/TEST CNTRL C
	SNA CLA
	KSF		/EXIT IF CNTRL/C AND KYBD FLAG UP
	JMP .+3		/NO FLAG WAIT FOR THE PRINTER
CIFCDF,	CDF CIF 0	/OS/8 FIELD
	JMP I (7600	/BACK TO OS/8
	TAD TEMP	/RESTORE THE AC
	JMP I CNTRLC
/
LINK,	0		/LINK TO THE NEXT PAGE
CA,	0
CCDF,	CDF
CNTRLP,	177&CNTRLC+7600	/PAGE ADDRESS OF CNTRL/C TEST
TEMP,	0
TEMP1,	-5		/(-5 IS USED AT INIT ONCE ONLY
TEMP2,	0		/TIMER LOCATION
EXITP,	177&EXIT-1+7600
WC,	0
/
	PAGE
/
EXITT,	0		/POINTER TO EOF EXIT
PCNTRL,	0		/POINTER TO CONTROL C TEST
/
PRINT,	0		/TEST THEN PRINT
	AND (177	/EXTRACT CHARACTER & FORCE PARITY
	SZA		/IGNORE NULLS
	TAD (-177	/TEST RUBOUT
	SNA
	JMP PURGE	/PURGE NULLS, RUBOUTS
	TAD (377-212	/FORCE PARITY
	SNA		/TEST FO LINE FEED
	JMP LF		/GO HANDLE A LINE FEED
	IAC		/TEST FOR TAB
	SNA
	JMP TAB
	TAD (211-215	/TEST CARRIAGE RETURN
	SNA
	JMP CR		/GO HANDLE CR
	IAC		/TEST FOR FORM FEED
	SNA
	JMP FORM
	TAD (214-233	/TEST FOR ALTMODE
	SNA		/SKIP IF NOT
	TAD (233-"$	/CHANGE TO A DOLLAR SIGN
	TAD (233-237	/TEST CNTRL/Z
	SNA
	JMP I EXITT	/GO HANDLE END OF FILE
	SMA		/SKIP ON ANY OTHER CNTRL CHARACTERS
	JMS TRANSL	/GO TRANSLATE AND PRINT THE CHARACTER

PURGE,	CLA CLL		/MERGE HERE TO EXIT
	JMP I PRINT	/BACK TO THE PREVIOUS PAGE

FORM,	TAD (100	/GET THE FORM CODE
LF,	TAD (2001	/(1 IS THE LINEFEED CODE
	JMP FCLEAR	/GO CLEAR THE FLAG

CR,	TAD CHARNO	/IS THIS TWO OR MORE CR/LF'S ?
	SNA CLA		/CLEAR FLAG ONLY ON FIRST CR
	JMP PURGE	/IGNORE A SECOND CR
FCLEAR,	LCF		/CLEAR THE READY FLAG
	LLS		/LOAD THE DATA
	SZA		/DON'T STROBE IF CR COMMAND
	LST		/STROBE THE DATA TO THE PRINTER
	JMS I PCNTRL	/GO TEST FOR CNTRL C
	CLA CLL		/CLEAR & STALL
	LLS		/LOAD A ZERO, COMMAND TERMINATE
	JMS I PCNTRL	/TEST FOR CNTRL/C WHILE WAITING
	LSF		/SKIP ON READY
	JMP .-2		/WAIT FOR THE FLAG
	DCA CHARNO	/ZERO THE CHARACTER COUNT
	JMP PURGE	/GO EXIT
CHARNO,	0
/
TAB,	CLA IAC		/GET A SPACE -237
	JMS TRANSL	/GO SEND IT
	TAD CHARNO
	AND (7		/ZERO IF AT NEXT TAB STOP
	SZA CLA
	JMP TAB		/NOT YET
	JMP PURGE	/EXIT TAB DONE
/
TRANSL,	0		/ENTER HERE TO FOLD & TRANSLATE THE CODE
	TAD (237-340	/TEST FOR LOWER CASE
	SMA		/SKIP IF UPPER CASE
	TAD (-40	/FOLD TO UPPER CASE
	TAD (340	/RESTORE THE CHAR
	RAR		/ODD BIT TO LINK
	AND (37		/MASK TO FIVE-BIT FOR TRANSLATION
	TAD GET		/MAKE A GET INSTRUCTION
	DCA .+1		/PREPARE TO RUN OVER IT
	0		/BECOMES A TAD TABLE(N)
	SNL		/TEST FOR WHICH HALF
	BSW
	AND (77		/USE ONLY SIX BITS
	CLL RAL
	CLL CML RAR	/SET BIT 0
	LLS		/LOAD THE CHARACTER
	LST		/STROBE THE DATA TO THE PRINTER
	ISZ CHARNO	/BUMP CHAR COUNT FOR TAB CALCULATION
	JMP I TRANSL	/EXIT DONE
/
/	THE FOLLOWING TABLE TRANSLATES ASCII TO THE PRINTER CODE
/
GET,	TAD .+1
	5421		/@  A
	2223		/B  C
	2425		/D  E
	2627		/F  G
	3031		/H  I
	0102		/J  K
	0304		/L  M
	0506		/N  O
	0710		/P  Q
	1162		/R  S
	6364		/T  U
	6566		/V  W
	6770		/X  Y
	7137		/Z  [
	3237		/\  ]
	1775		/^  _
	6012		/SP !
	5753		/"  #
	1374		/$  %
	2055		/&  '
	3515		/(  )
	1436		/*  +
	7300		/,  -
	3361		/.  /
	5241		/0  1
	4243		/2  3
	4445		/4  5
	4647		/6  7
	5051		/8  9
	4016		/:  ;
	3456		/<  =
	7677		/>  ?
	$$$
