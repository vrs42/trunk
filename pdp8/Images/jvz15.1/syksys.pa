/SYKES TRIPLE PACK SYSTEM HANDLER
/
/PACKS 2 12-BIT WORDS INTO 3 8-BIT BYTES
/
	*0
	-1		/ONE HANDLER
	DEVICE SYKE	/GROUP NAME
	DEVICE SYS	/PERMANENT NAME
	4500		/DCB
	6007		/ENTRY OFFSET -  2 PG HANDLER
	0		/ALWAYS ZERO
	DECIMAL; -667 ;OCTAL
	-1		/ONE WORD BOOT (DUMMY)
	HLT		/DUMMY BOOT
/
	UNIT=2		/USE DISK UNIT 2
	DEVC=32		/DEVICE CODE 32
	SYKOP=DEVC^10+6001
	SYKSF=DEVC^10+6002
	SYKIN=DEVC^10+6004
/
/MODIFY PIP.SV DEVICE LENGTH TABLE
/	13650/0000  6545
/
/	667 DECIMAL OS/8 BLOCKS PER DISK
/	USES ALL 77 TRACKS
/
/
	*200
/
NOPUNCH;*7600;ENPUNCH
/
	ZBLOCK 7
SYKES,	0		/ENTRY POINT
	CLA CLL
	TAD I SYKES	/GET FUNCTION WORD
	DCA ARG1
	TAD ARG1
	AND M3600	/MASK WORD COUNT
	CIA
	DCA DBLWCT	/SAVE -WC/2
	TAD CDFCIF
	RDF		/JAM IN RETURN FIELD
	DCA RETURN	/SAVE RETURN FIELD
	TAD ARG1	/GET FUCTION WORD AGAIN
	AND M70		/MASK BUFFER FIELD
	TAD CCDF	/FORM CDF INSTRUCTION
	DCA SETDF
	ISZ SYKES
	TAD I SYKES	/GET BUFFER ADDRESS
	DCA SPOINT
	ISZ SYKES	/BUMP POINTER TO BLOCK NUMBER
/
/
/CONVERT BLOCK NUMBER TO TRACK AND SECTOR
/
	DCA STRK	/CLEAR TRACK COUNT
	TAD I SYKES	/GET NUMBER OF OS/8 BLOCKS
	RAL CLL
	TAD I SYKES	/BLOCKS X 3
	ISZ STRK	/COUNT TRACKS
	TAD SMD26	/WHILE SUBTRACTING 26 SECTORS
	SMA
	JMP .-3		/DONE YET?
	TAD SP432	/ADD 26 SECTORS & COMMAND BIT 3
	DCA SECT
BYTE2,
SETDF,	0		/SELECT CORRECT FIELD
	CLA CMA		/SUBTRACT 1 TO USE TRACK 0
	TAD STRK	/GET TRACK
	TAD P7400	/AC3 = 1
	SYKOP		/OUTPUT SELECT TRK COMMAND
	CLA CLL CML RAR	/SET BIT 0 TO BUMP R/W/BIT
	TAD ARG1	/ AC TO BUMP R/W BIT INTO LINK
	SZL CLA		/TEST R/W 0=READ, 1=WRITE
	TAD S40		/ADD WRITE COMMAND
	TAD SECT	/ADD SECTOR NUMBER
	SYKOP		/OUTPUT R/W SECTOR
	SNL CLA		/TEST R/W AGAIN TO BRANCH
	JMP RLOOP	/READ
/
	CIF 20		/GO TO WRITE ROUTINE IN FIELD 2
	JMS ENTRYW	/JMS THERE BUT RETURN TO TERM
SPOINT,	0		/PICK UP ARGS VIA JMS POINTER
DBLWCT,	0
/
/READ LOOP
/
RLOOP,	DCA SAVE	/CLEAR BYTE 3
	JMS READ	/GET BYTE 1
	DCA I SPOINT	/STORE IN WORD 1
	JMS READ	/GET BYTE 2
	DCA BYTE2	/STORE IN BYTE 2
	JMS READ	/GET BYTE 3
	JMS HACK	/ASSEMBLE & STORE WORD 1  INCR SPOINT
	TAD BYTE2	/GET BYTE2
	DCA I SPOINT	/STORE IN WORD 2
	JMS HACK	/ASSEMBLE & STORE IN WORD 2
	ISZ DBLWCT	/INCREMENT ONCE EVERY 2 WORDS
	JMP RLOOP	/READ MORE
TERM,	TAD P603	/GET TERMINATE COMMAND
	SYKOP		/ISSUE TERMINATE
/
/CHECK FOR ERRORS - CRC OR FAULT
/
	JMS READ	/WAIT FOR TERMINATE AND READ STATUS
	AND ERMASK	/CRC & FAULT
	SNA 		/SKIP ON ERROR
	ISZ SYKES	/SKIP OVER THE ERROR RETURN
	ISZ SYKES	/TO THE NORMAL RETURN
	SZA CLA		/TEST ERROR FLAG
	CLA CMA		/MINUS 1 IF ERROR
RETURN,	0		/SET UP RETURN FIELD
	JMP I SYKES
/
/READ ROUTINE SHIFT LOOP
/
SECT,
HACK,	0		/ADDS UPPER 4 BITS TO COMPLETE WORD
	TAD SAVE	/GET BYTE 3
	AND M377	/MASK TO 8 BITS
	RTL		/SHIFT 4 LEFT
	RTL
	DCA SAVE	/STORE RESULT OF SHIFT
	TAD SAVE
	AND P7400	/MASK UPPER 4 BITS
	TAD I SPOINT	/ADD LOWER 8 BITS
	DCA I SPOINT
	ISZ SPOINT	/BUMP POINTER
S40,	40		/PROTECT ISZ
	JMP I HACK
/
/READ ROUTINE
/
ARG1,			/TEMP STORAGE OF FUNCTION
READ,	0
	SYKSF
	JMP .-1		/WAIT FOR DATA
	SYKIN		/READ DATA
	JMP I READ	/RETURN WITH DATA
/
SP432,	433		/COMMAND BIT AC3=1, ADDS A 26(10) TO FIX
			/DIVISION & ADDS 1 FOR FIRST SECTOR
SMD26,	-32		/26 SECTORS PER TRACK
P603,	603		/TERMINATE COMMAND
ERMASK,	110
CDFCIF,	CDF CIF
CCDF,	CDF
/
	*350
NOPUNCH;*7750;ENPUNCH
/
M70,	70		/USED TO MASK FIELD BITS
M377,	377
M3600,	3600
P7400,	7400
SAVE,	0		/TEMP STORE OF BYTE 3 FOR READ
STRK,	0		/TEMP STORAGE OF TRACK
/
/
/
NOPUNCH;FIELD 2;*7600;ENPUNCH
/
ENTRYW,	0		/ENTRY TO WRITE ROUTINE
	RDF		/GET CURRENT DF
	TAD CDFF
	DCA FLDCH	/SAVE A FIELD CHANGE INSTRUCTION
	CDF 0		/PICK UP ARGS FROM FIELD 0
	TAD I ENTRYW	/GET SPOINT
	DCA POINT
	TAD I ENTRYW	/GET DBLWCT
	DCA WC
FLDCH,	0		/BACK TO BUFFER FIELD
/
WLOOP,	CLL IAC RAR	/SETUP LINK AS FLAG FOR BYTE 3
ROT4L,	RTL
	RTL
	SPA		/BYTE 3 YET?
	JMP THIRD	/YES
	DCA BYTE	/NO GET FIRST OR SECOND HALF BYTE
	TAD I POINT	/GET NEXT BYTE
	JMS WRITE	/WRITE TO DISK
	TAD I POINT	/AND UNPACK ITS UPPER BITS
	ISZ POINT	/BUMP POINTER
M7400,	7400		/PROTECT SKIP
	AND M7400	/MASK UPPER BITS
	CLL RAL		/ROTATE UPPER BITS
	TAD BYTE	/ADD OTHER PART & FLAG
	JMP ROT4L	/PROCESS NEXT BYTE
THIRD,	JMS WRITE	/THIRD BYTE FLAGS END OF WORD PAIR
	ISZ WC		/KEEP TRACK OF WORD PAIRS
	JMP WLOOP	/GET ANOTHER WORD PAIR
	CIF 0		/BACK TO TERMINATE IN FIELD 0
	JMP TERM	/WRITE DONE ISSUE TERMINATE
/
/WRITE ROUITNE
/
WRITE,	0		/WRITE ROUITNE
	SYKSF		/WAIT FOR FLAG
	JMP .-1
	AND MM377	/MASKED WRITE TO DISK
	SYKOP		/OUTPUT DATA
	CLA		/CLEAR BEFORE EXIT
	JMP I WRITE
/
CDFF,	CDF
MM377,	377
WC,	0
POINT,	0
BYTE,	0
	$$$
@
