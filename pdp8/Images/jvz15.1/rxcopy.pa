SAVE,	0		/STASH 8 BITS IN BUFFER
	CDF 10
	DCA I	CBUF
	ISZ	CBUF	/BUMP POINTER
	CDF
	JMP I	SAVE	/AND RETURN

UNSAVE,	0		/GET BACK FROM THE BUFFER
	CDF 10
	TAD I	CBUF
	ISZ	CBUF	/BUMP POINTER
	CDF
	JMP I	UNSAVE	/AND RETURN

