	DCA	WS
	TAD I	WS
	AND	(7007	/STRIP OLD DEVICE CODE
	TAD	CDC	/AND PUT IN NEW ONE
	DCA I	WS
	JMP	DEVS2

DECOUT,	0		/OUTPUT DECIMAL NUMBER
	SNA
	JMP	DECO2	/DON'T SUPPRESS ALL ZEROES!!
