	ISZ ERRNMB	/ADD ONE TO ERROR NUMBER (#=4)
BADOP,	ISZ ERRNMB	/ADD ONE TO ERROR NUMBER (#=3)
CHNNG,	ISZ ERRNMB	/ADD ONE TO ERROR NUMBER (#=2)
