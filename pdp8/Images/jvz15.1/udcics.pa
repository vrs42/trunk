	ISZ DFLG
	CLA CMA
	DCA I DFLG
	JMP I (DDSPTH
DFLG,	0

CONTAC,	SMA	CLA
	JMP I RINGDN
	TAD I (TBLWD1
	JMS I (CNTCCK	/CHECK FOR ALL LEGAL
	TAD T1
	DCA CCHNO	/CHANNEL NO. STRIPPED
	TAD I (TBLWD2
	DCA ROTWD	/COS VALUE
	DCA BITCNT	/WILL COUNT BITS
NOTSET,	TAD ROTWD	/ROTATED ALREADY FOR BIT TO EXAM
	SNA
	JMP  I	RINGDN	/ALL BITS CHECKED
	SMA	CLA	/CHECK FOR SET BITS
	JMP ROTATE
