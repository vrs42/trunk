INPUT,	0
	CLA CLL
	JMS I (ICHAR
	JMP TSTEOF		/ERROR. SEE IF EOF.
	SNA			/IGNORE BLANKS
	JMP INPUT+1
	AND (177	/REMOVE PARITY BIT
	TAD (200	/FOCE PARITY
	DCA CHAR
	JMP I INPUT
SEND,	0
	SNA
	TAD CHAR	/AC=0 USE CHAR
	JMS I   (OCHAR		/AND OUTPUT THE CHARACTER
	JMP OUTERR
	JMP I SEND			/CONTINUE UNTIL EOF.
TSTEOF,	SMA CLA			/WAS IT FATAL?
	JMP CLOSE		/NO..EOF. CLOSE OUTPUT
	JMS TERR
	TEXT /READ ERROR/
CLOSE,	TAD SLASHF
	SNA CLA
	JMP .+2
	TAD (212
	JMS PACK
	CLA CMA
	DCA SLASHF	/EOF
	JMP INIT	/THIS IS NECCICARY AS LAST LINE ON /F IS NOT PACKED
CLOSE2,	JMS I   (OCLOSE
	JMP  CLERR		/FILE CLOSE FAILED
	TAD OPTMX	/GOTO PIP ?
	AND (400
	SZA CLA
	JMP PIP
END,	TAD OPTH	/NO EXIT OS 8 ?
	SMA CLA
	JMP CALLCD	/NO
	CDF CIF 0
	JMP 7600	/SURE
	PAGE
