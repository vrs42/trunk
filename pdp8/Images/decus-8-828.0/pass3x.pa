	NOP	/WAS KSF
	>
/
/ THIS PATCH TO PASS3.SV V3.03 FIXES SOME BUGS
/ & IMPLEMENTS A /M OPTION, WHICH IF SET LISTS
/ ONLY LINES WITH ERRORS. THE ERROR MESSAGES NOW
/ APPEAR AFTER THE LAST LINE OF EACH STATEMENT,
/ NOT THE FIRST.
/
/ THE ALGORITHM IS AS FOLLOWS:
/
/ A) SET STATEMENT NO TO 1
/
/ B) GET NO OF FIRST STATEMENT IN ERROR & GO TO E)
/
/ C) IF END-OF-FILE THEN FINISH;
/    IF /M IS SET THEN GO TO E)
/
/ D) PRINT LINE
/
/ E) GET NEXT LINE & IDENTIFY;
/    IF NOT CONTINUATION OR COMMENT THEN INCREMENT STATEMENT NO
/
/ F) IF STATEMENT NO <NEXT STATEMENT IN ERROR THEN GO TO C)
/
/ G) IF STATEMENT NO = NEXT STATEMENT IN ERROR
/    AND CURRENT STATEMENT NOT COMMENT THEN GO TO D)
/
/ H) PRINT ERROR MESSAGE FOR STATEMENT
/
/ I) GET NO OF NEXT STATEMENT IN ERROR AND GO TO F)
/
/
	COL6=32
	PRHNDR=1527
	ERRCHK=2101
	PAJE=600
	OCHAR=2022
	ONUMBR=1646
	ICHAR=1600
	ENDX=1400
	ERRPTR=2100
	ERRCHK=2101
*PAJE
	CLA IAC
	DCA 24	/INITIALIZE STATEMENT NO TO 1
	JMP I L777	/& GO TO PATCH 1
RTRN1,	DCA 35	/CLEAR STATEMENT TYPE
*777
L777,	EXTRA1	/REPLACES LITERAL AT 00777
*4000
/ EXTRA CODE GOES IN FREE SPACE BEYOND ERROR MESSGES
EXTRA1,	JMS I .+4	/GET - NO OF 1ST STATEMENT INTO 36
	DCA 37		/ZERO EOF INDICATOR
	JMP I .+1	/& GO TO NORMAL HEADER LINE PRINT
	PRHNDR		/CHANGE TO 1524 FOR FF BEFORE 1SST HEADER
	ERRCHK
EXTRA2=.
*611
	JMP CKERR	/AT END OF FILE, CHECK IF ERRORS LEFT
*615
	CLA CMA		/ANY -VE NO WILL DO AS TAB INDICATOR
	DCA TABMRK	/TAB MARKER AT 657 NOT 677
*633
	JMP CKERR	/1ST CHAR IS "C"
	ISZ 35		/INC STATEMENT TYPE
	TAD COL6	
	TAD 767		/CHECK FOR SPACE IN COL 6
	SZA CLA		/YES, NEW STATEMENT
	JMP CKERR
	ISZ 24		/INC STATEMENT NO
	ISZ 35		/& TYPE
CKERR,	CLA CLL
	TAD 36		/COMPARE NEXT STATEMENT IN ERROR
	TAD 24	 	/WITH CURRENT STATEMENT NO
	SNL
	JMP I PCKS	/NOT THERE YET, CHECK FOR /M & EOF
	SZA CLA
	JMP PRERR	/WAS LAST ONE; PRINT ERROR QUICK!
	TAD 35		/CURRENT STATEMENT IS IN ERROR
	SZA CLA		/IF CURRENT LINE IS COMMENT, PRINT ERROR
	JMP I AXTRA2	/ELSE PRINT LINE
PRERR,	JMS I L762	/PRINT ERROR & GET NEXT ERROR NO
	JMP CKERR	/& SEE IF ANY MORE FOR SAME LINE
TABMRK,	0		/MOVED FROM LOC 00677
PREST,	TAD TABMRK	/PRINT REST OF LINE
*.+2
	DCA TABMRK
*675
/ JUST OUTPUT LINE; GO & GET ANOTHER
	JMP RTRN1
AXTRA2,	EXTRA2
PCKS,	CKSLM
*762
L762,	NEWSUB		/REPLACES LITERAL AT 00762
*EXTRA2
	CLL CMA RAL	/ -2
	TAD 35
	SZA CLA		/CHECK IF 1ST LINE OF A STATEMENT
	JMP .+4		/NO
	NOP		/NOT NECESSARY; HERE FOR HISTORICAL REASONS
	TAD 24		/LOAD STTPJ
T M1RRANRX
,ATX	2ATE
2RKP	SCSC,LK7
M6*7
2,6LE	2UWN	BSE/	APRSCLI ERTL AE AL70T60E
2RX*ATC
2 L	ACLA M/LR2 		-DT
5 A	3LI
E
TEST,	TAD 12
	CIA
	TAD 10
	SNA CLA
	JMP .+4		/DONE 1ST 6 CHARS
	TAD I 12
	JMS I OPUT	/OUTPUT CHAR
	JMP TEST
	TAD 10
	TAD M32
	SZA CLA		/SKIP IF MORE TO COME
	JMP I .+3	/ELSE GO & DO CRLF
	JMP I .+1	/PRINT REST OF LINE
	PREST
	674
M32,	-32
OPUT,	OCHAR
V24,	24
TAB,	211
OPON,	ONUMBR
EXTRA3,	TAD 10		/CLEAR REST OF NON-PRINTING LINE
	TAD M32
	SZA CLA		/MORE THAN 6 CHARS?
	JMP I ARTN1	/NO
	JMS I ANXCH	/GET NEXT CHAR
	JMP I ARTN1	/END OF LINE
	CLA
	JMP .-3		/IGNORE
ARTN1,	RTRN1
ANXCH,	ICHAR
EXTRA4=.
*1415
/ FIX BUG; JUMP DIRECT SHOULD BE JUMP INDIRECT
	JMP I 1574
*1423
/ NO NEED FOR CIF HERE
	CDF 10
*1435
/NO NEED FOR CIF HERE
	NOP
*1440
/ NO NEED FOR CIF HERE
	NOP
*1454
/ FIX BUG; JUMP DIRECT SHOULD BE JUMP INDIRECT
	JMP I 1574
*1516
/ CHANGE INITIAL RETURN ADDRESS
	RTRN1
*1777
/ RESET TRAP FOR END-OF-FILE
	EXTRA4
*EXTRA4
/ SET END-OF-FILE MARKER
	ISZ 37
	JMP I .+1	/RETURN AS IF END OF LINE
	1704
/ NO ERROR FOR THIS LINE; CHECK /M
CKSLM,	CLA
	TAD 37
	SZA CLA
	JMP I EOFA	/EOF; WIND UP LISTING
	CDF 10
	TAD I CDOP2
	CDF
	SPA CLA
	JMP EXTRA3	/ /M ON; DO NOT PRINT LINE
	JMP EXTRA2	/DO CODE THAT IS BEEN TAKEN OUT
CDOP2,	7644
EOFA,	ENDX
RALFNM,	FILENAME RALF.SV
*2105
	CIA		/- NEXT STATEMENT IN ERROR
	JMP PATCH
NEWSUB,	0		/NEW SUBROUTINE ENTRY POINT
	CLL CMA RAL	/ -2
	TAD ERRPTR
	DCA 2100	/BACK UP 2 WORDS
	JMS ERRCHK	/GET ERROR NO & CONTINUE AS BEFORE
*2157
PATCH,	DCA 36		/SET - NEXT STATEMENT IN ERROR
	JMP I ERRCHK		/& EXIT SUBROUTINE
/IN V305 FILENAME IS AT 2157 SO MOVE IT
*1452
	RALFNM
*2125
/ CHANGE USE OF XR10 TO XR11, MUST PRESERVE XR10
	DCA 11
	TAD I 11
*2133
	ISZ 11
*2136
	TAD I 11
	DCA 11
	TAD I 11
*2156
/ RETURN FROM SUBROUTINE
	JMP I NEWSUB
