10 PRINT "UNIT ";\INPUT D$
20 PRINT "TAPE # OR DISC NAME ";\INPUT T$
21 K=LEN(T$)\V$=T$
22 IF K<4 GOTO 25
23 PRINT "NAME MAX 3 CHAR"\GOTO 20
25 IF LEN(T$)=3 GOTO 30
26 T$=T$&" "
27 GOTO 25
30 FILEV#1:"TEMP.BI"
40 PRINT #1:"$JOB"
60 PRINT #1:".DIR TD";V$;".XY<";D$;":/B"
70 PRINT #1:".MUNG TEMP"
75 PRINT #1:".KILLX @SYS:KILL"
80 PRINT #1:"$END"
90 CLOSE #1
100 FILEV#1:"TEMP.TE"
140 PRINT#1:"EBTD";V$;".XY";PNT(27);"YJ3K"
150 PRINT #1:"<N.";PNT(27);"3C4DI#";T$;;PNT(27);">EX"
170 CLOSE #1
200 END
