100 REM WRITES CURRENT DATE TO FILE TODAY.TE AND ALSO THE TECO MACRO
110 REM MUNG TODAY,X;FILE DOES AN EB ON FILE + Y AND INSERTS
120 REM TODAYS DATE AS 1ST LINE X<OPTIONAL>IS INSERTED BEFORE
130 REM BACKSLASH IS CHANGED TO / TO AVOID CCL CONFLICT
131 REM ^NIS INSERTED TO GIVE 1ST LINE LARGE CHAR EXEPT
132 REM IF COMMENTCHARACTER IS / AS PAL8 ADDS SO MUCH TO 1ST
133 REM LINE AS TO OVERFLOW
135 REMARKABLE ISNT IT
140 REM   .COMPILE DATE/K     OR WITH V3C  ADD/C
155 REM IF YOU HAVE BASIC OS8V3C IGNORE THE FOLLOWING 3 LINES
160 REM .ODT       NOTE VERY IMPORTANT
170 REM 7001/XXXX 7000
180 REM SAVE SYS DATE
190 REM .DATE   WITHOUT ARG WRITES THE "TODAY.TE" FILE
200 DIM M0$(12,10)
210 REM ^N <LARGE LETTERS>IS INSERTED EXEPT IF BACSLASH
220 FOR I= 1 TO 12
230 READ M0$(I)
240 NEXT I
250 A$=DAT$(Z)
260 FILEV#1:"TODAY.TE"
270 M$=SEG$(DAT$(Z),1,2)
280 D$=SEG$(DAT$(Z),4,5)
290 Y$=SEG$(DAT$(Z),7,8)
300 M=VAL(M$)
310 M1$=M0$(M)
320 PRINT#1:" HXF HK IC";PNT(27);"HXT HK GF JC 0A-^^;";PNT(34);
330 PRINT#1:"E0,.XT J 2D '!SAVE THE COMMENT CHAR!"
340 PRINT#1:":S.";PNT(27);PNT(34);"EZJI.FT";PNT(27);"'"
350 PRINT#1:"0LIEB";PNT(27);"ZJ@I[";PNT(27);"[HXF  !THE FILE NAME!"
360 PRINT#1:"HK GT 14UA  J 0A-92";PNT(34);
370 PRINT#1:"E HK 32UA  I/";PNT(27);"HXT HK'"
380 PRINT#1:"HK GY !THE MUNG MACRO! ZJ-L 0,.K"
390 PRINT#1:"ZJ GF";PNT(27);"MF"
400 PRINT#1:"HK GY ZJ -L 0,.K ZJ 3R D J GT 0L 2C QAI";
410 PRINT#1:PNT(27); " HXT"
420 PRINT#1:" Y J <S^";PNT(27);" 0L C 0A-^^^";PNT(34);
430 PRINT #1:"E 0LK OFOUND";PNT(27);"'L> !FOUND!"
440 PRINT#1:"GT J !"
450 PRINT #1:"^  " ;M1$;"   ";D$;"    19";Y$;"!"
460 CLOSE #1
470 DATA "JANUARY","FEBRUARY","MARCH","APRIL","MAY","JUNE"
480 DATA "JULY","AUGUST","SEPTEMBER","OCTOBER"
490 DATA "NOVEMBER","DECEMBER"
500 END
