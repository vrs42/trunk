RTN,	PUTFLAC		/NEGATIVE NUMBER ENDS FNTBL
	CDI P
	JMP I (EFUN3
/////

CMATST,	0		/TEST FOR A COMMA - 'TSTCMA'
	GETCHAR
	TAD (-",
	SZA CLA
	JMP I CMATST	/FIRST RETURN IF IT'S NOT
	GETC
	ISZ CMATST
	JMP I CMATST	/REMOVE IT AND TAKE 2ND RETURN
/////

ERR,	0		/PRINT AN ERROR MESSAGE - 'ERROR2'
	CLA
	TAD ERR
	CDI P
	DCA I (ERROR
	JMP I (ERROR+1
/////

OUTDG,	0		/PRINT BCD DIGIT IN AC - 'PRINTD'
	TAD ("0		/SOMEWHAT DIFFERENT THAN FIELD 1 VERSION
	PRINTC
	JMP I OUTDG
/////

ABSOLV,	0		/TAKE THE ABSOLUTE VALUE 
	TAD HORD
	DCA SIGN
	JMS RESOLV
	JMP I ABSOLV

RESOLV,	0		/RESTORE THE PROPER SIGN
	TAD SIGN
	SPA CLA
	JMS INVERT
	JMP I RESOLV

INVERT,	0		/COMPLEMENT FLAC - 'NEGATE'
	TAD OVER
	CLL CIA
	DCA OVER
	CML RAL
	TAD LORD
	CIA
	DCA LORD
	CML RAL
	TAD HORD
	CIA
	DCA HORD
	JMP I INVERT
/////
SGNCHK,	0
	JMS ABSOLV
	STL		/COMPATABILITY W/FIELD 1 ROUTINE
	TAD SIGN
	SZA
	ISZ SGNCHK	/FIRST RETURN IF ZERO
	JMP I SGNCHK
/////

FLOT,	0		/'FLOAT'
	DCA HORD
	DCA LORD
	DCA OVER
	TAD HORD
	SZA CLA		/A LITTLE NICER THAN THE FIELD 1 VERSION
	TAD P13
	DCA EXP
	JMP I FLOT

FLOATX,	JMS FLOT
	RETURN

FL0ATX,	CDI P
	JMP I (FL0AT

NORM,	0		/NORMALIZE ROUTINE
	CDI P
	JMS I (XNORM
	JMP I NORM

XRTL6,	0		/ROTATE THE AC LEFT SIX - 'RTL6'
	CLL RTL
	RTL
	RTL
	JMP I XRTL6

