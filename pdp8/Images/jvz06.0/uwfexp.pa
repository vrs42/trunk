CHRGET,	0		/COPY FIELD 1 CHAR TO FIELD F CHAR
	CLA
	CDF P
	TAD I (CHAR
	DCA CHAR
	CDF F
	TAD CHAR
	JMP I CHRGET
/////

GETCF,	0
	CIF P
	JMS I (CGET
	JMS CHRGET
	JMP I GETCF
/////

CRTEST,	0		/SKIP IF CHAR IS A CR - 'TESTCR'
	JMS CHRGET
	TAD MCR
	SNA CLA
	ISZ CRTEST
	JMP I CRTEST
/////

CTEST,	0		/TEST THE NEXT CHARACTER - 'TESTC'
	JMS XSPNOR	/IGNORE SPACES
	JMS XTEST	/CHECK ALL THE TERMINATORS
	JMP I CTEST	/IT WAS A TERM - SORTCN (FIELD 1) IS SET
	TAD CHAR
	TAD (-"F
	SNA CLA
	JMP XT3		/FUNCTION
	JMS NTEST
	SKP		/PERIOD
	ISZ CTEST	/OTHER
	ISZ CTEST	/NUMBER
XT3,	ISZ CTEST
	JMP I CTEST	/RETURNS: T;F;N;V
/////
XTEST,	0		/TEST IF CHAR IS A TERMINATOR - 'TESTX'
	JMS CHRGET
	CIF P
	JMS I (TESTX1
	ISZ XTEST	/NO
	JMP I XTEST	/YES
/////

XSORT,	0		/COMMAND WORD SORT - 'SORTX'
	JMS CRTEST
	TAD M240	/-SPACE
	SZA
	TAD CHAR	/NOT CR
M240,	SMA SZA
	TAD (SP-";	/SEMICOLON
	SPA
	TAD P17		/COMMA
	SNA CLA
	ISZ XSORT	/ONE OF THE ABOVE
	JMP I XSORT

XSPNOR,	0		/IGNORE INTERVENING SPACES - 'SPNOR'
	JMS CHRGET	/COPY FIELD 1 CHAR TO FIELD F CHAR
	TAD M240
	SZA CLA
	JMP I XSPNOR
	JMS GETCF
	JMP XSPNOR+2
/////

NTEST,	0		/TEST FOR PERIOD, NUMBER - 'TESTN'
	JMS CHRGET
	TAD (-".
	SZA
	ISZ NTEST
	TAD M14		/TEST FOR 0-9
	CLL
	TAD P12
	CDF P		/LOT OF TROUBLE JUST
	DCA I (SORTCN	/TO SET SORTCN
	CDF F		/
	SZL
	ISZ NTEST
	JMP I NTEST
P12,	12

	PAGE
CMNLST,	0
	0
	0
	0
	0
	0
	0
	0		/SHOULD BE MORE THAN ENOUGH


CONTF,	CDI P		/NEGATIVE NUMBER ENDS CMNLST
	JMP I (CONT

ABSV,	0		/FIXIT; CHECK FOR ZERO; TAKE ABS(LORD)
	FIXIT
	SNA
	JMP I ABSV	/FIRST RETURN IF ZERO
	SPA
	CIA
	ISZ ABSV
	JMP I ABSV
/////



CMNDGO,	CERR
	CERR
	CERR
	CERR
	CERR
	CERR
	CERR
	CERR


XPAND,	GETFLAC
	SORTJ
	   CMNLST-1
	   CMNDGO-CMNLST
CERR,	CDI P		/MUST BE AT 0636
	JMP I (PC1+11
/////

FNCTN,	IFZERO EAE <TAD I (DCAT2; CDF F; CIA>
       IFNZRO EAE <MQA>
	GETFLAC		/NEGATIVE # ENDS CMNLST
	SORTJ
	   FNTBL-1	/THESE TWO LOCATIONS CAN BE PATCHED
	   FNTBF-FNTBL	/TO RELOCATE THE FUNCTION TABLES
ERROR3,	CDI P		/NOT IN 2ND FUNCTION TABLE
	JMP I (ELPAR
IFNZRO	EAE <*.+2>
/////
IFZERO	EAE <

XTEN,	0		/MULTIPLY THE FLAC BY 10 (DECIMAL)
	DCA ABSV		/AND ADD IN THE C(AC) AT THE END
	TAD OVER
	DCA OVR1
	TAD LORD	/TRIPLE PRECISION MULTIPLY
	DCA AC1L	/BY TEN (DECIMAL)
	TAD HORD	/EX1 = REMAINDER
	DCA AC1H
	DCA EX1		/CLEAR OVERFLOW WORD
	JMS MULT2	/CALL SUBROUTINE TO
	JMS MULT2	/MULTIPLY BY TWO
	JMS DUBLAD	/CALL (TRIPLE) ADD
	JMS MULT2
	TAD ABSV		/ADD LAST DIGIT RECEIVED
	DCA OVR1
	DCA AC1L
	DCA AC1H
	JMS DUBLAD
	JMP I XTEN	/EXECUTION TIME = 200 MICROSECOND >
/////

IFNZRO	EAE <
XTEN,	0		/MULTIPLY THE FLAC BY 10 (DECIMAL)
	SWAB		/AND ADD IN C(AC)
	TAD OVER
	SWP MUY
	    P12
	SWP
	DCA OVER
	TAD LORD
	SWP MUY
	    P12
	SWP
	DCA LORD
	TAD HORD
	SWP MUY
	    P12
	SWP
	DCA HORD
	SWP		/AC = OVERFLOW
	JMP I XTEN	/EXECUTION TIME = 50 MICROSECONDS >
/////
DIV2,	0		/SHIFT FLAC RIGHT
	CLA CLL
	TAD HORD
	SPA
	CML
	RAR
	DCA HORD
	TAD LORD
	RAR
	DCA LORD
	TAD OVER
	RAR
	DCA OVER
	ISZ EXP
	JMP I DIV2
	JMP I DIV2
/////

MULT2,	0		/MULTIPLY FLAC BY 2 - 'SHIFTL'
	TAD OVER
	CLL RAL
	DCA OVER
	TAD LORD
	RAL
	DCA LORD
	TAD HORD
	RAL
	DCA HORD
	JMP I MULT2	/DOES NOT CHANGE 'EXP'
/////

DUBLAD,	0		/TRIPLE PRECISION ADDITION
	CLL
	TAD OVR1
	TAD OVER
	DCA OVER
	RAL
	TAD AC1L
	TAD LORD
	DCA LORD
	RAL
	TAD AC1H
	TAD HORD
	DCA HORD
	JMP I DUBLAD
/////
SORTB,	0		/SORT AND BRANCH ROUTINE - 'SORTJ'
	SNA
	GETCHAR		/COPY FIELD 1 CHAR TO FIELD F
IFZERO	EAE <CIA; DCA ABSV>
IFNZRO	EAE <SWAB>
	TAD I SORTB	/FIRST ARGUMENT IS LIST-1
	ISZ SORTB
	DCA XRT	
	TAD I XRT
	SPA		/LISTS ARE ENDED BY NEGATIVE #'S
	JMP SEX		/NOT THERE!
IFZERO	EAE <TAD ABSV>
IFNZRO	EAE <SAM>
	SZA CLA		/MATCH?
	JMP .-5		/NOT REALLY
	TAD XRT
	TAD I SORTB	/COMPUTE ADDRESS
	DCA SORTB
	TAD I SORTB	/DEBUG: AC= ADDRESS
	DCA SORTB
	JMP I SORTB

SEX,	SZA CLA		/CLEAR AC IF NO MATCH
	ISZ SORTB	/TAKE THE SECOND EXIT
	JMP I SORTB
/////

	PAGE
JFPUSH,	0		/RECURSIVE SUBROUTINE CALL FOR FIELD F
	CLA
	TAD I JFPUSH	/GET THE TARGET ADDRESS
	DCA XPUSHA	/SAVE FOR THE INDIRECT JUMP
	TAD JFPUSH	/GET THE RETURN ADDRESS
	IAC		/BUMP IT
	SKP		/AND PUSH IT ON THE STACK

XPUSHA,	0
	CDI P
	JMS I (APUSHX
	JMP I XPUSHA

XPUSHJ,	0		/RECURSIVE SUBROUTINE CALL FOR FIELD 1
	CLA
	TAD I XPUSHJ	/GET THE TARGET ADDRESS
	CDI P
	JMS I (JPUSH1	/GO DO A PUSHJ IN FIELD 1
	JMS FLACGT	/MAKE IT EASY TO USE EVAL
	ISZ XPUSHJ	/BUMP RETURN ADDRESS
	JMP I XPUSHJ
XPOPA,	0		/PULL SOMETHING OFF THE STACK
	DCA XPUSHA	/SAVE THE AC
	CDF P
	ISZ I (PDLXR	/INCREMENT STACK POINTER
	TAD I (PDLXR	/GET STACK POINTER
	DCA JFPUSH	/HANDY LOCATION
	TAD XPUSHA	/RESTORE AC
	CDF S
	TAD I JFPUSH	/ADD IN STACK ELEMENT
	CDF F
	JMP I XPOPA

XPOPJ,	0
	CDF P
	ISZ I (PDLXR	/INCREMENT STACK POINTER
	TAD I (PDLXR	/GET STACK POINTER
	DCA JFPUSH	/HANDY LOCATION
	CDF S
	TAD I JFPUSH	/GET THE RETURN ADDRESS
	DCA XPOPA
	JMP XPOPA+11	/RESTORE DATA FIELD & BRANCH

XPUSHF,	0		/SAVE A FLOATING-POINT NUMBER
	TAD XPUSHF
	CDI S		/USE FIELD 0 ROUTINE FOR THIS
	DCA I (MPUSHF
	CDF F		/RESET THE CALLING FIELD
	TAD .-1		/FORCE A RETURN TO FIELD F
	JMP I (MPUSHF+3

XPOPF,	0		/RESTORE A FLOATING-POINT NUMBER
	CLA CMA
	TAD I XPOPF	/BACKUP DATA POINTER
	ISZ XPOPF	/AND ADVANCE THE RETURN
	DCA XRT
	JMS XPOPA	/DUMP FOUR WORDS
	DCA I XRT
	JMS XPOPA
	DCA I XRT
	JMS XPOPA
	DCA I XRT
	JMS XPOPA
	DCA I XRT
	JMP I XPOPF
FLACGT,	0		/MAKE LOCAL COPY OF FIELD 1 FLAC
	DCA FLACPT
	CDF P
	TAD I (EXP
	DCA EXP
	TAD I (HORD
	DCA HORD
	TAD I (LORD
	DCA LORD
	TAD I (OVER
	DCA OVER
	CDF F
	TAD FLACPT
	JMP I FLACGT
/////

FLACPT,	0		/SET FIELD 1 FLAC = LOCAL FLAC
	DCA FLACGT
	CDF P
	TAD EXP
	DCA I (EXP
	TAD HORD
	DCA I (HORD
	TAD LORD
	DCA I (LORD
	TAD OVER
	DCA I (OVER
	CDF F
	TAD FLACGT
	JMP I FLACPT
/////
XGETLN,	0		/GET A LINE NUMBER - 'GETLN'
	CIF P
	JMS I (GETLNX
	TAD I (NAGSW
	DCA NAGSW
	TAD I (LINENO
	DCA LINENO
	CDF F
	JMP I XGETLN
/////

FLOUTP,	0		/CONVERT BINARY TO ASCII - 'PRINTN'
	CDI P
	JMS I (NPRINT
	JMP I FLOUTP
/////

CHOUT,	0		/OUTPUT A CHARACTER - 'PRINTC'
	SNA
	TAD CHAR
	CIF P
	JMS I (CPRINT
	JMP I CHOUT
/////

FIXER,	0		/COPIES FIELD F FLAC TO
	JMS FLACPT	/FIELD 1 FLAC, FIXES IT, THEN
	CIF P		/COPIES THE RESULT BACK TO FIELD F
	JMS I (FIX
	JMS FLACGT
	JMP I FIXER
/////

