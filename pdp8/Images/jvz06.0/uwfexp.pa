/ UWF FUNCTION EXPANSION PACKAGE	JAN-80


XLIST
MUY=	7405
SWAB=	7431
SAM=	7457
XLIST

	CDI=CDF CIF
	FIXTAB

	PDLXR=13
	SORTCN=65
	LASTC=71
	PC1=625
	CONT=755
	EFUN2=1742
	ELPAR=1753
	FL0AT=2021
	EFUN3=2026
	FNTABL=2156
	FNTABF=2356
	ERROR=2555
	DCAT2=2666
	MPUSHF=3042

	S=00		/DATA FIELD FOR STACK
	P=10		/DATA FIELD FOR PROCESSOR
IFNDEF F<F=60>		/DATA FIELD FOR FUNCTIONS
IFNDEF SLOT<SLOT=3400>	/FIELD 1 SUPPORT FOR FIELD F ROUTINES
IFNDEF EAE<EAE=0>	/EAE = 1   NON-EAE = 0

	CR=215
	SP=240
	FIELD P%10
	*EFUN2+6
	JMP I .+1	/PATCH THE FUNCTION TABLE SORT
	FUNCTN
	0

	*SLOT

FUNCTN,	SORTJ
	  FNTABL-1
	  FNTABF-FNTABL
IFZERO	EAE <CIF F>
IFNZRO	EAE <CDI F>
	JMP I.+1	/GO SEARCH 2ND FUNCTION TABLE
	FNCTN

EXPAND,	TAD LASTC	/COMMAND EXPANSION
	CDI F
	JMP I .+1
	XPAND

APUSHX,	0		/IMPLEMENT 'PUSHA' FOR FIELD F
	PUSHA
	CDI F
	JMP I APUSHX

TESTX1,	0		/IMPLEMENT 'TESTX' FOR FIELD F
	TESTX
	ISZ TESTX1
	CIF F
	JMP I TESTX1

FIX,	0		/IMPLEMENT 'FIXIT' FOR FIELD F
	FIXIT
	CIF F
	JMP I FIX

CGET,	0		/IMPLEMENT 'GETC' FOR FIELD F
	GETC
	CIF F
	JMP I CGET

TSTLPR,	0		/IMPLEMENT 'LPRTST ROUTINE' FOR FIELD F
	JMS I .+4	/JMS TO FIELD 1 LPRTST
	ISZ TSTLPR	/NOT A LEFT-PAREN
	CIF F		/CHAR IS A LEFT-PAREN
	JMP I TSTLPR
	1760

JPUSH1,	0		/DO A PUSHJ IN FIELD 1
	DCA .+2		/AND RETURN TO FIELD F
	PUSHJ
	  0
	CDI F
	JMP I JPUSH1
XNORM,	0		/IMPLEMENT 'NORMALIZE' FOR FIELD F
	NORMALIZE
	CDI F
	JMP I XNORM

GETLNX,	0		/IMPLEMENT 'GETLN' FOR FILED F
	GETLN
	CIF F
	JMP I GETLNX

CPRINT,	0		/IMPLEMENT 'PRINTC' FOR FIELD F
	DCA CHAR	/CAN EVEN PRINT NULLS
	PRINTC
	CDI F
	JMP I CPRINT

NPRINT,	0		/IMPLEMENT 'PRINTN' FOR FIELD F
	PRINTN
	CDI F
	JMP I NPRINT
	FIELD F%10
	*7
	16400		/POINTER TO FPP
	*14
XRT,	0

	*33
RTL6=	JMS I .		/ROTATE AC LEFT 6
	XRTL6
CONTINUE=JMP I .	/COMMAND RETURN
	CONTF
NORMALIZE=JMS I .	/NORMALIZE C(AC)
	NORM

	*36
ABSOL,	ABSOLV		/TAKE THE ABSOLUTE VALUE
RESOL,	RESOLV		/RESTORE THE PROPER SIGN
SIGN,	0		/FOR ABS VALUE

	*44
FLAC=.
EXP,	0		/FLOATING ACCUMULATOR
HORD,	0
LORD,	0
OVER,	0
FLOP=.
EX1,	0		/FLOATING OPERAND
AC1H,	0
AC1L,	0
OVR1,	0

	*66
CHAR,	0
LINENO,	0		/SET BY 'GETLN'
NAGSW,	0		/'NOT ALL' AND/OR 'GROUP' SWITCH

/USEFUL CONSTANTS

	*73
P7,	7
P13,	13
P177,	177
P43,	43
P77,	77
C100,	100
P17,	17
C200,	200
C240,	240
P7600,	7600
M4,	-4
M5,	-5
M14,	-14
MCR,	-CR
M1,	-1
/ NEW INSTRUCTIONS

	*120
PUSHA=	JMS I .		/SAVE THE AC ON THE STACK
	XPUSHA
POPA=	JMS I .		/UNLOAD THE STACK
	XPOPA
PUSHJ=	JMS I .		/CALL A SUBROUTINE IN FIELD 1
	XPUSHJ
POPJ=	JMS I .		/RETURN FROM A SUBROUTINE
	XPOPJ
PUSHF=	JMS I .		/SAVE 4 WORDS
	XPUSHF
POPF=	JMS I .		/RESTORE THEM
	XPOPF
SORTJ=	JMS I .		/SORT AND BRANCH ON AC OR CHAR
	SORTB
SORTX=	JMS I .		/LOOK FOR SP, COMMA, SEMI, CR
	XSORT
TESTC=	JMS I .		/TEST FOR TERM, FN, NO., OR VAR
	CTEST
TESTX=	JMS I .		/TEST FOR TERM AND SET SORTCN
	XTEST
TESTN=	JMS I .		/TEST FOR PERIOD, NUMBER
	NTEST
	0		/RESERVED FOR FUTURE EXPANSION
PRINTC=	JMS I .		/PRINT C(AC) OR 'CHAR' (IF AC = 0)
	CHOUT
PRINTD=	JMS I .		/PRINT A SINGLE DIGIT FROM THE AC
	OUTDG
	0		/RESERVED FOR FUTURE EXPANSION
PRINTN=	JMS I .		/CONVERT BINARY TO ASCII (MAYBE PRINT)
	FLOUTP
ABSVAL=	JMS I .		/CALL FIXIT; CHECK FOR 0; TAKE ABS(LORD)
	ABSV
GETC=	JMS I .		/UNPACK A CHARACTER
	GETCF
SPNOR=	JMS I .		/IGNORE LEADING SPACES
	XSPNOR
TSTCMA=	JMS I .		/SKIP IF CHAR=COMMA & MOVE PAST IT
	CMATST
TESTCR=	JMS I .		/SKIP IF CHAR = CR
	CRTEST
GETLN=	JMS I .		/COMPUTE A LINE NUMBER (RECURSIVE)
	XGETLN
/ SPECIAL FIELD F ROUTINES
GETCHAR=JMS I .		/MAKE FIELD F CHAR & AC = FIELD 1 CHAR
	CHRGET
PUSHJF=	JMS I .		/PUSHJ FOR FIELD F
	JFPUSH
GETFLAC=JMS I .		/MAKE A LOCAL COPY OF FIELF 1 FLAC
	FLACGT
PUTFLAC=JMS I .		/SET FIELD 1 FLAC = FIELD F FLAC
	FLACPT
/ END OF SPECIAL FIELD F ROUTINES



FLOAT=	JMS I .		/FLOAT THE AC
	FLOT
FLOATR=	JMP I .		/FLOAT THE AC AND RETURN
	FLOATX
FL0ATR=	JMP I .		/UNSIGNED FLOAT AND RETURN
	FL0ATX
RETURN=	JMP I .		/REGULAR FUNCTION RETURN
	RTN
SHIFTL=	JMS I .		/MULTIPLY FLAC BY 2
	MULT2
NEGATE=	JMS I .		/COMPLEMENT & INCREMENT THE FLAC
	INVERT
FIXIT=	JMS I .		/CONVERT FLAC TO A 24-BIT INTEGER
	FIXER
MULT10=	JMS I .		/MULTIPLY FLAC BY 10 & ADD THE AC
	XTEN
CHKSGN=	JMS I .		/TAKE ABSOLUTE VALUE & CHECK FOR 0
	SGNCHK
	*176
ERROR2=	JMS I .
	ERR
