/65 COMMUNICATIONS HANDLER FOR RSX-11M		-JVZ-

/ THIS HANDLER ALLOWS A 'PDP/8' TO COMMUNICATE WITH THE
/RSX TERMINAL HANDLER, USING THE XON/XOFF PROTOCOL PLUS
/WAITING FOR AN EOL TO CONTROL TRANSMISSION.  LINEFEEDS
/ARE SUPPRESSED DURING OUTPUT TO AVOID 'DOUBLE-SPACING'
/AND CTRL/Z IS SENT AT THE END TO CLOSE THE FILE UNLESS
/'ZSW' CONTAINS A NON-ZERO VALUE.  'SET RSX: LOC 100=1'
/WILL SET 'NO CTRL/Z MODE' WHICH SUPPRESSES EOF CHARAC-
/TERS SO YOU CAN COMBINE SEVERAL DIFFERENT OUTPUT FILES
/INTO A SINGLE RSX FILE.  'SET RSX: LOC 100=0' RESTORES
/NORMAL OPERATION.

/INPUT FROM THE '11 IS STARTED BY SENDING A 'CR', WHILE
/THE 'END-OF-FILE' IS DETERMINED BY AN ADJUSTABLE TIME-
/OUT LOOP (CHANGED WITH A 'SET RSX: LOC 300=N' COMMAND,
/N=0,1,2,3...).  TO AVOID HAVING THE RSX COMMAND PROMPT
/APPEAR AT THE END OF THE OS/8 FILE,  FOLLOW THE 'COPY'
/COMMAND WITH A TWO-SECOND 'WAIT'.   THE HANDLER STORES
/UP TO 8 'OVERFLOW' CHARACTERS INTERNALLY BETWEEN CALLS
/SO PROGRAMS LIKE FORTRAN-IV WHICH SWAP HANDLERS DURING
/THE I/O PROCESS WILL NECESSARILY LOSE PART OF THE DATA
/UNLESS THE OUTPUT FILE IS ON THE SYSTEM DEVICE.   NOTE
/THAT -ANY- OUTPUT SENT TO THE TERMINAL CAN BE SAVED IN
/AN OS/8 FILE SIMPLY BY LETTING THE HANDLER SEND THE CR
/TO TERMINATE THE COMMAND LINE.  (YOU CAN TYPE THE 'CR'
/IF YOU IMMEDIATELY STOP ALL OUTPUT BY TYPING 'CTRL/S';
/THE HANDLER WILL SEND A 'CTRL/Q' AND A 'CR' WHEN IT IS
/READY FOR THE TRANSMISSION TO RESUME.)

	VERSION="D&77
/	VT278=.		/DEFINE THIS FOR VT/278'S

IFNDEF	INDVC <INDVC=40>/DEFAULT DEVICE CODE
IFNDEF	OUTDVC <OUTDVC=INDVC+1>

KKFL=	INDVC^10+IOT 0	/VT278 SETFLAG INSTR.
KKSF=	INDVC^10+IOT 1	/SKIP ON INPUT FLAG
KKRB=	INDVC^10+IOT 6	/READ CHAR AND CLEAR FLAG

TTSF=	OUTDVC^10+IOT 1	/SKIP ON DONE FLAG
TTLS=	OUTDVC^10+IOT 6	/SEND CHAR, LEAVE IN THE AC

	PAGE 0
	-1		/ONE ENTRY POINT
DEVICE	RSX
DEVICE	RSX
	410		/DCB WORD (R/W/NONFILE, DEV 41)
	RSX&177+4000	/ENTRY POINT (PLUS 2-PAGE FLAG)
ZBLOCK	2
	PAGE 1

RSX,	VERSION		/VERS. NUMBER FOR 'RESORC'
	CLA STL RTL	/2=CDI-CDF
	RDF
	TAD CDF0
	DCA CDIX	/SAVE RETURN 'CDI'
	STL RAR		/4000
	TAD I RSX	/PUT R/W BIT IN THE LINK
XON,	AND V70		/GET BUFFER FIELD
	TAD CDF0
	DCA TEMP	/PUT INLINE FOR ONCE-ONLY USE
	TAD I RSX
	ISZ RSX		/BUMP TO BUFFER ADDRESS
	AND V3700	/STRIP PAGE COUNT
	SNA
	JMP VXIT	/IGNORE INITIALIZATION CALLS
	CIA
	DCA DWC		/SAVE DOUBLE-WORD COUNT

IFNZRO	.&177-21	<'XON' WON'T BE CORRECT>
V70,	70

	TAD I RSX	/GET BUFFER ADDRESS
	DCA BAD
TEMP,	HLT		/CDF TO BUFFER FIELD
	SNL		/READ OR WRITE?
	JMP READ

WRIT,	RTL		/SHIFT GUARD BIT
	RTL
	SPA		/TEST IT
	JMP WNO3	/TIME FOR THE THIRD BYTE
	DCA TEMP
	TAD I BAD	/GET FIRST OR SECOND BYTE
	JMS PUTC
	TAD SAVE
	ISZ BAD		/BUMP TO NEXT WORD
V7400,	NOP I
	AND .-1
	CLL RAL		/PACK THE BITS TOGETHER
	TAD TEMP
	JMP WRIT	/SHIFT INTO PROPER POSITION

WNO3,	JMS PUTC	/AC HAS SHIFT REGISTER
	CLA STL
	ISZ DWC		/DONE?
	JMP WRIT	/NO
	JMP VXIT	/YES
INP,	0		/=ADDRESS OF INPUT ROUTINE
	JMS I INP	/GET BYTE NO. 1
	DCA TEMP
	JMS I INP	/GET BYTE NO. 2
	DCA PUTC
	JMS I INP	/GET BYTE NO. 3
	JMS SAVE	/STORE FIRST WORD
	TAD PUTC
	DCA TEMP
	TAD CTRLC
	JMS SAVE	/STORE SECOND WORD
	ISZ DWC
	JMP INP+1	/DO THREE MORE
	CLA IAC
	JMS I INP	/SAVE OVERFLOW CHARACTERS

VXIT,	ISZ RSX		/MOVE PAST BUFFER ADDRESS
	ISZ RSX		/ "    "   BLOCK NUMBER
	ISZ RSX		/ "    "   ERROR RETURN
CDIX,	HLT		/CDF CIF TO CALLING FIELD
	JMP I RSX

BAD,	0		/BUFFER ADDRESS
DWC,	0		/BUFFER SIZE (%2)
IFNZRO	.&177-100	<'ZSW' WON'T BE AT '100'>
ZSW,	0		/EOF SWITCH

SAVE,	0		/STORE 1-1/2 BYTES IN 1 WORD
	RTL
	RTL		/SHIFT HALF-BYTE TO BITS 0-3
	DCA CTRLC
	TAD CTRLC
	AND V7400
	TAD TEMP	/MERGE WITH BITS 4-11
	DCA I BAD
	ISZ BAD
V177,	177		/PROTECTS THE 'ISZ'
	JMP I SAVE

CTRLC,	0
	KRS		/DON'T CLEAR KB FLAG
	AND V177	/STRIP TO SEVEN BITS
	TAD M3
	SNA CLA		/CTRL/C?
	KSF		/YES: FLAG UP?
	JMP I CTRLC	/NO
CDF0,	CDF		/BE SURE TO DO THIS!
	JMP I V7600	/RECALL OS/8 MONITOR
PUTC,	0		/OUTPUT ROUTINE
	DCA SAVE	/SAVE CHARACTER
	TAD SAVE
	AND V177
	SNA
	JMP I PUTC	/IGNORE NULLS
	TAD M12
	SNA
	ISZ INP		/CHECK LF SWITCH
	JMP NLF

EOL,	JMS CTRLC	/WAIT FOR LF AFTER A CR
	KKSF
	JMP EOL
	KKRB
	AND V177	/('11S USE 7-BIT ASCII)
	TAD M12
	SZA CLA
	JMP EOL
	JMP I PUTC	/IGNORE LF AFTER CR

NLF,	TAD M4
	DCA INP		/RESET LF SWITCH
	TAD INP
	TAD M14
	STL CIA		/CTRL/Z CLEARS LINK
V7600,	CLA I
	TAD ZSW		/CHECK EOF SWITCH
	SZL SNA CLA
	TAD SAVE	/SKIP TO SUPPRESS EOF

	TTLS		/SEND THE CHARACTER
	SNL CLA
	JMP VXIT	/EXIT HERE ON CTRL/Z
	TTSF
	JMP .-1
	JMP I PUTC	/DONE

M3,	-3
M4,	-4
M12,	-12
M14,	-14
V3700,	3700

	*.!177-3	/PUTS 'JMS INP' AT 'GETC-1'
READ,	TAD XON		/BE SURE OUTPUT IS ENABLED
	JMS PUTC
	STL RAR		/4000 = NEW CALL
	JMS INP		/START INPUT LOOP

	PAGE
/THIS PAGE HAS THE INPUT ROUTINE WHICH HAS TO RECOGNIZE
/WHEN RSX-11M HAS FINISHED SENDING DATA SO IT CAN PUT A
/CTRL/Z IN THE BUFFER, FILL IT OUT WITH NULLS, AND TAKE
/THE ERROR RETURN WITHOUT SENDING 'XOFF'.  THIS ROUTINE
/ALSO TURNS MULTIPLE LF'S INTO MULTIPLE CRLF'S AND BUF-
/FERS ANY EXTRA CHARACTERS WHICH ARE RECEIVED AFTER THE
/VAX HAS BEEN SENT AN 'XOFF'.

GETC,	(177		/GETS US V377
	SPA
	JMP NO1		/FIRST CALL
	SZA CLA
	JMP EOB		/END OF BUFFER
TADC,	TAD CHAR
	SPA CLA		/READ FROM SILO?
	ISZ .+1
HOLD,	HLT		/'TAD SILO'
	SNA
BOB,	JMS FETCH
C232,	AND C377	/ONLY KEEP 8 BITS
	JMP I GETC	/RETURN CHARACTER

NO1,	DCA CHAR	/4000
	TAD TADC
	DCA HOLD	/INITIALIZE SILO
	TAD FLAG	/FIRST CALL AFTER EOF?
/	SZA CLA
ONCE,	JMP SILO	/ONCE-ONLY CODE
	JMP HOLD-1	/RETURN SAVED CHARACTERS
C3,	15-12
	DCA HOLD
	TAD C1215	/START THINGS WITH A 'CR'
	TTLS

GET2,	JMS CCHK	/SKIP THE COMMAND LINE
	JMP .-1
	KKRB
C377,	AND (177	/FOUND THE LF YET?
	TAD (-12
	SZA CLA
	JMP GET2
	JMS CCHK	/WAIT FOR FIRST CHAR
	JMP .-1		/WITHOUT TIMING OUT!
IFNDEF	VT278 <NOP>
IFDEF	VT278 <KKFL>	/KLUDGE TO ZAP EXTRA CR
	JMP BOB		/(THANKS A LOT, DEC...)
EOB,	TAD CHAR	/BUFFER IS FULL, ARE WE AT EOF?
	SZA CLA
	JMP C1215	/NO
	ISZ GETC	/SKIP ONE 'ISZ RSX' INSTRUCTION
	JMP FLAG-1	/SET DONE FLAG

	ISZ XCHK	/WATCH FOR OVERFLOW
	JMP BLOOP
C1215,	TAD NO1		/RESET SILO POINTER
	DCA INST
	TAD (-12	/SILO SIZE
	DCA XCHK
	TAD XOFF	/SEND 'XOFF'
	TTLS

BLOOP,	JMS FETCH	/BUFFER THE OVERFLOW CHARS
	ISZ .+1
INST,	HLT		/'DCA SILO'
	TAD CHAR
SKIP,	SZA CLA		/DONE?
	JMP C1215-2	/NO
	TAD INST
	DCA FLAG	/REMOVE EOF CHARACTER
FLAG,	CTRLC-INP-2
	JMP I GETC

CCHK,	0		/CHECK KB, INPUT FLAGS
	JMS I CCCP
	KKSF
	SKP CLA
	ISZ CCHK
	JMP I CCHK
CCCP,	CTRLC

IFNZRO	.&177-100	<DIDN'T GET THIS AT '300'>
DELAY,	0 /1 /2 /3 ...	/ADJUST THIS IF NECESSARY

CHAR,	0		/MUST BE AT 'SILO-1'
SILO,	TAD GETC
	DCA CCCP	/COMPUTE PAGE 1 ADDRESS
	TAD SKIP
	DCA ONCE
	JMP C3+1	/EIGHT SHOULD BE ENOUGH
	ZBLOCK 3
TIMER,	0		/PLUS 2 MORE TO BE SAFE

FETCH,	0
	TAD CHAR	/CHECK FOR EOF
	ISZ FLAG	/CRLF,LF => CRLF,CRLF
	SNA CLA
	JMP I FETCH
CNTDN,	DCA CHAR	/START COUNTDOWN
	TAD DELAY
	CMA
	DCA TIMER
WAIT,	JMS CCHK
	JMP LOOP
	KKRB		/GET CHARACTER
	DCA CHAR
	TAD CHAR
	AND (177	/NO NULLS, PLEASE
	SNA
	JMP CNTDN
	TAD (-12	/WATCH THOSE LINEFEEDS!
	SZA CLA
	JMP XOFF+1
	STL CMA
	TAD FLAG	/WAS LAST CHAR A LF TOO?
	SNA CLA
	STL CMA
	DCA FLAG	/YES, REPLACE WITH CR/LF
	SZL
XOFF,	TAD C3		/CR-LF
	TAD CHAR
	JMP I FETCH

LOOP,	ISZ TIMER	/TEST FOR TIMEOUT
	JMP WAIT
	ISZ CHAR	/GOES TO 0 AT EOF
	JMP CNTDN+1
	TAD C232
	JMP I FETCH	/RETURN CTRL/Z

XCHK,	0		/CHECK HOSTSYNC SIGNALS
	KKSF
	JMP XIT
	KKRB
	AND (177	/EITHER 'XON' OR 'XOFF'
	TAD (-22
	TAD XSW		/CHECK FOR THE OPPOSITE
	SZA CLA
	JMP XIT
	TAD XSW		/TOGGLE BETWEEN THE TWO
	CIA
	DCA XSW
XIT,	TAD XSW		/RETURN STATUS CONDITION
	JMP I XCHK
XSW,	-1

	$END$
