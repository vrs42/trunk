C FORTRAN IV PLOTTER DEMO (OS/8 HANDBOOK P 8-144)

	DIMENSION NAME(30)
	ITTY=4
	WRITE(ITTY,100)
100	FORMAT(1X,'TYPE IN TEXT (30 CHARACTER MAX)')
	READ(ITTY,200)NAME
200	FORMAT(30A1)
	WRITE(ITTY,150)
150	FORMAT(1X,'HOW MANY CHARACTERS DID YOU TYPE IN?')
	READ(ITTY,250)NN
250	FORMAT(I2)
	CALL PLOTS(.01,0)
	CALL XYPLOT(0,-12,-3)
	CALL XYPLOT(0,5.5,-3)
	RAD=3
	SIZE=.1225*RAD
	ORIG=SIZE*NN
	SPIR=.995
	CONV=180./3.1415
	ANG=0.
	BANG=1.5707
	DO 300 J=1,NN
300	CALL SYMBOL((J-1)*SIZE,RAD,SIZE,NAME(J),ANG,1)
380	DO 400 J=1,NN
	T=2*ATAN(SIZE/(2.*RAD))
	ANG=ANG-T*CONV
	X=RAD*COS(BANG)
	Y=RAD*SIN(BANG)
	BANG=BANG-T
	RAD=RAD*SPIR
	SIZE=.1225*RAD
400	CALL SYMBOL(X+ORIG,Y,SIZE,NAME(J),ANG,1)
	IF(SIZE-.07)500,500,380
500	CALL XYPLOT(12,-5,-3)
	CALL PLEXIT
	END
