/FLOATING POINT PACKAGE FOR U/W-FOCAL

	*FPUTIPT1
FPNT,	0		/VIA 'FENT'
	CLA		/POINTS TO 'MOV' - SEE 'FLEX'
	RDF
	TAD CDI0	/ALLOW CALLS FROM ANY FIELD!
	DCA .+1
CDIX,	CDI P
	TAD I FPNT
	SNA
	JMP I FPNT	/EXIT
	CIF		/RESET I.F.
	JMP .+1		/AVOID RTS/8 OVERHEAD
	CLL RTL		/SHIFT PAGE BITS OVER AND
	RTL		/PUT OPERATION CODE IN 9-11
	DCA LSORT
	TAD LSORT	/PAGE 0?
	SPA CLA
	TAD FPNT	/GET CURRENT PAGE
	AND P7600
	DCA T1		/SAVE PAGE, GET RELATIVE
	TAD I FPNT
	AND P177
	TAD T1		/MERGE
	SNL		/IS IT INDIRECT?
	JMP NOTID	/NO
	SNA		/IS IT OUT-OF-FIELD?
	JMP CDFV	/YES
	DCA T1
	TAD I T1	/GET THE INDIRECT ADDRESS
NOTID,	CIA
	CMA CLL		/BACKUP ONE
	DCA XRT2	/LOAD THE INDEX REGISTER

	ISZ FPNT	/ADVANCE PROGRAM COUNTER
	TAD LSORT	/GET BACK THE INSTRUCTION
	AND P7		/MASK THE OP CODE
	SNA
	JMP FLGT
	TAD M6		/TEST IT
	SNA
	JMP FLPT
	TAD JUMPX	/SOMETHING ELSE
	DCA LSORT
	TAD I XRT2	/LOAD THE OPERAND
	DCA EX1
	TAD I XRT2
	DCA AC1H
	TAD I XRT2
	DCA AC1L
	TAD I XRT2	/'DCA OVER' FOR 3-WORD VERSION
	DCA OVR1
	CDF P
LSORT,	0		/BRANCH TO THE PROPER ROUTINE
	SKP CLA		/LOWER FIELD COMMAND SCANNER
	GETC
	SORTX		/SEARCH FOR END OF THE 2ND WORD
	JMP .-2
	SPNOR		/SKIP TO THE START OF THE THIRD
	CIF L
	JMP I LSORT	/NOTE: 'CHAR' PRESERVED BELOW !

CDFV,	CDF V		/CHANGE TO THE VARIABLES FIELD
	TAD PT1		/GET THE DATA POINTER
	JMP NOTID

JUMPX,	JMP I M6	/BRANCH TABLE FOR 'FPNT'
	FLAD
	FLSB
	FLDV
	FMPY
	FLEX
M6,	-6
	FLNR

/HERE ARE THE FLOATING POINT OPERATIONS:

FLGT,	TAD I XRT2	/FGET=0
	DCA EXP
	TAD I XRT2
	DCA HORD
	TAD I XRT2
	DCA LORD
	TAD I XRT2	/'NOP' FOR 3-WORD VERSION
	DCA OVER
	JMP CDIX	/L=0

FLPT,	TAD EXP		/FPUT=6
	DCA I XRT2
	TAD HORD
	DCA I XRT2
	TAD LORD
	DCA I XRT2
	TAD OVER	/'JMP CDIX' FOR 3-WORD VERSION
	DCA I XRT2
	JMP CDIX	/L=1
/////

FLTONE,	1;2000;0;0	/USED BY 'FOR' 'Y' 'FLOG' & 'FSIN'
FLEX,	PUSHF		/FPWR=5
	    FLAC
	JMS I FPNT+1	/SAVE FLAC AND MOVE EXPONENT
	FIXIT		/ONLY HANDLES INTEGER POWERS
	SMA
	CMA		/BUT THEY MAY BE EITHER
	DCA LSORT	/POSITIVE -OR- NEGATIVE!
	TAD HORD
	DCA SIGN	/SAVE SIGN OF EXPONENT
	IAC
	FLOAT		/START WITH UNITY
	NORMALIZE

IBLE,	POPF		/RECALL THE ARGUMENT
	    FLOP
	TAD (.+4-CDIX	/LOAD THE RETURN ADDRESS
	ISZ SIGN	/CHECK THE DIRECTION
	JMP .+5
	JMP I M6-3	/TAKE THE INVERSE (ONCE)
	PUSHF		/SAVE THE RECIPROCAL
	    FLAC
	JMP IBLE

	TAD P7		/ADVANCE THE RETURN
	ISZ LSORT	/CHECK THE LOOP COUNT
	JMP I M6-2	/ACCUMULATE THE PRODUCT
	JMP I M6+1	/DONE
	TAD M4
	TAD PDLXR	/REUSE THE SAME DATA
	DCA PDLXR
	JMP IBLE
/////
CDI0,	CDI

	*.!177-6	/BRANCH LIST FOR 'FETCH'
ACTION,	ENDFI		/ESCAPE = RETAIN CURRENT
	ENDFI		/ALTMODE = DITTO
	READ		/BA = RESTART INPUT
	ACCEPT		/FF = IGNORE IT
	ACCEPT		/LF = IGNORE IT
	ACCEPT		/RO = IGNORE IT

	PAGE
/THIS ROUTINE COMBINES THE EXPONENTS FOR MULTIPLY AND
/DIVIDE AND DETERMINES THE SIGN OF THE RESULT; IF THE
/RESULT IS ZERO IT EXITS IMMEDIATELY.

SGNTST,	0		/TEST AND SAVE SIGN OF THE RESULT
	IAC		/ADD ONE TO EXPONENT
	TAD EXP
	DCA EXP
	JMS ABSOLV	/TAKE THE ABSOLUTE VALUE
	TAD SIGN
	SNA
	JMP MDXIT	/QUICK RETURN
	AND P4000	/STRIP THE SIGN BIT
	TAD AC1H	/DO AN EXCLUSIVE OR
	DCA SIGN	/AND SAVE THE RESULT
	DCA PRODUCT+3	/CLEAR MULTIPLY AREA
	SWP
	DCA ABSOLV	/CLEAR & SAVE THE MQ
	TAD AC1H
	SZA
	ISZ SGNTST
	JMP I SGNTST	/RETURN WITH OPERAND SIGN
/////

/THREE-WORD BY THREE-WORD MULTIPLICATION:
/THE ANSWER IS ROUNDED OFF TO THREE WORDS

/ (A+B+C)*(D+E+F) = NINE PARTIAL PRODUCTS

FMPY,	DCA T1		/SAVE THE RETURN ADDRESS
	DCA PRODUCT+5	/CLEAR THE PRODUCT AREA
	DCA PRODUCT+4
	TAD EX1		/ADD THE EXPONENTS (PLUS 1)
	JMS SGNTST	/AND DETERMINE THE SIGN OF RESULT
	JMP MDONE	/THE RESULT IS ZERO!
	SPA CLA
	JMS REVERS	/TAKE THE ABSOLUTE VALUE
	SM0		/ADD ROUND-OFF CONSTANT
	DCA PRODUCT+2	/LINK IS CLEAR INITIALLY

	TAD HORD	/A*D
	DCA MCND	/STORE IN MULTIPLICAND
	TAD AC1H
	MULTIPLY	/12 BITS BY 12 BITS
	    PRODUCT+4	/RELATIVE LOCATION IN PRODUCT
	TAD AC1L	/A*E
	MULTIPLY
	    PRODUCT+3
	TAD LORD	/B*D
	DCA MCND
	TAD AC1H
	MULTIPLY
	    PRODUCT+3
	TAD AC1L	/B*E
	MULTIPLY
	    PRODUCT+2

MULT4,	DCA PRODUCT+1	/'JMP MDONE' FOR 3-WORD VERSION
	TAD OVR1	/A*F
	DCA MCND
	TAD HORD
	MULTIPLY
	    PRODUCT+2
	TAD LORD	/B*F
	MULTIPLY
	    PRODUCT+1
	TAD OVER	/C*D
	DCA MCND
	TAD AC1H
	MULTIPLY
	    PRODUCT+2
	TAD AC1L	/C*E
	MULTIPLY
	    PRODUCT+1
	DCA PRODUCT+0
	TAD OVR1	/C*F
	MULTIPLY
	    PRODUCT+0
	TAD PRODUCT+3	/COPY RESULT

MDONE,	DCA OVER
	TAD PRODUCT+4
	DCA LORD
	TAD PRODUCT+5
DVXIT,	DCA HORD
	TAD ABSOLV
	MQL
	TAD T1
MDXIT,	TAD FPNTP3	/COMPUTE THE RETURN POINT
	DCA RESOLV
	NORMALIZE
	JMP RESOLV+1	/EXIT FROM MULTIPLY / DIVIDE

/////
DCNT,	-44		/36 BITS (OR -30 FOR 24 BITS)
MULTIPLY=JMS I .;MPLY	/MULTIPLY AC BY MULTIPLICAND
P4000,	4000
FPNTP3,	CDIX
/////
ABSOLV,	0		/TAKE THE ABSOLUTE VALUE
	TAD HORD
	DCA SIGN	/BUT REMEMBER WHAT IT WAS
	JMS RESOLV
	JMP I ABSOLV

RESOLV,	0		/RESTORE THE PROPER SIGN
	TAD SIGN
	SPA CLA
	JMS INVERT
	JMP I RESOLV

INVERT,	0		/COMPLEMENT FLAC - 'NEGATE'
	TAD OVER
	CLL CIA
	DCA OVER
	CML RAL
	TAD LORD
	CIA
	DCA LORD
	CML RAL
	TAD HORD
	CIA
	DCA HORD
	JMP I INVERT

REVERS,	0		/NEGATE THE OPERAND
	TAD OVR1
	CLL CIA
	DCA OVR1
	CML RAL
	TAD AC1L
	CIA
	DCA AC1L
	CML RAL
	TAD AC1H
	CIA
	DCA AC1H
	JMP I REVERS

	*PRODUCT
	ZBLOCK 6	/INITIALZE

QLO=	PRODUCT+4
QHI=	PRODUCT+5

MCND=	XRT
PRDT=	NORM
/THREE-WORD BY THREE-WORD DIVIDE ROUTINE

	*6766
FLDV,	DCA T1		/SAVE THE RETURN POINT
	TAD EX1		/SUBTRACT THE EXPONENTS
	CMA
	JMS SGNTST
	ERROR2		/THE DIVISOR IS ZERO!
	SMA CLA
	JMS REVERS	/NEED A NEGATIVE DIVISOR
	TAD DCNT
	DCA XRT2	/START THE COUNTER
	SKP		/ACROSS THE PAGE
DLUP,	SHIFTL		/SHIFT OVER ONE BIT
	CLL
	TAD OVR1	/SUBTRACT 'FLOP' FROM 'FLAC'
	TAD OVER
	DCA NORM	/SAVE THE RESULT
	RAL
	TAD AC1L
	TAD LORD
	DCA EX1
	RAL		/BRING IN THE CARRY BITS
	TAD AC1H
	TAD HORD
	SNL		/DID IT GO?
	JMP .+6		/NO
	DCA HORD	/YES, UPDATE FLAC
	TAD EX1
	DCA LORD
	TAD NORM
	DCA OVER
	CLA MQA
	RAL
	MQL		/SAVE THE QUOTIENT BITS
	TAD QLO
	RAL
	DCA QLO
	TAD QHI
	RAL
	DCA QHI
	ISZ XRT2	/DONE?
	JMP DLUP	/NO
DDONE,	MQA
	DCA OVER
	TAD QLO
	DCA LORD
	TAD QHI
	SMA
	JMP I (DVXIT	/SIGN IS OK
	DCA HORD
	JMS I .+1	/SHIFT RIGHT A BIT
	SM0		/AND REMOVE SIGN
	TAD HORD
	JMP I (DVXIT	/NO NORMALIZATION NEEDED
/THIS NORMALIZE ROUTINE WORKS FOR BOTH POSITIVE & NEGATIVE
/NUMBERS, PRESERVING THE VALUE OF 'SIGN' FOR USE LATER ON.

NORM,	0		/NORMALIZE THE FLAC - 'NORMALIZE'
	SM0		/=4000
	AND HORD
	DCA XRT2	/SIGN BIT
	TAD HORD
	SNA
	TAD LORD
	SNA
	TAD OVER
	SZA CLA		/MANTISSA=0 ?
	JMP NORGO
	DCA EXP
	JMP I NORM	/YES

NORML,	SHIFTL		/ONE BIT AT A TIME
	CMA
	TAD EXP
	DCA EXP
NORGO,	TAD HORD
	RAL
	TAD XRT2	/COMPARE SIGN & BIT 1
	SMA CLA		/ARE THEY DIFFERENT ?
	JMP NORML	/NOT YET

	SM0		/CHECK FOR 4000 .....
	TAD HORD
	SNA
	TAD OVER
	SNA CLA
	JMS I NORM+1	/SHIFT IT BACK A BIT
	JMP I NORM
/////


/LINEFEED DURING INPUT: RETYPE THE LINE

LNFEED,	TAD I TABCNT	/WHERE ARE WE?
	SNA CLA
	JMP I CLF	/IGNORE THE LF AFTER A CR
	TAD LASTC
	DCAIAXIN	/SAVE THE LAST CHARACTER
	TAD BUFR
	DCA AXOUT	/SET 'TEXTP'
	DCA XCT
	TAD CCR		/START WITH A CR
	PRINTC
	TAD CSTAR	/THEN PRINT A STAR
	ISZ I QSWTCH	/DISABLE '?' TRAP
LFCONT,	PRINTC		/RETYPE THE INPUT LINE
	GETC
	TAD AXIN
	CIA		/THROUGH THE CURRENT POSITION
	TAD AXOUT
	SPA CLA
	JMP LFCONT
	TAD T3		/CHECK FOR AN EXTRA CHARACTER
	SPA CLA
	PRINTC
	CMA
	TAD AXIN
	JMP I CCR	/RESET PACKING POINTERS
/////

/SINGLE PRECISION, UNSIGNED, MULTIPLY ROUTINE:
/PRODUCTS ARE ACCUMULATED IN A 6-WORD REGISTER

MPLY,	0
	SNA		/NO RESULT ADDED IF ZERO
	JMP I MPLY
	MQL		/MULTIPLIER -> MQ
	TAD M14		/TWELVE BITS
	DCA PRDT
	TAD I MPLY	/RELATIVE LOCATION
	DCA EX1
	TAD I EX1	/ADD IN PREVIOUS RESULT
	SWP		/MULTIPLIER -> AC

MLOOP,	RAR		/THE LINK IS CLEAR INITIALLY
	SWP		/SUM -> AC
	SNL		/TEST THE BIT
	JMP .+3
	CLL
	TAD MCND	/MULTIPLY
	RAR
	SWP		/MULTIPLIER -> AC; PRODUCT -> MQ
	ISZ PRDT
	JMP MLOOP	/12.4 MICROSECONDS PER CYCLE
/////
	RAR
	DCA I EX1	/SAVE LOW ORDER PART
	MQA		/GET HIGH ORDER
CARRY,	ISZ EX1
	TAD I EX1	/ADD CARRY, SAVE
	DCA I EX1
	SNL
	JMP I MPLY	/EXIT WITH L=0
	RAL
	JMP CARRY
/////

	PAGE
/SHIFT ROUTINES FOR 'FLAC' AND 'FLOP'

	*CLA		/FOR 'FLEX'
MOV,	0		/FLOP -> FLAC
	TAD EX1
	DCA EXP
	TAD AC1H
	DCA HORD
	TAD AC1L
	DCA LORD
	TAD OVR1
	DCA OVER
	JMP I MOV
/////

ALIGN,	0		/LINE THINGS UP
	TAD AC1H	/OPERAND ZERO ?
	SNA CLA
	JMP I ALIGN	/DON'T WASTE ANY TIME

	TAD HORD	/FLAC ZERO ?
	SNA
	TAD LORD
	SNA CLA
	JMP FLIP 	/YES, FLOP -> FLAC

	TAD EX1		/EXPONENTS EQUAL?
	CIA
	TAD EXP
	SNA
	JMP AOK		/YES: WE'RE DONE
	DCA MOV

	TAD MOV		/NO: SAVE THE MISMATCH
	SMA
	CIA		/NEGATE FOR LOOP COUNT
	DCA T1

	TAD T1
ALC,	TAD P43		/'P27' FOR 3-WORD VERSION
	SPA CLA		/CAN THEY BE ALIGNED?
	JMP NOGO	/NO

ALP,	TAD MOV		/YES, SHIFT THE SMALLEST
	SMA
	JMS DIV1	/FLOP
	SPA
	JMS DIV2	/FLAC
	ISZ T1
	JMP ALP		/REPEAT
AOK,	ISZ ALIGN
	JMP I ALIGN	/TAKE THE SECOND RETURN

IFNZRO	.-"*&177	<'CSTAR' WON'T BE RIGHT>
/TURN THE FLOATING ACCUMULATOR INTO A 24-BIT INTEGER WITH
/THE LEAST MOST SIGNIFICANT 12 BITS IN THE AC UPON RETURN

FIXER,	0		/'FIXIT'
	TAD P27
	JMS FIXUP	/CONVERT TO A 24-BIT INTEGER
	DCA OVER	/CLEAR THE FRACTION
	JMS I RESOL
	CLL		/VERY USEFUL!
	TAD LORD
	JMP I FIXER

	*STA CML BSW	/FOR 'FRA'
FIXUP,	0		/FIXUP A FLOATING POINT NUMBER
	DCA EX1		/SAVE THE DESIRED BINARY POINT
	TAD EXP
	SPA SNA CLA	/IS NUMBER GREATER THAN ONE?
	JMP NOFIX	/NO, RETURN ZERO
	JMS I ABSOL	/NECESSARY FOR NEG. VALUES
	DCA AC1H
	TAD HORD	/IGNORE UNNORMALIZED NUMBERS
	JMS ALIGN
P27,	27
	JMP I FIXUP	/CALLED BY 'FIXIT', 'FRAC'

NOFIX,	FLOAT		/STUFF WITH ZEROS
	DCA EXP
	JMP I FIXUP	/DONE
/////

SHFTR1,	JMS DIV2	/SHIFT THE NUMBERS RIGHT ONCE
	JMS DIV1	/WHEN THEY HAVE THE SAME SIGN
	RAR
	TAD DIV2	/ADD THE BITS WE SHIFTED OUT
	CLA RAL
	JMP FLNR-1	/AND FINISH UP 'FLAD', 'FLSB'
/////

DIV1,	0		/SHIFT FLOP RIGHT
	CLA RAR
	DCA DIV2
	TAD AC1H
	SPA
	CML
	RAR
	DCA AC1H
	TAD AC1L
	RAR
	DCA AC1L
	TAD OVR1
	RAR
	DCA OVR1
	ISZ EX1
	JMP I DIV1
	JMP I DIV1
FP3,	CDIX		/RETURN FOR 'FLAD', 'FLSB'
/////

	*SM0		/FOR NORMALIZE, DIVIDE
DIV2,	0		/SHIFT FLAC RIGHT
	CLA CLL
	TAD HORD
	SPA
	CML
	RAR
	DCA HORD
	TAD LORD
	RAR
	DCA LORD
	TAD OVER
	RAR
	DCA OVER
	ISZ EXP
	JMP I DIV2
	JMP I DIV2
/////

	REVERS
FLSB,	JMS I .-1	/FSUB=2 - NEGATE THE OPERAND
FLAD,	JMS ALIGN	/FADD=1 - ALIGN EXPONENTS
	JMP FLNR	/NOT POSSIBLE
	SM0
	AND HORD	/COMPARE SIGNS
	TAD AC1H
	SMA CLA
	JMP SHFTR1	/SHIFT RIGHT ONCE
	JMS I (DUBLAD	/TO PRESERVE THE SIGN
FLNR,	NORMALIZE	/FNOR=7 - CALL NORMALIZE
	JMP I FP3
/////

	*CLA SM1	/FOR 'ASK' AND 'FTRM'
TERM,	0		/INPUT TERMINATOR

NOGO,	SM0		/MISSION IMPOSSIBLE
IFNZRO	STA STL RTL-.	<EAE DIVIDE NEEDS THIS>
	AND EX1
	TAD EXP		/FIND OUT WHO'S BIGGEST
	SPA CLA
	TAD EXP		/SIGNS DIFFER: TEST 'EXP'
	SNA
	TAD MOV		/SIGNS EQUAL: CHECK DIFF.
	SPA CLA
FLIP,	JMS MOV		/EX1 > EXP
	JMP I ALIGN	/EXP > EX1
/////

	PAGE
