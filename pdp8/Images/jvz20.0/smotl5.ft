	SUBROUTINE SMOTL5(NBAS)
	COMMON X,Y,X1,DELB,NPOIT,RIR,ROR
	COMMON IY,IB
	DIMENSION X(200),IY(200),IB(200)
	DIMENSION Y(200)
	IB(1)=(3*IY(1)+2*IY(2)+IY(3)-IY(5))/5
	N=NBAS
	IB(N)=(3*IY(N)+2*IY(N-1)+IY(N-2)-IY(N-4))/5
	IB(2)=(4*IY(1)+3*IY(2)+2*IY(3)+IY(4))/10
	IB(N-1)=(4*IY(N)+3*IY(N-1)+2*IY(N-2)+IY(N-3))/10
	N=NBAS-2
	DO 10 I=3,N
10	IB(I)=(IY(I-2)+IY(I-1)+IY(I)+IY(I+1)+IY(I+2))/5
	RETURN
	END
