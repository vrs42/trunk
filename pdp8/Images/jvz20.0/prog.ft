C	PROG.FT CALLS PROG1,PROG2 AS SUBR.
C	7/25/76
C
	COMMON X,Y,X1,DELX,NPOIT,RIR,ROR
	COMMON IY,IB,IXY
	DIMENSION X(200),IY(200),IB(200)
	DIMENSION Y(200),IXY(2,200)
	READ(1,1001)NCELL
1001	FORMAT('# CHANNELS IN FILE:'I1)
	READ(1,1002)BMSG
1002	FORMAT('TYPE BASELINE TITLE, A6 (6^P = NONE):'A6)
	READ(1,1003)EMSG
1003	FORMAT('TYPE EQUIL INPUT TITLE:'A6)
	READ(1,1000)FMSG
1000	FORMAT('TYPE OUTPUT TITLE:'A6)
	CALL OOPEN('DSK',FMSG)
	DO 10 I=1,NCELL
	CALL PROG1(I,BMSG,EMSG)
	CALL PROG2(I)
10	CONTINUE
	CALL OCLOSE
	END
