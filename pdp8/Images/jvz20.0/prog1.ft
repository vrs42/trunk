	SUBROUTINE PROG1(ICELL,BMSG,EMSG)
C	PROG1.FT REQUIRES SMOTL5.FT AND INTRPL.FT SUBROUTINES
C	SEPCOR.FT ALSO
C	UPDATED 2/14/74 D.C.T.
	COMMON X,Y,X1,DELX,NPOIT,RIR,ROR
	COMMON IY,IB,IXY
	DIMENSION X(200),IY(200),IB(200)
	DIMENSION Y(200),IXY(2,200)
	RM=4.
	SSEP=270.
	SEPR=0.
	NBAS=0
	NPBAS=0
	X1=0.
	IF(BMSG)10,200,10
10	CALL IOPEN('DSK',BMSG)
	DO 41 IJK=1,ICELL
	READ(4,1005)RIR,ROR
1005	FORMAT(2F6.0)
	READ(4,1001)XIR,YIR
	READ(4,1001)XOR,YOR
1001	FORMAT(F6.0,F7.1)
	SLOPE=(YOR-YIR)/(XOR-XIR)
	RMS=0.
	SSEP=0.
	DO 30 I=1,200
	READ(4,1002)X(I),IB(I),ISEP
1002	FORMAT(F6.0,2I4)
	IF(ISEP-999)20,40,20
20	IB(I)=-SLOPE*(X(I)-X(1))+FLOAT(IB(I))
	SSEP=SSEP+FLOAT(ISEP)
30	RMS=RMS+FLOAT(ISEP)**2
40	NPOIT=I-1
41	CONTINUE
	NPBAS=NPOIT
	SSEP=SSEP/FLOAT(NPOIT)
	RM=SQRT(RMS/FLOAT(NPOIT)-SSEP**2)
	WRITE(1,2000)
45	ISEP=0
	IMIN=IB(1)
47	IY(1)=IMIN
	DO 70 I=2,NPOIT
	IF(IB(I-1)-IB(I)-25)60,60,50
50	ISEP=ISEP+IFIX(SSEP+.5)
60	IY(I)=IB(I)+ISEP
	IF(IY(I)-IMIN)65,70,70
65	IMIN=IY(I)
70	CONTINUE
2000	FORMAT('Q TO CONT.,E TO EDIT, F TO SET NEW LIMIT')
	DO 80 I=1,NPOIT
	IXY(1,I)=3*I
80	IXY(2,I)=4*(IY(I)-IMIN)-250
90	M1=IABS(NALOG(0))-1
	CALL DISP1(NPOIT,IXY)
	CALL DISP2(NPOIT,IXY)
	CALL DISP6(M1)
	L=KEYBD(0)
	IF(L-197)90,100,110
100	K=M1/3+1
	IY(K)=(IY(K-1)+IY(K+1))/2
	IXY(2,K)=4*(IY(K)-IMIN)-250
	GO TO 90
110	IF(L-198)120,120,160
120	J=NPOIT/2
	K=M1/3+1
	IF(K-J)130,130,150
C	FOR K L.T. J, STRIP OFF LOW VALUES
130	NPOIT=NPOIT-K+1
	K=K-1
	DO 140 I=1,NPOIT
	K=K+1
	X(I)=X(K)
	IY(I)=IY(K)
140	IXY(2,I)=IXY(2,K)
	IMIN=IY(1)
	DO 142 I=2,NPOIT
	IF(IY(I)-IMIN)143,142,142
143	IMIN=IY(I)
142	CONTINUE
	DO 145 I=1,NPOIT
	IY(I)=IY(I)-IMIN
145	IXY(2,I)=4*(IY(I)-IMIN)-250
	GO TO 90
150	NPOIT=K
	GO TO 90
160	DO 170 I=1,NPOIT
170	IY(I)=IY(I)-IMIN
	CALL SMOTL5(NPOIT)
	X1=X(1)
	DELX=X(2)-X1
	NBAS=NPOIT
C	COME TO THIS POINT IF NO BASELINE
200	CALL IOPEN('DSK',EMSG)
	DO 261 IJK=1,ICELL
	SEPR=0.
	RMS=0.
	READ(4,1005)RIR,ROR
	READ(4,1001)XIR,YIR
	READ(4,1001)XOR,YOR
	SLOPE=(YOR-YIR)/(XOR-XIR)
	J=0
	ICOUNT=0
	RM=5.*RM
	DO 250 I=1,200
	READ(4,1002)XP,IYP,ISEP
C	CHECK FOR XP G.E. X1
	IF(XP-X1)250,210,210
C	CHECK FOR XP L.E. X(LAST)
210	J=J+1
	IF(XP-9999.)220,260,260
C	CHECK FOR REASONABLE ISEP
220	SEP=ISEP
	IF(ABS(SEP-SSEP)-RM)240,235,235
235	CONTINUE
C	THIS IS JUST NOP 
	GO TO 245
240	SEPR=SEPR+SEP
	RMS=RMS+SEP**2
	ICOUNT=ICOUNT+1
245	X(J)=XP
	IY(J)=-SLOPE*(X(J)-X(1))+FLOAT(IYP)
250	CONTINUE
260	NPOIT=J-1
261	CONTINUE
	J=NPOIT-ICOUNT
	FN=NPOIT-J
	SEPR=SEPR/FN
	RMS=SQRT(RMS/FN-SEPR**2)
C	INTERPOLATE BASELINE
	IF(NBAS)285,285,265
265	DO 270 I=1,NPOIT
	CALL INTRPL(I,COR,NBAS)
270	IY(I)=IY(I)-IFIX(COR+.5)
C	NOW CORRECT FOR FRINGE DISCONTINUITY
285	RMIN=IY(1)
	Y(1)=RMIN
	SEP=0.
	DO 300 I=2,NPOIT
	IF(IY(I-1)-IY(I)-25)280,280,275
275	SEP=SEP+SEPR
280	Y(I)=FLOAT(IY(I))+SEP
	IF(Y(I)-RMIN)290,300,300
290	RMIN=Y(I)
300	CONTINUE
	RMIN=RMIN-1.
	DO 310 I=1,NPOIT
310	Y(I)=Y(I)-RMIN
	X1=SEPR
	WRITE(1,2002)SEPR,RMS
2002	FORMAT(/'SEPRN =',F6.1,' +/-'F5.1/)
	CALL SEPCOR(NPOIT)
	RMIN=Y(1)
	DO 330 I=1,NPOIT
	IF(Y(I)-RMIN)320,330,330
320	RMIN=Y(I)
330	CONTINUE
	RMIN=RMIN-1.
	DO 340 I=1,NPOIT
340	Y(I)=Y(I)-RMIN
	RETURN
	END
