C  ADDSCN.FT TO AVERAGE SEVERAL SCANS AND WRITE THE DATA AS 
C	LINCTAPE BLOCKS FOR INPUT TO EQSCN.FT
C
	COMMON IC,IX
	DIMENSION IC(1024),IX(1024),IXY(2,1024)
C
1	READ(1,1000)NSCN
1000	FORMAT(' # SCANS TO AVERAGE:',I2)
	READ(1,1001)IBLK
1001	FORMAT(' BLOCK #:',I3)
	CALL RLINC(1,IBLK,8,IC,256)
	NPOIT=IC(1)
	IXMAX=IX(3)+1
C	PUT INTO IXY:
	J=0
	DO 20 I=3,NPOIT
	J=J+1
	IF(IX(I))10,25,10
10	IXY(1,I)=IXMAX-(J-1)
C  THIS GETS RID OF LINC 7777=-1
20	IXY(2,I)=IC(I)
25	NP=J-1
	FNP=NP
C**
	FIJK=0.
	DO 100 IJK=2,NSCN
	READ(1,1001)IBLK
	CALL RLINC(1,IBLK,8,IC,256)
	NPOIT=IC(1)
C  CHECK FOR SUFFICIENT POINTS:
	FN=NPOIT
	IF(FN-0.9*FNP)200,30,30
200	WRITE(1,2000)IBLK
2000	FORMAT(//' SHORT SCAN AT BLOCK',I5' SKIPPING'//)
	GO TO 100
30	FIJK=FIJK+1.
	SCN=FIJK+1.
	J0=IXY(1,3)-IX(3)
	J=0
	DO 60 I=3,NPOIT
	IF(IX(I))40,100,40
40	J=J+1
	K=J+J0
	IF(K-NP)45,45,100
45	IF(K)60,60,50
50	K=K+2
	OLD=FIJK*FLOAT(IXY(2,K))
	ANEW=IC(I)
	AVRG=(OLD+ANEW)/SCN
	SIGN=ABS(AVRG)/AVRG
	IXY(2,K)=AVRG+.5*SIGN
60	CONTINUE
100	CONTINUE
C  ZERO IC,IX
	DO 140 I=1,1024
	IX(I)=0
140	IC(I)=0
C  TRANSFER IXY INTO IC AND IX FOR OUTPUT
	NPOIT=NP+2
	IC(1)=NPOIT
	DO 150 I=3,NPOIT
	IF(IXY(1,I))145,143,145
143	IXY(1,I)=-1
145	IX(I)=IXY(1,I)
150	IC(I)=IXY(2,I)
	READ(1,1003)IBLK
1003	FORMAT(' OUTPUT BLOCK #:',I3)
	CALL WLINC(1,IBLK,8,IC,256)
	GO TO 1
	END
