	SUBROUTINE EPRO2(ICELL)
C	EQUIVALENT BOUNDARY SEDIMENTATION COEFFICIENT
C	DAVE TELLER APRIL 1973
C	REQUIRES DERIVS.FT SUBROUTINE
C	UPDATED 2/25/74 TO RUN OUT OF EPROG1.FT
	COMMON X,Y,SEPR,AMAG,NPOIT,RIR,ROR,DYDX,IXY
	DIMENSION X(150),Y(150),DYDX(150)
	DIMENSION IXY(2,150),TEMP(10)
	DELX=(X(3)-X(2))*AMAG
	DYDX(1)=0.
	N=NPOIT-1
	CALL DERIV(A2,A3,Y,DYDX,9,2,N)
C	NPT=9 ABOVE
	XREF=6.5-.5*(ROR+RIR)*AMAG
	DO 70 I=1,NPOIT
	DYDX(I)=DYDX(I)/DELX
70	X(I)=XREF+AMAG*X(I)
	XMIN=5.8
	XMAX=7.2
	DYMIN=500.
	DYMAX=0.
	DO 390 I=1,NPOIT
	X1=X(I)
	Y1=DYDX(I)
	IF(X1-XMAX)330,330,320
320	XMAX=X1
330	IF(X1-XMIN)340,350,350
340	XMIN=X1
350	IF(Y1-DYMAX)370,370,360
360	DYMAX=Y1
370	IF(Y1-DYMIN)380,390,390
380	DYMIN=Y1
390	CONTINUE
	XMAX=500./(XMAX-XMIN)
	DYMAX=500./(DYMAX-DYMIN)
	DO 400 I=1,NPOIT
	IXY(1,I)=IFIX((X(I)-XMIN)*XMAX)
400	IXY(2,I)=IFIX((DYDX(I)-DYMIN)*DYMAX)-250
2006	FORMAT(3(1XI4,F7.4,F6.2,F6.1,))
C	GET INTEGRAL OF X^2.DC
	SUM=0.
	N=NPOIT-1
	DO 80 I=1,N
	YJ=Y(I+1)
	YI=Y(I)
	XJ=X(I+1)**2
	XI=X(I)**2
80	SUM=SUM+.5*(XJ+XI)*(YJ-YI)
	J=NPOIT-2
	SUM2=0.
	DO 90 I=J,NPOIT
90	SUM2=SUM2+Y(I)
	SUM2=SUM2/3.
	XB=SQRT(SUM/SUM2)
	XBLOG=ALOG(XB)
C	RADIAL DILUTION
	CZ=(XB**2)*SUM2/X(1)**2
	WRITE(1,1999)X(1)
1999	FORMAT('X(M) =',F7.4)
	WRITE(1,2000)XB,XBLOG,CZ
2000	FORMAT('X-BAR =',F7.4,'  LOG X =',F9.5,'  C-ZERO =',F7.3)
C	ADD DISPLAY AND KEYBD ROUTINES HERE
	WRITE(1,2004)
2004	FORMAT('PUT CURSOR ON MIN OR MAX,C TO GET IT, Q TO CONT.')
100	M1=IABS(NALOG(0))
	CALL DISP1(NPOIT,IXY)
	CALL DISP2(NPOIT,IXY)
	CALL DISP6(M1)
	L=KEYBD(0)
	IF(L-195)100,110,160
110	M1=M1+1
	DO 120 I=1,NPOIT
	IF(IXY(1,I)-M1)120,130,120
120	CONTINUE
	WRITE(1,2005)
2005	FORMAT('WRONG INDEX ON SCREEN, TRY AGAIN')
	GO TO 100
130	ISTART=I-3
	NTIME=I+4-ISTART
	ISTOP=ISTART+7
	K=0
	DO 140 J=ISTART,ISTOP
	K=K+1
140	TEMP(K)=Y(J)
	CALL DERIV(A2,A3,DYDX,Y,7,ISTART,NTIME)
	TM=-A2/A3
	XB=DELX*TM+X(I)
	XBLOG=ALOG(XB)
	WRITE(1,2001)XB,XBLOG
2001	FORMAT('X =',F7.4,'  LOG X ='F9.5)
	K=0
	DO 150 J=ISTART,ISTOP
	K=K+1
150	Y(J)=TEMP(K)
	GO TO 100
160	WRITE(4,2009)NPOIT
2009	FORMAT(I4)
	I=1
	WRITE(4,2010)I,X(I),Y(I),DYDX(I)
	I=2
	WRITE(4,2010)I,X(I),Y(I),DYDX(I)
	N=NPOIT-1
	H=X(3)-X(2)
	DO 270 I=3,N
270	WRITE(4,2010)I,X(I),Y(I),DYDX(I)
	I=NPOIT
	WRITE(4,2010)I,X(I),Y(I),DYDX(I)
2010	FORMAT(I4,F7.4,F6.2,F6.1)
	WRITE(1,2007)
2007	FORMAT('P TO PRINT, Q TO CONT.')
165	L=KEYBD(0)
	IF(L-208)165,170,220
170	WRITE(1,2008)NPOIT
2008	FORMAT(/I4)
	N=NPOIT+1
	IF(N-150)180,200,200
180	DO 190 I=N,150
	X(I)=0.
	Y(I)=0.
190	DYDX(I)=0.
200	J=NPOIT/3+1
	J2=2*J
	K=J
	DO 210 I=1,J
	K=K+1
	J2=J2+1
210	WRITE(1,2006)I,X(I),Y(I),DYDX(I),K,X(K),Y(K),DYDX(K),
	1J2,X(J2),Y(J2),DYDX(J2)
220	RETURN
	END
