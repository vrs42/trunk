	SUBROUTINE MATINV(N)
C	MODIFIED DIMENSION FOR RESOLUTION OF GAUSSIA
C	MATRIX INVERSION
C	CALLING PROGRAM HAS COMMON A(6,6),B(6),C(6).
C	MOD TO A(12,12),B(12),C(12) ON 10/2/74 TO GET 4 GAUSSIA
C	EQUATIONS ARE [A][C]=[B]; VECTORS C AND
C	PIVOT OF THIS SUBROUTINE ARE STORED IN THE SAME PLACE.
C	N IS THE RANK OF THE SQUARE MATRIX [A].
	COMMON A,B,PIVOT
	DIMENSION A(12,12),B(12),IPIVOT(12),INDEX(12,2),PIVOT(12)
	DETERM=1.
	DO 20 J=1,N
20	IPIVOT(J)=0
	DO 550 I=1,N
C	SEARCH FOR PIVOT ELEMENT
	AMAX=0.
	DO 105 J=1,N
	IF(IPIVOT(J)-1)60,105,60
60	DO 100 K=1,N
	IF(IPIVOT(K)-1)80,100,740
80	IF(ABS(AMAX)-ABS(A(J,K)))85,85,100
85	IROW=J
	ICOLUM=K
	AMAX=A(J,K)
100	CONTINUE
105	CONTINUE
	IPIVOT(ICOLUM)=IPIVOT(ICOLUM)+1
C	INTERCHANGE ROWS TO PUT PIVOT ELEMENT ON DIAGONAL
	IF(IROW-ICOLUM)140,260,140
140	DETERM=-DETERM
	DO 200 L=1,N
	SWAP=A(IROW,L)
	A(IROW,L)=A(ICOLUM,L)
200	A(ICOLUM,L)=SWAP
260	INDEX(I,1)=IROW
	INDEX(I,2)=ICOLUM
	PIVOT(I)=A(ICOLUM,ICOLUM)
	DETERM=DETERM*PIVOT(I)
C	DIVIDE PIVOT ROW BY PIVOT ELEMENT
	A(ICOLUM,ICOLUM)=1.
	DO 350 L=1,N
	IF(A(ICOLUM,L))340,350,340
340	A(ICOLUM,L)=A(ICOLUM,L)/PIVOT(I)
350	CONTINUE
C	REDUCE NON-PIVOT ROWS
	DO 550 L1=1,N
	IF(L1-ICOLUM)400,550,400
400	T=A(L1,ICOLUM)
	A(L1,ICOLUM)=0.
	DO 450 L=1,N
	IF(A(ICOLUM,L))440,450,440
440	A(L1,L)=A(L1,L)-A(ICOLUM,L)*T
450	CONTINUE
550	CONTINUE
C	INTERCHANGE COLUMNS
	DO 710 I=1,N
	L=N+1-I
	IF(INDEX(L,1)-INDEX(L,2))630,710,630
630	JROW=INDEX(L,1)
	JCOLUM=INDEX(L,2)
	DO 705 K=1,N
	SWAP=A(K,JROW)
	A(K,JROW)=A(K,JCOLUM)
705	A(K,JCOLUM)=SWAP
710	CONTINUE
740	CONTINUE
	RETURN
	END
