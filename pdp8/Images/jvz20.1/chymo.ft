C	CHYMO.FT IS OLD SUBROUTINE FROM SEDEQ
C	CDC-6400 PROG.  IT USES THE METHOS OF
C	HOAGLAND AND TELLER TO CALC DIMERIZATION
C	CONSTANTS
C	NEEDS DEVI8.FT SUBR.
C
	COMMON C,AN,AW,AZ,WMON
	DIMENSION C(150),AN(150),AW(150),AZ(150)
	DIMENSION GMSG(4)
C	
	READ(1,1000)NCELL
1000	FORMAT('# CELLS (4 MAX):'I1)
	DO 5 I=1,NCELL
5	READ(1,1001)GMSG(I)
1001	FORMAT('INPUT TITLE:'A6)
	L=0
	CUT=1.
	DO 100 IJK=1,NCELL
	FMSG=GMSG(IJK)
	CALL IOPEN('DSK',FMSG)
	READ(4,1002)NPOIT
1002	FORMAT(I4)
	DO 100 I=1,NPOIT
	L=L+1
	READ(4,1003)C(L),AN(L),AW(L),AZ(L)
1003	FORMAT(12XF7.3,3F9.0)
	IF(C(L)-CUT)90,100,100
90	L=L-1
100	CONTINUE
	NPOIT=L
C	NOW CAN LOOP BACK TO NEXT STATEMENT FOR MULTIPLE M1 VALUES
20	READ(1,1004)WMON
1004	FORMAT('M(1) (F6.0):'F6.0)
	A=2.*WMON
	BLANK=1.E-20
	SUMC=0.
	SUMCQ=0.
	SWK=0.
	SNK=0.
	SZK=0.
	SWKC=0.
	SNKC=0.
	SZKC=0.
	SUMPK=0.
	SUPKC=0.
	SWKQ=0.
	SNKQ=0.
	SZKQ=0.
	SUPKQ=0.
	SUMW=0.
	DO 1 I=1,NPOIT
	IF(AN(I)-A)10,1,1
10	IF(AW(I)-A)11,1,1
11	IF(AZ(I)-A)12,1,1
12	WK=WMON*(AW(I)-WMON)/(C(I)*(2.*WMON-AW(I))**2)
	ANK=2.*AN(I)*(AN(I)-WMON)/(C(I)*(2.*WMON-AN(I))**2)
	ZK=(AZ(I)-WMON)*(3.*WMON-AZ(I))/(4.*C(I)*(2.*WMON-AZ(I))**2)
	IF(WK)13,13,14
13	WK=BLANK
14	IF(ANK)15,15,16
15	ANK=BLANK
16	IF(ZK)17,17,18
17	ZK=BLANK
18	CW=SQRT(4.*WK*C(I)+1.)
	CW=(CW-1.)/(2.*WK)
	CN=SQRT(4.*ANK*C(I)+1.)
	CN=(CN-1.)/(2.*ANK)
	CZ=SQRT(4.*ZK*C(I)+1.)
	CZ=(CZ-1.)/(2.*ZK)
	DWN=ABS(WMON*C(I)/(CW*(1.+WK*CW*.5))-AN(I))
	DZN=ABS(WMON*C(I)/(CZ*(1.+ZK*CZ*.5))-AN(I))
	DNW=ABS(WMON*CN*(1.+2.*ANK*CN)/C(I)-AW(I))
	DZW=ABS(WMON*CZ*(1.+2.*ZK*CZ)/C(I)-AW(I))
	DWZ=ABS(WMON*(1.+4.*WK*CW)/(1.+2.*WK*CW)-AZ(I))
	DNZ=ABS(WMON*(1.+4.*ANK*CN)/(1.+2.*ANK*CN)-AZ(I))
	WWK=1./DWN+1./DWZ
	WNK=1./DNW+1./DNZ
	WZK=1./DZN+1./DZW
	PK=(WWK*WK+WNK*ANK+WZK*ZK)/(WWK+WNK+WZK)
	ERK=(WWK*WK**2+WNK*ANK**2+WZK*ZK**2)/(WWK+WNK+WZK)
	CP=SQRT(4.*PK*C(I)+1.)
	CP=(CP-1.)/(2.*PK)
	W=1./ERK
	SUMW=SUMW+W
	SUMC=SUMC+C(I)*W
	SUMCQ=SUMCQ+W*C(I)**2
	SWK=SWK+WK*W
	SNK=SNK+ANK*W
	SZK=SZK+ZK*W
	SWKC=SWKC+WK*C(I)*W
	SNKC=SNKC+ANK*C(I)*W
	SZKC=SZKC+ZK*C(I)*W
	SUMPK=SUMPK+PK*W
	SUPKC=SUPKC+PK*C(I)*W
	SWKQ=SWKQ+W*WK**2
	SNKQ=SNKQ+W*ANK**2
	SZKQ=SZKQ+W*ZK**2
	SUPKQ=SUPKQ+W*PK**2
1	CONTINUE
C
C	WHEW!
C
	FN=1.
	IF(SUMW)22,22,21
21	FN=SUMW
22	SYYW=SWKQ-SWK**2/FN
	SYYN=SNKQ-SNK**2/FN
	SYYZ=SZKQ-SZK**2/FN
	SYYP=SUPKQ-SUMPK**2/FN
	SXYW=SWKC-SUMC*SWK/FN
	SXYN=SNKC-SUMC*SNK/FN
	SXYZ=SZKC-SUMC*SZK/FN
	SXYP=SUPKC-SUMC*SUMPK/FN
	SXX=SUMCQ-SUMC**2/FN
C	IF SXX=0, ABORT HERE
	BW=SXYW/SXX
	BN=SXYN/SXX
	BZ=SXYZ/SXX
	BP=SXYP/SXX
C	S.E. OF B'S
	SYXW=SQRT((SYYW-BW*SXYW)/FN)
	SYXN=SQRT((SYYN-BN*SXYN)/FN)
	SYXZ=SQRT((SYYZ-BZ*SXYZ)/FN)
	SYXP=SQRT((SYYP-BP*SXYP)/FN)
C	INTERCEPTS
	CBAR=SUMC/FN
	AAW=SWK/FN-BW*CBAR
	AAN=SNK/FN-BN*CBAR
	AAZ=SZK/FN-BZ*CBAR
	AP=SUMPK/FN-BP*CBAR
	CQ=SQRT(1./FN+CBAR**2/SXX)
	SXX=SQRT(SXX)
	SBW=SYXW/SXX
	SBN=SYXN/SXX
	SBZ=SYXZ/SXX
	SBP=SYXP/SXX
	SAW=SYXW*CQ
	SAN=SYXN*CQ
	SAZ=SYXZ*CQ
	SAP=SYXP*CQ
	BARK=SUMPK/FN
	ARF=SQRT(SUPKQ/FN-BARK**2)
C	GET DEVIATIONS FROM M(N),M(W)
C	WRITE-OUT IN DEVI8 SUBR.
	WRITE(1,2000)
2000	FORMAT(/'DATA  K (X10^3)     S.E.    SLOPE     S.E.
	1     M(N)     M(W)'/)
	TITL='M(N)  '
	CALL DEVI8(TITL,AAN,SAN,BN,SBN,NPOIT)
	TITL='M(W)  '
	CALL DEVI8(TITL,AAW,SAW,BW,SBW,NPOIT)
	TITL='M(Z)  '
	CALL DEVI8(TITL,AAZ,SAZ,BZ,SBZ,NPOIT)
	TITL='ALL   '
	CALL DEVI8(TITL,AP,SAP,BP,SBP,NPOIT)
	CALL DEVI8(TITL,BARK,ARF,0.,0.,NPOIT)
C
C	RECYCLE FOR NEW M(1)
C
	WRITE(1,2001)
2001	FORMAT(/////)
	GO TO 20
	END
