	DIMENSION X(100),Y(100),IY(100)
1	READ(1,1000)FMSG
1000	FORMAT('TYPE TITLE (A6):',A6)
	CALL IOPEN('DTA1',FMSG)
	READ(4,1002)XL
1002	FORMAT(20XF10.0)
	READ(1,1003)DX
1003	FORMAT('DELTA-X (F4.0)',F4.0)
	READ(4,1002)DUM
	READ(4,1005)X1,Y(1)
	NPOIT=IFIX((XL-X1)/DX)+1
	X(1)=X1
	DO 10 I=2,NPOIT
10	READ(4,1005)X(I),Y(I)
1005	FORMAT(2F6.0)
	YMIN=0.
	YMAX=0.
	DO 20 I=1,NPOIT
	IF(Y(I)-YMIN)30,40,40
30	YMIN=Y(I)
40	IF(Y(I)-YMAX)20,20,50
50	YMAX=Y(I)
20	CONTINUE
	YMULT=500./(YMAX-YMIN)
	DO 60 I=1,NPOIT
60	IY(I)=IFIX(YMULT*(Y(I)-YMIN))-250
70	CALL DISP3(NPOIT,IY)
	IF(ISENS(0))90,90,80
80	CALL DISP4(NPOIT,IY)
90	IF(KEYBD(0))70,70,100
100	GO TO 1
	END
