C	REORDR.FT READS 3RD PTS OF HISPD DATA AND REORDERS IT IN C
C	FOR INPUT TO A MODIFIED DYSON PROGRAM
C
	COMMON AX,BX,CX
	COMMON NPOIT,C,AM,A,RMS
	DIMENSION C(100),AM(3,100)
	DIMENSION AX(7,7),BX(7),CX(7)
	DIMENSION A(100),RMS(100),X(3)
	DIMENSION GMSG(6),SWAP(3),H(3)
	READ(1,1000)NSET
1000	FORMAT('#SETS:'I1)
	DO 10 I=1,NSET
10	READ(1,1001)GMSG(I)
1001	FORMAT('INPUT TITLE:'A6)
	L=0
	DO 100 IJ=1,NSET
	HMSG=GMSG(IJ)
	CALL IOPEN('DTA1',HMSG)
	READ(4,1005)NPOIT
1005	FORMAT(I4)
	DO 30 I=1,NPOIT,3
	IF(L-100)20,105,105
20	L=L+1
	READ(4,1006)C(L),(AM(K,L),K=1,3)
	READ(4,1006)DUM
30	READ(4,1006)DUM
1006	FORMAT(12XF7.3,3F9.0)
100	CONTINUE
105	NPOIT=L
	DO 120 I=1,NPOIT
	DO 120 J=I,NPOIT
	IF(C(J)-C(I))110,110,120
110	SWAPC=C(I)
	DO 111 K=1,3
111	SWAP(K)=AM(K,I)
	C(I)=C(J)
	DO 112 K=1,3
112	AM(K,I)=AM(K,J)
	C(J)=SWAPC
	DO 113 K=1,3
113	AM(K,J)=SWAP(K)
120	CONTINUE
C	NOW DELETE REDUNDANT C VALUES
	J=2
125	DO 130 I=J,NPOIT
	IF(C(I)-C(I-1))130,150,130
130	CONTINUE
	GO TO 170
150	DO 151 K=1,3
151	AM(K,I-1)=(AM(K,I)+AM(K,I-1))/2.
	NPOIT=NPOIT-1
	DO 160 K=I,NPOIT
	C(K)=C(K+1)
	DO 160 L=1,3
160	AM(L,K)=AM(L,K+1)
	J=I
	GO TO 125
170	A(1)=0.
	RMS(1)=0.
	JTRAP=0
	DO 210 I=2,NPOIT
	J=I-1
	K=I+1
	IF(I-NPOIT)310,305,305
305	JTRAP=1
	K=I
C	INTEGRAL SWAP(C).D[H(C)]
310	L=0
	DO 315 M=J,K
	L=L+1
	SWAP(L)=1./C(M)
315	H(L)=C(M)/AM(1,M)
	X(1)=AREA(SWAP,H,JTRAP)
	L=0
	DO 320 M=J,K
	L=L+1
	SWAP(L)=1./AM(2,M)
320	H(L)=ALOG(C(M))
	X(2)=AREA(SWAP,H,JTRAP)
	L=0
	DO 325 M=J,K
	L=L+1
	SWAP(L)=1./AM(3,M)
325	H(L)=ALOG(C(M)*AM(2,M))
	X(3)=AREA(SWAP,H,JTRAP)
C	AVERAGE
195	SXX=0.
	SX=0.
	DO 205 K=1,3
	SXX=SXX+X(K)**2
205	SX=SX+X(K)
	SX=SX/3.
	A(I)=A(J)+SX
	RMS(I)=SQRT(SXX/3.-SX**2)
210	RMS(I)=1./ABS(RMS(I)/SX+1.E-6)
	MID=NPOIT/2+1
	CON=A(MID)
	DO 220 I=1,NPOIT
220	A(I)=A(I)-CON
C	FIND MIN RMS AND NORMALIZE 0 - 1
	RMIN=RMS(2)
	RMAX=RMIN
	SX=0.
	DO 260 I=2,NPOIT
	RMSI=RMS(I)
	SX=SX+RMSI
	IF(RMIN-RMSI)240,240,230
230	RMIN=RMSI
240	IF(RMAX-RMSI)250,260,260
250	RMAX=RMSI
260	CONTINUE
	RMS(1)=SX/FLOAT(NPOIT-1)
	RMULT=.999/(RMAX-RMIN)
	DO 270 I=1,NPOIT
270	RMS(I)=(RMS(I)-RMIN)*RMULT+1.E-3
C
C	DELETE NEXT 3 LINES
	WRITE(1,2000)(I,C(I),A(I),RMS(I),I=1,NPOIT)
2000	FORMAT(I4,F7.3,2E15.6)
C
	CALL CHAIN('DYSON')
	END
