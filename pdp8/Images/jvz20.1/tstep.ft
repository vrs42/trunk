	SUBROUTINE STEP(DXY,J)
	COMMON FMSG,SAVE,TABLE
	COMMON A,ALPHA,GAMMA,RL
	COMMON BR,DX,DY
	COMMON DELCY,HALFPI,NMAX,PI,TWOPI,Y2
	COMMON N,XAIR1,YAIR1,XAIR2,YAIR2,XCOL1,XCOL2
	DIMENSION SAVE(8,3),TABLE(6,57)
	D1=ABS(DXY)
	J1=J
 10	STEPS=D1-2000.0
	IF (STEPS) 20,20,30
 20	STEPS=D1
	MORE=0
	GOTO 40
 30	STEPS=2000.0
	D1=D1-2000.0
	MORE=1
 40	IF (DXY) 50,60,60
 50	IDIR=J1+1
	GOTO 70
 60	IDIR=J1+2
 70	ISTEP=IFIX(STEPS)
	CALL STAGE(ISTEP,IDIR)
	IF (MORE) 80,80,10
 80	RETURN
	END
