C	GELSCN.FT TO SCAN GELS AND OTHER THINGS
C	NEEDS RHS, STAGE SUBROUTINES
C
	COMMON BR,DX,DY
	COMMON IXY,IYY
	DIMENSION IXY(2,500),IYY(500)
	WRITE(1,2005)
	WRITE(1,2008)
	READ(1,1000)MAG
1000	FORMAT('TYPE STEPS FROM CENTER SCAN (I3):',I3)
1	WRITE(1,2002)
2002	FORMAT(/'POSITION PLATE:',/,' 1) AT START OF SCAN')
	CALL RHS
	XSUM=0.
	YSUM=0.
	WRITE(1,2003)
2003	FORMAT(' 2) AT END OF SCAN')
	CALL RHS
	XSUM=DX
	YSUM=DY
	XF=DX
	CALL STEP(XSUM,0)
	CALL STEP(YSUM,2)
	IF(YSUM)5,10,5
5	WRITE(1,2001)
2001	FORMAT('CAUTION! SCANS ALONG X ONLY')
C	NOW GET NO. TIMES TO CALL STAGE
10	INX=XF/500.+1.
C	INX IS INCREMENT BETWEEN OD READINGS
	NOD=XF/FLOAT(INX)
C	MOVE STAGE DOWN 2 MAG
	J=2*MAG
	CALL STAGE(J,4)
	DO 25 I=1,500
	IXY(1,I)=I
25	IXY(2,I)=0
C	MAJOR LOOP FOR SCAN IS 50
	DO 50 J=1,3
	CALL STAGE(MAG,3)
	DO 30 I=1,NOD
S	6141
S	0110
S	0002
S	DCA \K
	IXY(2,I)=IXY(2,I)-K/3
30	CALL STAGE(INX,1)
C	RETURN STAGE FOR NEXT SCAN
40	OD=FLOAT(INX)*FLOAT(NOD)
50	CALL STEP(OD,0)
C	RETURN TO ORIGIN
	CALL STAGE(MAG,4)
C	NOW GET MAX AND MIN OD
	IMIN=512
	IMAX=-512
	DO 100 I=1,NOD
	IF(IXY(2,I)-IMIN)60,70,70
60	IMIN=IXY(2,I)
70	IF(IXY(2,I)-IMAX)100,100,80
80	IMAX=IXY(2,I)
100	CONTINUE
	YMULT=500./FLOAT(IMAX-IMIN)
	DO 110 I=1,NOD
	IYY(I)=IXY(2,I)
110	IXY(2,I)=FLOAT(IYY(I)-IMIN)*YMULT-250.
C	GET TOTAL OD
2005	FORMAT('POT 0 TO SET LEFT')
2008	FORMAT('POT 4 TO SET RIGHT AND ZERO')
120	M1=IABS(NALOG(0))-1
	M2=IABS(NALOG(4))-1
	CALL DISP1(NOD,IXY)
	CALL DISP6(M1)
	CALL DISP6(M2)
	M3=IXY(2,M2)
	CALL DISP5(M3)
	IF(KEYBD(0))120,120,130
130	SUM=0.
	J=IYY(M2)
	DO 140 I=M1,M2
140	SUM=SUM+FLOAT(IYY(I)-J)
	WRITE(1,2006)SUM
2006	FORMAT(/,'C TO GET PEAKS, Q TO EXIT',//,'TOTAL AREA = ',F12.0)
150	M1=IABS(NALOG(0))-1
	M2=IABS(NALOG(4))-1
	CALL DISP1(NOD,IXY)
	CALL DISP5(M3)
	CALL DISP6(M1)
	CALL DISP6(M2)
	M=KEYBD(0)
	IF(M-195)150,160,200
160	SUM1=0.
	DO 170 I=M1,M2
170	SUM1=SUM1+FLOAT(IYY(I)-J)
	RAT=SUM1/SUM
	WRITE(1,2007)SUM1,RAT
2007	FORMAT('   PEAK AREA = ',F12.0,'  RATIO = ',F8.2)
	GO TO 150
200	WRITE(1,2009)
2009	FORMAT(///)
	GO TO 1
	END
