C	LO SPEED SEDIMENTATION EQUILIBRIUM
C	STARTS WITH FIRST APPROXIMATION
C	DAVE TELLER APRIL 1973
	COMMON X,Y,CLN,DELX,NPOIT
	COMMON CZ,AMAG,AST
	DIMENSION X(50),Y(50),CLN(50)
C	SECOND EXTRAPOLATIONS
C	NEEDS QSMOOT.FT, AREA.FT ROUTINES
C	FOR THE LEAST SQUARES I WILL GO INTO
C	COLUMN 2X AS FAR AS THE EXTRAPOLATION
C	MODIFIED ABOVE STATEMENT TO 3X AND 4X 9/23/74
	CZCM=CZ-Y(1)
	WRITE(1,1000)CZCM
	INDIC=0
95	FP=3.+FLOAT(INDIC)
	XF=(FP+1.)*X(2)-FP*X(1)
	DO 100 I=2,NPOIT
	IF(X(I)-XF)100,100,130
100	CONTINUE
130	CALL QUAD(AI,BS,CS,2,I)
	CLN(1)=AI+BS*X(1)+CS*X(1)**2
140	N=NPOIT-1
	XF=(FP+1.)*X(N)-FP*X(NPOIT)
	DO 150 I=1,NPOIT
	IF(X(I)-XF)150,180,180
150	CONTINUE
180	I=I-1
	CALL QUAD(AI,BS,CS,I,N)
	CLN(NPOIT)=AI+BS*X(NPOIT)+CS*X(NPOIT)**2
190	Y(1)=EXP(CLN(1))
	Y(NPOIT)=EXP(CLN(NPOIT))
	IF(INDIC-1)200,195,195
195	NTIME=NPOIT-2
	CALL SMOOTH(15,2,NTIME)
C	REPLACE Y(I) BY SMOOTHED VALUES
	DO 205 I=2,N
	CLN(I)=Y(I)
205	Y(I)=EXP(Y(I))
200	INDIC=INDIC+1
C	RECALCULATE HINGE POINT
	SUM=0.
	N=NPOIT-1
	JTRAP=0
	DO 210 I=2,N
	J=I-1
	K=I+1
210	SUM=SUM+AREA(X(J),Y(J),JTRAP)
	I=N
	J=NPOIT
	SUM=SUM+X(J)*Y(J)-X(I)*Y(I)-(X(J)-X(I))*(Y(J)-Y(I))/(CLN(J)-CLN(
	1I))
	CZCM=((Y(NPOIT)-Y(1))*X(NPOIT)-SUM)/(X(NPOIT)-X(1))
	WRITE(1,1000)CZCM
1000	FORMAT('HINGE POINT =',F9.3)
	CM=CZ-CZCM
	CM=CM-Y(1)
	DO 220 I=1,NPOIT
220	Y(I)=Y(I)+CM
	IF(INDIC-1)95,95,230
230	CALL SMOOTH(15,2,NTIME)
	Y(1)=ALOG(Y(1))
	Y(NPOIT)=ALOG(Y(NPOIT))
	CALL CHAIN ('LPROG4')
	END
