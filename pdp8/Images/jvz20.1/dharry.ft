C	N-R OF MW(I) VS C(I) TO GET B,K
C	REQUIRES MATINV, A(2,2),B(2),C(2) AS FIRST COMMON
C
	COMMON A,B,C,S,AMW,X
C
	DIMENSION AK(2),S(2),B(2),X(150),AMW(150)
	DIMENSION A(2,2),C(2),GMSG(6),IXY(2,150),IP(2,25)
C
1	READ(1,997)NSET
997	FORMAT('#SETS (I1):',I2)
C	READ TITLES
	DO 5 I=1,NSET
5	READ(1,998)GMSG(I)
	READ(1,1502)AM1
1502	FORMAT('MONOMER M1 (F6.0):'F6.0)
998	FORMAT('TITLE:'A6)
	L=0
	CUT=.25
	DO 2 I=1,NSET
	HMSG=GMSG(I)
	CALL IOPEN('DSK',HMSG)
	READ(4,1500)NPOIT
1500	FORMAT(I4)
	DO 3 J=1,NPOIT
	L=L+1
	READ(4,1501)X(L),AMW(L)
	AMW(L)=AMW(L)/AM1
	X(L)=X(L)/4.
1501	FORMAT(12XF7.3,9XF9.0)
	IF(X(L)-CUT)4,3,3
4	L=L-1
3	CONTINUE
2	CONTINUE
	NOBS=L
C	GET FIRST APPROX
C
	SUMXY=0.
	SUMXQ=0.
	DO 10 I=1,NOBS
	SUMXY=SUMXY+(AMW(I)**2-1.)*X(I)
10	SUMXQ=SUMXQ+X(I)**2
	AK(1)=.25*SUMXY/SUMXQ
	WRITE(1,1503)AK(1)
1503	FORMAT('1-ST APPROX K ='E12.5)
	AK(2)=1.E-8
	NITER=10
	DO 999 I=1,NITER
	INDIC=0
	DO 25 JR=1,2
	B(JR)=0.
	DO 25 IC=1,2
25	A(IC,JR)=0.
	DO 60 I=1,NOBS
	D=-AMW(I)**2+((1.-AK(2)*AMW(I)*X(I))**2)*(1.+4.*AK(1)*X(I))
	AD=1.-AK(2)*AMW(I)*X(I)
	S(2)=2.*AD*(1.+4.*AK(1)*X(I))*(-AMW(I)*X(I))
	S(1)=4.*X(I)*AD**2
	DO 60 JR=1,2
	B(JR)=B(JR)+D*S(JR)
	DO 60 IC=1,2
60	A(IC,JR)=A(IC,JR)+S(IC)*S(JR)
C
	CALL MATINV(2)
C
	DO 70 I=1,2
	C(I)=0.
	DO 70 J=1,2
70	C(I)=C(I)+B(J)*A(I,J)
C
C	C(I) ARE UPDATES TO BE SUBTRACTED
C
	DO 80 I=1,2
	IF(ABS(C(I)/AK(I))-1.E-3)80,80,75
75	INDIC=1
80	AK(I)=AK(I)-C(I)
	WRITE(1,2001)(I,AK(I),C(I),I=1,2)
2001	FORMAT(I1' CST = 'E13.6' CNGE ='E13.6)
	IF(INDIC)999,100,999
999	CONTINUE
100	CONTINUE
C	COMPUTE RMS HERE
	SUM=0.
	DO 200 I=1,NOBS
	T1=SQRT(1.+4.*AK(1)*X(I))
	DEN=1.+AK(2)*X(I)*T1
	PRED=T1/DEN
	PRED=(PRED-AMW(I))**2
200	SUM=SUM+PRED
	SUM=AM1*SQRT(SUM/FLOAT(NOBS))
	WRITE(1,1504)SUM
1504	FORMAT('RMS ='F10.0//)
C	NOW DISPLAY OBS,PRED
C	FIND YMIN,YMAX,XMAX
	YMAX=0.
	YMIN=1.
	XMAX=0.
	DO 250 I=1,NOBS
	IF(AMW(I)-YMIN)210,220,220
210	YMIN=AMW(I)
220	IF(AMW(I)-YMAX)240,240,230
230	YMAX=AMW(I)
240	IF(X(I)-XMAX)250,250,245
245	XMAX=X(I)
250	CONTINUE
	T1=SQRT(1.+4.*AK(1)*XMAX)
	PRED=T1/(1.+AK(2)*XMAX*T1)
	IF(PRED-YMAX)255,255,251
251	YMAX=PRED
255	YMULT=500./(YMAX-YMIN)
	XMULT=500./XMAX
	DO 260 I=1,NOBS
	IXY(1,I)=X(I)*XMULT
	IXY(2,I)=YMULT*(AMW(I)-YMIN)-250.
260	CONTINUE
	DELX=XMAX/25.
	DX=-DELX
	DO 270 I=1,25
	DX=DX+DELX
	T1=SQRT(1.+4.*AK(1)*DX)
	DEN=1.+AK(2)*DX*T1
	PRED=T1/DEN
	IP(1,I)=XMULT*DX
	IP(2,I)=YMULT*(PRED-YMIN)-250.
270	CONTINUE
280	CALL DISP1(NOBS,IXY)
	CALL DISP2(25,IP)
	IF(KEYBD(0))1,280,1
	END
