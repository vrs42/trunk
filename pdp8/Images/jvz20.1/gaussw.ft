C	PROGRAM GAUSS.FT TO RESOLVE OVERLAPPING GAUSSIA
C	REQUIRES MATINV.FT AS SUBROUTINE
C	DO NOT CHANGE A,B,C IN COMMON BELOW
C	D.C.TELLER JAN.1974
C	MODOFIED FOR SCHLRN.FT OUTPUT 10/2/74
C
	COMMON A,B,C,S,X,Y
	DIMENSION X(100),Y(100),A(6,6),B(6),C(6)
	DIMENSION YM(2),AL(2),SIG(2),XB(2),EX(2),S(6)
C	READ VALUES
1	NEQ=2
	WRITE(1,1181)
	NPAR=6
	READ(1,1000)FMSG
1000	FORMAT('TYPE INPUT TITLE,A6:',A6)
	READ(1,1004)NITER
1004	FORMAT('# ITERATIONS,I2:',I2)
	CALL IOPEN('DTA1',FMSG)
	READ(4,1001)X1,XL
1001	FORMAT(10X2F10.0)
	READ(4,1001)DUM
	DO 5 I=1,2
5	READ(4,1002)X(I),Y(I)
	DELX=X(2)-X(1)
	NPOIT=IFIX((XL-X1)/DELX+1.)
	DO 10 I=3,NPOIT
10	READ(4,1002)X(I),Y(I)
1002	FORMAT(2F6.0)
C	READ FIRST ESTIMATES
	DO 15 I=1,NEQ
15	READ(1,1003)YM(I),XB(I),SIG(I)
1003	FORMAT('YMAX,X-BAR,SIGMA (3F4.0):',3F4.0)
C	SCALE VALUES TO 0.0-1.0
	YMIN=0.
	YMAX=Y(1)
	XMIN=X(1)
	XMAX=X(1)
	DO 90 I=1,NPOIT
	XI=X(I)
	YI=Y(I)
	IF(XMIN-XI)30,30,20
20	XMIN=XI
30	IF(XMAX-XI)40,70,70
40	XMAX=XI
70	IF(YMAX-YI)80,90,90
80	YMAX=YI
90	CONTINUE
	YMULT=1./(YMAX-YMIN)
	XMULT=1./(XMAX-XMIN)
	DO 100 I=1,NPOIT
	Y(I)=(Y(I)-YMIN)*YMULT
100	X(I)=(X(I)-XMIN)*XMULT
	DO 110 I=1,NEQ
	YM(I)=(YM(I)-YMIN)*YMULT
	XB(I)=(XB(I)-XMIN)*XMULT
	SIG(I)=SIG(I)*XMULT
110	AL(I)=1./SIG(I)**2
	NXS=NEQ+1
	NXF=NXS+NEQ-1
	NSS=NXF+1
	NSF=NSS+NEQ-1
C	COMMENCE ITERATION
	DO 999 KK=1,NITER
	INDIC=0
	WRITE(1,1999)KK
1999	FORMAT('ITERATION ',I4)
	DO 115 K=1,NPAR
	B(K)=0.
	DO 115 J=1,NPAR
115	A(K,J)=0.
	DO 152 I=1,NPOIT
	D=-Y(I)
	DO 120 J=1,NEQ
	EX(J)=EXP(-AL(J)*(X(I)-XB(J))**2)
	D=D+YM(J)*EX(J)
120	S(J)=EX(J)
	K=0
	DO 130 J=NXS,NXF
	K=K+1
130	S(J)=2.*YM(K)*AL(K)*EX(K)*(X(I)-XB(K))
	K=0
	DO 140 J=NSS,NSF
	K=K+1
140	S(J)=-YM(K)*EX(K)*(X(I)-XB(K))**2
	DO 150 K=1,NPAR
	B(K)=B(K)+D*S(K)*Y(I)
	DO 150 J=1,NPAR
150	A(K,J)=A(K,J)+S(K)*S(J)*Y(I)
C	MULTIPLYING BY Y(I) WEIGHTS HIGH PTS MOST
152	CONTINUE
C	MAY HAVE TOO MUCH NESTED HERE
	CALL MATINV(NPAR)
	DO 155 I=1,NPAR
	C(I)=0.
	DO 155 J=1,NPAR
155	C(I)=C(I)+B(J)*A(I,J)
C	UPDATE AND PRINTOUT
	DO 160 J=1,NEQ
	IF(ABS(C(J)/YM(J))-1.E-4)158,158,157
157	INDIC=1
158	WRITE(1,1160)YM(J),C(J)
1160	FORMAT('YM = ',E12.5,'  CHANGE =',E12.5)
160	YM(J)=YM(J)-C(J)
	K=0
	DO 170 J=NXS,NXF
	K=K+1
	IF(ABS(C(J)/XB(K))-1.E-4)165,165,164
164	INDIC=1
165	WRITE(1,1170)XB(K),C(J)
1170	FORMAT('XB = ',E12.5,'  CHANGE =',E12.5)
170	XB(K)=XB(K)-C(J)
	K=0
	DO 180 J=NSS,NSF
	K=K+1
	IF(ABS(C(J)/AL(K))-1.E-4)175,175,174
174	INDIC=1
175	WRITE(1,1180)AL(K),C(J)
1180	FORMAT('1/S^2 = ',E12.5,'  CHANGE =',E12.5)
180	AL(K)=AL(K)-C(J)
	WRITE(1,1181)
1181	FORMAT(///)
	IF(INDIC)190,190,999
999	CONTINUE
C	BACK TRANSFORM AND PREDICT VALUES
190	WRITE(1,1201)
1201	FORMAT('   I    YMAX   X-BAR   SIGMA')
	DO 200 I=1,NEQ
	YM(I)=YM(I)/YMULT+YMIN
	XB(I)=XB(I)/XMULT+XMIN
	SIG(I)=SQRT(1./AL(I))/XMULT
200	WRITE(1,1200)I,YM(I),XB(I),SIG(I)
1200	FORMAT(I4,3F8.0)
	RMS=0.
	DO 220 I=1,NPOIT
	X(I)=X(I)/XMULT+XMIN
	Y(I)=Y(I)/YMULT+YMIN
	PRED=0.
	DO 210 J=1,NEQ
	EX(J)=YM(J)*EXP(-((X(I)-XB(J))/SIG(J))**2)
210	PRED=PRED+EX(J)
	D=Y(I)-PRED
	RMS=RMS+D**2
220	WRITE(1,1220)I,X(I),Y(I),PRED,D,(EX(J),J=1,NEQ)
1220	FORMAT(I4,6F8.0)
	RMS=SQRT(RMS/FLOAT(NPOIT))
	WRITE(1,1221)RMS
1221	FORMAT('RMS FIT: ',F9.0)
	GO TO 1
	CALL EXIT
	END
