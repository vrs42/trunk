C	DYSON.FT IS A MODIFIED DYSON PROCEDURE FOR
C	COMPUTING SELF ASSOCIATION OF OUTPUT FROM HISPD
C	IS CALLED BY CHAIN FROM REORDR.FT
C	NEEDS: MATINV,REFINE,TABLE SUBROUTINES
C
	COMMON A,B,S
	COMMON NPOIT,C,AM,AV,W
	DIMENSION C(100),AM(3,100)
	DIMENSION A(7,7),B(7),CA(7)
	DIMENSION AV(100),W(100)
	DIMENSION S(7),NMER(6)
	MAX=7
1	READ(1,1000)AM1
1000	FORMAT('MONOMER MOL WT (F6.0):'F6.0)
	READ(1,1001)NCOMP
1001	FORMAT('# COMPONENTS:'I1)
	WRITE(1,1002)
1002	FORMAT('STOICHIOMETRY NEXT [MULTIPLE I1 FORMAT]')
	READ(1,1003)(NMER(J),J=1,NCOMP)
1003	FORMAT(':'6I1)
C	ZERO MATRIX
	DO 10 K=1,MAX
	B(K)=0.
	DO 10 J=1,MAX
10	A(K,J)=0.
C	DO LEAST SQUARES
	DO 150 I=1,NPOIT
	E=EXP(AM1*AV(I))
	DO 20 J=1,NCOMP
	L=NMER(J)
20	S(J)=E**L
	DO 150 K=1,NCOMP
	B(K)=B(K)+C(I)*W(I)*S(K)
	DO 150 J=1,NCOMP
150	A(K,J)=A(K,J)+S(K)*S(J)*W(I)
	CALL MATINV(NCOMP)
	DO 155 I=1,NCOMP
	CA(I)=0.
	DO 155 J=1,NCOMP
155	CA(I)=CA(I)+B(J)*A(I,J)
C
	IVIR=0
	CALL REFINE(NCOMP,AM1,NMER,CA,IVIR)
	CALL TABLE(NCOMP,AM1,NMER,CA,IVIR)
	NTERM=NCOMP+1
	CA(NTERM)=1.E-9
	IVIR=1
	CALL REFINE(NTERM,AM1,NMER,CA,IVIR)
	WRITE(1,2000)CA(NTERM)
2000	FORMAT(///'NON IDEALITY:  B ='E15.6)
	CALL TABLE(NCOMP,AM1,NMER,CA,IVIR)
	GO TO 1
	END
