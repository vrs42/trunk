C	ITERATE FOR C-0-A AND C-0-B MONOMER
C	FIRST GET FOR K-PRIME = 0.
1	READ(1,1000)H,AK
1000	FORMAT('H,K (F6.4,F5.3):'F6.4,F5.3)
2	READ(1,1001)C0A
1001	FORMAT('C0A (F3.1):'F3.1)
	READ(1,1002)C0B
1002	FORMAT('C0B:'F3.1)
	CT=C0A+C0B
	CZA=C0A/2.
	DEN=1.+2.*H*AK*CT
10	T2=2.*H*AK*C0B/ALOG(1./(1.-2.*H*AK*CZA))
	CZAN=CT/(DEN+T2)
	IF(ABS(CZAN-CZA)-1.E-5)30,30,20
20	CZA=CZAN
	GO TO 10
30	CZB=C0B*2.*H*AK*CZAN/ALOG(1./(1.-2.*H*AK*CZAN))
	WRITE(1,2000)CZAN,CZB
2000	FORMAT(/'CZA = 'E13.6/'CZB = 'E13.6)
	GO TO 2
	END
