	SUBROUTINE PROG2(ICELL)
C	PROG2.FT GETS CHAINED BY PROG1; REQUIRES SMOOTH.FT SUBROUTINE
C	VERSION OF SMOOTH.FT DOES NOT SMOOTH FINAL POINTS
C
	COMMON X,Y,SEPR,DELX,NPOIT,RIR,ROR
	COMMON IXY
	DIMENSION X(200),Y(200),IXY(2,200),CLN(200)
C	GET DATA TO 125 MICRONS FOR EDITING
	X1=X(1)
	DELX=X(2)-X1
	DO 10 I=1,NPOIT
	IF(Y(I)-125.)10,20,20
10	CONTINUE
20	NPT=I
	MULT=3
	IF(NPT-85)30,30,40
30	MULT=6
40	DO 50 I=1,NPT
	IXY(1,I)=MULT*I
50	IXY(2,I)=IFIX(4.*(Y(I)-1.))-250
	WRITE(1,2000)
2000	FORMAT('Q TO CONT.,E TO EDIT, F TO SET LIMIT')
60	M1=IABS(NALOG(0))-1
	M2=NALOG(1)/2
	CALL DISP1(NPT,IXY)
	CALL DISP2(NPT,IXY)
	CALL DISP6(M1)
	CALL DISP5(M2)
	CALL DISP5(-250)
	L=KEYBD(0)
	IF(L-197)60,70,80
70	K=M1/MULT+1
	Y(K)=FLOAT(M2+250)/4.+1.
	IXY(2,K)=IFIX(4.*(Y(K)-1.))-250
	GO TO 60
80	IF(L-198)90,90,110
90	K=M1/MULT+1
	NPOIT=NPOIT-K+1
	NPT=NPT-K+1
	K=K-1
	DO 100 I=1,NPOIT
	K=K+1
	X(I)=X(K)
	Y(I)=Y(K)
100	IXY(2,I)=IXY(2,K)
	GO TO 60
110	CALL SMOOTH(13,4,1,NPT,CLN,Y)
	NP=NPT-6
	DO 120 I=1,NP
120	Y(I)=CLN(I)
C	NOW DISPLAY LOG DATA TO EDIT AND SET NEW LIMIT
	NSTART=1
	COR=.1*SEPR
	DO 140 I=1,NPT
	IF(Y(I)-COR)130,130,140
130	NSTART=I
140	CONTINUE
	NSTART=NSTART+1
	NPT=NPOIT-NSTART+1
	MULT=3
	IF(NPT-85)150,150,160
150	MULT=6
160	K=0
	RMIN=ALOG(COR)
	RMAX=ALOG(10.*SEPR)
	DO 180 I=NSTART,NPOIT
	K=K+1
	IXY(1,K)=MULT*K
	CLN(K)=ALOG(Y(I))
	IF(CLN(K)-RMAX)180,180,170
170	RMAX=CLN(K)
180	CONTINUE
	YMULT=500./(RMAX-RMIN)
	DO 190 I=1,NPT
190	IXY(2,I)=IFIX(YMULT*(CLN(I)-RMIN))-250
	L1=-250
	L2=IFIX(YMULT*(ALOG(SEPR)-RMIN))-250
	L3=IFIX(YMULT*(ALOG(10.*SEPR)-RMIN))-250
200	M1=IABS(NALOG(0))-1
	CALL DISP1(NPT,IXY)
	CALL DISP2(NPT,IXY)
	CALL DISP6(M1)
	CALL DISP5(L1)
	CALL DISP5(L2)
	CALL DISP5(L3)
	L=KEYBD(0)
	IF(L-197)200,210,220
210	K=M1/MULT+1
	CLN(K)=(CLN(K+1)+CLN(K-1))/2.
	Y(K+NSTART)=EXP(CLN(K))
	IXY(2,K)=IFIX(YMULT*(ALOG(Y(K+NSTART))-RMIN))-250
C	FUNNY STUFF ABOVE IS CHECK ON INDEXING
	GO TO 200
220	IF(L-198)230,230,240
230	K=M1/MULT+1
	NPOIT=K+NSTART
	NPT=K
	GO TO 200
240	DO 310 I=1,NPT
	IF(IXY(2,I)-L2)300,300,310
300	NSTAR=I
310	CONTINUE
	NSX=NSTAR+NSTART-1
	IF(NSX-NPOIT)315,312,390
312	NSX=NSTART
315	SLOPE=ALOG(Y(NPOIT)/Y(NSX))/(X(NPOIT)-X(NSX))
	AINT=ALOG(Y(NSX))-SLOPE*X(NSX)
	MULT=500/(NPOIT-NSX+1)
	RMIN=0.
	RMAX=0.
	J=0
	DO 350 I=NSX,NPOIT
	J=J+1
	DEV=ALOG(Y(I))-AINT-SLOPE*X(I)
	IXY(1,J)=J*MULT
	IF(DEV-RMIN)320,330,330
320	RMIN=DEV
330	IF(DEV-RMAX)350,350,340
340	RMAX=DEV
350	CLN(J)=DEV
	NDIS=J
	IF(RMAX-RMIN)355,390,355
355	YMULT=500./(RMAX-RMIN)
	DO 360 I=1,NDIS
360	IXY(2,I)=IFIX((CLN(I)-RMIN)*YMULT)-250
	L1=IFIX(-RMIN*YMULT)-250
370	M1=IABS(NALOG(0))-1
	CALL DISP1(NDIS,IXY)
	CALL DISP2(NDIS,IXY)
	CALL DISP6(M1)
	CALL DISP5(L1)
	L=KEYBD(0)
	IF(L-198)370,380,390
380	K=M1/MULT+1
	NPOIT=NSX+K-1
C	?IS ABOVE CORRECT?
	NDIS=K
	GO TO 315
390	YMIN=Y(1)
	DO 410 I=1,NPOIT
	IF(Y(I)-YMIN)400,410,410
400	YMIN=Y(I)
410	CONTINUE
	YMIN=YMIN-1.
	WRITE(4,2001)NPOIT,SEPR
2001	FORMAT(I4,F6.1)
	WRITE(4,2002)RIR,ROR
C	MAKE Y(MIN)=1. AS EXPECTED BY HISPD
	DO 250 I=1,NPOIT
	Y(I)=Y(I)-YMIN
250	WRITE(4,2002)X(I),Y(I)
2002	FORMAT(2F6.0)
	RETURN
	END
