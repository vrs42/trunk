	SUBROUTINE SCAN(NY,IY)
C	FOR SCHLIEREN SCANS
	COMMON BR,DX,DY
	COMMON IXY
	DIMENSION IXY(2,500)
	DO 50 I=1,NY
	IXY(1,I)=I
C	READ OD
S	6141
S	0110
S	0002
S	DCA \J
	OD=BR-FLOAT(J)
	IXY(2,I)=OD
	CALL STAGE (IY,3)
50	CONTINUE
C	RETURN STAGE
	OD=FLOAT(IY)*FLOAT(NY)
	CALL STEP(OD,2)
	RETURN
	END
