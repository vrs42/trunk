C	EQUIVALENT BOUNDARY SEDIMENTATION COEFFICIENT
C	DAVE TELLER APRIL 1973
	COMMON X,DELX,NPOIT
	COMMON CZ,AMAG,AST
	COMMON Y,X1,DYDX,IXY
	DIMENSION X(150),Y(150),DYDX(150)
	DIMENSION IXY(2,150)
	XP=X(NPOIT)
C	FIND NO. POINTS
	NPOIT=IFIX((XP-X(2))/DELX)+2
	DELX=DELX*AMAG
	DYDX(1)=0.
	N=NPOIT-1
	CALL DERIV(A2,A3,Y,DYDX,7,2,N)
C	NPT=7 ABOVE
	WRITE(1,2006)NPOIT
	DO 70 I=1,NPOIT
	DYDX(I)=DYDX(I)/DELX
70	X(I)=5.6459+AMAG*X(I)
	XMIN=5.8
	XMAX=7.2
	DYMIN=500.
	DYMAX=0.
	DO 390 I=1,NPOIT
	X1=X(I)
	Y1=DYDX(I)
	IF(X1-XMAX)330,330,320
320	XMAX=X1
330	IF(X1-XMIN)340,350,350
340	XMIN=X1
350	IF(Y1-DYMAX)370,370,360
360	DYMAX=Y1
370	IF(Y1-DYMIN)380,390,390
380	DYMIN=Y1
390	CONTINUE
	XMAX=500./(XMAX-XMIN)
	DYMAX=500./(DYMAX-DYMIN)
	DO 400 I=1,NPOIT
	IXY(1,I)=IFIX((X(I)-XMIN)*XMAX)
400	IXY(2,I)=IFIX((DYDX(I)-DYMIN)*DYMAX)-250
	N=NPOIT+1
	IF(N-150)71,75,75
71	DO 73 I=N,150
	X(I)=0.
	DYDX(I)=0.
73	Y(I)=0.
75	J=NPOIT/3+1
	J2=2*J
	K=J
	DO 77 I=1,J
	K=K+1
	J2=J2+1
77	WRITE(1,2006)I,X(I),Y(I),DYDX(I),K,X(K),Y(K),DYDX(K),
	1J2,X(J2),Y(J2),DYDX(J2)
2006	FORMAT(3(1XI4,F7.4,F6.2,F6.1,))
C	GET INTEGRAL OF X^2.DC
	SUM=0.
	N=NPOIT-1
	DO 80 I=1,N
	YJ=Y(I+1)
	YI=Y(I)
	XJ=X(I+1)**2
	XI=X(I)**2
80	SUM=SUM+.5*(XJ+XI)*(YJ-YI)
	J=NPOIT-2
	SUM2=0.
	DO 90 I=J,NPOIT
90	SUM2=SUM2+Y(I)
	SUM2=SUM2/3.
	XB=SQRT(SUM/SUM2)
	XBLOG=ALOG(XB)
C	RADIAL DILUTION
	CZ=(XB**2)*SUM2/X(1)**2
	WRITE(1,2000)XB,XBLOG,CZ
2000	FORMAT('X-BAR =',F7.4,'  LOG X =',F9.5,'  C-ZERO =',F7.3)
C	ADD DISPLAY AND KEYBD ROUTINES HERE
95	READ(1,1000)N
1000	FORMAT('TYPE MAX OR MIN PT. NO.(0 TO EXIT)(I3):',I3)
	IF(N)200,200,100
100	ISTART=N-3
	NTIME=N+4-ISTART
	CALL DERIV(A2,A3,DYDX,Y,7,ISTART,NTIME)
C	CAUTION: Y VALUES SURROUNDING X-MAX OR X-MIN ARE DESTROYED
	TM=-A2/A3
	XB=DELX*TM+X(N)
	XBLOG=ALOG(XB)
	WRITE(1,2001)XB,XBLOG
2001	FORMAT('X ='F7.4,'  LOG X =',F9.5)
	GO TO 95
200	WRITE(1,2002)
2002	FORMAT('SET S.SW.2 = 1 TO CONNECT PTS.')
	WRITE(1,2003)
2003	FORMAT('STRIKE ANY KEY TO ESCAPE')
220	CALL DISP1(NPOIT,IXY)
	IF(ISENS(2))240,240,230
230	CALL DISP2(NPOIT,IXY)
240	IF(KEYBD(0))250,220,250
250	CALL CHAIN('PROG1')
	END
