	COMMON FMSG,SAVE,TABLE
	COMMON A,ALPHA,GAMMA,RL
	COMMON BR,DX,DY
	COMMON DELCY,HALFPI,NMAX,PI,TWOPI,Y2
	COMMON N,XAIR1,YAIR1,XAIR2,YAIR2,XCOL1,XCOL2
	DIMENSION SAVE(8,3),TABLE(6,57)
C	ROUTINE TO CALCULATE COS-SIN TABLE INITIALLY
C	SET PARAMETERS
10	READ (1,2001)FMSG
2001	FORMAT('TYPE TITLE(A6):',A6)
	NMAX=56
	WRITE(1,2002)
2002	FORMAT(/,'POSITION PLATE:',/,' 1)ON REFERENCE WIRE')
	CALL RHS
	WRITE(1,2003)
2003	FORMAT(/,' 2)FOR BACKGROUND')
	CALL STAGE(400,4)
	CALL RHS
	OD=0.
	DO 20 I=1,100
S	CPAGE 7
S	6141
S	0110
S	0002
S	DCA \J
	OD=OD+FLOAT(J)
20	CALL STAGE(1,1)
	BR=OD/100.
	CALL STAGE(100,2)
	CALL STAGE(400,3)
	CALL STEP(DX,0)
	CALL STEP(DY,2)
	CALL STAGE(50,1)
 2004	FORMAT(//,' 3) FOR SCAN')
	WRITE (1,2004)
	CALL RHS
	XAIR1=50.0+DX
	YAIR1=DY
	CALL STAGE(222,4)
	CALL SCAN(0)
	CALL STEP(YAIR1,2)
	CALL STEP(XAIR1,0)
	GO TO 10
	END
