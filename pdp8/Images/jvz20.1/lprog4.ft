C	PROGRAM 5 COMPUTE AMW,AMZ(?)
C	CHAINED FROM LPROG4
C	REQUIRES DERIV.FT AS SUBROUTINE
C	REQUIRES FUNCTION AREA.FT ALSO
C	DAVE TELLER APRIL 1973
	COMMON X,Y,CLN,DELX,NPOIT
	COMMON CZ,AMAG,AST
	COMMON AMW,AMZ
	DIMENSION X(50),Y(50),CLN(50)
	DIMENSION AMW(50),AMZ(50)
	FACT=DELX
	READ(1,2000)FMSG
2000	FORMAT('TYPE OUTPUT TITLE(A6):',A6)
	CALL OOPEN('DTA1',FMSG)
C	ENTER WITH Y=LOG C,X=X^2
C	UNLES S.SW. 0 = 1; THEN X NOT X^2
	T1=(X(1)-X(9))/DELX
	TN=(X(NPOIT)-X(NPOIT-8))/DELX
	NTIME=NPOIT-2
	CALL DERIV(Y,CLN,15,2,NTIME,T1,TN)
	WRITE(1,1001)
1001	FORMAT('   I    X(I)   C(I) LOG C(I)    MW(I)    MZ(I)')
	DO 10 I=1,NPOIT
	IF(ISENS(0))7,7,5
5	FACT=2.*X(I)*DELX
7	CLN(I)=CLN(I)/FACT
10	AMW(I)=ALOG(CLN(I)*EXP(Y(I)))
	T1=(X(1)-X(12))/DELX
	TN=(X(NPOIT)-X(NPOIT-11))/DELX
	CALL DERIV(AMW,AMZ,21,2,NTIME,T1,TN)
	WRITE(4,1002)NPOIT
	DO 20 I=1,NPOIT
	IF(ISENS(0))17,17,15
15	FACT=2.*X(I)*DELX
17	C=EXP(Y(I))
	AMW(I)=C
	CLN(I)=AST*CLN(I)
	AMZ(I)=AST*AMZ(I)/FACT
	WRITE(1,1002)I,X(I),C,Y(I),CLN(I),AMZ(I)
20	WRITE(4,1002)I,X(I),C,Y(I),CLN(I),AMZ(I)
1002	FORMAT(I4,F8.4,F7.3,F9.5,2F9.0)
	CB=EXP(Y(NPOIT))
	CM=EXP(Y(1))
	AMWC=AST*(CB-CM)/(CZ*(X(NPOIT)-X(1)))
	IF(ISENS(0))70,70,30
30	JTRAP=0
	SUM=0.
	DO 60 I=2,NPOIT
	J=I-1
	K=I+1
	IF(I-NPOIT)40,35,35
35	JTRAP=1
	K=I
40	DO 50 M=J,K
50	AMZ(M)=1./X(M)
60	SUM=SUM+AREA(AMZ(J),AMW(J),JTRAP)
	AMWC=AST*SUM/(2.*CZ*(X(NPOIT)-X(1)))
70	AMZC=(CB*CLN(NPOIT)-CM*CLN(1))/(CB-CM)
	WRITE(1,1003)AMWC,AMZC
1003	FORMAT('M(W) =',F10.0/,'M(Z) =',F10.0)
	CALL OCLOSE
	CALL CHAIN('LPROG1')
	END
