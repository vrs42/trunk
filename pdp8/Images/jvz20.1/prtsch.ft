	DIMENSION X(100),Y(100),IY(100)
	DIMENSION XM(4),YM(4)
1	READ(1,1000)FMSG
1000	FORMAT('TYPE TITLE (A6):',A6)
	CALL IOPEN('DTA1',FMSG)
	READ(4,1002)(XM(I),I=1,4)
1002	FORMAT(4F10.0)
	READ(4,1002)(YM(I),I=1,4)
	READ(4,1005)X(1),Y(1)
	READ(4,1005)X(2),Y(2)
	DX=X(2)-X(1)
	XL=XM(3)
	X1=X(1)
	NPOIT=IFIX((XL-X1)/DX)+1
	DO 10 I=3,NPOIT
	READ(4,1005)X(I),Y(I)
10	WRITE(1,1005)X(I),Y(I)
1005	FORMAT(2F6.0)
	YMIN=0.
	YMAX=0.
	DO 20 I=1,NPOIT
	IF(Y(I)-YMIN)30,40,40
30	YMIN=Y(I)
40	IF(Y(I)-YMAX)20,20,50
50	YMAX=Y(I)
20	CONTINUE
	YMULT=500./(YMAX-YMIN)
	DO 60 I=1,NPOIT
60	IY(I)=IFIX(YMULT*(Y(I)-YMIN))-250
70	CALL DISP3(NPOIT,IY)
	IF(ISENS(0))90,90,80
80	CALL DISP4(NPOIT,IY)
90	IF(KEYBD(0))70,70,100
100	GO TO 1
	END
