C	PLOTM.FT, A PROGRAM TO PLOT MOL WT OUTPUT FROM HISPD2
C	NEEDS AXIS,PLOTER,PENUP,PENDN SUBROUTINES
C	6/5/75   D.C.T.
	COMMON C,AM
	DIMENSION C(300),AM(3,300)
	DIMENSION IXY(2,100)
	DIMENSION NPOIT(3)
C
1	READ(1,1000)NSET
1000	FORMAT('TYPE # SETS IN FILE:'I2)
	READ(1,1302)CUT
1302	FORMAT('CONCN CUTOFF (F3.1):'F3.1)
10	READ(1,1001)FMSG
1001	FORMAT('INPUT TITLE:'A6)
	READ(1,1004)JNDIC
1004	FORMAT('3 PLOTS OR 1 ?:'I1)
	INDIC=1
4	L=0
	CALL IOPEN('DSK',FMSG)
	DO 30 II=1,NSET
	ICT=0
	READ(4,1002)NPOIT(II)
1002	FORMAT(I4)
	NPT=NPOIT(II)
	DO 15 I=1,NPT
	L=L+1
	ICT=ICT+1
	READ(4,1003)C(L),AM(1,L),AM(2,L),AM(3,L)
	IF(C(L)-CUT)12,13,13
12	L=L-1
	ICT=ICT-1
	GO TO 15
13	IF(C(L)-20.)15,15,14
14	L=L-1
	ICT=ICT-1
15	CONTINUE
	NPOIT(II)=ICT
1003	FORMAT(12XF7.3,3F9.0)
30	CONTINUE
	NTOT=L
C
C	FIND YMN,YMAX
C
	XMAX=10.
	YMIN=AM(1,1)
	YMAX=AM(1,1)
	DO 100 I=1,NTOT
	DO 50 II=1,3
	IF(AM(II,I)-YMIN)60,70,70
60	YMIN=AM(II,I)
70	IF(AM(II,I)-YMAX)50,50,80
80	YMAX=AM(II,I)
50	CONTINUE
	IF(C(I)-10.)100,100,90
90	XMAX=20.
100	CONTINUE
	WRITE(1,2000)YMIN,YMAX,XMAX
	MAG=ALOG(YMAX)/2.303-1.
	DENOM=10.**MAG
	MAX=YMAX/DENOM+1.
	MIN=YMIN/DENOM
	NHL=MAX-MIN
	YMIN=FLOAT(MIN)*DENOM
	YMAX=FLOAT(MAX)*DENOM
	WRITE(1,2000)YMIN,YMAX,XMAX
2000	FORMAT('MIN =',F9.0/'MAX =',F9.0/'C-MAX =',F4.0,' FRINGES')
	READ(1,1006)P
1006	FORMAT('SET NEW LIMITS?'A6)
	IF(P-'YES   ')105,300,105
300	READ(1,1007)YMAX,YMIN
1007	FORMAT('YMAX, YMIN (2F6.0):'2F6.0)
	NHL=(YMAX-YMIN)/DENOM
C	NOW GET REASONABLE # H.L. IF POSSIBLE
105	IF(NHL-15)350,350,310
310	IF(NHL/2-15)320,320,340
320	NHL=NHL/2
	IR=IREM(0)
	IF(IR)350,350,330
330	YMAX=YMAX+DENOM
	NHL=NHL+1
	GO TO 350
340	NHL=NHL/5
	IR=IREM(0)
	IF(IR)350,350,345
345	YMAX=YMAX+FLOAT(5-IR)*DENOM
	NHL=NHL+1
350	RINCR=(YMAX-YMIN)/FLOAT(NHL)
	WRITE(1,1008)RINCR
1008	FORMAT('Y-AXIS INCREMT =',F8.0,' G/MOLE')
	YMULT=500./(YMAX-YMIN)
	XMULT=500./(XMAX)
	DO 110 I=1,NTOT
	C(I)=C(I)*XMULT
	DO 110 II=1,3
110	AM(II,I)=(AM(II,I)-YMIN)*YMULT-250.
	DO 200 K=1,3
	IF(JNDIC-1)220,210,220
210	IF(K-1)230,215,230
215	CALL AXIS(YMAX,YMIN,XMAX,NHL,INDIC)
	GO TO 230
220	WRITE(1,1005)
1005	FORMAT('MOVE TO NEW LOC OR PAPER')
	CALL AXIS(YMAX,YMIN,XMAX,NHL,INDIC)
230	NSTOP=0
	DO 200 II=1,NSET
	NSTART=NSTOP+1
	NSTOP=NSTOP+NPOIT(II)
	J=0
	DO 120 I=NSTART,NSTOP
	J=J+1
120	IXY(1,J)=C(I)
	J=0
	DO 130 I=NSTART,NSTOP
	J=J+1
130	IXY(2,J)=AM(K,I)
	N=J
	CALL PLOTER(N,IXY,INDIC)
200	CONTINUE
	IF(JNDIC-1)1,240,1
240	NSTOP=0
	DO 260 II=1,NSET
	NSTART=NSTOP+1
	NSTOP=NSTOP+NPOIT(II)
	J=0
	DO 250 I=NSTART,NSTOP
	J=J+1
	IXY(1,J)=C(I)
250	IXY(2,J)=2.*AM(1,I)-AM(2,I)
	N=J
	CALL PLOTER(N,IXY,INDIC)
260	CONTINUE
	GO TO 1
	END
