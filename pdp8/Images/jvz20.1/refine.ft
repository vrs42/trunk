	SUBROUTINE REFINE(NCOMP,AM1,NMER,CA,IVIR)
C
C	REFINE FIT BY NEWTON-RAPHSON
C
	COMMON A,B,S
	COMMON NPOIT,C,AM,AV,W
	DIMENSION A(7,7),B(7),CA(7)
	DIMENSION C(100),AM(3,100),AV(100),W(100)
	DIMENSION S(7),NMER(6)
C
	MID=NPOIT/2+1
	CAT=C(MID)
	VIR=0.
C	WHEN COMES IN FOR NON-IDL NCOMP IS NTERM IS NCOMP + 1
	NC=NCOMP
	IF(IVIR)310,310,305
305	NC=NCOMP-1
310	DO 599 KKL=1,20
	INDIC=0
	DO 315 K=1,NCOMP
	B(K)=0.
	DO 315 J=1,NCOMP
315	A(K,J)=0.
	DO 350 I=1,NPOIT
	DELC=C(I)-CAT
	S(NCOMP)=0.
	D=-C(I)
	E=EXP(AM1*(AV(I)-VIR*DELC))
	DO 320 J=1,NC
	L=NMER(J)
	T1=E**L
	D=D+CA(J)*T1
	S(J)=T1
	IF(IVIR)320,320,317
317	FL=L
	S(NCOMP)=S(NCOMP)-FL*AM1*DELC*T1*CA(J)
320	CONTINUE
	DO 350 K=1,NCOMP
	B(K)=B(K)+D*S(K)*W(I)
	DO 350 J=1,NCOMP
350	A(K,J)=A(K,J)+S(K)*S(J)*W(I)
	CALL MATINV(NCOMP)
	DO 400 K=1,NCOMP
	CN=0.
	DO 355 J=1,NCOMP
355	CN=CN+B(J)*A(K,J)
	IF(ABS(CN/CA(K))-1.E-4)370,370,360
360	INDIC=1
370	CA(K)=CA(K)-CN
C
C	IF(CA(K))380,380,400
C	380 INDIC=1
C	CA(K)=0.
C
400	CONTINUE
	IF(IVIR)410,410,405
405	VIR=CA(NCOMP)
410	IF(INDIC)420,420,599
599	CONTINUE
	WRITE(1,2000)
2000	FORMAT('N-R = 20 ITERATIONS')
420	RETURN
	END
