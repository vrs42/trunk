C	LO SPEED SEDIMENTATION EQUILIBRIUM
C	STARTERS WITH FIRST APPROXIMATION
C	NEEDS QUAD3.FT SUBROUTINE
C	DAVE TELLER APRIL 1973
	COMMON X,DELX,NPOIT
	COMMON CZ,AMAG,AST
	COMMON Y,X1,CLN
	DIMENSION X(150),Y(150),CLN(150)
C	FIRST EXTRAPOLATION TO MENISCUS AND BOTTOM
	K=NPOIT+1
	N=NPOIT+2
	DO 510 I=1,NPOIT
	K=K-1
	N=N-1
	X(N)=X(K)
510	Y(N)=Y(K)
	NPOIT=NPOIT+2
	READ(1,2010)CZ
2010	FORMAT('TYPE C(0)[FRINGES,F5.3]:'F5.3)
	READ(1,2011)AMAG
2011	FORMAT('AMAG (F7.7):'F7.7)
	AMAG=.01*AMAG
	READ(1,2012)AST
2012	FORMAT('2RT/(1-VP)W^2 (E12.6):'E12.6)
	READ(1,2013)X(1),X(NPOIT)
2013	FORMAT('XM,XB (2F4.0):'2F4.0)
	Y(1)=0.
	J=2
	K=1
	L=0
15	XF=4.*X(J)-3.*X(K)
C	GO IN 3X AS FAR AS DELTA X(M) AND X(B)
	DO 20 I=1,NPOIT
	IF(X(I)-XF)20,25,25
20	CONTINUE
25	IF(J-K)35,35,30
30	IF(I-J-2)31,31,32
31	I=J+4
32	CALL QUAD(AI,BS,CS,J,I)
	GO TO 40
35	IF(J-I-2)36,36,37
36	I=J-4
37	CALL QUAD(AI,BS,CS,I,J)
40	Y(K)=AI+BS*X(K)+CS*X(K)**2
	IF(L)50,50,60
50	J=NPOIT-1
	K=NPOIT
	L=1
	GO TO 15
60	CM=Y(1)
	ISQARE=2
	IF(ISENS(0))67,67,63
63	ISQARE=1
67	DO 70 I=1,NPOIT
	Y(I)=Y(I)-CM
70	X(I)=(5.6262+AMAG*X(I))**ISQARE
C	GET INTEGRAL OF X^2.DC
	SUM=0.
	N=NPOIT-2
	DO 80 I=1,N
	YJ=Y(I+1)
	YK=Y(I+2)
	YI=Y(I)
	XJ=X(I+1)
	XK=X(I+2)
	XI=X(I)
	T=((YJ-YI)**3)*((XK-XJ)/(YK-YJ)-(XJ-XI)/(YJ-YI
	1))/(YK-YI)
80	SUM=SUM+.5*(XJ+XI)*(YJ-YI)-T/6.
	SUM=SUM+.5*(X(NPOIT)+X(N+1))*(Y(NPOIT)-Y(N+1))
	CZCM=((Y(NPOIT)-Y(1))*X(NPOIT)-SUM)/(X(NPOIT)-X(1))
	CM=CZ-CZCM
	DO 90 I=1,NPOIT
	Y(I)=Y(I)+CM
90	CLN(I)=ALOG(Y(I))
	DELX=(X(NPOIT-1)-X(2))/47.
	Y(51)=Y(1)
	Y(101)=CLN(1)
	Y(100)=Y(NPOIT)
	Y(150)=CLN(NPOIT)
	J=51
	K=101
	N=NPOIT-1
	XI=X(2)-DELX
	DO 120 JJ=1,48
	XI=XI+DELX
	J=J+1
	K=K+1
	DO 100 I=2,N
	IF(X(I)-XI)100,100,110
100	CONTINUE
110	CLNI=CLN(I-1)+(CLN(I)-CLN(I-1))*(XI-X(I-1))/(X(I)-X(I-1))
	Y(K)=CLNI
120	Y(J)=EXP(CLNI)
	X(50)=X(NPOIT)
	J=50
	K=100
	XI=X(2)
	DO 130 I=1,50
	J=J+1
	K=K+1
	X(J)=Y(J)
130	X(K)=Y(K)
	DO 140 I=2,49
140	X(I)=XI+DELX*FLOAT(I-2)
	NPOIT=50
	CALL CHAIN ('LPROG3')
	END
