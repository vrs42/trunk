	SUBROUTINE DERIV(Y,DYDX,NPT,ISTART,NTIME,T1,TN)
	COMMON Q,R,S,DELX,NPOIT
	COMMON CZ,AMAG,AST
	DIMENSION Q(50),R(50),S(50)
	DIMENSION Y(50),DYDX(50)
C	NPT NECESSARILY ODD,NTERM=3,NTIME=#PTS TO BE SMOOTHED
	M=(NPT-1)/2
	AM=FLOAT(M)
	G2=3./(AM*(AM+1.)*(2.*AM+1.))
	T32=AM*(AM+1.)
	T33=AM*(2.*AM-1.)
	G3=5./(T33*(AM+1.)*(2.*AM+1.)*(2.*AM+3.))
	JTIME=NTIME-2*M
	JSTART=ISTART-1
	DO 100 K=1,JTIME
	JSTART=JSTART+1
	JM=JSTART+M
	JSTOP=JSTART+NPT-1
	A2=0.
	A3=0.
	T=-(AM+1.)
	DO 30 I=JSTART,JSTOP
	T=T+1.
	A2=A2+Y(I)*T
30	A3=A3+Y(I)*(3.*T**2-T32)
	A2=A2*G2
	A3=6.*A3*G3
	IF(K-1)50,50,60
50	T=-(AM+1.)
	DO 55 I=JSTART,JM
	T=T+1.
55	DYDX(I)=A2+A3*T
	DYDX(1)=A2+A3*T1
60	DYDX(JSTART+M)=A2
	IF(K-JTIME)100,70,70
70	T=0.
	N=JSTART+M+1
	DO 75 I=N,JSTOP
	T=T+1.
	DYDX(I)=A2+A3*T
75	DYDX(JSTOP+1)=A2+A3*TN
100	CONTINUE
	RETURN
	END
