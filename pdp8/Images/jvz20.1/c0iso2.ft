C	C0ISO2.FT DOES NEWTON-RAPHSONITERATION OF
C	CZA AND CZB FOR MIXED ISODESMIC MODEL
C	
1	READ(1,999)FMSG
999	FORMAT('TYPE TITLE:'A6)
	READ(1,1000)RPM
1000	FORMAT('RPM (F6.0):'F6.0)
	RPM=.26*(.10472*RPM)**2/((8.3144E+7)*293.15)
	RBRM=6.9**2-6.6**2
	H=RPM*292000.*RBRM/4.
C	C0A=INITIAL (A-TOTAL),X=CZA = MASS AVERAGE CONCN OF MONOMERIC A.
C	Y=CZB.
	READ(1,1001)C0A,C0B
1001	FORMAT('C0A,C0B (2F4.2):'2F4.2)
	READ(1,1002)AK1,AK2
1002	FORMAT('K,K# (2F5.3):'2F5.3)
	DO 120 IJK=1,3
	CALL OOPEN('DTA1',FMSG)
	WRITE(4,1503)AK1,AK2
5	X=C0A*2.*AK1
	C0=C0A+C0B
	DEN=1.+2.*H*AK1*C0
210	T2=2.*H*AK1*C0B/ALOG(1./(1.-2.*H*AK1*X))
	XN=C0/(DEN+T2)
	IF(ABS(XN-X)-1.E-5)230,230,220
220	X=XN
	GO TO 210
230	Y=C0B*2.*H*AK1*XN/ALOG(1./(1.-2.*H*AK1*XN))
	U=(AK1-AK2)/(2.*H)
10	A=AK1*X+AK2*Y
	B=1.-2.*H*A
	IF(B)95,95,15
15	C=ALOG(B)
	C0=(X+Y)/B
	DCZDX=(1.+2.*H*Y*(AK1-AK2))/B**2
	DCZDY=(1.+2.*H*X*(AK2-AK1))/B**2
	FXY=-C0A+AK1*X*C0/A+U*X*Y*C/A**2
	GXY=-C0B+AK2*Y*C0/A-U*X*Y*C/A**2
1500	FORMAT(I4,2(3XE15.6))
	FX=AK1*C0/A-(AK1**2)*C0*X/A**2+(U*Y/A**2)*(C-2.*X*AK1*C/A
	1-X*2.*H*AK1/B)
	FY=-AK1*AK2*C0*X/A**2+(U*X/A**2)*(C-2.*Y*AK2*C/A-2.*H*AK2*Y/B)
	FX=FX+AK1*X*DCZDX/A
	FY=FY+AK1*X*DCZDY/A
	GX=-AK1*AK2*C0*Y/A**2-(U*Y/A**2)*(C-2.*X*AK1*C/A-2.*H*AK1*X/B)
	GY=AK2*C0/A-(AK2**2)*C0*Y/A**2-(U*X/A**2)*(C-2.*AK2*Y*C/A
	1-2.*H*AK2*Y/B)
	GX=GX+AK2*Y*DCZDX/A
	GY=GY+AK2*Y*DCZDY/A
	DX=(FXY*GY-GXY*FY)/(FX*GY-GX*FY)
	DY=(FXY-FX*DX)/FY
C	
C	WANT TO IMPOSE 4 CONDITIONS FOR ESCAPE:
C	1)ABS(DX) L.T.1.E-5
C	2)ABS(DY) L.T. 1.E-5
C	3)X-DX G.E. 0.
C	4)Y-DY G.E. 0.
C
	INDIC=0
	IF(ABS(DX)-1.E-5)30,20,20
20	INDIC=1
30	IF(ABS(DY)-1.E-5)50,40,40
40	INDIC=1
50	X=X-DX
	Y=Y-DY
	IF(X)60,70,70
60	X=0.
	INDIC=1
70	IF(Y)80,90,90
80	Y=0.
	INDIC=1
90	IF(INDIC)100,100,10
C	COME TO 95 IF (1-2HA) L.E. 0. AT 10+2
95	X=X/2.
	Y=Y/2.
	GO TO 10
C	ESCAPE AT 100
100	WRITE(1,2000)C0,H,C0A,AK1,C0B,AK2
2000	FORMAT(/'C0 ='F7.3,' H ='F8.5/'C0A ='F7.3,' K ='F7.4/'C0B ='F7.3,
	1' K# ='F7.4)
	WRITE(1,2001)X,Y
2001	FORMAT('MONOMERS'/'CZA ='F9.5/'CZB ='F9.5)
	WRITE(4,1503)H,X,Y
1503	FORMAT(3E15.6)
	R=C0A/C0B
	C0=C0+2.
	C0B=C0/(1.+R)
	C0A=R*C0B
	J=1
	CALL OCLOSE
	WRITE(1,1211)FMSG
1211	FORMAT('TITLE IS:'A6///)
S	CLA IAC
S	TAD \FMSG
S	DCA \FMSG
120	CONTINUE
	GO TO 1
	END
