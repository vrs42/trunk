	SUBROUTINE QUAD(AI,BS,CS,NSTART,NSTOP)
C	MODIFIED FROM PH.D. THESIS FOR
C	LO SPEED EQUIL APRIL 1973 D.C.T.
	COMMON X,DELX,NPOIT
	COMMON CZ,AMAG,AST
	COMMON Y,X1,Q
	DIMENSION X(150),Q(150),Y(150)
C	QUADRATIC LEAST SQUARES
	N=NSTOP-NSTART+1
	FN=N
	SX=0.
	SXQ=0.
	SXC=0.
	SXF=0.
	SY=0.
	SYX=0.
	SYXQ=0.
	J=NSTART-1
	XP=X(NSTART)
	DO 10 I=1,N
	J=J+1
	XT=X(J)-XP
	SX=SX+XT
	SXQ=SXQ+XT**2
	SXC=SXC+XT**3
	SXF=SXF+XT**4
	SY=SY+Y(J)
	SYX=SYX+Y(J)*XT
10	SYXQ=SYXQ+Y(J)*XT**2
	X1=SX/FN
	X2=SXQ/SX
	X3=SXC/SXQ
	X12=SXQ/FN
	X22=SXC/SX
	X32=SXF/SXQ
	Y1=SY/FN
	Y2=SYX/SX
	Y3=SYXQ/SXQ
	CS=(Y2-Y1)*(X3-X1)-(Y3-Y1)*(X2-X1)
	DE=(X22-X12)*(X3-X1)-(X32-X12)*(X2-X1)
	CS=CS/DE
	BS=((Y3-Y1)*(X22-X12)-(Y2-Y1)*(X32-X12))/DE
	AI=Y1-X1*BS-X12*CS
	AI=AI-BS*XP+CS*XP**2
	BS=BS-2.*CS*XP
	RETURN
	END
