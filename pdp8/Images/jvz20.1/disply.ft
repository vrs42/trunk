	COMMON IXY,NPOIT,FMSG
	DIMENSION IXY(2,250)
	READ (1,2001)FMSG
2001	FORMAT('TYPE TITLE(A6):',A6)
	CALL IOPEN('DTA0',FMSG)
	DO 50 I=1,222
	READ(4,2002)IX,IY
2002	FORMAT(2I3)
	IXY(1,I)=2*IX
	IXY(2,I)=IY-225
50	CONTINUE
100	CALL DISP1(222,IXY)
	IF(ISENS(0))120,120,110
110	CALL DISP2(222,IXY)
120	IF(KEYBD(0))200,100,200
200	CONTINUE
	END
