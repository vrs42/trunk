	COMMON C,AM
	DIMENSION C(200),AM(3,200)
	DIMENSION GMSG(9),NPOIT(9)
C
1	READ(1,1000)NSET
1000	FORMAT('TYPE # SETS:'I2)
	DO 10 I=1,NSET
10	READ(1,1001)GMSG(I)
1001	FORMAT('INPUT TITLE:'A6)
	L=0
	READ(1,1004)WMON
1004	FORMAT('MONOMER MOL WT (F6.0):'F6.0)
	DO 30 II=1,NSET
	FMSG=GMSG(II)
	CALL IOPEN('DTA1',FMSG)
	READ(4,1002)NPOIT(II)
1002	FORMAT(I4)
	NPT=NPOIT(II)
	DO 15 I=1,NPT
	L=L+1
	READ(4,1003)C(L),AM(1,L),AM(2,L),AM(3,L)
1003	FORMAT(12XF7.3,3F9.0)
	IF(C(L)-1.)100,15,15
100	L=L-1
15	CONTINUE
30	CONTINUE
	NTOT=L
	DO 50 I=1,NTOT
	TOP=AM(2,I)*AM(3,I)/WMON**2-3.*AM(2,I)/WMON+2.
	BOT=AM(2,I)/WMON+2.*WMON/AM(1,I)-3.
	AN=TOP/BOT
	WRITE(1,2000)I,C(I),AN
2000	FORMAT(I4,F7.3,F6.2)
50	CONTINUE
	GO TO 1
	END
