C	PROGRAM GAPROX.FT TO GET 1-ST APPROX TO OVERLAPPING GAUSSIA
C	D.C.TELLER FEB.1974
C	MODIFIED FOR SCHLRN.FT OUTPUT 10/2/74
C
	COMMON X,Y
	COMMON IEXP,IPRED,IDEV,IY1,IY2
	DIMENSION X(100),Y(100)
	DIMENSION YM(2),AL(2),SIG(2),XB(2),EX(2),S(6)
	DIMENSION IEXP(100),IPRED(100),IDEV(100),IY1(100),IY2(100)
C	READ VALUES
1	NEQ=2
	NPAR=6
	READ(1,1000)FMSG
1000	FORMAT('TYPE INPUT TITLE,A6:',A6)
	CALL IOPEN('DTA1',FMSG)
	READ(4,1001)X1,XL
1001	FORMAT(10X2F10.0)
	READ(4,1001)DUM
	DO 5 I=1,2
5	READ(4,1002)X(I),Y(I)
	DELX=X(2)-X(1)
	NPOIT=IFIX((XL-X1)/DELX+1.)
	DO 10 I=3,NPOIT
10	READ(4,1002)X(I),Y(I)
1002	FORMAT(2F6.0)
1003	FORMAT('YMAX,X-BAR,SIGMA (3F4.0):',3F4.0)
C	SCALE VALUES TO 0.0-500.
	YMIN=0.
	YMAX=Y(1)
	XMIN=X(1)
	XMAX=X(NPOIT)
	DO 90 I=1,NPOIT
	YI=Y(I)
70	IF(YMAX-YI)80,90,90
80	YMAX=YI
90	CONTINUE
	YMULT=500./YMAX
	XMULT=500./(XMAX-XMIN)
	DO 20 I=1,NPOIT
	IEXP(I)=IFIX(Y(I)*YMULT)-250
	Y(I)=Y(I)*YMULT
20	X(I)=(X(I)-XMIN)*XMULT
C	COMMENCE GUESSES
25	DO 30 I=1,2
	READ(1,1003)YM(I),XB(I),SIG(I)
	YM(I)=YM(I)*YMULT
	XB(I)=(XB(I)-XMIN)*XMULT
	SIG(I)=SIG(I)*XMULT
30	AL(I)=1./SIG(I)**2
	DO 100 I=1,NPOIT
	IPRED(I)=0
	DO 50 J=1,2
	EX(J)=YM(J)*EXP(-AL(J)*(X(I)-XB(J))**2)
	IF(J-1)40,40,45
40	IY1(I)=IFIX(EX(J))-250
	GO TO 50
45	IY2(I)=IFIX(EX(J))-250
50	IPRED(I)=IPRED(I)+IFIX(EX(J))
	IPRED(I)=IPRED(I)-250
100	IDEV(I)=IEXP(I)-IPRED(I)
150	CALL DISP4(NPOIT,IEXP)
	CALL DISP3(NPOIT,IPRED)
	CALL DISP4(NPOIT,IDEV)
	CALL DISP3(NPOIT,IY1)
	CALL DISP3(NPOIT,IY2)
	CALL DISP5(0)
	IF(KEYBD(0))150,150,25
	CALL EXIT
	END
