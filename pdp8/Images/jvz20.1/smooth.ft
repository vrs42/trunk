	SUBROUTINE SMOOTH(NPT,NTERM,ISTART,NTIME,Y,X)
C** FIXED STATEMENT #5 10/27/77 D.C.T.
	DIMENSION X(200)
	DIMENSION Y(200),G(4),A(4)
C	NPT NECESSARILY ODD,NTERM=3 OR 4,NTIME=#PTS TO BE SMOOTHED
C	NTIME = NPOIT-NSTART+1 IN MAINLINE
	AM=FLOAT(NPT-1)/2.
	G(1)=2.*AM+1.
5	G(2)=(AM+1.)*(2.*AM+1.)/(3.*AM)
C** OLD:G(2)=(AM+1.)*(2.*AM+1.)/3.*AM
	G(3)=0.
	G(4)=0.
	T32=AM*(AM+1.)
	T33=AM*(2.*AM-1.)
	T43=T33*(AM-1.)
	T42=3.*AM**2+3.*AM-1.
	T=-(AM+1.)
	DO 10 I=1,NPT
	T=T+1.
	G(3)=G(3)+((3.*T**2-T32)/T33)**2
10	G(4)=G(4)+((5.*T**3-T42*T)/T43)**2
	M=IFIX(AM)
	JTIME=NTIME-2*M
	JSTART=ISTART-1
	DO 100 K=1,JTIME
	JSTART=JSTART+1
	JM=JSTART+M
	JSTOP=JSTART+NPT-1
	DO 20 I=1,4
20	A(I)=0.
	T=-(AM+1.)
	DO 30 I=JSTART,JSTOP
	T=T+1.
	A(1)=A(1)+X(I)
	A(2)=A(2)+X(I)*T/AM
	A(3)=A(3)+X(I)*(3.*T**2-T32)/T33
30	A(4)=A(4)+X(I)*(5.*T**3-T42*T)/T43
	DO 40 I=1,4
40	A(I)=A(I)/G(I)
	IF(K-1)50,50,60
50	T=-(AM+1.)
	DO 55 I=JSTART,JM
	T=T+1.
	Y(I)=A(1)+A(2)*T/AM+A(3)*(3.*T**2-T32)/T33
	IF(NTERM-3)55,55,54
54	Y(I)=Y(I)+A(4)*(5.*T**3-T42*T)/T43
55	CONTINUE
60	Y(JSTART+M)=A(1)-A(3)*T32/T33
C	DONT SMOOTH FINAL POINTS
100	CONTINUE
	RETURN
	END
