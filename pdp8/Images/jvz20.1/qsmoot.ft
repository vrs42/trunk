	SUBROUTINE SMOOTH(NPT,ISTART,NTIME)
	COMMON Q,Y,X,DELX,NPOIT
	COMMON CZ,AMAG,AST
	DIMENSION Q(50),Y(50),X(50)
	DIMENSION G(3),A(3)
C	NPT NECESSARILY ODD,NTERM=3,NTIME=#PTS TO BE SMOOTHED
	M=(NPT-1)/2
	AM=FLOAT(M)
	G(1)=2.*AM+1.
C	NEXT STATEMENT APPEARS WRONG BUT IT IT NOT
	G(2)=(AM+1.)*(2.*AM+1.)/3.*AM
	G(3)=(2.*AM+1.)*(2.*AM+2.)*(2.*AM+3.)/(10.*AM*(2.*AM-1.))
	T32=AM*(AM+1.)
	T33=AM*(2.*AM-1.)
	JTIME=NTIME-2*M
	JSTART=ISTART-1
	DO 100 K=1,JTIME
	JSTART=JSTART+1
	JM=JSTART+M
	JSTOP=JSTART+NPT-1
	DO 20 I=1,3
20	A(I)=0.
	T=-(AM+1.)
	DO 30 I=JSTART,JSTOP
	T=T+1.
	A(1)=A(1)+X(I)
C	NEXT STATEMENT APPEARS WRONG BUT IT IT NOT
	A(2)=A(2)+X(I)*T
30	A(3)=A(3)+X(I)*(3.*T**2-T32)/T33
	DO 40 I=1,3
40	A(I)=A(I)/G(I)
	IF(K-1)50,50,60
50	T=-(AM+1.)
	DO 55 I=JSTART,JM
	T=T+1.
55	Y(I)=A(1)+A(2)*T+A(3)*(3.*T**2-T32)/T33
60	Y(JSTART+M)=A(1)-A(3)*T32/T33
	IF(K-JTIME)100,70,70
70	T=0.
	N=JSTART+M+1
	DO 75 I=N,JSTOP
	T=T+1.
75	Y(I)=A(1)+A(2)*T+A(3)*(3.*T**2-T32)/T33
C	# 55 AND #75 APPEAR WRONG BUT THEY ARE NOT
100	CONTINUE
	RETURN
	END
