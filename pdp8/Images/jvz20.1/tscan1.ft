	SUBROUTINE SCAN(NX)
	COMMON FMSG,SAVE,TABLE
	COMMON A,ALPHA,GAMMA,RL
	COMMON BR,DX,DY
	COMMON DELCY,HALFPI,NMAX,PI,TWOPI,Y2
	COMMON N,XAIR1,YAIR1,XAIR2,YAIR2,XCOL1,XCOL2
	DIMENSION SAVE(8,3),TABLE(6,57)
	N=222
	CALL OOPEN('DTA0',FMSG)
	DO 50 I=1,N
C	READ OD
S	6141
S	0110
S	0002
S	DCA \J
	OD=BR-FLOAT(J)
	J=OD
	WRITE(4,2001)I,J
2001	FORMAT(2I3)
	CALL STAGE (2,3)
50	CONTINUE
	CALL OCLOSE
C	RETURN STAGE
	IF(NX)70,70,60
60	CALL STAGE(NX,1)
70	CALL STAGE(222,4)
	RETURN
	END
