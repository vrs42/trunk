	FUNCTION AREA(Y,X,JTRAP)
C
C	GET INTEGRAL Y.D[X] FROM X(I-1),Y(I-1) TO X(I),Y(I)
C	IF JTRAP = 1, USE TRAPEZOIDAL TERM ONLY
C
	DIMENSION Y(3),X(3)
	DX1=X(2)-X(1)
	DY1=Y(2)-Y(1)
	T=.5*(Y(2)+Y(1))*DX1
	IF(JTRAP)10,10,20
10	DX2=X(3)-X(2)
	DY2=Y(3)-Y(2)
	T=T-(DX1**3)*(DY2/DX2-DY1/DX1)/(6.*(DX1+DX2))
20	AREA=T
	RETURN
	END
