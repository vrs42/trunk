	SUBROUTINE TABLE(NCOMP,AM1,NMER,CA,IVIR)
C
C	PRINT MOL WT DEVIATIONS, ETC
	COMMON A,B,S
	COMMON NPOIT,C,AM,AV,W
	DIMENSION C(100),AM(3,100)
	DIMENSION A(7,7),B(7),CA(7)
	DIMENSION AV(100),W(100)
	DIMENSION S(7),NMER(6)
	WRITE(1,2003)
2003	FORMAT(///)
	VIR=0.
	MID=NPOIT/2+1
	CAT=C(MID)
	IF(IVIR)20,20,10
10	VIR=CA(NCOMP+1)
20	IPRINT=0
	DO 160 J=2,NCOMP
	L=NMER(J)
	AK=CA(J)/CA(1)**L
	VAL=FLOAT(L)*AM1
	IF(AK)155,160,160
155	IPRINT=1
160	WRITE(1,2000)L,VAL,AK
2000	FORMAT(I2'-MER ='F9.0'  K ='E15.6)
	WRITE(1,2003)
C	NOW PREDICT MN,MW,MZ,ETC
	RMC=0.
	RMN=0.
	RMW=0.
	RMZ=0.
	DO 200 I=1,NPOIT
	SUMC=0.
	SUMN=0.
	SUMW=0.
	SUMZ=0.
	DELC=C(I)-CAT
	E=EXP(AM1*(AV(I)-VIR*DELC))
	DO 170 J=1,NCOMP
	L=NMER(J)
	VAL=CA(J)*E**L
	AK=AM1*FLOAT(L)
	SUMC=SUMC+VAL
	SUMN=SUMN+VAL/AK
	SUMW=SUMW+VAL*AK
170	SUMZ=SUMZ+VAL*AK**2
	SUMZ=SUMZ/SUMW
	SUMW=SUMW/SUMC
	SUMN=SUMC/SUMN
	VIRN=1.+.5*VIR*SUMN*SUMC
	VIRW=1.+VIR*SUMW*SUMC
180	DC=C(I)-SUMC
	DN=AM(1,I)-SUMN/VIRN
	DW=AM(2,I)-SUMW/VIRW
	DZ=AM(3,I)-SUMZ/VIRW**2
	RMC=RMC+DC**2
	RMN=RMN+DN**2
	RMW=RMW+DW**2
	RMZ=RMZ+DZ**2
	IF(IPRINT)195,195,200
195	WRITE(1,2001)I,C(I),DC,DN,DW,DZ
200	CONTINUE
2001	FORMAT(I4,F7.3,F7.3,3F9.0)
	FN=FLOAT(NPOIT)
	RMC=SQRT(RMC/FN)
	RMN=SQRT(RMN/FN)
	RMW=SQRT(RMW/FN)
	RMZ=SQRT(RMZ/FN)
	MID=NPOIT/2+1
	CAT=0.
	DO 210 J=1,NCOMP
210	CAT=CAT+CA(J)
	WRITE(1,2002)
2002	FORMAT('RMS VALUES:'/)
	WRITE(1,2001)MID,CAT,RMC,RMN,RMW,RMZ
	WRITE(1,2003)
	RETURN
	END
