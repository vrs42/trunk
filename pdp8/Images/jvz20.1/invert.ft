C	PROGRAM INVERT.FT
C	TO INPUT C,MN,MW,MZ
C	PLOT 1/M(X) VS C
C	USES LSQSE SUBROUTINE
C
	COMMON C,AMN,AMW,AMZ
	DIMENSION C(200),AMN(200),AMW(200),AMZ(200),RECIP(200)
	DIMENSION GMSG(10),AM(3),AM1(6),SEM(6)
1	READ(1,1000)NDAT
1000	FORMAT('# SETS:'I1)
	READ(1,1001)(GMSG(I),I=1,NDAT)
1001	FORMAT('INPUT TITLE:'A6)
	NPOIT=0
	K=0
	DO 10 IJK=1,NDAT
	FMSG=GMSG(IJK)
	CALL IOPEN('DTA1',FMSG)
	READ(4,1002)NP
1002	FORMAT(I4)
	DO 5 I=1,NP
	READ(4,1003)CC,(AM(J),J=1,3)
	IF(CC-1.)5,4,4
4	NPOIT=NPOIT+1
	K=K+1
	AMN(K)=AM(1)
	AMW(K)=AM(2)
	AMZ(K)=AM(3)
	C(K)=CC
5	CONTINUE
1003	FORMAT(12XF7.3,3F9.0)
10	CONTINUE
	DO 40 I=1,NPOIT
40	RECIP(I)=1./AMN(I)
	CALL LSQSE(AI,SEA,BS,SEB,1,NPOIT,C,RECIP)
	N=14*64
	WRITE(1,2000)N,AI,SEA,BS,SEB
2000	FORMAT(/'1/M'A1' = 'E13.6,' +/-'E13.6/'SLOPE ='E13.6,' +/-'E13.6)
	X1=1./(AI+SEA)
	X2=1./(AI-SEA)
	XB=1./AI
	X1=.5*ABS(X1-X2)
	WRITE(1,2001)N,XB,X1
2001	FORMAT('M('A1') ='F9.0' +/-'F9.0)
	DO 50 I=1,NPOIT
50	RECIP(I)=1./AMW(I)
	CALL LSQSE(AI,SEA,BS,SEB,1,NPOIT,C,RECIP)
	N=23*64
	WRITE(1,2000)N,AI,SEA,BS,SEB
	X1=1./(AI+SEA)
	X2=1./(AI-SEA)
	XB=1./AI
	X1=.5*ABS(X1-X2)
	WRITE(1,2001)N,XB,X1
	DO 60 I=1,NPOIT
60	RECIP(I)=AMW(I)**2/AMZ(I)
	CALL LSQSE(AI,SEA,BS,SEB,1,NPOIT,C,RECIP)
	WRITE(1,2002)AI,SEA,BS,SEB
2002	FORMAT(/'MZ ='F9.0' +/-'F9.0/'SLOPE ='E13.6' +/-'E13.6)
	DO 70 I=1,NPOIT
70	RECIP(I)=1./(2./AMN(I)-1./AMW(I))
	CALL LSQSE(AI,SEA,BS,SEB,1,NPOIT,C,RECIP)
	WRITE(1,2003)AI,SEA
	WRITE(1,2004)BS,SEB
2003	FORMAT(/'[2/MN-1/MW]^-1 ='F9.0' +/-'F9.0)
2004	FORMAT('SLOPE ='E13.6' +/-'E13.6/)
	DO 80 I=1,NPOIT
80	RECIP(I)=2.*AMN(I)-AMW(I)
	CALL LSQSE(AI,SEA,BS,SEB,1,NPOIT,C,RECIP)
	WRITE(1,2005)AI,SEA
	WRITE(1,2004)BS,SEB
2005	FORMAT(/'2*MN - MW ='F9.0' +/-'F9.0)
	DO 90 I=1,NPOIT
90	RECIP(I)=1./AMN(I)
	CALL LSQSE(AI,SEA,BS,SEB,1,NPOIT,RECIP,AMW)
	WRITE(1,2006)
2006	FORMAT(//'TWO SPECIES PLOTS:'
	WRITE(1,2008)
	WRITE(1,2007)AI,SEA
	WRITE(1,2004)BS,SEB
	AM1(1)=AI/3.
	SEM(1)=SEA/3.
	AM1(2)=.5*SQRT(ABS(BS))
	SEM(2)=.5*SQRT(SEB)
2008	FORMAT(/'MW VS 1/MN')
2007	FORMAT('[P+1]*M(1) ='F9.0' +/-'F9.0)
	DO 100 I=1,NPOIT
100	RECIP(I)=1./AMW(I)
	CALL LSQSE(AI,SEA,BS,SEB,1,NPOIT,RECIP,AMZ)
	WRITE(1,2009)
2009	FORMAT(/'MZ VS 1/MW')
	WRITE(1,2007)AI,SEA
	WRITE(1,2004)BS,SEB
	AM1(3)=AI/3.
	AM1(4)=.5*SQRT(ABS(BS))
	SEM(3)=SEA/3.
	SEM(4)=.5*SQRT(SEB)
	WRITE(1,2010)
2010	FORMAT(/'     M(1)     S.E.')
	WRITE(1,2011)(AM1(I),SEM(I),I=1,4)
2011	FORMAT(2F9.0)
	CALL EXIT
	END
