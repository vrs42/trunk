C	SCAN SCHLIEREN PATTERNS
C	PRESUMABLY CAN USE FOR GEL PATTERNS ALSO
	COMMON BR,DX,DY
	COMMON IXY
	DIMENSION IXY(2,500),IYY(500)
	DIMENSION XM(4),YM(4)
1	READ(1,999)FMSG
999	FORMAT('TYPE TITLE (A6):',A6)
	WRITE(1,2002)
2002	FORMAT(/,'POSITION PLATE:',/,' 1)ON INNER REFERENCE')
	CALL RHS
	XSUM=0.
	YSUM=0.
	WRITE(1,2003)
2003	FORMAT(' 2)ON MENISCUS')
	CALL RHS
	XSUM=XSUM+DX
	YSUM=YSUM+DY
	XM(1)=DX
	YM(1)=DY
	WRITE(1,2004)
2004	FORMAT(' 3)AT START OF SCAN')
	CALL RHS
	XSUM=XSUM+DX
	YSUM=YSUM+DY
	XM(2)=XSUM
	WRITE(1,2005)
2005	FORMAT(' 4)ON MINIMUM Y SCAN POINT')
	CALL RHS
	XSUM=XSUM+DX
	YSUM=YSUM+DY
	YM(2)=YSUM
	WRITE(1,2008)
2008	FORMAT(' 5)FOR BACKGROUND')
	CALL RHS
	XSUM=XSUM+DX
	YSUM=YSUM+DY
	OD=0.
	DO 20 I=1,100
S	CPAGE 7
S	6141
S	0110
S	0002
S	DCA \J
	OD=OD+FLOAT(J)
20	CALL STAGE(5,1)
	BR=OD/100.
	CALL STAGE(500,2)
	WRITE(1,2006)
2006	FORMAT(' 6)ON MAX. Y SCAN POINT')
	CALL RHS
	XSUM=XSUM+DX
	YSUM=YSUM+DY
	YM(3)=YSUM
	WRITE(1,2007)
2007	FORMAT(' 7)ON PLATEAU FOR END OF SCAN')
	CALL RHS
	XSUM=XSUM+DX
	YSUM=YSUM+DY
	XM(3)=XSUM
	WRITE(1,2009)
2009	FORMAT(' 8)ON OUTER REFERENCE EDGE')
	CALL RHS
	XSUM=XSUM+DX
	YSUM=YSUM+DY
	XM(4)=XSUM
	YM(4)=YSUM
	CALL STEP(XSUM,0)
	CALL STEP(YSUM,2)
C	MAY WANT DIRECTIONS 1 AND 3 HERE
	WRITE(1,2010)
2010	FORMAT('  MENISCUS   MINIMUM   MAXIMUM REFERENCE')
	CALL OOPEN('DTA1',FMSG)
	WRITE(1,2011)(XM(I),I=1,4)
	WRITE(1,2011)(YM(I),I=1,4)
	WRITE(4,2011)(XM(I),I=1,4)
	WRITE(4,2011)(YM(I),I=1,4)
2011	FORMAT(4F10.0)
	READ(1,1000)N
1000	FORMAT('INPUT STEPS BETWEEN SCANS (I3):',I3)
	NX=N
	XINT=(XM(3)-XM(2))/FLOAT(N)
	K=IFIX(XINT)+1
	X1=-(XM(3)-FLOAT(K-1)*FLOAT(N))
	CALL STEP(X1,0)
	X2=-YM(2)
	CALL STEP(X2,2)
C	MAY BE WRONG PLACE HERE
C
	IY=IFIX((YM(3)-YM(2))/500.)+1
	X2=(YM(3)-YM(2))/FLOAT(IY)
	NY=IFIX(X2)+1
C	NY IS NO. OF TIMES TO READ OD
	XINT=FLOAT(NX)
	X1=-X1-XINT
	DO 100 I=1,K
	X1=X1+XINT
	CALL SCAN(NY,IY)
	CALL STAGE(NX,1)
	NS=NY-2
	DO 60 J=3,NS
	L=J-2
	M=J+2
	SUM=0.
	DO 55 LL=L,M
55	SUM=SUM+FLOAT(IXY(2,LL))
60	IYY(J)=IFIX(SUM/5.)
	DO 65 J=3,NS
65	IXY(2,J)=IYY(J)
C	DISPLAY ROUTINE
30	M1=NALOG(0)
	M1=IABS(M1)
	M2=NALOG(4)
	M2=IABS(M2)
	CALL DISP1(NY,IXY)
	CALL DISP6(M1)
	CALL DISP6(M2)
	IF(KEYBD(0))30,30,40
40	Y=FLOAT(IY)*(FLOAT(IXY(1,M2)-IXY(1,M1)))
	WRITE(1,2012)X1,Y
2012	FORMAT(2F6.0)
	WRITE(4,2012)X1,Y
100	CONTINUE
	CALL STAGE(NX,2)
	CALL OCLOSE
	CALL STEP(X1,0)
	Y=YM(2)
	CALL STEP(Y,2)
	GO TO 1
	END
