C	PROGRAM TO SIMULATE HI SPD EQUIL EXPTS
	COMMON X,C,AWT
	DIMENSION X(150),C(150),H(10),W(10),AM(10),AWT(3,150)
	DIMENSION GMSG(15)
1	READ(1,1599)NCHAN
1599	FORMAT('# TIMES TO RUN PROG:'I2)
	DO 2 I=1,NCHAN
2	READ(1,999)GMSG(I)
	DO 1300 IJK=1,NCHAN
	FMSG=GMSG(IJK)
	RM=6.6
	RB=6.9
	CALL IOPEN('DTA1',FMSG)
	READ(4,1301)AK1,AK2
1301	FORMAT(3E15.6)
	READ(4,1301)G,CZA,CZB
	AM1=292000.
999	FORMAT('TYPE TITLE, A6:',A6)
	RBRM=RB**2-RM**2
	AMAG=.046296
	AMAG=.01*AMAG
	RPM=G*4./(RBRM*AM1)
	NCOMP=10
	DO 5 I=1,NCOMP
	AM(I)=FLOAT(I)*AM1
5	H(I)=RPM*AM(I)*RBRM/4.
	PQ=(AK1*CZA+CZB*AK2)*2.*H(1)
	C1=CZA+CZB
	C0=C1/(1.-PQ)
	DO 10 I=1,10
	J=I-1
	CZ=C1*PQ**J
	W(I)=CZ/C0
10	WRITE(1,2014)I,W(I),H(I)
2014	FORMAT(I3,2XF8.6,F9.5)
	XM=(RM-5.6262)/AMAG
	XB=(RB-5.6262)/AMAG
	DELX=10.
	NPOIT=IFIX((XB-XM)/DELX)+1
	IF(NPOIT-150)50,50,20
20	IDELX=IFIX((XB-XM)/149.+1.)
	DELX=FLOAT(IDELX)
	NPOIT=IFIX((XB-XM)/DELX)+1
50	WRITE(1,2000)DELX
2000	FORMAT('STEPSIZE =',F5.0)
	DELR=AMAG*DELX
	AST=1./RPM
	RBPRM=RB**2+RM**2
	WRITE(1,2010)FMSG
2010	FORMAT('TITLE:',2XA6)
	SEPR=280.
	WRITE(1,2011)SEPR
2011	FORMAT('SEPN:',F5.0)
	ZMAG=100.*AMAG
	WRITE(1,2012)ZMAG
2012	FORMAT('AMAG:',F9.7)
	WRITE(1,2013)AST
2013	FORMAT('RT/(1-VP)W^2 :',2XE12.5)
	DO 100 I=1,NCOMP
	W(I)=W(I)*C0
100	WRITE(1,2002)I,W(I),AM(I),H(I)
2002	FORMAT( I3,' COMP HAS C(0) =',F9.5,'  M = ',F9.0,' AND H = ',F7.3)
	HST=4.*AST/RBRM
	LL=1
	DO 200 I=1,NPOIT
	SUMC=0.
	SUMN=0.
	SUMW=0.
	SUMZ=0.
	R=(RM+FLOAT(I-1)*DELR)**2
	Z=(2.*R-RBPRM)/RBRM
	DO 150 J=1,NCOMP
	SINHH=.5*(EXP(H(J))-EXP(-H(J)))
	DELC=W(J)*H(J)*EXP(Z*H(J))/SINHH
	SUMC=SUMC+DELC
	SUMN=SUMN+DELC/H(J)
	SUMW=SUMW+DELC*H(J)
150	SUMZ=SUMZ+DELC*H(J)**2
	AMN=HST*SUMC/SUMN
	AMW=HST*SUMW/SUMC
	AMZ=HST*SUMZ/SUMW
	X(I)=R
	AWT(1,I)=AMN
	AWT(2,I)=AMW
	AWT(3,I)=AMZ
	C(I)=SUMC
	IF(SUMC-.35)155,155,157
155	NSTART=I
157	IF(I-LL)200,160,200
160	WRITE(1,2003)I,R,SUMC,AMN,AMW,AMZ
	LL=LL+10
200	CONTINUE
2003	FORMAT(I4,F8.4,F7.3,3F9.0)
C	DELETE DATA FOR GRADIENT GT 400 FRINGE/CM
	DO 210 I=2,NPOIT
	J=I-1
	IF((C(I)-C(J))/DELR-250.)210,210,220
210	CONTINUE
	I=I-1
220	NPOIT=I
	NPT=NPOIT-NSTART+1
	CALL OOPEN('DTA1',FMSG)
	WRITE(4,2004)NPT
2004	FORMAT(I4)
	DO 230 I=NSTART,NPOIT
230	WRITE(4,2005)I,X(I),C(I),AWT(1,I),AWT(2,I),AWT(3,I)
2005	FORMAT(I4,F8.4,F7.3,3F9.0)
	CALL OCLOSE
1300	CONTINUE
	GO TO 1
	END
