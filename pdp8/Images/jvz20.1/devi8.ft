	SUBROUTINE DEVI8(TITL,AI,SEA,BS,SEB,NPOIT)
C	CALLED FROM CHYMO.FT MAIN PROG
C
	COMMON C,AN,AW,AZ,WMON
	DIMENSION C(150),AN(150),AW(150),AZ(150)
C
	SW=0.
	SN=0.
	K=0
	DO 20 I=1,NPOIT
	PAC=AI+BS*C(I)
	IF(PAC)20,20,5
5	CW=SQRT(4.*PAC*C(I)+1.)
	CW=.5*(CW-1.)/PAC
	PW=WMON*CW*(1.+2.*PAC*CW)/C(I)
	PN=WMON*C(I)/(CW*(1.+PAC*CW*.5))
	SW=SW+ABS(AW(I)-PW)
	SN=SN+ABS(AN(I)-PN)
	K=K+1
20	CONTINUE
	FN=K
	SW=SW/FN
	SN=SN/FN
	FN=.002*WMON
	AI=AI*FN
	SEA=SEA*FN
	BS=BS*FN
	SEB=SEB*FN
	WRITE(1,2000)TITL,AI,SEA,BS,SEB,SN,SW
2000	FORMAT(A6,4F9.3,2F9.0,/)
	RETURN
	END
