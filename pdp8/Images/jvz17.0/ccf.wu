/2.0 COPYCF - COPY CODED FILE UTILITY.
/	JOHN EASTON	SSRFC	76/08/18	V1.0
/				77/01/16	V1.9Y
/				80/01/11	V2.0 (TYPED BACK IN,ALSO)




///	JUST ONE OF THE PROLIFERATION OF TEXT COPY UTILITIES,
/	COPYCF IS USEFUL FOR:
/
/V.0	1) TAB EXPANSION/COMPRESSION (/C, /E).
/
/V1.8	2) CHARACTER REPLACEMENT OF SPECIFIC CHARACTERS
/	   (/F, /G, /K, /L, /O, /Q, /R, /S, /T, /U, /X, /Y).
/
/V1.9	3) CLEANING UP CODED FILE LINE STRUCTURE (/P).
/V1.9Y	  REVISED CCF + OUCH FOR ACCURACY
/
/V2.0	4) READING FROM BAT: UPON /B.
/	   ALSO /E MADE DEFAULT; OUTPUT ERROR FIXED; OUTMIN FIXED
/	   (TEXT TYPED IN FROM LISTING THIS VERSION/DATE)




///	USAGE.
/
/	.R COPYCF
/	*OUTPUT<INPUT
/
/	WHERE INPUT MAY BE UP TO 9 FILES.
/	THERE ARE NO DEFAULT FILENAME EXTENSIONS.




///	OPTIONS.
/
/	/A	SET ASCII CHARACTER MODE (SEE DISUSSION, BELOW).
/		(DEFAULT CHARACTER MODE.)
/
/	/B	READ FROM BAT: STREAM (INPUT FILES IGNORED).
/
/	/C	SET COMPRESS MODE - TABS ARE EXPANDED ON INPUT
/		TO COPYCF AND REGENERATED ON OUTPUT.
/
/	/E	SET EXPAND MODE - TABS ARE EXPANDED ON INPUT TO
/		COPYCF BUT NOT COMPRESSED ON OUTPUT.
/
/	/F	DELETE FORM FEED AND VERTICAL TABS (FF, VT).
/
/	/G	DELETE ALL NON-PRINTING CHARACTERS EXCEPT TAB, FF,
/		VT, BELL, CR, LF, ALTMODE (33 ONLY). (DROP GARBAGE)
/
/	/I	SET CHARACTER IMAGE MODE
/
/	/K	SET KRONOS 9-TRACK MAGTAPE ASCII TO OS/8 ASCII
/		CONVERSION (# BECOMES ', ' BECOMES ^).
/	/L	CONVERT UPPER CASE TO LOWER CASE ALPHABETICS.
/
/	/O	SET OS/8 ASCII TO KRONOS 9-TRACK MAGTAPE ASCII
/		CONVERSION (' BECOMES #, ^ BECOMES ')
/
/	/P	"PURIFY" LINE STRUCTURE: DROP ALL LINE FEEDS, AND
/		ADD A LINE FEED AFTER EVERY CARRIAGE RETURN.
/
/	/Q	SET OS/8 TO SUPIO ASCII CONVERSION.
/		(SEE TABLE BELOW FOR OS/8-SUPIO CODES.)
/
/	/R	RESET DEFAULT OPTIONS: SELECT /A, /E, /1, AND
/		CLEAR OPTIONS /G, /F, /K, /O, /S, /Q, /L, /U, /X,
/		AND /P.  THESE OPTIONS ARE ONLY RESET BY /R, OR BY
/		RESTARTING THE PROGRAM BY A .R OR .ST KBM COMMAND.
/
/	/S	SET SUPIO ASCII TO OS/8 ASCII CONVERSION.
/		(SEE TABLE BELOW FOR SUPIO-OS/8 CODES.)
/
/	/T	SET TRANSLATE MODE: READ 'C2C' DIRECTIVES FROM
/		THE FIRST INPUT FILE, AND PERFORM INDICATED
/		CHARACTER TRANSLATIONS (SEE DISCUSSION, BELOW)
/
/	/U	CONVERT LOWER CASE TO UPPER CASE ALPHABETICS
/
/	/V	PRINT THE VERSION NUMBER ON THE CONSOLE.
/
/	/X	INSTALLATION ASCII CONVERSION (UNSPECIFIED).
/
/	/Y	INSTALLATION ASCII CONVERSION (UNSPECIFIED).
/
/	/0, /1, /2, /3 -- NUMBER OF CONSECUTIVE BLANKS TO RETAIN BEFORE
/		CONVERTING BLANKS TO TABS (DEFAULT IS /1 -- WILL
/		NOT CHANGE SINGLE BLANKS TO TABS).
/
/	=N	COPY ONLY N (OCTAL) LINES.
/
/	CR	CARRIAGE RETURN TERMINATION ON COMMAND DECODER
/		CAUSES COPYCF TO RETURN TO THE COMMAND DECODED PHASE
/		AFTER PROCESSING THE CURRENT OPTIONS/FILES (WHICH
/		MAY BE NULL).
/
/	ESC/ALT -- ALTMODE TERMINATOR TO THE COMMAND DECODER CAUSES
/		COPYCF TO RETURN TO OS/8 NORMALLY AFTER PROCESSING
/		THE CURRENT OPTIONS/FILES (WHICH MAY BE NULL).




///	THE OPTION PAIRS LISTED HERE ARE MUTUALLY EXCLUSIVE.
/
/	CHARACTER MODE: 	      * /A	/I
/
/	TABBING MODE:		      * /E	/C
/
/	KRONOS TAPE ASCII:		/K	/O
/
/	SUPIO COMMUNICATIONS ASCII:	/S	/Q
/
/	INSTALLATIN OPTION ASCII:	/X	/Y
/
/				     (*=DEFAULT)
///	ASCII / IMAGE MODE - BRIEF DESCRIPTION.
/
/	PARITY BIT IS ALWAYS FORCED ON,
/	THEN THE C2C TABLE LOOKUP IS DONE.
/
/	/I - IMAGE MODE: ALL VALUES 200 TO 377 ARE COPIED.
/
/	/A - ASCII MODE: CODES 200, 377 ARE DROPPED, ALL
/	     OTHERS ARE COPIED, EXCEPT FOR THE ACTION
/
/	/P - 'PURIFY' -- NOT SELECTED: CARRIAGE RETURN MARKS AN
/	     END-OF-LINE. LINE FEED IS COPIED AS IS.
/
/	/P - 'PURIFY' -- SELECTED: LINE FEED IN INPUT IS ALWAYS
/	     DROPPED. CARRIAGE-RETURN MARKS AN END-OF-LINE, AND
/	     GENERATES A CR-LF PAIR TO NORMALIZE UNIT RECORD
/	     STRUCTURE. USEFUL FOR OS/8 FORTRAN IV OUTPUT FILES.






///	MESSAGES.
/
/	'COPYCF VERSION 2.0  SSRFC  80/01/11  JTE'
/		VERSION MESSAGE IS GIVEN IN RESPONSE TO THE /V OPTION.
/
/	'??CCF ASCII-IMAGE CHARACTER MODE CONFLICT'
/		THE /A AND THE /I OPTIONS WERE SPECIFIED TOGETHER, AND
/		ARE MUTUALLY EXCLUSIVE.
/
/	'??CCF EXPAND-COMPRESS TABBING MODE CONFLICT.'
/		THE /C AND THE /E OPTIONS WERE SPECIFIED TOGETHER, AND
/		ARE MUTUALLY EXCLUSIVE.
/
/	'??CCF KRONOS TAPE-OS/8 ASCII TRANSLATION MODE CONFLICT.'
/		THE /K AND THE /O OPTIONS WERE SPECIFIED TOGETHER,
/		AND ARE MUTUALLY EXCLUSIVE.
/
/	'??CCF SUPIO COMMUNICATIONS-OS/8 ASCII TRANSLATION MODE CONFLICT.'
/		THE /S AND THE /Q OPTIONS WERE SPECIFIED TOGETHER, AND
/		ARE MUTUALLY EXCLUSIVE.
/
/	'??CCF /X - /Y OPTIONS CONFLICT.'
/		THE /X AND /Y OPTIONS SPECIFY AN INSTALLATION-DEPENDANT
/		ASCII CONVERSION PROCESS AND IT'S CONVERSE, AND ARE
/		MUTUALLY EXCLUSIVE.
/
/	'??CCF /? NOT IMPLEMENTED.'
/		WHERE '/?' IS ONE OF /S, /Q, /X, OR /Y - THE OPTION
/		SPECIFIED HAS NOT YET BEEN PROGRAMMED.
/		THE /X AND /Y OPTIONS ARE FOR INSTALLATION USE.
/
/	'??CCF OUTPUT OPEN ERROR.'
/		A FATAL DEVICE ERROR HAS OCCURRED WHILE SETTING UP
/		AN OUTPUT FILE ON THE SPECIFIED OUTPUT DEVICE.
/
/	'??CCF INPUT DEVICE ERROR.'
/		A FATAL DEVICE ERROR HAS OCCURRED ON THE CURRENT
/		INPUT DEVICE.
/	'??CCF OUTPUT FILE OVERFLOW.'
/		THE OUTPUT FILE HAS BECOME TOO LARGE FOR THE AVAILABLE
/		SPACE, OR A FATAL OUTPUT DEVICE ERROR HAS OCCURRED.
/
/	'??CCF OUTPUT DEVICE CLOSE ERROR.'
/		THE OUTPUT FILE WAS TOO LARGE FOR THE AVAILABLE
/		SPACE, OR A FATAL OUTPUT CLOSE DEVICE ERROR HAS
/		OCCURRED.
/
/	'??C2C INQUIRE ERROR.'
/		DURING C2C DIRECTIVE PROCESSING, THE HANDLER
/		FOR THE REPORT FILE COULD NOT BE FETCHED.
/
/	'??C2C OPEN ERROR (OUTPUT).'
/
/	'??C2C OUTPUT ERROR.'
/
/	'??C2C CLOSE (OUTPUT) DEVICE ERROR.'
/
/	'??C2C EOF DURING DIRECTIVES.'
/		AN EOF IS NOT EXPECTED DURING C2C DIRECTIVES
/		PROCESSING.
/
/	'??C2C INPUT DEVICE ERROR.'




//	INSTALLATION.
/
/	.R PAL8
/	*CCF<CCF,TTYIO,CHARS
/
/	.R ABSLDR
/	*CCF/9/P$
/	.SAVE SYS:CCF
/
/
/	THE /P$ IS CRUCIAL FOR THE CCF/B OPTION TO WORK!
/	THE ALTMODE MUST BE ON SAME LINE AS /P TO ABSLDR!!!
/	(MIGHT ALSO SAVE AS COPYCF.SV)
/
/
/	TTYIO IS A TELETYPE INPUT/OUTPUT EXTENDED
/	HANDLER, AND IS USED BASICALLY FOR MESSAGES,
/	THE INPUT FACILITY (TTYREAD) BEING TURNED OFF.
/
/	CHARS ARE DEVICE INDEPENDENT CHARACTER INPUT/OUTPUT
/	SUBROUTINES AND ARE ADAPTED FROM THE OS/9 SOFTWARE
/	SUPPORT MANUAL.
/
/	TTYIO AND CHARS ARE AVAILABLE AT SSRFC, OR ACCOMPANY
/	THE SOURCE FOR THIS PROGRAM.
