/2 RK8E NON-SYSTEM HANDLER FOR 7 AREAS		-JVZ-

/ONE RK8E IS SPLIT INTO SEVEN LOGICAL DEVICES.  *HALF*
/OF THE DESIRED DEVICE LENGTH FOR EACH PIECE SHOULD BE
/DEFINED AS 'ASIZE', 'BSIZE', ETC.  THE TOTAL MUST SUM
/TO 3248.  LOCATIONS 13640-13646 IN PIP.SV SHOULD THEN
/BE PATCHED WITH THE VALUES SHOWN FOR L13640-L13646...

/THE ENTRY POINTS ARE NAMED A:,B:,C:,D:,E:,F:,G:.  ALL
/SEVEN ENTRY POINTS NEED NOT BE DEFINED, I.E. THE DISK
/CAN BE DIVIDED INTO LESS THAN SEVEN PIECES IF DESIRED.

	VERSION="B&77	/KEEP THIS UPDATED
IFNDEF	DRIVE <DRIVE=0>	/VERSION B FEATURE

	DECIMAL
IFNDEF	AREAS <AREAS=7>
IFNDEF	ASIZE <ASIZE=928%2>
IFNDEF	BSIZE <BSIZE=928%2>
IFNDEF	CSIZE <CSIZE=928%2>
IFNDEF	DSIZE <DSIZE=928%2>
IFNDEF	ESIZE <ESIZE=928%2>
IFNDEF	FSIZE <FSIZE=928%2>
IFNDEF	GSIZE <GSIZE=928%2>
	OCTAL

ASTRT=	0		/START WITH SECTOR 0
BSTRT=	ASTRT+ASIZE
CSTRT=	BSTRT+BSIZE
DSTRT=	CSTRT+CSIZE
ESTRT=	DSTRT+DSIZE
FSTRT=	ESTRT+ESIZE
GSTRT=	FSTRT+FSIZE

IFNZRO	GSTRT+GSIZE-6260 <SIZES DON'T ADD UP RIGHT!>

L13660=	-ASIZE^2	/DISPLAY PIP PATCHES
L13661=	-BSIZE^2
L13662=	-CSIZE^2
L13663=	-DSIZE^2
L13664=	-ESIZE^2
L13665=	-FSIZE^2
L13666=	-GSIZE^2

	DSKP=6741	/DISK INSTRUCTIONS
	DCLR=6742
	DLAG=6743
	DLCA=6744
	DRST=6745
	DLDC=6746
	*0		/BUILD PARAMETERS
	-AREAS
IFNZRO	ASIZE <DEVICE RKEN;DEVICE A;4600;A&177;ZBLOCK 2>
IFNZRO	BSIZE <DEVICE RKEN;DEVICE B;4610;B&177;ZBLOCK 2>
IFNZRO	CSIZE <DEVICE RKEN;DEVICE C;4620;C&177;ZBLOCK 2>
IFNZRO	DSIZE <DEVICE RKEN;DEVICE D;4630;D&177;ZBLOCK 2>
IFNZRO	ESIZE <DEVICE RKEN;DEVICE E;4640;E&177;ZBLOCK 2>
IFNZRO	FSIZE <DEVICE RKEN;DEVICE F;4650;F&177;ZBLOCK 2>
IFNZRO	GSIZE <DEVICE RKEN;DEVICE G;4660;G&177;ZBLOCK 2>
	*200
R37,	37		/CYLINDER MASK (AT PAGE+0!)
ABGIN,	ASTRT
BBGIN,	BSTRT		/OFFSET LIST
CBGIN,	CSTRT
DBGIN,	DSTRT
EBGIN,	ESTRT
FBGIN,	FSTRT
GBGIN,	GSTRT
RUNIT=	(DRIVE&3^2	/*B* DRIVE/UNIT SELECTION

/KEYBOARD CHECK

CTRLC,	TAD R7600	/TO IGNORE PARITY
	KRS		/READ THE KEYBOARD
	TAD (-7603
	SNA CLA		/TEST FOR CTRL/C
	KSF		/IS KEYBOARD FLAG UP?
	JMP RWAIT	/NO
RCIF,	CDF CIF 0
	JMP I R7600	/BOOTSTRAP

	ZBLOCK 220-.	/PAD ENTRY POINTS TO 220
A,	VERSION
B,	ISZ RKENO	/THE ISZ'S SET UP A COUNT OF
C,	ISZ RKENO	/WHICH ENTRY POINT WE CAME IN
D,	ISZ RKENO
E,	ISZ RKENO
F,	ISZ RKENO
G,	ISZ RKENO
	ISZ RKENO
RKENO,	0		/ENTRY POINT COUNT
	CLA CLL CMA RTL	/AC=-3
	DCA RERRCT	/RETRY 3 TIMES
	TAD RKENO	/GET ENTRY POINT COUNT
	CMA
	TAD .-2		/ADD ON INSTRUCTION
	DCA RKECMD	/EXECUTE TO GET USERS ADDRESS
	TAD RKECMD
	TAD (ABGIN-A	/COMPUTE AREA OFFSET
	DCA OFFSET
	STL RTR		/AC=2000, LINK=0
	TAD RKECMD	/GENERATE A 'DCA' INTO THE ENTRY POINT
	DCA RKEBLK	/THIS IS EXECUTED TO REPLACE THE 'ISZ'
	RDF		/GET USERS DATA FIELD
	TAD RCIF	/BUILD A CIF FOR RETURNING
	DCA REXIT	/STORE IT INTO THE EXIT CODE
	DCA RKENO	/RESET COUNTER
RKECMD,	HLT		/WILL BE A TAD "ENTRY POINT"
	DCA RKEARG	/SAVE USERS ADDR IN COMMON LOCATION
	TAD RKENO-1	/REPLACE 'ISZ RKENO'
RKEBLK,	HLT		/THE DCA ENTRY POINT IS PUT HERE.
RETRY,	TAD RKEARG	/AC=-3 IF ERROR RETRY
	DCA RKEARG
	TAD I RKEARG	/GET ARG1
	AND (4070	/GET R/W AND DF BITS
	TAD RUNIT	/*B* ADD DRIVE # (*2)
	DCA RKECMD	/BASE COMMAND TO RK8E(DLDC)
	TAD I RKEARG	/GET ARG1 AGAIN
	ISZ RKEARG	/POINT TO ARG2
	CLL RAL		/GET PAGE COUNT
	AND R7600
	CIA		/TO MAKE 0 LOOK LIKE 40 PAGES
	DCA PAGCNT	/SAVE PAGE COUNT
	TAD I RKEARG	/GET ARG2
	ISZ RKEARG	/POINT TO ARG3
	DLCA		/LOAD CURRENT ADDRESS REGISTER
OFFSET,	HLT		/GET (DISPLACEMENT/2)
	CLL RAL		/ALIGN
	TAD I RKEARG	/PLUS ARG3
	ISZ RKEARG	/POINT TO ERROR RETURN
	DCA RKEBLK	/LOW PART OF RK8E BLOCK NUMBER
	SZL		/STILL OFF IF BELOW BLOCK 10000
OVRFLO,	ISZ RKECMD	/TURN ON EXTENDED BIT IF OVERFLOWED
RELOOP,	DCA CHKHED	/SET CHECK HEADER FLAG TO EITHER 0 OR
			/4000(WHICH GETS RTR'D BEFORE USED) AND
			/DOES EITHER A "DATA" OR "ALL" TRANSFER
	DCLR		/CLEAR STATUS REGISTER
	TAD PAGCNT	/TEST TO SEE IF ONLY 1 PAGE WANTED
	TAD R200
	SNA CLA
	TAD (100^4	/7600 WAS IN PAGCNT
	TAD CHKHED	/ADD IN CHECK HEADER FLAG
	CLL RTR		/PUT BITS IN THEIR PLACES
	TAD RKECMD	/ADD IN BASE COMMAND
	DLDC		/LOAD COMMAND REGISTER
	TAD RKEBLK
	DLAG		/LOAD BLOCK REGISTER AND GO
RWAIT,	DSKP		/WAIT ON FLAG
	JMP CTRLC	/CHECK FOR CONTROL C WHILE WAITING
	DRST		/READ COMPLETION REGISTER
	CLL RAL		/GET RID OF SUCCESS BIT
	SZA		/AND SEE IF ANYTHING LEFT
	JMP RERROR	/AN ERROR

/IF THERE WAS NO ERROR L=1 BECAUSE OF DONE FLAG

	TAD PAGCNT	/CHECK TO SEE IF DONE
	TAD (200^2	/ADD 2 PAGES TO TOTAL
	SNL
	JMP R7600	/NO MORE TO DO
	DCA PAGCNT	/SAVE FOR NEXT TIME
	TAD RKEBLK
	CMA
/R37 MUST BE AT PAGE+0 SO THE FOLLOWING IS A 200

R200,	AND R37		/IF BLOCK IS AT A 37 MAKE
			/NEXT OPERATION DO A CHECK HEADER
	SZA CLA
	STL RAR		/SET AC TO "ALL" FLAG(4000)
	ISZ RKEBLK	/BUMP BLOCK NUMBER
	JMP RELOOP	/TRANSFER SOME MORE
	JMP OVRFLO	/PAST BLOCK 7777-SET EXTENDED BIT

RERROR,	AND (401^2	/AC WAS RAL'D AND WE WANT TO SEE IF
			/SEEK FAILED OR CYLINDER ADDR ERROR
	SNA CLA
	JMP RKTST3	/WE TRY 3 TIMES

/WE HAVE TO RECALIBRATE DRIVE

	DCLR		/CLEAR STAUS REGISTER
	STL RTL		/AC=2
	DCLR		/RECALIBRATE DRIVE
	DSKP		/WAIT ON FLAG
	JMP .-1
	DCLR		/CLEAR STATUS REGISTER
	DRST		/WAIT FOR STATUS TO CLEAR
	SZA CLA
	JMP .-2		/STILL DOING RECALIBRATE
RKTST3,	CLA CLL CMA RTL	/AC=-3
	ISZ RERRCT	/SKIP IF WE TRIED 3 TIMES
	JMP RETRY	/TRY AGAIN
	JMP REXIT	/ERROR EXIT (AC=-3)

R7600,	CLA I		/NORMAL EXIT (AC=0)
	ISZ RKEARG	/BUMP TO GOOD RETURN
REXIT,	HLT		/RESET USERS INST FIELD
	JMP I RKEARG	/**RETURN**

CHKHED,	0		/CHECK HEADER FLAG
PAGCNT,	0		/HOLDS PAGE COUNT
RERRCT,	0		/HOLDS RETRY COUNT
RKEARG,	0		/HOLDS RETURN ADDRESS

IFDEF	END <$END$>
IFNDEF	END <END=.>	/APPEND SIZE SPECS...
