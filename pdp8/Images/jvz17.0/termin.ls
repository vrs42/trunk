
/TERMINAL EMULATOR FOR USE ON A PDP8/12   PAL8-V12B 25-AUG-87 PAGE 1

             /TERMINAL EMULATOR FOR USE ON A PDP8/12         -JVZ-

             /THIS PROGRAM CONNECTS THE CONSOLE TERMINAL TO A REMOTE
             /HOST.  ALL CHARACTERS WITH THE EXCEPTION OF CTRL/B AND
             /CTRL/E ARE SENT AS IS.  CTRL/B GENERATES A 'BREAK' AND
             /CTRL/E RETURNS ('EXITS') TO OS/8.  'BREAK' FOLLOWED BY
             /A 'CTRL/X' IS SENT TO STOP THE TU58 SIMULATOR WHEN THE
             /PROGRAM IS FIRST STARTED.  THE PROGRAM RUNS ON ALL 12-
             /BIT MACHINES WITH MANY COMMAND-LINE OPTIONS AVAILABLE.

       6303  VERSION=        "3^100+"C-"@     /KEPT IN 'PSW'

             IFNDEF  RECDVC  <RECDVC=32>      /RECEIVE DEVICE CODE
             IFNDEF  XMTDVC  <XMTDVC=RECDVC+1>/TRANSMIT DEVICE CODE
             IFNDEF  BAUDRT  <BAUDRT=16>      /BAUD RATE CODE (9600)

       6321  KKSF=   RECDVC^10+IOT 1         /SKIP (MAY CLEAR FLAG TOO)
       6324  KKRS=   RECDVC^10+IOT 4         /.OR. CHAR WITH AC
       6325  KKIE=   RECDVC^10+IOT 5         /DISABLE INTERRUPTS
       6326  KKRB=   RECDVC^10+IOT 6         /READ CHAR AND CLEAR FLAG

       6331  TTSF=   XMTDVC^10+IOT 1         /SKIP, CLEAR FLAG MAYBE
       6332  TTCF=   XMTDVC^10+IOT 2         /CLEAR DONE FLAG
       6333  TTSB=   XMTDVC^10+IOT 3         /SET VT/78, '278 BAUD RATE
       6334  TTLS=   XMTDVC^10+IOT 4         /TRANSMIT CHARACTER

       0001          *1
00001  6232          CIF 30          /SYMBIONT SUPPORT
00002  5001          JMP 1
00003  0006  YMS,    "Y-"S           /FILL IN A HOLE

00004  0000  ODT,    ZBLOCK  3       /RESERVED FOR ODT

00007  0177  WR1,    (BAUDRT         /USED BY 'BREAK', 'XON'
00010  6334          TTLS
00011  6331          TTSF
00012  5011          JMP .-1
00013  0136  UPA,    "^&177          /'AND 7450'
00014  5407          JMP I WR1

00015  0000  INP,    0               /AUTO INDEX
00016  0000  OUP,    0
00017  0000  TSW,    0               /TERMINAL FLAG

       0020          *20             /ENTRY POINT
00020  7601  M177,   -177            /CLA
00021  0177  P177,   +177            /LOC = 'XON'
00022  6325          KKIE            /SYMBIONT SUPPORT
00023  6333  BREAK,  TTSB            /START WITH A BREAK
00024  4007          JMS WR1         /LOAD OUTPUT BUFFER
00025  7107          CLL IAC RTL     /4
00026  4007          JMS WR1         /THERE ARE SEVERAL
00027  7310          CLA CLL RAR     /DIFFERENT WAYS TO
00030  1177          TAD (BAUDRT     /DO THIS...
00031  6333          TTSB            /RESET BAUD RATE

