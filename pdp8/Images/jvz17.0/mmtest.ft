C	MATRIX MULTIPLICATION BENCHMARK - BYTE VOL 7 #10 OCT 1982 PP 254-67
	COMMON A(25,25),B(25,25)
	DIMENSION C(25,25)
	MAX=25
	WRITE(4,100)
100	FORMAT(' SIZE? ')
	READ(4,200) N
200	FORMAT(I4)
	IF(N.EQ.0)N=MAX
	DO 1 I=1,N
	DO 1 J=1,N
1	A(I,J)=I+J
	WRITE(4,300)
300	FORMAT(' A FILLED')
	DO 2 I=1,N
	DO 2 J=1,N
2	B(I,J)=(I+J)/J
	WRITE(4,400)
400	FORMAT(' B FILLED')
	DO 3 I=1,N
	DO 3 J=1,N
3	C(I,J)=0.
	WRITE(4,500)
500	FORMAT(' C FILLED')
	DO 4 I=1,N
	DO 4 J=1,N
	DO 4 K=1,N
4	C(I,J)=C(I,J)+A(I,K)*B(K,J)
	WRITE(4,600)
600	FORMAT(' MULTIPLIED')
	SUM=0.
	DO 5 I=1,N
	DO 5 J=1,N
5	SUM=SUM+C(I,J)
	WRITE(4,700) SUM
700	FORMAT(' SUM= ',F12.2)
	END
