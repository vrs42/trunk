/ PC8CPY: DEVICE -> XMODEM COPY PROGRAM		-JVZ-
/
/ THIS PROGRAM CAN BE CALLED DIRECTLY, OR CHAINED TO BY CCL(X)
/ TO COPY AN ENTIRE DEVICE TO A PC8(SOFT8) RK8E DISKPACK FILE.
/
/ COMPILE INSTRUCTIONS:
/
/	.PAL PC8CPY(LP9)
/	.SAVE SYS:PC8CPY
/
/ UNLESS CHAINED TO, PC8CPY CALLS THE COMMAND DECODER, LOOKING
/ FOR -ONE- DEV: NAME AND THE NUMBER OF BLOCKS (OCTAL) TO COPY
/ (SPECIFIED BY THE '=' OPTION):
/
/	.R PC8CPY	-OR-	.PCX D1:=1233
/	*D1:=1233
/
/	$ ALTMODE RECALLS C.D. (IF CHAINED TO) OR ENDS PROGRAM
/
/ OUTPUT IS TO AN INTERNAL XMODEM-COMPATIBLE HANDLER THAT SENDS
/ THREE BYTES PER TWO WORDS IN THE ORDER EXPECTED BY THE PC8 &
/ SOFT8 EMULATORS.  THE RESULTING FILES ARE THUS IMAGE COPIES
/ OF THE FILES ON THE INPUT DEVICE, WITH ALL OS/8 DATES AND ANY
/ OTHER SPECIAL FEATURES PRESERVED.

VERS=	0100	/VERSION 1_

IFNDEF	IDVC <IDVC=40>	/ASSUMED I/O DEVICE CODES
IFNDEF	ODVC <ODVC=IDVC+1>

KKSF=	IDVC^10+IOT 1
KKCF=	IDVC^10+IOT 2
KKRB=	IDVC^10+IOT 6

TTSF=	ODVC^10+IOT 1
TTCF=	ODVC^10+IOT 2
TTLS=	ODVC^10+IOT 6

CDI=	CDF CIF

USR=	10200	/ADDRESS OF USR (IN CORE)
UUSR=	17700	/ADDRESS OF USR (ON DISK)
FETCH=	 1	/FETCH A HANDLER
DECODE=  5	/CALL THE COMMAND DECODER
USRIN=	10

BUFFER=	0400	/INPUT BUFFER (TO 70/7400)
/ONE PAGE HANDLERS GO AT 7400 = 14. BLOCKS
/TWO PAGE HANDLERS GO AT 7200 = 13. BLOCKS
/ PC8: OS/8 -> XMODEM FILE TRANSFER		-JVZ-

/ THIS HANDLER IMPLEMENTS WARD CHRISTENSEN'S 'XMODEM'
/ PROTOCOL FOR SENDING/RECEIVING FILES OVER A SERIAL
/ LINE. THIS VERSION DOES -NOT- USE THE CRC CHECKSUM.

SOH=	"A&77		/CONTROL CHARACTERS
EOT=	"D&77
ACK=	"F&77
NAK=	"U&77
CAN=	"X&77

	*7
PC8,	VERS		/LEAVE ROOM FOR ODT...
	TAD I PC8
X377,	200 (3700	/HAVE TO FORCE CURRENT PAGE
	STL CIA
	DCA DWC
	ISZ PC8
	TAD I PC8
XX07,	ISZ PC8
	DCA BAD
	TAD I PC8
	ISZ PC8
	SZL		/CLOSE?
	 JMP WRITE
CLOSE,	CLA CLL IAC RTL	/=EOT
	JMS OUTC
	JMS I (SYNC
	 SKP		/ACK
	JMP CLOSE	/NAK
EXIT,	ISZ PC8
	JMP I PC8

WRITE,	SZA CLA		/BLOCK 0?
	 JMP NEXT
	DCA BLK		/CLEAR PACKET COUNTER
	MQL
	TAD (JMP NO1
	DCA NO2		/INITIALIZE BYTE LOOP
	JMS I (SYNC
	 JMP .-1	/ACK
NEXT,	TAD DWC		/NAK
	SNA
	JMP EXIT	/DONE
	DCA DWCSV
	TAD BAD
	DCA BADSV
	TAD NO2
	DCA NO2SV

	ISZ BLK		/NEXT BLOCK
X177,	177		/PROTECT ISZ
/	TAD (-12
/	DCA TOCNT

REPEAT,	TAD M200
	DCA CDFX
	DCA CKSUM

X7201,
HEADER,	CLA IAC		/SOH
	JMS OUTC
	TAD BLK
	MQL		/DISPLAY BLK #
	MQA
	JMS OUTC
	TAD BLK
	CMA
	JMS OUTC

NO2,	JMP NO1		/OR: AND XX, JMP NO3
	TAD NO2
	DCA OUTC
	TAD (JMP NO3
	DCA NO2
	TAD I BAD
	AND X7400
	CLL RAL
	TAD OUTC
	RTL;RTL
	JMP X7400+1
NO1,	TAD I BAD
	AND X17
	DCA NO2		/'AND XX'
	TAD I BAD
	RTR;RTR
	JMP X7400-1
NO3,	TAD (JMP NO1
	DCA NO2
	ISZ DWC
X17,	17
	TAD I BAD
	ISZ BAD
X7400,	NOP I
	JMS OUTC
	ISZ CDFX
	JMP NO2

	TAD CKSUM
	JMS OUTC
	JMS I (SYNC
	JMP NEXT	/ACK
	TAD DWCSV	/NAK
	DCA DWC
	TAD BADSV
	DCA BAD
	TAD NO2SV
	DCA NO2
	TAD XX07	/BEEP ON REPEAT
	TLS
/	TSF		/LOTS OF TIME 'TIL NEXT ONE
/	JMP .-1
M200,	CLA I
/	ISZ TOCNT
	JMP REPEAT
/	JMP EXIT

OUTC,	0
	AND X377
	TTLS
	TTSF
	JMP .-1
	TAD CKSUM
	DCA CKSUM
	JMP I OUTC

BLK,	0
DWC,	0
BAD,	0
CDFX=	3		/HOLE BETWEEN SYMBIONT & ODT

CKSUM,	0
DWCSV,	0
BADSV,	0
NO2SV,	0
/TOCNT,	0

	FIELD 0		/DUMP PAGE 0 LITERALS
/ PROGRAM PROPER (IT ALL FITS ON THIS + PAGE 0)

	*200
START,	SKP CLA		/NORMAL ENTRY POINT
	JMP CHAIN	/CHAIN ENTRY (CMD DECODE DONE BY CCLX)
	CIF 10
	JMS I X17700	/BRING USR IN
	USRIN
	CIF 10		/SEE WHAT TO DO
	JMS USR
	DECODE
	0/5200		/SPECIAL MODE?
	0
CHAIN,	TAD (-16	/7400-400 = 14. BLOCKS
	DCA BUFSIZ
	TAD X7400	/TRY ONE-PAGE HANDLER FIRST
GO4IT,	DCA IHNADR
	CDF 10
	TAD I (17646	/EQUALS OPTION
	SNA
	 JMP CDF10
	DCA EQUALS
	TAD I (17644	/PAUSE OPTION
	SZA CLA
	 TAD NASTY
	DCA PAUSW
	TAD I (17620	/FILE NAME? (17606 IN * MODE)
	SZA CLA
	 JMP CDF10
	TAD I (17617	/FIRST INPUT DEVICE # (17605)
	CDF 0
	SNA
	 JMP CDF10	/NO DEVICE SPECIFIED
	CIF 10
	JMS USR
	FETCH
IHNADR,	7201
	 JMP TWOPAG	/ERROR? TRY TWO PAGE HANDLER
PAUSW,	0/HLT		/ALLOW DISKPACK SWAP

LOOP,	DCA BLKNUM	/START WITH BLOCK 0
	TAD BLKNUM
	DCA PC8NUM
	STL
	TAD BUFSIZ	/-15 OR -16
	TAD EQUALS
	SZL
X7600,	 CLA I
	DCA REMAIN	/REMAINING BLOCKS TO COPY
	TAD REMAIN
	CIA
	TAD EQUALS	/NUMBER OF BLOCKS TO COPY
	SNA
	JMP START	/BAD EQUALS OPT.
	DCA BLKCNT
	TAD BLKCNT	/NUMBER TO COPY THIS TIME
	CLL RTR
	RTR		/CONVERT TO PAGE COUNT
	RTR
	DCA FNWORD
RETRY,	JMS I IHNADR
FNWORD,	3200		/BLOCK COUNT ^ 200 + DF^10
	BUFFER
BLKNUM,	0
	 JMP NASTY	/READ ERROR (IT HAPPENS!)
	STL RAR		/SET WRITE BIT
	TAD FNWORD
PC8END,	DCA PC8FNW
	JMS PC8
PC8FNW,	7200
	BUFFER
PC8NUM,	0
	 JMP NASTY	/PRETTY UNLIKELY, THIS ONE

	TAD REMAIN	/CHECK PROGRESS
	SNA
	 JMP FINISH	/DONE!
	DCA EQUALS
	TAD BLKNUM
	TAD BLKCNT
	JMP LOOP

NASTY,	HLT		/RATHER CRUDE, EH?
	JMP RETRY

FINISH,	TAD PC8FNW
	SZA CLA
	 JMP PC8END	/CLOSE REMOTE FILE
	TAD PAUSW
	DCA .+1
	0/HLT
CDF10,	CDF 10
	TAD I (17642	/ALTMODE FLAG
	CDF 0
X17700,	SMA CLA
	 JMP START	/REPEAT UNTIL SET
	JMP I X7600

TWOPAG,	ISZ BUFSIZ	/ONE LESS BLOCK
	TAD X7201
	JMP GO4IT	/7200-400 = 13.5 BLOCKS

SYNC,	0
	KKSF
	 SKP
	KKRB
	AND X177
	TAD (-CAN
	SNA
	 JMP FINISH
	TAD (CAN-NAK
	SNA
	 ISZ SYNC
	SZA
	 TAD X17	/(NAK-ACK
	SNA CLA
	 JMP I SYNC

KB,	TAD X7600
	KRS
	TAD (-7603
	SNA CLA
	 KSF
	 JMP SYNC+1
	JMP FINISH

EQUALS,	0
REMAIN,	0
BLKCNT,	0
BUFSIZ,	0

	$END$
