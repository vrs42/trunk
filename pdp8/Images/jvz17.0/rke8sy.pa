/2 RK8E SYSTEM HANDLER FOR SEVEN AREAS		-JVZ-

/ THIS HANDLER SPLITS A RK05 DISK INTO 7 AREAS OF VARI-
/ OUS SIZES.  *HALF* THE DESIRED DEVICE LENGTH FOR EACH
/ AREA SHOULD BE DEFINED AS 'ASIZE', 'BSIZE', ETC., THE
/ TOTAL BEING 3248.  LOCS. 13640-13646 IN PIP.SV SHOULD
/ THEN BE CHANGED TO THE VALUES GIVEN FOR L13640-L13646.

/ THE ENTRY POINTS ARE LABELED: SYS:(OR A:),B:,C:,D:,E:,
/ F:,G:.  ONLY ENTRY POINTS FOR DEVICES WITH A NON-ZERO
/ SIZE ARE INCLUDED.  THE HANDLER REQUIRES AT LEAST 12K.

	VERSION="B&77

	DECIMAL
IFNDEF	AREAS <AREAS=7>
IFNDEF	ASIZE <ASIZE=928%2>
IFNDEF	BSIZE <BSIZE=928%2>
IFNDEF	CSIZE <CSIZE=928%2>
IFNDEF	DSIZE <DSIZE=928%2>
IFNDEF	ESIZE <ESIZE=928%2>
IFNDEF	FSIZE <FSIZE=928%2>
IFNDEF	GSIZE <GSIZE=928%2>
	OCTAL

ASTRT=	0		/START WITH SECTOR 0
BSTRT=	ASTRT+ASIZE
CSTRT=	BSTRT+BSIZE
DSTRT=	CSTRT+CSIZE
ESTRT=	DSTRT+DSIZE
FSTRT=	ESTRT+ESIZE
GSTRT=	FSTRT+FSIZE

IFNZRO	GSTRT+GSIZE-6260 <SIZES DON'T ADD UP RIGHT!>

L13660=	-ASIZE^2	/DISPLAY PIP PATCHES
L13661=	-BSIZE^2
L13662=	-CSIZE^2
L13663=	-DSIZE^2
L13664=	-ESIZE^2
L13665=	-FSIZE^2
L13666=	-GSIZE^2

	*0		/BUILD PARAMETERS
	-AREAS-1
DEVICE RKES;DEVICE SYS;4601;6007;0;ASIZE^2
IFNZRO	ASIZE <DEVICE RKES;DEVICE A;4601;A-2600;ZBLOCK 2>
IFNZRO	BSIZE <DEVICE RKES;DEVICE B;4611;B-2600;ZBLOCK 2>
IFNZRO	CSIZE <DEVICE RKES;DEVICE C;4621;C-2600;ZBLOCK 2>
IFNZRO	DSIZE <DEVICE RKES;DEVICE D;4631;D-2600;ZBLOCK 2>
IFNZRO	ESIZE <DEVICE RKES;DEVICE E;4641;E-2600;ZBLOCK 2>
IFNZRO	FSIZE <DEVICE RKES;DEVICE F;4651;F-2600;ZBLOCK 2>
IFNZRO	GSIZE <DEVICE RKES;DEVICE G;4661;G-2600;ZBLOCK 2>

	BOOT-BLAST	/LENGTH OF BOOTSTRAP (FOR BUILD)
/ THE BOOTSTRAP PRESERVES THE CURRENT SYSTEM DATE:

/	40	6743	OR	30	6743
/	41	5041		31	5031

/	LOAD ADDRESS 40, HIT 'CLEAR', THEN 'CONT'.

	RELOC 0
BOOT,	TAD I BOOTX1	/RELOCATE 200 TO 07600
	DCA I BOOTX2
	CDF 20
	TAD I BOOTX3	/& 27447 TO 17647, ETC.
	ISZ BM20
	CDF 10		/SKIPPED AT LOCN 17666
	DCA I BOOTX4
	CDF 0
	ISZ BM177	/-200 WILL STORE 07777
	JMP BOOT
	JMP I B7605	/BOOT TO OS/8

BOOTX1,	177		/MUST BE HERE TO BE AUTO-INDEX!!
BOOTX2,	7577
BOOTX3,	7446
BOOTX4,	7646

BM20,	7646-7666	/SKIPS AT 17666
BM177,	-200		/PROTECTS 07777

PART2,	JMS I B207	/USE HANDLER TO READ PATCH
	0220
	7400
	0066		/BLOCK 66 HAS FIELDS 1 & 2
	HLT
	JMP BOOT	/NOW MOVE FIELD 0,1 CODE
B207,	SYS&377

	ZBLOCK	30-.	/DSKP GOES OVER 30
	DSKP		/LOADS OVER TOGGLE-IN.
	JMP .-1
BOOT32,	AND RK6
	DCA I RKUNIT
	JMP PART2

RK6,	6
RKUNIT,	SYSUNT&377	/CHANGED BEFORE IT IS MOVED
B7605,	07605

	ZBLOCK 40-.	/ALTERNATE BOOT LOCATION
	DSKP		/EASIER TO ENTER ON 8/E:
	JMP .-1		/LOC 40: 6743
	JMP BOOT32	/LOC 41: 5041
BLAST,	RELOC

	PAGE 1
	RELOC 7600
	ZBLOCK 7
A,
SYS,	VERSION		/SYSTEM HANDLER ENTRY POINT
	CLA CLL		/GUARD AGAINST RANDOM AC
CIF0,	CIF 0		/FOR RESTORING USERS FIELD
	3		/FLAG FOR 'TWO-PAGE' HANDLER
	DCA OFFSET	/SET OFFSET FOR SYS OR A-E
	DCA EPCNT	/RESET E.P. COUNTER
	CMA CLL RTL	/AC=-3
	DCA SERRCT	/SET RETRY COUNT
	RDF
	TAD CIF0
	DCA SEXIT	/SET USER INST FIELD FOR EXIT
RETRY,	TAD SYS		/AC=-3 IF ERROR ENTRY
	DCA SYS
	TAD I SYS	/GET ARG1
	AND S4070	/GET R/W AND DF BITS
	TAD SYSUNT
	DCA RKECMD	/BASE COMMAND TO RK8E(DLDC)
	JMP CONT	/SKIP AROUND OTHER EP'S
OFFSET,
B,	VERSION		/REMAINING ENTRY POINTS
C,	ISZ EPCNT
D,	ISZ EPCNT
E,	ISZ EPCNT
F,	ISZ EPCNT
G,	ISZ EPCNT
	STA CLL RTL	/-3
	CLL RAL		/-6
	TAD EPCNT
IFNZRO .-7642 <'CIF XX' IS NOT AT 7642>
	CIF 20		/MUST BE AT 7642
	JMP BCDEFG	/-1 FOR B, -6 FOR G
EPCNT,	0		/ENTRY POINT COUNTER

CONT,	TAD I SYS	/GET ARG1 AGAIN
	ISZ SYS		/POINT TO ARG2
	AND S3700
	SNA
	STL CLA RAR	/4000
	DCA PAGCNT	/SAVE PAGE COUNT
	TAD I SYS	/GET ARG2
	ISZ SYS		/POINT TO ARG3
	DLCA		/LOAD CURRENT ADDRESS REGISTER
	TAD OFFSET	/DISPLACEMENT
	CLL RAL		/TIMES TWO
	TAD I SYS	/PLUS ARG3
	ISZ SYS
	DCA RKEBLK	/LOW PART OF RK8E BLOCK NUMBER
	SZL		/STILL OFF IF BELOW BLOCK 10000
OVRFLO,	ISZ RKECMD	/TURN ON EXTENDED BIT IF OVERFLOWED
RELOOP,	DCA CHKHED	/SET CHECK HEADER FLAG TO EITHER 0 OR
			/4000(WHICH GETS RTR'D BEFORE USED) AND
			/CAUSES EITHER A "DATA" OR "ALL" TRANSFER
	TAD PAGCNT	/TEST TO SEE IF ONLY 1 PAGE WANTED
	AND S7600
	SNA CLA
	TAD S400	/100 WAS IN PAGCNT
	TAD CHKHED	/ADD IN CHECK HEADER FLAG
	CLL RTR		/SHIFT TO CORRECT BITS
	TAD RKECMD	/ADD IN BASE COMMAND
	DLDC		/LOAD COMMAND REGISTER
	TAD RKEBLK
	DLAG		/LOAD BLOCK REGISTER AND GO
IFNZRO .-7700 <SYSUNIT NOT AT 7700>
SYSUNT,	0		/SYSTEM DEV UNIT # (SET BY BOOTSTRAP)
	DSKP		/WAIT ON FLAG
	JMP .-1		/(PROTECTS AGAINST FIELD 0 USR CALLS)
	DRST		/READ COMPLETION REGISTER
	CLL RAL		/GET RID OF SUCCESS BIT
	SZA CLA		/AND SEE IF ANYTHING LEFT
	JMP SERROR	/AN ERROR
	TAD PAGCNT
	TAD S7600
	SPA SNA
	JMP S7600	/DONE: EXIT
	DCA PAGCNT
	TAD RKEBLK
	CMA
	AND S37		/CHECK HEADER ON CYLINDER CHANGES
	SZA CLA
	STL RAR		/SET AC TO "ALL" FLAG
	ISZ RKEBLK	/BUMP BLOCK NUMBER
	JMP RELOOP	/TRANSFER SOME MORE
	JMP OVRFLO	/PAST BLOCK 7777-SET EXTENDED BIT

SERROR,	CIF 20		/ERROR HANDLING IS IN FIELD 2
	JMP SERR0R
	CMA CLL RTL 	/AC=-3
	ISZ SERRCT	/SKIP IF WE TRIED 3 TIMES
	JMP RETRY	/TRY AGAIN
	JMP SEXIT	/ERROR EXIT (AC=-3)
S7600,	CLA I		/NORMAL EXIT (AC=0)
	ISZ SYS		/BUMP TO GOOD RETURN
SEXIT,	HLT		/RESET USERS INST FIELD
	JMP I SYS	/*RETURN*

S37,	37		/FOR CYLINDER SHIFT TEST
S400,	100^4		/FOR 128 WORD TRANSFERS
S3700,	3700		/TO GET PAGE COUNT
S4070,	4070		/TO GET R/W, DF BITS

RKEBLK=	7750		/12 BITS OF BLOCK NUMBER
SERRCT=	7751		/HOLDS RETRY COUNT
PAGCNT=	7752		/PAGE COUNT
RKECMD=	7753		/BASE OF DLDC COMMAND
CHKHED=	7754		/CHECK HEADER FLAG
	RELOC
	PAGE 2
NOPUNCH;FIELD 2;ENPUNCH	/FIELD 2 CODE
RELOC	7600
BBGIN,	BSTRT		/OFFSET TABLE
CBGIN,	CSTRT
DBGIN,	DSTRT
EBGIN,	ESTRT
FBGIN,	FSTRT
GBGIN,	GSTRT

BCDEFG,	CMA		/POINT TO ENTRY POINT
	TAD ENTRY
	DCA POINT
	RDF
	TAD CDF0	/SAVE DF
	DCA CDFX
CDF0,	CDF 0
	TAD I POINT
	DCA I SYSP	/MOVE TO SYS
	TAD ISZCNT
	DCA I POINT	/REPLACE THE ISZ
CDFX,	HLT		/RESTORE CALLING FIELD
	TAD ADJUST
	TAD POINT
	DCA POINT
POINT,	HLT		/GET (DISPLACEMENT/2)
	CIF 0
	JMP CIF0+2

SERR0R,			/RECALIBRATE ON ALL ERRORS
	DCLR		/CLEAR STATUS REGISTER
	STL RTL		/AC=2
	DCLR		/RECALIBRATE DRIVE
	DSKP		/WAIT ON FLAG
	JMP .-1
	DCLR		/CLEAR STATUS REGISTER
	DRST		/WAIT FOR STATUS TO CLEAR
	SZA CLA
	JMP .-3		/STILL DOING RECALIBRATE
	CIF 0
	JMP SERROR+2

SYSP,	SYS
ENTRY,	OFFSET
ADJUST,	1200-B		/1200=TAD BBGIN
ISZCNT,	ISZ EPCNT

	DSKP=6741	/DISK INSTRUCTIONS
	DCLR=6742
	DLAG=6743
	DLCA=6744
	DRST=6745
	DLDC=6746
	DMAN=6747

IFDEF	END <$END$>
IFNDEF	END <END=.>	/APPEND SIZE SPECS...
