/TERMINAL EMULATOR FOR USE ON A PDP8/12		-JVZ-

/THIS PROGRAM CONNECTS THE CONSOLE TERMINAL TO A REMOTE
/HOST.  ALL CHARACTERS WITH THE EXCEPTION OF CTRL/B AND
/CTRL/E ARE SENT AS IS.  CTRL/B GENERATES A 'BREAK' AND
/CTRL/E RETURNS ('EXITS') TO OS/8.  'BREAK' FOLLOWED BY
/A 'CTRL/X' IS SENT TO STOP THE TU58 SIMULATOR WHEN THE
/PROGRAM IS FIRST STARTED.  THE PROGRAM RUNS ON ALL 12-
/BIT MACHINES WITH MANY COMMAND-LINE OPTIONS AVAILABLE.

VERSION=	"3^100+"C-"@	 /KEPT IN 'PSW'

IFNDEF	RECDVC	<RECDVC=32>	 /RECEIVE DEVICE CODE
IFNDEF	XMTDVC	<XMTDVC=RECDVC+1>/TRANSMIT DEVICE CODE
IFNDEF	BAUDRT	<BAUDRT=16>	 /BAUD RATE CODE (9600)

KKSF=	RECDVC^10+IOT 1		/SKIP (MAY CLEAR FLAG TOO)
KKRS=	RECDVC^10+IOT 4		/.OR. CHAR WITH AC
KKIE=	RECDVC^10+IOT 5		/DISABLE INTERRUPTS
KKRB=	RECDVC^10+IOT 6		/READ CHAR AND CLEAR FLAG

TTSF=	XMTDVC^10+IOT 1		/SKIP, CLEAR FLAG MAYBE
TTCF=	XMTDVC^10+IOT 2		/CLEAR DONE FLAG
TTSB=	XMTDVC^10+IOT 3		/SET VT/78, '278 BAUD RATE
TTLS=	XMTDVC^10+IOT 4		/TRANSMIT CHARACTER

	*1
	CIF 30		/SYMBIONT SUPPORT
	JMP 1
YMS,	"Y-"S		/FILL IN A HOLE

ODT,	ZBLOCK	3	/RESERVED FOR ODT

WR1,	(BAUDRT		/USED BY 'BREAK', 'XON'
	TTLS
	TTSF
	JMP .-1
UPA,	"^&177		/'AND 7450'
	JMP I WR1

INP,	0		/AUTO INDEX
OUP,	0
TSW,	0		/TERMINAL FLAG

	*20		/ENTRY POINT
M177,	-177		/CLA
P177,	+177		/LOC = 'XON'
	KKIE		/SYMBIONT SUPPORT
BREAK,	TTSB		/START WITH A BREAK
	JMS WR1		/LOAD OUTPUT BUFFER
	CLL IAC RTL	/4
	JMS WR1		/THERE ARE SEVERAL
	CLA CLL RAR	/DIFFERENT WAYS TO
	TAD (BAUDRT	/DO THIS...
	TTSB		/RESET BAUD RATE
	CLA CMA		/CTRL/X TO STOP TU58
TTSW,	JMP CAN		/A 'ONCE-ONLY' INSTR.

TE1,	TAD TSW		/CHECK OUTPUT FLAG
	SZA CLA
	JMP TE2
	TAD PSW		/CHECK FOR A PAUSE
	SNA CLA
	JMP DEL		/CHECK FOR DELETE
	TAD OUP
	STL CIA
	TAD INP		/ANYTHING TO PRINT?
	SNA CLA
	JMP RST		/CHECK FOR RESTART
	TAD I OUP
	TLS		/TYPE NEXT CHARACTER
	JMP TE3-1

DEL,	TAD WR1		/CHECK FOR DELETE
	TAD M177	/DURING A PAUSE
	SNA CLA
RST,	JMS PSW		/CLEAR BUFFER

TE2,	TSF		/CHECK DONE FLAG
	JMP TE3
	TCF		/CLEAR IT IF SKIP DIDN'T
	DCA TSW

TE3,	KKSF		/INPUT FLAG UP?
	JMP TE4		/NO
	KKRB
XON,	AND P177
	SZA
	TAD M10		/TEST CHAR
ARSW,	SPA-200		/7310 = NO ARROW
X100,	JMP M10-1	/PRINT '^,LETTER'
	TAD (10-15
	SPA SNA
	JMP M10		/LEAVE BS-CR ALONE
	TAD (15-33
	SZA
	TAD (33-40	/ALSO ESCAPE
	CMA CLL
M10,	SPA SNA SZL CLA
	JMP ASIS	/ALL PRINTING CHARS
	TAD UPA
	DCA I INP	/PRINT AS '^,LETTER'
	TAD X100
ASIS,	KKRS
	DCA I INP	/STORE CHARACTER
	TAD TTSW	/CHECK OUTPUT FLAG
	SNA CLA
	TAD INP		/TEST FOR OVERFLOW
	SPA CLA
	JMP XOFF	/SEND 'XOFF'
TE4,	TAD TTSW	/OUTPUT FLAG UP?
	SNA CLA		/YES: WAIT A BIT
	KSF		/KB FLAG UP?
	JMP TE5
	KRB		/GET CHARACTER
	AND P177
	TAD (-5		/CHECK FOR ^E
	SNA
	JMP I C7600
	CLL IAC
	CML IAC		/CHECK FOR ^C
	SNA
	JMS PSW
	IAC		/CHECK FOR ^B
	SKP/SNA
	JMP BREAK
	TAD ("B-"Y	/CHECK FOR ^Y
CAN,	SNA
	JMS PSW
	TAD YMS		/CHECK FOR ^S
	SNA
	DCA PSW
XOFF,	CLL IAC		/CHECK FOR ^Q
	CLL IAC
	SNA
	ISZ PSW
	TAD XON		/RESTORE CHAR
	TTLS
	DCA TTSW	/ENTRY POINT

TE5,	TTSF		/VAX OUTPUT DONE?
	JMP TE1
	TTCF		/YES
	TAD TTSW
	DCA WR1		/FOR DELETE CHECK
	JMP TE5-1

PSW,	VERSION		/PAUSE SWITCH
	TAD INP
	SNL SMA CLA	/BUFFER FULL?
	JMP .+4
	TAD XON		/SEND 'XON'
	JMS WR1
C7600,	CLA I
	TAD P177	/RESET POINTERS
	DCA OUP
	TAD OUP
	DCA INP
	JMP I PSW

	FIELD 0
/INITIALIZATION CODE FOR TERMIN PROGRAM			-JVZ-

/THIS CODE SCANS THE COMMAND LINE WHICH CALLS THE TERMIN PRO-
/GRAM, LOOKING FOR THE FOLLOWING CONFIGURATION OPTIONS:

/	/NORMAL[=XX]	-	USE 'KL8E' BREAK; TLS=6XX6
/	/DECSTA[=2,3]	-	BAUD-RATE BREAK; SLU2,SLU3
/	/SPECIAL	-	SPECIAL BREAK; DVC=40,41
/	/SPEED=NNNN	-	SET BAUD RATE (50-19200)
/	/BAUDRATE=NNNN	-	SAME AS /SPEED=NNNN
/	/INPUT=XX	-	CHANGE INPUT DEVICE CODE
/	/OUTPUT=XX	-	CHANGE OUTPUT DEVICE CODE
/	/ARROW		-	SHOW CTRL CHARS AS '^,CHAR'
/	/VERSION	-	PRINT VERSION NUMBER
/	/HELP		-	PRINT OPTION SUMMARY
/	/PERMANENT	-	MODIFY PROGRAM LOAD FILE

/OPTIONS MAY BE SPECIFIED IN ANY ORDER; NO SPACES ARE PERMIT-
/TED BETWEEN THE '/' AND THE OPTION WORD, NOR BETWEEN THE '='
/SIGN AND THE NUMERIC PARAMETER.  SINGLE-LETTER ABBREVIATIONS
/MAY BE USED, HOWEVER, SINCE ONLY THE FIRST LETTER IS TESTED:

/EXAMPLE 1:		.R TERMIN /N=46 /PERM

/THIS SPECIFIES A 'NORMAL' INTERFACE (KL8E, KL8JA, M707, ETC.)
/SET FOR DEVICE CODES 46 (INPUT) AND 47 (OUTPUT).  THE CHANGES
/WILL BE SAVED IN SYS:TERMIN.SV.  BOTH /NORMAL AND /DECSTATION
/REMOVE CONTROL CHARACTER FLAGGING UNLESS /ARROW IS SPECIFIED.

/EXAMPLE 2:		.TER/D/S=300/P

/THIS RUNS THE PROGRAM USING THE OS/78 CCL COMMAND, SPECIFYING
/THE '/DECSTATION', '300 BAUD' AND '/PERMANENT' OPTIONS.  THE
/OPTIONS CAN THEN BE OMITTED IN SUBSEQUENT CALLS UNTIL, (SAY),
/IT IS NECESSARY TO SPECIFY A DIFFERENT BAUD RATE OR SWITCH TO
/A DIFFERENT PORT.  ('SLU3' IS THE DEFAULT: '/D=2' SWITCHES TO
/'SLU2'.  'DECMATE' (VT/278) PROCESSORS CAN ONLY USE 'SLU3'.)

/THE FOLLOWING ERROR MESSAGES MAY BE PRINTED ON THE TERMINAL,
/FOLLOWED BY A RETURN TO THE OS/8 MONITOR:

/	NOT UNDER BATCH!	       (CAN'T RUN UNDER BATCH)
/	INPUT DVC = OUTPUT DVC	       (CODES MUST BE UNIQUE!)
/	BAD SPEED OR BAUD RATE	       (SEE NOTE BELOW)
/	WRITE ERROR ON LOAD DEV        (UPDATE (/PERM) FAILED)

/THE FOLLOWING ARE THE ONLY BAUD RATES AVAILABLE (VT/78,'278):
/50,75,110,134,150,300,600,1200,1800,2000,2400,3600,4800,7200,
/9600 AND 19200; THE DEFAULT FOR THE /D OPTION IS 9600.  (THIS
/CAN BE CHANGED BY PATCHING LOCATION '200' OF THE '.SV' FILE.)
BR,	BAUDRT		/DEFAULT BAUD RATE
XX32,	CLA STL RTR	/2000
	AND I (7777	/CHECK IF BATCH IS RUNNING
	SZA CLA
	JMS I (ERROR	/CAN'T RUN UNDER BATCH
	BATERR
	TAD XON
	DCA I (7745	/SET RESTART ADDRESS TO 21

	DCA IDVC	/CLEAR INPUT DEVICE CODE
NS,	JMS I (SCAN	/CHECK FOR /NORMAL OPTION
	"N
	JMP DS		/NOPE: TRY /DECSTATION
	DCA IDVC	/SAVE OPTIONAL INPUT DVC
	JMS I (MKLB	/INSTALL 'KL8E' BREAK
	TAD IDVC
XX40,	SZA		/DEVICE CODE SPECIFIED?
	IAC		/YES
	DCA ODVC	/MAKE ODVC=IDVC+1
	TAD CTRLX
	JMP IS-1	/SKIP /B/D/S OPTIONS

SB,	CLA CMA		/INSTALL SPECIAL BREAK
	DCA INP
	TAD XX40
	JMP NS+3

DS,	JMS I (SCAN	/LOOK FOR /DECSTATION=XX
	"D
	JMP BS-1	/CLEAR OUTPUT CODE
	CLL RAR
	SNL SZA CLA	/SKIP FOR /3 OR [NONE]
	CMA CLL RAL	/-2   FOR /2 OR /30
	TAD XX32	/DEFAULT IS SLU3 (32,33)
	DCA IDVC
	TAD BR		/SET DEFAULT SPEED (9600)
	DCA 177
	JMS I (MDSB	/INSTALL DECSTATION BREAK
	TAD IDVC
	IAC
	DCA ODVC	/SET OUTPUT DEVICE CODE

BS,	JMS I (SCAN	/LOOK FOR /BAUD_RATE OPT.
	"B
P7510,	SPA
	JMP P7310	/REMOVE BAUD RATE

SS,	JMS I (SCAN	/LOOK FOR /SPEED OPTION
	"S
	JMP IS		/CONTINUE
	SNA CLA
	JMP SB		/0= THE /SPECIAL OPTION
P7310,	CLA CLL RAR
	TAD (BRTBL-1	/INITIALIZE TABLE POINTER
	DCA INP
LP,	TAD I INP	/CHECK AGAINST TABLE
	SNA
	JMP SE		/UN-RECOGNIZED SPEED
	TAD WR1
	SZA CLA		/MATCH?
	JMP LP		/TRY AGAIN

	TAD INP		/COMPUTE BAUD RATE CODE
	TAD (-BRTBL
	DCA 177

IS,	JMS I (SCAN	/LOOK FOR /INPUT OPTION
	"I
	JMP OS
	DCA IDVC	/SAVE NEW INPUT DVC

OS,	JMS I (SCAN	/LOOK FOR /OUTPUT OPTION
	"O
	JMP AS
	DCA ODVC	/SAVE NEW OUTPUT DVC

AS,	JMS I (SCAN	/LOOK FOR /ARROW OPTION
	"A
	JMP VS
	TAD P7510	/MAKE CTRL CHARS VISIBLE
	DCA ARSW

VS,	JMS I (SCAN	/LOOK FOR /VERSION OPTION
	"V
	JMP HS
	JMS I (TYPE	/PRINT VERSION ID
	VERSN

HS,	JMS I (SCAN	/LOOK FOR /HELP OPTION
	"H
	JMP RP
	JMS I (ERROR	/PRINT SUMMARY, RETURN
	HELPER

RP,	TAD BREAK-1
	JMS I (REPLAC	/REPLACE INPUT IOTS
IDVC,	0
	TAD WR1+1
	JMS I (REPLAC	/REPLACE OUTPUT IOTS
ODVC,	0

	TAD TE3		/ARE DEVICE CODES EQUAL?
	CIA
	TAD TE5
	SNA CLA
	JMS I (ERROR	/YES!  CAN'T ALLOW THAT!
	EQLERR
PERM,	JMS I (SCAN	/LOOK FOR /PERM OPTION
	"P
	JMP STRTUP	/CLEAR XREG. AND START
	DCA INP
	TAD I (7756	/MOVE HANDLER ENTRY PT
	DCA WR1
	TAD I (7762	/MOVE BLOCK NUMBER
	DCA BLOK
	JMS I WR1	/CALL LOAD HANDLER
	4200		/WRITE 1 BLOCK
	0		/FROM LOCATION 0
BLOK,	0
	JMS I (ERROR	/HANDLER ERROR?
	WRLERR		/MUST BE WRITE-LOCKED...

STRTUP,	DCA INP		/CLEAR MAIN X-REGISTER
/	JMP M177	/AND START THE PROGRAM
	JMP TE5-1	/V3C: NO BREAK, CTRL/X

SE,	JMS I (ERROR	/NON-STANDARD BAUD RATE
	BRERR

CTRLX,	"X&77

	PAGE
VERSN,	TEXT "TERMIN V3C "

TYPE,	0		/ERROR MESSAGE PRINTER
	SNA
	TAD I TYPE
	DCA WR1		/SAVE MESSAGE ADDRESS
	TAD I WR1
	RTR
	RTR
	RTR
	JMS PRNT	/PRINT FIRST BYTE
	TAD I WR1
	JMS PRNT
	ISZ WR1
	JMP TYPE+4

PRNT,	0
	AND C77
	SNA
	JMP I TYPE	/ALL DONE
	TAD .+1
	AND C77
	TAD .-1
	TLS
	TSF
	JMP .-1
	CLA
	JMP I PRNT

C10,	10		/PUT C77 AT 'PAGE+40'
C77,	77

ERROR,	0		/PRINT ERROR MESSAGE
	CLA CLL
	TAD I ERROR	/GET MESSAGE POINTER
	JMS TYPE
	TAD I (7746	/MODIFY JOB STATUS WORD
	AND (6777
	TAD (1000	/'NOT-RESTARTABLE' BIT
	DCA I (7746
	JMP I (7605
SCAN,	0
	TAD (1000	/DOESN'T WORK WITH PS/8
	DCA INP

SCLP,	TAD I INP
	SNA
	JMP I SCAN	/NO SUCH OPTION
	TAD (-"/
	SNA CLA
	TAD I INP
	CIA
	TAD I SCAN
	SZA CLA
	JMP SCLP

	ISZ SCAN	/FOUND IT
	ISZ SCAN

EQLP,	TAD I INP	/LOOK FOR '='
	SZA
	TAD (-"/
	SNA
	JMP I SCAN	/NO '='
	TAD ("/-"=
	SZA CLA
	JMP EQLP

RDLP,	DCA WR1		/READ VALUE
	TAD I INP
	TAD (-"9-1
	STL IAC
	IAC
	SNL		/8 OR 9?
	ISZ WR1		/YES: ADD 8 MORE
	TAD C10		/CHECK FOR 0-9
	DCA TYPE
	SZL
	JMP DONE
	TAD WR1		/READ #
	RAL
	RTL
	TAD TYPE
	JMP RDLP
DONE,	TAD WR1		/EXIT WITH VALUE
	JMP I SCAN
REPLAC,	0
	AND M10		/KEEP '6XX0'
	CLL CIA
	DCA WR1
	TAD I REPLAC
	ISZ REPLAC
	AND C77
	SNA
	JMP I REPLAC	/NO PATCHES
	RAL
	RTL
	DCA TYPE	/SAVE NEW DEVICE CODE
	TAD M177
	DCA ERROR	/SET SCAN RANGE
	DCA SCAN

HUNT,	ISZ SCAN
	TAD I SCAN	/CHECK INSTR.
	TAD WR1
	AND M10
	SZA CLA		/MATCH?
	JMP BUMP
	TAD I SCAN	/FOUND ONE
	AND (7007
	TAD TYPE	/PUT IN NEW DVC
	DCA I SCAN
BUMP,	ISZ ERROR	/DONE?
	JMP HUNT
	JMP I REPLAC	/YES

BATERR,	TEXT "NOT UNDER BATCH!"

	PAGE
MKLB,	0
	TAD WR1+1
	AND M10
	TAD YMS		/FORCE '6XX6'
	DCA WR1+1
	JMS MVBR	/MOVE 'KL8E' BREAK ROUTINE
RELOC	BREAK+1
	ISZ WR1
	JMP .-2		/4096 'TTLS' INSTRUCTIONS
	JMS WR1
	TAD 177		/'CTRL/X'
	JMS WR1
	DCA .-1		/ONLY ONCE!
	TAD P177
	JMP TE5-2	/SEND A 'DELETE'
RELOC;	0
	ISZ INP		/SPECIAL BREAK?
	JMP I MKLB	/NO
	CMA CLL RTL	/-3
	JMS MVBR	/'6XX3' = 'SET BREAK'
	JMS WR1
	JMS WR1
	0
	TAD WR1+1	/'6XX6'
	IAC
	DCA BREAK+3	/'6XX7' = 'CLR BREAK'
	JMP I MKLB

MDSB,	0
	STA CLL RTL	/7775
	AND WR1+1	/FORCE '6XX4'
	DCA WR1+1
	CLA CMA		/SETUP 'TTSB' INSTR.
	JMS MVBR	/MOVE DECSTATION BREAK
	JMS WR1		/SEND A L-O-N-G NULL
	CLL IAC RTL	/4
	JMS WR1		/FILL BUFFER WITH ^D
C7310,	CLA CLL RAR
	TAD 177		/GET DESIRED BAUD RATE
	TTSB
	CLA CMA
	JMP CAN		/FINISH WITH A CTRL/X
	0
	TAD BREAK
	DCA BREAK+6
	JMP I MDSB
MVBR,	0		/INSTALL 'BREAK' ROUTINE
	TAD WR1+1
	DCA BREAK
	TAD C7310	/REMOVE ARROW FLAG
	DCA ARSW
	TAD WR1+1	/MOVE 'TTLS' INSTRUCTION
	DCA TE5-2
	TAD .-5
	DCA .+6
	TAD I MVBR
	ISZ MVBR
	SNA
	JMP I MVBR
	ISZ .+1
	HLT		/'DCA BREAK+1',+2,+3...
	JMP .-6

BRTBL,	-50		/BAUD RATE TABLE
	-75
	-110
	-134
	-150
	-300
	-600
	-1200
	-3000		/1800
	-2000
	-2400
	-3600
	-6000		/4800
	-7200
	-1601		/9600
	-1201		/19200
	0

BRERR,	TEXT "BAD SPEED OR BAUD RATE"
EQLERR,	TEXT "INPUT DVC = OUTPUT DVC"

WRLERR,	TEXT "WRITE ERROR ON LOAD DEV"

HELPER,	TEXT "ARROW,SPEED,I,O,N,D,VERS,PERM"

	$END$
