	SUBROUTINE ACOM(NN)
	COMMON ICHAR,IERCT,LINE,MSG
	DIMENSION MSG(80)
	N=NN
C WAIT FOR ? FROM SOL
10	CALL RCHAR
	IF(ICHAR-63)10,11,10
11	CONTINUE
	DO 20  I=1,N
	ITEM=MSG(I)
S	TAD \ITEM
S	RTR;RTR;RTR
S	DCA \ICHAR
S	TAD \ICHAR
S	AND MASK
S	DCA \ICHAR
	IF(ICHAR-32) 12,13,13
12	ICHAR=ICHAR+64
13	ICHR=ICHAR
	CALL SCHAR
	CALL RCHAR
	IF(ICHAR-ICHR)16,17,16
16	WRITE(1,1016) LINE,I
1016	FORMAT('ERROR IN LINE',I6,'   COLUMN',I4)
17	ICHAR=ITEM
20	CONTINUE
C  SEND RETURN
	ICHAR=141
	CALL SCHAR
	CALL RCHAR
C  WAIT FOR LINE FEED
	CALL RCHAR
S	TAD \ICHAR
S	AND (177
S	DCA \ICHAR
	IF(ICHAR-10) 27,22,27
22	RETURN
27	CALL IACTV
	STOP
SMASK,	77
	END
