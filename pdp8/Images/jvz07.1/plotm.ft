C	PLOTM.FT, A PROGRAM TO PLOT MOL WT OUTPUT FROM HISPD
C	NEEDS: SCALE,AXIS,PLOTER,PENUP,PENDN,PLOTX,PLOTO,PLOTP,
C  MOVE,AND ROUND SUBROUTINES
C	6/5/75   D.C.T.
C UPDATED 1/78 D.C.T.
	COMMON IDIS,AM
	DIMENSION C(400),AM(3,400)
	DIMENSION IXY(2,100)
	DIMENSION NPOIT(10),IDIS(2,2)
C
	CALL PENDN(20)
	IDIS(1,1)=0
	IDIS(2,1)=-250
	CALL DISP1(1,IDIS)
	READ(1,1000)NSET
1000	FORMAT(' TYPE # SETS IN FILE:'I2)
	READ(1,1302)CUT
1302	FORMAT(' CONCN CUTOFF (F3.1):'F3.1)
10	READ(1,1001)FMSG
1001	FORMAT(' INPUT TITLE:'A6)
	READ(1,1004)JNDIC
1004	FORMAT(' 3 PLOTS OR 1 ?:'I1)
	IF(JNDIC-1)2,2,3
2	READ(1,1200)XN
1200	FORMAT(' PLOT 2 M<N> - M<W>?'A6)
3	INDIC=1
4	L=0
	CALL IOPEN('DSK',FMSG)
	DO 30 II=1,NSET
	ICT=0
	READ(4,1002)NPOIT(II)
1002	FORMAT(I4)
	NPT=NPOIT(II)
	DO 15 I=1,NPT
	L=L+1
	ICT=ICT+1
	READ(4,1003)C(L),AM(1,L),AM(2,L),AM(3,L)
	IF(C(L)-CUT)12,13,13
12	L=L-1
	ICT=ICT-1
	GO TO 15
13	IF(C(L)-20.)15,15,14
14	L=L-1
	ICT=ICT-1
15	CONTINUE
	NPOIT(II)=ICT
1003	FORMAT(12XF7.3,3F9.0)
30	CONTINUE
	NTOT=L
C
C	FIND YMN,YMAX
C
	CMAX=0.
	YMIN=AM(1,1)
	YMAX=AM(1,1)
	DO 100 I=1,NTOT
	DO 50 II=1,3
	IF(AM(II,I)-YMIN)60,70,70
60	YMIN=AM(II,I)
70	IF(AM(II,I)-YMAX)50,50,80
80	YMAX=AM(II,I)
50	CONTINUE
	IF(C(I)-CMAX)100,100,90
90	CMAX=C(I)
100	CONTINUE
	XMIN=0.
	NVL=5
	XINC=.5
	XMAX=2.5
	IF(CMAX-2.5)107,107,89
89	XINC=1.
	XMAX=5.
	IF(CMAX-5.)107,107,101
101	XMAX=10.
	NVL=10
	IF(CMAX-10.)107,107,102
102	XMAX=20.
	NVL=20
	IF(CMAX-20.)107,107,103
103	CALL SCALE(XMIN,XMAX,XINC,NVL)
107	WRITE(1,2001)YMIN,YMAX
	WRITE(1,2000)XMAX
	CALL SCALE(YMIN,YMAX,YINC,NHL)
	WRITE(1,2001)YMIN,YMAX
2001	FORMAT(' MIN =',F9.0/' MAX =',F9.0)
2000	FORMAT(' C-MAX =',F5.1,' FRINGES')
	READ(1,1006)P
1006	FORMAT(' SET NEW VALUE?'A6)
	IF(P-'YES   ')295,300,295
295	IF(P-'Y     ')305,300,305
300	READ(1,1007)YMIN
1007	FORMAT(' YMIN (F9.0):'F9.0)
	READ(1,1011)YMAX
1011	FORMAT(' YMAX (F9.0):'F9.0)
	YINC=(YMAX-YMIN)/FLOAT(NHL)
305	WRITE(1,1008)YINC
1008	FORMAT(/'Y-AXIS INCREMENT =',F8.0/)
	READ(1,1006)P
	IF(P-'YES   ')310,315,310
310	IF(P-'Y     ')320,315,320
315	READ(1,1009)YINC
1009	FORMAT(' INCREMENT:',F6.0)
	NHL=(YMAX-YMIN)/YINC+0.5
320	YMULT=500./(YMAX-YMIN)
	XMULT=500./(XMAX)
	DO 110 I=1,NTOT
	C(I)=C(I)*XMULT
	DO 110 II=1,3
110	AM(II,I)=(AM(II,I)-YMIN)*YMULT-250.
	DO 200 K=1,3
	IF(K-1)210,215,210
210	IF(JNDIC-1)220,230,220
215	IDIS(1,1)=0
	IDIS(2,1)=-250
	CALL DISP1(1,IDIS)
	WRITE(1,1005)
S	HLT
	CALL AXIS(XMIN,XMAX,NVL,1)
	CALL AXIS(YMIN,YMAX,NHL,2)
	GO TO 230
220	WRITE(1,1005)
1005	FORMAT(' MOVE TO NEW LOC OR PAPER'/' PRESS CONT.')
	IDIS(1,2)=0
	IDIS(2,2)=-250
	CALL MOVE
	CALL PENDN(1000)
	CALL PENUP(100)
	CALL PENDN(100)
S	HLT
	CALL AXIS(XMIN,XMAX,NVL,1)
230	NSTOP=0
	DO 200 II=1,NSET
	NSTART=NSTOP+1
	NSTOP=NSTOP+NPOIT(II)
	J=0
	DO 120 I=NSTART,NSTOP
	J=J+1
120	IXY(1,J)=C(I)
	J=0
	DO 130 I=NSTART,NSTOP
	J=J+1
130	IXY(2,J)=AM(K,I)
	N=J
	CALL PLOTER(N,IXY,K)
200	CONTINUE
	IF(JNDIC-1)350,240,350
240	IF(XN-'Y     ')350,241,350
241	NSTOP=0
	DO 260 II=1,NSET
	NSTART=NSTOP+1
	NSTOP=NSTOP+NPOIT(II)
	J=0
	DO 250 I=NSTART,NSTOP
	J=J+1
	IXY(1,J)=C(I)
250	IXY(2,J)=2.*AM(1,I)-AM(2,I)
	N=J
	CALL PLOTER(N,IXY,3)
260	CONTINUE
350	IDIS(1,2)=0
	IDIS(2,2)=-250
	READ(1,1010)P
	CALL MOVE
1010	FORMAT(' BOX PLOT?',A6)
	IF(P-'YES   ')355,360,355
355	IF(P-'Y     ')380,360,380
360	WRITE(1,1005)
	IDIS(1,2)=0
	IDIS(2,2)=250
	CALL MOVE
	CALL PENDN(1000)
	CALL PENUP(100)
	CALL PENDN(100)
S	HLT
	CALL AXIS(XMIN,XMAX,NVL,3)
	IF(JNDIC-1)365,370,365
365	IDIS(1,2)=500
	IDIS(2,2)=-250
	CALL MOVE
	WRITE(1,1005)
	CALL PENDN(1000)
	CALL PENUP(100)
	CALL PENDN(100)
S	HLT
370	CALL AXIS(YMIN,YMAX,NHL,4)
380	CONTINUE
	END
