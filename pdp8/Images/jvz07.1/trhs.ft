	SUBROUTINE STEP(DXY,J)
	COMMON BR,DX,DY,IDIS
	COMMON IXY,IYY
	DIMENSION IXY(2,500),IYY(500),IDIS(2,2)
	D1=ABS(DXY)
	J1=J
 10	STEPS=D1-2000.0
	IF (STEPS) 20,20,30
 20	STEPS=D1
	MORE=0
	GOTO 40
 30	STEPS=2000.0
	D1=D1-2000.0
	MORE=1
 40	IF (DXY) 50,60,60
 50	IDIR=J1+1
	GOTO 70
 60	IDIR=J1+2
 70	ISTEP=IFIX(STEPS)
	CALL STAGE(ISTEP,IDIR)
	IF (MORE) 80,80,10
 80	RETURN
S	ENTRY RHS
SRHS,	BLOCK 2
	DX=0.0
	DY=0.0
 90	DO 100 I=1,250
S	CLA
S	TAD (D-107
SRHS0,	IAC
S	NOP
S	NOP
S	SPA
S	JMP RHS0
S	CLA CLL
 100	CONTINUE
S	CLL CLA CMA	/INITIALIZE
S	DCA SIGN
S	DCA HSW
S	DCA \IDIR
S	DCA STEPS
S	TAD (D-8
S	DCA CNT1
S	DCA CNT2
SRHS1,	TAD (K0400	/ADD IN SXL
S	DCA RHS2	/STORE INSTRUCTION
S	CMA		/
S	6141		/CHANGE TO LINC MODE
SRHS2,	0		/SENSE LINE N
S	0017		/COMPLEMENT ACC
S	0002		/RETURN TO 8 MODE
S	IAC
S	CLL
S	TAD HSW		/SET BIT CORRESPONDING TO HAND SW
S	RAL
S	DCA HSW
S	ISZ CNT1
S	JMP RHS3
S	JMP RHS4
SRHS3,	INC CNT2	/SET NEXT HAND SWITCH IN ACC
S	TAD CNT2
S	JMP RHS1
SRHS4,	TAD HSW
S	RTL;RTL
S	SZL		/DECODE HS 0 (+,-)
S	ISZ SIGN
S	NOP
S	RAL		/DECODE HS 1 (X,Y)
S	DCA HSW
S	SNL
S	TAD (D-2	/SET IDIR; 1=X;2=-X;3=Y;4=-Y
S	TAD (3
S	CLL		/ADDITION MAY CAUSE OVERFLOW
S	ISZ SIGN
S	IAC		/TAKE CARE OF SIGN
S	DCA \IDIR
S	TAD HSW		/DECODE HS 2 (1000 STEPS)
S	INC STEPS
S	RAL
S	SZL
S	JMP \110
S	INC STEPS
S	RAL		/DECODE HS 3 (100 STEPS)
S	SZL
S	JMP \110
S	INC STEPS
S	RAL		/DECODE HS 4 (10 STEPS)
S	SZL
S	JMP \110
S	INC STEPS
S	RAL		/DECODE HS 5 (1 STEP)
S	SZL
S	JMP \110
S	RAL		/DECODE HS 6 (RETURN FLAG SWITCH)
S	SNL
S	JMP \90		/RECHECK HAND SWITCHES
S	CLA CLL
S	RETRN RHS
SCNT1,	0
SCNT2,	0
SHSW,	0
SSIGN,	0
SSTEPS, 0
S	CPAGE 5
SSTEPP, STEPP
S	1750;144;12;1
S\110,	CLA CLL
S	TAD STEPP	/FETCH NUMBER OF STEPS
S	TAD STEPS
S	DCA STEPS
S	TAD I STEPS
S	DCA \NSTEPS
	IF (NSTEPS) 90,90,115
 115	CALL STAGE(NSTEPS,IDIR)
	STEPR=FLOAT(NSTEPS)
	IF (IDIR-1) 120,150,120
 120	IF (IDIR-2) 130,160,130
 130	IF (IDIR-3) 140,170,140
 140	IF (IDIR-4) 90 ,180,90
 150	DX=DX+STEPR
	GOTO 90
 160	DX=DX-STEPR
	GOTO 90
 170	DY=DY+STEPR
	GOTO 90
 180	DY=DY-STEPR
	GOTO 90
	END
