	SUBROUTINE PLOTLN(N,IXY)
C  PLOT LINES,NO SYMBOLS AT POINTS
C  NEEDS: PENUP,PENDN,MOVE
	COMMON IDIS
	DIMENSION IXY(2,200),IDIS(2,2)
C  MOVE TO FIRST POINT
	CALL PENUP(10)
	IDIS(1,2)=IXY(1,1)
	IDIS(2,2)=IXY(2,1)
	CALL MOVE
C  CHECK VALUES:
	DO 240 I=1,N
	IF(IXY(2,I)-250)220,220,210
210	IXY(2,I)=250
220	IF(IXY(2,I)+250)230,260,260
230	IXY(2,I)=-250
260	IF(IXY(1,I))265,270,270
265	IXY(1,I)=0
270	IF(IXY(1,I)-500)240,240,275
275	IXY(1,I)=500
240	CONTINUE
C	PUT 1 ST POINT INTO IDIS
	IDIS(1,1)=IXY(1,1)
	IDIS(2,1)=IXY(2,1)
	CALL DISP1(1,IDIS)
	DO 250 I=1,5
250	CALL PENUP(2000)
	CALL PENDN(2000)
C	
C	PRESUMABLY PEN IS NOW DOWN AND PLOTTER SET UP
C
290	DO 100 I=2,N
	K=I-1
	DX=IXY(1,I)-IXY(1,K)
	DY=IXY(2,I)-IXY(2,K)
	DIST=SQRT(DX*DX+DY*DY)
	NSTEP=DIST+.5
	IF(NSTEP-1)100,100,30
C IF NSTEP .LE. 1, DONT PLOT MULTIPLE POINTS
C30	CALL PENUP(500)
30	DO 50 J=1,NSTEP
	FX=FLOAT(J)/FLOAT(NSTEP)
	JX=FX*DX
	IDIS(1,1)=IXY(1,K)+JX
	JY=FX*DY
	IDIS(2,1)=IXY(2,K)+JY
	IBUFY=IDIS(2,1)
	DO 50 L=1,100
50	CALL DISP1(1,IDIS)
C	IF(IABS(IBUFY)-250)55,100,100
100	CONTINUE
	CALL PENUP(2000)
	RETURN
	END
