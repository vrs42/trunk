	SUBROUTINE PLOTX(IX,IY,IR)
C  PLOT X'S
C IR IS LENGTH OF ARM ON X
	DIMENSION IDIS(2,1)
C*******
	NDLAY=30
C**********
	DO 50 I=1,50
	IDIS(1,1)=IX
	IDIS(2,1)=IY
50	CALL DISP1(1,IDIS)
	CALL PENDN(500)
	ISIGN=1
	DO 60 JJ=1,2
	ISIGN=-ISIGN
	DO 60 L=1,IR
	IDIS(2,1)=IDIS(2,1)+ISIGN*L
	IDIS(1,1)=IDIS(1,1)-ISIGN*L
	DO 60 LL=1,NDLAY
	CALL DISP1(1,IDIS)
60	CONTINUE
	DO 70 JJ=1,2
	ISIGN=-ISIGN
	DO 70 L=1,IR
	IDIS(2,1)=IDIS(2,1)-ISIGN*L
	IDIS(1,1)=IDIS(1,1)+ISIGN*L
	DO 70 LL=1,NDLAY
	CALL DISP1(1,IDIS)
70	CONTINUE
	DO 80 JJ=1,2
	ISIGN=-ISIGN
	DO 80 L=1,IR
	IDIS(2,1)=IDIS(2,1)+ISIGN*L
	IDIS(1,1)=IDIS(1,1)+ISIGN*L
	DO 80 LL=1,NDLAY
	CALL DISP1(1,IDIS)
80	CONTINUE
	DO 90 JJ=1,2
	ISIGN=-ISIGN
	DO 90 L=1,IR
	IDIS(2,1)=IDIS(2,1)-ISIGN*L
	IDIS(1,1)=IDIS(1,1)-ISIGN*L
	DO 90 LL=1,NDLAY
	CALL DISP1(1,IDIS)
90	CONTINUE
	CALL PENUP(200)
	RETURN
	END
