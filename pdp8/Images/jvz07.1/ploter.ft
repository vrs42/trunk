	SUBROUTINE PLOTER(N,IXY,INDIC)
C	INDIC=1 PLOTS X'S
C	INDIC=2 PLOTS O'S
C	INDIC=3 PLOTS +'S
C  NEEDS: PLOTX,PLOTO,PLOTP,ROUND,PENUP,PENDN,MOVE
	COMMON IDIS
	DIMENSION IXY(2,100),IDIS(2,2)
C  MOVE TO FIRST POINT
	NPAUS=15
	CALL PENUP(10)
	IDIS(1,2)=IXY(1,1)
	IDIS(2,2)=IXY(2,1)
	CALL MOVE
C  CHECK VALUES:
	DO 240 I=1,N
	IF(IXY(2,I)-250)220,220,210
210	IXY(2,I)=250
220	IF(IXY(2,I)+250)230,240,240
230	IXY(2,I)=-250
240	CONTINUE
C	PUT 1 ST POINT INTO IDIS
	IDIS(1,1)=IXY(1,1)
	IDIS(2,1)=IXY(2,1)
	CALL DISP1(1,IDIS)
	DO 250 I=1,5
250	CALL PENUP(200)
	IX=IDIS(1,1)
	IY=IDIS(2,1)
	IF(IX)290,290,255
C X,O,+:
255	GO TO (260,270,280),INDIC
260	CALL PLOTX(IX,IY,3)
	GO TO 290
270	CALL PLOTO(IX,IY,4)
	GO TO 290
280	CALL PLOTP(IX,IY,3)
C	
C	PRESUMABLY PEN IS NOW DOWN AND PLOTTER SET UP
C
290	DO 100 I=2,N
	K=I-1
	DX=IXY(1,I)-IXY(1,K)
	DY=IXY(2,I)-IXY(2,K)
	DIST=SQRT(DX*DX+DY*DY)
	NSTEP=DIST+.5
	IF(NSTEP-1)100,100,30
C IF NSTEP .LE. 1, DONT PLOT MULTIPLE POINTS
30	CALL PENUP(200)
	DO 50 J=1,NSTEP
	FX=FLOAT(J)/FLOAT(NSTEP)
	JX=FX*DX
	IDIS(1,1)=IXY(1,K)+JX
	JY=FX*DY
	IDIS(2,1)=IXY(2,K)+JY
	IBUFY=IDIS(2,1)
	DO 50 L=1,NPAUS
50	CALL DISP1(1,IDIS)
	IF(IABS(IBUFY)-250)55,100,100
55	IX=IDIS(1,1)
	IY=IDIS(2,1)
	GO TO (56,57,58),INDIC
56	CALL PLOTX(IX,IY,3)
	GO TO 100
57	CALL PLOTO(IX,IY,4)
	GO TO 100
58	CALL PLOTP(IX,IY,3)
100	CONTINUE
	CALL PENUP(200)
	RETURN
	END
