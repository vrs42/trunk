	SUBROUTINE AXIS(ZMIN,ZMAX,NHL,IDIR)
C  GENERAL PURPOSE AXIS PLOTTING SUBROUTINE
C	NHL IS NUMBER OF PIPS
C	ZMAX AND ZMIN ARE FOUND BY MAINLINE
C	CAN BE ANY VALUES
C	IDIR IS DIRECTION:
C	IDIR	LINE	ORIGIN	PIP DIR.
C	1	HORIZ.	0,-250	 +VE Y
C	2	VERT	0,-250	 +VE X
C	3	HORIZ	0,250	 -VE Y
C	4	VERT	500,-250 -VE X
C
C  COME IN WITH IDIS(1,1),IDIS(2,1) OF PREVIOUS
C	VALUES
C  INITIAL CALL TO "MOVE" GOES TO ORIGIN OF THIS CALL
C
C  D.C.T.1/7/78
C
	COMMON IDIS
	DIMENSION IDIS(2,2)
C
C** SETUP
	NDLAY=30
	CALL PENUP(2000)
	GO TO (10,20,30,40),IDIR
10	ISIN=1
	M0=-250
	IT0=0
	ITOT=0
	IT=1
	IM=2
	GO TO 100
20	ISIN=1
	M0=0
	IT0=-250
	ITOT=-250
	IT=2
	IM=1
	GO TO 100
30	ISIN=-1
	M0=250
	IT0=0
	ITOT=0
	IT=1
	IM=2
	GO TO 100
40	ISIN=-1
	M0=500
	IT0=-250
	ITOT=-250
	IT=2
	IM=1
C** MOVE TO M0,IT0:
100	IDIS(IT,2)=ITOT
	IDIS(IM,2)=M0
	CALL MOVE
	CALL PENDN(200)
C** CALCULATE:
	ZMULT=500./(ZMAX-ZMIN)
	ZINC=(ZMAX-ZMIN)/FLOAT(NHL)
	ZOLD=ZMIN
	DO 250 JHL=1,NHL
	ZNEW=ZOLD+ZINC
	ICOUNT=ZMULT*(ZNEW-ZOLD)+.5
	ZOLD=ZNEW
C  MOVE PEN ICONT TIMES:
	DO 230 J=1,ICOUNT
	ITOT=ITOT+1
	IDIS(IT,1)=ITOT
	IDIS(IM,1)=M0
	DO 230 L=1,NDLAY
230	CALL DISP1(1,IDIS)
C  MAKE PIP
	M=M0
	DO 240 L=1,10
	M=M+ISIN
	DO 240 LL=1,5
	IDIS(IT,1)=ITOT
	IDIS(IM,1)=M
240	CALL DISP1(1,IDIS)
C  MOVE BACK
	DO 245 L=1,10
	M=M-ISIN
	DO 245 LL=1,5
	IDIS(IT,1)=ITOT
	IDIS(IM,1)=M
245	CALL DISP1(1,IDIS)
C PAUSE:
	DO 250 L=1,NDLAY
250	CALL DISP1(1,IDIS)
C  MOVE BACK TO ORIGIN:
	CALL PENUP(200)
	IDIS(IT,2)=IT0
	IDIS(IM,2)=M0
	CALL MOVE
	RETURN
	END
