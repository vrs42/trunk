	SUBROUTINE SCALE(ZMIN,ZMAX,ZINC,NHL)
C  GENERAL PURPOSE SCALING ROUTINE
C	NHL IS 10 OR 20
C	ZINC IS 1,2,2.5,4,OR 5 MAGNITUDES
C	ZMIN AND ZMAX ARE MODIFIED TO GET "PLEASANT" VALUES
C  D.C.T. 1/6/78
C
	DIMENSION ALLOW(15)
C** GET 0, NEGATIVE VALUES:
	ZCST=0.
C  NEXT 2 STATEMENTS ARE SETUP FOR ZMIN=0:
	MINA=-3
	ZMAG=.001
	FCT=ALOG(10.)
	IF(ZMIN)110,130,120
110	ZCST=1.-ZMIN
	ZMIN=1.
	ZMAX=ZMAX+ZCST
C** GET ROUNDED ZMIN,ZMAG:
120	AMIN=ALOG(ZMIN)/FCT
	MINA=AMIN-1.
	AMIN=AMIN-FLOAT(MINA)
	MINZ=EXP(FCT*AMIN)
	ZMAG=10.**MINA
	ZMIN=ZMAG*FLOAT(MINZ)
C** GET ROUNDED ZMAX:
130	AMAX=ALOG(ZMAX)/FCT
	MAXA=AMAX-1.
C  CHECK THAT MAXA AND MINA DIFFER BY LT 2 ORDERS OF MAG:
C  THIS SHOULD GET FORCED BY MINA = -3 IF ZMIN=0
	IF(MAXA-MINA-2)20,10,10
10	MINA=MAXA
	ZMAG=10.**MINA
20	AMAX=AMAX-FLOAT(MINA)
C  ?CHECK THAT ZMAX/ZMAG LT 2047? HERE IF NEEDED
	MAXZ=EXP(FCT*AMAX)+1.
	ZMAX=ZMAG*FLOAT(MAXZ)
C** NOW GET # OF PIPS:
	NHL=10
	HL=10.
	ZINC=(ZMAX-ZMIN)/(HL*ZMAG)
C  TRUNCATE AND CHECK RANGE
	INCZ=ALOG(ZINC)/FCT
	IF(INCZ-1)40,30,10
30	NHL=20
	HL=20.
	ZINC=ZINC/2.
C** GET ROUNDED AND ALLOWED ZINC:
C  NEXT COVERS DATA RANGE FROM ZINC = 0.1 TO 50
C  IF VALUES OF ZMIN, ZMAX ARE "UNPLEASANT" CHANGE RANGE.
40	ALLOW(1)=1.
	ALLOW(2)=2.
	ALLOW(3)=2.5
	ALLOW(4)=4.
	ALLOW(5)=5.
	DO 50 I=1,5
	ALLOW(I)=0.1*ALLOW(I)
	ALLOW(I+5)=10.*ALLOW(I)
50	ALLOW(I+10)=100.*ALLOW(I)
	DO 60 I=1,15
	SINC=ALLOW(I)
	IF(ZINC-ALLOW(I))70,70,60
60	CONTINUE
70	ZINC=SINC*ZMAG
C** GET "PLEASANT" VALUES OF ZMIN,ZMAX:
	MINZ=ZMIN/ZINC
	ZMIN=ZINC*FLOAT(MINZ)
	ZMAX=HL*ZINC+ZMIN
C** RESTORE SCALE FOR NEGATIVE VALUES:
	IF(ZCST)100,100,80
80	ACST=ZCST-1.
	IF(ACST)90,90,85
C  TREAT ACST LIKE ZMAX:
85	AMAX=ALOG(ACST)/FCT
	AMAX=AMAX-FLOAT(MINA)
	MAXZ=EXP(FCT*AMAX)+1.
	ZCST=ZMAG*FLOAT(MAXZ)+1.
90	ZMIN=ZMIN-ZCST
	ZMAX=ZMAX-ZCST
100	RETURN
	END
