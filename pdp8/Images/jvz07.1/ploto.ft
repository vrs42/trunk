	SUBROUTINE PLOTO(IX,IY,IR)
C  PLOT CIRCLES, O
C  DISPLAYS CIRCLE CENTERED AT (IX,IY) WITH RADIUS IR
C  MAX IR PRESENTLY 4; IR AND NN4 DET. JXY DIM.
C  IF IR EQ PREV IR, SETUP IS BYPASSED
C**NEEDS ROUND.FT FUNCTION
C
	COMMON IDIS
	DIMENSION JXY(2,30),IDIS(2,2)
	NDLAY=20
	IF(IR-IRP)4,30,4
4	IRP=IR
	R=FLOAT(IR)
	R2=R**2
	N=IR+3
	NN2=2*N
	NN4=4*N
	NT=NN4+1
C  CALC Y FOR X:  (0, 0.33, 0.67, 1.0, 1.33)-R
	X=-R
	DO 15  I=1,5
	Y=SQRT(R2-X**2)
	JXY(1,I)=ROUND(X)
	JXY(2,I)=ROUND(Y)
	X=X+0.333333
15	CONTINUE
C  CALC Y FOR X=(2,N)-R
	X=1.-R
	DO 19  I=6,N
	X=X+1.
	Y=SQRT(R2-X**2)
	JXY(1,I)=X
	JXY(2,I)=ROUND(Y)
19	CONTINUE
C  CALC OTHER QUADRANTS
	DO 29  I=1,N
	JXY(1,NN4-I+1)=JXY(1,I)
	JXY(2,NN4-I+1)=-JXY(2,I)
	JXY(1,NN2-I+1)=-JXY(1,I)
	JXY(2,NN2-I+1)=JXY(2,I)
	JXY(1,NN2+I)=-JXY(1,I)
	JXY(2,NN2+I)=-JXY(2,I)
29	CONTINUE
	JXY(1,NT)=JXY(1,1)
	JXY(2,NT)=JXY(2,1)
C
30	DO 60 I=1,NDLAY
	IDIS(1,1)=JXY(1,1)+IX
	IDIS(2,1)=JXY(2,1)+IY
60	CALL DISP1(1,IDIS)
	CALL PENDN(200)
	DO 70  I=1,NT
	IDIS(1,1)=JXY(1,I)+IX
	IDIS(2,1)=JXY(2,I)+IY
	CALL DISP1(1,IDIS)
	DO 70 J=1,NDLAY
70	CALL DISP1(1,IDIS)
	CALL PENUP(100)
	DO 80 I=1,NDLAY
	IDIS(1,1)=IX
	IDIS(2,1)=IY
80	CALL DISP1(1,IDIS)
	RETURN
	END
