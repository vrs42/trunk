C  PLOTSV.FT = PROGRAM TO PLOT C VS X AND DC/DX VS X FROM SEDIMENTATION 
C VELOCITY RUNS.
C	NEEDS: SCALE,AXIS,PLOTLN,PENUP,PENDN,MOVE SUBROUTINES
C  CREATED BY MODIFICATION OF PLOTM 17-DEC-80  D.C.T.
C  PLOTS C VS R AND DC/DR VS R ON SAME GRAPH
C  USES OUTPUT FROM EPROG.LD AS INPUT
C
	COMMON IDIS,X,C,D
	DIMENSION X(200),C(200),D(200)
	DIMENSION IXY(2,200)
	DIMENSION IDIS(2,2)
C
	CALL PENDN(20)
	IDIS(1,1)=0
	IDIS(2,1)=-250
	CALL DISP1(1,IDIS)
	READ(1,1000)NSET
1000	FORMAT('TYPE # DATA SETS IN FILE:'I2)
10	READ(1,1001)FMSG
1001	FORMAT('INPUT TITLE:'A6)
	CALL IOPEN('DSK',FMSG)
	DO 30 IJK=1,NSET
	READ(4,1002)NPOIT
1002	FORMAT(I4)
	READ(4,1011)DUM
1011	FORMAT(F6.0)
	DO 15 I=1,NPOIT
	READ(4,1003)X(I),C(I),D(I)
15	CONTINUE
C   1 5.8850  0.00  12.9
1003	FORMAT(4X,F7.4,F6.2,F6.1)
C
C	FIND YMN,YMAX
C
	XMAX=7.2
	NVL=28
	XMIN=5.80
	XINC=.05
	YMIN=C(1)
	DMIN=D(1)
	YMAX=C(1)
	DMAX=D(1)
	DO 50 I=1,NPOIT
	IF(C(I)-YMIN)60,65,65
60	YMIN=C(I)
65	IF(D(I)-DMIN)67,70,70
67	DMIN=D(I)
70	IF(C(I)-YMAX)80,80,75
75	YMAX=C(I)
80	IF(D(I)-DMAX)50,50,78
78	DMAX=D(I)
50	CONTINUE
C103	CALL SCALE(XMIN,XMAX,XINC,NVL)
107	WRITE(1,2001)YMIN,YMAX
	CALL SCALE(YMIN,YMAX,YINC,NHL)
	WRITE(1,1999)
1999	FORMAT(/' CONCENTRATION')
	WRITE(1,2001)YMIN,YMAX
2001	FORMAT(' MIN =',F9.2/'MAX =',F9.2)
	READ(1,1006)P
1006	FORMAT('SET NEW VALUE?'A6)
	IF(P-'YES   ')295,300,295
295	IF(P-'Y     ')305,300,305
300	READ(1,1007)YMIN,YMAX
1007	FORMAT('YMIN, YMAX (2F4.1):'2F4.1)
	YINC=(YMAX-YMIN)/FLOAT(NHL)
305	WRITE(1,1008)YINC
1008	FORMAT(/'Y-AXIS INCREMENT =',F8.0/)
	READ(1,1006)P
	IF(P-'YES   ')310,315,310
310	IF(P-'Y     ')320,315,320
315	READ(1,1009)YINC
1009	FORMAT(' INCREMENT:',F6.0)
	NHL=(YMAX-YMIN)/YINC+0.5
320	YMULT=500./(YMAX-YMIN)
C*****8*****************88
	CALL SCALE(DMIN,DMAX,DINC,NDL)
	WRITE(1,1998)
1998	FORMAT(/' DERIVATIVE')
	WRITE(1,2001)DMIN,DMAX
	READ(1,1006)P
	IF(P-'YES   ')395,400,395
395	IF(P-'Y     ')405,400,405
400	READ(1,1012)DMIN,DMAX
1012	FORMAT('DMIN, DMAX (2F4.1):'2F4.1)
	DINC=(DMAX-DMIN)/FLOAT(NDL)
405	WRITE(1,1008)DINC
	READ(1,1006)P
	IF(P-'YES   ')410,415,410
410	IF(P-'Y     ')420,415,420
415	READ(1,1009)DINC
	NDL=(DMAX-DMIN)/DINC+0.5
420	DMULT=500./(DMAX-DMIN)
C*****************************
	XMULT=500./(XMAX-XMIN)
	DO 110 I=1,NPOIT
	X(I)=(X(I)-XMIN)*XMULT
	D(I)=(D(I)-DMIN)*DMULT-250.
110	C(I)=(C(I)-YMIN)*YMULT-250.
C*****************************
	IDIS(1,1)=0
	IDIS(2,1)=-250
	CALL DISP1(1,IDIS)
	WRITE(1,1005)
S	HLT
	CALL AXIS(XMIN,XMAX,NVL,1)
	CALL AXIS(YMIN,YMAX,NHL,2)
	CALL AXIS(DMIN,DMAX,NDL,4)
1005	FORMAT('MOVE TO NEW LOC OR PAPER'/'PRESS CONT.')
	IDIS(1,2)=0
	IDIS(2,2)=-250
	CALL MOVE
	CALL PENDN(1000)
	CALL PENUP(100)
	CALL PENDN(100)
	DO 120 I=1,NPOIT
	IXY(2,I)=C(I)
120	IXY(1,I)=X(I)
C**************************
	CALL PLOTLN(NPOIT,IXY)
C**************************
	DO 250 I=1,NPOIT
250	IXY(2,I)=D(I)
	CALL PLOTLN(NPOIT,IXY)
350	IDIS(1,2)=0
	IDIS(2,2)=+250
	CALL MOVE
	CALL AXIS(XMIN,XMAX,NVL,3)
30	CONTINUE
	END
