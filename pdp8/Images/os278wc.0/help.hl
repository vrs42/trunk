&DEVICE
FILE NAME LOGICAL DEVICE     COMMENTS

TTY   .HN TTY		Console terminal handler
BAT   .HN BAT		Batch handler
LPTS  .HN LPT		Serial line printer handler
COMM  .HN COMM		Communication handler for DECmate II
COM0  .HN COM0		Communication handler for DECmate I port 0
COM1  .HN COM1		Communication handler for DECmate I port 1
RX02SY.HN SYS		RX02 system handler
RX01SY.HN SYS		RX01 system handler
RX2A  .HN RX20, RX21	RX02 non-system handler for drive pair A
RX2B  .HN RX22, RX23	RX02 non-system handler for drive pair B
RX50SY.HN SYS		RX50 system handler
RX5A  .HN RX50, RX51	RX50 non-system handler for drive pair A
RX5B  .HN RX52, RX53	RX50 non-system handler for drive pair B
RD51SY.HN SYS		RD51 system handler
RD5A  .HN RD50, RD51	RD51 non-system handler
RD5B  .HN RD52, RD53	RD51 non-system handler
RL01SY.HN SYS		RL01 system handler
RL0   .HN RL0A, RL0B	RL01passes (twice as slow)
	/P	Disable pass 1 listing (needs $ at end of source)
	/U	Disable pass 1 listing and PAL symbol table
	/X	Do not process literals

