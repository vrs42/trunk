	DIMENSION RDATA(30)
	DO 10 I=1,30
	READ(5,100)
100	FORMAT(F10.2)
10	CONTINUE
	CALL INITT(30)
	CALL TWINDO(100,900,100,600)
	CALL DWINDO(10,100,10,100)
	CALL POLTRN(10,100,0)
	CALL GRID
	CALL MOVEA(RDATA(1),10)
	DO 20 I=1,30
	DEGREE=10+I*3
20	CALL DASHSA(RDATA(I),DEGREE,12)
	CALL FINITT(0,0)
	STOP
	END
