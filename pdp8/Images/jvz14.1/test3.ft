	DIMENSION RDATA(30)
	DATA RDATA /90.3,92.4,94.5,95.2,96.1,96.9,98.2,98.7,99.1,99.4,
     1	99.7,100.0,99.5,99.0,98.5,98.0,97.5,97.0,96.5,96.0,95.5,95.0,
     2	94.5,94.0,93.5,93.0,92.1,92.0,90.5,90.0/
	CALL INITT(30)
	CALL TWINDO(100,900,100,600)
	CALL DWINDO(90.,100.,10.,100.)
	CALL DWINDO(90,100,10,100)
	CALL POLTRN(0,180,90)
	CALL GRID
	CALL MOVEA(RDATA(1),10)
	DO 10 I=1,30
	DEGREE=10+I*3
10	CALL DASHSA(RDATA(I),DEGREE,12)
	CALL FINITT(0,0)
	STOP
	END
