/ADEOUT - SEND AN ARRAY OF ADE CHARACTERS TO THE TERMINAL
/	PART OF THE TERMINAL CONTROL SYSTEM TO DRIVE TEK 4006
/
/SUBROUTINE CALL: CALL ADEOUT(NCHAR,IARAY)
/			WHERE:
/				NCHAR=NUMBER OF CHARACTERS IN IARAY
/				IARAY=ARRAY OF CHARACTERS (SIX BIT )
/
/SHADOW JULY 3,1978
/
/
/
	SECT	ADEOUT		/SECTION NAME
	JA	#ADEOT		/JUMP TO START OF ROUTINE
	TEXT	+ADEOUT+	/FOR ERROR TRACE BACK
ADEXR,	SETX	XRADE		/SET INDEX REGISTERS
	SETB	BPADE		/ASIGN BASE PAGE
BPADE,	F 0.0			/BASE PAGE
XRADE,	F 0.0			/INDEX REGS.
ADEX,	F 0.0			/TEMP STORAGE
NCHAR,	F 0.0
IARAY,	F 0.0
	ORG 10*3+BPADE		/RETURN SEQUENCE
	FNOP
	JA	ADEXR
	0
ADERTN,	JA	.		/EXIT
	EXTERN	#ARGER
ADEER,	TRAP4	#ARGER		/PRINT AN ERROR MESSAGE
	FCLA			/EXIT WITH FAC=0
	JA	ADERTN
	BASE	0		/STAY ON CALLER'S BASE PAGE
				/LONG ENOUGH TO GET RETURN ADDRESS
#ADEOT,	STARTD		/START OF ADEOUT
	FLDA	10*3		/GET RETURN JUMP
	FSTA	ADERTN		/STORE IN THIS SUBROUTINE
	FLDA	0		/GET POINTER TO PASSED ARG
	SETX	XRADE		/ASSIGN ADE'S INDEX REGS
	SETB	BPADE		/AND ITS BASE PAGE
	BASE	BPADE
	LDX	1,1
	FSTA	BPADE
	FLDA%	BPADE,1
	FSTA	NCHAR		/ADDRESS OF NCHAR
	FLDA%	BPADE,1+
	FSTA	IARAY		/ADDRESS OF IARAY
	STARTF
	FLDA%	NCHAR		/GET NCHAR
	JEQ	ADEER		/IF NCHAR=0......ERROR.....
	FNEG			/MINUS OF CHARATERS TO SEND
	ATX	1		/STORE IN X REG ONE [COUNTER]
	FCLA			/FAC=0
	LDX	-1,2		/SET INDEX REG TO -1
FTCHLP,	FCLA			/CLEAR FAC
	FLDA%	IARAY,2+		/GET A TSC CHARACTER
	ATX	3		/STORE IN A REG FOR PASSING
				/TO PAL8 ROUTINE
	TRAP4	#ADESND		/CALL PAL8 TX ROUTINE
	JXN	FTCHLP,1+	/FALL THROUGH IF ZERO
	JA	ADERTN		/RETURN TO CALLER
SECT8 ADESND
	ORG	.+200	/NOT ON PAGE ZERO PLEASE

#ADESND,	0
	TAD	XXRADE		/GET FIELD OUT CHARACTER IS IN
	RAL
	RTL
	TAD	CDF		/GENERATE A CDF
	DCA	.+1		/EXECUTE IT AS NEXT INSTRUCTION
	HLT			/CDF TO XREG 3
	IOF
	TAD%	XXRADE+1	/GET THE CHARACTER
	TPC			/SEND IT TO THE TERMINAL
	TSF			/WAIT TILL WE PRINT
	JMP .-1			/WAIT WAIT WAIT
	ION
	CLA CLL			/RETURN WITH A CLEARED AC
	CIF CDF 00		/RETURN TO CALLER (TRAP4)
	JMP%	#ADESND		/BYE BYE
XXRADE,	ADDR	XRADE+3	/OUR WAY TO GET TO X REG THREE
CDF,	6201			/CDF 
