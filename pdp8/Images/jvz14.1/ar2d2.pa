
	ACL=7701
	CAM=7621
	RPCI=6700
	WPCI=6701
	RDSTAT=6710
	SKPTIM=6713
	WMC=6711
	CFLAG1=6707
	WCRA=6705
	WCRB=6715
	
	ND1DIG=6517
	ND2DIG=6515
	ND3DIG=6513
	ND1EXT=6516
	ND2EXT=6514
	ND3EXT=6512

	*7776
BEGIN,	0200
	JMP I BEGIN
	*15
AUTO15,	0000
AUTO16,	0000
AUTO17,	0000
	*100
HOLD,	0000
COUNT,	0000
	*200
CSDIAG,	JMS CSINIT
	JMS TSTCLK
	JMS MOTION
GO,	JMS I (CASSET		/EXECUTE
FUNCT,	4100			/HOW
CORE,	0210			/START MEM LOCATION
BLOCK,	0001			/START TAPE LOCATION
BAD,	JMP CODEF4		/OOPS!
GOOD,	JMS NXTBLK		/CHANGE PARAM FOR NEXT BLOCK
	CLA CLL
	TAD FUNCT
	RAL			/R/W BIT INTO LINK
	SNL			/IS IT SET?
	JMP COMPAR		/NO, GO CHECK FOR ERRORS
	CLA CLL			/YES, SET UP FOR READ
	TAD (0110		/CASSETTE INTO MEMORY
	DCA FUNCT		/FIELD 1
	TAD (0210
	DCA CORE		/CORE = 210
	IAC
	DCA BLOCK		/BLOCK = 0001
	TAD ( JMP CODEF5	/GET INSTRUCTION
	DCA BAD			/CHANGE ERROR CODE JUMP
	JMP GO			/GO READ CASSETTE

ADDR,	1400			/[CRA] TO ACCESS SYNC REG
	0253			/[SYNC]
	4400			/[CRA] TO ACCESS MODE REG
	0214			/[MODE]
	5400			/[CRA] TO ACCESS COMMAND REG
	0100			/[COMMAND]
	0000			/END OF TABLE FLAG

CSINIT,	0000
	CLA CLL			/DUMP TRASH
	TAD (ADDR-1		/GET ADDRESS OF TABLE
	DCA AUTO17		/LOAD AUTO INDEX REG 17
	WCRB			/CRB = 0000
	TAD I AUTO17		/GET ACCESS CODE
	WCRA
	CLA CLL
	TAD I AUTO17		/GET SYNC CHAR
	WPCI
LOOP,	CLA CLL
	TAD I AUTO17		/GET ACCESS CODE
	SNA			/ARE WE DONE?
	JMP I CSINIT		/YES,RETURN
	WCRA			/NO, ACCESS REGISTER SET
	MQL			/SAVE CRA IN CASE OF ERROR
	TAD I AUTO17		/FETCH WORD TO GO INTO REGISTER
	WPCI			/LOAD REGISTER
	WPCI			/KEEP LOADING
	CMA IAC			/TAKE NEGATIVE OF REG VALUE
	DCA HOLD		/SAVE IT
	CFLAG1			/READ ENABLE PCI
	RPCI			/READ BACK REGISTER
	TAD HOLD		/SUBTRACT WHAT WAS WRITTEN IN
	SNA			/DO THEY MATCH?
	JMP LOOP		/YES, GO LOAD NEXT REGISTER SET
	JMP CODEF1		/NO, GET CODE & GO TO ERROR ROUTINE
TSTCLK,	0000
	CAM			/CLR AC&MQ
	SKPTIM			/RESET TIME SENSE LINE
	NOP
	TAD (7400		/GET COUNTER VALUE
	DCA COUNT		/STORE IT, WE ARE GOING TO DELAY
				/ABOUT 3.3 MS
	ISZ COUNT		/INCREMENT, ARE WE DONE?
	JMP .-1			/NO
	SKPTIM			/YES, DID TIME FF SET?
	JMP CODEF3		/NO, IT SHOULD HAVE
	JMP I TSTCLK		/YES, RETURN TO CALLER

CASSET,	0000			/DUMMY CASSETTE HANDLER
	CLA CLL
	TAD (6735		/CODE FOR AAA
	JMP I (ERROR		/DISPLAY AAA

	*400
MOTION,	0000
	CLA CLL
	RDSTAT		/GET STATUS
	AND (0200	/GET CLR LEADER BIT
	SNA		/IS IT SET?
	JMP CODEF2	/NO, IT SHOULD 'A BEEN
	CLA CLL IAC	/YES, AC = 0001
	WMC		/START TAPE IN MOTION
	CLA CLL
	TAD (2000	/GET READY TO DELAY APPROX 3 SEC
	JMS DELAY	/DELAY
	CLA CLL
	WMC		/STOP MOTOR
	RDSTAT		/GET STATUS
	AND (0200	/GET CLR LEADER BIT
	SNA		/HAS LEADER PASSED?
	JMP I MOTION	/YES, ALL IS WELL, RETURN TO CALLER
	CLA CLL		/NO, TAPE IS STILL ON LEADER
	TAD (5707	/GET CODE FOR FAILURE
	JMP ERROR	/CURSES FOILED AGAIN!

CODEF1,	CLA CLL		/MQ HAS CRA IN IT
	TAD (5701	/GET ERROR CODE
	JMP ERROR

CODEF2, TAD (5702	/GET CODE FOR FAILURE
	JMP ERROR	/GO

CODEF3,	MQL		
	TAD (5703
	JMP ERROR

CODEF4,	MQL
	TAD (5704
	JMP ERROR

CODEF5,	MQL
	TAD (5705
	JMP ERROR

CODEF6,	MQL
	TAD (7506
	JMP ERROR

DELAY,	0000
	CMA		/GET # OF TICKS READY FOR DECR
TICK,	SKPTIM		/SO WE CAN SYNC W/ TIMER FIRST TIME
	JMP .-1		/WAIT TILL IT BONGS
	IAC		/INC AC
	SPA		/TEST FOR POS AC
	JMP TICK	/WAIT FOR ANOTHER TICK
	JMP I DELAY	/RETURN TO CALLER

NXTBLK,	0000
	CLA CLL
	TAD CORE	/GET PRESENT CORE ADDRESS
	TAD (0200	/INCREMENT TO NEXT PAGE
	DCA CORE	/STORE
	ISZ BLOCK	/INCREMENT BLOCK NUMBER,IT
			/SHOULD NEVER SKIP
	TAD BLOCK	/GET BLOCK NUMBER
	TAD (-10	/SUBTRACT 10
	SPA		/WAS BLOCK < 10
	JMP GO		/YES, DO NEXT BLOCK
	JMP I NXTBLK	/NO, END OF BLOCK XFER, RETURN

COMPAR,	CLA CLL
	TAD (0207	/GET STARTING ADDRESS - 1
	MQL		/KEEP IT HANDY
	ACL		/GET IT BACK
	DCA AUTO17	/SET UP AUTO INDEX REGISTERS
	ACL		/ECT
	DCA AUTO16
	ACL
	DCA AUTO15
NEXT,	CDF 1		/ACCESS FIELD 1
	TAD I AUTO17	/GET CONTENTS OF FIELD 1 LOCATION
	CDF 0		/ACCESS FIELD 0
	CMA IAC		/CONVERT TO NEGATIVE NUMBER
	TAD I AUTO16	/ADD TO CONTENTS OF FIELD 0 LOCATION
	SZA		/WERE THEY EQUAL?
	JMP CODEF6	/NO, GO SET ERROR CODE
	TAD AUTO15	/GET COUNTER VALUE
	TAD (-2070	/SUBTRACT ENDING ADDRESS
	SPA		/ARE WE DONE?
	JMP NEXT	/NO, CONTINUE
	CLA CLL		/YES, NO ERROR CODE
	TAD (6735	/GET CODE FOR GOOD PASS (DISP=AAA)

ERROR,	ND1DIG		/ERROR CODE TO DISP 1
	SWP		/GET FLAGS
	ND2DIG		/FLAGS TO DISP 2
	CLA CLL
	ND3DIG		/CLEAR ALL OTHER DISP'S
	ND1EXT
	ND2EXT
	ND3EXT
	HLT


