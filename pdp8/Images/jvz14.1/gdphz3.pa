	*400
/ ROUTINE TO ADD AN INTEGER TO A DOUBLE PRECISION INTEGER
/
	DBLADD,	0
		DCA DBL1	/STORE ADDER
		TAD I DBLADD	/GET ADDRESS OF HIGH ORDER OF ADDEND
		DCA DHI		/STORE ADDRESS OF HIGH ORDER OF ADDEND
		IAC		/GET ADDRESS OF LOW ORDER OF ADDEND
		TAD DHI
		DCA DLOW	/STORE ADDRESS OF LOW ORDER OF ADDEND
		ISZ DBLADD	/INCREMENT RETURN ADDRESS
		TAD DBL1	/GET ADDER
		SMA		/IS IT NEGATIVE?
		JMP DB11	/NO
		MQL		/YES, PUT IN MQR
		CLA CMA		/EXTEND MINUS SIGN
		SKP		/SKIP IF NEGATIVE
	DB11,	MQL		/IF ADDER IS POSITIVE, PUT IN MQR
		CLL		/CLEAR GARBAGE FROM LINK
		SWP		/PUT ADDER BACK IN ACC.
		TAD I DLOW	/ADD TO LOW ORDER OF ADDEND
		DCA I DLOW	/STORE IN LOW ORDER OF ADDEND
		SWP		/USELESS INSTRUCTION
		SZL		/IS THERE FOR OVERFLOW?
		IAC		/YES, INCREMENT HIGH ORDER OF ADDEND
		TAD I DHI
		DCA I DHI	/STORE IN HIGH ORDER OF ADDEND
		JMP I DBLADD	/RETURN FROM ROUTINE
	DBL1,	0		/ADDER
	DHI,	0		/ADDRESS OF HIGH ORDER OF ADDEND
	DLOW,	0		/ADDRESS OF LOW ORDER OF ADDEND
	/
	DBLFLT, 0	/ FLOAT A DBL PREC INTEGER
		TAD I DBLFLT	/GET ADDRESS OF DBL PREC INTEGER
		DCA DBL4	/STORE ADDRESS OF DBL PREC INTEGER
		ISZ DBLFLT	/INCREMENT RETURN ADDRESS
		TAD (27		/GET LARGEST POSSIBLE EXPONENT
		DCA 44		/STORE IN FPP ACC.
		TAD CDF12	/USE APPROPRIATE CDF INSTRUCTION
		DCA .+1
		CDF 10
		TAD I DBL4	/GET LOW ORDER DBL PREC INTEGER
		DCA 46		/PUT IN FPP ACC.
		ISZ DBL4
		TAD I DBL4	/GET HIGH ORDER OF DBL PREC INTEGER
		DCA 45		/PUT IN FPP ACC
		CDF 00		/CHANGE BACK TO FIELD 0
		JMS I (FNORLX	/NORMALIZE INTEGER IN FPP ACC
		JMP I DBLFLT	/RETURN FROM ROUTINE
	DBL4,	0		/ADDRESS OF DBL PREC INTEGER
