		JMS I BINCD	/FROM BCD TO BINARY
		ND1DIG		/PUT PROGRAM # IN DISP. 1
		CLA CLL		/CLEAR PROG # FROM ACC
		TAD SELECT	/DETERMINE WHICH PROGRAM
		TAD PROGL	/ADD TO PROGRAM TABLE
		DCA PNAME	/SAVE ADDR. OF ADDR OF PROGRAM
		TAD I PNAME	/GET ADDR OF PROG
		DCA PNAME	/ SAVE IN JUMP ADDRESS
		JMP I PNAME	/JUMP TO SELECTED PROGRAM
	PNAME,	0		/ ADDR OF PROGRM TO BE EXECUTED
	PROGL,	.+1		/PROGRAM TABLE
		177		/OLD BATTERY CHARGE CHECK PROGRAM
		DVM0		/CHANNEL 1 DVM PROGRAM     
		DVM0A   	/CHANNEL 2 DVM PROGRAM
		PHASSE		/PHASE DOMAIN PROGRAM
		PHZ60		/PHASE DOMAIN WITH 60HZ NOTCH
		177		/
		177		/RESTART ON INVALID
		177		/SELECT SWITCH
		177		/
		177		/
	/
	/-------     ------ ABOVE CODE WILL EXECUTE PROGRAMS
	/-------     ------ "SELECTED" BY THE SELECT SWITCH
/
