/--------ROUTINE TO COMPUTE 2^N--------/
/THIS ROUTINE WILL LIMIT 2^N TO A MAXIMUM 
/OF 2047.  THAT IS 2^11 OR HIGHER WILL 
/RETURN A 2047 FROM THIS ROUTINE
	PWR2,	0
		SPA SNA		/IS EXPONENT > 0?
		JMP PW2		/NO
		CIA		/YES, NEGATE
		DCA PW1		/SAVE FOR COUNTER
		TAD PW1		/CHECK FOR EXPONENT
		TAD (13		/BEING 11 OR LARGER
		SPA SNA CLA	/SKIP ON N<11
		JMP X2047	/SET TO A MAX OF 2047
		IAC		/SET ACC = 1
		CLL RAL		/MULTIPLY BY 2
		ISZ PW1		/RAISE ANOTHER POWER?
		JMP .-2		/YES
		JMP I PWR2	/NO, RETURN FROM ROUTINE
	PW2,	SMA CLA		/IS EXPONENT = 0?
		SKP		/YES
		JMP I PWR2	/NO, EXPONENT NEGATIVE, RETURN
		IAC		/SET ACC = 1
		JMP I PWR2	/RETURN FROM ROUTINE
	X2047,	TAD K2047	/SET AC = 2047
		JMP I PWR2	/RETURN
	K2047,	3777		/CONSTANT 2047
	PW1,	0		/NEGATED POWER OF 2
	/
	/
	CLEAR,	0		/ ZERO'S TO D.F. 1  ONLY
		CLA CLL		/CLEAR GARBAGE FROM ACC. AND LINK
		DCA TMP2	/SET COUNTER AND POINTER TO 0
	CLR1,	CDF 10		/CHANGE TO DF 1
		DCA I TMP2	/INSERT 0'S
		ISZ TMP2	/INCREMENT COUNTER AND POINTER
		JMP CLR1+1	/IF COUNTER DOESN'T GO TO 0, REPEAT
		CDF 00		/CHANGE BACK TO DF 0
		DCA SIN1	/INIT FOR DATA ACQUISITION
		DCA S11		/FOR CHANNEL 1
		DCA SOUT1	/FOR CHANNEL 1
		DCA S21		/FOR CHANNEL 1
		DCA SIN2	/FOR CHANNEL 2
		DCA S12		/FOR CHANNEL 2
		DCA SOUT2	/FOR CHANNEL 2
		DCA S22		/FOR CHANNEL 2
		JMP I CLEAR	/RETURN FROM ROUTINE
	/
