		TAD KCRA
		WCRA		/WRITE TO CONTROL REG. A
		CLA CLL		/CLEAR GARBAGE FROM ACC.
		TAD KCRB
		WCRB		/WRITE TO CONTROL REG. B
		CLA CLL		/CLEAR GARBAGE FROM ACC.
		TAD KBAUD
		BAUDLD		/LOAD BAUD RATE
		TSCAF		/CLEAR ALL FLAGS
		CLA		/CLEAR GARBAGE FROM ACC.
		JMP I INIT	/RETURN FROM ROUTINE
	KCRA,	0400
	KCRB,	0360
	KBAUD,	0217
