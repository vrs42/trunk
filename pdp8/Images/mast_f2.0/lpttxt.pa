/
/	SAMPLE TALLEY FORMAT STATEMENTS
/
/
/
/	SAMPLE LINE FORMAT
/
/
FORM01,	TEXT "'0D1',6D,2A,6D,3X,3D,8D,7D,2X,'/'"
/
/
/	NEW ROLL PAGE HEADING
/
/
FORM03,	TEXT "'0FF',1A,1A,/,'0H0ROLLEN NUMMER ',13A,5X"
	*.-1
	TEXT "'SCHICHTROLLEN ',2D,9X,'SEITE  1',/'0LF'"
/
/
/	ROLL INFORMATION LINES
/
/
FORM04, TEXT "'0H2PACKART',17T,5A,35T,'DATUM',46T,11A/"
	*.-1
	TEXT "'0H3PROBEN CODE',17T,2A,35T,'SCHICHT',46T,2A/ "
	*.-1
	TEXT "'0H4BREITE - HUB',17T,5A,1X,3A,35T, "
	*.-1
	TEXT "'M.-FUEHR.',46T,2A,/'0LF'"
/
/
/	SAMPLE TALLEY HEADING
/
/
FORM05, TEXT "'0H5',4X,'PROBE  BOX  BLATT  HUEBE  ' "
	*.-1
	TEXT "'REJECTS',49T,'BEMERKUNGEN',/'0LF'"
/
/
/	ROLL SUMMARY HEADING
/
/
FORM07,	TEXT "'0H8 END BOX    BLATT    HUEBE    REJECTS ' "
	*.-1
	TEXT ",'   PROBE    METER'"
/
/
/	ROLL GRAND TOTAL HEADING
/
/
FORM08, TEXT "'0LF',/'0LF',/'0LF',/,'0H7 GESAMTABRECHUNG '"
	*.-1
	TEXT "'ROLLEN NUMMER ',13A,/'0LF'"
/
/
/	ROLL GRAND TOTAL DATA LINE
/
/
FORM09, TEXT "'0H9',2X,6D,6X,3D,9D,1X,10D,1X,8D,9D"
/
/
/	NEW PAGE HEADING
/
/
FORM10,	TEXT "'0FF',1A,/,'0H1ROLLEN NUMMER ',13A,5X,"
	*.-1
	TEXT "'SCHICHTROLLEN ',2D,9X,'SEITE ',2D,/'0LF'"
/
/
/	SPLICE MESSAGE
/
/
FORM20,	TEXT "'0M1***   KLEBSTELLE BEI HUB',8D"
/
/
/	SAMPLE CODE CHANGE MESSAGE
/
/
FORM21,	TEXT "'0M1***   PROBEN CODE ',2A' BEI HUB',8D "
/
/
/	PUT UP CHANGE MESSAGE
/
/
FORM22,	TEXT "'0M1***   PACKART ',5A,' NACH KOECHER',5D"
/
/
/	MACHINE CHECK MESSAGE
/
/
FORM23,	TEXT "'0M1***   MASCHINEN TEST  P',1A,'  TRAY,  ' "
	*.-1
	TEXT "1A,' BLATT'"
/
/
/	STOP MESSAGE
/
/
FORM24,	TEXT "'0M1***   STOP BEI HUB',8D,43T& "
	*.-1
FRM24N,	TEXT "&&A"
/
/
/	EMULSION FAULT START MESSAGE
/
/
FORM25,	TEXT "'0M1***   FEHLENDE EMULSION BEI HUB',8D"
/
/
/	EMULSION FAULT END MESSAGE
/
/
FORM26,	TEXT "'0M1***   FEHLENDE EMULSION BIS HUB',8D"
/
/
/	SAMPLE TRAY OUT MESSAGE
/
/
FORM29,	TEXT "'0M1***   PROBENKASTEN HERAUS BEI HUB',8D"
/
/
/	SPECIAL SAMPLE MESSAGE
/
/
FORM30,	TEXT "'0M1***   PLANLAGE PROBE  P',1A,'  TRAY,  ' "
	*.-1
	TEXT "1A,' BLATT'"
/


