/ PRINTER TEXT FOR THE SAMPLE TALLEY               22-AUG-91
/
/
/
/	L      PPPP   TTTTT  TTTTT  X   X  TTTTT
/	L      P   P    T      T    X   X    T
/	L      P   P    T      T     X X     T
/	L      PPPP     T      T      X      T
/	L      P        T      T     X X     T
/	L      P        T      T    X   X    T
/	LLLLL  P        T      T    X   X    T
/
/
/
/	STORAGE FOR ALL TEXT FOR THE SAMPLE TALLEY
/	IS CONTAINED HERE.
/
/
/EDIT HISTORY:
/
/19-JUN-90	(LHN)
/	1)   ADDED SAMPLE TRAY OUT MESSAGE
/	2)  DELETED FORMAT FOR INFORMATION LINE
/
/31-JUL-90	(LHN)
/	1)  ADDED SECOND FORM FEED AT START OF ROLL
/
/30-AUG-90	(LHN)
/	1)  CHANGED MACHINE STOP MESSAGE FORMAT
/
/
/12-JUN-91	(LHN)		FOR VERSION 4A
/	1)  ADDED LINE CODES FOR GATEWAY
/	2)  CHANGED OUTPUT TASK FROM LPT TO DIRTAL
/
/
/22-AUG-91	(LHN)		FOR VERSION 4B
/	1)  ADDED CHARACTER TO START OF EACH TEXT
/	    FOR ERROR RETURN FROM GATEWY TASK.
/



	FIELD LPTXFLD%10
	*LPTXLOC
/
/
/	SAMPLE TALLEY LINE BUFFER
/
/

TALBUF, ZBLOCK 3
	LPTXFLD^100+400+DIRTAL	/UNPACKED OUTPUT
	FORM01
	0010			/BINARY SAMPLE NUMBER
	ZBLOCK 2
	0012			/ASCII SAMPLE TYPE
	4040
	0110			/LOCAL ASCII INPUT DATA
	0			/BOX NUMBER
	0
	0			/SHEET WITHIN BOX
	0			/CHOP
	0
	0			/REJECTS
	0
	0			/TERMINATOR

