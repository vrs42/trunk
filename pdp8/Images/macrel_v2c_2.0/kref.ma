			/LIST
OUTLN,	0
OUTDEV,	0
OUTEXT,	'LS		/DEFAULT OUTPUT EXTENSION
OUTL,	0		/NEG OF OUTPUT BUFFERLENGTH (IN DBL WDS)
OUTB,	0		/START OF OUTPUT BUFFER
INPLEN,	4		/NO. OF BLOCKS IN INPUT BUFFER

OUTLEN,	4		/NO. OF BLOCKS IN OUTPUT BUFFER
OUTKNT,	0
OUTSIZ,	0		/LENGTH OF OUTPUT FILE
