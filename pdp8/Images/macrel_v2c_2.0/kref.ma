END$:	JMS I [CRLF
	TAD NAMPTR	/GO TO NEXT NAME ENTRY FOR THIS LETTER
	JMP LOOP$

4$:	DCA PAD
	TAD HIN
	CLL
	JMS I [DPRINT
	JMP 3$
	PAGE
CTRLC,	0		/CHECK FOR ^C FROM TTY
	TAD [200
	KRS
	TAD (-203
	SNA CLA
	KSF
