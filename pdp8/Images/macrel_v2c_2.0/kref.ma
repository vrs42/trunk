INHAND,	6600		/LOCATION OF INPUT  HANDLER (FIELD 0)
OUTHAND,7200		/LOCATION OF OUTPUT HANDLER (FIELD 0)

	USR=7700
	MQL=7421
ONAME,	0;0;0;0		/NAME OF OUTPUT FILE

LINEN2,	0
LINENO,	0
LINEXT,	0

LOLET,	100		/6-BIT OF LOWEST LETTER PAIR CREFFING THIS PASS
