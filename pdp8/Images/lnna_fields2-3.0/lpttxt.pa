/
/
/	SAMPLE TALLEY FORMAT STATEMENTS
/
/
/	SAMPLE LINE FORMAT
/
FORM1A,	TEXT "6D,2A,6D,3X,3D,8D,8D,2X,'/'"
FORM1B,	TEXT "6D,2A,6D,3X,3D,8D,8D,2X,'/',/"
FORM1C,	TEXT "6D,2A,6D,3X,3D,8D,8D,2X,'/',//"
/
/
/	INFORMATION LINE MESSAGE & FORMAT
/
/
INFLIN,	ZBLOCK 3
	LPTXFLD^100+400+LPT	/UNPACKED OUTPUT
	FORM2A
	0110
	0			/BOX NUMBER
	0
	0			/SHEET WITHIN BOX
	0			/CHOP
	0
	0			/REJECT
	0
	0			/TERMINATOR

FORM2A, TEXT "8X,6D,3X,3D,8D,8D,2X,'/'"
FORM2B, TEXT "8X,6D,3X,3D,8D,8D,2X,'/',/"
FORM2C, TEXT "8X,6D,3X,3D,8D,8D,2X,'/',//"
/
/	NEW ROLL PAGE HEADING
/
/
FORM03,	TEXT "1A,/,'ROLLEN NUMMER ',13A,5X,'SCHICHTROLLEN ' "
	*.-1
	TEXT ",2D,9X,'SEITE 1',/"
/
/	ROLL INFORMATION LINES
/
FORM04, TEXT "'PACKART',15T,5A,33T,'DATUM',44T,8A,/,"
	*.-1
	TEXT "'PROBEN CODE',15T,7A,33T,'SCHICHT',44T,1A,/,"
	*.-1
	TEXT "'BREITE - HUB',15T,3A,1X,5A,33T,'M.-FUEHR.',44T,2A,/"
/
/	SAMPLE TALLEY HEADING
/
FORM05, TEXT "2X,'PROBE    BOX  BLATT  HUEBE    '  "
	*.-1
	TEXT "'REJECTS',49T,'BEMERKUNGEN',/"
/
/	SISTER ROLL SUMMARY HEADING
/
FORM06, TEXT "///,'ZWISCHENSUMME SCHWESTER ROLLE NR. ',1A,"
	*.-1
	TEXT "44T,'SCHICHTROLLE ',2D,/"
/
/	ROLL SUMMARY HEADING
/
FORM07,	TEXT "' END BOX    BLATT    HUEBE     REJECTS'"
	*.-1
	TEXT ",'  PROBE    METER'"
/
/	ROLL GRAND TOTAL HEADING
/
FORM08, TEXT "///,' GESAMTABRECHUNG  ROLLEN NUMMER ',11A,/"
/
/	ROLL GRAND TOTAL HEADING
/
FORM09, TEXT "6D,7X,3D,10D,10D,8D,10D,///"
/
/	NEW PAGE HEADING
/
FORM10,	TEXT "1A,/,'ROLLEN NUMMER ',13A,5X,'SCHICHTROLLEN ' "
	*.-1
	TEXT ",2D,9X,'SEITE ',2D,/"
/
/	SPLICE MESSAGE
/
FORM20,	TEXT "'***   KLEBSTELLE BEI HUB',8D"

/
/	SAMPLE CODE CHANGE MESSAGE
/
FORM21,	TEXT "'***   PROBEN CODE ',7A' BEI HUB',8D "
/
/	PUT UP CHANGE MESSAGE
/
FORM22,	TEXT "'***   PACKART ',5A,' NACH KOECHER',5D"

/
/	MACHINE CHECK MESSAGE
/
FORM23,	TEXT "'***   MASCHINEN TEST  P',1A,'  TRAY,  ' "
	*.-1
	TEXT "1A,' BLATT'"
/
/	STOP MESSAGE
/
FORM24,	TEXT "'***   STOP BEI HUB',8D"

/
/	EMULSION FAULT START MESSAGE
/
FORM25,	TEXT "'***   FEHLENDE EMULSION BEI HUB',8D"
/
/	EMULSION FAULT END MESSAGE
/
FORM26,	TEXT "'***   FEHLENDE EMULSION BIS HUB',8D"

/
/	FORM FEED MESSAGE
/

FORM27, TEXT "1A"
FORM28,	TEXT "/,'ROLLEN NUMMER ',13A,5X,'SCHICHTROLLEN '"
	*.-1
	TEXT ",2D/"
