/ PRINTER TEXT FOR THE SAMPLE TALLEY               23-MAY-78
/
/
/	STORAGE FOR ALL TEXT FOR THE SAMPLE TALLEY
/	IS CONTAINED HERE.


	FIELD LPTXFLD%10
	*LPTXLOC

/
/
/	SAMPLE TALLEY LINE BUFFER
/
/

TALBUF, ZBLOCK 3
	LPTXFLD^100+400+LPT	/UNPACKED OUTPUT
	FORM1A
	0010			/BINARY SAMPLE NUMBER
	ZBLOCK 2
	0012			/ASCII SAMPLE TYPE
	4040
	0110			/LOCAL ASCII INPUT DATA
	0			/BOX NUMBER
	0
	0			/SHEET WITHIN BOX
	0			/CHOP
	0
	0			/REJECTS
	0
	0			/TERMINATOR

	ZBLOCK 3
	LPTXFLD^100+400+LPT
	FORM1A
	0010	
	ZBLOCK 2
	0012
	4040
	0110
	ZBLOCK 10

	ZBLOCK 3
	LPTXFLD^100+400+LPT
	FORM1A
	0010
	ZBLOCK 2
	0012
	4040
	0110
	ZBLOCK 10

