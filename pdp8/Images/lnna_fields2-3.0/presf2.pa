/PRESET FIELD 2			          	22-MAY-90


/
/EDIT HISTORY:
/
/22-NOV-78	(LHN)
/	1)  ADDED "EORTRP" FOR "SAMPLE"
/
/18-MAY-90	(LHN)
/	1) MOVED CODE TO READ UNWIND STATE 









	TASK=	PRESF2
	CUR=	PREF2FLD
	INIWT=  0
	VERS=	3








	FIELD PREF2FLD%10
	*PREF2LOC
/
/
/%R	INITIALIZE FIELD 2 AFTER END OF ROLL SUMMARY
/
/
START,  CLB

   IFNDEF	EPLTEST	<
	DBRI52
	AND (1000)
    >
    IFDEF	EPLTEST	<
	DBRI50
	AND (0100)
    >
	DCA UNWDBF


	CAL
	SUSPND		/GO TO SLEEP 'TIL NEEDED

	TAD (PR2TBL-1)
	DCA XR17
	TAD (PR2TBL-PR2END-1)
	STL RAR
	DCA PRES2B

PRE1,	TAD I XR17
	DCA PRES2A
	TAD I XR17
	DCA I PRES2A
	ISZ PRES2B
	JMP PRE1

	JMP START

PRES2A, 0
PRES2B, 0
/
/
/	TABLE OF INITIAL VALUES
/
/
PR2TBL,	
	SPLMFG		/SPLICE MESSAGE FLAG AND TIMER
	-1
	BINSAM		/BINARY SAMPLE COUNTER
	0
	BINSAM+1
	0
	BINBOX		/BINARY BOX COUNTER
	1
	BINBOX+1
	0
	BINSHT		/BINARY SHEETS IN BOX COUNTER
	0
	BINCHP		/BINARY CHOP COUNTER
	0
	BINCHP+1
	0
	BINREJ		/BINARY REJECT COUNTER
	0
	BINREJ+1
	0
	BINMTR		/BINARY METER COUNTER
	0
	BINMTR+1
	0
	BINSHR		/BINARY SHIFT ROLL
	0
	BINSSM		/BINARY SPLICE SAMPLE COUNTER
	0
	BINSSM+1
	0
	CHOPFG		/CHOP OCCURED FLAG
	0
	EORTRP		/EOR DATA MISSING TRAP FLAG
PR2END,	0

	PAGE

	NOPUNCH
	XLIST 1
