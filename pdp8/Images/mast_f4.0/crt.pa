	TASK=	CRT
	CUR=	CRTFLD
	INIWT=	0
	VERS=	4

	TASK2=	VTDINP
	CUR2=	CRTFLD
	INIWT2=	0
	VERS2=	4

	TASK3=	CRTMSG
	CUR3=	CRTFLD
	INIWT3=	0
