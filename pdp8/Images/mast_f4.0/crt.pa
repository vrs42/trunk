/
/	RRRR   FFFFF  RRRR   EEEEE   SSSS  H   H
/	R   R  F      R   R  E      S      H   H
/       R   R  F      R   R  E      S      H   H
/	RRRR   FFFF   RRRR   EEEE    SSS   HHHHH
/       R R    F      R R    E          S  H   H
/	R  R   F      R  R   E          S  H   H
/	R   R  F      R   R  EEEEE  SSSS   H   H
/
/
/

/
/
/ TASK TO REFRESH THE PRODUCT DATA WHEN THE MACHINE STOPS
/
/
START4,	CLB
	CAL 
	SUSPND		/GO TO SLEEP 'TIL NEEDED.

	CLB
	TAD (REFTBL)	/SET UP A POINTER TO THE TEXT TO
	DCA REFRA	/ DISPLAY.

REFR1,	TAD I REFRA	/GET THE NEXT MESSAGE ADDRESS
	ISZ REFRA
	SNA		/IS IT ZERO ?
	JMP START4	/YES, END OF LIST

	DCA REFRB	/NO, LET'S GO DISPLAY IT.
	CAL
	SENDW
	CRT
	REFMG
	JMP REFR1	/GO AROUND AGAIN.

REFRA,  0
REFMG,	ZBLOCK 3
REFRB,	0

REFTBL,	CRTD01
	CRTD02
	CRTD03
	CRTD04
	CRTD05
	CRTD06
	CRTD07
	0

	PAGE

	NOPUNCH		/THE CRTTXT FILE FOLLOWS
	XLIST 1

