/
/
/	USER TASK NAME FILE
/
/
/ THIS FILE IS ASSEMBLED WITH THE MCR TASK TO PROVIDE USER
/ TASK NAMES FOR THE MCR'S SYSTEM STATUS REPORT (SY).
/
/
/ FORMAT OF NMTBL IS 2 OR 3 WORDS OF 4 6-BIT CHARACTERS
/ ORDERED BY NUMBER OF TASK AFFILIATED WITH THAT NAME.
/
/ NAMES MUST BE PADDED WITH BLANKS!
/
/
/
/
/
/ GENERAL FORM FOR TASK NAME ENTRY
/
/
/	FOR TASK "ABC":
/
/	IFDEF	ABC	<
/	*ABC^NAMWDS+NAMES
/	0102; 0340		/FOR 4 CHARACTER NAMES
/	IFNZRO	MCR6CN	<4040>	/FOR 6 CHARACTER NAMES
/	>
/
/



	IFZERO	MCR6CN	<NAMWDS= 2>	/NUMBER OF WORDS
	IFNZRO	MCR6CN	<NAMWDS= 3>	/PER ENTRY.


	*NMTBL		/NAME TABLE IN MCR TASK.



	IFDEF	SMGATE	<
	*SMGATE^3+NAMES
