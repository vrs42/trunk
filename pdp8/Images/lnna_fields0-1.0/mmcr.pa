/ M. HURLEY / R. LARY
/THE MONITOR CONSOLE ROUTINE ALLOWS THE OPERATOR/PROGRAMMER
/OF AN RTS-8 SYSTEM TO CONTROL AND OBSERVE THE STATE OF THE
/SYSTEM THROUGH THE CONSOLE TELETYPE.

/
/EDIT HISTORY
/
/	MADE NON-RESIDENT-ABLE LATE DEC, 1975
/	4-JAN-76	FIXED BUG RE RE TO EARLIER TIMES
/	3-MAY-76	ADDED 'MCRFLD' AND 'MCRCLK'
/			ADDED DECNET/8 NAMES TO NAME TABLE
/	14-JUN-76	ADDED TLK, LSN
/	02-OCT-76	FIXED TIMING PROBLEMS
/			ADDED 'MCRCDV' PARAMETER
/			INCREASED INPUT BUFFER IF USING
/			NULL8A NULL TASK
/			ADDED TTY2 AND EXIT TO NAME TABLE
/			MODIFIED 'EXIT' CODE
/01-AUG-77:  (LHN)
/	1)  80 COLUMN LPT: CREF LISTING.
/	2)  ADDED CONDITIONAL CODE WHEN "MCRDMP"=1 TO ENABLE
/		A)  THE DUMP (DU) COMMAND.
/		B)  THE FI COMMAND.
/	3)  CHANGED THE NULL TASK CONDITIONAL TEST.
/	4)  ADDED "B" FOR DEBUG WAIT IN THE STATUS LIST.
/	5)  MODIFIED "SYSTAT" CODE TO LIST UP TO 128 TASKS.
/	6)  ADDED 6 CHARACTER NAMES WHEN "MCR6CN" =1.
/	7)  MODIFIED TEST FOR NAME LIST TO SHARE PAGE.
/	8)  MODIFIED "ENABLE" TO ALSO REMOVE "DEBWT" BIT.
/02-AUG-77:  (LHN)
/	1)  MODIFIED "TIME" TO INCLUDE SECONDS IN TIME LOG.
/	2)  REPLACED "EAE" ASSEMBLY PARAMETER WITH "MQ".
/	3)  CHANGED "PDP8E" CONDITIONALS TO "PDP8E+PDP8A".
/03-AUG-77: (LHN)
/	1)  MODIFIED "SYSTAT" CODE TO PRINT THE EAE STEP
/	    COUNTER IN THE STATUS LIST, IF "EAE" = 1.



IFNDEF	MCRFLD	<MCRFLD=10>



	TASK=	MCR
	CUR=	MCRFLD
	INIWT=	0
/
/
/ MCR MESSAGE FORMAT
/
/
/
/MCRMSG, ZBLOCK 3
/	 FUNCTION AND TASK
/	 ANSWERB
/	 MSGTXT
/
/
/WHERE:
/
/ FUNCTION
/    BIT 0 = 0	LOG ERRORS ON THE CONSOLE DEVICE (MCRCDV)
/	   = 1	SEND ERRORS MESSAGES TO OUTPUT "TASK"
/
/    BIT 1 = 0	FOLLOW THE OUTPUT WITH A CARRIAGE RETURN AND
/		LINE FEED. THE TASK WHICH RECEIVES MCR'S
/		MESSAGE CAN ACT ON THIS BIT.
/	   = 1	DO NOT FOLLOW THE OUTPUT WITH A CARRIAGE
/		RETURN AND LINE FEED
/
/    BIT 2 = 0	"MSGTXT" IS THE FIRST WORD OF THE MESSAGE
/	   = 1	"MSGTXT" POINTS TO THE FIRST WORD OF THE
/		TEXT MESSAGE
/
/    BIT 3 = 0	DO NOT OUTPUT THE PROMPT CHARACTER ">"
/	   = 1	OUTPUT THE PROMPT CHARACTER VIA THE OUTPUT
/		"TASK"
/
/    BIT 4	CURRENTLY UNUSED
/
/
/ TASK		BITS 5-11 CONTAIN THE NUMBER OF THE TASK TO
/		WHICH MCR WILL SEND ANSWERS (AND MAYBE
/		ERRORS).
/
/
/ ANSWERB	IS THE BUFFER ADDRESS IN THE CALLING TASK'S
/		FIELD WHERE MCR WILL PUT ITS ANSWER TO THE 
/		CALLER'S REQUEST. FOR EXAMPLE, IF THE CALLER
/		REQUESTED THE DATE, IT WILL BE STORED (IN
/		PACKED ASCII) STARTING AT "ANSWERB". IF
/		MCR'S RESPONCE TO A REQUEST WILL BE SENT ON
/		TO ANOTHER TASK (I.E. THE TTY:), THIS
/		LOCATION MUST BE ZERO.
/
/
/ MSGTXT	IS EITHER THE FIRST WORD OF THE MESSAGE TEXT
/		STRING (IF BIT 2 = 0) OR A POINTER TO THE
/		FIRST WORD OF THE MESSAGE TEXT STRING (IF
/		BIT 2 = 1).
/
IFNDEF	MCRCDV	<MCRCDV=TTY>	/TTY IS DEFAULT
IFNDEF	CLOCK	<MCRCLK=0>
IFDEF	CLOCK	<IFNDEF	MCRCLK	<MCRCLK=1> >
IFNDEF	MCRSYS	<MCRSYS=1>	/DEFAULT INCLUDES SYSTAT
IFNDEF	MCR6CN	<MCR6CN=0>	/DEFAULT TO 4 CHAR NAMES
IFNDEF	MCRDMP	<MCRDMP=1>	/DEFAULT INCLUDES DUMP
IFNDEF	MQ	<MQ=0>		/JUST IN CASE



/ USER SHOULD DEFINE 'MCRLOC' IN PARAM FILE IF HE WANTS TO
/ SPECIFY LOCATION.  IF HE DOESN'T THEN MCR WILL PUSH UP
/ AGAINST END OF FIELD 1.
/
/ IF 'MCRPRT' IS DEFINED IN THE PARAMETER FILE, THEN THE
/ USER WANTS THE MCR TO BE NON-RESIDENT, AND 'MCRPRT' IS
/ ITS PARTITION NUMBER. THE FIRST PAGE OF MCR IS RESIDENT
/ AND ITS ORIGIN SHOULD NOT BE MULTIPLE OF 400.

	IFDEF	MCRPRT	<	PARTNO=MCRPRT
				CPABLE=0
				WRITE=1		>



/ PARAMETERS FOR SOMEWHAT FANCIER NULL TASK WHICH COMES
/ WITH MCR

	IFDEF	NULL8A	<NULL=NULL8A>
	IFNDEF	NULL	<
TASK2=	NTASKS+1	/LOWEST PRIORITY TASK IN SYSTEM -
	>		/ UNADDRESSABLE
	IFDEF	NULL	<
	IFNZRO	NULL-NTASKS-1	<
TASK2=	NTASKS+1
	> >
CUR2=	CUR		/SAME FIELD AS MCR
INIWT2=	0		/COMES UP RUNNING




/********
/ PARAMETERS WHICH DEPEND ON SPACE FREE IN MCR PAGES:

CODFIT=	114	/LENGTH OF THE CODE THAT CAN SHARE A MEMORY
		/ PAGE WITH THE NAME LIST. (SEE NAME LIST.)
INLENG=	35	/LENGTH OF INPUT BUFFER (USED TO BE 54)
IFNDEF	TASK2	<INLENG=INLENG+26>
IFDEF	TASK2	<IFZERO	MQ	<INLENG=INLENG+14> >

/ CHECK THEM WHENEVER EDITING CODE!
/********
/ PAGE ZERO DEFINITIONS

	FIELD CUR%10

	*MCRPGZ

ERRDLM,	DLMER
ERRNUM,	NUMER
ERRNAM,	NAMER
GET,	GETA
NUMB,	0	/GETN RESULT
ENDSTF,	ENDS
BCKUP,	BACKUP
LEGLIM,	LEGAL
EOL,	EOLA
ACLW,	0	/2 WORD AC
ACH,	0
Q,	0	/ALL USAGE TEMPS
V,	0
P,	0
PUTW=	JMS I	.
	PUTWX
/
/
/ DETERMINE MODULE ORIGIN IF NOT SPECIFIED	[V2B-A]
/
/
IFDEF	MCRLOC	<*MCRLOC>

IFNDEF	MCRLOC	<*6200			/BASE ADDRESS
	IFNZRO	MCRSYS	<*.-200>	/1 PAGE
	IFNZRO	MCRCLK	<*.-600>	/3 PAGES
	IFNZRO	MCRDMP	<*.-200>	/1 PAGE

	TEMP=	CODFIT		/COMPUTE NAME LIST LENGTH
	IFDEF	EXIT		<TEMP=	TEMP-7>
	IFZERO	NTASKS-100&4000	<TEMP=	TEMP+15>
	IFNZRO	MCR6CN	<TEMP=	TEMP+6>
	IFZERO	MCR6CN	<TEMP=	NTASKS+1^2+TEMP&7600>
	IFNZRO	MCR6CN	<TEMP=	NTASKS+1^3+TEMP&7600>
	*.-TEMP

	IFDEF	MCRPRT	<	/INSURE NON-RESIDENT PORTION
				/IS ON A BLOCK BOUNDARY
		IFZERO	.&200	<*.-200>
		>
	>

IFNDEF	MCRNRL	<MCRNRL= .+200>		/NON-RESIDENT ORIGIN
/
/	RESIDENT PORTION OF MCR:
/

	IFDEF	TASK2	<
START2,	TAD	L7600	/RSX-11D STYLE NULL TASK
BKGLP,	ISZ	BKGCT
	ISZ	BKGCT
	IFNZRO	MQ	<JMP MQDPY>
	ISZ	BKGCT
	ISZ	BKGCT
	ISZ	BKGCT
	JMP	BKGLP
	RAR
	JMP	BKGLP
BKGCT,	0

	IFNZRO	MQ	<
/	MQ DISPLAY ROUTINE			[V2B-A]
/
/	THIS CODE IS CALLED FROM THE 'NULL' TASK IN THE
/	MCR, AND PUTS THE SELECTED CORE LOCATION IN THE
/	MQ REGISTER.  THE FIELD OF THE DISPLAY IS 
/	SET BY THE FIELD (FI) COMMAND.
/
/
	0
MQDPY,	DCA START2	/SAVE THE AC
	OSR		/READ THE SWITCH REGISTER AND SAVE
	DCA MQDPY-1	/THE VALUE AS AN INDIRECT
MQFLD,	CDF 0		/SET THE REQUIRED DATA FIELD
	TAD I MQDPY-1	/READ THE SELECTED CORE LOCATION
	CDF CUR		/RESET THE DATA FIELD TO HERE
	MQL		/MOVE THE DATA TO THE MQ REGISTER
	CLA		/JUST IN CASE MQL FAILS
	TAD START2	/RESTORE THE AC
	JMP BKGLP+3	/RETURN TO THE 'NULL' TASK

	>
	>
/
MCRMSG,	ZBLOCK 3
	2000		/NO CRLF
	0
L7600,	TEXT />/



ERMSG,	ZBLOCK	3	/STANDARD MESSAGE HEADER
	1000		/SIXBIT MESSAGE, END WITH CRLF,
			/ INDIRECT
	0		/NO INPUT
ERRA,	0		/JMS PUTS POINTER TO ERROR
			/ MESSAGE HERE
	CAL		/AC RANDOM BUT IRRELEVANT
	SENDW+FREE
ERRB,	MCRCDV
	ERMSG
	JMP I	(ENDS



CHRER,	JMS	ERRA
	TEXT	/BAD CHAR/
NAMER,	JMS	ERRA
	TEXT	/BAD NAME/
DLMER,	JMS	ERRA
	TEXT	/BAD DELIM/
NUMER,	JMS	ERRA
	TEXT	/BAD NUMBER/
/GET NEXT CHARACTER ROUTINE
/ADVANCE POINTER FOR NEXT GET

/ MOVED HERE FOR [V2B-A]

GETA,	0
	TAD I	IP
	ISZ	IP
	JMP I	GETA
IP,	0

BACKUP,	0		/BACK UP INBUF POINTER BY 1 CHAR
	CLA CMA
	TAD	IP
	DCA	IP
	JMP I	BACKUP

PUTWX,	0		/ROUTINE TO STORE A WORD IN THE 
	DCA I W		/ OUTPUT BUFFER
	ISZ W
	JMP I PUTWX	/[V2B-A]

W,	E1MSG


TTOUT,	0
	PUTW		/TERMINATE LINE
	TAD	(E1MSG	/INITIALIZE POINTER FOR NEXT LINE
	DCA	W
	TAD EXINB	/DID THE CALLING TASK REQUEST AN 
	SZA CLA		/ ANSWER ?
	JMP I (ANSWER)	/YES, GO MOVE THE ANSWER INTO THE 
			/ CALLER'S BUFFER AREA.

	CAL
	SENDW+FREE
TTO1,	MCRCDV		/SEND MESSAGE TO TTY AND WAIT
	EXMSG
	JMP I	TTOUT

EXMSG,	ZBLOCK	3	/OUTPUT BUFFER SHARES SPACE WITH
EXFUN,	0		/ INPUT BUFFER
EXINB,	0
E1MSG,
INBUF,	ZBLOCK	INLENG	/INPUT BUFFER

	PAGE
/	NON-RESIDENT PORTION OF MCR:


	*MCRNRL

	IFDEF	MCRPRT	<IFNZRO .&0200 <MCRBLK,  _ERROR_  >>
		/ERROR IF NON-RESIDENT PORTION OF MCR
		/DOES NOT START AT A MULTIPLE OF 400.



/ROUTINE TO PARSE OFF A TASK NAME OR NUMBER

NAMEA,	XNAME
XNAME,	0	/USED FOR TEMP STORAGE OF ACCUMULATED NAME
XNAME1,	0
XNAME2,	0	/[V2B-A]

GETTSK,	0		/THIS SUBR RETURNS TASK NUMBER IN
	JMS	NAMGET	/ "TSKWD"
	JMP	NUMTSK
	JMS	NAMCOM	/OK SO FAR.
			/NOW CHECK FOR NAME DUPLICATION
	JMP I	ERRNAM
	TAD	V
	TAD	(NTASKS+1  /GET NUMBER ASSOC. WITH THIS NAME
GOTASK,	DCA	TSKWD	/AND THAT'S THE TASK NUMBER
	TAD	TSKWD
	CIA
	CLL
	TAD	(NTASKS	/MUST BE BETWEEN 1 + NTASKS
	SNL CLA
	JMP I	ERRNUM
	TAD	TSKWD
	JMP I	GETTSK	/RETURN WITH TASK NUMBER IN AC
NUMTSK,	JMS I	BCKUP	/IT'S A NUMBER - MUST BACK UP PTR
	JMS I	(OCTNUM	/SO GO ACCUMULATE IT
	JMS I	BCKUP
	JMS I	GET	/GET DELIMITING CHAR
	CLA
	TAD	NUMB
	JMP	GOTASK
/
NAMGET,	0
	TAD	NAMEA
	DCA	G7
	IFZERO	MCR6CN	<AC7776>	/[V2B-A]
	IFNZRO	MCR6CN	<AC7775>
	DCA	G3
	TAD	(4040
	DCA	XNAME1
	TAD	(4040)		/[V2B-A]
	DCA	XNAME2

	JMS I	(ALPNUM	/ONLY ALPHAS + NUMBERS LEGAL
	JMP I	(CHRER
	TAD	(-300
	SPA CLA		/NAME OR NUMBER?
	JMP I	NAMGET	/BY NUMBER
	ISZ	NAMGET
	TAD	Q
NXT,	AND	(77
	STL RTL		/40 IN LOW 6 BITS
	RTL
	RTL
	DCA I	G7
	JMS I	(ALPNUM
	JMP	ENDX	/2ND CHAR IS NOT ALPHANUMERIC
	AND	(77
	TAD	(-40	/REMOVE LOW 40
	TAD I	G7
	DCA I	G7	/SAVE 1ST 2 CHARS
	ISZ	G7
	ISZ	G3	/4 (0R 6) CHARS YET?
	JMS I	(ALPNUM
	JMP	ENDX	/3RD CHAR NON-ALPHANUMERIC
	JMP	NXT	/GO DO 3RD+4TH CHARS
ENDX,	JMS I	BCKUP
END,	JMS I	LEGLIM
	JMP	END
	NOP
	JMP I	NAMGET

G3,	0
G7,	0
TSKWD,	0
/COMPARE NAME IN XNAME WITH NMTBL, LOOKING FOR MATCHES.

NAMCOM,	0
	IFZERO	MCR6CN	<TAD	(NMTBL-1>	/[V2B-A]
	IFNZRO	MCR6CN	<TAD	(NMTBL-2>
	DCA	P
	TAD	(-NTASKS-1
	DCA	V
CHKMOR,	ISZ	P	/UPDATE PAST UNNEED INFO
	IFNZRO	MCR6CN	<	/[V2B-A]
	ISZ	P
	>
	ISZ	V	/DONE?
	SKP
	JMP I	NAMCOM	/YES
	TAD I	P	/GET 2 CHARACTERS FROM NMTBL
	ISZ	P
	CIA
	TAD	XNAME	/COMPARE TO NAME UNDER INVESTIGATION
	SZA CLA
	JMP	CHKMOR	/N.G. CONTINUE THRU NMTBL
	TAD	XNAME1	/TRY 2ND 2 CHARS FOR MATCH
	CIA
	TAD I	P
	SZA CLA
	JMP	CHKMOR	/NOT CLOSE ENOUGH

	IFNZRO	MCR6CN	<	/[V2B-A]
	ISZ	P
	TAD	XNAME2	/TRY 3RD 2 CHARS FOR MATCH
	CIA
	TAD I	P
	SZA CLA
	JMP	CHKMOR+1	/NOPE, NO MATCH
	>
	ISZ	NAMCOM	/FOUND IT
	JMP I	NAMCOM
/RUN THE REQUESTED TASK. TO SCHED FIRST

	IFZERO	MCRCLK	<
SCHED,	JMS	GETTSK	
	>
REQUST,	IFNZRO	MCRCLK	<TAD	TSKWD>
	CAL
	RUN
	JMP	BKELEN

/STOP THE REQUESTED TASK

STOP,	JMS	GETTSK
	CAL
	SUSPND
BKELEN,	JMS I	BCKUP
	JMS I	EOL
	JMP I	ENDSTF

/ENABLE A TASKS EXECUTION

ENABLE,	JMS	GETTSK
	CAL
	UNBARG		/UNBLOCK THE TASK ON
	ENABWT+DEBWT	/ENABLE WAIT AND DEBUG WAIT  [V2B-A]
	JMP	BKELEN	/CLEAN UP

/DISABLE A TASKS EXECUTION

DISABL,	JMS	GETTSK
	CAL
	BLKARG		/BLOCK THE TASK ON
	ENABWT		/ENABLE WAIT
	JMP	BKELEN	/CLEAN UP

	PAGE
/COMMAND CLEANUP AND FETCH NEW COMMAND

ENDS,	CLL CLA
	TAD MSGFLD+1	/MOVE THE MESSAGE CDF FOR POSTING.
	DCA END1
	AC7775		/FORM ADDRESS OF THE MESSAGE EVENT 
	TAD MADDR	/ FLAG, AND GO POST IT.
	CAL
	POST
END1,	HLT
	TAD TTTASK	/DID THE CALLING TASK ASK FOR A 
	AND (0400)	/ PROMPT CHARACTER ?
	SNA CLA
	JMP NEXT	/NO, GO ON.
	TAD I (TTO1	/YES, PICK UP THE OUTPUT TASK NUMBER
	DCA .+3		/ AND SEND OUT THE PROMPT CHARACTER.
START,	CAL
	SEND+FREE
	MCRCDV
	MCRMSG

ENDZ,
NEXT,	CAL		/GO WAIT FOR A MESSAGE.
	RECEIVE+FREE
MADDR,	0
	DCA MSGFLD+1	/SAVE THE MESSAGE CDF.
	TAD MADDR	/SET UP POINTER TO THE NEW MESSAGE.
	DCA P

	JMS MSGFLD	/SET THE DATA FIELD TO THE MESSAGE.
	TAD I P		/GET THE OUTPUT CONTROL WORD,
	ISZ P
	DCA TTTASK	/ AND SAVE IT.

	TAD I P		/MOVE THE ADDRESS OF THE CALLER'S
	ISZ P		/ANSWER BUFFER, IF ANY.
	CDF CUR
	DCA I (EXINB)

	TAD TTTASK	/IS "OUTTXT" THE DATA OR A POINTER ?
	RTL
	SMA CLA
	JMP .+4
	JMS MSGFLD
	TAD I P		/'TIS A POINTER, UPDATE OUR POINTER.
	DCA P

	TAD (INBUF)	/SET UP A POINTER TO OUR LOCAL
	DCA Q		/ BUFFER.
	TAD (-INLENG+1)	/SET UP A LOOP COUNTER.
	DCA V
/
/ MOVE THE NEW MESSAGE TO OUR LOCAL BUFFER

MOV1,	JMS MSGFLD	/SET DATA FIELD FOR MESSAGE.
	TAD I P		/GET ANOTHER WORD OF OUR MESSAGE.
	ISZ P
	CDF CUR
	SPA SNA		/IS THIS THE MESSAGE TERMINATOR ?
	JMP MOV2	/YES, EXIT LOOP
	DCA I Q		/ADD THE WORD TO THE LOCAL BUFFER
	ISZ Q
	ISZ V		/IS OUR BUFFER FULL ?
	JMP MOV1	/NO, GET ANOTHER WORD.
MOV2,	DCA I Q		/SAVE THE MESSAGE TERMINATOR.

	AC2000		/MOVE THE CARRIAGE RETURN/LINE FEED
	AND TTTASK	/ CONTROL BIT TO THE OUTPUT MESSAGE.
	DCA I (EXFUN)

	TAD TTTASK	/SET UP THE TASK NUMBER FOR OUTPUT.
	AND (0177)
	SNA
	TAD (MCRCDV)	/THE DEFAULT DEVICE IS "MCRCDV".
	DCA I (TTO1)

	TAD I (TTO1)	/PRESET THE OUTPUT TASK NUMBER FOR 
	DCA I (ERRB)	/ERROR MESSAGES.
	TAD TTTASK	/DID THE CALLER ASK FOR ERRORS ON
	SMA CLA		/THE CONSOLE TTY (MCR'S CONSOLE) ?
	JMP .+3
	TAD (MCRCDV)	/YES, SET UP TTY AS ERROR OUTPUT.
	DCA I (ERRB)
/ SET UP AND DECODE THE NEW COMMAND

	TAD	(INBUF
	DCA I	(IP
	DCA I	(CRALT
	JMS I	LEGLIM	/LOOK AT FIRST CHAR
	JMP	.+3	/SOMETHING USEFUL
	JMP I	ENDSTF	/CR OR ALT - NULL LINE
	JMP	.-3	/SPACE OR COMMA - KEEP LOOKING
			/ FOR MEAT
	JMS I	BCKUP	/FOUND MEAT - BACK UP OVER IT
	JMS I	(NAMGET	/GET COMMAND NAME
	JMP I	ERRNAM
	TAD	(CMDLST-1
	DCA	P
CMDLP,	ISZ	P
	TAD I	P	/GET 1ST 2 CHARS OF A COMMAND
	ISZ	P
	SZA		/0 TERMINATES COMMAND LIST
	TAD I	(XNAME
	SZA	CLA	/A MATCH?
	JMP	CMDLP	/NO-TRY AGAIN
	TAD I	P	/YES - GET COMMAND DISPATCH ADDRESS
	DCA	P
	JMP I	P	/WE'RE ON OUR WAY

TTTASK,	0		/OUTPUT CONTROL WORD FROM CALLER.

MSGFLD,	0
	HLT		/WILL BE CDF TO MESSAGE FIELD.
	JMP I MSGFLD
/
/ RETURN OUR ANSWER IN THE CALLER'S BUFFER
/
ANSWER,	TAD (INBUF)	/SET UP A POINTER TO OUR BUFFER.
	DCA P
	TAD I (EXINB)	/SET UP A POINTER TO THE CALLER'S
	DCA Q		/ BUFFER AREA.
	TAD (-INLENG+1)	/SET UP A LOOP COUNTER.
	DCA V

ANS1,	CDF CUR
	TAD I P		/GET A WORD FROM OUR BUFFER.
	ISZ P
	JMS MSGFLD	/SET DATA FIELD TO CALLING TASK.
	SNA		/TEXT TERMINATOR ?
	JMP ANS2	/YES, GO ON.
	DCA I Q		/PUT THE WORD IN THE CALLER'S AREA.
	ISZ Q
	ISZ V		/TRANSFER DONE ?
	JMP ANS1	/NO, MOVE ANOTHER WORD.

ANS2,	DCA I Q		/ADD THE BUFFER TERMINATOR.
	CDF CUR
	JMP ENDS	/NOW DO EXIT STUFF

	PAGE
/DETERMINES IF NEXT CHARACTER IS ALPHABETIC OR NUMERIC
/EXIT IF NOT; EXIT+1 IF ALPHA OR NUM

ALPNUM,	0		
	JMS I	GET
	DCA	Q
	TAD	Q
	TAD	(-333
	CLL
	TAD	(32
	SZL CLA		/TEST FOR ALPHA
	ISZ	ALPNUM	/BUMP RETURN IF ALPHA
	TAD	Q	/NOW TEST FOR NUMERIC
	JMS	ISITNM
	ISZ	ALPNUM
	JMP I	ALPNUM

/SEE IF CHARACTER IN AC IS NUMERAL
/EXIT IF IS; EXIT+1 IF NOT

ISITNM,	0	
	TAD	(-"9-1
	CLL
	TAD	(12	/CHECK FOR RANGE 260-271
	SNL
	ISZ	ISITNM	/BUMP RETURN ADDRESS IF NOT IN RANGE
	TAD	(260	/RESTORE CHAR
	JMP I	ISITNM
/
/
/ COME HERE FOR UNKNOWN COMMANDS
/
/ IF THE USER SUPPLIED A EXTENDED COMMAND DECODING TASK,
/ SEND OUR INPUT MESSAGE ON TO IT.
/
/
NONAME,	IFNDEF	USERCD	<JMP I ERRNAM>
	IFDEF	USERCD	<
	CAL
	SENDW+FREE
	USERCD
	EXMSG
	JMP I ENDSTF
	>
/CHECK NEXT CHAR FOR TYPE OF DELIMITER
/EXIT=	NOT CR,ALTMODE,SPACE, OR COMMA
/EXIT+1=CR OR ALTMODE
/EXIT+2=SPACE OR COMMA

LEGAL,	0
	JMS I	GET	
	DCA	Q
	TAD	Q
	CIA CLL
	SPA		/CR OR ALTMODE?
	JMP	NOCRAL	/NO
	STA CML RAL	/GENERATE -2 IF CR, -1 IF ALTMODE
	DCA	CRALT
	JMP	ITSEOL
NOCRAL,	TAD	(240	/BLANK?
	SZA
	TAD	(",-240	/COMMA?
	SZA CLA
	JMP	NOGOOD	/NEITHER
	ISZ	LEGAL	/SPACE OR COMMA
ITSEOL,	ISZ	LEGAL	/CR,ALT
NOGOOD,	JMP I	LEGAL

EOLA,	0		/SEARCH FOR C.R. OR ALTMODE
	JMS I	LEGLIM
	JMP I	ERRDLM	/CRAP AT END OF LINE
	JMP I	EOLA
	JMP	EOLA+1

CRALT,	0
/COMMAND LIST - FORMAT OF LIST IS:
/	NAME
/	OVERLAY NO.
/	ST. ADDR. IN OVERLAY

CMDLST,	-2324;	STOP	/STOP
	-0516;	ENABLE	/ENABLE
	-0411;	DISABL	/DISABLE
	-1601;	NAME	/NAME
	IFNZRO	MCRCLK	<
	-0401;	DATEX	/DATE
	-2411;	TIME	/TIME
	-0301;	CANCEX	/CANCEL
	>
	-2205;	SCHED	/REQUEST
	-1720;	EXAM	/OPEN
	-0405;	DEPSIT	/DEPOSIT
	-2017;	POSTEF	/POST
	IFNZRO	MCRSYS	<
	-2331;	SYSTAT	/SYSTAT
	>
	-0530;	EXITT	/EXIT
	IFNZRO	MCRDMP	<
	-0425;	DUMPIT	/CORE DUMP OPTION	[V2B-A]
	-0611;	MQDFLD	/FIELD OF MQ DISPLAY	[V2B-A]
	>
	0;	NONAME	/END OF LIST
