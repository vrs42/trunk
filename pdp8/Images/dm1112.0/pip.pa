START,	CLL CLA
	CLKSET		/SET CLOCK FLAG
	CLKSKP		/SKIP IF CLOCK FLAG IS SET
	JMP	MONITR	/NOT A DECMATE II RETURN TO SYSTEM
	PRQ3		/CALL SETUP FUNCTION
