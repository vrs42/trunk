CFLD,	0		/CURRENT CORE FIELD
CURBLK,	0		/POINTER TO CURRENT BLOCK IN BINARY BUFFER
BP,	LDBUFS		/BINARY POINTER INTO BINARY OUTPUT BUFFER
MAPFIL,	ZBLOCK	5	/MAP FILE SPECIFIER
OUTFIL,	ZBLOCK	5	/.SV FILE SPECIFIER
SAOFF,	0		/STARTING ADDRESS OFFSET
TOPLOC,	7600		/HIGHEST LOCATION ALLOWED TO BE USED
