TRYDAT,	0		/DATA FROM TRYLIM ROUTINE
SAV2,	0
SAV3,	0
MFLD,	-40		/FIRST FIELD WHERE 7600 IS ALLOWED TO BE ALLOCATED
RFLD0,	0		/RESERVED FLD BITS 10 TO 23
