	JMP	OVLM		/3RD PASS
	IAC			/2ND PASS
	DCA	STAB3		/SET OFFSET TO 1
	TAD	(7400		/SET MASK TO 7400
	JMP	OVLM1
OVLM,	AC4			/3RD PASS
	DCA	STAB3		/SET WORD OFFSET TO 4 FOR TYPE & OVERLAY
	TAD	(SZL CLA
