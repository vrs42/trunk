UNDMSG,	325;323		/UNDEFINED SYMBOL
DDMSG,	304;323		/DOUBLE DEFINITION ERROR
GOFMSG,	TEXT	"SYMBOL TABLE OVERFLOW"
SOFMSG,	TEXT	"SECT TABLE OVERFLOW"
