	DCA	SOUT
	ISZ	IN		/BUMP CURRENT POINTER
	TAD	IN
	TAD	SBOTTOM
	SMA CLA			/AT END OF STACK?
E28==.;	JMS I	COS8ER		/YES, ERROR, STACK FULL
