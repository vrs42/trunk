/ABCDE TO ACDEB00
FLD59,	0
	CLL RAL			/MOVE AC LEFT 1
	TAD	(7740		/PUT "A" IN LINK
	AND	(37		/CLEAR UNUSED BITS
	TAD	(3760		/PUT "B" IN AC0
	SPA			/"B"?
	IAC			/YES, PUT "B" IN AC11
	AND	(17		/MASK OFF GARBAGE
	SZL			/"A"?
	TAD	(20		/YES, PUT "A" IN 7
	CLL RTL			/LEFT 2
	JMP I	FLD59		/DONE

/ABCDE TO CDEBA0
FLD80,	0
	CLL RAL			/MOVE AC LEFT 1
	TAD	(7740		/PUT "A" IN LINK
	AND	(37		/CLEAR UNUSED BITS
	TAD	(3760		/PUT "B" IN AC0
	SPA			/"B"?
	IAC			/YES, PUT "B" IN AC11
	RTL			/PUT "B" IN 9, "A" IN 10
	AND	(76		/MASK OFF UNWANTTED BITS
	JMP I	FLD80		/DONE

/CDEBA0 TO ABCDE
FLD95,	0
	AND	(76		/MASK OFF UNWANTED BITS
	RTR CLL;	RAR	/MOVE "A" TO AC0, "B" TO LINK
	SZL			/"B"?
	TAD	(10		/YES, PUT "B" IN AC8
	SPA			/"A"?
	TAD	(4020		/YES, PUT "A" IN AC7, CLEAR AC0
	JMP I	FLD95		/DONE


CAUT,	TEXT	"CAUTION - ENTRY POINT ABOVE FIELD 7"

