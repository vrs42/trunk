PUTBIN,	0
	DCA	TEMP2		/SAVE
	TAD	OUTINH
K7640,	SZA CLA			/INHIBIT OUTPUT?
	JMP I	PUTBIN		/YES
	TAD	OPTAB
	RAL
	SPA CLA			/DOING .BN FILE?
	JMP	PBIN		/YES
	TAD	TEMP2		/NO
OUTFLD,	0			/CDF X
	DCA I	BLKSIZ		/STORE IT AWAY
	CDF	0
	ISZ	BLKSIZ
	TAD	BLKSIZ
	AND	(377		/HAVE WE CROSSED
	SZA CLA			/A BLOCK BOUNDRY?
	JMP	PUTBN1		/NO
	ISZ	NEWBLK		/YES, BUMP BLOCK NUMBER
	JMS	NEWBB		/SELECT A NEW BUFFER
	TAD	BLKBEG
	DCA	BLKSIZ		/RE-INITIALIZE WORD POINTER
PUTBN1,	ISZ	CURLOC		/BUMP CURLOC
	NOP			/FILLER
	JMP I	PUTBIN		/EXIT
PBIN,	CLL
	JMS	PUNBIN		/PUNCH BINARY
	JMP	PUTBN1		/BUMP CURLOC, EXIT

/PUNCH BINARY
PUNBIN,	0
	TAD	TEMP2		/GET WORD TO PUNCH
	RTR;	RTR;	RTR	/6 RIGHT
	AND	(177		/MASK TO 6 MSB'S AND ORG BIT
	DCA	TEMP4
	TAD	TEMP4
	TAD	CHKSUM
	DCA	CHKSUM		/ADD TO CHECKSUM
	TAD	TEMP4
	JMS	OCHARA
	TAD	TEMP2		/GET WORD AGAIN
	AND	(77		/MASK TO LSB'S
	DCA	TEMP4
	TAD	TEMP4
	TAD	CHKSUM
	DCA	CHKSUM
	TAD	TEMP4
	JMS	OCHARA
	JMP I	PUNBIN

/PUNCH ORIGIN
PUNORG,	TAD	TEMP4
	CIA
	TAD	ORIGIN
	SNA CLA			/HAS THIS FIELD BEEN PUNCHED BEFORE?
	JMP	PUNOR1		/YES
	TAD	TEMP4		/NO
	DCA	ORIGIN
	TAD	ORIGIN
	AND	(30		/MASK TO MSB'S
	TAD	(300
