/MORE OF NEWBUF

NEWBF2,	0
	DCA	BLKBEG		/SAVE ADDRESS
	TAD	OPTAB+2
	AND	(4000
	SZA CLA			/USE 7600?
	JMP I	NEWBF2		/YES
	TAD	BLKBEG		/NO
	TAD	(-7400
	SZA CLA			/DOES IT USE BUFFER STARTING AT 7400?
	JMP I	NEWBF2		/NO
	CDF	10		/YES, ERROR
	DCA I	BP		/RESET
