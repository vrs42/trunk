/
/GET NEXT TEXT WORD, STORE IN TXTWRD
NXTTXT,	0
	TAD	INPTR
	AND	(377
	SZA CLA			/CROSSING 400 WORD BOUNDRY?
	JMP	GETWRD		/NO
	TAD	INPTR		/YES, END OF INPUT BUFFER?
	TAD	(-ENDBUF
	SZA CLA
	JMP	GETWRD-3	/NO, BUMP POINTER AROUND HEADER WORD
	JMS	REMOD		/YES, READ NEW BUFFER
	TAD	(INBUF
	DCA	INPTR		/RESET INPTR TO BEGINNING OF BUFFER
	ISZ	INPTR		/BUMP POINTER AROUND HEADER WORD
	STA
	DCA	FLGCNT		/MAKE IT LOOK LIKE END OF FLGWRD
GETWRD,	CDF	10
	TAD I	INPTR		/GET NEXT TEXT WORD
	CDF	0
	DCA	TXTWRD		/SAVE IT
	ISZ	INPTR		/INCREMENT TO NEXT TEXT WORD
	JMP I	NXTTXT		/EXIT
/
