	ISZ	LIBPTR		/DUMP POINTER
	TAD	TEMP1
	SZA CLA			/INTERESTED IN THIS MODULE?
	JMP I	LIBREL		/YES - GO PROCESS IT
	JMS	SKPLIB		/NO- JUMP OVER THE WHOLE THING
	JMP	LIBRL1		/END OF FILE
	JMP	LIBREL+1	/TRY AGAIN
LIBRL1,	ISZ	LIBPTR		/BUMP POINTER
	JMP	GOREL1		/GO ON TO NEXT FILE
LIBMOD,	0			/BIT WHICH TELLS IF WE WANT THIS MODULE
