/HERE TO FIX UP CORE IMAGE DATA FOR NEW SECT

FIXDAT,	0
	TAD	OVRL		/GET CURRENT OVERLAY-LEVEL NUMBER
	AND	(160		/MASK TO LEVEL
	RTR CLL
	TAD	(LHDR		/FORM ENTRY IN LHDR
	DCA	BSECTP		/SET UP BSECTP
	CMA
	TAD	BSECTP
	DCA	XR0		/SET UP AUTO INDEX REG
	TAD	(CIDAT-1
	DCA	XR1		/SET UP STORAGE POINTER (-1)
	TAD	(-4
	DCA	XR2		/SET UP COUNTER
	CDF	10		/MOVE 4 DATA WORDS
	TAD I	XR0
	CDF
	DCA I	XR1
	ISZ	XR2
	JMP	.-5
	TAD	OVRL
	AND	(17		/FORM CURRENT OVERLAY NUMBER
	SNA			/0?
	JMP	FIXDT1		/YES, NO MULTIPLICATION NEEDED
	CIA			/MAKE -
	DCA	TEMP3		/SAVE
	TAD I	(CIDAT+3	/GET LENGTH OF OVERLAY
	IAC			/CONVERT TO BLOCKS
	CLL RAR
	DCA	TEMP2		/SAVE
	TAD	TEMP2		/MULTIPLY BY NUMBER OF OVERLAY
	ISZ	TEMP3
	JMP	.-2
FIXDT1,	TAD I	(CIDAT+2	/ADD IN STARTING POINT OF LEVEL
	DCA I	(CIDAT+2	/STORE AWAY RESULT
	JMP I	FIXDAT		/DONE

OLLERR,	TEXT	"OVERLAY-LEVEL"		/OVERLAY-LEVEL ERROR - LOWER THAN ALLOWED

