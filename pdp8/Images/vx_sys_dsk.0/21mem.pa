/%R	MANUAL STACKER CHANGE REQUEST

HLD17,	TAD CIRS
	AND [200
	SNA CLA		/STACK GATE CHANGE REQUESTED?
	JMP HLD19	/NO
	TAD STAFLA	/YES
	SZA CLA		/CHANGE IN PROGRESS?
	JMP HLD18	/YES-IGNORE REQUEST
	IOF		/NO-TURN INTERRUPT OFF
	TAD CORS	/CHANGE GATE POSITION
	RAL
	CML RAR		/COMPLEMENT BIT 0
	JMS I [OSRJT	/SET INTO O.S.R. & CORS
	TAD CORS	/CLEAR TRAY LIGHT
	SMA CLA		/LOWER ?
	TAD (200	/NO, UPPER
	TAD (200	/YES.
	JMS I [MOCRSC	/TURN LIGHT OFF
	TAD NOSPBB	/RESET GOOD SHEET COUNTER =
	CIA		/-NO. OF SHEETS PER BOX
	DCA GSCNT
	CLA IAC
	DCA STAFLA	/SET STACKER FLAG
	JMS ITBC	/UPDATE BOX COUNTER
	ION
	JMP HLD20
