	DCA STAFLA	/YES-CLEAR STAFLA
HLD18,	IOF
	TAD CIRS	/CLEAR CIRS BIT 4
	AND [7577
	DCA CIRS
/%R MANUAL SAMPLE AT STACKER REQUEST

HLD20,	TAD CIRS	/READ BIT
	AND (4		/MASK BIT
	SNA CLA		/SET ?
	JMP HLD21-1	/NO
	TAD SROFLG	/YES, IS SRO IN PROGRESS?
	SZA CLA
	JMP HLD21	/YES, EXIT
	TAD SAMFLB	/NO, IS SAMPLE IN PROGRESS?
	SZA CLA
	JMP HLD21	/YES, EXIT
	IOF		/TURN OFF INTERRUPTS
	ISZ SAMFLB	/SET IN PROGRESS FLAG
	ISZ SAMFLC	/SET STACKER SAMPLE FLAG
	CLA CMA		/ADD ONE TO BOX COUNT
	TAD GSCNT
	DCA GSCNT
	TAD [1000	/SET ACK LIGHT
	JMS I [MOCRSS
	TAD (600	/CLEAR LIGHTS
	JMS I [MOCRSC
	JMP HLD21	/EXIT

	DCA SAMFLB	/CLEAR IN PROGRESS FLAG
HLD21,	IOF
	TAD CIRS	/CLEAR BIT
	AND (7773
	DCA CIRS
	ION


/%R	MANUAL SAMPLE AT REJECT REQUEST

HLD23,	TAD CIRS	/READ BIT
	AND (100
	SZA CLA		/SET ?
	JMP .+3		/YES, NOW CHECK IF FLAG IS SET.
	DCA SAMFLA	/NO, CLEAR THE FLAG
	JMP HLD24	/CLEAR BIT AND EXIT
	TAD SAMFLA	/GET THE FLAG
	SZA CLA		/SET ?
	JMP HLD24	/YES, EXIT
	IAC		/NO, SET THE FLAG
	DCA SAMFLA
	CLB CML RAR	/"TAKE" A REJECT
	DCA BFF1
HLD24,	IOF
	TAD CIRS	/GET WORD
	AND (7677	/MASK BIT OUT
	DCA CIRS	/SAVE WORD
	ION
	JMP HLD25

