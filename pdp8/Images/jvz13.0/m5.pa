	DCA TXTPNT
	TAD TXTPNT
	TAD (-203	/^C ?
	SNA
	 JMP JMP7600	/YES, THAT'S NO ANSWER.
	TAD (203-"Y
	SZA CLA
	 JMP .+4
	JMS TXTOUT
	   YMSG
	JMP .+4
	ISZ ANSWER
	JMS TXTOUT
	   NMSG
	JMS CRLF
	JMP I ANSWER

TXTPNT,	0
YMSG,	TEXT	*YES*
NMSG,	TEXT	*NO*

