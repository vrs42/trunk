	CLL RAL
	DCA ZTEM5	/WE ONLY NEED THE LINK NOW
	TAD I EMUAC
MRIFLD,	  CDF BGFLD	//NOT DANGEROUS FOR OPR.INSTR.
MRINST,	  HLT		//EMULATE !
