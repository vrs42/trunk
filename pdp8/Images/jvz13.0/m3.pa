IFNZRO PDPTYP-PDP8E <AC0002>>
	TAD BJOB	///
	DCA AUTO13	///
IFDEF EAE 	<
	SCA		///OR-IN STEPCOUNTER
	SWP		///SWAP AC AND MQ
	DCA I AUTO13	///
IFZERO PDPTYP-PDP8E <
/    MODE A    MODE B
     SCL       ASC
     7330      AC4000
	MQA		///M00.000.0SS.SSS, M=MODE B >
	DCA I AUTO13	///>
