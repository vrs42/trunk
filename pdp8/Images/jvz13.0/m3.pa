	TAD INTFLD
DISP3A,	RTF		///ALSO COME HERE AFTER FAST
	CLA		///CDF-EMULATION.
	TAD INTAC
	JMP I 0		/// >/END OF KM8E
IFNDEF KM8E <
	JMP I (INTEXT	/// GO !>>/END OF PDP8E
IFNZRO PDPTYP-PDP8E	<
