KHI11,	JMS I (SETBASE	/NECESSARY IN CASE OF TIMEOUT
	JMS I (QCOUNT
	   UBUFIN
	SNA CLA		/ANY INPUT WAITING ?
	 JMP KHILP	/NO
KHIRUN,	JMS I (EMRUN	/START THE EMULATOR
	   UCUR
KHI,	JMS I (EMRUN
	   UWRTR
KHILP,	TAD I BASE
	AND (BGERR+SWPERR
	SZA CLA		/ERROR IN EMULATION OR SWP ?
	 JMP I (KHI8	/Y, GET INTO ^B-MODE
	JMS I (GET	/
	   UKB
	DCA KHINAM
	JMS I (GET
	   UREAD	/GET READER RUN FLAG (=TIMEOUT
	JMS MONITOR	/VALUE)
	   CALL
KHINAM,	   0
	 JMP I (KHI3	/INPUT HANDLER BUSY:LOOP AND TRY
	SPA SNA		/IGNORE NULL'S
	 JMP KHI11	/TIMEOUT, ACTIVATE BG
	DCA ZTEM1	/SAVE TEMP
	JMS I (SETBASE	/FOR WHICH BG?MAY HAVE CHANGED!
	TAD ZTEM1	/
	TAD (-217	/TEST FOR ^O
	SZA
	TAD (217-203	/TEST FOR ^C
	SNA
	 JMS I (KHI4	/CLEAR INPUT AND OUTPUT BUFFERS
	IAC		/TEST FOR ^B
	SNA
	 JMP KHI2	/CONTROL-B
