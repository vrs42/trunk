	TAD INTFLD	///COMPUTE CDF INSTR.
	AND C7		///EXTRACT DATAFIELD
	CLL RTL		///
	RAL		///
	TAD C6201	///MAKE CDF
	DCA BGCDF	///
	TAD INTFLD	///
