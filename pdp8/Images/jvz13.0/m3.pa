/***********************************************************
/***********   C E N T R A L   E M U L A T O R   ***********
/***********************************************************

TRAPINT,CINT		///CLEAR THE TRAP INTERRUPT FLAG
IFDEF KM8E <
	RIB	/TAD INTFLD (FOR PDP8E GTF WILL DO AS WELL)
	AND C70		///USERS INSTR. FIELD
	TAD C6201	///MAKE CDF USERS FIELD
	DCA BGCDF1
	ACM1
	TAD 0		///GET PC OF TRAPPING INSTR.
	DCA X
BGCDF1,	  HLT		///CDF USERS INSTR. F.
	TAD I X		///GET HIS INSTRUCTION
	CLL RTR
	RTR
	TAD (-1310	///IF IT IS A CDF 0 OR 1 AC=0
	SZA CLA		///AND LINK IS COMPLEMENT OF F.
	 JMP EMNCDF
IFNZRO PDPTYP-PDP8E <
	CDF MONFLD
	TAD (INTAC-1	///SET AUTO14 FOR DISP3A
	DCA AUTO14
