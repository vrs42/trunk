	SCL		/LOAD STEPCOUNTER FROM .+1
	0		/>>
IFNDEF EAE	<
IFZERO PDPTYP-PDP8E <
	TAD I AUTO14	/FETCH MQ FROM CORE
	MQL		/LOAD MQ
	ISZ AUTO14	/SKIP STEPCOUNTER>>
	TAD I AUTO14	/FETCH PC
	IOF		///
	ISZ CURTSK	///MAKE CURTSK POSITIVE
	DCA 0		///SET UP FOR RETURN
