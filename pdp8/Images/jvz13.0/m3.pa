	RAL		///LOAD LINK
	CLA		///
	SUF		///SET USER MODE
	TAD I AUTO14	///
BGCDF,	0		///
BGCIF,	0		///
	ION		///
	JMP I 0		///AT LAST WE GO>

RSAVE,	0		///SAVE FULL INTERRUPT STATUS
