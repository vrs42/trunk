/ MCR NAME FILE FOR   M A S T			3/15/77
/
/	USER TASK NAME FILE
/
/	THIS FILE IS ASSEMBLED WITH THE MCR TASK TO
/	PROVIDE USER TASK NAMES FOR THE MCR'S SYSTEM
/	STATUS REPORT (SY).
/
/
/FORMAT OF NMTBL IS 2 OR 3 WORDS OF 4 6-BIT CHARS
/ORDERED BY NUMBER OF TASK AFFILIATED WITH THAT NAME
/NAMES MUST BE PADDED WITH BLANKS!



	*NMTBL		/NAME TABLE IN MCR TASK.


	IFDEF	SMGATE	<
	*SMGATE^3+NAMES
	2315; 0701; 2405	/SAMPLE TRAY GATE HANDLER
	>

	IFDEF	RAGATE	<
	*RAGATE^3+NAMES
	2201; 0701; 2405	/REJECT A TRAY GATE HANDLER
	>

	IFDEF	RBGATE	<
	*RBGATE^3+NAMES
	2202; 0701; 2405	/REJECT B TRAY GATE HANDLER
	>

	IFDEF	PAGATE	<
	*PAGATE^3+NAMES
	2001; 0701; 2405	/PRODUCT A TRAY GATE HANDLER
	>

	IFDEF	PBGATE	<
	*PBGATE^3+NAMES
	2002; 0701; 2405	/PRODUCT B TRAY GATE HANDLER
	>

	IFDEF	PCGATE	<
	*PCGATE^3+NAMES
	2003; 0701; 2405	/PRODUCT C TRAY GATE HANDLER
	>
/
/	USER TASK NAMES
/
	IFDEF	SNAP	<
	*SNAP^3+NAMES
	DEVICE SNAP		/SNAP
	4040
	>
	IFDEF	DUMP	<
	*DUMP^3+NAMES
	DEVICE DUMP		/DUMP
	4040
	>


	$=$=LHN=$=$
