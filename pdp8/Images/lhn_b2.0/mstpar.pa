/
/
/	FIELD 1 COMMON DEFINITIONS
/
/
	FIELD 1
	*40

GATEDY,	0		/STACKER GATE TURN ON DELAY
MEMPTR,	20		/CURRENT DEFECT MEMORY POINTER
MEMTBL=	2200



