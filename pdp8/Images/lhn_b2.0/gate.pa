CDI=	CDF CIF
TUBLOD=	6000

P200=	20
P100=	21
P4000=	34
SMTCNT=	150

P40=	22
M4=	23
P20=	24
P2000=	25

P10=	25
P1000=	26
P4=	44
P400=	45



MEMPTR=	4000
MEMTBL=	4200
P177=	17
WKA=	170
CLB=	CLL CLA
TRAYSZ=	30
DBCO50=	6501
DBSO51=	6514
DBCO54=	6541
DBSO54=	6544

LINESP=	5000
/
/
/
/%R	JUMP TABLE LINKAGE TO "TUBLOD"
/
/%TW	COME HERE FROM THE JUMP TABLE WHEN A SAMPLE SHEET
/	IS IN THE PROPER POSITION FOR MARKING.  IF A SHEET 
/	WAS DIRECTED INTO THE SAMPLE TRAY, GO TO "TUBLOD"
/	IN FIELD 2 TO SET UP AND FIRE THE SAMPLE MARKER.
/
/
SMARKR,	0
	CLB
	TAD SMRLOC	/GET THE WORD FROM THE DEFECT MEMORY
	TAD MEMPTR	/TABLE AT THE SAMPLE MARKER POSITION.
	AND P177
	TAD (MEMTBL)
	DCA WKA
	TAD I WKA	/IS THE SAMPLE MARKER SET TO FIRE FOR
	AND P400	/THIS SHEET ?
	SNA CLA
	JMP I SMARKR	/NO, RETURN
	CDI 20		/YES, GO TO THE "TUBLOD" ROUTINE IN FIELD
	JMS I (TUBLOD)	/2, LOAD THE SAMPLE DATA AND FIRE THE 
			/SAMPLE MARKER.
	JMP I SMARKR	/RETURN

SMRLOC,	0		/SAMPLE MARKER LOCATION IN THE MEMORY
			/TABLE
