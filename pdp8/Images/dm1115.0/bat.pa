JMP I IRENTRY	/BEGIN PROCESSING.

TEMPOINT,
DEVINPUT,0
	JMS DEVIN1
	SNA
	JMP .-2		/WAIT HERE FOR SOME INPUT
	JMP I DEVINPUT

DEVIN1,0
	RECSKP
	JMP I .-2	/NO FLAG.
	RECLOD
	AND (177
	TAD (200
	JMP I DEVIN1	/WITH 8BIT.

MONXIT,CDF CIF 0
	JMP I OS8MON	/BEFORE EXITING TO MONITOR

DOCRLF,	0		/OUTPUT A CRLF
	TAD (215
	JMS XMIT6
	TAD (212
	JMS XMIT6
	JMP I DOCRLF


