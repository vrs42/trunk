IFNDEF	VT100 <TAD KM6>	/GET START OF TABLE
KEYN,	TAD SORTCN	/GET KEY VALUE (0-9,1-5)
	ISZ LASTC	/CHECK 'F' FLAG
IFDEF	VT100 <TAD KM11
KEYG,	TAD (KEYTBL+21)>/PF KEYS
