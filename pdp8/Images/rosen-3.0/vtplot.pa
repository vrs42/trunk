	TAD C33
	JMS I (XOUTL
	TAD I ESCSEQ
	,R,G,E,V,Z' (EITHER CASE)
	AND K537
	SORTJ		/SECOND+ CHARS NEVER MATCH
	    BRGLST-1
KM6,	    BRGGO-BRGLST
	JMP K537	/SCAN PAST REST OF KEY NAME

KEYL,	IAC		/LEFT
KEYO,	IAC		/OVER (RIGHT)
KEYD,	IAC		/DOWN
KEYU,	DCA SORTCN	/UP
	CLL IAC RTL	/+4
	DCA CURSW	/ENABLE CURSOR KEYS
