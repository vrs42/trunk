/PATCH TO PAL8-V12 TO ADD XS40 OP		-JVZ-

/THIS PATCH ADDS THE 'XS40' PSEUDO-OPERATOR TO PAL8 (V12).
/THIS OPERATOR BEHAVES JUST LIKE THE 'TEXT' OPERATOR, BUT
/PACKS STRINGS IN 'EXCESS-40' CODE RATHER THAN 'SIXBIT'.

/TO ADD TO PAL8:	.LO PAL8.SV/I$*XS40$
/			.SA SYS PAL8X=2100

	*6314		/REPLACE 'DTORG' PSEUDO-OP
	"X-300^45+"S-300+4000
	"4-225^45+"0-225
	4000

	*6223
	XS40X+1		/WAS 'TEXTX'

	*5400		/DTORGX
XS40X,	TAD 165		/[240
	DCA I .+3
	JMP I .+1
	2601		/TEXTX
	XS40Z

	*2623
	TAD XS40Z
	JMP XS40Y

	*2770
XS40Y,	JMS 2651	/TEXT2
	JMP 2614	/TEXT3
XS40Z,	0		/SWITCH

	$END$
