/THE 'FLGS' FUNCTION READS EVENT FLAGS WHICH HAVE NOT
/CAUSED A PROGRAM INTERRUPT.  A NON-ZERO ARGUMENT MAY
/BE SPECIFIED AS A MASK: ('-1'='ALL', '1'='EVENT 12')
/WHEN A MASK IS USED, THE FLAGS READ ARE RESET; OTHER-
/WISE THEY ARE LEFT ALONE.

FLGS,	FIXIT		/GET THE MASK
	SNA
	STL CMA		/'0' = 'ALL'
	AND EVFLGS
	DCA HORD	/SAVE
	SNL
	TAD HORD	/CLEAR IF NZ MASK
	CMA
	CIF P		/INHIBIT INTERRUPTS
	AND EVFLGS
	DCA EVFLGS
	TAD HORD
	FL0ATR		/RETURN WHAT WE FOUND

