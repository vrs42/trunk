GETSIZ,	SNL SMA		/POINTS TO 'MGETA'
	JMP .-2		/AND PAD WITH ZEROS
	ISZ TEMP	/CHECK CALLING FLAG
	JMP NOSIZE
FLENPT,	OPBLKS
			/NOTE: L=1, SO NO 'GETC'
REMOVE,	JMS I GETSIZ	/GET THE CLOSING LENGTH, IF ANY
	STL		/ONLY 'O A' & 'O C' HAVE SIZES
