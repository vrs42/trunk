	TAD I [ERROR	/CHECK PRINT POSITION
L340,	AND L17
LM40,	SMA SZA CLA	/SEPARATE BY 3 SPACES
	JMP SPACLP
	TAD I [LINENO	/COLUMN SPECIFICATION?
	SZA
	DCA COLCNT	/SAVE NEW COLUMN COUNT
	TAD I [ERROR
	CDF L
	CLL RTL		/TIMES 8, THEN NEGATE
P7044,	CMA RAL
	TAD COLCNT	/COMPARE
	SMA CLA
	JMP I P7044	/CONTINUE
	JMP SPACLP-1	/START A NEW LINE
/////
COLCNT,	5^200		/NO. OF DIRECTORY COLS.

