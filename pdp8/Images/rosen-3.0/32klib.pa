	4
	ONMTMP		/FILE NAME POINTER
BLKCNT,	0		/CURRENT FILE LENGTH
OLNGTH,	0		/MAXIMUM   "     "
	TAD OUTFLG
	SNA CLA
	ERROR1		/FILE WAS TOO LONG
	DCA OUTFLG	/CLEAR THE 'FILE OPEN' FLAG
