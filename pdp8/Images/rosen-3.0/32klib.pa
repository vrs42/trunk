ICHAR4,	JMP I ICHARP	/SKIP NULLS (ENTRY PT)
	TAD MEOF
	SNA		/TEST FOR CTRL/Z
EOFXIT,	DCA INFLG	/ZAP WORD COUNT ON EOF
	TAD [EOF
	CDI P
	JMP ICHAR+3	/RETURN CHAR TO PROGRAM
