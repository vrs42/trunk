	PUT
FINAL,	JMS LAST1	/UPDATE THE LAST BLOCK
	FLOATR

INITL,	TSTCMA		/UPDATE OR INITIALIZE?
	JMP FINAL
	GETNXT		/EVALUATE MODE PARAMETER
