	ERROR2		/FCOM INDEX EXCEEDED RANGE
	CMA		/SUBTRACT ONE
	TAD BUFR	/'NOP' FOR 20K SYSTEM
	DCA XRT		/LOAD INDEX REGISTER
	CDF T		/'CDF 40' FOR 20K
	JMP I INDEX

