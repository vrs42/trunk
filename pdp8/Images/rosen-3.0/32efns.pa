A11,	-4;4266;6330;5514
E0,	+0;3777;7777/7775
A9,	-3;2204;0441;7142
A7,	-3;5056;2150;2756
A5,	-2;2023;0156;7455
A3,	-2;4465;4651;5615
A1,	+0;2427;6301;5544
/LOGARITHM CONSTANTS

L6,	-2;5312;1653;0406
L5,	-2;3137;6765;6402
L4,	-2;4000;7041;0031
