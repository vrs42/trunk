	COMMON DX,DY
	DIMENSION X(5),Y(5)
10	WRITE(1,2000)
2000	FORMAT('POSITION PLATE ON INNER REFERENCE')
	X(1)=0.
	Y(1)=0.
	CALL RHS
	WRITE(1,2001)
2001	FORMAT('POSITION PLATE ON R(M,R)')
	CALL RHS
	X(2)=DX
	Y(2)=DY
	WRITE(1,2003)
2003	FORMAT('POSITION PLATE ON R(M,L)')
	CALL RHS
	X(3)=DX+X(2)
	Y(3)=DY+Y(2)
	WRITE(1,2004)
2004	FORMAT('POSITION PLATE ON R(B,R)')
	CALL RHS
	X(4)=DX+X(3)
	Y(4)=DY+Y(3)
	WRITE(1,2005)
2005	FORMAT('POSITION PLATE ON OUTER REFERENCE')
	CALL RHS
	X(5)=DX+X(4)
	Y(5)=DY+Y(4)
	WRITE(1,2006)(X(I),I=1,5)
2006	FORMAT('X =',5F6.0)
	WRITE(1,2007)(Y(I),I=1,5)
2007	FORMAT('Y =',5F6.0)
	DX=X(5)
	DY=Y(5)
	CALL STEP(DX,0)
	CALL STEP(DY,2)
	GO TO 10
	END
