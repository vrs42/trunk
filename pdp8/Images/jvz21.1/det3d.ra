/ DOUBLE PRECISION 3 X 3 DETERMINANT
/	FUNCTION DET3D(A)
/
	SECT	DET3
	DPCHK
	JA	#ST
#XR,	ORG	.+3
	TEXT	+DET3  +
#RET,	SETX	#XR
	SETB	#BASE
	JA	.+3
#BASE,	ORG	.+6
AA,	ORG	.+3
	ORG	#BASE+30
	FNOP
	JA	#RET
	FNOP
#RTN,
#GOBAK,	0;0
D,	ORG	.+0006
#LIT,	0000
	0000
	0006
A,	ORG	.+0066
	BASE	#BASE
#ST,	STARTD
	0210
	FSTA	#GOBAK,0
	0200
	SETX	#XR
	SETB	#BASE
	LDX	0,1
	FSTA	#BASE
	FLDA%	#BASE,1+
	FSUB	#LIT+1
	FSTA	AA
	STARTE
 
	LDX	-11,1
	LDX	0,2
#G0001,	FLDA%	AA,2+
	FSTA	A-6,2
	JXN	#G0001,1+
/
	FLDA	A
	FMUL	A+30
	FMUL	A+60
	FSTA	D
	FLDA	A+6
	FMUL	A+36
	FMUL	A+44
	FADDM	D
	FLDA	A+14
	FMUL	A+22
	FMUL	A+52
	FADDM	D
	FLDA	A+14
	FMUL	A+30
	FMUL	A+44
	FNEG
	FADDM	D
	FLDA	A+6
	FMUL	A+22
	FMUL	A+60
	FNEG
	FADDM	D
	FLDA	A
	FMUL	A+36
	FMUL	A+52
	FNEG
	FADD	D
	JA	#RTN
	END
