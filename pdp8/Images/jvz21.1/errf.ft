	FUNCTION ERRF(X)
C	GOES IN WITH X, COMES OUT WITH ERRF(X)
	SIGN=1.
	IF(X)1,5,1
1	SIGN=X/ABS(X)
5	Y=ABS(X)
	IF(Y-3.)20,10,10
10	ERRF=SIGN
	RETURN
20	S=0.
	DX=.1*Y
	X1=-2.*DX
	DO 30 J=1,5
	X1=X1+2.*DX
	Y1=EXP(-X1**2)+4.*EXP(-(X1+DX)**2)+EXP(-(X1+2.*DX)**2)
30	S=S+DX*Y1/3.
	ERRF=S*SIGN*1.1283792
	RETURN
	END
