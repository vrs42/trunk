	SUBROUTINE SCAN(NX)
	COMMON FMSG,SAVE,TABLE
	COMMON A,ALPHA,GAMMA,RL
	COMMON BR,DX,DY
	COMMON DELCY,HALFPI,NMAX,PI,TWOPI,Y2
	COMMON N,XAIR1,YAIR1,XAIR2,YAIR2,XCOL1,XCOL2
	DIMENSION SAVE(8,3),TABLE(6,57)
C	INITIALIZE SUMS
	S1=0.0
	S2=0.0
	S3=0.0
	S4=0.0
	S5=0.0
	S6=0.0
C	SET PARAMETERS FOR SCAN
	K1=-NMAX
	N=2*NMAX-1
	DO 50 I=1,N
C	READ OD
S	6141
S	0110
S	0002
S	DCA \J
	OD=BR-FLOAT(J)
	CALL STAGE(1,3)
	IF (K1) 10,20,30
C	CHANGE SIGN OF SIN
 10	K=-K1
	X1=-TABLE(1,K)
	X2=-TABLE(2,K)
	X3=-TABLE(3,K)
	GOTO 40
 20	K1=1
 30	K=K1+1
	X1=TABLE(1,K)
	X2=TABLE(2,K)
	X3=TABLE(3,K)
40	S1=S1+OD*X1
	CALL STAGE(1,3)
	S2=S2+OD*X2
	S3=S3+OD*X3
	CALL STAGE(1,3)
	X1=TABLE(4,K)
	X2=TABLE(5,K)
	S4=S4+OD*X1
	CALL STAGE(1,3)
	X3=TABLE(6,K)
	S5=S5+OD*X2
	S6=S6+OD*X3
 50	K1=K1+1
C	MOVE STAGE TO RIGHT
	CALL STAGE(NX,1)
C	MOVE STAGE DOWN
	N=8*NMAX-4
	CALL STAGE(N,4)
C	CALCULATE MODULUS OF TRANSFORM AT YJ
	F1=SQRT(S1*S1+S4*S4)
	F2=SQRT(S2*S2+S5*S5)
	F3=SQRT(S3*S3+S6*S6)
C	CALCULATE ARGUMENT PHIJ OF F(YJ)
	P1=ATAN2(S1,S4)
	P2=ATAN2(S2,S5)
	P3=ATAN2(S3,S6)
C	CHECKS FOR INTERPOLATION
	IF ((P1+P3-2.0*P2)-HALFPI) 60,70,70
 60	IF ((2.0*P2-P1-P3)-HALFPI) 130,100,100
 70	IF (P3-P1) 80,90,90
 80	P1=P1-TWOPI
	GOTO 130
 90	P3=P3-TWOPI
	GOTO 130
 100	IF (P3-P1) 110,120,120
 110	P3=P3+TWOPI
	GOTO 130
 120	P1=P1+TWOPI
 130	CONTINUE
C	CALCULATE COEFFICIENTS OF QUADRATIC
	A=(F1+F3-2.0*F2)/(2.0*DELCY*DELCY)
	B=(F3-F1)/(2.0*DELCY)
C	COMPUTE A,ALPHA,GAMMA,L
	RL=1.0/(Y2+(B/(-2.0*A)))
	D=(P3-P1)/(2.0*DELCY)
	GAMMA=D/TWOPI
	ALPHA=RL*((P1+P2+P3)/3.+(B/(-2.0*A))*D)/TWOPI
	A=F2-(B*B)/(4.0*A)
	RETURN
	END
