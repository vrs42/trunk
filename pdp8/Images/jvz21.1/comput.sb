/COMPUT.SB
/FOLLOWING HAS BEEN OPTIMIZED FOR USE
/IN SECOM1 AND SECOM2 PROGRAMS.
/ 5/22/77
/
/ASSEMBLY:
/.R SABR
/*COMPUT<COMPUT/F
/AND IGNORE THE I-TYPE ERROR MESSAGES
/
FORTR 
OPDEF	TADI	1400
OPDEF	DCAI	3400
/      SUBROUTINE COMPUT
ENTRY COMPU
COMPU, BLOCK 2
/ 
/   THIS ROUTINE DOES THE MATRIX COMPUTATIONS.
/   NEEDS MEMR.RL 
/ 
/      COMMON NS1,NS2,LD,KSEQ,KSQN,KPRG,NVOL,TTAB,LIST,LISTX,ITAB,IS1,
/      DIMENSION IS1(30),IS2(120),IP(122),ITAB(27,27),
/   EFFECTIVE M(32,121) FROM MEMR ROUTINES
/ 
/   COMPUTE COMPARISON MATRIX
/      CALL MEMI
CALL 0,MEMI
/
/      DO 49  J=1,NS2
DCA \J
ZZA, ISZ \J
TAD \J
CIA 
TAD \NS2
SPC 
JMP ZZB
     TAD  \J
     7421    /MQ SHOWS J
/      JJ=IS2(J)
CALL 2,SUBSC
ARG \J
ARG \IS2
[0
TAD I [0
DCA \JJ
     TAD  \JJ
     CLL RTR;RTR;RTR
     AND  (77
     TAD  (-33
     SMA SZA
     CLA
     TAD  (33
     DCA  \JJ
/ 
/      IPP=0
DCA \IPP
/      IF(IP(J)+2016)20,22,20
CALL 2,SUBSC
ARG \J
ARG \IP
[0
TAD I [0
TAD (3740
SNA CLA 
JMP \22
/20    IF(IP(J)+1120)21,22,21
\20,	TAD I [0
TAD (2140
SNA CLA 
JMP \22
/21    IPP=-1
\21, IAC 
CIA 
DCA \IPP
/22    CONTINUE
\22, NOP 
/
PAGE
/
	6214		/RDF
	TAD	(6201
	DCA	CDF1	/SETS DF TO CURRENT
	TAD	CDF1
	DCA	CDF2
/      DO 47  I=1,NS1
DCA I1
ZZC, ISZ I1
TAD I1
CIA 
TAD \NS1
SPC 
JMP ZZD
/      II=IS1(I)
CLA CMA
TAD I1
TAD ADIS1
DCA TMPV
6211		/CDF 1
TADI TMPV
CDF1,	HLT
     CLL RTR;RTR;RTR
     AND  (77
     TAD  (-33
     SMA SZA
     CLA
     TAD  (33
     DCA  \II
/37    MM=ITAB(II,JJ)
\37, CLA CMA
	TAD	\JJ
	7421		/LOAD MQ WITH J-1
	7405		/MULTIPLY
	33		/BY 27
	7501		/PRODUCT TO AC
	TAD	(-1
	TAD	\II	/+II-1
	TAD	ADTAB	/+ADDRESS OF ITAB
	DCA	TMPV
	6211		/CDF 1
	TADI	TMPV
CDF2,	HLT
	DCA \MM
	TAD	\J
	7421
/      IF(IPP)41,46,41
TAD \IPP
SNA CLA 
JMP \46
/41    MM=-1
\41, IAC 
CIA 
DCA \MM
/              M(I,J)=MM
/              IJ=J*32+I
\46, TAD  \J
     CLL RTL;RTL;RAL
     TAD  I1
     DCA  TMPV
/      CALL MEMST(IJ,MM)
	TAD	\MM
	6271
	DCAI	TMPV
	DCA	ZZZZZ
/47    CONTINUE
\47,	JMP ZZC
ZZD, 
/49    CONTINUE
\49,	JMP ZZA
/
ADIS1,	\IS1
ADTAB,	\ITAB
TMPV,	0
I1,	0
/
PAGE
/
TMPX,	0
ZZB, 
/ 
/   COMPUTE SANKOF V0 MATRIX
/
/      DO 59  J=2,NS2
IAC 
CIA 
TAD (2
DCA J
ZZE, ISZ J
TAD J
CIA 
TAD \NS2
SPC 
JMP ZZF
     TAD  J
     CLL RTL;RTL;RAL
     DCA  JJ
     CLA CLL CMA 
     TAD  J
     CLL RTL;RTL;RAL
     DCA  JJM
/      DO 58  I=2,NS1
IAC 
CIA 
TAD (2
DCA II
ZZG,	DCA	ZZZZZ		/FORCES CDF CURRENT
 ISZ II
TAD II
CIA 
TAD \NS1
SPC 
JMP ZZH
/      M(I,J)=M(I-1,J-1)+M(I,J)
     TAD  JJ
     TAD  II
     DCA  IJ
     CLA CLL CMA 
     TAD  JJM
     TAD  II
     DCA  TMPX
/      MM=MEMR(IJ)+MEMR(IJK)
	6271		/CDF 7
	TADI	TMPX
	DCA	TMPA
	TAD	IJ
	DCA	TMPX
	TADI	TMPX
	TAD	TMPA
/      CALL MEMST(IJ,MM)
	DCAI	TMPX
/58    CONTINUE
\58,	JMP ZZG
ZZH, 
/59    CONTINUE
\59, NOP 
JMP ZZE
II,	0
J,	0
JJ,	0
JJM,	0
IJK,	0
IJ,	0
TMPA,	0
/
PAGE
/
\K,	0
TMPZ,	0
ADLIST,	\LIST
/
ZZF, 
/ 
/   DO DIAGONAL SEARCH
/      J2=NS2-LD+1
TAD \LD
CIA 
TAD \NS2
IAC 
DCA \J2
/      I2=NS1-LD+1
TAD \LD
CIA 
TAD \NS1
IAC 
DCA \I2
/      DO 79  JJ=1,J2
DCA \JJ
ZZI, ISZ \JJ
TAD \JJ
CIA 
TAD \J2
SPC 
JMP ZZJ
/      J=JJ-1
IAC 
CIA 
TAD \JJ
DCA \J
     TAD  \J
     7421    /MQ SHOWS J
/      DO 78  II=1,I2
DCA \II
ZZK, ISZ \II
TAD \II
CIA 
TAD \I2
SPC 
JMP ZZL
/      I=II-1
IAC 
CIA 
TAD \II
DCA \I
/      ISC=0
DCA \ISC
/      K=2
TAD (2
DCA \K
/      IF(I) 63,63,61
TAD \I
SNA 
JMP \63
SPC 
JMP \63
/61    IF(J) 63,63,62
\61, TAD \J
SNA 
JMP \63
SPC 
JMP \63
JMP \62
/  62          ISC=M(I,J)
\62, TAD  \J
     CLL RTL;RTL;RAL
     TAD  \I
     DCA  \IJ
/      ISC=MEMR(IJ)
	TAD	\IJ
	DCA	TMPZ
	6271		/CDF 7
	TADI	TMPZ
ZZZ1,	DCA \ISC
/  63          ISC=M(I+LD,J+LD)-ISC
\63, TAD  \J
     TAD  \LD
     CLL RTL;RTL;RAL
     TAD  \I
     TAD  \LD
     DCA  \IJ
/      ISC=MEMR(IJ)-ISC
	TAD	\IJ
	DCA	TMPZ
	6271
	TADI	TMPZ
ZZZ2,	CIA
	TAD	\ISC
	CIA
DCA \ISC
/64    KM1=K-1
\64, IAC 
CIA 
TAD \K
DCA \KM1
/      IF(ISC-LIST(K)) 70,70,66
	CLA CMA
	TAD	\K
	TAD	ADLIST
	DCA	TMPZ
	6211		/CDF 1
	TADI	TMPZ
ZZZ3,	CIA 
TAD \ISC
SNA 
JMP \70
SPC 
JMP \70
/66    LIST(KM1)=LIST(K)
\66, CALL 2,SUBSC
ARG \KM1
ARG \LIST
[0
CALL 2,SUBSC
ARG \K
ARG \LIST
[1
TAD I [1
DCA I [0
/      DO 67  IK=1,5
DCA \IK
ZZM, ISZ \IK
TAD \IK
CIA 
TAD (5
SPC 
JMP ZZN
/67    LISTX(KM1,IK)=LISTX(K,IK)
\67, TAD (26
CALL 3,SUBSC
ARG \IK
ARG \KM1
ARG \LISTX
[0
TAD (26
CALL 3,SUBSC
ARG \IK
ARG \K
ARG \LISTX
[1
TAD I [1
DCA I [0
JMP ZZM
ZZN, 
/      K=K+1
IAC 
TAD \K
DCA \K
/      GO TO 64
JMP \64
/70    IF(K-2) 78,78,71
\70, TAD (2
CIA 
TAD \K
SNA 
JMP \78
SPC 
JMP \78
/71    LIST(KM1)=ISC
\71, CALL 2,SUBSC
ARG \KM1
ARG \LIST
[0
TAD \ISC
DCA I [0
/      LISTX(KM1,1)=NVOL
TAD (26
CALL 3,SUBSC
ARG (1
ARG \KM1
ARG \LISTX
[0
TAD \NVOL
DCA I [0
/      LISTX(KM1,2)=KSEQ
TAD (26
CALL 3,SUBSC
ARG (2
ARG \KM1
ARG \LISTX
[0
TAD \KSEQ
DCA I [0
/      LISTX(KM1,3)=KSQN
TAD (26
CALL 3,SUBSC
ARG (3
ARG \KM1
ARG \LISTX
[0
TAD \KSQN
DCA I [0
/      LISTX(KM1,4)=II
TAD (26
CALL 3,SUBSC
ARG (4
ARG \KM1
ARG \LISTX
[0
TAD \II
DCA I [0
/      LISTX(KM1,5)=JJ+(KSQN-1)*100-2
TAD (26
CALL 3,SUBSC
ARG (5
ARG \KM1
ARG \LISTX
[0
IAC 
CIA 
TAD \KSQN
CALL 1,MPY
ARG (144
TAD \JJ
CIA 
TAD (2
CIA 
DCA I [0
/78    CONTINUE
\78, NOP 
JMP ZZK
ZZL, 
/79    CONTINUE
\79, NOP 
JMP ZZI
ZZJ, 
/      KPRG=2
TAD (2
DCA \KPRG
ZZS, 
/      RETURN
RETRN COMPU
/      END
CALL 0,EXIT
[0, BLOCK 2
[1, BLOCK 2
END 
LAP 
\NS1, COMMN 1
\NS2, COMMN 1
\LD, COMMN 1
\KSEQ, COMMN 1
\KSQN, COMMN 1
\KPRG, COMMN 1
\NVOL, COMMN 1
\TTAB, COMMN 3
\LIST, COMMN 26
\LISTX, COMMN 156
\ITAB, COMMN 1331
\IS1, COMMN 36
\IS2, COMMN 170
\IP, COMMN 172
\STTL, COMMN 3
\COFF, COMMN 3
\NR, COMMN 1
\TITLE, COMMN 22
\J, BLOCK 1
\JJ, BLOCK 1
\IPP, BLOCK 1
\I, BLOCK 1
\II, BLOCK 1
\MM, BLOCK 1
\IJ, BLOCK 1
\JJM, BLOCK 1
\IJK, BLOCK 1
\J2, BLOCK 1
\I2, BLOCK 1
\ISC, BLOCK 1
\KM1, BLOCK 1
\IK, BLOCK 1
ZZZZZ, BLOCK 1
[A, BLOCK 1
DUMMY [0
DUMMY [1
CPAGE 6
EAP 
CALL 0,OPEN
PAUSE 
