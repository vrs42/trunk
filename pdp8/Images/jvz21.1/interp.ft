	SUBROUTINE INTERP(XX,YY,Y,X)
C	INTERPOLATION OF ERROR FUNCTION INTEGRALTO GET ARG.
C	CALLED BY DIFUSC.FT
C	METHOD IS THAT SUGGESTED BY W.P.A. TABLES BOOK
C
	DIMENSION X(41),Y(41)
	TPI=1.1283792
	DO 10 I=1,41
	IF(XX-X(I))20,20,10
10	CONTINUE
20	I=I-1
	A=XX-X(I)
	B=XX-X(I+1)
	IF(A-ABS(B))40,40,30
30	I=I+1
	A=B
40	HP=TPI*EXP(-Y(I)**2)
	R=A/HP
	YY=Y(I)*(1.+R**2)+R
	RETURN
	END
