C	DIFUS2.FT CHAINED FROM DIFUSC.FT
C	NEEDS LSQSE SUBROUTINE
C
	COMMON NTOT,X,Y
	DIMENSION X(500),Y(500)
C
	CALL IOPEN('DTA1','FILDUM')
	READ(4,2003)(IDUM,X(I),Y(I),I=1,NTOT)
2003	FORMAT(I4,F6.2,E13.6)
	CALL LSQSE(A,SEA,B,SEB,1,NTOT,X,Y)
	WRITE(1,2007)A,SEA
	WRITE(1,2008)B,SEB
2007	FORMAT('D(0) ='E13.6' +/-'E13.6)
2008	FORMAT('SLOPE ='E13.6' +/-'E13.6///)
	CALL CHAIN('DIFUSC')
	END
