C	GELSCN.FT TO SCAN GELS AND OTHER THINGS
C	NEEDS TRHS, STAGE SUBROUTINES
C  AXIS3,PLOTS,PENUP,PENDN,MOVE ALL .FT ALSO NEEDED
C  D.C.T.2-27-79
C
	COMMON BR,DX,DY,IDIS
	COMMON IXY,IYY
	DIMENSION IDIS(2,2)
	DIMENSION IXY(2,500),IYY(500)
	WRITE(1,2005)
	WRITE(1,2008)
	READ(1,1000)MAG
1000	FORMAT(' TYPE STEPS FROM CENTER SCAN (I3):' ,I3)
1	WRITE(1,2002)
2002	FORMAT(/' POSITION PLATE:' ,/,'  1) AT START OF SCAN' )
	CALL RHS
	XSUM=0.
	YSUM=0.
	WRITE(1,2003)
2003	FORMAT('  2) AT END OF SCAN' )
	CALL RHS
	XSUM=DX
	YSUM=DY
	XF=DX
	CALL STEP(XSUM,0)
	CALL STEP(YSUM,2)
	IF(YSUM)5,10,5
5	WRITE(1,2001)
2001	FORMAT(' CAUTION! SCANS ALONG X ONLY' )
C	NOW GET NO. TIMES TO CALL STAGE
10	INX=XF/500.+1.
C	INX IS INCREMENT BETWEEN OD READINGS
	NOD=XF/FLOAT(INX)
C	MOVE STAGE DOWN 2 MAG
	J=2*MAG
	CALL STAGE(J,4)
	DO 25 I=1,500
	IXY(1,I)=I
25	IXY(2,I)=0
	DO 50 J=1,3
	CALL STAGE(MAG,3)
	DO 30 I=1,NOD
S	6141
S	0114
S	0002
S	DCA \K
	IXY(2,I)=IXY(2,I)-K/3
30	CALL STAGE(INX,1)
C	RETURN STAGE FOR NEXT SCAN
40	OD=FLOAT(INX)*FLOAT(NOD)
50	CALL STEP(OD,0)
C	RETURN TO ORIGIN
	CALL STAGE(MAG,4)
C GET MAX AND MIN OD
	IMIN=512
	IMAX=-512
	DO 100 I=1,NOD
	IF(IXY(2,I)-IMIN)60,70,70
60	IMIN=IXY(2,I)
70	IF(IXY(2,I)-IMAX)100,100,80
80	IMAX=IXY(2,I)
100	CONTINUE
C  SMOOTH IXY(2,I) INTO IYY(I)
	JOD=NOD-1
	DO 105 I=2,JOD
	L=I-1
	M=I+1
	S=0.
	DO 104 K=L,M
104	S=S+FLOAT(IXY(2,K))/3.
	SIGN=S/ABS(S)
105	IYY(I)=S+SIGN*.5
	DO 106 I=2,JOD
106	IXY(2,I)=IYY(I)
	YMULT=500./FLOAT(IMAX-IMIN)
	DO 110 I=1,NOD
	IYY(I)=IXY(2,I)
110	IXY(2,I)=FLOAT(IYY(I)-IMIN)*YMULT-250.
2005	FORMAT(' POT 0 TO SET LEFT' )
2008	FORMAT(' POT 4 TO SET RIGHT AND ZERO' )
120	M1=IABS(NALOG(0))-1
	M2=IABS(NALOG(4))-1
	M3=NALOG(1)
	M3=FLOAT(M3-IMIN)*YMULT-250.
	CALL DISP2(NOD,IXY)
	CALL DISP6(M1)
	CALL DISP6(M2)
	CALL DISP5(M3)
	IF(KEYBD(0))120,120,130
130	SUM=0.
	SUMR=0.
	SUMRQ=0.
	FJ=M3+250
	J=FJ/YMULT+FLOAT(IMIN)
	IF(J-IMIN)132,138,134
132	WRITE(1,1034)
1034	FORMAT(' BL . LT . IMIN, MOVE UP')
	GO TO 120
134	IF(J-IMAX)138,136,136
136	WRITE(1,1035)
1035	FORMAT(' BL . GE . IMAX, MOVE DOWN')
	GO TO 120
138	M4=NALOG(1)
	WRITE(1,1038)J,IMIN,IMAX,YMULT,M3,M4
1038	FORMAT(' J',I4,' IMIN',I4,' IMAX',I4/' YMULT',F12.5,' M3',I4,I4)
	AGM=FLOAT(M2-M1)
	RREF=M1
	DO 140 I=M1,M2
	OD=IYY(I)-J
	RF=(FLOAT(I)-RREF)/AGM
	SUMR=SUMR+OD*RF
	SUMRQ=SUMRQ+OD*RF*RF
140	SUM=SUM+OD
	RQ=SUMRQ/SUM
	RBAR=SUMR/SUM
	SIG=SQRT(RQ-RBAR**2)
	WRITE(1,2012)
2012	FORMAT(/,' C TO GET PEAKS, P TO PLOT, Q TO EXIT'//)
	WRITE(1,2006)SUM
2006	FORMAT(' TOTAL AREA = ' ,F12.0)
	WRITE(1,2010)RBAR,SIG
2010	FORMAT(' RF-BAR:',F9.5,' +/-',F9.5)
150	M1=IABS(NALOG(0))-1
	M2=IABS(NALOG(4))-1
	CALL DISP2(NOD,IXY)
	CALL DISP5(M3)
	CALL DISP6(M1)
	CALL DISP6(M2)
	M=KEYBD(0)
C C IS 195, THEN P IS 208 AND Q = 209
	IF(M-195)150,160,200
160	SUM1=0.
	SUMR1=0.
	SUMR2=0.
	DO 170 I=M1,M2
	OD=IYY(I)-J
	RF=(FLOAT(I)-RREF)/AGM
	SUMR1=SUMR1+OD*RF
	SUMR2=SUMR2+OD*RF*RF
170	SUM1=SUM1+OD
	RAT=SUM1/SUM
	WRITE(1,2007)SUM1,RAT
2007	FORMAT('    PEAK AREA = ' ,F12.0,'   RATIO = ' ,F8.2)
	RQ=SUMR2/SUM1
	RBAR=SUMR1/SUM1
	SIG=SQRT(RQ-RBAR**2)
	WRITE(1,2011)RBAR,SIG
2011	FORMAT(' RF-PEAK:',F9.5,' +/-',F9.5)
	GO TO 150
200	IF(M-208)150,210,300
210	XMIN=RREF
	XMAX=AGM+RREF
	NHL=10
	IDIS(1,1)=RREF
	IDIS(2,1)=M3
	CALL PENDN(2000)
	CALL DISP1(1,IDIS)
	WRITE(1,2013)
2013	FORMAT(' PEN DOWN AT R(F) = 0; PRESS CONT.')
S	HLT
	CALL AXIS(XMIN,XMAX,NHL)
C	SUBROUTINE AXIS(ZMIN,ZMAX,NHL)
	IDIS(1,2)=IXY(1,1)
	IDIS(2,2)=IXY(2,1)
	CALL MOVE
	CALL PLOTER(NOD,IXY)
300	WRITE(1,2009)
2009	FORMAT(///)
	GO TO 1
	END
