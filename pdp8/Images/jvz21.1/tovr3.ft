C	TOVR3.FT NEEDS:TRHS.FT,STAGE.SB
C	SAVE AS OVER3.SV
C
	COMMON FMSG,SAVE,TABLE
	COMMON A,ALPHA,GAMMA,RL
	COMMON BR,DX,DY
	COMMON DELCY,HALFPI,NMAX,PI,TWOPI,Y2
	COMMON N,XAIR1,YAIR1,XAIR2,YAIR2,XCOL1,XCOL2
	COMMON XIR,XOR
	COMMON NCELL,XM,YM,GMSG,ICOUNT,XS,YS,XD,YD
	DIMENSION SAVE(8,3),TABLE(6,57)
	DIMENSION XM(6),YM(6),GMSG(3)
	IF (FMSG)40,50,40
50	READ(1,1002)NCELL
1002	FORMAT('INPUT NUMBER OF CHANNELS(I1):',I1)
	READ(1,1000)N
1000	FORMAT('INPUT STEPS BETWEEN SCANS(I3):',I3)
	XSUM=0.
	YSUM=0.
	READ(1,1001)(GMSG(I),I=1,NCELL)
1001	FORMAT('TYPE TITLE,A6:'A6)
	DO 100 I=1,NCELL
	J=2*I
	WRITE(1,2000)
2000	FORMAT(/,'7) ON TOP OF COLUMN FOR SCAN')
	CALL RHS
	XSUM=XSUM+DX
	YSUM=YSUM+DY
	XM(J-1)=XSUM
	YM(J-1)=YSUM
	WRITE(1,2001)
2001	FORMAT(/,'8) ON BOTTOM OF COLUMN FOR LENGTH OF SCAN')
	CALL RHS
	XSUM=XSUM+DX
	YSUM=YSUM+DY
	XM(J)=XSUM
100	YM(J)=YSUM
C	RETURN TO WIRE
	CALL STEP(XSUM,0)
	CALL STEP(YSUM,2)
	ICOUNT=0
40	ICOUNT=ICOUNT+1
	IF(ICOUNT-NCELL)60,60,55
55	CALL CHAIN('OVER1')
60	J=2*ICOUNT
	XCOL1=XM(J-1)
	XCOL2=XM(J)
	YCOL1=YM(J-1)
	YCOL2=YM(J)
	FMSG=GMSG(ICOUNT)
	WRITE(1,2012)FMSG
2012	FORMAT(/,A6)
	WRITE(1,2014)XIR,XOR
2014	FORMAT(/,'X(IR) ='F6.0/'X(OR) ='F6.0/)
	IF (ICOUNT-1)70,70,65
65	XAIR1=XAIR1-3.
	XAIR2=XAIR2-3.
70	WRITE(1,2011)
2011	FORMAT('      AIR 1  MENISCUS    BOTTOM     AIR 2')
	WRITE(1,2006)XAIR1,XCOL1,XCOL2,XAIR2
2006	FORMAT('X',4F10.0)
	WRITE(1,2007)YAIR1,YCOL1,YCOL2,YAIR2
2007	FORMAT('Y',4F10.0)
	WRITE(1,2010)
2010	FORMAT(/,6X,'X',6X,'A',2X,'ALPHA',2X,'GAMMA',6X,'L')
	XS=0.
	YS=0.
	DO 20 J=1,3
	WRITE(1,2008)XAIR1,(SAVE(I,J),I=1,4)
	XS=XS+XAIR1
	YS=YS+SAVE(2,J)
20	XAIR1=XAIR1+1.
	XS=XS/3.
	YS=YS/3.
	WRITE(1,2013)XS,YS
2013	FORMAT(F7.0,7XF7.1)
	XD=0.
	YD=0.
	WRITE(1,2009)
2009	FORMAT(/)
	DO 30 J=1,3
	WRITE(1,2008)XAIR2,(SAVE(I,J),I=5,8)
	XD=XD+XAIR2
	YD=YD+SAVE(6,J)
30	XAIR2=XAIR2+1.
	XD=XD/3.
	YD=YD/3.
	WRITE(1,2013)XD,YD
2008	FORMAT(F7.0,4F7.1)
	WRITE(1,2009)
	CALL CHAIN('OVER4')
	END
