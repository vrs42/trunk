/ DISPSL.RA  TO SET CODE FOR STRAIGHT LINE SEGMENTS
/ BETWEEN DATA POINTS
/
	FIELD1  #DISPX
#XR,	ORG	.+3
	TEXT	+DISPSL+
#RET,	SETX	#XR
	SETB	#BASE
	JA	.+3
#BASE,	ORG	.+6
	ORG	#BASE+30
	FNOP
	JA	#RET
	FNOP
#GOBAK,	0;0
	BASE	#BASE
/
	ENTRY DISPSL
DISPSL,	STARTD
	0210
	FSTA	#GOBAK,0
	0200
	SETX	#XR
	SETB	#BASE
	LDX	0,1
	FSTA	#BASE
	STARTF
	TRAP4	PL2SL
	JA	#GOBAK
/
	ENTRY	DISPSM
DISPSM,	STARTD
	0210
	FSTA	#GOBAK,0
	0200
	SETX	#XR
	SETB	#BASE
	LDX	0,1
	FSTA	#BASE
	STARTF
	TRAP4	PL2SM
	JA	#GOBAK
/
/ ROUTINE TO SET JMS INSTRUCTION, TO STRAIGHT LINE ROUTINE
PL2SL,	0
	IOF
	TAD	SLFLG
	SZA CLA
	JMP	.+14
	TAD	M6141
	CMA IAC
	TADZ	41	/SHOULD BE 6141
	SZA CLA
	HLT
	TAD	PLT2AD+1
	DCAZ	0177	/ADDRESS IN PAGE ZERO LOC 0177
	TAD	M4577	/JMS I INSTRUCTION
	DCAZ	41
	CLA IAC
	DCA	SLFLG
	CDF CIF 0
	ION
	JMP%	PL2SL
/
/ROUTINE TO RESTORE LINC INSTRUCTION
PL2SM,	0
	IOF
	TAD	M6141
	DCAZ	41
	DCA	SLFLG
	CDF CIF 0
	ION
	JMP%	PL2SM
SLFLG,	0
M4577,	4577
M6141,	6141
PLT2AD,	ADDR	PLOT2
/
/8-MODE SECTION FOR USE WITH FORTRAN IV
/PLOT ROUTINE, TO CONNECT DATA POINTS BY STRAIGHT
/LINE SEGMENTS
/THIS ROUTINE REQUIRES THE USE OF THE EAE HARDWARE OPTION.
/ TO BE ENTERED FROM JMS AT LOC 10041.
/
/
	FIELD1	#PLOT2
N,	0
NT,	0
TEMP,	0
X2,	0
Y2,	0
DX,
X1,	0
DY,
Y1,	0
SAVMQ,	0
DFLG,	0
/
/ROUTINE TO PLOT LINE SEGMENTS
/SEGMENTS ARE DISPLAYED ONE THIRD AS OFTEN
/AS DATA POINTS
/
PLOT2,	0
	IOF	/NO INTERRUPTS PLEASE
	DCA	Y2	/Y WAS IN AC
	TADZ	17	/X FROM ALPHA REG 17
	DCA	X2
	TAD	NT
	SZA CLA
	JMP	PLT2S
	TAD	DFLG
	SZA
	JMP	PLT2S
	7501
	DCA	SAVMQ	/SAVE MQ
	TAD X2
	CIA
	TAD X1
	DCA DX 		/X1-X2
	TAD Y2
	CIA
	TAD Y1
	DCA DY 		/Y1-Y2
	TAD DX
	SPA
	CIA
	DCA TEMP 	/ABS(DX)
	TAD DY
	SPA
	CIA
	DCA NPTS 	/ABS(DY)
	TAD NPTS
	CIA
	TAD TEMP
	SPA CLA
	JMP .+3
	TAD TEMP
	DCA NPTS
	TAD NPTS	/MAX(ABS(DX),ABS(DY))
	CLL RAR
	CLL RAR
	SNA
	IAC
	DCA NPTS 	/ NPTS/4, OR 1
	TAD NPTS
	CIA
	DCA TEMP	/-NPTS
	TAD NPTS
	DCA NPTS1
	DCA II
	DCA II1
/
/PLOT LOOP TO INTERPOLATE BETWEEN ELEMENTS OF IXY.
PLUP2,	TAD DX
	SPA
	CIA
	7425 /MQL MUY
II,	0		/COUNTS UP FROM ZERO
	7407 /DVI
NPTS,	0
	CLA CLL CML RAR /SET AC=4000, L=0
	TAD DX 		/COMPLEMENT LINK IF DX<0.
	7701	 	/CLA MQA
	SZL
	CIA
	TAD X2
	DCAZ	17	/SET ALPHA REG 17
	TAD DY
	SPA
	CIA
	7425 /MQL MUY
II1,	0
	7407 /DVI
NPTS1,	0
	CLA CLL CML RAR /SET AC=4000, L=0.
	TAD DY 		/COMPLEMENT LINK IF DY<0.
	7701 /CLA MQA
	SZL
	CIA
	TAD Y2
	6141 /LINC
	0157 /DIS 17
	0002 /PDP
	CLA
	ISZ II
	ISZ II1
	ISZ TEMP
	JMP PLUP2
/
PLT2R,	TAD X2		/SETS OLD POINTS
	DCA X1
	TAD Y2
	DCA Y1
	DCA	DFLG
	CLA CLL IAC
	TADZ	120	/TEST PAGE 0 LOC 120 = -1
	SZA CLA
	JMP	.+13
	IAC
	DCA	DFLG	/DFLG=1 IF LAST POINT
	ISZ	NT
	NOP
	CLA CMA
	TAD	NT	/CHECK NT=1
	SZA CLA
	JMP	.+3
	CMA RTL
	DCA	NT	/NT=-3
	TAD	SAVMQ
	7421
	ION		/REENABLE INTERRUPTS
	JMP% PLOT2	/RETURN
/
PLT2S,	TAD Y2
	6141	/LINC
	 157	/DIS 17
	 002	/PDP
	CLA CLL
	JMP  PLT2R
	END
