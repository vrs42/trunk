/DISMQ.RA
/  FUNCTION DISMQ(N) DISPLAYS LOWER 12 BITS OF N IN MQ REGISTER
	SECT8	#DISMQ	/EVERYTHING GOES IN ONE PAGE
#XR,	ORG	.+3
	TEXT	+DISMQ+
#RET,	SETX	#XR
	SETB	#BASE
	JA	.+3
#BASE,	ORG	.+6
N,	ORG	.+3
	ORG	#BASE+30
	FNOP
	JA	#RET
	FNOP
#GOBAK,	0;0
	BASE	#BASE
/
	ENTRY DISMQ
DISMQ,	STARTD
	0210
	FSTA	#GOBAK,0
	0200
	SETX	#XR
	SETB	#BASE
	LDX	0,1
	FSTA	#BASE
	FLDA%	#BASE,1+
	FSTA	N
	STARTF
	FLDA%	N
	ATX	0
	TRAP4	MQLD
	JA	#GOBAK
/
/  8-MODE ROUTINE TO DISPLAY N IN MQ REGISTER
MQLD,	0
	IOF
	TAD	#XR
	7421
	CDF CIF	0
	ION
	JMP%	MQLD
	END
