/	SUBROUTINE STAGE(NSTEPS,DIRECTION)
	LAP
OPDEF	TADI 1400
OPDEF	JMPI 5400
/
/	GETARG FETCHES THE NEXT ARGUMENT
/
TEMP,
GETARG,	0
DIRECT,
GET1,	0		/CHANGE TO DF OF CALLING PROGRAM
	TADI STAGE#
	INC STAGE#
	DCA GET2
	TADI STAGE#
	INC STAGE#
MNSTEPS,
GET2,	0		/CHANGE TO DF OF ARG
	DCA GET2
	TADI GET2
GET3,	0		/CHANGE TO DF OF THIS PROGRAM
	JMPI GETARG
TABP,	TABP		/TABLE OF STEPPING PATTERNS
	7776;7775;7773;7767
NSTEPS,	0		/NUMBER OF STEPS
/
/	SUBROUTINE STAGE(NSTEPS,DIRECTION)
/
	ENTRY STAGE
STAGE,	BLOCK 2
	TAD (K6201
	6214
	DCA GET3
	CLA CLL CML RTL	/ACC = 2
	TAD STAGE
	DCA MOVE8	/SET UP FOR QUICK RETURN
	TAD STAGE
	DCA GET1
	JMS GETARG	/FETCH NSTEPS
	DCA NSTEPS
	JMS GETARG	/FETCH DIRECTION
	DCA DIRECT
	TAD NSTEPS	/CHECK FOR ILLEGAL ARG
	SNA
	JMP MOVE7	/RETURN ARG = 0
	SPC
	JMP MOVE7	/RETURN ARG < 0
	TAD DIRECT
	CIA
	TAD (D12
	TAD (K0400
	DCA MOVE2	/STORE INSTRUCTION TO SENSE LIMIT SWITCH
	TAD DIRECT
	TAD TABP
	DCA TEMP
	TADI TEMP
	DCA DIRECT	/SET PATTERN WORD FOR STEPPING
	TAD NSTEPS
	CIA
	DCA MNSTEPS	/SAVE MINUS THE NUMBER OF STEPS
MOVE1,	CLA CLL IAC	/ACC = 1
	6141		/LINC
	0407		/SXL A-M SWITCH
	0011		/CLEAR ACC IF A-M IS ON
MOVE2,	0		/SXL LIMIT SWITCH
	0011		/CLEAR ACC IF LIMIT SWITCH IS ON
	0002		/PDP
	SNA CLA		/ALL SWITCHES OFF?
	JMP MOVE9	/NO, PROCESS ERROR
	TAD DIRECT	/LOAD STEP PATTERN
	6346		/START STEP
	CLA CLL		/50 MICSEC DELAY & RAMP ROUTINE
	TAD MNSTEPS	/ACC = -NO. OF STEPS LEFT
	RAL		/*2
	CLL		/
	TAD NSTEPS	/+NO. OF STEPS
	CLA SZL		/IF LINC = 0, NOT HALFWAY
	JMP MOVE3	/JMP IF NOT HALFWAY
	TAD NSTEPS	/ACC = NO. OF STEPS
	TAD MNSTEPS	/ACC = NO. OF STEPS TAKEN
	CIA		/NEGATE
	SKP		/
MOVE3,	TAD MNSTEPS	/ACC = -NO. OF STEPS LEFT
	TAD (K100	/+DELAY CONSTANT
	SPA		/MINIMUM DELAY = 0
	CLA		/
	CMA		/EFFECTIVE - DELAY
	DCA TEMP	/SET DELAY
	6601		/4 MICSEC DELAY
	CLA CLL		/MORE DELAY
	TAD (K17	/
	6346		/FLIP FLOPS OFF
	CLA CMA
	TAD NSTEPS	/IMMEDIATE EXIT IF 1 STEP
	SNA CLA
	JMP MOVE7
	TAD (K7565	/DELAY 700 MICSECS
MOVE4,	IAC		/
	SZA		/
	JMP MOVE4	/
MOVE5,	TAD (K7770	/61 MICSEC DELAY BLOCKS
MOVE6,	IAC		/
	SZA		/
	JMP MOVE6	/
	ISZ TEMP	/REPEAT 61 MICSEC DELAY TEMP TIMES
	JMP MOVE5	/
	ISZ MNSTEPS	/INCR AND TEST -NO. OF STEPS
	JMP MOVE1	/
MOVE7,	CLA CLL		/CLEAR ACC BEFORE RETURNING
MOVE8,	0		/CHANGE TO DF & IF OF CALLING PROGRAM
	JMPI STAGE#	/QUICK RETURN
MOVE9,	CALL 2,WRITE
	ARG (1
	ARG MOVE10
	CALL 1,IOH
	ARG 0
	HLT		/
	JMP MOVE1	/CONTINUE PROCESSING
MOVE10,	TEXT *('SW HIT')*
	END
