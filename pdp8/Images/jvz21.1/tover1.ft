C	TOVER1.FT NEEDS:TRHS.FT,STAGE.SB
C	CHAINS TO TOVR2.FT (OVER2.SV)
C	SAVE AS OVER1.SV
C
	COMMON FMSG,SAVE,TABLE
	COMMON A,ALPHA,GAMMA,RL
	COMMON BR,DX,DY
	COMMON DELCY,HALFPI,NMAX,PI,TWOPI,Y2
	COMMON N,XAIR1,YAIR1,XAIR2,YAIR2,XCOL1,XCOL2
	COMMON XIR,XOR
	DIMENSION SAVE(8,3),TABLE(6,57)
C	ROUTINE TO CALCULATE COS-SIN TABLE INITIALLY
C	SET PARAMETERS
	READ(1,1000)SEP
1000	FORMAT('TYPE FRINGE SEPARATION (F4.0):',F4.0)
	FMSG=0.
	WRITE(1,2000)
2000	FORMAT('FOR LOW SPEED EQUIL. SET SENSE SWITCH 0 = 1 NOW')
	NMAX=56
	STEPSIZE=40.0
	Y2=1.0/SEP
	TOL=0.03/SEP
	Y1=Y2-TOL
	Y3=Y2+TOL
	DELCY=Y2-Y1
	HALFPI=2.0*ATAN(1.0)
	PI=4.0*ATAN(1.0)
	TWOPI=8.0*ATAN(1.0)
	X=TWOPI*STEPSIZE
	ARG1=X*Y1
	ARG2=X*Y2
	ARG3=X*Y3
	M=NMAX+1
C	CALCULATE TABLE
	DO 10 J=1,M
	K=J-1
	X=FLOAT(K)
	ARG11=X*ARG1
	ARG22=X*ARG2
	ARG33=X*ARG3
	TABLE(1,J)=SIN(ARG11)
	TABLE(2,J)=SIN(ARG22)
	TABLE(3,J)=SIN(ARG33)
	TABLE(4,J)=COS(ARG11)
	TABLE(5,J)=COS(ARG22)
 10	TABLE(6,J)=COS(ARG33)
C	SET FLAG FOR FIRST TIME LOADED
	WRITE(1,2002)
2002	FORMAT(/,'POSITION PLATE:',/,' 1)ON REFERENCE WIRE')
	CALL RHS
	WRITE(1,2003)
2003	FORMAT(/,' 2)FOR BACKGROUND')
	CALL STAGE(400,4)
	CALL RHS
	OD=0.
	DO 20 I=1,100
S	CPAGE 7
S	6141
S	0110
S	0002
S	DCA \J
	OD=OD+FLOAT(J)
20	CALL STAGE(1,1)
	BR=OD/100.
	CALL STAGE(100,2)
	CALL STAGE(400,3)
	CALL STEP(DX,0)
	CALL STEP(DY,2)
	CALL STAGE(50,1)
C	CALL IN OVERLAY 2
	IF(ISENS(0))30,30,40
30	CALL CHAIN('OVER2')
40	CALL CHAIN('LOVER2')
	END
