	SUBROUTINE SEPCOR(NPOIT,YMIN,NBAS)
C	SUBROUTINE FOR EPROG1.FT WHICH CORRECTS FOR
C	BAD FRINGE DISCONTINUITIES,BAD PTS,ETC
C	IN EQUIVALENT BOUNDARY PROFILES
C
	COMMON X,Y,SEPR,DELX,IDUM,RIR,ROR,IY,IB,IXY
	DIMENSION X(150),Y(150),IY(150),IB(150),IXY(2,150)
	WRITE(1,2003)
2003	FORMAT('F TO COR PTS FROM CURSOR TO RT.,Q TO CONT.,E TO EDIT')
	WRITE(1,2004)
2004	FORMAT('1,2,..I, TO ADD I*SEPRN;-1,-2,..-I TO SUBTRACT')
	MULT=3
	IF(NPOIT-85)10,10,20
10	MULT=6
20	DO 30 I=1,NPOIT
30	IXY(1,I)=MULT*I
33	YMAX=Y(NPOIT)
	YMIN=Y(1)
	DO 40 I=1,NPOIT
	IF(Y(I)-YMAX)240,240,35
35	YMAX=Y(I)
240	IF(Y(I)-YMIN)250,40,40
250	YMIN=Y(I)
40	CONTINUE
	YMULT=500./(YMAX-YMIN)
	DO 50 I=1,NPOIT
50	IXY(2,I)=IFIX(YMULT*(Y(I)-YMIN))-250
60	M1=IABS(NALOG(0))-1
	CALL DISP1(NPOIT,IXY)
	CALL DISP2(NPOIT,IXY)
	CALL DISP6(M1)
	L=KEYBD(0)
	IF(L-197)60,70,100
70	K=M1/MULT+1
	Y(K)=(Y(K+1)+Y(K-1))*.5
	GO TO 33
100	IF(L-198)110,110,150
110	K=M1/MULT+1
	READ(1,1005)FI
1005	FORMAT('CORRECTION:'F3.0)
	DO 80 I=K,NPOIT
80	Y(I)=Y(I)+FI*SEPR
	GO TO 33
150	IF(NBAS)180,180,155
155	WRITE(1,2005)
2005	FORMAT('PUT CURSOR ON X(PLATEAU), STRIKE ANY KEY')
160	M1=IABS(NALOG(0))-1
	CALL DISP1(NPOIT,IXY)
	CALL DISP2(NPOIT,IXY)
	CALL DISP6(M1)
	IF(KEYBD(0))160,160,170
170	NPOIT=M1/MULT+1
180	RETURN
	END
