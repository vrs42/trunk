/ X- AND Y-CURSOR DISPLAY ROUTINES
/ DISP5 FOR Y-CURSOR; DISP6 FOR X-CURSOR
/ CURSOR FLASHES ONCE PER CALL
/
/ DISP5B AND DISP6B FOR BACKGROUND CURSOR DISPLAY,
/
	SECT	DISP56
	EXTERN  #DISP
	EXTERN	ONQB
	EXTERN	#NE
/ SHARED LOCATIONS FOR ALL ROUTINES
#XR,	ORG	.+3
	TEXT	+DISP56+
#RET,	SETX	#XR
	SETB	#BASE
	JA	.+3
#BASE,	ORG	.+6
N,	ORG	.+3
	ORG	#BASE+30
	FNOP
	JA	#RET
	FNOP
#GOBAK,	0;0
#RTN,	BASE	#BASE
	JA	#GOBAK
	ORG	#BASE+41	/STAY ON 3-WORD ADDRESS
F512,	F	512.
F1024,	F	1024.
/
/SHARED ROUTINE TO GET ARGUMENT AND TEST RANGE
#SETUP,	JA  .
	STARTD
	0210
	FSTA	#GOBAK,0
	0200
	SETX	#XR
	SETB	#BASE
	LDX	0,1
	FSTA	#BASE
	FLDA%	#BASE,1+
	FSTA	N
	STARTF
	FLDA%	N
	FSUB	F512
	JGE	.+10
	FADD	F1024
	JLT	.+5
/ 1024 (O2000) REPLACES OUT OF RANGE ARGUMENT
	FLDA%	N
	JA	.+3
	FLDA	F1024
	SETX	CURS1X
	ATX	0
	JA	#SETUP
/
	ENTRY 	DISP5
DISP5,	JSA	#SETUP
	TRAP4	CURSY1
	SETX	#XR
	JA	#RTN
/
	ENTRY	DISP5B
DISP5B,	JSA	#SETUP
	TRAP4	YCRC2
	SETX	#XR
	JA	#RTN
/
	ENTRY DISP6
DISP6,	JSA	#SETUP
	TRAP4	CURSX1
	SETX	#XR
	JA	#RTN
/
	ENTRY DISP6B
DISP6B,	JSA	#SETUP
	TRAP4	XCRC2
	SETX	#XR
	JA	#RTN
/
/
	FIELD1	CURSXY
/  8-MODE ROUTINE TO DISPLAY X-CURSOR ONCE
	ENTRY	CURSX1
CURSX1,	ZBLOCK	1
	IOF
	TAD	CURS1X	/HORIZ POSITION
	JMS	DISCX	/FOR DISPLAY
	CDF CIF 0
	ION
	JMP%	CURSX1
/
/BACKGROUND ROUTINE FOR X-CURSOR CONTROL
	ENTRY	XCRCB
XCRCB,	0
	IOF
	TAD	NXCR	/#CURSORS
	SNA
	JMP	XCRB2	/IMMEDIATE RETURN IF NO CURSORS
	CIA
	DCA	TMP+6
	TAD	TMPADR+1	/ADDRESS OF TMP
	DCA	TMP
	ISZ	TMP
	TAD%	TMP	/POSITION (FROM LIST)
	JMS	DISCX		/FOR DISPLAY
	ISZ	TMP+6		/IF ALL CURSORS DISPLAYED
	JMP	.-4
XCRB2,	ION
	JMP%	XCRCB
/
/X-CURSOR SETUP ROUTINE
	ENTRY	XCRC2
XCRC2,	0
	IOF
	TAD	XINIT
	SZA CLA
	JMP	.+6
	JMS%	XONQB+1
	ADDR	XCRCB
	CLA CMA
	DCA	XINIT	/SO ONQB IS CALLED ONLY ONCE
	TAD	N2000
	TAD	CURS1X		/CHECK RESET SIGNAL
	SNA CLA
	JMP	XCRC3
	TAD	NXCR
	TAD	N5
	SMA CLA			/TOO MANY CURSORS?
	JMP	.+7		/DON'T INCLUDE
	ISZ	NXCR	/INCREMENT # CURSORS
	TAD	TMPADR+1
	TAD	NXCR
	DCA	TMP+6		/WHERE IN LIST
	TAD	CURS1X		/POSITION
	DCA%	TMP+6
	CDF CIF 0
	ION
	JMP%	XCRC2
/  RESET PATH
XCRC3,	DCA	NXCR		/ZERO X AND Y CURSOR COUNTS
	DCA%	NXCR+2
	JMP	.-5
/
DISCX,	0		/X-CURSOR DISPLAY
	DCA	.+3
	6141
	0062		/SET ALPHA REGISTER 2
	0		/TO POSITION
	002
	TAD	N377
	DCA	CNT
	TAD	N377
	6141
	0142		/DISPLAY
	002
	IAC
	IAC		/EVERY OTHER POINT
	ISZ	CNT
	JMP	.-6
	CLA CLL
	JMP%	DISCX
/
XONQB,	ADDR	ONQB
TMPADR,	ADDR	TMP
TMP,	ZBLOCK 10
CURS1X,	0		/FOR ATX DEPOSIT
CNT,	0
NXCR,	0
	ADDR	NYCR
XINIT,	0
N5,	-5
N377,	-377
N777,	-777
N2000,	-2000
/
/
/  8-MODE ROUTINE TO DISPLAY Y-CURSOR
	ORG	CURSXY+200	/NEW PAGE
	ENTRY	CURSY1
CURSY1,	ZBLOCK	1
	IOF		/INTERRUPTS OFF
	TAD%	CURS1Y+1	/VERTICAL POSITION
	JMS	DISCY	/FOR DISPLAY
	CDF CIF	0
	ION
	JMP%	CURSY1
/
/ BACKGROUND ROUTINE FOR Y-CURSOR DISPLAY
	ENTRY	YCRCB
YCRCB,	0
	IOF
	TAD	NYCR	/#CURSORS
	SNA
	JMP	YCRB2	/IMMEDIATE RETURN IF NO CURSORS
	CIA
	DCA	YTMP+6
	TAD	YTMPAD+1
	DCA	YTMP
	ISZ	YTMP
	TAD%	YTMP	/POSITION (FROM LIST)
	JMS	DISCY		/FOR DISPLAY
	ISZ	YTMP+6
	JMP	.-4
YCRB2,	ION
	JMP%	YCRCB
/
/Y-CURSOR SETUP ROUTINE
	ENTRY	YCRC2
YCRC2,	0
	IOF
	TAD	YINIT
	SZA CLA
	JMP	.+6
	JMS%	YONQB+1
	ADDR	YCRCB
	CLA CMA
	DCA	YINIT	/SO ONQB IS CALLED ONLY ONCE
	TAD	NN2M
	TAD%	CURS1Y+1
	SNA CLA		/CHECK RESET SIGNAL
	JMP	YCRC3
	TAD	NYCR
	TAD	NN5
	SMA CLA		/TO MANY CURSORS?
	JMP	.+7
	ISZ	NYCR	/INCREMENT # CURSORS
	TAD	YTMPAD+1	
	TAD	NYCR
	DCA	YTMP+6
	TAD%	CURS1Y+1		/POSITION
	DCA%	YTMP+6
	CDF CIF 0
	ION
	JMP%	YCRC2
YCRC3,	DCA	NYCR
	DCA%	NYCR+2
	JMP	.-5
/
DISCY,	0		/Y-CURSOR DISPLAY
	DCA	YTMP+7	/SAVE POSITION
	6141
	0062		/ZERO ALPHA REGISTER 2
	0
	002
	TAD	NN377
	DCA	YCNT
	TAD	YTMP+7	/GET POSITION
	6141
	162		/DISPLAY
	002
	ISZZ	2	/EVERY OTHER POINT
	ISZ	YCNT
	JMP	.-5
	CLA CLL
	JMP%	DISCY
/
YONQB,	ADDR	ONQB
YTMPAD,	ADDR	YTMP
YTMP,	ZBLOCK 10
CURS1Y,	ADDR	CURS1X
YCNT,	0
NYCR,	0
	ADDR	NXCR
YINIT,	0
NN5,	-5
NN377,	-377
NN777,	-777
NN2M,	-2000
	END
