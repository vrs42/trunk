	SUBROUTINE LSQ(AI,BS,NSTART,NSTOP,X,Y)
C	MODIFIED FROM PH.D. THESIS FOR
C	LO SPEED EQUIL APRIL 1973 D.C.T.
C	THIS VERSION CALLED BY DIFUSC.FT
	DIMENSION X(40),Y(40)
C	STRAIGHT LINE LEAST SQUARES
	N=NSTOP-NSTART+1
	FN=N
	SUMX=0.
	SUMY=0.
	SUMXQ=0.
	SUMXY=0.
	J=NSTART-1
	DO 10 I=1,N
	J=J+1
	XJ=X(J)
	YJ=Y(J)
	SUMX=SUMX+XJ
	SUMY=SUMY+YJ
	SUMXQ=SUMXQ+XJ**2
10	SUMXY=SUMXY+XJ*YJ
	BS=(SUMXY-SUMX*SUMY/FN)/(SUMXQ-SUMX*SUMX/FN)
	AI=SUMY/FN-BS*SUMX/FN
	RETURN
	END
