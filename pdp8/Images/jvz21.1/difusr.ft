C	PATTERNED FROM DIFUSE.FT FOR RAYLEIGH DATA
	COMMON IXY
	DIMENSION IXY(2,150)
	DIMENSION X(150),Y(150),DYDX(150)
5	XMIN=5.8
	XMAX=7.2
	XMULT=500./(XMAX-XMIN)
	READ(1,1000)FMSG
1000	FORMAT('TYPE INPUT TITLE (A6):',A6)
	YMIN=0.
	YMAX=0.
	CALL IOPEN('DTA1',FMSG)
	READ(4,2000)NPOIT
2000	FORMAT(I4)
	DO 50 I=1,NPOIT
	READ(4,2001)X(I),DYDX(I)
2001	FORMAT(4XF7.4,6XF6.1)
	IXY(1,I)=(X(I)-XMIN)*XMULT
	IF(DYDX(I)-YMIN)20,30,30
20	YMIN=DYDX(I)
30	IF(DYDX(I)-YMAX)50,50,40
40	YMAX=DYDX(I)
50	CONTINUE
	YMULT=500./(YMAX-YMIN)
	DO 60 I=1,NPOIT
60	IXY(2,I)=IFIX((DYDX(I)-YMIN)*YMULT)-250
	WRITE(1,2002)
2002	FORMAT('PUT CURSOR ON YMAX')
70	M1=IABS(NALOG(0))
	CALL DISP1(NPOIT,IXY)
	CALL DISP2(NPOIT,IXY)
	CALL DISP6(M1)
	IF(KEYBD(0))70,70,80
80	M1=M1+1
	DO 90 I=1,NPOIT
	IF(IXY(1,I)-M1)90,100,90
90	CONTINUE
	WRITE(1,2003)
2003	FORMAT('WRONG INDEX ON SCREEN, TRY AGAIN')
	GO TO 70
100	ISTART=I-3
	NTIM=I+4-ISTART
	CALL DERIV(A2,A3,DYDX,Y,7,ISTART,NTIM)
	TM=-A2/A3
	DELX=X(3)-X(2)
	XB=DELX*TM+X(I)
	T=-3.
	M=I-2
	NTIM=I+2
	A1=0.
	A2=0.
	A3=0.
	DO 125 I=M,NTIM
	T=T+1.
	A1=A1+DYDX(I)
	A2=A2+DYDX(I)*T
125	A3=A3+DYDX(I)*(3.*T**2-6.)/6.
	A1=A1/5.
	A2=A2/2.5
	A3=A3/3.5
	YINFL=A1+A2*TM+A3*(3.*TM**2-6.)/6.
	YINFL=YINFL/1.648721
C	TEMP WRITE-OUT OF VALUES
	L=M+2
	WRITE(1,2020)L,X(L),DYDX(L),XB,YINFL
2020	FORMAT(I4,4F12.6)
	IYINF=(YINFL-DYMIN)*YMULT-250.
	WRITE(1,2006)
2006	FORMAT('PUT X-CURSORS ON Y(INFLCT)')
131	CALL DISP1(NPOIT,IXY)
	CALL DISP2(NPOIT,IXY)
	CALL DISP5(IYINF)
	M2=IABS(NALOG(4))
	M1=IABS(NALOG(0))
	CALL DISP6(M2-1)
	CALL DISP6(M1-1)
	IF(KEYBD(0))131,131,140
140	XI=FLOAT(M2-M1)/(2.*XMULT)
	XQ=XI**2
	WRITE(1,2005)FMSG,XI,XQ
2005	FORMAT('TITLE:',A6,' HAS X(I) =',F9.5,/,'X(I)^2 = ',E12.5,///)
	GO TO 5
	CALL EXIT
	END
