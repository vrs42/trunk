C	DIFUSC.FT TO COMPUTE D FROM RAYLEIGH FRINGE DATA
C	NEEDS: INTERP,TABL,ERRF,LSQ SUBROUTINES
C	USE METHOD OF LONGSWORTH JACS 74,4155(1952).
C	USES OUTPUT FROM EPROG1.FT SERIES OF PROGS
C	CHAIN TO DIFUS2.FT FOR FINAL LEAST SQUARES
C
	COMMON NTOT,X,CDAPP,CBAR,GMSG,TIMES,DBAR
	DIMENSION X(150),C(150),DAPP(40),CBAR(40)
	DIMENSION U(41),ERF(41)
	DIMENSION GMSG(40),TIMES(40),DBAR(40)
C	SET UP TABLE OF ERROR FUNCTION
	CALL TABL(U,ERF)
C	READ TITLES AND TIMES
1	CALL OOPEN('DTA1','FILDUM')
	READ(1,999)NFRAM
999	FORMAT('# FRAMES TO BE CALC (I2):'I2)
	DO 5 I=1,NFRAM
	WRITE(1,997)I
997	FORMAT(I2,':')
	READ(1,1000)GMSG(I)
1000	FORMAT('INPUT TITLE:'A6)
5	READ(1,998)TIMES(I)
998	FORMAT('TIME (MIN.) (F6.2):'F6.2)
	WRITE(1,990)(I,GMSG(I),TIMES(I),I=1,NFRAM)
990	FORMAT(I2,1XA6,1XF7.2)
6	READ(1,996)P
996	FORMAT('EDIT TITLE OR TIME? (YES OR NO):'A6)
	IF(P-'YES   ')8,7,8
7	READ(1,995)I
995	FORMAT('FRAME # (I2):'I2)
	READ(1,1000)GMSG(I)
	READ(1,998)TIMES(I)
	GO TO 6
8	DO 1600 INDIC=1,2
	NTOT=0
	DO 1500 IJK=1,NFRAM
	FMSG=GMSG(IJK)
	CALL IOPEN('DTA1',FMSG)
	READ(4,1001)NPOIT
1001	FORMAT(I4)
	READ(4,1002)(X(I),C(I),I=1,NPOIT)
1002	FORMAT(4XF7.4,F6.2)
C	GET C-PLATEAU
	N=NPOIT-4
	SUM=0.
	DO 10 I=N,NPOIT
10	SUM=SUM+C(I)
	C0=SUM/5.
	ISTAR=1
	ISTOP=NPOIT
C	DELETE DATA
	DO 50 I=1,NPOIT
	IF(C(I)-.05*C0)20,30,30
20	ISTAR=I
30	IF(C(I)-.95*C0)40,40,50
40	ISTOP=I
50	CONTINUE
	ISTAR=ISTAR+1
	K=0
	DO 60 I=ISTAR,ISTOP
	K=K+1
	X(K)=X(I)
60	C(K)=C(I)
	NPOIT=ISTOP-ISTAR+1
C	GET 1ST PT G.T. C0/2
	DO 70 I=1,NPOIT
	IF(C(I)-.5*C0)70,70,80
70	CONTINUE
80	MID=I
	NSTOP=MID-1
	NTEST=NPOIT-MID+1
	IF(NSTOP-NTEST)100,100,90
90	NSTOP=NTEST
C	NOW LOOK UP ERROR FUN AND CALC D
100	DO 150 I=1,NSTOP
	J=MID+I-1
	PH1=ABS((2.*C(I)-C0)/C0)
	PH2=ABS((2.*C(J)-C0)/C0)
C	GET Z1,Z2
	CALL INTERP(PH1,Z1,U,ERF)
	CALL INTERP(PH2,Z2,U,ERF)
	DX=X(J)-X(I)
	DEL=DX/(Z1+Z2)
	DAPP(I)=DEL**2/4.
150	CBAR(I)=(C(I)+C(J))/2.
C	NOW GET MEAN AND SIGMA DAPP,LINEAR REGRESSION,ETC
	WRITE(1,2002)FMSG,TIMES(IJK)
2002	FORMAT(//'TITLE: 'A6' AT'F7.2' MINUTES'/)
	IF(INDIC-1)157,157,153
153	DO 170 I=1,NSTOP
170	DAPP(I)=DAPP(I)/(60.*TIMES(IJK))
	WRITE(4,2003)(I,CBAR(I),DAPP(I),I=1,NSTOP)
	NTOT=NTOT+NSTOP
	WRITE(1,2003)(I,CBAR(I),DAPP(I),I=1,NSTOP)
2003	FORMAT(I4,F6.2,E13.6)
	CALL LSQ(D0,SL,1,NSTOP,CBAR,DAPP)
	WRITE(1,2004)D0,SL
2004	FORMAT(/'D(0) ='E13.6' SLOPE ='E13.6)
157	SUMX=0.
	SUMXQ=0.
	DO 160 I=1,NSTOP
	SUMX=SUMX+DAPP(I)
160	SUMXQ=SUMXQ+DAPP(I)**2
	FN=NSTOP
	DBAR(IJK)=SUMX/FN
	SIG=SQRT((SUMXQ-DBAR(IJK)*SUMX)/FN)
	CAV=C0/2.
	WRITE(1,2000)CAV
2000	FORMAT(/'C0/2 ='F7.3/)
	WRITE(1,2001)DBAR(IJK),SIG
2001	FORMAT('D(APP) ='E13.6' +/-'E13.6//)
1500	CONTINUE
	IF(INDIC-1)180,180,1600
180	CALL LSQ(TZ,DAV,1,NFRAM,TIMES,DBAR)
	DT=TZ/DAV
	DO 190 I=1,NFRAM
190	TIMES(I)=TIMES(I)+DT
	WRITE(1,2005)DAV,DT
2005	FORMAT('D(AVE) ='E13.6' DELTA-T ='F7.2' MIN')
1600	CONTINUE
	SUMX=0.
	SUMXQ=0.
	DO 200 I=1,NFRAM
	DB=DBAR(I)
	SUMX=SUMX+DB
200	SUMXQ=SUMXQ+DB**2
	FN=NFRAM
	XBAR=SUMX/FN
	SIG=SQRT(SUMXQ/FN-XBAR*SUMX/FN)
	WRITE(1,2006)XBAR,SIG
2006	FORMAT(//'D(TOT) ='E13.6' +/-'E13.6)
	CALL OCLOSE
	CALL CHAIN('DIFUS2')
	END
