	COMMON M
	DIMENSION M(1400),LINE(60),ITITL(57)
	KK=371
	KSEQ=10
	M(4)=-1376
	WRITE(1,1000)
1000	FORMAT('SEQUENCE REFORMATTING'/'INPUT FROM SEQXXX.DA '
     1	' OUTPUT TO SEQVVV.DA')
	CALL OOPEN('DSK','SEQVVV')
	CALL IOPEN('DSK','SEQXXX')
10	KM=0
	KN=1
12	READ(4,1010) L,Z,(LINE(I), I=1,60)
1010	FORMAT(A1,A3,60A1)
	IF(L-1056)15,44,15
15	IF(L-416) 16,44,16
16	IF(L-352) 18,22,18
18	IF(L-1312)20,22,20
20	STOP
22	IF(Z-'ITL ') 23,12,23
23	DO 25  I=2,1400,2
	N=I
	IF(M(I)+1376)25,26,25
25	CONTINUE
C
26	IF(N-242)28,27,28
27	N=240
28	I1=1
31	I2=I1+239
	JK=0
	IF(I2-N)33,33,32
32	I2=N
	JK=1
33	NS=I2/2-(KN-1)*100-JK
	WRITE(4,1030)KSEQ,KN,NS,KK,ZT,ITITL
1030	FORMAT(I5,I2,I4,I4,1X,A3,58A1)
	WRITE(4,1034)(M(I), I=I1,I2)
1034	FORMAT(4X,60A1)
	KN=KN+1
	I1=I1+200
	IF(I1-N+40) 31,31,40
40	KSEQ=KSEQ+5
	IF(L-352)41,80,41
41	LT=L
	ZT=Z
	DO 43  I=1,57
43	ITITL(I)=LINE(I)
	GO TO 10
C
44	CONTINUE
	DO 45  I=1,60
45	M(I+KM)=LINE(I)
	KM=KM+60
	GO TO 12
80	WRITE(1,1080)
1080	FORMAT('END')
	CALL OCLOSE
	STOP
	END
