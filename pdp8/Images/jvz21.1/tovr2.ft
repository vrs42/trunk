C	TOVR2.FT NEEDS:TRHS.FT,STAGE.SB,TSCAN9.FT,TATAN2.FT
C	SAVE AS OVER2.SV
C	CHAINS TO OVER3.SV
C
	COMMON FMSG,SAVE,TABLE
	COMMON A,ALPHA,GAMMA,RL
	COMMON BR,DX,DY
	COMMON DELCY,HALFPI,NMAX,PI,TWOPI,Y2
	COMMON N,XAIR1,YAIR1,XAIR2,YAIR2,XCOL1,XCOL2
	COMMON XIR,XOR
	DIMENSION SAVE(8,3),TABLE(6,57)
 2004	FORMAT(//,' 3) FOR SCAN')
2006	FORMAT(//,' 4) ON INNER REFERENCE EDGE')
2007	FORMAT(//,' 5) ON OUTER REFERENCE EDGE')
 2005	FORMAT(//,' 6) ON AIR FRINGE, READY TO SCAN')
	WRITE (1,2004)
	CALL RHS
	XAIR1=50.0+DX
	YAIR1=DY
	CALL STAGE(222,4)
	J=0
	L=1
 30	DO 40 I=1,3
	CALL SCAN(1)
	SAVE(1+J,I)=A
	SAVE(2+J,I)=ALPHA
	SAVE(3+J,I)=GAMMA
 40	SAVE(4+J,I)=RL
	CALL STAGE(222,3)
	GO TO (50,60),L
50	WRITE(1,2006)
	CALL STAGE(95,1)
	CALL RHS
	XIR=95.+XAIR1+DX+3.
	YIR=DY
 	L=2
	J=4
	WRITE (1,2007)
	CALL STAGE(2000,1)
	CALL STAGE(1495,1)
	CALL RHS
	XOR=3495.+XIR+DX
	WRITE(1,2005)
	CALL STAGE(50,1)
	CALL RHS
	XAIR2=50.+XOR+DX+3.
	YAIR2=DY
	CALL STAGE(222,4)
	GOTO 30
 60	CALL STEP(DY,2)
	CALL STEP(XAIR2,0)
	XAIR2=XAIR2-3.
	CALL CHAIN('OVER3')
	END
