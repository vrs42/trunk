	COMMON X,IY,IB,X1,DELB,NBAS
	COMMON Y
	DIMENSION X(150),IY(150),IB(150)
	DIMENSION Y(150)
C	CORRECT FOR BASELINE AND SUBTRACT MIN Y VALUE
1	READ(1,1998)FMSG
1998	FORMAT('TYPE EQUIL TITLE,A6:'A6)
	READ(1,2000)DELX
2000	FORMAT('STEPSIZE(F3.0)'F3.0)
	READ(1,2001)XLAST
2001	FORMAT('X(LAST)(F4.0)'F4.0)
	READ(1,2002)XIR,XOR
2002	FORMAT('XIR,XOR(2F4.0)'2F4.0)
	READ(1,2003)YIR,YOR
2003	FORMAT('YIR,YOR(2F3.1)'2F3.1)
	SL=(YOR-YIR)/(XOR-XIR)
	CALL IOPEN('DTA1',FMSG)
	SSEP=0.
10	READ(4,2004)X(1),IY(1),ISEP
	IF(X(1)-X1)10,20,20
20	NPOIT=(XLAST-X(1))/DELX+1.
	DO 30 I=2,NPOIT
	READ(4,2004)X(I),IY(I),ISEP
2004	FORMAT(F6.0,2I4)
	IY(I)=-SL*(X(I)-X(1))+FLOAT(IY(I))
30	SSEP=SSEP+FLOAT(ISEP)
	SSEP=SSEP/FLOAT(NPOIT-1)
C	INTERPOLATE BASELINE CORRECTION
	DO 40 I=1,NPOIT
	CALL INTRPL(I,COR)
40	IY(I)=IY(I)-IFIX(COR+.5)
C	NOW CORRECT FOR FRINGE DISCONTINUITY
	SEP=0.
	DO 50 I=2,NPOIT
	IF(IY(I-1)-IY(I)-25)50,50,45
45	SEP=SEP+SSEP
50	Y(I)=FLOAT(IY(I))+SEP
C	FIND MIN Y VALUE AND TRANSFER TO IY
	RMIN=FLOAT(IY(1))
	DO 60 I=2,NPOIT
	IF(Y(I)-RMIN)55,60,60
55	RMIN=Y(I)
60	CONTINUE
C	SUBTRACT MIN+1 SO LOWEST POINT IS 1
	Y(1)=FLOAT(IY(1))
	DO 70 I=1,NPOIT
70	Y(I)=Y(I)-RMIN+1.
	WRITE(1,2005)NPOIT,SSEP
2005	FORMAT(I3/F5.1)
	N=NPOIT+1
	IF(N-150)71,75,75
71	DO 73 I=N,150
	X(I)=0.
73	Y(I)=0.
75	J=NPOIT/3+1
	J2=2*J
	K=J
	DO 77 I=1,J
	K=K+1
	J2=J2+1
77	WRITE(1,2006)I,X(I),Y(I),K,X(K),Y(K),J2,X(J2),Y(J2)
2006	FORMAT(3(3XI4,F6.0,F7.1))
C	CALL CHAIN TO MENISCUS ROUTINES
C	AT PRESENT CHAIN BACK TO PROG1
	X1=X(1)
	DELB=DELX
	NBAS=NPOIT
80	READ(1,2007)I
2007	FORMAT('EDIT ANY POINTS?(0=NO,PT # IF YES):'I3)
	IF(I)190,100,190
190	READ(1,2009)COR
2009	FORMAT('CORRECT ALL PTS,TYPE CORRN (0=1 POINT)(F6.1):',F6.1)
	IF(COR)105,90,105
105	DO 110 J=1,NPOIT
110	Y(J)=Y(J)+COR
	GO TO 75
90	READ(1,2008)Y(I)
2008	FORMAT('TYPE CORRECT Y VALUE(F4.0):'F4.0)
	GO TO 80
100	CALL CHAIN('PROG3')
	END
