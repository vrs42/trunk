	SECT	STAGE
	JA	#ST
#XR,	ORG	.+10
	TEXT	+STAGE+
#RET,	SETX	#XR
	SETB	#BASE
	JA	.+3
#BASE,	ORG	.+6
NSTEP,	ORG	.+3
IDIR,	ORG	.+3
	ORG	#BASE+30
	FNOP
	JA	#RET
	FNOP
#GOBAK,	0;0
FMNST,	ORG	.+0003
I,	ORG	.+0003
ID,	ORG	.+0003
IDLY,	ORG	.+0003
K,	ORG	.+0003
#TMP,	ORG	.+0011
#DOTMP,	ORG	.+6
#LIT,	0000		/0.
	0000
	0000
	0001		/1.
	2000
	0000
	0002		/2.
	2000
	0000
	0002		/3.
	3000
	0000
	0006		/40.
	2400
	0000
	0006		/41.
	2440
	0000
	0016		/10000.
	2342
	0000
#RTN,	BASE	#BASE
	JA	#GOBAK
#ST,	STARTD
	0210
	FSTA	#GOBAK,0
	0200
	SETX	#XR
	SETB	#BASE
	LDX	0,1
	FSTA	#BASE
	FLDA%	#BASE,1+
	FSTA	NSTEP
	FLDA%	#BASE,1+
	FSTA	IDIR
	STARTF
	FLDA%	NSTEP
	JLE	.+10
	FSUB	#LIT+3
	JEQ	#60	/FOR SINGLE STEP
	FSUB	#LIT+22
	JLT	.+4
	EXTERN	#EXIT
	JSR	#EXIT	/IF 0>NSTEP>10000
#G0001,	FLDA%	IDIR
	FSTA	ID
	FLDA	#LIT+0014
	FSUB%	NSTEP
	FSTA	FMNST
	FLDA	#LIT+0003
	FSTA	I
	FLDA%	NSTEP
	FSTA	#DOTMP+0000
 
#G0002,	SETX	MOVIX
	FLDA	ID
	ATX	0
	TRAP4	MOVE
	SETX	#XR
/ DELAY COUNT IS MAX0(41-I,40-NSTEP+I,1)
	FLDA	#LIT+0017
	FSUB	I
	FSTA	#TMP+0000
	FLDA	FMNST
	FADD	I
	FSTA	#TMP+0003
	FNEG
	FADD	#TMP
	JGE	.+5
	FLDA	#TMP+0003
	JA	.+3
	FLDA	#TMP
	FMUL	#LIT+11
	FNEG
/ FAST DELAY LOOP
#30,	FADD	#LIT+3
	JLE	#30
 
#50,	FLDA	I
	FADD	#LIT+0003
	FSTA	I
	FSUB	#DOTMP+0000
	JLE	#G0002
	EXTERN	#NE
	JA	#RTN
 
/PATH FOR SINGLE STEP
#60,	SETX	MOVIX
	FLDA%	IDIR
	ATX	0
	TRAP4	MOVE
	JA	#RTN
/
/  8-MODE STEPPING MOTOR ROUTINE
	SECT8	MOVE
	ZBLOCK  1
	IOF		/INTERRUPTS OFF
	CLA CLL
	TAD	MOVIX	/GET DIRECTION
	TAD	TAB+1	/GET ADDRESS OF TABP
	DCA	TEMP
	TAD%   TEMP    /GET STEPPING PATTERN WORD
	6346		/STEP COMMAND
	CLA CLL
	TAD	#M5	/50 USEC DELAY
	DCA	DLYT
	NOP
	ISZ	DLYT
	JMP	.-2
	CLA CMA		/AC=7777
	6346		/OFF
/  CHECK LIMIT SWITCHES
	CLA CLL CMA
	6141		/LINC MODE
	407		/SKIP EXT LVL 7
	017		/COM  AC
	002		/8 MODE
	SNA CLA
	HLT		/HALT ON SW HIT
/
	CDF CIF 0
	ION		/REENABLE INTERRUPTS
	JMP%   MOVE     /RETURN
/
TAB,	ADDR	TABP
TABP,	0
	7776
	7775
	7773
	7767
MOVIX,	0
TEMP,	0
DLYT,	0
#M5,	-5
	END
