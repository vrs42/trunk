C	LOVR4.FT NEEDS:TSCAN9.FT,TATAN2.FT,TSTEP.FT,STAGE.SB
C	SAVE AS LOVER4.SV
C
	COMMON FMSG,SAVE,TABLE
	COMMON A,ALPHA,GAMMA,RL
	COMMON BR,DX,DY
	COMMON DELCY,HALFPI,NMAX,PI,TWOPI,Y2
	COMMON N,XAIR1,YAIR1,XAIR2,YAIR2,XCOL1,XCOL2
	COMMON XIR,XOR
	COMMON NCELL,XM,YM,GMSG,ICOUNT,XT,YT,XS,YS,XD,YD
	DIMENSION SAVE(8,3),TABLE(6,57)
	DIMENSION XM(6),YM(6),GMSG(3),XT(6),YT(6)
 2000	FORMAT(F7.0,4(F7.1))
	NX=N
	XINT=(XCOL2-XCOL1)/FLOAT(N)
	K=IFIX(XINT)+1
	XCOL3=XCOL2-(FLOAT(K-1)*FLOAT(N))
	Y=-XCOL3
	CALL STEP(Y,0)
	Y=-YM(2*ICOUNT-1)
	CALL STEP(Y,2)
C	MAY WANT -Y INSTEAD OF Y IN ABOVE STATEMENT
	CALL STAGE(222,4)
	CALL OOPEN('DTA1',FMSG)
	WRITE(4,2004)XIR,XOR
2004	FORMAT(2F6.0)
	WRITE(4,2003)XS,YS
	WRITE(4,2003)XD,YD
2003	FORMAT(F6.0,F7.1)
	J=K-5
	DO 10 I=1,K
	CALL SCAN(NX)
	IF(I-6)11,11,9
9	IF(I-J)12,11,11
11	WRITE(1,2000)XCOL3,A,ALPHA,GAMMA,RL
12	IA1=IFIX(ALPHA+.5)
2002	FORMAT(F6.0,2I4)
	IA3=IFIX(RL+.5)
	WRITE(4,2002)XCOL3,IA1,IA3
 10	XCOL3=XCOL3+FLOAT(NX)
	XCOL3=9999.
	IA1=999
	WRITE(4,2002)XCOL3,IA1,IA1
	CALL OCLOSE
	Y=XCOL2+FLOAT(NX)
	CALL STEP(Y,0)
	Y=-222.0+YM(2*ICOUNT-1)
	CALL STEP(Y,2)
	N=NX
 	CALL CHAIN('LOVER3')
	END
