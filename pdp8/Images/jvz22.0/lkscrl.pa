/CCL LINK TO SCROLL EDITOR
/THIS PROGRAM PROVIDES LINKAGE BETWEEN THE MONITOR AND
/VERSION 16 OF THE SCROLL EDITOR.  IT CAN BE CALLED BY
/THE CCL EDIT AND CREATE COMMANDS WHEN SAVED ON SYS AS
/EDIT.SV.  SEE SCRL16.WU FOR EXPLANATION OF USE.
/ERIC SWANSON      JULY 6, 1978
/FIXED HANDLER PROBLEM	25 AUGUST (JVZ)
/FIXED EM PROBLEMS	12 DECEMBER (JVZ)
/
USR=	200
BUFR=	2600	/FIELD 1 BUFFER

	*10
IX1,	0	/AUTOINDEX REGISTERS
IX2,	0
	*20
ENTRI,	0	/HANDLER ENTRY POINTS
ENTRO,	0
IBLK1,	0	/FIRST BLOCK OF INPUT FILE
IBLK,	0	/CURRENT INPUT BLOCK
LBLK,	0	/LAST INPUT BLOCK
OBLK1,	0	/FIRST BLOCK OF OUTPUT FILE
OBLK,	0	/CURRENT OUTPUT BLOCK
IDEV,	0	/INPUT DEVICE #
ODEV,	0	/OUTPUT DEVICE #
IFL,	0	/INPUT FILE LENGTH, BLOCKS
OFL,	0	/OUTPUT FILE LENGTH, BLOCKS
BUFD,	2000	/DIRECTORY BUFFER ADDRESS
BUFD4,	2004	/ +4
SAME,	0	/INPUT FILE=OUTPUT FILE FLAG
NNNN,	0	/ =NNNN OPTION
BDL,	0	/B,D,L OPTIONS
TMP,	0
CNT,	0
OFT,	ZBLOCK 5	/OUTPUT FILE TABLE
IFT,	ZBLOCK 5	/INPUT FILE TABLE
HDALT,	10;0;0	/HANDLER ALLOCATION TABLE FOR SCROLL
EXTRA,	12	/# EXTRA BLOCKS REQUESTED


OCTLD,	0		/DECOMPOSE FILE LENGTH
	TAD	(-144
	SPA
	JMP	.+3
	ISZ	NNN
	JMP	OCTLD+1
	TAD	(144-12
	SPA
	JMP	.+3
	ISZ	NNN+1
	JMP	OCTLD+1
	TAD	("0+12
	DCA	NNN+2

	TAD	("[
	DCA I	IX1	/MOVE INTO COMMAND LINE
	TAD	NNN
	DCA I	IX1
	TAD	NNN+1
	DCA I	IX1
	TAD	NNN+2
	DCA I	IX1
	TAD	("]
	DCA I	IX1
	JMP I	OCTLD
NNN,	"0
	"0
	"0
/	MAINLINE
	*200
	JMS	FIRST	/ENTRY FROM MONITOR
	JMS	CHENTR	/CHAINED ENTRY FROM CCL
	JMS	CTLC
	CDF 10
	TAD I	(7646	/ =NNNN OPTION
	DCA	NNNN
	TAD I	(7666	/ =DATE WORD
	DCA	CTLC
	TAD I	(7643	/GET B,D,L OPTIONS
	DCA	BDL
	CDF 0
	TAD	BDL
	RAL
	SMA CLA
	JMS	CKSAME	/DON'T COPY IF ONLY SINGLE FILE
	JMP	AA	/AND NO /B OPTION.

/PATH FOR SINGLE FILE AND NO /B

	TAD	OFL
	SNA
	TAD	IFL
	DCA	OFL
	JMS	FIND	/FIND DIR ENTRY
	DCA	IX2	/POINTS TO .EX
	TAD I	(7644	/CHECK /T OPTION
	AND	[20
	SZA CLA
	TAD I	BUFD4	
	SZA CLA		/IS THERE A DATE WORD?
	TAD	CTLC	/GET SYSTEM DATE
	SNA
	JMP	AC1	/NO /T, NO DATE, ETC.
	DCA I	IX2
	JMS	WRDIR	/CHANGE THE FILE DATE

AC1,	ISZ	DCNT	/CHECKS IF AT END OF
	JMP	AC2	/DIRECTORY SEGMENT
	JMS	RDDIR	/YES, READ NEXT SEGMENT
	TAD	BUFD4	/SETS IX2 TO GET NEXT ENTRY
	JMP	AC3

/NOW LOOK AT NEXT ENTRY TO CHECK AVAILABLE SPACE
AC2,	TAD I	BUFD4	/-# EXTRA INFO WORDS
	CIA
	IAC
	TAD	IX1	/PLUS POINTER TO .EX

AC3,	DCA	IX2
	TAD I	IX2	/FOLLOWING ENTRY
	SNA CLA		/EMPTY?
	JMP	AF1	/EMPTY FOLLOWS
	CLA CLL  CMA RTL  /NOW CHECK TEMPORARY
	TAD I	BUFD4	/-(# EXTRA INFO WORDS +3)
	CIA
	TAD	IX2
	DCA	IX2
	TAD I	IX2	/LOOK AT LENGTH
	SZA CLA		/ZERO LENGTH=TEMPORARY
	JMP	AF2
	TAD	IX1	/SET TO SKIP OVER TEMP
	TAD	(6
	DCA	IX1
	JMP	AC1

AF1,	TAD I	IX2	/-# EMPTY BLKS
	CMA		/# -1
AF2,	CDF 0
	DCA	EXTRA	/PASS TO SCROLL
	TAD	NNNN	/CHECK =NNNN AGAINST FREE SPACE
	CLL CIA
	TAD	EXTRA
	SNL CLA
	JMP	AB2	/GO COPY FILE TO GAIN SPACE
	JMP	SETUP	/OK, CHAIN TO SCROLL

/PATH FOR DIFFERENT FILES (OR SINGLE FILE AND /B)

AA,	CDF 0
	TAD	NNNN	/PATH TO COPY FILE
	SNA
	TAD	(11	/DEFAULT, SET 10 EXTRA BLKS
	IAC		/(SO =NNNN IS CORRECT)
	DCA	EXTRA
	JMS	CKSAME	/CHECK FOR /B
	JMP	AB	/DIFFERENT FILES
	TAD	[213	/.BK
	JMS	DELBK	/DELETE EXISTING .BK FILE
	JMS	RENAM	/RENAME INPUT FILE TO .BK

AB,	TAD	BDL	/CHECK /D
	AND	(400
	SNA CLA
	JMP	AD
	JMS	DELBK	/PRE-DELETE OUTPUT FILE

AB2,	TAD	NNNN	/CHANGE DEFAULT TO 0
	SZA
	IAC
	DCA	EXTRA	/SO FILE CAN OVERWRITE

/NOW COPY FILE

AD,	CDF 0
	JMS	OPEN	/OPEN OUTPUT FILE
	JMS	RD8B	/READ 8 BLKS
	JMS	CTLC
	JMS	WR8B	/WRITE 8 BLKS
	TAD	IBLK
	CIA
	TAD	LBLK
	SMA CLA		/DONE?
	JMP	AD+2
	JMS	CTLC
	JMS	CLOSE	/CLOSE OUTPUT FILE.
	JMP	SETUP	/CHAIN TO SCROLL

CTLC,	0		/CONTROL-C CHECK
	TAD	[200
	KRS
	TAD	(-203
	SNA CLA
	KSF
	JMP I	CTLC
	JMP I	[7605	/IMMEDIATE EXIT

	PAGE
/
/ INITIAL FILE PROCESSING (ENTERED FROM MONITOR)
/ ***NOTE:  THIS CODE MAY NOT BE REEXECUTEABLE

FIRST,	0
	NOP
	CIF	10
	JMS I	[7700	/USRIN
	10
	CIF	10
	JMS I	[USR	/CALL COMMAND DECODER
	5
	5200		/SPECIAL MODE
	NOP
	TAD	(3501	/SET THE JOB STATUS WORD
	DCA I	(7746	/'NOT RESTARTABLE, ETC.'
	TAD	(-5
	JMS	INITL	/MOVE FILE INFO, FETCH HANDLERS

	TAD	OFT+1	/CHECK IF OUTPUT NAME EXISTS
	SZA CLA
	JMP	FRST2
	TAD	IFT+1	/NONE, USE INPUT FILENAME
	DCA	OFT+1
	TAD	IFT+2
	DCA	OFT+2
	TAD	IFT+3
	DCA	OFT+3
	TAD	IFT+4
	DCA	OFT+4
FRST2,	TAD	IDEV
	CIF	10
	JMS I	[USR	/LOOKUP INPUT FILE
	2
	IFT+1
	0
	JMP	ERR2
	TAD	.-3
	DCA	IBLK1
	TAD	.-4
	CIA
	DCA	IFL
	JMS	FINAL
	ISZ	FIRST
	JMP I	FIRST
/
INITL,	0		/TRANSFER FILE TABLES
	TAD	(-5
	DCA	CNT
	TAD	[7577
	DCA	IX1	/TO PAGE ZERO
	TAD	(OFT-1
	DCA	IX2
	CDF 10
	TAD I	IX1
	CDF 0
	DCA I	IX2
	ISZ	CNT
	JMP	.-5

	TAD	OFT
	SNA
	TAD	IFT	/IF NO OUTPUT SPECIFIED, USE INPUT
	DCA	OFT
	TAD	IFT
	AND	[17
	DCA	IDEV	/INPUT DEVICE #
	TAD	OFT
	AND	[17
	DCA	ODEV	/OUTPUT DEVICE #
	TAD	OFT+4
	TAD	(-213	/.BK ILLEGAL
	SNA CLA
	JMP	ERR3

	JMS	FETCHO	/FETCH OUTPUT DEVICE HANDLER
	TAD	IDEV	/INPUT DEVICE #
	SNA
	JMP	NOINFL	/NO INPUT FILE?
	CIA
	TAD	ODEV	/SAME AS OUTPUT DEVICE?
	SNA CLA
	JMP	INIT2
	TAD	IDEV
	CIF	10
	JMS I	[USR	/FETCH INPUT DEVICE HANDLER
	1
	6401		/INTO LOC 6400 (MAYBE 7000)
	JMP	ERR2
	TAD	.-2
	DCA	ENTRI	/STORE HANDLER ENTRY POINT
	JMP I	INITL
INIT2,	TAD	ENTRO
	JMP	.-3

FINAL,	0		/SET A FEW POINTERS
	TAD	IBLK1
	DCA	IBLK
	TAD	OBLK1
	SNA
	TAD	IBLK1
	DCA	OBLK1
	CLA CMA
	TAD	IBLK1
	TAD	IFL
	DCA	LBLK	/LAST BLOCK
	DCA	OFL
	JMP I	FINAL

	PAGE
/ INITIAL FILE PROCESSING (CHAINED ENTRY)
/ ***NOTE:  THIS CODE MAY NOT BE REEXECUTABLE

CHENTR,	0
	NOP
	CIF	10
	JMS I	[7700	/USRIN
	10
	CDF 10
	TAD I	(7617	/INPUT FL AND DEVICE #
	DCA I	[7605	/PUT IT WHERE INITL WILL GET IT
	TAD I	(7620	/FIRST BLK OF INPUT FILE
	DCA	IBLK1

	CLA CMA
	JMS	INITL	/MOVE FILE INFO, FETCH HANDLERS
	TAD	IFT
	AND	(7760	/INSURE FL<256 BLOCKS
	SNA
	JMP	ERR1	/TOO BIG
	CLL RTR;RTR
	TAD	[7400
	CIA
	DCA	IFL	/INPUT FILE LENGTH
/
/CHECK IF OUTPUT FILE IS SAME AS INPUT FILE
	TAD	IDEV
	CIA
	TAD	ODEV
	SZA CLA
	JMP	CHE3
	TAD	ODEV	/LOOKUP OUTPUT FILE
	CIF	10
	JMS I	[USR
	2
	OFT+1
	0
	JMP	CHE3
	TAD	.-3
	CIA
	TAD	IBLK1	/COMPARE STARTING BLK #'S
	SNA CLA
	IAC
CHE3,	DCA	SAME	/SET FLAG
	JMS	FINAL
	JMP I	CHENTR

/ROUTINE TO CHECK IF OUTPUT FILENAME IS SAME
/AS INPUT FILENAME.
/RETURN IS .+2 IF SAME; .+1 IF DIFFERENT

CKSAME,	0
	TAD	SAME
	SZA CLA
	JMP	SIMILR
	TAD	IDEV
	CIA		/COMPARE DEVICE NUMBERS
	TAD	ODEV
	SZA CLA
	JMP I	CKSAME
	TAD	(IFT	/COMPARE FILENAMES
	DCA	IX1
	TAD	[OFT
	DCA	IX2
	TAD	[-4
	DCA	CNT
	TAD I	IX1
	CIA
	TAD I	IX2
	SZA CLA
	JMP I	CKSAME
	ISZ	CNT
	JMP	.-6
	ISZ	SAME
SIMILR,	ISZ	CKSAME
	JMP I	CKSAME

/CHECK FOR AND DELETE EXISTING .BK FILE

DELBK,	0
	DCA	ARG2	/SAVE NEW EXTENSION
	TAD	OFT+4
	DCA	TMP	/SAVE CURRENT EXTENSION
	TAD	ARG2
	SZA
	DCA	OFT+4
	TAD	OFT1	/OUTPUT FILENAME
	DCA	ARG2
	TAD	ODEV
	CIF	10
	JMS I	[USR	/LOOKUP .BK FILE
	2
ARG2,	OFT+1
	0
	JMP	NOBK	/NO SUCH ANIMAL
	TAD	ODEV
	CIF	10
	JMS I	[USR
	4		/DELETE .BK FILE
OFT1,	OFT+1
	0
	JMP	ERR3
NOBK,	TAD	TMP	/RESTORE EXTENSION
	DCA	OFT+4
	JMP I	DELBK

ERR1,	JMS	MSGO
TEXT	'INPUT FL>255 BLKS--USE .R EDIT'

	PAGE
/ROUTINE TO OPEN OUTPUT FILE

OPEN,	0
	TAD	OFTP1	/ADDR OF OUTPUT FILENAME
	DCA	OPN1
	TAD	IFL	/REQUEST INPUT FILE LENGTH
	TAD	EXTRA	/PLUS EXTRA
	DCA	TMP
	TAD	TMP
	AND	[7400	/IF >255 GET MAX EMPTY
	SNA CLA
	TAD	TMP
	CLL RTL;RTL
	TAD	ODEV
	CIF	10
	JMS I	[USR	/USR CALL
	3
OPN1,	OFT+1
	0
	JMP	ERR3
	TAD	OPN1	/GET STARTING BLK #
	DCA	OBLK1
	TAD	OBLK1
	DCA	OBLK
	DCA	OFL
	CLL CML
	TAD	OPN1+1	/CHECK SPACE
	TAD	IFL
	TAD	EXTRA
	SMA SZA SNL CLA	/!?!? COMPLICATED TEST FOR SIZE
	JMP	ERR3
	CLL
	TAD	OPN1+1	/SET ACTUAL # EXTRA BLOCKS
	TAD	IFL
	CMA
	SZL
	CLA
	DCA	EXTRA
	JMP I	OPEN

/ROUTINE TO CLOSE FILE
/
CLOSE,	0
	TAD	OFL	/TRUE FILE LENGTH
	DCA	.+6
	TAD	ODEV
	CIF	10
	JMS I	[USR	/USR CALL
	4		/CLOSE
OFTP1,	OFT+1		/OUTPUT FILENAME
	0
	JMP	ERR5
	JMP I	CLOSE
/ROUTINE TO READ NEXT EIGHT BLOCKS FROM INPUT FILE

RD8B,	0
	TAD	(10	/READS UP TO 8 BLOCKS
	TAD	IBLK
	CIA
	IAC
	TAD	LBLK
	SMA		/BUT NOT BEYOND LAST BLK
	CLA
	TAD	(10
	CLL RTR;RTR;RTR
	TAD	(10	/FIELD 1
	DCA	.+4
	TAD	IBLK
	DCA	.+4	/STORE BLK #
	JMS I	ENTRI	/INPUT DEVICE HANDLER CALL
RD8BB,	0		/UP TO 8 BLOCKS, FIELD 1
	BUFR		/BUFFER ADDRESS
	0		/ BLOCK #
	JMP	ERR4
	TAD	IBLK
	TAD	(10	/UPDATE BLK #
	DCA	IBLK
	JMP I	RD8B
/
/
/ROUTINE TO WRITE EIGHT BLOCKS OF OUTPUT

WR8B,	0
	CLA STL RAR	/WRITES SAME # BLOCKS AS
	TAD	RD8BB	/WE JUST READ ABOVE.
	DCA	.+4
	TAD	OBLK
	DCA	.+4
	JMS I	ENTRO	/CALL OUTPUT DEVICE HANDLER
	0		/UP TO 8 BLOCKS, FIELD 1
	BUFR		/BUFFER ADDRESS
	0		/BLOCK #
	JMP	ERR5
	TAD	OBLK	/UPDATE BLOCK #
	TAD	(10
	DCA	OBLK
	TAD	RD8BB	/UPDATE OUTPUT FILE LENGTH
	RTL;RTL;RTL
	AND	[17
	TAD	OFL
	DCA	OFL
	JMP I	WR8B
MSGO,	0		/MESSAGE OUT
	TAD I	MSGO
	RTR;RTR;RTR
	JMS	TTYO
	TAD I	MSGO
	JMS	TTYO
	ISZ	MSGO
	JMP	MSGO+1

TTYO,	0		/TTY OUTPUT ROUTINE
	AND	[77
	SNA
	JMP I	[7605	/ZERO CHAR EXITS TO MONITOR
	TAD	[SP
	AND	[77
	TAD	[SP
	TLS
	TSF
	JMP	.-1
	CLA
	JMP I	TTYO

	PAGE
/ROUTINE TO READ NEXT DIRECTORY BLOCK

RDDIR,	0
	CDF 0
	TAD	DBLK	/DIR BLK #
	SNA
	JMP	ERR3
	DCA	BUFP+1	/SET UP TO WRITE
	CLA STL RTR	/(2000
	DCA	BUFD	/NOW USE BUFFER AT 2000
	TAD	(2004
	DCA	BUFD4
	JMS I	ENTRI
	210		/1 BLK AT A TIME
	2000
DBLK,	0
	JMP	ERR3
	CDF 10
	TAD I	(2002	/NEXT DIR BLK
	DCA	DBLK
	JMP I	RDDIR

/ROUTINE TO WRITE DIRECTORY BLOCK
/BLOCK WRITTEN IS LAST BLOCK READ ABOVE

WRDIR,	0
	TAD	BUFD
	DCA	BUFP	/BUFFER AREA TO USE
	TAD	BUFD
	RAL
	CDF 10
	SPA CLA		/IF BUFFER=2000,
	DCA I	[7	/ZAP 'OLDDIR'
	CDF 0	/SO USR WILL NOT REWRITE
	JMS I	ENTRI
	4210
BUFP,	0
	0
	JMP	ERR3
	JMP I	WRDIR

/RENAME INPUT FILE TO .BK EXTENSION

RENAM,	0
	JMS	FIND	/FIND DIR ENTRY
	DCA	FIND	/SAVE POINTER
	TAD	[213	/.BK
	DCA I	FIND
	JMS	WRDIR	/WRITE DIR BLOCK
	JMP I	RENAM

/ROUTINE TO FIND A DIRECTORY ENTRY FOR THE OUTPUT FILENAME.
/RETURNS WITH AC (AND IX1) POINTING TO EXTENSION WORD IN
/DIRECTORY ENTRY.  SEARCHES USR DIRECTORY SEGMENT FIRST IF
/POSSIBLE.

FIND,	0
	CDF 10
	TAD I	[7	/CHECK USR DIRECTORY SEGMENT FIRST
	AND	[7	/IF THERE IS ONE
	SNA
	JMP	FIND2
	DCA	DBLK
	TAD I	(51
	CIA		/MUST BE SAME DEVICE
	TAD	ENTRI
	SZA CLA
	JMP	FIND2
	TAD	DBLK
	DCA	BUFP+1
	TAD	(1400	/ADDRESS OF SEGMENT
	DCA	BUFD
	TAD	(1404
	DCA	BUFD4
	TAD I	(1402	/NEXT DIR SEGMENT
	DCA	DBLK
	JMS	SRCHD
	SZA
	JMP I	FIND
FIND2,	CLA IAC
	DCA	DBLK
FIND3,	JMS	RDDIR	/READ NEXT DIR BLK
	JMS	SRCHD	/SEARCH IT FOR FILENAME
	SNA
	JMP	FIND3
	JMP I	FIND

DCNT=	TMP
/ROUTINE TO SEARCH THROUGH DIRECTORY SEGMENT
/FOR FILENAME=INPUT FILENAME.

SRCHD,	0
	CDF 10
	TAD I	BUFD
	DCA	DCNT
	TAD	BUFD4	/SKIP FIRST 5 WORDS
	DCA	IX1
SCH1,	TAD	[OFT
	DCA	IX2
	TAD	[-4
	DCA	CNT
	TAD I	IX1
	SNA		/EMPTIES ARE SPECIAL
	JMP	EMPTY
	SKP
SCH2,	TAD I	IX1	/COMPARE WITH OFT
	CDF 0
	CIA
	TAD I	IX2
	CDF 10
	SZA CLA
	JMP	NOMAT
	ISZ	CNT
	JMP	SCH2

	TAD I	BUFD4	/-# OF EXTRA WORDS
	CIA
	TAD	IX1
	DCA	IX2
	TAD I	IX2	/-LENGTH
	SNA CLA
	JMP	NOMAT	/WAS TENTATIVE FILE
	TAD	IX1
	JMP I	SRCHD	/EXIT WITH POINTER TO .EX

NOMAT,	TAD I	BUFD4	/NO MATCH
	TAD	CNT
	CMA		/# EXTRA INFO WORDS
EMPTY,	IAC		/SKIP OVER EMPTIES
	TAD	IX1	/SKIP OVER THEM
	DCA	IX1
	ISZ	DCNT	/DONE?
	JMP	SCH1
	JMP I	SRCHD	/RETURN WITH AC=0

	PAGE
FETCHO,	0
	TAD	OFT
	CIF	10
	JMS I	[USR	/FETCH OUTPUT DEVICE HANDLER
	1
FTCHX,	7000		/INTO LOC 7000
	JMP	FTCH2
	TAD	.-2
	DCA	ENTRO	/STORE ENTRY POINT
	TAD	ENTRO
	TAD	[200	/CHECK IF SYS HANDLER
	SMA CLA
	DCA	HDALT
	JMP I	FETCHO
FTCH2,	ISZ	FTCHX
	TAD	HDALT
	DCA	HDALT+1
	ISZ	HDALT
	TAD	.+3
	DCA	FTCHX+1
	JMP	FETCHO+1
	JMP	ERR3


/ROUTINE TO SET UP EM COMMAND, IF THERE IS NO INPUT FILE.

NOINFL,	TAD	OFT
	SNA CLA		/THERE MUST BE AN OUTPUT FILE
	JMP	ERR2
	TAD	[7577
	DCA	IX1
	STL RTL		/POINT TO 'EM'
	JMS	STP1

	TAD	OFT	/NOW CHECK [NNN]
	CLL RTR;RTR
	AND	(377
	DCA	EXTRA	/SO MQ LOOKS 'RIGHT'
	TAD	EXTRA
	SZA
	JMS	OCTLD	/CONVERT TO DECIMAL
	JMP	STP3

/ROUTINE TO SETUP SCROLL ED COMMAND.

SETUP,	TAD	[7577	/STARTS AT 17600
	DCA	IX1
	IAC
	AND	BDL	/CHECK /L OPTION
	SNA CLA
	JMP	STP2
	TAD	(LOCKM	/MOVE 'LOCK '
	DCA	TMP
	CMA CLL RTL	/-3
	JMS	SETUP2
STP2,	JMS	STP1	/SETUP COMMAND LINE
STP3,	DCA I	IX1	/ZERO WORD TERMINATES COMMAND
	TAD	EXTRA	/PASS # EXTRA BLOCKS
	DCA I	IX1	/AFTER THE SCROLL COMMAND
	TAD	EXTRA	/ ** FOR EAE ONLY
	MQL		/ ** PUTS # EXTRA BLKS IN MQ
	CLA		/ **
	CDF 0
	CIF 10
	JMP	CHAIN	/CHAIN TO SCROLL

STP1,	0
	TAD	(CMNDS	/POINT TO COMMAND WORD
	DCA	TMP
	CMA CLL RAL	/-2
	JMS	SETUP2
	JMS	QDEV	/FIND OUTPUT DEVICE NAME
	DCA	TMP
	TAD	TMP
	TAD	(-DEVLST-2    /IS IT DSK:?
	SNA CLA
	JMP	DSK	/DON'T ENTER DSK:
	CMA CLL RAL	/-2
	JMS	SETUP2
	TAD	(":
	DCA I	IX1
DSK,	TAD	(OFT+1	/FILENAME
	DCA	TMP
	CMA CLL RTL	/-3
	JMS	SETUP2	/FILENAME
	TAD	OFT+4
	SNA CLA
	JMP I	STP1	/NO . IF NO .EX
	TAD	(".
	DCA I	IX1
	CLA CMA
	JMS	SETUP2	/MOVE EXTENSION
	JMP I	STP1

LOCKM,	TEXT	'LOCK '
CMNDS,	TEXT	'ED '
	TEXT	'EM '
SETUP2,	0		/UNPACKS 2 CHAR/WORD AND PUTS
	DCA	CNT	/THEM IN 17600 CMD LINE.
	CDF 0
	TAD I	TMP
	RTR;RTR;RTR
	JMS	SETUP3
	CDF 0
	TAD I	TMP
	JMS	SETUP3
	ISZ	TMP
	ISZ	CNT
	JMP	SETUP2+2
	JMP I	SETUP2

SETUP3,	0
	CDF 10
	AND	[77
	SNA
	JMP I	SETUP3	/WILL SKIP BLANKS
	TAD	[SP
	AND	[77
	TAD	[SP
	DCA I	IX1
	JMP I	SETUP3

SP=	240

	PAGE
/ERROR EXITS

ERR2,	JMS	MSGO
TEXT	'INPUT FILE ERROR IN EDIT'
ERR3,	JMS	MSGO
TEXT	'OUTPUT FILE ERROR IN EDIT'
ERR4,	JMS	MSGO
TEXT	'READ ERROR IN EDIT'
ERR5,	JMS	MSGO
TEXT	'WRITE ERROR IN EDIT'
ERR7,	JMS	MSGO
TEXT	'SYS ERROR IN EDIT'
/ROUTINE TO FIND DEVICE NAME CORRESPONDING TO A
/GIVEN DEVICE NUMBER.  RETURNS WITH POINTER TO
/DEVICE NAME, IF FOUND.  OTHERWISE TAKES 'ERR3'
/EXIT.  THE USR MUST BE IN CORE.

/MORE DEVICES MAY BE ADDED TO THIS TABLE, BUT
/DO NOT INSERT ANYTHING BEFORE SYS AND DSK.

QDEV,	0
	TAD	(DEVLST-1
	DCA	QXX
	CLA CMA
	TAD	ODEV
	TAD I	(36
