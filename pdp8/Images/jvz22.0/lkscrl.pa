/ROUTINE TO LOAD SCROLL.SV AND EXECUTE IT.

	*2400
SAVE=.			/ONCE ONLY, SO SAVE SOME SPACE
CHAIN,	TAD I	(OBLK1	/SAVE SOME PAGE0 STUFF
	DCA	SAVE	/FIRST BLOCK
	CLA CMA
	TAD	SAVE
	TAD I	(OFL
	DCA	SAVE+1	/LAST BLOCK
	TAD I	(ENTRO
	DCA	SAVE+2	/MAIN HANDLER ENTRY
	TAD I	(HDALT
	DCA	SAVE+3	/HANDLER ALLOCATION WORDS
	TAD I	(HDALT+1
	DCA	SAVE+4
	TAD I	(ODEV	/DEVICE NUMBER
	DCA	SAVE+5
	CDF 10

/NEED TO CLEAR THE DEVICE HANDLER TABLE SO THAT THE MONITOR
/WON'T THINK THAT ANYTHING BESIDES THE MAIN HANDLER IS IN
/CORE.  THIS PREVENTS 'E I' OR 'E O' FROM CAUSING DISASTER!

DHLUP,	TAD I	SCORE	/SET UP TO POINT TO TABLE
	AND	(7600
	TAD	(200
	SNA
	JMP	DHDUN	/DON'T REMOVE SYS OR DSK!
	TAD	(-200
	CIA
	TAD	SAVE+2	/MAIN HANDLER ENTRY POINT
	AND	(7600
	SZA CLA		/COMPARE PAGES
	DCA I	SCORE	/REMOVE BAD ENTRIES
DHDUN,	ISZ	SCORE
	ISZ	SCCB	/CHECKED ALL 16 SLOTS?
	JMP	DHLUP

	CLA IAC
	JMS I	SCFCW	/NOW LOOKUP 'SCROLL.SV'
	2
SCRLNM,	SCROLL
	0
	JMP	ERRHLT	/TROUBLE
	TAD	SCRLNM	/SAVE STARTING BLOCK NUMBER
	DCA	SCCB
	CIF	0
	JMS I	(7607	/READ CORE CONTROL BLOCK
	0110
	CRCB
SCCB,	-16
	JMP	ERRHLT	/BAD NEWS
	TAD	SCBLK
	DCA	IX2	/USE THE 'CDI' LOCATION
	TAD	SCCB
	DCA	SCBLK	/MOVE THE BLOCK NUMBER

SCLOAD,	TAD	SCFCW	/ADD IN # BLKS
	AND	(3600
	CLL RTL;RTL;RTL
	TAD	SCBLK
	DCA	SCBLK
	TAD I	IX2	/CORE ORGIN
	DCA	SCORE
	TAD I	IX2	/LENGTH AND FIELD
	DCA	SCFCW
	CIF	0
	JMS I	(7607	/READ ANOTHER SEGMENT
SCFCW,	200		/FUNCTION CONTROL WORD
SCORE,	DHRT
SCBLK,	CRCB+3
	JMP ERRHLT
	ISZ	CRCB	/SEGMENT COUNTER
	JMP	SCLOAD

/NOW PASS THE INFO FROM EDIT TO SCROLL

	TAD I	(7601	/CHECK FOR 'EM'
	TAD	(-"M
	CDF CIF	0
	SZA CLA		/PATCH THE 'ED' COMMAND
	TAD	(JMP I FMAXB
	SZA		/TO SKIP THE FILE LOOKUP
	DCA I	(EDITC1
	TAD	CRCB+3	/MOVE JOB STATUS WORD
	DCA I	(7746
	TAD	SAVE	/AND NOW THE STUFF WE SAVED
	DCA I	(FMINB
	TAD	SAVE+1
	DCA I	(FLASTB
	TAD	SAVE+2
	DCA I	(MNHDLA
	TAD	SAVE+3
	DCA I	(HDALTB
	TAD	SAVE+4
	DCA I	(HDALTB+1
	TAD	SAVE+5
	DCA I	(DEVNUM
	ISZ	CRCB+2	/ADVANCE TO CHAIN ENTRY POINT
	JMP I	CRCB+2	/GO

ERRHLT,	CLA HLT		/SYSTEM HANDLER FAILURE
	CDF CIF 0	/OR 'SCROLL' IS MISSING
