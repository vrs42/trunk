C	PRINT THE SEQUENCES IN REAONABLE STYLE
C
	DIMENSION IAL(512),KAL(512)
1	READ(1,1013)FMSG
1013	FORMAT('INPUT TITLE:'A6)
	CALL IOPEN('DSK',FMSG)
	READ(4,1001)NA,NPOIT
1001	FORMAT(I5/I5)
100	READ(4,1050)(IAL(I),I=1,512)
1050	FORMAT(40A1)
	J=0
	I=0
10	J=J+1
	K=IAL(J)
S	CLA CLL
S	TAD \K
S	AND (7700
S	RTR
S	RTR
S	RTR
S	DCA \K
20	IF(K-32)30,10,30
30	I=I+1
	KAL(I)=IAL(J)
	K=KAL(I)
S	CLA CLL
S	TAD \K
S	AND (7600
S	RTR
S	RTR
S	RTR
S	DCA \K
	IF(K-62)10,40,10
40	NPOIT=I
	WRITE(1,2001)
	WRITE(1,2000)(KAL(I),I=1,NPOIT)
2000	FORMAT(30(1X,A1)/)
	CALL OOPEN('DSK',FMSG)
	WRITE(4,1001)NA,NPOIT
	WRITE(4,2002)(KAL(I),I=1,NPOIT)
2002	FORMAT(30A1)
	CALL OCLOSE
	WRITE(1,2001)
2001	FORMAT(/////)
	END
