	DIMENSION M(80)
C
	CALL MMI
	CALL MVI
	CALL MWI
C
	READ(1,1008)YN
1008	FORMAT('ZERO-CENTERED MATRIX? ',A6)
	IF(YN-'Y     ')5,6,5
5	IF(YN-'YES   ')7,6,7
6	YN=1.
	GO TO 10
7	YN=0
C  ROUTINES HERE SHOULD AVOID OVERFLOW WHEN SECOMX IS
C RUN (D.C.T.-7/31/80):
	CALL IOPEN('DSK','SCOMMM')
	READ(4,1004) NS1,NS2,NST1,L1,NST2,L2,FN1,FN2
	READ(4,1015)(M(I), I=1,L1)
	DO 100 I=1,L1
	IF(M(I)-30)100,100,95
95	YN=1.
100	CONTINUE
	IF(YN)10,10,105
105	WRITE(1,1105)
1105	FORMAT(/' MATRIX ZEROED ANYHOW; USE SECOM FOR NON-ZERO CENTER'/)
10	CALL IOPEN('DSK','SCOMMM')
	CALL OOPEN('DSK','SANKOF')
	READ(4,1004) NS1,NS2,NST1,L1,NST2,L2,FN1,FN2
	WRITE(4,1004) NS1,NS2,NST1,L1,NST2,L2,FN1,FN2
1004	FORMAT(6I5,2(1X,A6))
	READ(1,1006) NQMAX
1006	FORMAT('MAXIMUM Q: ',I2)
	WRITE(4,1004)NQMAX
C
	SUM=0
	DO 15  J=1,L2
	READ(4,1015)(M(I), I=1,L1)
1015	FORMAT(20I3)
	DO 14  I=1,L1
	N=M(I)
	IF(N)13,131,131
13	N=0
131	SUM=SUM+FLOAT(N)
14	CALL MMST(I,J,N)
15	CONTINUE
C
	F=FLOAT(L1)*FLOAT(L2)
	F=SUM/F
	MEAN=F*YN+0.5
	WRITE(1,1016)F,MEAN
1016	FORMAT('MEAN=',F6.1,' SUBTRACTED',I5,' FROM ENTRIES')
	DO 17  J=1,L2
	DO 17  I=1,L1
	N=MM(I,J)-MEAN
	CALL MMST(I,J,N)
17	CONTINUE
C
C ZERO TOP AND LEFT EDGES OF MV,MW
	DO 22  J=1,64
	CALL MVST(1,J,0)
	CALL MVST(J,1,0)
	CALL MWST(1,J,0)
22	CALL MWST(J,1,0)
C
C COMPUTE VQ
	NQ=0
	L1=L1+1
	L2=L2+1
25	CONTINUE
	DO 30  J=2,L2
S	TAD	\J
S	7421
	DO 30  I=2,L1
	M1=MV(I-1,J-1)
	M2=MW(I-1,J-1)
	IF(M1-M2)27,28,28
27	M1=M2
28	M1=M1+MM(I-1,J-1)
	CALL MVST(I,J,M1)
30	CONTINUE
C
C COMPUTE SANKOF WQ
	DO 40  J=2,L2
S	TAD	\J
S	7421
	DO 40  I=2,L1
	M1=MW(I-1,J)
	M2=MW(I,J-1)
	M3=MV(I,J)
	IF(M1-M2)33,34,34
33	M1=M2
34	IF(M1-M3)35,36,36
35	M1=M3
36	CALL MWST(I,J,M1)
40	CONTINUE
C
	DO 50  J=2,L2
	DO 48  I=2,L1
48	M(I)=MV(I,J)
50	WRITE(4,1050)(M(I), I=2,L1)
	DO 52  J=2,L2
	DO 51  I=2,L1
51	M(I)=MW(I,J)
52	WRITE(4,1050)(M(I), I=2,L1)
1050	FORMAT(40A2)
	WRITE(1,1055)NQ,M(L1)
1055	FORMAT('Q=',I3',  W MAX=',I5)
	NQ=NQ+1
	IF(NQ-NQMAX)25,25,90
90	CALL OCLOSE
	STOP
C
	END
