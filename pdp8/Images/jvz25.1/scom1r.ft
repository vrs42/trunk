C  SCOM1R.FT   V1.4
C  LISTS RESULTS AND WRITES DSK:RESULT.DA
C
	COMMON NS1,NS2,LD,KSEQ,KSQN,KPRG,NVOL,TTAB,LIST,LISTX,ITAB,IS1,
     1  IS2,IP,STTL,COFF,NR,TITLE
	DIMENSION IS1(32),IS2(120),IP(122),ITAB(27,27),
     1  STTL(6),LIST(22),LISTX(22,5),TITLE(8)
C
C  RESULTS OF RUN
C
	WRITE(1,1001)TITLE,STTL
1001	FORMAT('RESULTS...'/8A6/6A6)
	WRITE(1,1002)(IS1(I), I=1,NS1)
1002	FORMAT('TEST SEQUENCE:'/32(1X,A1))
	WRITE(1,1003) LD
1003	FORMAT('DIAGONAL STRETCH LENGTH=',I4)
C
C  COMPUTE MAX POSSIBLE VALUE
	MAX=0
	J2=NS1-LD+1
	DO 9  J=1,J2
	MX=0
	I2=J+LD-1
	DO 6  I=J,I2
	II=IS1(I)
S	TAD  \II
S	RTR;RTR;RTR
S	AND  (77
S	TAD  (-33
S	SMA SZA
S	CLA
S	TAD  (33
S	DCA  \II
 6	MX=MX+ITAB(II,II)
	IF(MX-MAX)9,9,8
8	MAX=MX
9	CONTINUE
C
	K=0
	IF(COFF)12,13,13
12	K=-1
	COFF=-COFF
13	KYY=COFF/366.
	COFF=COFF-FLOAT(KYY)*366.
	KYY=KYY+70
	MM=COFF/31.
	KDD=COFF-FLOAT(MM)*31.+1.
	MM=MM+1
	IF(K)14,15,15
14	WRITE(1,1014) MM,KDD,KYY
1014	FORMAT('CUTOFF:  BEFORE ',I2,1H/,I2,1H/,I2)
	GO TO 16
15	WRITE(1,1015) MM,KDD,KYY
1015	FORMAT('CUTOFF:  AFTER ',I2,1H/,I2,1H/,I2)
16	RSLT='RESULT'
	IF(NR)19,19,17
17	RSLT='R0RSLT'
S	TAD  \NR
S	TAD  \RSLT
S	DCA  \RSLT
19	CALL OOPEN('DSK',RSLT)
	WRITE(4,1001) TITLE,STTL
	WRITE(4,1002)(IS1(I), I=1,NS1)
	WRITE(4,1003) LD
	IF(K) 21,22,22
21	WRITE(4,1014) MM,KDD,KYY
	GO TO 23
22	WRITE(4,1015) MM,KDD,KYY
	WRITE(1,1009)MAX
	WRITE(4,1009)MAX
1009	FORMAT('MAX POSSIBLE VALUE=',I5)
23	WRITE(1,1010)
1010	FORMAT(//'VOL  SEQ# F#   VALUE   COORD')
	WRITE(4,1010)
	DO 29  JJ=1,20
	J=22-JJ
	WRITE(1,1021)(LISTX(J,I),I=1,3),LIST(J),(LISTX(J,I),I=4,5)
29	WRITE(4,1021)(LISTX(J,I),I=1,3),LIST(J),(LISTX(J,I),I=4,5)
1021	FORMAT(I3,I5,I3,I8,'    (',I2,',',I3,')')
	CALL OCLOSE
	IF(NR)33,33,31
31	CALL CHAIN('SCOM1A')
33	CALL EXIT
	END
