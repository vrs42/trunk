/  ROUTINES TO USE MEMORY FIELD 7 FOR STORAGE
/
/	FUNCTION MEMR(J)
/	RETREIVES JTH WORD FROM ARRAY
/
OPDEF	TADI 1400
OPDEF	DCAI 3400
	ENTRY MEMR
	DUMMY \J
\J,	BLOCK 2
MEMR,	BLOCK 2
	TAD MEMR
	DCA MR1
MR1,	HLT
	TADI MEMR#
	DCA MR2
	INC  MEMR#
	TADI MEMR#
	DCA  \J
	INC  MEMR#
MR2,	HLT
/
	TADI \J
	DCA  ADDR
CDFL,	HLT		/CHANGE TO DF 7
	TADI ADDR	/GET ENTRY
RDFL,	NOP		/RESET DF
	RETRN MEMR
ADDR,	BLOCK 1
\MEMR,	BLOCK 1
/
/SUBROUTINE MEMST(J,N)
/ STORES N AS JTH WORD IN ARRAY
ENTRY	MEMST
	DUMMY \N
\N,	BLOCK 2
MEMST,	BLOCK 2
	TAD MEMST
	DCA MST1
	JMS MSTAR
	DCA ADDR
	JMS MSTAR
/
CDF2,	HLT		/CHANGE TO DF 7
	DCAI ADDR
RDF2,	NOP		/RESET DF
	RETRN MEMST
/
MSTAR,	0
MST1,	HLT		/FOR CDF
	TADI MEMST#
	DCA  MST2
	INC MEMST#
	TADI MEMST#
	DCA  TEMP
	INC MEMST#
MST2,	HLT
	TADI TEMP
	JMP I MSTAR
TEMP,	0
/
/ INITIALIZATION ROUTINE
	ENTRY MEMI
MEMI,	BLOCK 2
	TAD  (6271	/TO USE DF 7
	DCA  CDFL
	TAD  (6271
	DCA  CDF2
	6214		/READ CURRENT DF
	TAD  (6201	/TO RESTORE
	DCA  RDFL
	TAD  RDFL
	DCA  RDF2
	RETRN MEMI
	END
