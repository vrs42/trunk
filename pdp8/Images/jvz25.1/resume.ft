	SUBROUTINE RESUME
	COMMON NS1,NS2,LD,KSEQ,KSQN,KPRG,NVOL,TTAB,LIST,LISTX,ITAB,IS1,
     1  IS2,IP,STTL,COFF,NR,TITLE,NCODE,KODES,CODES
	DIMENSION IS1(32),LIST(22),LISTX(22,5),IP(122),IS2(120),
     1	ITAB(27,27),TITLE(8),STTL(6),CODES(200),KODES(200)
	CALL IOPEN('DSK','SECOMX')
	READ(4,1008) K,KSEQ,KSQN,LD,NVOL,NS1,NS2,NR,NCODE,TTAB,COFF
1008	FORMAT(9I5,2A6)
	WRITE(1,1710) K,KSEQ,KSQN,LD,NVOL,TTAB
1710	FORMAT(5I7,3X,A6)
	IF(K-371)70,10,70
10	READ(4,1009)TITLE
1009	FORMAT(8A6)
	READ(4,1009)(CODES(I), I=1,NCODE)
	READ(4,1010)(KODES(I), I=1,NCODE)
	READ(4,1010)(IS1(I), I=1,32)
	READ(4,1010)(LIST(I), I=1,22)
	READ(4,1010)((LISTX(I,J), I=1,22), J=1,5)
1010	FORMAT(16I5)
	READ(4,1011)STTL
1011	FORMAT(6A6)
	IF(K-371)70,15,70
15	CALL IOPEN('DSK',TTAB)
	READ(4,1014) I
1014	FORMAT(A1)
	DO 12  J=1,27
12	READ(4,1012)(ITAB(I,J), I=1,27)
1012	FORMAT(27I2)
C
C  OPEN SEQUENCE FILE AND READ INTO 
C  PREVIOUS POSITION
	GO TO (20,21,22,23),NVOL
20	CALL IOPEN('DSK','SEQUV1')
	GO TO 24
21	CALL IOPEN('DSK','SEQUV2')
	GO TO 24
22	CALL IOPEN('DSK','SEQUV3')
	GO TO 24
23	CALL IOPEN('DSK','SEQUV4')
C
24	CONTINUE
C
	IF(KSEQ)40,25,25
25	READ(4,1026) KS,KSQ,NS2
1026	FORMAT(I5,I2,I4)
26	IF(NS2-120)27,31,27
27	READ(4,1027)(IS2(I),IP(I), I=1,NS2),ISTAR
1027	FORMAT(5X,60A1)
	GO TO 35
31	READ(4,1027)(IS2(I),IP(I), I=1,NS2)
35	IF(KS-KSEQ)25,40,25
40	IF(KSQ-KSQN)25,41,25
41	WRITE(1,1015)KSEQ
1015	FORMAT('RESUMING PROCESSING AFTER KSEQ=',I5)
	KTAB=0
	KPRG=2
	RETURN
70	WRITE(1,1070)
1070	FORMAT('ERROR IN RESUME ROUTINE')
	RETURN
	END
