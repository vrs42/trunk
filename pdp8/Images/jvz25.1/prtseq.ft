C	PRINT THE SEQUENCES IN REAONABLE STYLE
C
	DIMENSION IAL(512),GMSG(10)
	READ(1,999)NPROT
999	FORMAT(' # PROT:'I2)
	READ(1,1013)(GMSG(I),I=1,NPROT)
1013	FORMAT('TITLE:'A6)
	K=-29
	DO 950 IJKL=1,11
	K=K+30
	J=K+29
	DO 900 IJK=1,NPROT
	FMSG=GMSG(IJK)
	CALL IOPEN('DSK',FMSG)
	READ(4,1001)NA,NPOIT
1001	FORMAT(I5/I5)
100	READ(4,1050)(IAL(I),I=1,NPOIT)
1050	FORMAT(30A1)
	WRITE(1,2000)(IAL(I),I=K,J)
2000	FORMAT(30(1X,A1)/)
900	CONTINUE
	WRITE(1,2001)
950	CONTINUE
980	WRITE(1,2001)
2001	FORMAT(/////)
	END
