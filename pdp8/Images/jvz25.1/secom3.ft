	SUBROUTINE SECM3
	COMMON NS1,NS2,LD,KSEQ,KSQN,KPRG,NVOL,TTAB,LIST,LISTX,ITAB,IS1,
     1  IS2,IP
	DIMENSION M(26,121),IS1(30),IS2(120),IP(122),ITAB(27,27),
     1  LIST(22),LISTX(22,4)
C
C  COMPUTE COMPARISON MATRIX
	DO 49  J=1,NS2
	DO 47  I=1,NS1
	II=IS1(I)
S	TAD  \II
S	RTR;RTR;RTR
S	AND  (77
S	DCA  \II
	IF(II-27) 35,35,34
34	II=27
35	JJ=IS2(J)
S	TAD  \JJ
S	RTR;RTR;RTR
S	AND  (77
S	DCA  \JJ
	IF(JJ-27) 37,37,36
36	JJ=27
37	M(I,J)=ITAB(II,JJ)
	IF(IP(J)+2016) 40,46,40
40	IF(IP(J)+1120) 41,46,41
41	M(I,J)=-1
46	CONTINUE
47	CONTINUE
49	CONTINUE
C
C  COMPUTE SANKOFF V0 MATRIX
	DO 59  J=2,NS2
	DO 58  I=2,NS1
	M(I,J)=M(I-1,J-1)+M(I,J)
58	CONTINUE
59	CONTINUE
C
C  DO DIAGONAL SEARCH
	J2=NS2-LD+1
	I2=NS1-LD+1
	DO 69  JJ=1,J2
	DO 68  II=1,I2
	I=II-1
	J=JJ-1
	ISC=0
	K=2
	IF(I) 63,63,61
61	IF(J) 63,63,62
62	ISC=M(I,J)
63	ISC=M(I+LD,J+LD)-ISC
64	IF(ISC-LIST(K))67,67,65
65	LIST(K-1)=LIST(K)
	DO 66  IK=1,4
66	LISTX(K-1,IK)=LISTX(K,IK)
	K=K+1
	GO TO 64
67	LIST(K-1)=ISC
	LISTX(K-1,1)=KSEQ
	LISTX(K-1,2)=I
	LISTX(K-1,3)=J
	LISTX(K-1,4)=KSQN
68	CONTINUE
69	CONTINUE
	KPRG=2
	RETURN
	END
