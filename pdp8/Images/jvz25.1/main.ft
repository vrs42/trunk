C  MAIN.FT   4-30-80
C  ATTEMPT TO LOOK UP VALUES IN SEQUENCE DATA FILES BASED ON R?RSLT.DA
C FILES
	DIMENSION TITLE(12),TITL(11)
	DIMENSION IVOL(6,20),IP(122)
C
	READ(1,998)NR
998	FORMAT(' NUMBER OF RESULT FILES:'I1)
	IF(NR-5)2,5,5
2	READ(1,997)RSLT
997	FORMAT(' 1ST "R?RSLT" TITLE (A6):'A6) 
	J=-1
S	TAD  \J
S	TAD  \RSLT
S	DCA  \RSLT
	GO TO 7
5	RSLT='R0RSLT'
7	DO 999 IJK=1,NR
	J=1
S	TAD  \J
S	TAD  \RSLT
S	DCA  \RSLT
	WRITE(1,1000)RSLT
	CALL IOPEN('DSK',RSLT)
	DO 10 I=1,11
	READ(4,1000)TITLE
1000	FORMAT(12A6)
	WRITE(1,1010)TITLE
1010	FORMAT(1X,12A6)
10	CONTINUE
	DO 20 I=1,20
	READ(4,1001)(IVOL(J,I),J=1,6)
1001	FORMAT(I3,I5,I3,2X,I6,5X,I2,1X,I3)
C  4 1894  1     221    (18, 72)
	WRITE(1,1002)(IVOL(J,I),J=1,6)
1002	FORMAT(I3,I5,I3,2X,I6,4X,'(',I2,',',I3,')')
20	CONTINUE
	DO 100 JVOL=1,4
	WRITE(1,1020)JVOL
1020	FORMAT(//' VOLUME',I2)
	GO TO (21,22,23,24),JVOL
21	CALL IOPEN('DSK','SEQUV1')
	GO TO 25
22	CALL IOPEN('DSK','SEQUV2')
	GO TO 25
23	CALL IOPEN('DSK','SEQUV3')
	GO TO 25
24	CALL IOPEN('DSK','SEQUV4')
25	READ(4,1003)JSEQ,JF,JRES,TITL
C	WRITE(1,1003)JSEQ,JF,JRES,TITL
1003	FORMAT(I5,I2,I4,11A6)
	IF(JSEQ+1)27,100,27
27	DO 30 I=1,20
	IF(JVOL-IVOL(1,I))30,28,30
28	IF(JSEQ-IVOL(2,I))30,29,30
29	IF(JF-IVOL(3,I))30,31,30
31	WRITE(1,1031)(IVOL(J,I),J=1,6)
1031	FORMAT(/I3,I5,I3,2X,I6,4X,'(',I2,',',I3,')')
	WRITE(1,1003)JSEQ,JF,JRES,TITL
30	CONTINUE
C  READ SEQUENCES
	IF(JRES-120)41,44,41
41	READ(4,1041)(IP(I),IS2,I=1,JRES),I,ISTAR
1041	FORMAT(5X,60A1)
	IF(ISTAR+1376)43,49,43
43	WRITE(1,1043)JVOL,JSEQ,JF,JRES,TITL
1043	FORMAT(' NO * AT END OF SEQ. VOL',I2/I5,I2,I5,11A6)
	GO TO 49
44	READ(4,1041)(IP(I),IS2,I=1,JRES)
49	CONTINUE
	GO TO 25
100	CONTINUE
999	CONTINUE
	END
