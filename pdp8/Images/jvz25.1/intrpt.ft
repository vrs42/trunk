	SUBROUTINE INTRPT(N)
	COMMON NS1,NS2,LD,KSEQ,KSQN,KPRG,NVOL,TTAB,LIST,LISTX,ITAB,IS1,
     1  IS2,IP,STTL,COFF,NR,TITLE,NCODE,KODES,CODES
	DIMENSION IS1(32),ITAB(27,27),LIST(22),LISTX(22,5),IS2(120),
     1	IP(122),TITLE(8),STTL(6),KODES(200),CODES(200)
C  ROUTINE TO PROCESS INTERRUPTION
C  SENSE SWITCH ONE CONTROLS INTERRUPTION
	IF(N)4,11,4
4	I=1
	CALL SSW(I)
	IF(I) 8,8,9
8	RETURN
9	CONTINUE
10	WRITE(1,1007)
1007	FORMAT('PROGRAM INTERRUPTION...')
11	CONTINUE
	K=371
	CALL OOPEN('DSK','SECOMX')
	WRITE(4,1008) K,KSEQ,KSQN,LD,NVOL,NS1,NS2,NR,NCODE,TTAB,COFF
1008	FORMAT(9I5,2A6)
	WRITE(4,1009)TITLE
1009	FORMAT(8A6)
	WRITE(4,1009)(CODES(I), I=1,NCODE)
	WRITE(4,1010)(KODES(I), I=1,NCODE)
	WRITE(4,1010)(IS1(I), I=1,32)
	WRITE(4,1010)(LIST(I), I=1,22)
	WRITE(4,1010)((LISTX(I,J), I=1,22), J=1,5)
1010	FORMAT(16I5)
	WRITE(4,1011)STTL
1011	FORMAT(6A6)
	CALL OCLOSE
	IF(N)25,8,25
25	WRITE(1,1020)
1020	FORMAT('INFO SAVED ON DSK:SECOMX.DA'/)
	CALL EXIT
	END
