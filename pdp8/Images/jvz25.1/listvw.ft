C  LISTVW.FT TO LIST SANKOF V0 AND W0 MATRICES
C  MODIFIED FROM SECL 7/27/81 D.C.T.
C	COMMON NS1,NS2,NST1,L1,NST2,L2,NQMAX,NQRD
	DIMENSION IS1(10,64),IS2(10,64),M(100)
	DIMENSION ISEQ(500)
C
	INDIC=-1
	DO 2  J=1,10
	DO 2  I=1,64
S	TAD	(4040
S	DCA	\N
	IS1(J,I)=N
2	IS2(J,I)=N
C
	CALL IOPEN('DSK','SCOMMM')
	READ(4,1004) NS1,NS2,NST1,L1,NST2,L2,FN1,FN2
1004	FORMAT(6I5,2(1X,A6))
C
	CALL IOPEN('DSK',FN1)
	READ(4,1004) N
	IF(N-NS1)190,5,190
5	NSTP=L1+NST1-1
	DO 10  J=1,NS1
	READ(4,1004)LS1
	READ(4,1006)(ISEQ(K), K=1,LS1)
1006	FORMAT(30A1)
	K=0
	DO 8  I=NST1,NSTP
	K=K+1
8	IS1(J,K)=ISEQ(I)
10	CONTINUE
C
	CALL IOPEN('DSK',FN2)
	READ(4,1004) N
	IF(N-NS2)190,15,190
15	NSTP=L2+NST2-1
	DO 20  J=1,NS2
	READ(4,1004)LS2
	READ(4,1006)(ISEQ(K), K=1,LS2)
	K=0
	DO 18  I=NST2,NSTP
	K=K+1
18	IS2(J,K)=ISEQ(I)
20	CONTINUE
C
	READ(1,1022)A
1022	FORMAT('WIDE PRINTOUT?',A6)
	NWD=19
	IF(A-'Y     ')23,22,23
23	IF(A-'YES   ')24,22,24
22	NWD=38
24	K1=1
30	K2=K1+NWD
	IF(K2-L1)32,32,31
31	K2=L1
32	IDIV=100
C  NUMBER THE TOP COLUMNS:
80	IPR=0
	DO 100 I=1,L1
	NI=I+NST1-1
	M(I)=IREM(NI/(10*IDIV))/IDIV
	IF(M(I))90,100,90
90	IPR=1
100	CONTINUE
	IF(IPR)130,130,120
120	WRITE(1,1120)(M(K),K=K1,K2)
1120	FORMAT(14X,39I3)
130	IDIV=IDIV/10
	IF(IDIV)140,140,80
C  LIST THE TOP SEQUENCES:
140	DO 33  I=1,NS1
33	WRITE(1,1040)(IS1(I,K), K=K1,K2)
1040	FORMAT(14X,39(2X,A1))
C
C  NOW READ V0 AND W0 OF SANKOF.DA FILE
C
C************************************
	CALL IOPEN('DSK','SANKOF')
	READ(4,1001) NS1,NS2,NST1,L1,NST2,L2,NQMAX
1001	FORMAT(6I5)
	N=(L1+39)/40
	N=N*L2*NQ*2
	DO 50  I=1,N
50	READ(4,1050) K
1050	FORMAT(A1)
	DO 60  J=1,L2
	NJ=J+NST2-1
	DO 55  I=1,L1
	READ(4,1055)(M(I), I=1,L1)
1055	FORMAT(40A2)
C************************************
	WRITE(1,1060) NJ,(IS2(K,J), K=1,10),(M(K), K=K1,K2)
1060	FORMAT(I3,1X,10A1,39I3)
55	CONTINUE
60	CONTINUE
	K1=K1+NWD
	IF(K1-L1)61,61,62
61	WRITE(1,1061)
1061	FORMAT(////A1)
	GO TO 30
62	INDIC=INDIC+1
	IF(INDIC)24,24,190
C
190	STOP
	END
