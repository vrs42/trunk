	COMMON NS1,NS2,NST1,L1,NST2,L2,NQMAX,NQRD
2	CALL MVI
	CALL MWI
C
	WRITE(1,1001)
1001	FORMAT(//)
	READ(1,1002) NQ
1002	FORMAT('Q: ',I2)
	IF(NQ)99,3,3
3	CALL RDV(NQ)
	CALL RDW(NQ)
	WRITE(1,1003)
1003	FORMAT('  Q    COORD  DIAG VALUE')
	M=MW(L1,L2)
	I=L1
	J=L2
20	I=I-1
	IF(M-MW(I,J))20,20,22
22	I=I+1
23	J=J-1
	IF(M-MW(I,J))23,23,24
24	J=J+1
C
28	IF(NQ)281,281,282
281	CALL MWI
	GO TO 30
282	CALL RDW(NQ-1)
30	M=MV(I,J)
	IX=I+NST1-1
	JX=J+NST2-1
	IDIAG=IX-JX
	WRITE(1,1030)NQ,IX,JX,IDIAG,M
1030	FORMAT(I3,3I5,I6)
C
	NV=MV(I-1,J-1)
	NW=MW(I-1,J-1)
	IF(NV-NW)35,31,32
31	WRITE(1,1040)
32	I=I-1
	IF(I)60,60,321
321	J=J-1
	IF(J)60,60,322
322	GO TO 30
C
35	NQ=NQ-1
	CALL RDV(NQ)
39	NV=MV(I,J)
	NW1=MW(I-1,J)
	NW2=MW(I,J-1)
	IF(NV-NW1)45,41,42
41	WRITE(1,1040)
1040	FORMAT('ALTERNATE PATH')
42	IF(NV-NW2)45,43,44
43	WRITE(1,1040)
44	I=I-1
	IF(I)60,60,441
441	J=J-1
	IF(J)60,60,442
442	GO TO 28
C
45	IF(NW1-NW2)52,51,53
51	WRITE(1,1040)
52	J=J-1
	IF(J)60,60,521
521	GO TO 39
53	I=I-1
	IF(I)60,60,531
531	GO TO 39
C
60	GO TO 2
99	STOP
	END
