C  RESULT.FT   11-20-80
C  ATTEMPT TO LOOK UP VALUES IN SEQUENCE DATA FILES BASED ON R?RSLT.DA
C FILES
	DIMENSION TITLE(12),TITL(11)
	DIMENSION IVOL(6,20)
C
C  UNITS 5,6,7,8 FOR SEQUV?.DA FILES
C  READ R?RSLT.DA FILE ON UNIT 3
C  IT MAY BE BETTER TO USE FORTRAN II FOR THIS PROBLEM
C
C  THIS PROG BECAUSE FPP IS DOWN
C
	READ(1,999)NR
999	FORMAT(' NO. OF R?RSLT FILES:'I1)
	RSLT='R0RSLT'
	DO 500 IJK=1,NR
S	TAD (1
S	TAD \RSLT
S	DCA \RSLT
	CALL IOPEN('DSK',RSLT)
	DO 10 I=1,11
	READ(4,1000)TITLE
1000	FORMAT(12A6)
	WRITE(1,1010)TITLE
1010	FORMAT(1X,12A6)
10	CONTINUE
	DO 20 I=1,20
	READ(4,1001)(IVOL(J,I),J=1,6)
1001	FORMAT(I3,I5,I3,2X,I6,5X,I2,1X,I3)
C  4 1894  1     221    (18, 72)
	WRITE(1,1002)(IVOL(J,I),J=1,6)
1002	FORMAT(I3,I5,I3,2X,I6,4X,'(',I2,',',I3,')')
20	CONTINUE
	DO 100 IN=1,4
C*******************
	GO TO (21,22,23,24),IN
21	SEQUV='SEQUV1'
	GO TO 25
22	SEQUV='SEQUV2'
	GO TO 25
23	SEQUV='SEQUV3'
	GO TO 25
24	SEQUV='SEQUV4'
	GO TO 25
25	CALL IOPEN('DSK',SEQUV)
	WRITE(1,1025)IN,SEQUV
1025	FORMAT(//' VOLUME'I2' IS ',A6)
	JVOL=IN
250	READ(4,1003)JSEQ,JF,JRES,TITL
1003	FORMAT(I5,I2,I4,11A6)
C	IF(JSEQ.EQ.-1)GO TO 100
	IF(JSEQ+1)19,100,19
19	DO 30 I=1,20
	IF(JVOL-IVOL(1,I))30,26,30
26	IF(JSEQ-IVOL(2,I))30,27,30
27	IF(JF-IVOL(3,I))30,28,30
28	WRITE(1,1002)(IVOL(J,I),J=1,6)
	WRITE(1,1029)JSEQ,JF,JRES,TITL
1029	FORMAT(I5,I2,I4,11A6/)
C  DONT READ SEQUENCES
30	CONTINUE
	IRD=JRES/30
	IR=IREM(JRES/30)+1
	IF(IR)36,37,36
36	IRD=IRD+1
37	IF(IRD-4)39,39,38
38	IRD=4
39	DO 40 I=1,IRD
	READ(4,1004)DUM
C	WRITE(1,1004)DUM
40	CONTINUE
1004	FORMAT(6X,A6)
	GO TO 250
100	CONTINUE
500	CONTINUE
	END
