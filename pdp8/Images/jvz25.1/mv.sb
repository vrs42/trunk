/
/	FUNCTION MV(I,J)
/	RETREIVES JTH WORD FROM ARRAY MV(64,64)
/	FIELD 5 STORAGE
/
OPDEF	TADI 1400
OPDEF	DCAI 3400
	ENTRY MV
	DUMMY	\I
	DUMMY	\J
\I,	BLOCK	2
\J,	BLOCK 2
MV,	BLOCK 2
	TAD MV
	DCA MR1
	JMS MVAR
	DCA ADDR
	JMS MVAR
	CLL RTL;RTL;RTL
	TAD ADDR
	DCA ADDR
CDFL,	HLT		/CHANGE TO DF 6
	TADI ADDR	/GET ENTRY
RDFL,	NOP		/RESET DF
	RETRN MV
/
MVAR,	0
MR1,	HLT
	TADI MV#
	DCA  MR2
	INC  MV#
	TADI MV#
	DCA  TEMP
	INC  MV#
MR2,	HLT
	TADI TEMP
	JMP I MVAR
ADDR,	BLOCK 1
\MV,	BLOCK 1
/
/SUBROUTINE MVST(I,J,N)
/ STORES N AS I,JTH WORD IN ARRAY
ENTRY	MVST
	DUMMY \N
\N,	BLOCK 2
MVST,	BLOCK 2
	TAD MVST
	DCA MST1
	JMS MSTAR	/GET I
	DCA ADDR
	JMS MSTAR	/GET J
	CLL RTL;RTL;RTL
	TAD ADDR
	DCA ADDR
	JMS MSTAR	/GET N
/
CDF2,	HLT		/CHANGE TO DF 6
	DCAI ADDR
RDF2,	NOP		/RESET DF
	RETRN MVST
/
MSTAR,	0
MST1,	HLT		/FOR CDF
	TADI MVST#
	DCA  MST2
	INC MVST#
	TADI MVST#
	DCA  TEMP
	INC MVST#
MST2,	HLT
	TADI TEMP
	JMP I MSTAR
TEMP,	0
/
/ INITIALIZATION ROUTINE
	ENTRY MVI
MVI,	BLOCK 2
	TAD  (6261	/TO USE DF 6
	DCA  CDFL
	TAD  (6261
	DCA  CDF2
	6214		/READ CURRENT DF
	TAD  (6201	/TO RESTORE
	DCA  RDFL
	TAD  RDFL
	DCA  RDF2
	TAD  RDFL
	DCA  MVI2
	DCA  TEMP
	6261		/CDF 6
MVI1,	DCAI  TEMP	/CLEAR FIELD 6
	ISZ  TEMP
	JMP  MVI1
MVI2,	0
	RETRN MVI
	END
