C  SCOM1B.FT   V1.5    4/20/77
C  SECOND PROGRAM MODULE--SETS UP DATA FOR COMPUT.
C  USER SUBROUTINES COMPUT,INTRPT,RESUME,SSW ARE NEEDED.
C  ENTRY IS CHAIN FROM SECOM1 OR SCOM1A, NORMAL EXIT BY
C  CHAIN TO SCOM1R.
C
	COMMON NS1,NS2,LD,KSEQ,KSQN,KPRG,NVOL,TTAB,LIST,LISTX,ITAB,IS1,
     1  IS2,IP,STTL,COFF,NR,TITLE,NCODE,KODES,CODES
	DIMENSION IS1(32),IS2(120),IP(122),ITAB(27,27),
     1  STTL(6),LIST(22),LISTX(22,5),TITLE(8),CODES(200),KODES(200)
C
	GO TO (1,24,100),KPRG
1	NVOL=1
19	K=1
	GO TO (20,21,22,23),NVOL
20	DO 202  I=1,NCODE
	IF(CODES(I)-'SEQUV1')202,201,202
201	K=KODES(I)
202	CONTINUE
	IF(K)90,203,203
203	CALL IOPEN('DSK','SEQUV1')
	GO TO 24
21	DO 212  I=1,NCODE
	IF(CODES(I)-'SEQUV2')212,211,212
211	K=KODES(I)
212	CONTINUE
	IF(K)90,213,213
213	CALL IOPEN('DSK','SEQUV2')
	GO TO 24
22	DO 222  I=1,NCODE
	IF(CODES(I)-'SEQUV3')222,221,222
221	K=KODES(I)
222	CONTINUE
	IF(K)90,223,223
223	CALL IOPEN('DSK','SEQUV3')
	GO TO 24
23	DO 232	I=1,NCODE
	IF(CODES(I)-'SEQUV4')232,231,232
231	K=KODES(I)
232	CONTINUE
	IF(K)90,233,233
233	CALL IOPEN('DSK','SEQUV4')
C
24	CONTINUE
C
	I=1
	CALL INTRPT(I)
C
	READ(4,1025) KSEQ,KSQN,NS2,MM,KSL,KDD,KYY,CODE
1025	FORMAT(I5,I2,I4,1X,I2,A1,I2,1X,I2,1X,A6)
	WHEN=FLOAT((MM-1)*31+KDD-1)+FLOAT(KYY-70)*366.
	I=0
	CALL SSW(NSW)
1706	FORMAT(4X,I2,I5,I3,I5,2X,A6)
	IF(KSEQ) 90,36,36
36	IF(KSL+1056)37,38,37
37	WRITE(1,1037)NVOL,KSEQ,KSQN,NS2
1037	FORMAT('BAD TITLE LINE',4I5)
38	CONTINUE
	IF(COFF) 51,52,52
51	WHEN=-WHEN
52	IF(NS2-LD)80,53,53
53	IF(WHEN-COFF)80,54,54
54	CONTINUE
	ISKP=0
	DO 64  K=1,NCODE
	I=KCHAR(CODE,CODES(K))
	IF(I)64,63,64
63	ISKP=KODES(K)
64	CONTINUE
	IF(ISKP)80,70,70
70	IF(NS2-120)71,74,71
71	READ(4,1070)(IP(I),IS2(I), I=1,NS2),I,ISTAR
1070	FORMAT(5X,60A1)
	IF(ISTAR+1376)73,79,73
73	WRITE(1,1073)NVOL,KSEQ,KSQN,NS2,CODE
1073	FORMAT('COULD NOT FIND * AT END OF SEQUENCE',4I5,1X,A6)
	GO TO 79
74	READ(4,1070)(IP(I),IS2(I), I=1,NS2)
79	CONTINUE
C
	NSW=0
	CALL SSW(NSW)
	IF(NSW)76,76,77
76	WRITE(1,1080)NVOL,KSEQ,KSQN,NS2,CODE
1080	FORMAT(I3,I5,I3,I5,2X,A6)
77	CALL COMPUT
	GO TO 24
C
80	NSW=0
	CALL SSW(NSW)
	IF(NSW)81,81,82
81	WRITE(1,1081)NVOL,KSEQ,KSQN,NS2,CODE
1081	FORMAT(I3,I5,I3,I5,2X,A6,'  SKIPPED')
82	N=NS2/30 +1 -NS2/120
	DO 83  I=1,N
83	READ(4,1070)K
	GO TO 24
90	NVOL=NVOL+1
	I=0
	CALL INTRPT(I)
	IF(NVOL-4)19,19,91
91	CONTINUE
C  RESULTS OUT HERE
	CALL CHAIN('SCOM1R')
C
C  RESUME PATH
100	CALL RESUME
	GO TO 24
C
	END
