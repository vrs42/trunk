/
/	FUNCTION MW(I,J)
/	RETREIVES JTH WORD FROM ARRAY MW(64,64)
/	FIELD 5 STORAGE
/
OPDEF	TADI 1400
OPDEF	DCAI 3400
	ENTRY MW
	DUMMY	\I
	DUMMY	\J
\I,	BLOCK	2
\J,	BLOCK 2
MW,	BLOCK 2
	TAD MW
	DCA MR1
	JMS MWAR
	DCA ADDR
	JMS MWAR
	CLL RTL;RTL;RTL
	TAD ADDR
	DCA ADDR
CDFL,	HLT		/CHANGE TO DF 7
	TADI ADDR	/GET ENTRY
RDFL,	NOP		/RESET DF
	RETRN MW
/
MWAR,	0
MR1,	HLT
	TADI MW#
	DCA  MR2
	INC  MW#
	TADI MW#
	DCA  TEMP
	INC  MW#
MR2,	HLT
	TADI TEMP
	JMP I MWAR
ADDR,	BLOCK 1
\MW,	BLOCK 1
/
/SUBROUTINE MWST(I,J,N)
/ STORES N AS I,JTH WORD IN ARRAY
ENTRY	MWST
	DUMMY \N
\N,	BLOCK 2
MWST,	BLOCK 2
	TAD MWST
	DCA MST1
	JMS MSTAR	/GET I
	DCA ADDR
	JMS MSTAR	/GET J
	CLL RTL;RTL;RTL
	TAD ADDR
	DCA ADDR
	JMS MSTAR	/GET N
/
CDF2,	HLT		/CHANGE TO DF 7
	DCAI ADDR
RDF2,	NOP		/RESET DF
	RETRN MWST
/
MSTAR,	0
MST1,	HLT		/FOR CDF
	TADI MWST#
	DCA  MST2
	INC MWST#
	TADI MWST#
	DCA  TEMP
	INC MWST#
MST2,	HLT
	TADI TEMP
	JMP I MSTAR
TEMP,	0
/
/ INITIALIZATION ROUTINE
	ENTRY MWI
MWI,	BLOCK 2
	TAD  (6271	/TO USE DF 7
	DCA  CDFL
	TAD  (6271
	DCA  CDF2
	6214		/READ CURRENT DF
	TAD  (6201	/TO RESTORE
	DCA  RDFL
	TAD  RDFL
	DCA  RDF2
	TAD  RDFL
	DCA  MWI2
	DCA  TEMP
	6271		/CDF 7
MWI1,	DCAI  TEMP	/CLEAR FIELD  7
	ISZ  TEMP
	JMP  MWI1
MWI2,	0
	RETRN MWI
	END
