	SUBROUTINE RDW(NQ)
	COMMON NS1,NS2,NST1,L1,NST2,L2,NQMAX,NQRD
	DIMENSION M(64)
	IF(NQRD-NQ)5,12,5
5	CALL IOPEN('DSK','SANKOF')
	READ(4,1001) NS1,NS2,NST1,L1,NST2,L2,NQMAX
1001	FORMAT(6I5)
	N=(L1+39)/40
	N=N*L2*(NQ*2+1)
	DO 10  I=1,N
10	READ(4,1010) K
1010	FORMAT(A1)
12	DO 20  J=1,L2
	READ(4,1020)(M(I), I=1,L1)
1020	FORMAT(40A2)
	DO 19  I=1,L1
	N=M(I)
19	CALL MWST(I,J,N)
20	CONTINUE
	NQRD=-2
	RETURN
	END
