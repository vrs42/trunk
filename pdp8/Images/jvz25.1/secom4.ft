C SEQUENCE COMPARISON PROGRAM--SECOM4
C FOR TESTING POSSIBLE INTERNAL SEQUENCE HOMOLOGY
C ERIC SWANSON MAY L977
	COMMON ISEQ
	DIMENSION ISEQ(1000),LIST(5,21),TITLE(6),ITAB(27,27)
C
	WRITE(1,1000)
1000	FORMAT('INTERNAL HOMOLOGY TEST')
	DO 3  I=1,20
3	LIST(1,I)=0
	LIST(1,21)=2047
	READ(1,1001)TTAB
1001	FORMAT('TYPE SCORING TABLE TITLE (A6): ',A6)
	CALL IOPEN('DSK',TTAB)
	READ(4,1004)TITLE
1004	FORMAT(6A6)
	WRITE(1,1004)TITLE
	DO 5  J=1,27
5	READ(4,1005)(ITAB(I,J), I=1,27)
1005	FORMAT(27I2)
C
	READ(1,1010)FN
1010	FORMAT('TYPE SEQUENCE FILENAME: ',A6)
	CALL IOPEN('DSK',FN)
	READ(4,1012)LS1,TITLE
1012	FORMAT(I5,6A6)
	WRITE(1,1012)LS1,TITLE
	READ(4,1015)(ISEQ(I), I=1,LS1)
1015	FORMAT(30A1)
	DO 19  I=1,LS1
	ITMP=ISEQ(I)
S	TAD	\ITMP
S	CLL RTR;RTR;RTR
S	AND	(77
S	TAD	(-33
S	SMA SZA
S	CLA
S	TAD	(33
S	DCA	\ITMP
19	ISEQ(I)=ITMP
C
	READ(1,1020)LD
1020	FORMAT('TYPE DIAGONAL STRETCH LENGTH: ',I3)
C
	JN=LS1-LD
	DO 60  JJ=1,JN
S	TAD	\JJ
S	7421
	NV=0
	DO 29  J=1,LD
	IS=ISEQ(J)
	JS=ISEQ(JJ+J)
	NV=NV+ITAB(IS,JS)
29	CONTINUE
	I2=LS1-LD-JJ
	DO 44  I=1,I2
	K=2
	IS=ISEQ(I)
	JS=ISEQ(I+JJ)
	NV=NV-ITAB(IS,JS)
	IS=ISEQ(I+LD)
	JS=ISEQ(I+JJ+LD)
	NV=NV+ITAB(IS,JS)
33	KM1=K-1
	IF(NV-LIST(1,K))39,39,34
34	DO 36  IK=1,3
36	LIST(IK,KM1)=LIST(IK,K)
	K=K+1
	GO TO 33
39	IF(K-2)44,44,41
41	LIST(1,KM1)=NV
	LIST(2,KM1)=I+1
	LIST(3,KM1)=JJ
44	CONTINUE
C
60	CONTINUE
C
	WRITE(1,1070)
1070	FORMAT('  COORD  DIAG  VALUE')
	DO 70  II=1,20
	I=21-II
	K=LIST(2,I)+LIST(3,I)
	WRITE(1,1071)LIST(2,I),K,LIST(3,I),LIST(1,I)
1071	FORMAT(2I4,I5,I7)
70	CONTINUE
	END
