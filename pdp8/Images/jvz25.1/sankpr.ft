	DIMENSION M(200)
	CALL IOPEN('DSK','SANKOF')
	READ(4,1001)NS1,NS2,NST1,L1,NST2,L2,NQMAX
1001	FORMAT(6I5)
	DO 80  IJK=1,NQMAX
	DO 77  IVW=1,2
	WRITE(1,1011)
1011	FORMAT(///)
	DO 40  I=1,L2
	READ(4,1004)(M(K), K=1,L1)
1004	FORMAT(40A2)
	WRITE(1,1005)I,(M(K), K=1,L1)
1005	FORMAT(I3,2X,30I4/5X,30I4/5X,30I4)
40	CONTINUE
77	CONTINUE
80	CONTINUE
	END
