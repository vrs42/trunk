/	FUNCTION KCHAR(A,B)
/
/COMPARES A AND B AS SIX-CHARACTER STRINGS.
/RETURNS 0 IF A=B, OTHERWISE RETURNS NON-ZERO.
/BLANKS AND @ COUNT AS THE SAME CHARACTER.
/? IS A WILD CHARACTER--COMPARES GOOD AGAINST
/ANY OTHER CHARACTER.
/
OPDEF	TADI	1400
	ENTRY	KCHAR
	DUMMY	\A
	DUMMY	\B
\A,	BLOCK	2
\B,	BLOCK	2
KCHAR,	BLOCK	2
	TAD	KCHAR
	DCA	KCX1
KCX1,	HLT		/FOR CDF
	TADI	KCHAR#
	DCA	KC1
	INC	KCHAR#
	TADI	KCHAR#
	DCA	AA	/ADDRESS OF A
	INC	KCHAR#
	TADI	KCHAR#
	DCA	KC2
	INC	KCHAR#
	TADI	KCHAR#
	DCA	BB	/ADDRESS OF B
	INC	KCHAR#
/
	DCA	DIF
	TAD	(-3
	DCA	CNT
KC1,	HLT		/FOR CDF
	TADI	AA
	DCA	AA#
KC2,	HLT
	TADI	BB
	DCA	BB#
	TAD	AA#
	CLL RTR;RTR;RTR
	AND	(77
	TAD	(-40
	SZA
	TAD	(40
	DCA	TMP
	TAD	TMP
	TAD	(-77	/CHECKS ?
	SNA CLA
	JMP	KC3
	TAD	BB#
	CLL RTR;RTR;RTR
	AND	(77
	TAD	(-40
	SZA
	TAD	(40
	DCA	TMP2
	TAD	TMP2
	TAD	(-77
	SNA CLA
	JMP	KC3
	TAD	TMP
	CIA
	TAD	TMP2
	SZA CLA
	INC	DIF
/
KC3,	TAD	AA#
	AND	(77
	TAD	(-40
	SZA
	TAD	(40
	DCA	TMP
	TAD	TMP
	TAD	(-77
	SNA CLA
	JMP	KC5
KC4,	TAD	BB#
	AND	(77
	TAD	(-40
	SZA
	TAD	(40
	DCA	TMP2
	TAD	TMP2
	TAD	(-77
	SNA CLA
	JMP	KC5
	TAD	TMP
	CIA
	TAD	TMP2
	SZA CLA
	INC	DIF
KC5,	INC	AA
	INC	BB
	ISZ	CNT
	JMP	KC1
	TAD	DIF
	RETRN	KCHAR
/
AA,	0;0
BB,	0;0
CNT,	0
DIF,	0
TMP,	0
TMP2,	0
	END
