C  SCOM1A.FT   V1.5  MULTIPLE RUNS
C  THIS ROUTINE GETS RUN PARAMETERS FROM THE SECOMZ.DA FILE,
C  AND CHAINS TO SCOM1B.
C
	COMMON NS1,NS2,LD,KSEQ,KSQN,KPRG,NVOL,TTAB,LIST,LISTX,ITAB,IS1,
     1  IS2,IP,STTL,COFF,NR,TITLE,NCODE,KODES,CODES
	DIMENSION IS1(32),IS2(120),IP(122),ITAB(27,27),
     1  STTL(6),LIST(22),LISTX(22,5),TITLE(8),CODES(200),KODES(200)
C
	NN=NR
	NR=NR+1
	CALL IOPEN('DSK','SECOMZ')
	IF(NN)11,11,5
5	DO 9  J=1,NN
	READ(4,1009)A
1009	FORMAT(A6)
	IF(A-'GOGOGO')91,7,91
7	READ(4,1007)N
1007	FORMAT(12X,I3)
	N=(N-1)/20 +(N-1)/10 +4
	DO 10  I=1,N
10	READ(4,1009) A
9	CONTINUE
C
11	READ(4,1009)A
	IF(A-'GOGOGO')99,13,99
13	READ(4,1011)TTAB,NS1,LD,NCODE,COFF,TITLE
	READ(4,1012)(IS1(I), I=1,NS1)
	IF(NCODE)14,14,15
14	READ(4,1034)I,I
1034	FORMAT(A1)
	GO TO 16
15	READ(4,1044)(KODES(I), I=1,NCODE)
	READ(4,1045)(CODES(I), I=1,NCODE)
1011	FORMAT(A6,3I3,F10.0/8A6)
1044	FORMAT(20I3)
1045	FORMAT(10A6)
1012	FORMAT(32A1)
C
16	CALL IOPEN('DSK',TTAB)
	READ(4,1014)STTL
1014	FORMAT(6A6)
	DO 18  J=1,27
18	READ(4,1015)(ITAB(I,J), I=1,27)
1015	FORMAT(27I2)
C
	DO 22  I=1,21
	DO 21  J=1,4
21	LISTX(I,J)=0
22	LIST(I)=0
	LIST(22)=2047
	KPRG=1
	CALL CHAIN('SCOM1B')
	STOP
C
91	WRITE(1,1091)
1091	FORMAT('ERROR 91 IN SCOM1A')
99	STOP
	END
