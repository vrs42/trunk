C  SECOM2.FT   V1.5  MULTIPLE RUNS
C  SEQUENCE COMPARISON PROGRAM
C  NEEDS SUBROUTINE SSW(N)
C  CHAINS TO SCOM1A.SV
C
C  ERIC SWANSON    APRIL 1977
C
	COMMON NS1,NS2,LD,KSEQ,KSQN,KPRG,NVOL,TTAB,LIST,LISTX,ITAB,IS1,
     1  IS2,IP,STTL,COFF,NR,TITLE,NCODE,KODES,CODES
	DIMENSION IS1(32),IS2(120),IP(122),ITAB(27,27),
     1  STTL(6),LIST(22),LISTX(22,5),TITLE(8),CODES(200),KODES(200)
C
	KTAB=0
	WRITE(1,1000)
1000	FORMAT('SEQUENCE COMPARISON PROGRAM (MULTIPLE RUNS) V1.5'//)
	I=1
	CALL SSW(I)
	IF(I)10,10,2
2	WRITE(1,1002)
1002	FORMAT('RESET SENSE SWITCH 1'//)
C
10	READ(1,1003)NRUN
1003	FORMAT('NUMBER OF RUNS (MAX 5): ',I1)
	IF(NRUN-5)11,11,10
C
11	CONTINUE
	CALL OOPEN('DSK','SECOMZ')
	DO 80  NR=1,NRUN
	WRITE(1,1110)
1110	FORMAT(1X)
3	READ(1,1001) TTAB
1001	FORMAT('TYPE SCORING TABLE TITLE (A6):',A6)
	IF(TTAB-'RESUME')4,100,4
4	IF(TTAB-'      ')7,5,7
5	TTAB=TTABP
7	CALL IOPEN('DSK',TTAB)
	TTABP=TTAB
	READ(4,1004) STTL
	WRITE(1,1004) STTL
1004	FORMAT(6A6)
C
	READ(1,1006)TITLE
1006	FORMAT('RUN TITLE: ',8A6)
C
	READ(1,1009) NS1
1009	FORMAT('LENGTH OF TEST SEQUENCE, MAX 32 (I2):',I2)
9	WRITE(1,1010)
1010	FORMAT('TYPE TEST SEQUENCE:')
	READ(1,1012)(IS1(I), I=1,NS1)
1012	FORMAT(32A1)
	WRITE(1,1013)(IS1(I), I=1,NS1)
1013	FORMAT(/32(1X,A1))
	READ(1,1014) T
1014	FORMAT('IS SEQUENCE CORRECT?',A6)
	IF(T-'Y     ') 14,16,14
14	IF(T-'YES   ') 9,16,9
16	CONTINUE
C
26	READ(1,1017) LD
1017	FORMAT('TYPE DIAGONAL STRETCH LENGTH (I2):',I2)
	IF(LD-NS1)28,28,27
27	WRITE(1,1027)
1027	FORMAT('LENGTH MUST BE <= SEQUENCE LENGTH.')
	GO TO 26
28	CONTINUE
	IF(NR-2)29,70,70
29	READ(1,1029)MM,KDD,KYY,SIGN
1029	FORMAT('CUTOFF DATE:',I2,1X,I2,1X,I2,A6)
	IF(MM+KDD+KYY)281,281,282
281	KYY=70
	MM=1
	KDD=1
282	WRITE(1,1030)MM,KDD,KYY
1030	FORMAT(2X,I2,1H/,I2,1H/,I2)
	COFF=FLOAT(31*(MM-1)+KDD-1)+FLOAT(KYY-70)*366.
	IF(SIGN-'-     ') 32,31,32
31	COFF=-COFF
32	CONTINUE
C
C GET CHECKLIST OF PROTEIN CODES
	NCODE=0
	WRITE(1,1033)
1033	FORMAT('TYPE IN CHECKLIST OF PROTEIN CODES')
	DO 42  I=1,200
	GO TO 35
34	WRITE(1,1034)
1034	FORMAT('BAD INPUT')
35	READ(1,1038)A,T
1038	FORMAT('  ',A6,A1)
	IF(A-'      ')36,45,36
36	IF(T-'+     ')37,38,37
37	IF(T-'-     ')34,40,34
38	NCODE=NCODE+1
	KODES(NCODE)=0
	CODES(NCODE)=A
	GO TO 42
40	NCODE=NCODE+1
	KODES(NCODE)=-1
	CODES(NCODE)=A
42	CONTINUE
45	CONTINUE
C
70	WRITE(4,1040)
1040	FORMAT('GOGOGO')
	WRITE(4,1041)TTAB,NS1,LD,NCODE,COFF,TITLE
1041	FORMAT(A6,3I3,F10.0/8A6)
	WRITE(4,1042)(IS1(I), I=1,NS1)
1042	FORMAT(32A1)
	WRITE(4,1043)(KODES(I), I=1,NCODE)
1043	FORMAT(20I3)
	WRITE(4,1044)(CODES(I), I=1,NCODE)
1044	FORMAT(10A6)
80	CONTINUE
	WRITE(4,1045)
1045	FORMAT('ENDEND')
	CALL OCLOSE
C
	NR=0
	KPRG=1
	CALL CHAIN('SCOM1A')
100	WRITE(1,1100)
1100	FORMAT('USE SECOM1 TO RESUME.')
	END
