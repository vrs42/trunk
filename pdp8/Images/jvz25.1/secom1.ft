C  SECOM1.FT   V1.5    4/20/77
C  SEQUENCE COMPARISON PROGRAM
C  NEEDS SUBROUTINE SSW(N)
C  CHAINS TO SCOM1B.SV
C
C  ERIC SWANSON    JUL 1976
C
	COMMON NS1,NS2,LD,KSEQ,KSQN,KPRG,NVOL,TTAB,LIST,LISTX,ITAB,IS1,
     1  IS2,IP,STTL,COFF,NR,TITLE,NCODE,KODES,CODES
	DIMENSION IS1(32),IS2(120),IP(122),ITAB(27,27),
     1  STTL(6),LIST(22),LISTX(22,5),TITLE(8),CODES(200),KODES(200)
C
	KTAB=0
	NR=-9
	WRITE(1,1000)
1000	FORMAT('SEQUENCE COMPARISON PROGRAM  V1.4'/)
	I=1
	CALL SSW(I)
	IF(I)3,3,2
2	WRITE(1,1002)
1002	FORMAT('RESET SENSE SWITCH 1'//)
3	READ(1,1001) TTAB
1001	FORMAT('TYPE SCORING TABLE TITLE (A6):',A6)
	IF(TTAB-'RESUME')4,100,4
4	CALL IOPEN('DSK',TTAB)
	READ(4,1004) STTL
	WRITE(1,1004) STTL
1004	FORMAT(6A6)
	DO 5  J=1,27
5	READ(4,1005)(ITAB(I,J), I=1,27)
1005	FORMAT(27I2)
C
	READ(1,1006)TITLE
1006	FORMAT('RUN TITLE: ',8A6)
	READ(1,1009) NS1
1009	FORMAT('LENGTH OF TEST SEQUENCE, MAX 32 (I2):',I2)
9	WRITE(1,1010)
1010	FORMAT('TYPE TEST SEQUENCE:')
	READ(1,1012)(IS1(I), I=1,NS1)
1012	FORMAT(32A1)
	WRITE(1,1013)(IS1(I), I=1,NS1)
1013	FORMAT(/32(1X,A1))
	READ(1,1014) T
1014	FORMAT('IS SEQUENCE CORRECT?',A6)
	IF(T-'Y     ') 14,16,14
14	IF(T-'YES   ') 9,16,9
16	CONTINUE
C  INSERT SS1 CHECK HERE
C
26	READ(1,1017) LD
1017	FORMAT('TYPE DIAGONAL STRETCH LENGTH (I2):',I2)
	IF(LD-NS1)28,28,27
27	WRITE(1,1027)
1027	FORMAT('LENGTH MUST BE <= SEQUENCE LENGTH.')
	GO TO 26
28	CONTINUE
	READ(1,1029)MM,KDD,KYY,SIGN
1029	FORMAT('CUTOFF DATE:',I2,1X,I2,1X,I2,A6)
	IF(MM+KDD+KYY)281,281,282
281	KYY=70
	MM=1
	KDD=1
282	WRITE(1,1030)MM,KDD,KYY
1030	FORMAT(2X,I2,1H/,I2,1H/,I2)
	COFF=FLOAT(31*(MM-1)+KDD-1)+FLOAT(KYY-70)*366.
	IF(SIGN-'-     ') 32,31,32
31	COFF=-COFF
32	CONTINUE
C
C GET CHECKLIST OF PROTEIN CODES
	NCODE=0
	WRITE(1,1033)
1033	FORMAT('TYPE IN CHECKLIST OF PROTEIN CODES')
	DO 42  I=1,200
	GO TO 35
34	WRITE(1,1034)
1034	FORMAT('BAD INPUT')
35	READ(1,1038)A,T
1038	FORMAT('  ',A6,A1)
	IF(A-'      ')36,45,36
36	IF(T-'+     ')37,38,37
37	IF(T-'-     ')34,40,34
38	NCODE=NCODE+1
	KODES(NCODE)=0
	CODES(NCODE)=A
	GO TO 42
40	NCODE=NCODE+1
	KODES(NCODE)=-1
	CODES(NCODE)=A
42	CONTINUE
45	CONTINUE
	DO 58  I=1,21
	DO 57  J=1,4
57	LISTX(I,J)=0
58	LIST(I)=0
	LIST(22)=2047
	KPRG=1
	CALL CHAIN('SCOM1B')
100	KPRG=3
	CALL CHAIN('SCOM1B')
	END
