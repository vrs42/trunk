C SEQUENCE COMPARISON PROGRAM--SECOM5
C COMPARES TWO PROTEINS UP TO 1000 RESIDUES
C ERIC SWANSON MAY 1977
	COMMON ISEQ,ISEQ2
	DIMENSION ISEQ(1000),LIST(5,21),TITLE(6),ITAB(27,27)
	DIMENSION ISEQ2(1000)
C
	WRITE(1,1000)
1000	FORMAT('SEQUENCE COMPARISON')
	DO 3  I=1,20
3	LIST(1,I)=0
	LIST(1,21)=2047
	READ(1,1001)TTAB
1001	FORMAT('TYPE SCORING TABLE TITLE (A6): ',A6)
	CALL IOPEN('DSK',TTAB)
	READ(4,1004)TITLE
1004	FORMAT(6A6)
	WRITE(1,1004)TITLE
	DO 5  J=1,27
5	READ(4,1005)(ITAB(I,J), I=1,27)
1005	FORMAT(27I2)
C
	READ(1,1010)FN
1010	FORMAT('TYPE SEQUENCE FILENAME: ',A6)
	CALL IOPEN('DSK',FN)
	READ(4,1012)LS1
1012	FORMAT(I5)
	READ(4,1015)(ISEQ(I), I=1,LS1)
1015	FORMAT(30A1)
	DO 19  I=1,LS1
	ITMP=ISEQ(I)
S	TAD	\ITMP
S	CLL RTR;RTR;RTR
S	AND	(77
S	TAD	(-33
S	SMA SZA
S	CLA
S	TAD	(33
S	DCA	\ITMP
19	ISEQ(I)=ITMP
C
	READ(1,1010)FN
	CALL IOPEN('DSK',FN)
	READ(4,1012) LS2
	READ(4,1015)(ISEQ2(I), I=1,LS2)
	DO 22  I=1,LS2
	ITMP=ISEQ2(I)
S	TAD	\ITMP
S	CLL RTR;RTR;RTR
S	AND	(77
S	TAD	(-33
S	SMA SZA
S	CLA
S	TAD	(33
S	DCA	\ITMP
22	ISEQ2(I)=ITMP
C
	READ(1,1020)LD
1020	FORMAT('TYPE DIAGONAL STRETCH LENGTH: ',I3)
C
	DO 69  IJK=1,2
	KL2=1+IJK
	KL3=4-IJK
	JN=LS2-LD
	DO 60  JJ=1,JN
S	TAD	\JJ
S	7421
25	NV=0
	DO 29  J=1,LD
	IS=ISEQ(J)
	JS=ISEQ2(JJ+J)
	NV=NV+ITAB(IS,JS)
29	CONTINUE
	I2=LS1-LD
	I22=LS2-LD-JJ
	IF(I2-I22)31,30,30
30	I2=I22
31	DO 44  I=1,I2
	K=2
	IS=ISEQ(I)
	JS=ISEQ2(I+JJ)
	NV=NV-ITAB(IS,JS)
	IS=ISEQ(I+LD)
	JS=ISEQ2(I+JJ+LD)
	NV=NV+ITAB(IS,JS)
33	KM1=K-1
	IF(NV-LIST(1,K))39,39,34
34	DO 36  IK=1,3
36	LIST(IK,KM1)=LIST(IK,K)
	K=K+1
	GO TO 33
39	IF(K-2)44,44,41
41	LIST(1,KM1)=NV
	LIST(KL2,KM1)=I+1
	LIST(KL3,KM1)=I+1+JJ
44	CONTINUE
C
	IF(JJ)60,70,60
60	CONTINUE
C
	DO 64  I=1,1000
	K=ISEQ(I)
	ISEQ(I)=ISEQ2(I)
64	ISEQ2(I)=K
	K=LS1
	LS1=LS2
	LS2=K
69	CONTINUE
	JJ=0
	GO TO 25
C
70	WRITE(1,1070)
1070	FORMAT(/'  COORD  DIAG  VALUE')
	DO 77  II=1,20
	I=21-II
	K=LIST(2,I)-LIST(3,I)
	WRITE(1,1071)LIST(2,I),LIST(3,I),K,LIST(1,I)
1071	FORMAT(2I4,I5,I7)
77	CONTINUE
	END
