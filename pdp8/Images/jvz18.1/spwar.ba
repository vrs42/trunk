2230  IF D(I)<0 THEN 2260
2240  NEXT I
2250  GOTO 2320
2260  R1=I
2270D(I)=D(I)+FNZ(5)
2280IFD(I)>-0THEN2300
2290D(I)=0
2300  PRINT "*** TRUCE, ";
2310PRINTD$(R1);" STATE OF REPAIR IMPROVED ***"
