210   !
220   PRINT PNT(27);"H";PNT(27);"J"
230   PRINT"CONTROL CALLING LUNAR MODULE ..." \ PRINT \ PRINT
240   PRINT"YOU MAY SET THE FUEL RATE (K) TO ANY VALUE"
250   PRINT"BETWEEN 8 AND 200 LBS./SEC." \ PRINT
260   PRINT"YOU HAVE 16000 LBS. OF FUEL ON BOARD" \ PRINT
270   PRINT"ESTIMATED FREE-FALL IMPACT TIME IS 120 SEC."
280   PRINT"YOUR CAPSULE WEIGHT IS 32500 LBS." \ PRINT \ PRINT
290   PRINT"FIRST RADAR CHECK COMING UP ... BEGIN LANDING PROCEDURE !" \ PRINT
300   PRINT
310   PRINT"TIME","HEIGHT","VELOCITY","FUEL","FUEL RATE"
320   PRINT"(SEC)","MILES","  MPH","LBS.","  - K -" \ PRINT
330   PRINT
340   L=0\A=120\V=1\M=32500\N=16500
350   G=.001\Z=1.8
360   PRINT INT(L+.5),A,V*3600,M-N,"K";
370   INPUT K
380   T=10
390   IF K <> -2 GOTO 410
400   M1=M \ L1=L \ V1=V \ A1=A \ PRINT "SAVED YOUR POSITION" \ GOTO 370
410   IF K<0 GOTO 740
420   IF K=0 GOTO 470
430   IF K<8 THEN 450
440   IF K<=200 GOTO 470
450   PRINT "NOT POSSIBLE",,,,"K";
460   INPUT K \ GOTO 410
470   IF M-N-.001 <=0 GOTO 560
480   IF T<.001 GOTO 360
490   LET S=T\IF N+S*K<=M GOTO 510
500   LET S=(M-N)/K
510   LET I0=1 \ GOTO 960
520   IF I <= 0 GOTO 850
530   IF V<=0 GOTO 550
540   IF J<0 GOTO 880
550   LET I0=1\ GOTO 780
560   PRINT"FUEL OUT AT ";L;"SECS."
570   LET S=(-V+SQR(V*V+2*A*G))/G
580   LET V = V+G*S
590   LET L=L+S
600   PRINT"ON THE MOON AT ";L;"SECS."
610   LET W = 3600*V
620   PRINT "IMPACT VELOCITY OF ";W;"M.P.H."
630   PRINT "FUEL LEFT ";M-N;"LBS."
640   IF W>=1 GOTO 660
650   PRINT "PERFECT LANDING!  CONGRATULATIONS!!"\ GOTO 740
660   IF W >=10 THEN 680
670   PRINT "VERY GOOD LANDING, NOT PERFECT YET."\ GOTO 740
680   IF W >= 25 THEN 700
690   PRINT "A FAIR LANDING, NO CRAFT DAMAGE." \ GOTO 740
700   IF W >= 60 THEN720
710   PRINT "CRAFT DAMAGE -- BETTER LUCK NEXT TIME."\GOTO 740
720   PRINT "SORRY, BUT THERE WERE NO SURVIVORS."
730   PRINT "IN FACT YOU BLASTED A NEW LUNAR CRATER ";W*.277777;" FEET DEEP."
740   PRINT\PRINT\PRINT "TRY AGAIN? (Y,N,RESTART, OR LOW WINDOW)";
750   INPUT R$\R$=SEG$(R$,1,1)
760   IF R$="Y" THEN 330 \ IF R$="R" THEN 1120 \ IF R$="L" THEN 1060
770   PRINT\ PRINT "CONTROL OUT" \ GOTO 1130
780   LET L=L+S
790   LET T = T-S
800   LET M=M-S*K
810   LET A=I
820   LET V=J
830   IF I0=1 GOTO 470
840   IF I0=3 GOTO 930
850   IF S< .005 GOTO 600
860   LET S= 2*A/(V+SQR(V*V+2*A*(G-Z*K/M)))
870   LET I0=2 \GOTO 960
880   LET W=(1-M*G/(Z*K))/2
890   LET S=M*V/(Z*K*(W+SQR(W*W+V/Z)))+.05
900   LET I0=3 \GOTO 960
910   IF I<=0 THEN 850
920   GOTO 780
930   IF J>=0 THEN 470
940   IF V<=0 GOTO 470
950   GOTO 880
960   LET Q=S*K/M
970   IF Q<=0 THEN 1030
980   LET J=V+G*S+Z*(-Q-(Q^2)/2-(Q^3)/3-(Q^4)/4-(Q^5)/5)
990   LET I=A-G*S*S/2-V*S+Z*S*(Q/2+Q^2/6+Q^3/12+Q^4/20+Q^5/30)
1000  IF I0=1 GOTO 520
1010  IF I0=2 GOTO 780
1020  IF I0=3 GOTO 910
1030  LET J=V+G*S
1040  LET I=A-G*S*S/2-V*S
1050  GOTO1000
1060  LET L=140
1070  LET A=2.382342
1080  LET V=.1257558
1090  LET M=18500
1100  LET N=16500
1110  GOTO 350
1120  M=M1 \ L=L1 \ V=V1 \ A=A1 \ GOTO 360
1130  END 
