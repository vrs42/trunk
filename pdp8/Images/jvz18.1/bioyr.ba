5 REM PROGRAM NAME: BIOYR.BA
10 REMARKABLY WRITTEN BY ALAN C. PROCTOR
20 DIM M9(12),L(3),V(4),C$(4),M$(12,9)
30 DIM F(93,41),L$(72),L1$(72),N$(30),N1$(30),F$(20)
40 REM
50 DEF FNA(D0,M0,Y0)=M9(M0)+D0+SGN(INT(M0/3))*(1+SGN(INT(Y0/4)-Y0))
60 DEF FNB(J1,Y1)=J1+36524*(INT(Y1/100))+INT(365.25*(Y1-100*(INT(Y1/100))))
70 REM
80 READ D$\FOR I=1 TO 3\READ L(I)\NEXT I
90 FOR I=1 TO 4\READ C$(I)\NEXT I
100 FOR I=1 TO 12\READ M9(I)\NEXT I
110 FOR I=1 TO 12\READ M$(I)\NEXT I
120 DATA "-"
130 DATA 23,28,33
140 DATA "P","E","I","*"
150 DATA 0,31,59,90,120,151,181,212,243,273,304,334
160 DATA "JANUARY","FEBRUARY","MARCH","APRIL", "MAY","JUNE","JULY"
170 DATA "AUGUST","SEPTEMBER","OCTOBER","NOVEMBER","DECEMBER"
180 PRINT "OUTPUT DEV:FILNAM.EX";\INPUT F$
190 IF LEN(F$)=0 GOTO 210
200 GOTO 220
210 LET F$="TTY:"
220 FILEV #1:F$
230 FILEV #2:"DSK:SCRATC.CH"
240 PRINT "INPUT BIRTHDATE IN FORMAT MMDDYYYY -- ";\INPUT D1$
244 IF LEN(D1$)<>0 GOTO 245 \ LET D1$=D8$ \ PRINT D1$
245 LET D8$=D1$
250 PRINT #2:D1$
260 IF D1$="END" GOTO 350
270 PRINT "INPUT DESIRED YEAR IN FORMAT YYYY -- ";\INPUT D3$
274 IF LEN(D3$)<>0 GOTO 275 \ LET D3$=D9$ \ PRINT D3$
275 LET D9$=D3$
280 PRINT #2:D3$
290 PRINT "NAME, PLEASE -- ";\INPUT N$
294 IF LEN(N$)<>0 GOTO 295 \ LET N$=N1$ \ PRINT N$
295 LET N1$=N$
300 PRINT #2:N$
310 PRINT "INPUT ANY MISCELLANEOUS COMMENT HERE. "\INPUT L$
314 IF LEN(L$)<>0 GOTO 315 \ LET L$=L1$ \ PRINT L$
315 LET L1$=L$
320 PRINT #2:L$
330 GOTO 240
340 PRINT\PRINT
350 CLOSE #2
360 FILE #2:"DSK:SCRATC.CH"
370 INPUT #2:D1$\IF D1$="END" GOTO 1110\INPUT #2:D3$\INPUT #2:N$
380 INPUT #2:L$
390 IF SEG$(L$,1,3)="END" GOTO 1110
391 FOR Q=1 TO 12
392 LET D4$="0" \ IF Q>9 GOTO 396
394 LET D2$=D4$&STR$(Q)&D3$ \ GOTO 400
396 LET D2$=STR$(Q)&D3$
400 B2=VAL(SEG$(D1$,1,2))\B1=VAL(SEG$(D1$,3,4))\B3=VAL(SEG$(D1$,5,8))
410 C2=VAL(SEG$(D2$,1,2))\C3=VAL(SEG$(D2$,3,6))
420 T0=FNB(FNA(1,C2,C3),C3)-FNB(FNA(B1,B2,B3),B3)
430 T=T0 \ G=0
440 FOR I=1 TO 93
450 FOR J=1 TO 20\F(I,J)=0\NEXT J
460 F(I,21)=5
470 FOR J=22 TO 41\F(I,J)=0\NEXT J
480 NEXT I
490 PRINT #1:TAB(40);N$
500 PRINT #1:"BORN ON ";M$(B2);B1;",";B3
510 PRINT #1:L$\PRINT #1:" "
520 PRINT #1:"BIORHYTHM CHART FOR ";M$(C2);" ";C3;"  RUN ON ";
530 PRINT #1:M$(VAL(SEG$(DAT$(Z5),1,2)));" ";VAL(SEG$(DAT$(Z5),4,5));
540 PRINT #1:",";VAL(SEG$(DAT$(Z5),7,8))+1906
550 PRINT #1:" "
560 PRINT #1:"CHARTING THE PHYSICAL     - P (23 DAY CYCLE)"
570 PRINT #1:"             EMOTIONAL    - E (28 DAY CYCLE)"
580 PRINT #1:"             INTELLECTUAL - I (33 DAY CYCLE)"
590 PRINT #1:"         AND OVERALL      - *"
600 PRINT #1:" "
610 PRINT #1:"THESE CYCLES ARE BELIEVED TO OCCUR IN "
620 PRINT #1:"EVERYONE, BEGINNING ON THE DAY OF THEIR BIRTH."
630 PRINT #1:" "\PRINT #1:"NUMBER OF CYCLES SINCE BIRTH:  ";
640 FOR I=1 TO 3\PRINT #1:C$(I);" ";T/L(I),\NEXT I
650 PRINT #1:
660 PRINT #1:TAB(18);"MINUS";TAB(34);"ZERO";TAB(47);"POSITIVE"
670 PRINT #1:" "
680 REM
690 REM
700 LET P=3.14159
710 FOR I=1 TO 93
720 FOR K=1 TO 3
730 S=T/L(K)*2*P
740 IF S<3217 GOTO 770
750 S=S-3217
760 GOTO 740
770 LET V(K)=20*SIN(S)
780 NEXT K
790 V(4)=(V(1)+V(2)+V(3))/3
800 FOR K=1 TO 4
810 K0=INT(ABS(V(K)+.5)*SGN(V(K)))+21
820 F(I,K0)=K
830 NEXT K
840 T=T+1/3
850 NEXT I
860 REM
870 REM
880 REM
890 PRINT #1:
900 FOR I=1 TO 93
910 PRINT #1:TAB(10);
920 IF INT(I/3)*3<>I GOTO 940
930 G=G+1\PRINT #1:STR$(G);
940 PRINT #1:TAB(15);
950 FOR J=1 TO 41
960 IF F(I,J)<>0 GOTO 980
970 PRINT #1:" ";
980 IF F(I,J)<>1 GOTO 1000
990 PRINT #1:"P";
1000 IF F(I,J)<>2 GOTO 1020
1010 PRINT #1:"E";
1020 IF F(I,J)<>3 GOTO 1040
1030 PRINT #1:"I";
1040 IF F(I,J)<>4 GOTO 1060
1050 PRINT #1:"*";
1060 IF F(I,J)<>5 GOTO 1080
1070 PRINT #1:"-";
1080 NEXT J\PRINT #1:" "\NEXT I
1090 PRINT #1:" "\PRINT #1:" "\PRINT #1:TAB(40);M$(C2);" ";C3
1100 PRINT #1:PNT(12) \ NEXT Q \ GOTO 370
1110 CLOSE #1\CLOSE #2
1120 FILEV #1:"DSK:SCRATC.CH"\CLOSE #1
1130 END
