1500 X=CCL("LOAD AJRLGA.SV/I/G")
1510 STOP
1520 PRINT PNT(27);"H",PNT(27);"J"
1525 PRINT CUR$(5,0)
1530 RETURN
1540 PRINT"         DUMMY TRY IT AGAIN AND GET IT RIGHT THIS TIME!"
1550 X=0
1560 FOR X=1 TO 1000
1570 NEXT X
