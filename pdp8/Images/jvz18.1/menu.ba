570 X=CCL("LOAD DJKKBA.SV/I/G")
580 X=CCL("LOAD DJCLAA.SV/I/G")
590 X=CCL("LOAD DHKMCC.SV/I/G")
600 X=CCL("LOAD DHKMAD.SV/I/G")
610 X=CCL("LOAD AKVTFA.SV/I/G")
620 X=CCL("LOAD AJKTAB.SV/I/G")
630 X=CCL("LOAD DHKAFA.SV/I/G")
640 X=CCL("LOAD DHKAGA.SV/I/G")
