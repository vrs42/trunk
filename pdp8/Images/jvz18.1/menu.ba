10 REM SCREEN SELECT
20 A=0
30 GOSUB 1520
40 PRINT"                 DIAGNOSTIC SELECT MENU  BY WADE GOODWIN"
50 PRINT
60 PRINT"                    1. PDP8 CPU AND MEMORY DIAGNOSTICS"
70 PRINT"                    2. RX01/2 AND PRINTER DIAGNOSTICS"
80 PRINT"                    3. GOTO OS8"
90 PRINT"                    4. RK05 DIAGNOSTICS"
100 PRINT"                    5. GAMES"
110 PRINT"                    6. RL01 DIAGNOSTICS"
120 PRINT"                    PLEASE SELECT BY NUMBER ";
130 INPUT A
140 GOSUB 1520
150 IF A=1 GOTO 260
160 IF A=2 GOTO 660
170 IF A=3 GOTO 230
180 IF A=4 GOTO 960
190 IF A=5 GOTO 240
200 IF A=6 GOTO 1250
210 GOSUB 1540
220 GOTO 20
230 X=CCL("LOAD OS8.SV/I/G")
240 X=CCL("LOAD GAMENU.SV/I/G")
250 STOP
