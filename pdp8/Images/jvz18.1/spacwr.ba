5540 IF S8>144 THEN 5570
5550 R$=SEG$(R$,1,S8-73)&A$&SEG$(R$,S8-69,72)
5560 GOTO 5580
5570 S$=SEG$(S$,1,S8-145)&A$&SEG$(S$,S8-141,72)
5580 RETURN
5590 !
5600 !	-------------------------------------
5610 !	  PRINTS DEVICE NAME FROM ARRAY
5620 !	-------------------------------------
5630 !
5640 S8=R1*12-11\IF S8>72 THEN 5660
5650 PRINT SEG$(D$,S8,S8+11);\GOTO 5670
5660 PRINT SEG$(E$,S8-72,S8-61);
5670 RETURN
5680 !
5690 !	-------------------------------------------
5700 !	  STRING COMPARISON IN QUADRANT ARRAY
5710 !	-------------------------------------------
5720 !
5730 S8=Z1*24+Z2*3-26\Z3=0\IF S8>72 THEN 5760
5740 IF SEG$(Q$,S8,S8+2)<>A$ THEN 5810
5750 Z3=1\GOTO 5810
5760 IF S8>144 THEN 5790
5770 IF SEG$(R$,S8-72,S8-70)<>A$ THEN 5810
5780 Z3=1\GOTO 5810
5790 IF SEG$(S$,S8-144,S8-142)<>A$ THEN 5810
5800 Z3=1
5810 RETURN
5820 END
