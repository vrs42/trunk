1950 PRINT\PRINT "DAMAGE CONTROL REPORT:";
1960 GOSUB 5590
1970 PRINT" STATE OF REPAIR IMPROVED"\PRINT
1980 N=INT((W1+.0625)*8)\A$="   "\Z1=S1\Z2=S2
1990 GOSUB 5460
2000 X=S1\Y=S2
2010 X1=C(C1,1)+(C(C1+1,1)-C(C1,1))*(C1-INT(C1))
2020 X2=C(C1,2)+(C(C1+1,2)-C(C1,2))*(C1-INT(C1))
2030 FOR I=1TO N\S1=S1+X1\S2=S2+X2
2040 IF S1<1 GOTO 2230\IF S1>=9 GOTO 2230\IF S2<1 GOTO 2230\IF S2>=9 GOTO 2230
2050 S8=S1*24+S2*3-26\ IF S8>72 THEN 2080
2060 IF SEG$(Q$,S8,S8+2)="   " GOTO 2150
2070 GOTO 2120
2080 IF S8>144 THEN 2110
2090 IF SEG$(R$,S8-72,S8-70)="   " GOTO 2150
2100 GOTO 2120
2110 IF SEG$(S$,S8-144,S8-142)="   " GOTO 2150
2120 S1=INT(S1-X1)\S2=INT(S2-X2)\PRINT "WARP ENGINES SHUTDOWN AT SECTOR";
2130 PRINT S1;",";S2;"DUE TO BAD NAVAGATION"
2140 GOTO 2170
2150 NEXT I
2160 S1=INT(S1)\S2=INT(S2)
2170 A$="<*>"\Z1=S1\Z2=S2
2180 GOSUB 5460
2190 E=E-N+5\T=(INT(10*T+1.1))/10\IF W1<1 THEN 2210
2200 T=(INT(10*T+9))/10
2210 IF T>T0+T9 THEN 3950
2220 GOTO 1350
2230 X=Q1*8+X+X1*N\Y=Q2*8+Y+X2*N
2240 Q1=INT(X/8)\Q2=INT(Y/8)\S1=INT(X-Q1*8)\S2=INT(Y-Q2*8)
2250 IF S1<>0 THEN 2270
2260 Q1=Q1-1\S1=8
2270 IF S2<>0 THEN 2290
2280 Q2=Q2-1\S2=8
2290 T=T+1\E=E-N+5
2300 IF T>T0 + T9 THEN 3950
2310 GOTO 780
