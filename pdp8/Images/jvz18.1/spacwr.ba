470  !	--------------------------------
480  !        SET UP WHAT EXISTS
490  !           IN THE GALAXY
500  !  --------------------------------
510  !
520  FOR I=1TO8
530  FOR J=1TO8
540  R1=RND(1)
550  IF R1>.98 THEN 590
560  IF R1>.95 THEN 600
570  IF R1>.8 THEN 610
580  K3=0\GOTO 620
590  K3=3\K9=K9+3\GOTO 620
600  K3=2\K9=K9+2\GOTO 620
610  K3=1\K9=K9+1
620  R1=RND(1)
630  IF R1>.96 THEN 650
640  B3=0\GOTO 660
650  B3=1\B9=B9+1
660  S3=INT(RND(1)*8+1)
670  G(I,J)=K3*100+B3*10+S3
680  Z(I,J)=0
690  NEXT J
700  NEXT I
710  K7=K9
720  PRINT\PRINT
730  IF B9>0 GOTO 760
740  G(6,3)=G(6,3)+10
750  B9=1
760  PRINT "YOU MUST DESTROY";K9;"KLINGONS IN";T9;
770  PRINT "STARDATES WITH";B9;"STARBASES"
780  S3=0\K3=0\B3=0
790  IF Q1<1 GOTO 880\IF Q1>8 GOTO 880\IF Q2<1 GOTO 880\IF Q2>8 GOTO 880
800  X=G(Q1,Q2)*.01
810  K3=INT(X)
820  B3=INT((X-K3)*10)
830  S3=G(Q1,Q2)-INT(G(Q1,Q2)*.1)*10
840  IF K3=0 THEN880
850  IF S>200 THEN 870
860  PRINT "   SHIELDS DANGEROUSLY LOW"
870  PRINT "COMBAT AREA      CONDITION RED"
880  FOR I=1TO3
890  K(I,3)=0
900  NEXT I
