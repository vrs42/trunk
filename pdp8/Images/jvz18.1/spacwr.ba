360  Q2=INT(RND(1)*8+1)
370  S1=INT(RND(1)*8+1)
380  S2=INT(RND(1)*8+1)
390  C(2,1)=-1\C(3,1)=-1\C(4,1)=-1\C(4,2)=-1\C(5,2)=-1\C(6,2)=-1
400  C(1,1)=0\C(3,2)=0\C(5,1)=0\C(7,2)=0\C(9,1)=0
410  C(1,2)=1\C(2,2)=1\C(6,1)=1\C(7,1)=1\C(8,1)=1\C(8,2)=1\C(9,2)=1
420  D$="WARP ENGINESS.R. SENSORSL.R. SENSORSPHASER CNTRL"
