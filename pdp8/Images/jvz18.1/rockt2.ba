10 REM LUNAR 1 IS A INTERACTIVE GAME THAT STIMULATES A LUNAR
20 REM LANDING SIMILAR TO THAT OF THE APOLLO PROGRAM.
30 REM THERE IS ABSOLUTELY NO CHANCE INVOLVED.
40 LET Z$="GO"
50 DIM N$(11)
60 LET B1=1
70 LET M=17.95
80 LET F1=5.25
90 LET N=7.5
100 LET R0=926
110 LET V0=1.29
120 LET T=0
130 LET H0=60
140 LET R=R0+H0
150 LET A=-3.425
160 LET R1=0
170 LET A1=8.84361E-04
180 LET R3=0
190 LET A3=0
200 LET M1=7.45
210 LET M0=M1
220 LET B=750
230 LET T1=0
240 LET F=0
250 LET P=0
260 LET N=1
270 LET M2=0
280 LET S=0
290 LET C=0
300 IF Z$="YES" THEN 2400
310 PRINT
320 PRINT "LUNAR LANDING SIMULATION"
330 PRINT
340 PRINT "HAVE YOU FLOWN ON AN APOLLO/LEM MISSION BEFORE#";
350 PRINT "(YES OR NO)";
360 INPUT Q$
370 IF Q$="YES" THEN 410
380 IF Q$="NO" THEN 440
390 PRINT "JUST ANSWER THE QUESTION, PLEASE";
400 GOTO 350
410 PRINT
420 PRINT "ENTER MEASUREMENT OPTION NUMBER";
430 GOTO 480
440 PRINT
450 PRINT "WHICH SYSTEM OF MEASUREMENT DO YOU PREFER?"
460 PRINT " 1=METRIC     0=ENGLISH"
470 PRINT "ENTER THE APPROPRIATE NUMBER";
480 INPUT K
490 PRINT
500 IF K=0 THEN 590
510 IF K=1 THEN 530
520 GOTO 470
530 LET Z=1852.8
540 LET M$="METERS"
550 LET G3=3.6
560 LET N$=" KILOMETERS"
570 LET G5=1000
580 GOTO 640
590 LET Z=6080
600 LET M$="FEET"
610 LET G3=.592
620 LET N$=" MILES"
630 LET G5=Z
640 PRINT "PRINT ON LPT (0) OR TTY (1)";
650 INPUT P
660 IF P=1 GOTO 700
670 IF P<>0 GOTO 640
680 FILEV #1:"LPT:"
690 GOTO 710
700 FILEV #1:"TTY:"
710 IF B1=3 THEN 1240
720 IF Q$="YES" THEN 1070
730 PRINT #1:
740 PRINT #1:"YOU ARE ON A LUNAR LANDING MISSION. AS THE PILOT OF"
750 PRINT #1:"THE LUNAR EXCURSION MODULE, YOU WILL BE EXPECTED TO"
760 PRINT #1:"GIVE CERTAIN COMMANDS TO THE MODULE NAVIGATION SYSTEM."
770 PRINT #1:"THE ON BOARD COMPUTER WILL GIVE A RUNNING ACCOUNT"
780 PRINT #1:"OF INFORMATION NEEDED TO NAVIGATE THE SHIP."
790 PRINT #1:
800 PRINT #1:
810 PRINT #1:"THE ATTITUDE ANGLE CALLED FOR IS DESCRIBED AS FOLLOWS-"
820 PRINT #1:"+ OR - 180 DEGREES IS DIRECTLY AWAY FROM THE MOON"
830 PRINT #1:"-90 DEGREES IS ON A TANGENT IN THE DIRECTION OF ORBIT"
840 PRINT #1:"90 DEGREES IS ON A TANGENT FROM THE DIRECTION OF ORBIT"
850 PRINT #1:"0 (ZERO) DEGREES IS DIRECTLY TOWARD THE MOON"
860 PRINT #1:
870 PRINT #1:TAB(30);"-180,180"
880 PRINT #1:TAB(27);"-90 < -+- > 90"
890 PRINT #1:TAB(27);"-90 < -+- > 90"
900 PRINT #1:TAB(34);"!"
910 PRINT #1:TAB(34);"0"
920 PRINT #1:TAB(23);"<< DIRECTION OF ORBIT <<"
930 PRINT #1:
940 PRINT #1:TAB(27);"SURFACE OF MOON"
950 PRINT #1:
960 PRINT #1:
970 PRINT #1:"ALL ANGLES BETWEEN -180 AND 180 DEGREES ARE ACCEPTED."
980 PRINT #1:
990 PRINT #1:"1 FUEL UNIT = 1 SEC. AT MAX. THRUST"
1000 PRINT #1:"ANY DISCREPANCIES ARE ACCOUNTED FOR IN THE USE OF FUEL"
1010 PRINT #1:"FOR AN ATTITUDE CHANGE."
1020 PRINT #1:"AVAILABLE ENGINE POWER: 0 (ZERO) AND ANY VALUE BETWEEN"
1030 PRINT #1:"10 AND 100 PERCENT"
1040 PRINT #1:
1050 PRINT #1:"NEGATIVE THRUST OR TIME IS PROHIPITED"
1060 PRINT #1:
1070 PRINT #1:
1080 PRINT #1:"INPUT: TIME INTERVAL IN SECONDS ------ (T)"
1090 PRINT #1:"       PERCENTAGE OF THRUST ---------- (P)"
1100 PRINT #1:"       ATTITUDE ANGLE IN DEGREES ----- (A)"
1110 PRINT #1:
1120 IF Q$="YES" THEN 1170
1130 PRINT #1:"FOR EXAMPLE:"
1140 PRINT #1:"T,P,A?10,65,-60"
1150 PRINT #1:"TO ABORT THE MISSION AT ANY TIME, ENTER 0,0,0"
1160 PRINT #1:
1170 PRINT #1:"OUTPUT: TOTAL TIME ELAPSED IN SECONDS"
1180 PRINT #1:"        HEIGHT IN ";M$
1190 PRINT #1:"        DISTANCE FROM LANDING SITE IN ";M$
1200 PRINT #1:"        VERTICAL VELOCITY IN ";M$;"/SECOND"
1210 PRINT #1:"        HORIZONTAL VELOCITY IN ";M$;"/SECOND"
1220 PRINT #1:"        FUEL UNITS REMAINING"
1230 PRINT #1:
1240 CLOSE #1
1250 GOTO 1450
1260 PRINT
1270 PRINT "T,P,A";
1280 INPUT T1,F,P
1290 LET F=F/100
1300 IF T1<0 THEN 1920
1310 IF T1=0 THEN 2280
1320 IF ABS(F-.05)>1 THEN 2000
1330 IF ABS(F-.05)<.05 THEN 2000
1340 IF ABS(P)>180 THEN 1960
1350 LET N=20
1360 IF T1<400 THEN 1380
1370 LET N=T1/20
1380 LET T1=T1/N
1390 LET P=P*3.14159/180
1400 LET S=SIN(P)
1410 LET C=COS(P)
1420 LET M2=M0*T1*F/B
1430 LET R3=-.5*R0*((V0/R)^2)+R*A1*A1
1440 LET A3=-2*R1*A1/R
1450 FOR I=1 TO N
1460 IF M1=0 THEN 1540
1470 LET M1=M1-M2
1480 IF M1>0 THEN 1560
1490 LET F=F*(1+M1/M2)
1500 LET M2=M1+M2
1510 PRINT "YOU ARE OUT OF FUEL"
1520 LET M1=0
1530 GOTO 1560
1540 LET F=0
1550 LET M2=0
1560 LET M=M-.5*M2
1570 LET R4=R3
1580 LET R3=-.5*R0*((V0/R)^2)+R*A1*A1
1590 LET R2=(3*R3-R4)/2+.00526*F1*F*C/M
1600 LET A4=A3
1610 LET A3=-2*R1*A1/R
1620 LET A2=(3*A3-A4)/2+.00526*F1*F*S/(M*R)
1630 LET X=R1*T1+.5*R2*T1*T1
1640 LET R=R+X
1650 LET H0=H0+X
1660 LET R1=R1+R2*T1
1670 LET A=A+A1*T1+.5*A2*T1*T1
1680 LET A1=A1+A2*T1
1690 LET M=M-.5*M2
1700 LET T=T+T1
1710 IF H0<3.287828E-04 THEN 1730
1720 NEXT I
1730 LET H=H0*Z
1740 LET H1=R1*Z
1750 LET D=R0*A*Z
1760 LET D1=R*A1*Z
1770 LET T2=M1*B/M0
1780 PRINT TAB(1);T;TAB(10);H;TAB(23);D;
1790 PRINT TAB(37);H1;TAB(49);D1;TAB(60);T2
1800 IF H0<3.287828E-04 THEN 1870
1810 IF R0*A>164.4736 THEN 2210
1820 IF M1>0 THEN 1270
1830 LET T1=22
1840 LET F=0
1850 LET P=0
1860 GOTO 1350
1870 IF R1<-8.21957E-04 THEN 2150
1880 IF ABS(R*A1)>4.931742E-04 THEN 2150
1890 IF H0<-3.287828E-04 THEN 2150
1900 IF ABS(D)>10*Z THEN 2240
1910 GOTO 2100
1920 PRINT
1930 PRINT "THIS SPACECRAFT IS NOT ABLE TO VIOLATE THE SPACE-";
1940 PRINT "TIME CONTINUM"
1950 GOTO 1260
1960 PRINT
1970 PRINT "IF YOU WANT TO SPIN AROUND, GO OUTSIDE THE MODULE";
1980 PRINT "FOR AN E.V.A"
1990 GOTO 1260
2000 PRINT
2010 PRINT "IMPOSSIBLE THRUST-VALUE ";
2020 IF F<0 THEN 2080
2030 IF F-.05<.05 THEN 2060
2040 PRINT "TOO LARGE"
2050 GOTO 1260
2060 PRINT "TOO SMALL"
2070 GOTO 1260
2080 PRINT "NEGATIVE"
2090 GOTO 1260
2100 PRINT
2110 PRINT "TRANQUILITY BASE HERE -- THE EAGLE HAS LANDED"
2120 PRINT "CONGRATULATIONS - THERE WAS NO SPACECRAFT DAMAGE"
2130 PRINT "YOU MAY NOW PROCEED WITH SURFACE EXPLORATION."
2140 GOTO 2300
2150 PRINT
2160 PRINT "CRASH !!!!!!!!!!"
2170 PRINT "YOUR IMPACT CREATED A CRATER";ABS(H);M$;" DEEP"
2180 X1=SQR(D1*D1+H1*H1)*G3
2190 PRINT "AT CONTACT YOU WERE TRAVELLING";X1;N$;"/HR."
2200 GOTO 2300
2210 PRINT
2220 PRINT "YOU HAVE BEEN LOST IN SPACE WITH NO HOPE OF RECOVERY"
2230 GOTO 2300
2240 PRINT "YOU ARE DOWN SAFELY - "
2250 PRINT
2260 PRINT "BUT MISSED THE LANDING SITE BY";ABS(D/G5);N$
2270 GOTO 2300
2280 PRINT
2290 PRINT "MISSION ABORTED"
2300 PRINT
2310 PRINT "DO YOU WANT TO FLY IT AGAIN ? (YES OR NO)";
2320 INPUT Z$
2330 IF Z$="YES" THEN 70
2340 IF Z$="NO" THEN 2360
2350 GOTO 2310
2360 PRINT
2370 PRINT "TOO BAD, THE SPACE PROGRAM HATES TO LOSE EXPERIENCED";
2380 PRINT " ASTRONAUTS."
2390 STOP
2400 PRINT
2410 PRINT "OK, DO YOU WANT THE COMPLETE INSTRUCTIONS OR THE INPUT-"
2420 PRINT "OUTPUT STATEMENTS ?"
2430 PRINT "1=COMPLETE INSTRUCTIONS"
2440 PRINT "2=INPUT-OUTPUT STATEMENTS"
2450 PRINT "3=NEITHER"
2460 INPUT B1
2470 LET Q$="NO"
2480 IF B1=1 THEN 440
2490 LET Q$="YES"
2500 IF B1=2 THEN 410
2510 IF B1=3 THEN 410
2520 GOTO 2430
2530 END
