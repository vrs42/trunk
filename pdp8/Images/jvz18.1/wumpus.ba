1530 PRINT "THERE IS A SUPER-BAT IN ROOM";H;".  FLAP--FLAP OUCH!!"
1540 H=INT(20*RND(0))+1
1550 IF D(H)>999 GOTO 1540
1560 IF H=H1 GOTO 1540
1570 GOTO 940
1580 IF J>=100 GOTO 1710
1590 PRINT "YOU FELL INTO THE BOTTOMLESS PIT IN ROOM";H
1600 IF J-10<>0 GOTO 2430
1610 IF D(H)<>INT(D(H)/10)*10 GOTO 2450
