2260 IF F=B(W) GOTO 2280
2270 IF F<>C(W) GOTO 2240
2280 X=100000
2290 D(F)=D(F)+X
2300 W=F
2310 GOSUB 2510
2320 F=A(W)
2330 GOSUB 2510
2340 F=B(W)
2350 GOSUB 2510
2360 F=C(W)
2370 GOSUB 2510
