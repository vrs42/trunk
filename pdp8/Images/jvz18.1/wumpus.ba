50  PRINT \ PRINT
100  PRINT "HERE WE GO----"
110  PRINT "DOWN"
120  PRINT " O"
130  PRINT "  W"
140  PRINT "DOWN"
150  PRINT
160  DIM A(20),B(20),C(20),D(20)
170  DIM Q$(20),P$(10)
180  READ Q$
200  FOR Z=1 TO 20
210  A(Z)=0
220  B(Z)=0
230  C(Z)=0
240  D(Z)=0
250  NEXT Z
260  R0=.02
270  B0=0
280  L0=0
290  FOR Z=1 TO 20
300  IF A(Z)<>0 GOTO 360
310  F=INT(20*RND(0))+1
320  IF F=Z GOTO 310
330  IF A(F)<>0 GOTO 310
340  A(Z)=F
350  A(F)=Z
360  NEXT Z
370  FOR Z=1 TO 20
380  IF B(Z)<>0 GOTO 450
390  F=INT(20*RND(0))+1
400  IF F=Z GOTO 390
410  IF A(Z)=F GOTO 390
420  IF B(F)<>0 GOTO 390
430  B(Z)=F
440  B(F)=Z
450  NEXT Z
460  FOR X=1 TO 20
470  IF D(X)<>0 GOTO 580
480  IF X=1 GOTO 510
490  B(Y)=X
500  B(X)=Y
510  Y=X
520  D(Y)=1
530  Y=A(Y)
540  D(Y)=1
550  IF B(Y)=X GOTO 580
560  Y=B(Y)
570  GOTO 520
580  D(X)=0
590  NEXT X
600  B(Y)=1
610  B(1)=Y
620  FOR Z=1 TO 20
630  IF C(Z)<>0 GOTO 710
640  F=INT(20*RND(0))+1
650  IF F=Z GOTO 640
660  IF F=A(Z) GOTO 640
670  IF F=B(Z) GOTO 640
680  IF C(F)<>0 GOTO 640
690  C(Z)=F
700  C(F)=Z
710  NEXT Z
720  FOR X=1000 TO 10000 STEP 9000
730  FOR Z=1 TO 3
740  F=INT(20*RND(0))+1
750  IF D(F)>=X GOTO 740
760  D(F)=D(F)+X
770  GOSUB 2510
780  NEXT Z
790  NEXT X
800  F=INT(20*RND(0))+1
810  X=100000
820  D(F)=D(F)+X
830  GOSUB 2510
840  W=F
850  F=A(W)
860  GOSUB 2510
870  F=B(W)
880  GOSUB 2510
890  F=C(W)
900  GOSUB 2510
910  H=INT(20*RND(0))+1
920  IF D(H)>=1000 GOTO 910
930  FOR S=5 TO 1 STEP -1
940  IF L0=0 GOTO 980
950  GOSUB 2120
960  PRINT "I SEE THAT TUNNELS A B AND C LEAD TO ROOMS";
970  PRINT A(H);B(H);"AND";C(H);"RESPECTIVELY"
980  IF RND(0)>.04 GOTO 1000
990  GOSUB 2580
1000 J=D(H)
1010 IF J>=1000 GOTO 1510
1020 GOTO 1340
1030 IF J=0 GOTO 1120
1040 IF J=INT(J/10)*10 GOTO 1060
1050 PRINT "I HEAR SQUEAKING, ";
1060 J=INT(J/10)
1070 IF J=INT(J/10)*10 GOTO 1090
1080 PRINT "I FEEL A DRAFT, ";
1090 IF J<10 GOTO 1110
1100 PRINT "I SMELL A WUMPUS";
1110 PRINT
1120 PRINT "YOU ARE IN ROOM";H;"  MOVE THROUGH TUNNEL";
