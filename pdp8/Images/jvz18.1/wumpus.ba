1140 INPUT P$
1150 IF P$<>"A" GOTO 1180
1160 H=A(H)
1170 GOTO 940
1180 IF P$<>"B" GOTO 1210
1190 H=B(H)
1200 GOTO 940
1210 IF P$<>"C" GOTO 1240
1220 H=C(H)
1230 GOTO 940
