1720 GOTO 1620
1730 PRINT "YOU SHOT YOURSELF"
1740 GOTO 1620
1750 PRINT "THE ARROW ZINGS IN";
1760 K=H
1770 K1=H
1780 FOR R=1 TO 5
1790 PRINT "TO ROOM ";
1800 INPUT M
1810 IF M=A(K) GOTO 1880
1820 IF M=B(K) GOTO 1880
1830 IF M=C(K) GOTO 1880
