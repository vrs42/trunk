1250 IF P$<>"MAP" GOTO 1280
1260 GOSUB 2670
1270 GOTO 1000
1280 IF P$<>"LIGHTS ON" GOTO 1310
1290 L0=1
1300 GOTO 940
1310 IF P$<>"LIGHTS OFF" GOTO 940
1320 L0=0
1330 GOTO 940
1340 IF RND(0)>R0 GOTO 1030
1350 PRINT "YOU TRIPPED ON A ";Q$;" IN ROOM";H;
1360 F=INT(20*RND(0))+1
1370 IF F=A(H) GOTO 1410
1380 IF F=B(H) GOTO 1410
1390 IF F<>C(H) GOTO 1360
1400 IF F=H GOTO 1360
1410 PRINT "AND HAVE TUMBLED INTO ROOM";F
1420 IF R0<.2 GOTO 1460
1430 IF RND(0)<.5 GOTO 1460
1440 PRINT "YOU ARE GETTING CLUMSIER BY THE MINUTE"
