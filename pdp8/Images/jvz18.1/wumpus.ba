1850 R=6
1860 M=INT(20*RND(0))+1
1870 GOTO 1810
1880 IF R<=5 GOTO 1910
1890 PRINT "THE ARROW WENT ASTRAY"
1900 GOTO 1920
1910 IF M=K1 GOTO 1850
