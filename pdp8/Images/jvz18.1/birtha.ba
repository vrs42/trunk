10 DIM G$(12,18),H$(32,60)
20 RANDOMIZE
30 FOR X=1 TO 12
40 READ G$(X)
50 NEXT X
60 FOR X=1 TO 32
70 READ H$(X)
80 NEXT X
90 GOSUB 160
100 PRINT "WELL, ";N$
110 IF L$=K$ GO TO 130
120 PRINT " (ALIAS ";K$;")"
130 PRINT "IT HAS BEEN NICE CHATTING WITH YOU DO COME AGAIN."
140 PRINT "GOOD BYE."
150 GO TO 460
160 LET R1=INT(12*RND(X)+1)
170 LET R2=INT(12*RND(X)+1)
180 IF R1=R2 GO TO 170
190 PRINT "YOU WERE BORN UNDER THE ";H$(INT(4*RND(X)+1));" OF ";G$(R1)
200 PRINT "AND ";G$(R2);".  YOU ARE A BASICALLY ";H$(INT(4*RND(X)+1)+4)
210 PRINT "PERSON BUT ";H$(INT(3*RND(X)+1)+8);" YOU ";
220 PRINT H$(INT(3*RND(X)+1)+11)
230 PRINT H$(INT(3*RND(X)+1)+14);" WITH ";H$(INT(4*RND(X)+1)+17);
240 PRINT H$(INT(2*RND(X)+1)+21);H$(INT(5*RND(X)+1)+23)
250 PRINT "FOR THE NEXT WEEK.  I PREDICT YOU WILL SOON"
260 PRINT H$(INT(4*RND(X)+1)+28)
270 PRINT " "
280 RETURN
290 DATA "THE MOON","THE SUN","THE EARTH","THE PLANET MERCURY"
300 DATA "VENUS","MARS","JUPITER","SATURN","THE PLANET URANUS"
310 DATA "THE PLANET NEPTUNE","THE PLANET PLUTO","PEANUT BUTTER"
320 DATA "JUXTAROTATION","CONTRAPOSITION","CONTRASTING PHASES"
330 DATA "TRANSPOSITION","SATISFIED","HAPPY","INTERESTING","TOLERANT"
340 DATA "OFTEN","OCCASIONALLY","SOMETIMES"
350 DATA "TEND TO BE","ARE","ARE INCLINED TO BE"
360 DATA "SHORT OF PATIENCE","UNEASY","AT ODDS"
370 DATA "OTHERS.","CLOSE FRIENDS.","YOUNGER PEOPLE."
380 DATA "THOSE IN AUTHORITY."
390 DATA "  BEWARE OF ","  AVOID "
400 DATA "APPLE PIE","BEING ALONE","DARK PLACES","STRANGERS"
410 DATA "UNUSUAL SITUATIONS"
420 DATA "BE TAKING A TRIP YOU HAVE NOT MADE BEFORE."
430 DATA "BE MEETING SOMEONE YOU WILL KNOW FOR THE REST OF YOUR LIFE."
440 DATA "MAKE SEVERAL IMPORTANT DECISIONS INVOLVING OTHERS."
450 DATA "BECOME ILL IF YOU DO NOT LESSEN YOUR UNUSUAL ACTIVITIES."
460 END
