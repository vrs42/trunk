10 DIM Z$(12,9),L(12),N(60),Y$(7)
20 DIM G$(12,18),H$(32,56),N$(72),K$(72),M$(9),L$(72)
30 FOR X=1 TO 12
40 READ Z$(X)
50 NEXT X
60 FOR X=1 TO 12
70 READ L(X)
80 NEXT X
90 FOR X=1 TO 7
100 READ Y$(X)
110 NEXT X
120 LET Z1=VAL(SEG$(DAT$(X),7,8))+1900
130 LET Y1=VAL(SEG$(DAT$(X),4,5))
140 LET X1=VAL(SEG$(DAT$(X),1,2))
150 LET U=Y1-1
160 FOR I1=1 TO X1-1
170 LET U=U+L(I1)
180 NEXT I1
190 LET I1=INT(Z1/100)
200 IF Z1<>4*INT(Z1/4) GO TO 250
210 IF Z1/100=I1 GO TO 250
220 IF U>59 GO TO 250
230 IF X1=3 GO TO 250
240 LET U=U-1
250 LET U=U+36524*I1+INT(365.25*(Z1-100*I1))
260 PRINT " "
270 PRINT " "
280 PRINT "TODAY IS: ";Z$(X1);" ";Y1;", ";Z1
290 PRINT " ";Y$(U-7*INT(U/7)+1);"DAY    (I HOPE)"
300 PRINT " "
310 PRINT " "
320 PRINT "HI, I'M THE DIGITAL PDP-8 COMPUTER."
330 PRINT "TELL ME YOUR NAME";
340 INPUT N$
350 LET C=POS(N$," ",1)
360 LET K$=SEG$(N$,1,C)
370 LET L$=K$
380 PRINT "ARE YOU USUALLY CALLED ";K$;
390 GOSUB 1120
400 IF A$="YES" GO TO 430
410 PRINT "WHAT DO YOU LIKE TO BE CALLED";
420 INPUT K$
430 PRINT "SO YOUR FULL NAME IS ";N$;", BUT YOU"
440 PRINT "LIKE TO BE CALLED ";K$;"."
450 PRINT "HOW OLD ARE YOU, ";K$;
460 INPUT A
470 LET A=INT(A)
480 IF INT((A-5)/95)=0 GO TO 510
490 PRINT "COME ON, ";K$;", YOU'RE PULLING MY LEG."
500 GO TO 450
510 PRINT "SO YOU ARE ";A;" YEARS OLD."
520 PRINT "DO YOU KNOW, OFF HAND, HOW MANY DAYS OLD YOU ARE";
530 GOSUB 1120
540 IF A$="NO" GO TO 580
550 PRINT "OK, SMARTY HOW MANY?"
560 PRINT "SORRY, ";K$;", YOU'LL HAVE TO BE FASTER THAN THAT!"
570 GO TO 1220
580 PRINT "OK, I'LL TELL YOU."
590 PRINT "IN WHAT MONTH WERE YOU BORN";
600 INPUT M$
610 FOR X=1 TO 12
620 IF M$=Z$(X) GO TO 660
630 NEXT X
640 PRINT K$;", YOU MAY BE NICE BUT YOU CAN'T SPELL."
650 GO TO 590
660 PRINT "ON WHAT DAY";
670 INPUT Y
680 LET Z=Z1-A
690 IF INT((Y-1)/L(X))=0 GO TO 730
700 IF (X-1)*(Y-28)*(Z-4*INT(Z/4)+1)=1 GO TO 730
710 PRINT "COME ON, ";N$;", YOU'RE GIVING ME A HARD TIME."
720 GO TO 660
730 LET W=Y1-1
740 FOR I1=1 TO X1-1
750 LET W=W+L(I1)
760 NEXT I1
770 LET I1=INT(Z/100)
780 IF Z<>4*INT(Z/4) GO TO 820
790 IF Z/100=I1 GO TO 820
800 IF W>59 GO TO 820
810 LET W=W-1
820 LET W=W+36524*I1+INT(365.25*(Z-100*I1))
830 LET V=Y-1
840 FOR I1=1 TO X-1
850 LET V=V+L(I1)
860 NEXT I1
870 LET I1=INT(Z/100)
880 IF Z<>4*INT(Z/4) GO TO 920
890 IF Z/100=I1 GO TO 920
900 IF V>59 GO TO 920
910 LET V=V-1
920 LET V=V+36524*I1+INT(365.25*(Z-100*I1))
930 IF W=>V GO TO 950
940 LET Z=Z-1
950 IF ABS(W-V)>30 GO TO 1040
960 IF (W-V)<0 GO TO 990
970 IF (W-V)>0 GO TO 1010
980 GO TO 1030
990 PRINT "YOU HAVE A BIRTHDAY COMING UP IN ONLY ";V-W;;" DAYS!"
1000 GO TO 1040
1010 PRINT "YOUR BIRTHDAY WAS ONLY ";W-V;" DAYS AGO.  CONGRATULATIONS!"
1020 GO TO 1040
1030 PRINT "HAPPY BIRTHDAY, DEAR ";K$;", HAPPY BIRTHDAY TO YOU."
1040 PRINT "YOU WERE BORN ON ";Y$(V-7*INT(V/7)+1);"DAY, ";Z$(X);Y;
1050 PRINT ", ";Z
1060 PRINT "WHICH MAKES YOU ";U-V;" DAYS OLD."
1070 PRINT "YOU WERE BORN ON THE DAY ";V;" AD, AND ON JAN. 1, 2000"
1080 PRINT "YOU WILL BE ";730480-V;" DAYS OLD."
1090 PRINT "HOW ABOUT THAT!!!"
1100 PRINT " "
1110 CHAIN "SYS:BIRTHA.SV"
1120 INPUT A$
1130 IF A$="NO" GO TO 1170
1140 IF A$="YES" GO TO 1170
1150 PRINT "A SIMPLE YES OR NO WILL DO!"
1160 GO TO 1120
1170 RETURN
1180 DATA "JANUARY","FEBRUARY","MARCH","APRIL","MAY","JUNE","JULY"
1190 DATA "AUGUST","SEPTEMBER","OCTOBER","NOVEMBER","DECEMBER"
1200 DATA 31,28,31,30,31,30,31,31,30,31,30,31
1210 DATA "THURS","FRI","SATUR","SUN","MON","TUES","WEDNES"
1220 END
