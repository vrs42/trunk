13 PRINT "SEC","MI + FT","MPH","LB FUEL","BURN RATE"\PRINT
15 A=120\V=1\M=33000\N=1650\G=1.000000E-03\Z=1.8
21 PRINT L,INT(A);INT(5280*(A-INT(A))),3600*V,M-N,\INPUT K\T=10\PRINT
31 IF M-N<.001 THEN 41\IF T<.001 THEN 21\S=T\IF M<N+S*K THEN 95
35 GOSUB 91 \IF I<=0 THEN 71\IF V<=0 THEN 38\IF J<0 THEN 81
38 GOSUB 61\GO TO 31
41 PRINT "FUEL OUT AT";L;"SEC"\S=(-V+SQR(V*V+2*A*G))/G\V=V+G*S\L=L+S
51 W=3600*V\PRINT "ON MOON AT";L;"SEC - IMPACT VELOCITY";W;"MPH"
53 IF W>10 THEN 56\PRINT "GOOD LANDING"\STOP
56 IF W>60 THEN 58\PRINT "BAD JOLT"\STOP
58 PRINT "NO SURVIORS-BLASTED NEW LUNAR CRATER";W*.2777;"FT DEEP"\STOP
61 L=L+S\T=T-S\M=M-S*K\A=I\V=J\RETURN
71 IF S<5.000000E-03 THEN 51\D=V+SQR(V*V+2*A*(G-Z*K/M))\S=2*A/D
73 GOSUB 91\GOSUB 61 \GO TO 71
81 W=(1-M*G/(Z*K))/2\S=M*V/(Z*K*(W+SQR(W*W+V/Z)))+.05\GOSUB 91
83 IF I<=0 THEN 71 \GOSUB 61 \IF J>0 THEN 31 \IF V>0 THEN 81 \GO TO 31
91 Q=S*K/M\J=V+G*S+Z*(-Q-Q*Q/2-Q^3/3-Q^4/4-Q^5/5)
94 I=A-G*S*S/2-V*S+Z*S*(Q/2+Q^2/6+Q^3/12+Q^4/20+Q^5/30)\RETURN
95 GO TO 13
99 END
