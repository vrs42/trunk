10 REM MONOPOLY GAME BY DAVID BARKER, S.E. STATE COLLEGE, DURANT, OK
20 REM SLIGHT PROGRAM MODIFICATIONS BY DAVID AHL, DIGITAL
30 REMARKABLY TRANSLATED TO OS8 BASIC BY KAY R. FISHER ...DEC
40 M(1)=1500\M(2)=1500\I(1)=0\I(2)=0\DIM A$(26,21),B$(26,21),H(40)
50DIMO$(19),G$(40,21),L(40),P(40),R(40),C$(10,39),Z$(10,38),M$(20,60)
60 P$="HOW MANY HOUSES AT $"\O$=" EACH DO YOU WANT ON"
70 DEF FNR(H,I,Z,R)=(H(I(Z))*R(I(Z))*10)
80 FOR I=1 TO 40\L(I)=0\H(I)=0\NEXT I
90 FOR I=1 TO 8\U(I)=0\NEXT I
100 FILE #1:"RKB0:MONPLY.B1"
110 FOR I=1 TO 40\INPUT #1:G$(I)\NEXT I
120 FOR I=1 TO 20\INPUT #1:M$(I)\NEXT I
130 FOR I=1 TO 10\INPUT #1:C$(I)\NEXT I
140 FOR I=1 TO 10\INPUT #1:Z$(I)\NEXT I
150 PRINT M$(1)\PRINT\PRINT\PRINT"**RULES**"\PRINT M$(2)
160 PRINT M$(3)\PRINT M$(4)\PRINT M$(5)\CLOSE #1
170 FOR I=1 TO 40\READ P(I),R(I)\NEXT I
180 DATA 60,2,0,0,60,4,0,0,200,25,100,6,0,0,100,6,120,8,0,0
190 DATA 140,10,150,35,140,10,160,12,200,25,180,14,0,0
200 DATA 180,14,200,16,0,0,220,18,0,0,220,18,240,20,200,25
210 DATA 260,22,260,22,150,35,280,24,0,0,300,26,300,26,0,0
220 DATA 320,28,200,25,0,0,350,35,0,0,400,50,0,0
230 RESTORE
240 DIM V$(21)
250 DIM P$(20)
260 DIM N$(2,8)
270 PRINT"WHO IS PLAYER #1";\INPUT N$(1)
280 PRINT"WHO IS PLAYER #2";\INPUT  N$(2)
290 PRINT\PRINT "**";N$(1);"'S TURN**********"\F=0
300 Z=1\GOSUB 410
310 GOSUB 470
320 IF D<>D1 GOTO 330\F=F+1\IF F=>3 GOTO 330\PRINTM$(9)\GOTO 300
330 IF F<>3 GOTO 340\PRINT M$(10)\I(Z)=10\M(Z)=M(Z)-50
340 PRINT\PRINT"**";N$(2);"'S TURN**********"\F=0
350 Z=2\GOSUB 410
360 GOSUB 470
370 IF D<>D1 GOTO 380\F=F+1\IF F>=3 GOTO 380\PRINTM$(9)\GOTO350
380 IF F<>3GOTO390\PRINT M$(10)\I(Z)=10\M(Z)=M(Z)-50
390 PRINT M$(11);\INPUT F$\IF F$="QUIT" THEN 1780\GOTO 290
400 REM DICE ROLL
410 PRINT M$(6);\INPUT F$\RANDOMIZE\X=RND(0)\Y=RND(0)
420 D=INT(X*6+1)\D1=INT(Y*6+1)
430 PRINT "YOU ROLLED A";D;"AND A";D1\I(Z)=I(Z)+(D+D1)
440 IF I(Z)=<40GOTO450\I(Z)=I(Z)-40\M(Z)=M(Z)+200
450 RETURN
460 REM PLACEMENT
470 PRINT"YOU ARE ON ";G$(I(Z))
480 REM COM CHEST
490 IF I(Z)=2 THEN 1500\IFI(Z)=17THEN1500\IFI(Z)=33THEN1500
500 REM INC TAX
510 IFI(Z)<>4THEN530\M(Z)=M(Z)-200\RETURN
520 REM CHANCE
530 IFI(Z)=7THEN1620\IFI(Z)=22THEN1620\IFI(Z)=36THEN1620
540 REM VISIT IN JAIL OR FREE PARKING
550 IFI(Z)=10THEN600\IFI(Z)=20THEN600
560 REM JAIL
570 IFI(Z)<>30THEN580\M(Z)=M(Z)-50\I(Z)=10\RETURN
580 IFI(Z)<>38THEN590\M(Z)=M(Z)-75\RETURN\REM LUX TAX
590 IFI(Z)<>40THEN610\M(Z)=M(Z)+200\I(Z)=0\RETURN\REM GO
600 RETURN
610 IFL(I(Z))<>Z THEN 620\PRINT M$(12)\GOTO 760
620 IFH(I(Z))<>0GOTO630\IFL(I(Z))=<0GOTO630\IFL(I(Z))<>ZTHEN720
630 IFH(I(Z))=<0GOTO640\IFL(I(Z))=<0GOTO640\IFL(I(Z))<>ZTHEN680
640 PRINT M$(7);P(I(Z));"DOLLARS"
650 PRINT M$(8);\INPUT F$\ IF F$<>"BUY" THEN 760
655 IF M(Z)=>P(I(Z)) THEN 660\PRINT "NOT ENOUGH MONEY!"\GOTO 760
660 M(Z)=M(Z)-P(I(Z))\PRINT "YOU NOW HAVE";M(Z);"DOLLARS"
670 L(I(Z))=Z\GOTO 760
680 IF Z<>1 THEN 690\M(Z)=M(Z)-FNR(H,I,Z,R)\M(2)=M(2)+FNR(H,I,Z,R)
690 PRINT "YOU OWE";FNR(H,I,Z,R);"DOLLARS RENT"\RETURN
700 IF Z<>2 THEN 710\M(Z)=M(Z)-FNR(H,I,Z,R)\M(1)=M(1)+FNR(H,I,Z,R)
710 PRINT "YOU OWE";FNR(H,I,Z,R);"DOLLARS RENT"\RETURN
720 IFZ<>1 THEN 730\M(Z)=M(Z)-R(I(Z))\M(2)=M(2)+R(I(Z))
730 PRINT "YOU OWE";R(I(Z));"DOLLARS RENT"\RETURN
740 IF Z<>2 THEN 750\M(Z)=M(Z)-R(I(Z))\M(1)=M(1)+R(I(Z))
750 PRINT "YOU OWE";R(I(Z));"DOLLARS RENT"\RETURN
760 PRINT M$(13)\PRINTM$(14);\INPUTF$\IFF$="SELL"THEN780
770 GOTO 790
780 GOSUB 800
790 PRINTM$(19);\INPUTH$\IFH$="HOUSE"THEN1080\RETURN
800 PRINTM$(15);\INPUTF$\IFF$<>"LIST"THEN810\GOSUB900
810 PRINTM$(17);\INPUTV$\PRINT"HOW MUCH DO YOU WANT FOR IT";\INPUTV
820 FOR I=1 TO 39
830 IF V$<>G$(I)THEN840\IFL(I)<>0THEN840\PRINTM$(16)\RETURN
840 IFV$<>G$(I)THEN860\IFL(I)<>1THEN860\M(1)=M(1)+V
850 M(2)=M(2)-V\L(I)=2\GOTO 890
860 IF V$<>G$(I)THEN880\IFL(I)<>2THEN880\M(2)=M(2)+V
870 M(1)=M(1)-V\L(I)=1\GOTO 890
880 NEXT I
890 PRINT M$(18);\INPUT F$\IFF$="YES"THEN 810\RETURN
900 C=0\D=0
910 FOR I=1 TO 39
920 IFL(I)<>1THEN 930\C=C+1\A$(C)=G$(I)
930 IFL(I)<>2 THEN 940\D=D+1\B$(D)=G$(I)
940 NEXT I
950 PRINT "OUTPUT TO TTY (1) OR LPT (0)";
960 INPUT S1$
970 IF S1$="0" GOTO 1010
980 IF S1$<>"1" GOTO 950
990 FILEV #1:"TTY:"
1000 GOTO 1020
1010 FILEV #1:"LPT:"
1020 PRINT #1:N$(1);"'S PROPERTY"
1030 FOR I=1 TO C\PRINT #1:A$(I)\NEXT I
1040 PRINT #1:N$(2);"'S PROPERTY"
1050 FOR I=1 TO D\PRINT #1:B$(I)\NEXT I
1060 CLOSE #1
1070 RETURN
1080 IFL(1)<>ZTHEN1100\IFL(3)<>ZTHEN1100\PRINTP$;"50";O$
1090 PRINT G$(1);" ";G$(3);\INPUT U\GOSUB 1250
1100 IFL(6)<>ZGOTO1120\IFL(8)<>ZGOTO1120\IFL(9)<>ZGOTO1120
1110 PRINTP$;"50";O$\PRINTG$(6);" ";G$(8);" ";G$(9);\INPUTU\GOSUB1280
1120 IFL(11)<>ZGOTO1140\IFL(13)<>ZGOTO1140\IFL(14)<>ZGOTO1140
1130PRINTP$;"100";O$\PRINTG$(11);" ";G$(13);" ";G$(14);\INPUTU\GOSUB1310
1140 IFL(16)<>ZGOTO1160\IFL(18)<>ZGOTO1160\IFL(19)<>ZGOTO1160
1150PRINTP$;"100";O$\PRINTG$(16);" ";G$(18);" ";G$(19);\INPUTU\GOSUB1340
1160IFL(21)<>ZGOTO1180\IFL(23)<>ZGOTO1180\IFL(24)<>ZGOTO1180
1170PRINTP$;"150";O$\PRINTG$(21);" ";G$(23);" ";G$(24);\INPUTU\GOSUB1370
1180IFL(26)<>ZGOTO1200\IFL(27)<>ZGOTO1200\IFL(29)<>ZGOTO1200
1190PRINTP$;"150";O$\PRINTG$(26);" ";G$(27);" ";G$(29);\INPUTU\GOSUB1400
1200IFL(31)<>ZGOTO1220\IFL(32)<>ZGOTO1220\IFL(34)<>ZGOTO1220
1210PRINTP$;"200";O$\PRINTG$(31);" ";G$(32);" ";G$(34);\INPUTU\GOSUB1430
1220IFL(37)<>ZGOTO1240\IFL(39)<>ZGOTO1240\PRINTP$;"200";O$
1230PRINTG$(37);" ";G$(39);\INPUTU\GOSUB1460
1240 RETURN
1250U(1)=U(1)+U\M(Z)=M(Z)-(U*100)\IFM(Z)=>0THEN1270\PRINTM$(20)
1260 M(Z)=M(Z)+(U*100)\U(1)=U(1)-U\RETURN
1270 H(1)=U(1)\H(3)=U(1)\RETURN
1280U(2)=U(2)+U\M(Z)=M(Z)-(U*150)\IFM(Z)=>0THEN1300\PRINTM$(20)
1290 M(Z)=M(Z)+(U*150)\U(2)=U(2)-U\RETURN
1300 H(6)=U(2)\H(8)=U(2)\H(9)=U(2)\RETURN
1310U(3)=U(3)+U\M(Z)=M(Z)-(U*150)\IFM(Z)=>0THEN1330\PRINTM$(20)
1320 M(Z)=M(Z)+(U*150)\U(3)=U(3)-U\RETURN
1330 H(11)=U(3)\H(13)=U(3)\H(14)=U(3)\RETURN
1340U(4)=U(4)+U\M(Z)=M(Z)-(U*300)\IFM(Z)=>0THEN1360\PRINTM$(20)
1350 M(Z)=M(Z)+(U*300)\U(4)=U(4)-U\RETURN
1360 H(16)=U(4)\H(18)=U(4)\H(19)=U(4)\RETURN
1370U(5)=U(5)+U\M(Z)=M(Z)-(U*450)\IFM(Z)=>0THEN1390\PRINTM$(20)
1380 M(Z)=M(Z)+(U*450)\U(5)=U(5)-U\RETURN
1390 H(21)=U(5)\H(23)=U(5)\H(24)=U(5)\RETURN
1400U(6)=U(6)+U\M(Z)=M(Z)-(U*450)\IFM(Z)=>0THEN1420\PRINTM$(20)
1410M(Z)=M(Z)+(U*450)\U(6)=U(6)-U\RETURN
1420 H(26)=U(6)\H(27)=U(6)\H(29)=U(6)\RETURN
1430U(7)=U(7)+U\M(Z)=M(Z)-(U*600)\IFM(Z)=>0THEN1450\PRINTM$(20)
1440 M(Z)=M(Z)+(U*600)\U(7)=U(7)-U\RETURN
1450 H(31)=U(7)\H(32)=U(7)\H(34)=U(7)\RETURN
1460U(8)=U(8)+U\M(Z)=M(Z)-(U*400)\IFM(Z)=>0THEN1480\PRINTM$(20)
1470 M(Z)=M(Z)+(U*400)\U(8)=U(8)-U\RETURN
1480 H(37)=U(8)\H(39)=U(8)\RETURN
1490 REM COMMUNITY CHEST
1500 RANDOMIZE\L=RND(0)
1510 IF L>.1 THEN 1520\PRINTZ$(1)\M(Z)=M(Z)+100\RETURN
1520 IF L>.2 THEN 1530\PRINTZ$(2)\M(Z)=M(Z)+100\RETURN
1530 IF L>.3 THEN 1540\PRINTZ$(3)\M(Z)=M(Z)+20\RETURN
1540 IF L>.4 THEN 1550\PRINTZ$(4)\M(Z)=M(Z)-50\RETURN
1550 IF L>.5 THEN 1560\PRINTZ$(5)\M(Z)=M(Z)+100\RETURN
1560 IF L>.6 THEN 1570\PRINTZ$(6)\M(Z)=M(Z)+200\I(Z)=0\RETURN
1570 IF L>.7 THEN 1580\PRINTZ$(7)\M(Z)=M(Z)-100\RETURN
1580 IF L>.8 THEN 1590\PRINTZ$(8)\M(Z)=M(Z)-50\I(Z)=10\RETURN
1590 IF L>.9 THEN 1600\PRINTZ$(9)\M(Z)=M(Z)-50\RETURN
1600 PRINT Z$(10)\M(Z)=M(Z)+200\RETURN
1610 REM CHANCE
1620 RANDOMIZE\L=RND(0)
1630 IF L>.1 THEN 1640\PRINTC$(1)\M(Z)=M(Z)-15\RETURN
1640 IF L>.2 THEN 1660\PRINTC$(2)\I(Z)=24\GOSUB 470
1650 RETURN
1660 IF L>.3 THEN 1680\PRINTC$(3)\I(Z)=I(Z)-3\GOSUB 470
1670 RETURN
1680 IF L>.4 THEN 1690\PRINTC$(4)\I(Z)=0\M(Z)=M(Z)+200\RETURN
1690 IF L>.5 THEN 1700\PRINTC$(5)\M(Z)=M(Z)+50\RETURN
1700 IF L>.6 THEN 1720\PRINTC$(6)\I(Z)=5\M(Z)=M(Z)+200\GOSUB470
1710 RETURN
1720 IF L>.7 THEN 1730\PRINTC$(7)\I(Z)=10\M(Z)=M(Z)-50\RETURN
1730 IF L>.8 THEN 1740\PRINTC$(8)\M(Z)=M(Z)+150\RETURN
1740 IF L>.9 THEN 1760\PRINTC$(9)\I(Z)=39\GOSUB 470
1750 RETURN
1760 PRINTC$(10)\I(Z)=11\GOSUB 470
1770 RETURN
1780 C=0\D=0
1790 FOR I=1 TO 39
1800 IF L(I)<>1 THEN 1810\C=C+1\A$(C)=G$(I)
1810 IF L(I)<>2 THEN 1820\D=D+1\B$(D)=G$(I)
1820 NEXT I\PRINT \PRINT
1830 PRINT "OUTPUT TO TTY (1) OR LPT (0)";
1840 INPUT S1$
1850 IF S1$="0" GOTO 1890
1860 IF S1$<>"1" GOTO 1830
1870 FILEV #1:"TTY:"
1880 GOTO 1900
1890 FILEV #1:"LPT:"
1900 PRINT #1:N$(1);" OWNED THE FOLLOWING PROPERTY"
1910 FOR I=1 TO C\PRINT #1:A$(I)\NEXT I
1920 PRINT #1:"AND HAD";M(1);"DOLLARS AT THE END OF THE GAME"
1930 PRINT #1:N$(2);" OWNED THE FOLLOWING PROPERTY"
1940 FOR I=1 TO D\PRINT #1:B$(I)\NEXT I
1950 PRINT #1:"AND HAD";M(2);"DOLLARS AT THE END OF THE GAME"
1960 CLOSE #1
1970 END
