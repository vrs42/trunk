320 !------------------------------------------------------------
330 !      PROGRAM RESEQ.BA (VERSION V7)
340 !      REWRITTEN BY J. REID   FEBRUARY 6,1979
350 !      RESEQUENCES LINE #'S IN A BASIC PROGRAM.
360 !      A FILENAME,NEW STARTING # AND STEP SIZE ARE INPUT.
370 !-----------------------------------------------------------
380 ! ------ PART1 ------     THIS PART INSPECTS EACH LINE#
390 !                         AND SAVES IT IN ARRAY N
400 DIM L$(80),N$(16)
410 DIM L2$(80),T$(1),R5$(6)
420 DIM N(600),L3$(80),L4$(80)
430 T$=CHR$(34)
440 Z9=0
450 PRINT "FILE";
460 INPUT N$
470 IF POS(N$,".BA",1)<>0 THEN 490     !SEE IF .BA IN FILENAME
480 N$=N$&".BA"                        !ADD .BA IF NOT THERE
490 PRINT "START,STEP";
500 INPUT S1,S
510 LET S1=INT(ABS(S1))
520 LET S=INT(ABS(S))
530 LET T=0
540 LET N2=0
550 FILE #1:N$
560 LET I=1
570 INPUT #1:L$                        !GET A LINE
580 IFEND #1 THEN 780                  !END- GO TO PART2
590 LET L=LEN(L$)
600 GOSUB 2000                          !GET OLD LINE # =N1.
610 IF N1>0 THEN 660
620 PRINT "NO LINE NUMBER"
630 Z9=1
640 PRINT L$
650 GO TO 560
660 IF N1>N2 THEN 710
670 PRINT "OUT OF SEQUENCE"
680 Z9=1
690 PRINT L$
700 GO TO 560
710 LET N2=N1                          !N2=PRESENT LINE #.
720 LET T=T+1
730 LET N(T)=N1                        !SAVE OLD LINE #'S IN ARRAY N
740 IF T<500 THEN 560
750 PRINT "TOO MANY LINES"
760 STOP
770 ! ------ PART2 ------     THIS PART RESEQUENCES
780 IF Z9=1 THEN 760                   !EXIT IF LINE#'S INCORRECT
790 RESTORE #1                         !REOPEN INPUT FILE
800 FILEV #2:N$                        !OPEN INPUT FILE FOR OUTPUT
810 LET N2=S1                          !N2=NEW LINE #
820 INPUT #1: L$                       !GET A LINE
830 IFEND #1 THEN 1260
840 LET I=1                            !POINTER I AT BEG. OF LINE (SUB6)
850 LET L=LEN(L$)
860 GOSUB 2000                          !GET OLD LINE # AGAIN (N(T))?  
870 LET L2$=STR$(N2)                   !SO I IS AFTER LINE #
880 PRINT #2: L2$;                     !OUTPUT NEW LINE #
890 LET N2=N2+S
900 LET L$=SEG$(CAP$(L$),I,80)         !L$=LINE WO/LINE#
910 LET F=0
920 LET D=POS(CAP$(L$),"\",1) \ LET P=D!SEE IF BACKSLASH IN LINE
930 IF D=0 THEN 960
940 LET L2$=SEG$(CAP$(L$),P+1,80)      !IF BACKSLASH, SPLIT LINE
950 LET L$=SEG$(CAP$(L$),1,P-1)        !L$=FIRST STATEM.,L2$=THE REST
960 R5$="ON"\GOSUB 2100\I=R+2           !LOOK FOR "ON","GOTO", --ETC.
970 IF I>2 THEN 1110
980 R5$="GOTO"\GOSUB 2100\I=R+4
990 IF I>4 THEN 1090
1000 R5$="GO TO"\GOSUB 2100\I=R+5
1010 IF I>5 THEN 1090
1020 R5$="THEN"\GOSUB 2100\I=R+4
1030 IF I>4 THEN 1090
1040 R5$="GOSUB"\GOSUB 2100\I=R+5
1050 IF I>5 THEN 1090
1060 R5$="GO SUB"\GOSUB 2100\I=R+6
1070 IF I>6 THEN 1090
1080 GOTO 1120
1090 GOSUB 1290
1100 GOTO 1120
1110 GOSUB 1400
1120 IF F=0 THEN 1140
1130 PRINT #2:"\";
1140 PRINT #2:L$;
1150 LET F=F+1
1160 IF D>0 THEN 1190
1170 PRINT #2:
1180 GO TO 820
1190 LET D=POS(CAP$(L2$),"\",1) \ LET P=D !MORE BACKSLASHES IN L2$?
1200 IF D>0 THEN 1230
1210 LET L$=L2$
1220 GO TO 960
1230 LET L$=SEG$(CAP$(L2$),1,P-1)       !L$=NEXT STATEMENT IN LINE
1240 LET L2$=SEG$(CAP$(L2$),P+1,80)     !L2$=REST OF LINE
1250 GO TO 960                          !LOOK FOR BRANCHES,ETC...
1260 CLOSE #2                           !DONE!
1270 STOP
1280 ! ------ SUB1 ------     HERE IF BRANCH FOUND
1290 O1=0
1300 GOSUB 1630                          !FIND 1ST NUMERAL (SUB3)
1310 IF C<0 THEN 1360                    !IF NO NUMBER FOUND
1320 GOSUB 1780                          !GET NEW LINE# (SUB4)
1330 IF N1=0 THEN 1360                   !IF NO NUMBER
1340 L$=SEG$(CAP$(L$),1,P-1)&Q$&SEG$(CAP$(L$),I,80)
1350 RETURN                             !FORM NEW STATEMENT
1360 PRINT "BAD REFERENCE (SUB1)"
1370 PRINT L$
1380 RETURN
1390 ! ------ SUB2 ------     HERE IF "ON" FOUND
1400 O1=1
1410 L3$=L$                             !SAVE L$
1420 K=0
1430 K=K+1
1440 GOSUB 1630                          !GET LINE#
1450 IF C>= 0 THEN 1480
1460 IF K=1 THEN 1600
1470 GOTO 1580
1480 GOSUB 1780                          !GET NEW LINE#
1490 IF N1>0 THEN 1520
1500 IF K=1 THEN 1600
1510 GOTO 1580
1520 IF K=1 THEN 1560
1530 L3$=L3$&","&Q$                     !FORM NEW LINE
1540 L4$=SEG$(CAP$(L$),I,80) 
1550 GOTO 1430
1560 L3$=SEG$(CAP$(L$),1,P-1)&Q$
1570 GOTO 1430
1580 L$=L3$&L4$
1590 RETURN
1600 PRINT "BAD REFERENCE (SUB2)"
1610 PRINT L$
1620 RETURN
1630 ! ------ SUB3 ------    HERE TO GET POINTER AT NUMERAL
1640 LET L=LEN(L$)
1650 GOSUB 1930                           !GET ASCII CHAR. AT I
1660 IF O1=0 THEN 1710                    !IF "ON" SKIP OVER NON-NUMERALS
1670 IF C<0 THEN 1770
1680 IF C<48 THEN 1650
1690 IF C>57 THEN 1650
1700 GOTO 1730
1710 IF C=32 THEN 1650
1720 IF C<0 THEN 1770                     !IF NO NUMBER FOUND
1730 LET I=I-1 				!I=POINTER AT 1ST NUMERAL
1740 IF O1=0 THEN 1760
1750 IF K<>1 THEN 1770
1760 LET P=I 				!SAVE THIS POSITION
1770 RETURN
1780 !     ------ SUB4 ------     HERE TO GET NEW LINE#
1790 GOSUB 2000			        !GET OLD LINE# FIRST
1800 IF N1=0 THEN 1860 			!IF NO LINE NUMBER FOUND
1810 FOR J=1 TO T 			!THIS LOOP FINDS OLD LINE# IN N(T)
1820 IF N1<>N(J) THEN 1850
1830 LET Q$=STR$(J*S-S+S1) 		!NEW LINE# COMPUTED 
1840 RETURN
1850 NEXT J
1860 RETURN
1870 !		SUB5 AND SUB6  GET AN OLD LINE#
1880 !		INPUTS: I=CHARACTER POINTER
1890 !		        L$=STATEMENT TO BE SCANNED
1900 !		OUTPUT: C=ASCII CODE FOR CHAR. AT I
1910 !		        N1=OLD LINE#
1920 !		        I=POINTER AT CHAR. AFTER N1
1930 !     ------ SUB5 ------
1940 IF I<=L THEN 1970 		       !POINTER WITHIN STATEMENT?
1950 LET C=-1 			       !SCANNING BEYOND END
1960 RETURN
1970 LET C=ASC(SEG$(CAP$(L$),I,I))      !GET ASCII CODE FOR CHAR. AT I
1980 LET I=I+1 			       !INCREMENT POINTER
1990 RETURN
2000 !     ------ SUB6 ------
2010 LET N1=0 			       !INITIALIZE LINE#
2020 GOSUB 1930
2030 IF C<48 THEN 2070 		       !SEE IF CHAR. A NUMERAL
2040 IF C>57 THEN 2070 		       !
2050 LET N1=N1*10+C-48 		       !FORM LINE NUMBER HERE
2060 GO TO 2020 		               !GET NEXT NUMERAL
2070 IF C<0 THEN 2090 		       !RETURN IF NO LINE#
2080 LET I=I-1 			       !POSITION POINTER I AFTER N1 (LINE#)
2090 RETURN
2100 !     ------ SUB7 ------     HERE TO FIND "GOTO","THEN" --- ETC.
2110 L5=LEN(L$)
2120 R=POS(CAP$(L$),R5$,1)            !SEE IF R5$ IN LINE AT ALL
2130 IF R=0 THEN 2530                  !IF NOT THEN RETURN
2140 B=1
2150 C1=POS(CAP$(L$),"!",B)          !FIND !
2160 R1=POS(CAP$(L$),"REM",B)         !FIND REMARK
2170 IF R1=0 THEN  2260
2180 IF C1<R1 THEN 2260
2190 GOSUB 2540                        !GET QUOTES (G1,G2)
2200 IF G1=0 THEN 2520                 !IF NO QUOTES
2210 IF G2=0 THEN 2500
2220 IF R1<G1 THEN 2520                !QUOTE AFTER REM
2230 B=G2+1
2240 IF B>L5-1 THEN 2260
2250 GOTO 2160
2260 B=1
2270 IF C1=0 THEN 2360
2280 GOSUB 2540                        !GET G1 AND G2 (PAIR OF QUOTES)
2290 IF G1=0 THEN 2360                 !IF NO QUOTES
2300 IF G2=0 THEN 2500                 !IF NOT A PAIR
2310 IF C1<G1 THEN 2360                !IF QUOTES AFTER!
2320 B=G2+1                           !CHECK ANOTHER PAIR
2330 IF B>L5-1 THEN 2360
2340 C1=POS(CAP$(L$),"!",B)           !LOOK FOR! (COMMENT TYPE)
2350 GOTO 2270
2360 B=1
2370 R=POS(CAP$(L$),R5$,B)            !LOOK FOR R5$
2380 IF R=0 THEN 2530
2390 IF R1=0 THEN 2410
2400 IF R>=R1 THEN  2520
2410 IF C1=0 THEN 2430                 !IF NO!
2420 IF R>=C1 THEN 2520                !R5$ IN COMMENT AREA?
2430 GOSUB 2540                        !GET PAIR OF QUOTES (G1,G2)
2440 IF G1=0 THEN 2530
2450 IF G2=0 THEN 2500
2460 IF R<G1 THEN 2530
2470 B=G2+1
2480 IF B>L5-1 THEN 2520               !END OF L$?
2490 GOTO 2370
2500 PRINT "UNPAIRED QU0TES"
2510 PRINT L$
2520 R=0
2530 RETURN
2540 !     ------ SUB8 ------     HERE TO FIND QUOTES IN L$
2550 G1=POS(CAP$(L$),T$,B)            !G1=1ST QUOTE
2560 G2=POS(CAP$(L$),T$,G1+1)         !G2=2ND QUOTE
2570 RETURN
2580 END
