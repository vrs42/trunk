100  !	"HELLO"   AN INTERACTIVE Q & A SESSION
110  !
120  !
130  !	OS-78 V7A HACKS BY R. MOORE, DEC
140  !
150  !
160  PRINT PNT(27);"H";PNT(27);"J"
170  DIM A$(30),D$(15),E$(80)
180  PRINT "HELLO THERE ... MY NAME IS PETEY P. EIGHT   (YEAH, THAT'S PDP-8 !)"
190 PRINT 
200 RANDOMIZE
210 PRINT "WHAT'S YOUR NAME "; \ INPUT A$
220 PRINT \ PRINT
230 PRINT "HI THERE "; \ GOSUB 1280
240 PRINT ".  ARE YOU ENJOYING YOURSELF HERE"
250 PRINT"IN THIS WONDERFUL PLACE";
260 INPUT B$\PRINT
270 IF B$="YES" THEN 340
280 IF B$="NO" THEN 370
290 PRINT " ";\GOSUB 1280
300 PRINT ", I DON'T UNDERSTAND YOUR ANSWER OF '";B$;"'."
310 PRINT "PLEASE ANSWER 'YES' OR 'NO'. DO YOU LIKE IT HERE"
320 PRINT"IN THIS CRAZY PLACE !!!";
330 GOTO 260
340 PRINT "OH, I'M GLAD TO HEAR THAT ";\GOSUB 1280
350 PRINT
360 GOTO 400
370 PRINT "OH, SORRY TO HEAR THAT ";\GOSUB 1280
380 PRINT ", MAYBE WE CAN"
390 PRINT "BRIGHTEN UP YOUR STAY A BIT"
400 PRINT
410 PRINT "SAY, ";\GOSUB 1280
420 PRINT ", I CAN SOLVE ALL KINDS OF PROBLEMS"
430 PRINT "EXCEPT THOSE DEALING WITH GREECE. WHAT KIND OF"
440 PRINT "PROBLEMS DO YOU HAVE (ANSWER SEX, HEALTH, MONEY,"
450 PRINT "JOB,COMPUTERS, OR OLD JOKES)";
460 INPUT C$\PRINT
470 IF C$="SEX" THEN 740
480 IF C$="HEALTH" THEN 680
490 IF C$="MONEY" THEN 630
500 IF C$="JOB" THEN 560
510 IF C$="COMPUTERS" GOTO 1300
520 IF C$="OLD JOKES" GOTO 1510
530 PRINT "OH, ";\GOSUB 1280
540 PRINT ", YOUR ANSWER OF '";C$;"' IS GREEK TO ME."
550 GOTO 890
560 PRINT "I CAN SYMPATHIZE WITH YOU ";\GOSUB 1280
570 PRINT ". I HAVE TO WORK"
580 PRINT "VERY LONG HOURS FOR NO PAY -- AND SOME OF MY BOSSES REALLY"
590 PRINT "BEAT MY KEYBOARD. MY ADVICE TO YOU ";\GOSUB 1280
600 PRINT ", IS"
610 PRINT "TO TRY FIXING COMPUTERS FOR A LIVING ... IT'S GREAT FUN ..."
620 GOTO 890
630 PRINT "SORRY, ";\GOSUB 1280
640 PRINT ", I'M BROKE TOO. WHY DON'T YOU "
650 PRINT "SELL ENCYCLOPAEDIAS OR MARRY SOMEONE RICH OR STOP EATING"
660 PRINT "SO YOU WON'T NEED SO MUCH MONEY?"
670 GOTO 890
680 PRINT "MY ADVICE TO YOU ";\GOSUB 1280
690 PRINT ", IS:"
700 PRINT "     1. TAKE TWO ASPRIN"
710 PRINT "     2. DRINK PLENTY OF FLUIDS (ORANGE JUICE, NOT BEER!)"
720 PRINT "     3. GO TO BED (ALONE)"
730 GOTO 890
740 PRINT "IS YOUR PROBLEM TOO MUCH OR TOO LITTLE";
750 INPUT D$\PRINT
760 IF D$="TOO MUCH" THEN 820
770 IF D$="TOO LITTLE" THEN 850
780 PRINT "DON'T GET ALL SHOOK UP ";\GOSUB 1280
790 PRINT ", JUST ANSWER"
800 PRINT "THE QUESTION WITH 'TOO MUCH' OR 'TOO LITTLE'. WHICH IS IT";
810 GOTO 750
820 PRINT "YOU CALL THAT A PROBLEM?!! I SHOULD HAVE SUCH PROBLEMS!"
830 PRINT "IF IT BOTHERS YOU, TAKE A COLD SHOWER ";\GOSUB 1280
840 GOTO 890
850 PRINT "WHY ARE YOU HERE ";\GOSUB 1280
860 PRINT "? YOU SHOULD BE"
870 PRINT "IN TOKYO OR NEW YORK OR AMSTERDAM OR SOMEPLACE WITH SOME"
880 PRINT "REAL ACTION."
890 PRINT
900 PRINT "ANY MORE PROBLEMS YOU WANT SOLVED, ";\GOSUB 1280
910 INPUT E$\PRINT
920 IF E$="YES" THEN 970
930 IF E$="NO" THEN 990
940 PRINT "JUST A SIMPLE 'YES' OR 'NO' PLEASE, ";\GOSUB 1280
950 PRINT "."
960 GOTO 900
970 PRINT "WHAT KIND (SEX, MONEY, HEALTH, JOB, COMPUTERS, OLD JOKES) ";
980 GOTO 460
990 PRINT
1000 PRINT "THAT WILL BE $5.00 FOR THE ADVICE, ";\GOSUB 1280
1010 PRINT "."
1020 PRINT "PLEASE LEAVE THE MONEY ON THE TERMINAL. "
1030 PRINT\PRINT\PRINT
1040 PRINT "DID YOU LEAVE THE MONEY";
1050 INPUT G$\PRINT
1060 IF G$="YES" THEN 1120
1070 IF G$="NO" THEN 1180
1080 PRINT "YOUR ANSWER OF '";G$;"' CONFUSES ME, ";\GOSUB 1280
1090 PRINT ". PLEASE"
1100 PRINT "RESPOND WITH A 'YES' OR 'NO'."
1110 GOTO 1040
1120 PRINT "HEY, ";\GOSUB 1280
1130 PRINT "??? YOU LEFT NO MONEY AT ALL!"
1140 PRINT "YOU ARE CHEATING ME OUT OF MY HARD-EARNED LIVING."
1150 PRINT "RIP OFF, ";\GOSUB 1280
1160 PRINT ". *=*=*=*=*=*=*=*=*=*=*=*=*=*=*=*=*"
1170 GOTO 1230
1180 PRINT "THAT'S HONEST, ";\GOSUB 1280
1190 PRINT ", BUT HOW DO YOU EXPECT"
1200 PRINT "ME TO GO ON WITH MY PSYCHOLOGY STUDIES IF MY PATIENTS DON'T"
1210 PRINT "PAY THEIR BILLS?"
1220 PRINT\PRINT\PRINT "NOW LET ME TALK TO SOMEONE ELSE."
1230 PRINT "NICE MEETING YOU ";\GOSUB 1280
1240 PRINT ". HAVE A NICE DAY!!"
1250 STOP
1280 PRINT A$;
1290 RETURN
1300 PRINT \ PRINT "ARE YOUR PROBLEMS RELATED TO HARDWARE OR SOFTWARE";
1310 INPUT D$
1320 IF D$="HARDWARE" GOTO 1420
1330 IF D$="HARD" GOTO 1420
1340 IF D$="H" GOTO 1420
1350 IF D$="SOFTWARE" GOTO 1440
1360 IF D$="PROGRAMMING" GOTO 1440
1370 IF D$="PROGRAM" GOTO 1440
1380 IF D$="S" GOTO 1440
1390 IF D$="SALES" GOTO 1470
1400 PRINT \ PRINT "I DON'T WANT TO TALK ABOUT IT" \ PRINT \ PRINT
1410 GOTO 890
1420 PRINT \ PRINT "SOUNDS LIKE A SOFTWARE ISSUE TO BE ..."
1430 GOTO 890
1440 PRINT
1450 PRINT "<GHKDF98W709&*$^%($;> ^C^CHKEKEX$$";PNT(7);"...MUST BE HARDWARE..."
1460 GOTO 890
1470 PRINT \ PRINT
1480 PRINT "THERE ARE NO SUCH THINGS AS SALES PROBLEMS ... ONLY CHALLENGES"
1490 PRINT "CALL YOUR DEC SALES REP ..."
1500 GOTO 890
1510 RESTORE
1520 PRINT \ PRINT \ PRINT
1530 K=INT(10*RND(X)+1)
1540 IF K>4 GOTO 1530
1550 FOR J=1 TO K*10
1560 READ E$
1570 NEXT J
1580 FOR I=1 TO 9
1590 READ E$ \ PRINT E$
1600 NEXT I
1610 PRINT PNT(7)
1620 FOR I=1 TO 2000
1630 NEXT I
1640 READ E$ \ PRINT E$
1650 FOR I=1 TO 500
1660 NEXT I
1670 PRINT PNT(27);"H";PNT(27);"J"
1680 GOTO 890
1690 DATA ""
1700 DATA ""
1710 DATA ""
1720 DATA ""
1730 DATA ""
1740 DATA ""
1750 DATA ""
1760 DATA ""
1770 DATA ""
1780 DATA ""
