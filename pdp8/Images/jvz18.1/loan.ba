100  !PROGRAM TO COMPUTE COMPOUND INTEREST
110  !
120  !
130  !
140  !ORGINAL PROGRAM FROM "PROGRAMMING LANGUAGES" , DEC
150  !
160  !OS-78 V7A VERSION BY R. MOORE, DEC
170  !
180  !
190  !
200  !
210  PRINT PNT(27);"H";PNT(27);"J"
220  PRINT ,"L O A N     R E P A Y M E N T   P R O G R A M"
230  PRINT ,"---------------------------------------------"
240  PRINT \ PRINT
250  PRINT "OUTPUT TO (1) TTY, (2) LA-180/LP05, OR (3) LQP PRINTER "; \ INPUT A$
260  IF A$ = "3" GOTO 270 \ IF A$ = "2" GOTO 280 \ GOTO 290
270  FILEV#1:"LQP:" \ GOTO 300
280  FILEV#1:"LPT:" \ GOTO 300
290  FILEV#1:"TTY:"
300  PRINT \ PRINT
310  DIM Z$(80)
320  PRINT "ENTER AMOUNT OF LOAN ";
330  INPUT A
340  PRINT \ PRINT "ENTER INTEREST IN PERCENT ";
350  INPUT J \ J=J/100
360  PRINT \ PRINT "ENTER NUMBER OF YEARS ";
370  INPUT N
380  PRINT \ PRINT "ENTER NUMBER OF PAYMENTS PER YEAR ";
390  INPUT M
400  PRINT \ PRINT "DO YOU WANT THE PAYMENT TABLE  (Y/N) "; \ INPUT B$
410  IF B$="N" GOTO 460
420  PRINT \ PRINT "ENTER # OF YRS TO PRINT OR ""ALL"" "; \ INPUT C$
430  C=999
440  IF C$= "ALL" GOTO 460
450  C=VAL(FIX$(C$))*M
460  PRINT PNT(27);"H";PNT(27);"J"
470  PRINT#1:TAB(20);"LOAN  REPAYMENT  SCHEDULE"
480  PRINT#1:TAB(20);"-------------------------"
490  PRINT#1: \ PRINT#1: \ PRINT#1:
500  PRINT#1: \ PRINT#1: USING "AMOUNT OF LOAN = &&&&&&.##",STR$(A)
510  PRINT#1: \ PRINT#1: USING "INTEREST IN %  =    &&&.##",STR$(J*100)
520  PRINT#1: \ PRINT#1: USING "NUMBER OF YRS  =     &&.##",STR$(N)
530  PRINT#1: \ PRINT#1: USING "PAYMENTS / YR  =        &&",STR$(M)
540  PRINT#1: \ PRINT#1:
550  X=0 \ Y=0
560  N=N*M
570  I=J/M
580  B=I+1
590  R=A*I/(1-1/B**N)
600  PRINT#1: \ PRINT#1: USING "AMOUNT PER PAYMENT = &&&&&&.##",STR$(R)
610  PRINT#1: \ PRINT#1: USING "TOTAL INTEREST     = &&&&&&.##",STR$(R*N-A)
620  B=A
630  PRINT#1: \ PRINT#1:
640  IF B$="N" GOTO 830
650  PRINT#1: "  INTEREST         APP TO BALANCE             BALANCE"
660  PRINT#1: "  --------         --------------             -------"
670  PRINT#1: \ PRINT#1:
680  Z$=" &&&&&&.##           &&&&&&.##              &&&&&&.##"
690  L=B*I
700  P=R-L
710  B=B-P
720  X=X+1
730  Y=Y+1
740  IF Y<=12 GOTO 770
750  PRINT#1:
760  Y=0
770  PRINT#1: USING Z$,STR$(L),STR$(P),STR$(B)
780  IF B$="N" GOTO 800
790  IF X>=C GOTO 830
800  IF B>R GOTO 690
810  PRINT#1: USING Z$,STR$(B*I),STR$(R-B*I)
820  PRINT#1: USING Z$,"0",STR$(B*I+B),"0"
830  CLOSE#1
840 PRINT"           MORE ";
850 INPUT A$
860 IF A$="Y" GOTO 100
900 END
