#:: Basic Instruction Test (801-1)
#:: This test halts after the first few instructions to
#:: allow manual verification of OSR and CLA operation.
#:: Correct operation is to print "?@?" and "1" every pass.
set cpu pdp5
echof -n "** PDP-5: Basic Instruction Test (1): "
load -r diags/maindec-801-1-pm
# Edit 801-1 back to PDP-5 version.
d 1005 3002
d 1022 3002
d 1046 3002
d 1055 1001
d 1070 3001
d 1072 3002
reset
go 0200
if (PC != 0201 || AC != 0) echof "MAINDEC-501-1 failed."; exit 1
d sr 7777
c
if (PC != 00203) echof "MAINDEC-501-1 failed pc."; exit 1
if (AC != 07777) echof "MAINDEC-501-1 failed ac."; exit 1
c
if (PC != 0206 || AC != 0) echof "MAINDEC-501-1 failed."; exit 1
expect -r [25] "1" echof; echof "** PDP-5: MAINDEC-501-1 passed."
c
