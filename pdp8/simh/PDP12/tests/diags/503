#:: Memory Address Test (503)
#:: This test checks that memory addresses are unique.
set cpu pdp5
echof -n "** PDP-5: Memory Address Test: "
load -r diags/maindec-803-pm
# Stop twice at the breakpoint
br 0031
reset
go 0001
e ac
if (PC == 0017) echof "MAINDEC-503 failed."; exit 1
if (AC == 0022) echof "MAINDEC-503 failed."; exit 1
c
echof "MAINDEC-503 passed."
nobr
