	214		/FORM
STEP1,	JMS I PUSHF	/PUSH
	ONE		/CONSTANT OF ONE AS STEP
	JMP GOTSTP	/GO GET LIMIT
IF,	TAD PGO		/GET ADDRESS OF GOTO HANDLER
	SKP 		/GO SET UP POINTER
BRANCH,	TAD PDO		/GET ADDRESS OF DO HANDLER
