	TAD WRKPTR	/YES, GET ADDRESS OF ENTRY
	TAD I SCHTAB	/ADD OFFSET OF GO TABLE
	DCA WORK	/STORE GO TABLE POINTER
	TAD I WORK	/GET GO TABLE ENTRY
	DCA WORK	/STORE AS DESTINATION
