SCHTAB,	.-.		/LOOKUP AND GO ROUTINE
	SNA 		/CHARACTER IN AC?
	TAD CHAR	/NO, USE ONE IN STORAGE
	CIA		/NEGATE CHARACTER SOUGHT
	DCA WORK	/SAVE FOR LATER
