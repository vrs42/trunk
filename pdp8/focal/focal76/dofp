sub float {
  local ($exp, @mant) = @_;
  local $x, $sgn = 1;

$mant[2] = 0; # Not currently used
  if ($mant[0] & 2**11) {
    $sgn = -1;
    $mant[0] = ~$mant[0] & 07777;
    $mant[1] = ~$mant[1] & 07777;
    $mant[2] = ~$mant[2] & 07777;
    $mant[2] = ($mant[2]+1) & 07777;
    if ($mant[2] == 0) {
      $mant[1] = ($mant[1]+1) & 07777;
      if ($mant[1] == 0) {
        $mant[0] = ($mant[0]+1) & 07777;
      }
    }
  }
  $x = $mant[0]/2**11 + $mant[1]/2**23 + $mant[2]/2**35;
  $x *= $sgn;
  $exp = $exp - 4096 if $exp > 2047;
  return $x * 2**$exp;
}

