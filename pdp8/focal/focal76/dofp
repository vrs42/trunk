sub octal {
  local ($x) = @_;
  local $digit, $digits;
  local $exp = 0;

  return if ($x < 0);
  while ($x < 0.5) {
    $exp--;
    $x *= 2.0;
  }
  while ($x > 1) {
    $exp++;
    $x /= 2.0;
  }
  $x *= 4;
  printf "%04o ", $exp & 07777;
  $digits = 0;
  while ($x > 0.0) {
    $digit = int($x);
    print $digit;
    $x -= $digit;
    $x *= 8.0;
    last if ++$digits > 11;
    print " " unless $digits % 4;
  }
  print "\n";
}

