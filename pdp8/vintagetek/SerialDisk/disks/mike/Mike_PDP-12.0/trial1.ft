      WRITE(1,100)
  100 FORMAT(' TEST OF FORTRAN II (FORT.SV), LIST OF SQUARES AND ROOTS')
      WRITE(1,101)
  101 FORMAT(' ')
      DO 1 I=1,20
      J=I*I
      A=SQRT(FLOAT(I))
    1 WRITE(1,102)I,J,A
  102 FORMAT(' THE SQUARE OF ',I2,' IS ',I3,' AND THE ROOT IS ',F10.6)
      WRITE(1,101)
      WRITE(1,103)
  103 FORMAT(' DONE.')
      STOP
      END
