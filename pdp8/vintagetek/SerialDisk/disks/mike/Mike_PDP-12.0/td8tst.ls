
/TD8E SIMPLE DECTAPE SHORT TEST SEQUENC   PAL8-V10A 31-JAN-73 PAGE 1

             /TD8E SIMPLE DECTAPE SHORT TEST SEQUENCES

             /       00 01 02 03 04 05 06 07 08 09 10 11
             /(WRITE) U FR SG RW
             /(READ)  U FR SG RW WL ST M0 M1 M2 M3 M4 M5

             /BIT 0 -  UNIT 0 OR 1
             /BIT 1=0 FOR FORWARDS TAPE MOTION, =1 FOR REVERSE
             /BIT 2=0 FOR STOP TAPE, =1 FOR TAPE RUN
             /BIT 3=0 FOR READ, =1 FOR WRITE
             /BITS 6-11 ARE IGNORED (NOT WRITTEN)

             /ON READ THE FOLLOWING BITS ARE VALID IN ADDITION
             /BIT 4=1 FOR WRITE LOCK-OUT
             /BIT 5=1 FOR SELECT OR TIME ERROR
             /BITS 6-11 FORM MARK TRACK REGISTER BITS 0-5


             /TD8E INSTRUCTION SET

       6771  SDSS=6771               /SKIP ON SINGLE LINE FLAG
       6772  SDST=6772               /SKIP ON TIME ERROR FLAG
       6773  SDSQ=6773               /SKIP ON QUAD LINE FLAG
       6774  SDLC=6774               /LOAD COMMAND REG,CLEAR AC, T-ERR AND UP-TO-SPEED FLIPFLOP
       6775  SDLD=6775               /LOAD DATA REG,CLEAR SINGLE & QUAD FLAGS
       6776  SDRC=6776               /READ COMMAND REG,CLEAR SINGLE & QUAD FLAGS
       6777  SDRD=6777               /READ DATA REG,CLEAR SINGLE & QUAD FLAGS

             /MARK TRACK SEQUENCE:
             /NB - WHEN TAPE IS READ IN REVERSE THE MARK TRACK DATA IS REVERSED AND INVERTED
             /E.G. 26 = FORWARD BLOCK MARK BECOMES 45 = REVERSE BLOCK MARK

             /TRACK-MARK     DESCRIPTION
             /55             -END REVERSE END ZONE
             /25             E/-E EXPAND CODE
             /26             FORWARD BLOCK MARK
             /32             REVERSE GUARD
             /10             -C FORWARD LOCK / REVERSE CHECKSUM /  FINAL /  PRE-FINAL
             /70             D/-D DATA
             /73             F REVERSE LOCK /  FORWARD CHECKSUM /  FINAL /  PRE-FINAL
             /51             FORWARD GUARD
             /45             REVERSE BLOCK MARK
             /22             END FORWARD END ZONE


/TD8E SIMPLE DECTAPE SHORT TEST SEQUENC   PAL8-V10A 31-JAN-73 PAGE 2

             /TEST1 - INSTRUCTION DECODE EXERCISE
