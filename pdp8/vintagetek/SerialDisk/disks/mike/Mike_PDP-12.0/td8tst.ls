/TD8E SIMPLE DECTAPE SHORT TEST SEQUENC   PAL8-V10A 31-JAN-73 PAGE 6

             / THIS IS THE TD8E BOOTSTRAP ROUTINE

       7300  *7300
07300  1312  TD8E,   TAD MOVTAP      /2000->AC
07301  4312          JMS MOVTAP      /REWIND TO START OF TAPE
07302  4312          JMS MOVTAP      /FORWARD WIND TO 1ST BLOCK
07303  6773  WAITWD, SDSQ            /WAIT FOR QUAD LINE FLAG
07304  5303          JMP .-1
07305  6777          SDRD            /READ THE DATA
07306  3726          DCA I POINTR    /PUT THE DATA WHERE THE POINTER SAYS
07307  2326          ISZ POINTR      /INCREMENT THE POINTER
07310  5303          JMP WAITWD      /GET ANOTHER DATA WORD
07311  5732          JMP I OS8PTR    /JUMP TO THE START OF THE OS8 BOOTLOADER
07312  2000  MOVTAP, 2000            /2000 CONSTANT, REVERSE DIRECTION
07313  1300          TAD 7300        /AC = REVERSE & GO / FORWARD & GO
07314  6774          SDLC            /AC->COMMAND REGISTER
07315  6771  WAITMT, SDSS            /WAIT FOR SINGLE LINE FLAG
07316  5315          JMP .-1
07317  6776          SDRC            /COMMAND REGISTER->AC
07320  0331          AND MASK        /KEEP JUST THE MARK TRACK BITS
07321  1327  MTCODE, TAD ENDZN       /SUBTRACT THE END ZONE / REVERSE GUARD MARK TRACK DATA
07322  7640          SZA CLA         /IS THIS IS THE END ZONE
07323  5315          JMP WAITMT      /GET ANOTHER MARK TRACK CODE
07324  2321          ISZ MTCODE      /CHANGE POINTER FROM END ZONE TO REVERSE GUARD
07325  5712          JMP I MOVTAP    /RETURN FROM JMS
07326  7354  POINTR, BUFFER          /POINTER TO DATA BUFFER
07327  7756  ENDZN,  -22             /-0022, END ZONE
07330  7747  REVGRD, -31             /-0031, REVERSE GUARD
07331  0077  MASK,   0077            /MASK TO KEEP JUST THE MARK TRACK BITS
07332  7400  OS8PTR, OS8BT           /OS8 BOOTLOADER ENTRY POINT
       7354  *7354
07354  0000  BUFFER, 0               /START OF BUFFER FOR OS8 BOOTLOADER
       7400  *7400
07400  0000  OS8BT,  0               /OS8 BOOTLOADER ENTRY POINT
             $

