00217  6774          SDLC
00220  6772          SDST            /CHECK FOR A TIMING ERROR
00221  7410          SKP             /THERE SHOULDN'T BE ONE BECAUSE
00222  7402          HLT             /TAPE IS STOPPED
00223  4246          JMS CHKSEL      /CHECK THE SELECT BIT
00224  7402          HLT             /WE HAD A UNIT 0 SELECT ERROR
00225  1377          TAD (4000       /GET UNIT 1 BIT
00226  6774          SDLC            /SELECT UNIT 1
00227  4246          JMS CHKSEL      /LOOKING FOR SELECT ERROR THIS TIME
00230  7410          SKP             /WE GOT THE ERROR
00231  7402          HLT             /FAILED TO GET UNIT 1 SELECT ERROR
00232  6774          SDLC            /RESELECT UNIT 0, STOP
00233  6776          SDRC            /UNIT 0 IS WRITE LOCKED
00234  0376          AND (200
00235  7650          SNA CLA         /CHECK FOR WRITE LOCKOUT
00236  7402          HLT             /WRITE LOCK NOT RECOGNISED
00237  1375          TAD (400
00240  6774          SDLC            /TRY TO SET WRITE BIT
00241  6776          SDRC            /READ IT BACK
00242  0375          AND (400
00243  7640          SZA CLA         /CHECK IF WRITE WAS SET
00244  7402          HLT             /WRITE LOCKOUT DID NOT INHIBIT WRITE
00245  5215          JMP TEST2       /LOOP TEST2

00246  6776  CHKSEL, SDRC            /FETCH THE COMMAND REGISTER
00247  0374          AND (100        /LOOK AT THE SELECT BIT
00250  7650          SNA CLA         /IF SET TAKE THE FIRST RETURN
00251  2246          ISZ CHKSEL      /IF NO ERROR TAKE THE SECOND RETURN

