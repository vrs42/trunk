2747               
2748               /
2749               /THESE ROUTINES MAP VARIOUS USER INTERFACES TO THE TANK
2750               /SWITCH REGISTER LAYOUT.  USING THE ACTUAL FRONT PANEL
2751               /SWITCHES IS NOT RECOMMENDED, AS THEY ARE SOMEWHAT FRAGILE.
2752               /THE TANK GAME USES THE FOLLOWING BIT ASSIGNMENTS:
2753               /       0       UNASSIGNED
2754               /       1       UNASSIGNED
2755               /       2       BACKWARDS/FORWARDS
2756               /       3       STEER LEFT (CCW)
2757               /       4       STEER RIGHT (CW)
2758               /       5       FIRE
2759               /THE OTHER PLAYER USES THE OTHER HALF OF THE REGISTER,
2760               /WITH BITS 8-11 CORRESPONDING TO BITS 2-5.
2761               RFORW=  10
2762               RCCW=   04
2763               RCW=    02
2764               RFIRE=  01
2765               LFORW=  10^100
2766               LCCW=   04^100
2767               LCW=    02^100
2768               LFIRE=  01^100
2769               
2770               /
2771               /WHERE POSSIBLE, WE ALSO USE OSR TO MERGE THE VALUE FROM THE
2772               /SWITCHES, ALLOWING GAME PLAY WITHOUT THE SPECIAL HARDWARE.
2773               /
2774               *1130
2775               IFNZRO RICM12 <
2776               /
2777               /THE RHODE ISLAND COMPUTER MUSEUM HAS BUILT SOME GAME CONTROLLERS.
2778               /THESE CONTROLLERS ARE CONNECTED TO THE SXL INSTRUCTION:
2779               /       COLOR   SXL     ACTION
2780               /       -----   ---     ------
2781               /       WHITE   0,10    FIRE
2782               /       RED     1,11    ROTATE CCW
2783               /       BLUE    2,12    ROTATE CLOCKWISE
2784               /       YELLOW  3,13    THRUST
2785               /       BLACK           UNASSIGNED
2786               /       ORANGE          UNASSIGNED
2787               /
2788               GETBUT, .-.             /Return Address goes here
2789                       CLA             /Clear the AC
2790                       LINC            /Enter LINC Mode
2791                       LMODE           /Inform assembler
2792                       SXL 0           /See if Button 0 is closed
2793                       JMP BUT1        /Don't set the AC bits if the button is not pressed
2794                       BSE+20          /Set the corresponding bit in the AC
2795                       LFIRE           /Left Fire rockets
2796               BUT1,   SXL 1           /See if Button 1 is closed
2797                       JMP BUT2        /Don't set the AC bits if the button is not pressed
2798                       BSE+20          /Set the corresponding bit in the AC
2799                       LCCW            /Left Rotate the ship counter clockwise
2800               BUT2,   SXL 2           /See if Button 2 is closed
2801                       JMP BUT3        /Don't set the AC bits if the button is not pressed
2802                       BSE+20          /Set the corresponding bit in the AC
2803                       LCW             /Left Rotate the ship clockwise
2804               BUT3,   SXL 3           /See if Button 3 is closed
2805                       JMP BUT10       /Don't set the AC bits if the button is not pressed
2806                       BSE+20          /Set the corresponding bit in the AC
2807                       LFORW           /Left Fire thrust
2808               BUT10,  SXL 10          /See if Button 10 is closed
2809                       JMP BUT11       /Don't set the AC bits if the button is not pressed
2810                       BSE+20          /Set the corresponding bit in the AC
2811                       RFIRE           /Right Fire rockets
2812               BUT11,  SXL 11          /See if Button 11 is closed
2813                       JMP BUT12       /Don't set the AC bits if the button is not pressed
2814                       BSE+20          /Set the corresponding bit in the AC
2815                       RCCW            /Right Rotate the ship counter clockwise
2816               BUT12,  SXL 12          /See if Button 12 is closed
2817                       JMP BUT13       /Don't set the AC bits if the button is not pressed
2818                       BSE+20          /Set the corresponding bit in the AC
2819                       RCW             /Right Rotate the ship clockwise
2820               BUT13,  SXL 13          /See if Button 13 is closed
2821                       JMP BUT99       /Don't set the AC bits if the button is not pressed
2822                       BSE+20          /Set the corresponding bit in the AC
2823                       RFORW           /Right Fire rockets
2824               BUT99,  PDP             /Enter PDP Mode
2825                       PMODE           /Inform assembler
2826                       OSR             /OR in the switch register because we might
2827                                       /not have control boxes
2828                       JMP I GETBUT    /Go back to the caller
2829               >
2830               
2831               IFNZRO M1703 <
2832               /
2833               /THE M1703 EMULATION ON THE SPACEWAR BOARD IS SET UP FOR SPCWR3.
2834               /WHICH IS TO SAY, THE BITS ARE:
2835               /       0,8             /FIRE
2836               /       1,9             /CCW
2837               /       2,10            /CW
2838               /       3,11            /FORWARD
2839               /WE DESIRE TO SWAP FORWARD AND FIRE, AND ALSO TO SHIFT THE HIGH BITS
2840               /RIGHT.
2841 001130  0000  GETBUT, .-.
2842 001131  3373          DCA SWR         /INITIALIZE RESULT
2843 001132  6144          6144            /GET M1703 INPUT
2844 001133  4361          JMS BIT         /IF TOP BIT SET
2845 001134  0100          LFIRE           /FIRE
2846 001135  4361          JMS BIT         /IF NEXT BIT SET
2847 001136  0400          LCCW            /TURN
2848 001137  4361          JMS BIT         /IF NEXT BIT SET
2849 001140  0200          LCW             /TURN
2850 001141  4361          JMS BIT         /IF NEXT BIT SET
2851 001142  1000          LFORW           /FORWARD
2852 001143  7006          RTL             /SHIFT PAST DEAD BITS
2853 001144  7006          RTL
2854 001145  4361          JMS BIT         /IF TOP BIT SET
2855 001146  0001          RFIRE           /FIRE
2856 001147  4361          JMS BIT         /IF NEXT BIT SET
2857 001150  0004          RCCW            /TURN
2858 001151  4361          JMS BIT         /IF NEXT BIT SET
2859 001152  0002          RCW             /TURN
2860 001153  4361          JMS BIT         /IF NEXT BIT SET
2861 001154  0010          RFORW           /FORWARD
2862 001155  7200          CLA             /LOAD RESULT
2863 001156  1373          TAD SWR
2864 001157  7404          OSR             /OR IN THE SWITCH REGISTER
2865 001160  5730          JMP I GETBUT    /RETURN TO CALLER
2866 001161  0000  BIT,    .-.             /LOOK AT NEXT BIT
2867 001162  7004          RAL             /SHIFT NEXT BIT
2868 001163  3374          DCA SAVEA       /SAVE AC
2869 001164  7430          SZL             /NEED TO ADD TO RESULT?
2870 001165  1761          TAD I BIT       /YES, GET AMOUNT TO ADD
2871 001166  2361          ISZ BIT         /SET UP FOR RETURN
2872 001167  1373          TAD SWR         /UPDATE RESULT
2873 001170  3373          DCA SWR
2874 001171  1374          TAD SAVEA       /GET AC BACK
2875 001172  5761          JMP I BIT       /RETURN TO CALLER
2876 001173  0000  SWR,    .-.             /RESULT BITS IN SWR ORDER
2877 001174  0000  SAVEA,  .-.             /SAVED INPUT BITS
2878               >
2879               IFNZRO SUM <
2880                       *77
2881 000077  1130  GTBUT,  GETBUT          /POINTER TO BUTTON ROUTINE
2882               LAS=    JMS I GTBUT             /READ THE BUTTONS
2883               >
2884               $

