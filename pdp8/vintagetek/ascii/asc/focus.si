
HEADING:FOCUS.3 FOCUS ROUTINE (MODEL 25 #3 ONLY)  3/24/80  MA,GF

STEP
  1   REM  "FOCAL ROUTINE FOR SINGLE PARTS ON THE MODEL 25 #3 LASER ONLY"
  2   GOSU  STEP 14
  3   GOSU  STEP 47
  4   LET  POS 601 = POS 600 + DLTA 1
  5   LET  POS 602 = POS 600 + DLTA 2
  6   LET  POS 603 = POS 602 + DLTA 3
  7   MOVE   POS 600  SPD 100
  8   NIBL   DLTA 1  POS 601  DENS 1  BRAN 0
  9   MOVE   POS 602  SPD 100
 10   NIBL   DLTA 3  POS 603  DENS 1  BRAN 0
 11   GOTO  STEP 2
 12   QUIT
 13   EXIT
 14   PRIN  "JOYSTICK TO STARTING POSITION!"
 15   PRIN  ""
 16   PRIN  "PUSH LOAD POSITION TO START TRIM"
 17   PRIN  "TO STOP-- TYPE A ^Z AND THEN A ^P"
 18   PRIN  "          THEN PUSH LOAD POSITION"
 19   PRIN  ""
 20   XFER   DEV 500  REG 0  MASK 0  BRAN 0
 21   XFER   DEV 501  REG 0  MASK 0  BRAN 0
 22   LET  REG 500 = 00
 23   GOSU  STEP 33
 24   XFER   DEV 502  REG 0  MASK 0  BRAN 0
 25   LET  REG 500 = 01
 26   GOSU  STEP 33
 27   LET  REG 501 = 00
 28   XFER   DEV 503  REG 501  MASK 500  BRAN 0
 29   IF  REG 501 = 00 THEN   GOTO  STEP 21
 30   XFER   DEV 504  REG 0  MASK 0  BRAN 0
 31   XFER   DEV 505  REG 0  MASK 0  BRAN 0
 32   EXIT
 33   XFER   DEV 506  REG 502  MASK 501  BRAN 0
 34   IF  REG 502 = 00 THEN   GOTO  STEP 46
 35   XFER   DEV 506  REG 502  MASK 502  BRAN 0
 36   IF  REG 502 # 00 THEN   GOTO  STEP 42
 37   IF  REG 500 = 00 THEN   GOTO  STEP 40
 38   NIBL   DLTA 500  POS 500  DENS 500  BRAN 0
 39   GOTO  STEP 46
 40   NIBL   DLTA 501  POS 500  DENS 500  BRAN 0
 41   GOTO  STEP 46
 42   IF  REG 500 = 00 THEN   GOTO  STEP 45
 43   NIBL   DLTA 502  POS 501  DENS 500  BRAN 0
 44   GOTO  STEP 46
 45   NIBL   DLTA 503  POS 501  DENS 500  BRAN 0
 46   EXIT
 47   XFER   DEV 600  REG 0  MASK 0  BRAN 0
 48   XFER   DEV 601  REG 0  MASK 0  BRAN 0
 49   GOSU  STEP 56
 50   LET  DLTA 600 = DUM 600 * DLTA 601
 51   XFER   DEV 602  REG 0  MASK 0  BRAN 0
 52   GOSU  STEP 56
 53   LET  POS 600 = DLTA 600 + ( DUM 600 * DLTA 602 )
 54   XFER   DEV 605  REG 0  MASK 0  BRAN 0
 55   EXIT
 56   LET  REG 600 = 00
 57   LET  REG 601 = 00
 58   XFER   DEV 603  REG 600  MASK 0  BRAN 0
 59   XFER   DEV 604  REG 601  MASK 0  BRAN 0
 60   LET  DUM 600 = REG 600 * 010000 + REG 601 - 0100000
 61   EXIT
DENS
  1   SPD 1  PWR 1
500   SPD 500  PWR 0
