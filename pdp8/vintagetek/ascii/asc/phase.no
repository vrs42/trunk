
HEADING:(PHASE.NO) LOT/DATE PROMPTS WITH NO 4-16 PHASE  7/25/90 GF

STEP
  7   GOTO  STEP 990
  9   IF  DUM 801 = 00 THEN   GOTO  STEP 990
990   PRIN  STRG 3 "ENTER LOT NUMBER >" STRG 1
991   READ  TTY:;"_" STRG 333 %1.0 THEN   QUIT
992   PRIN  "LOT NUMBER IS " STRG 333
993   PRIN  STRG 3
994   PRIN  STRG 3 "ENTER TODAY'S DATE >" STRG 1
995   READ  TTY:;"_" STRG 350 %1.0 THEN   QUIT
996   PRIN  "DATE IS " STRG 350
997   PRIN  "NO 4-16 PHASE CHANGE ROUTINE" STRG 3
998   LET  DUM 801 = 01
999   QUIT
