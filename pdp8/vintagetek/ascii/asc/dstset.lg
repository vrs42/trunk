
HEADING:(DSTSET.LG) DISTRIBUTION DATALOG SET DUMMY ROUTINE  7/25/90 GF

STEP
730   REM  "DUM 815 IS 1ST RANGE, 816 LAST RNG, 820 START VAL, 821 INC"
731   LET  M = DUM 815
732   LET  N = DUM 816 + 01
733   LET  DUM 804 = DUM 820
734   FOR  I = M TO N 
735   LET  DUM I = DUM 804
736   LET  DUM 804 = DUM 804 + DUM 821
737   NEXT  I
738   PRIN  STRG 3
739   QUIT
