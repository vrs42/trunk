
HEADING:(SRSTEP.1P) S&R ROUTINE FOR 1 PART PER SUB  4-29-91 GF

STEP
  6   GOTO  STEP 443
  8   PRIN  STRG 3 "THIS PROGRAM ONLY DOES 1 PART AT A TIME" STRG 3
 15   GOSU  STEP 400
 16   LET  DLTA 900 = POS 900 - POS 899
 17   DISP   DLTA 900
 18   MOVE   POS 899  SPD 0
408   SHOM   REG 990
409   SHOM   REG 0
414   LET  DLTA 998 = POS 997
415   IF  BIT 6 = 01 THEN   GOTO  STEP 423
418   PRIN  "ALIGN THETA" STRG 3
419   ALIN   POS 998  REF 999  REG 998
420   PRIN  "ALIGN X-Y" STRG 3
421   ALIN   POS 0  REF 0  REG 0
422   LET  DLTA 998 = POS 997 - POS 999
423   SMOV   DLTA 998  SPD 0  REG 0
424   GOSU  STEP 16
443   SHOM   REG 990
444   SHOM   REG 0
445   SHOM   REG 991
446   QUIT
REG
990   03
991   04
998   -01
POS
990   0, 0
997   0, 0
998   -10000, 1000
999   10000, 1000
REF
999   POS 999
DLTA
998   0, 0
