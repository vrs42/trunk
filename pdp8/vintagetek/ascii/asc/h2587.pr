
HEADING: H2587 (H2587.PR) THICK S&R 25'S  6-10-96 SH

STEP
  1   GOTO  STEP 9
  2   GOTO  STEP 194
  3   GOTO  STEP 171
  4   GOSU  STEP 114
  5   GOTO  STEP 9
  6   GOTO  STEP 143
  7   GOTO  STEP 231
  8   IF  DUM 807 = 00 THEN   LET  DUM 807 = 01
  9   IF  DUM 801 = 00 THEN   GOTO  STEP 231
 10   MOVE   POS 300  SPD 0
 11   GOSU  STEP 122
 12   LET  DLTA 900 = POS 900 - POS 899
 13   DISP   DLTA 900
 14   MOVE   POS 899  SPD 0
 16   REM  " *** DIELECTRIC SHORT TEST ***"
 17   FOR  I = 5.01000E+02 TO 5.03000E+02 
 18   TEST   UNK 500  CODE 8  TOL 500  ACC 0  REJ 22  REG 0
 19   TEST   UNK 500  CODE 1  TOL 500  ACC 0  REJ 22  REG 0
 20   PRIN  "SHORT REJECT # " I
 21   LET  REG 3 = 01
 22   NEXT  I
 23   IF  REG 3 # 00 THEN   GOTO  STEP 109
 24   LET  M = DUM 811
 25   FOR  I = 01 TO M 
 26   IF  BIT 4 = 01 THEN   GOTO  STEP 42
 27   IF  NOM I < - 01 THEN   LET  I = - NOM I
 28   IF  I # 1.18000E+02 THEN   GOTO  STEP 31
 29   LET  NOM 118 = ( NOM 30 + ( NOM 30 * DUM 30 / 1.00000E+02 ) ) / DUM 499
 30   PRIN  "NOM 118 = " NOM 118
 31   LET  J = 02
 32   IF  NOM I > 9.00000E+04 THEN   LET  J = J + 1.00000E+01
 33   TEST   UNK 1  CODE J  TOL I  ACC 35  REJ 0  REG 0
 34   TEST   UNK 1  CODE 1  TOL I  ACC 0  REJ 36  REG 1
 35   IF  BIT 8 = 01 THEN   GOTO  STEP 37
 36   PRIN  "R" I " = " DUM I "%"
 37   NEXT  I
 38   IF  DUM 4 < - 2.00000E+00 THEN   GOSU  STEP 156
 39   IF  BIT 4 = 01 THEN   GOTO  STEP 42
 40   IF  REG 1 # 00 THEN   GOTO  STEP 109
 41   REM  "**************************************"
 42   LET  M = DUM 811
 43   FOR  I = 01 TO M 
 44   IF  NOM I < - 01 THEN   LET  I = - NOM I
 45   IF  MASK I = 00 THEN   GOTO  STEP 82
 46   IF  MASK I # - 01 THEN   GOTO  STEP 49
 47   REM  "** CALCULATE NOMINAL FOR 2-PLUNGE L-TRIM ROUTINE **"
 48   LET  NOM 300 = NOM I + ( NOM I * DUM I * TURN I / 1.00000E+04 )
 49   LET  J = I * 02
 50   LET  K = J + 01
 51   LET  L = I + 1.00000E+02
 52   IF  REG 50 = 02 THEN   GOSU  STEP 131
 53   IF  REG 50 = 02 THEN   GOTO  STEP 82
 54   IF  BIT 4 = 01 THEN   GOTO  STEP 122
 55   IF  DUM I > TOL L THEN   GOTO  STEP 79
 56   MOVE   POS J  SPD 0
 57   LET  J = 02
 58   IF  DUM I > - 4.50000E+01 THEN   LET  J = 03
 59   IF  DUM I > - 2.00000E+01 THEN   LET  J = 04
 60   IF  DUM I > - 1.00000E+01 THEN   LET  J = 05
 61   IF  DUM I > - 5.00000E+00 THEN   LET  J = 06
 62   IF  NOM I > 2.00000E+04 THEN   LET  J = J + 1.00000E+01
 63   LET  N = 01
 64   IF  NOM I < 2.00000E+02 THEN   LET  N = 02
 65   IF  MASK I # - 01 THEN   GOTO  STEP 75
 66   REM  "***BEGIN '2-PLUNGE L-TRIM ROUTINE***"
 67   LET  M = 04
 68   TRIM   UNK 300  CODE 104  CUT 202  MODE 202  POS K  DENS M  BRAN 0
 69   TRIM   UNK 300  CODE 105  CUT 2  MODE I  POS K  DENS M  BRAN 0
 70   IF  N < 1.00000E+01 THEN   LET  N = N + 1.00000E+01
 71   LET  M = 1.04000E+02
 72   TRIM   UNK 1  CODE J  CUT L  MODE L  POS K  DENS M  BRAN 0
 73   GOTO  STEP 78
 74   REM  "END"
 75   TRIM   UNK 1  CODE J  CUT I  MODE I  POS K  DENS N  BRAN 0
 76   IF  I = 1.10000E+01 THEN   GOSU  STEP 241
 77   IF  I = 1.30000E+01 THEN   GOSU  STEP 244
 78   IF  MASK I = - 01 THEN   GOSU  STEP 216
 79   TEST   UNK 1  CODE 15  TOL L  ACC 0  REJ 81  REG 2
 80   IF  BIT 8 = 01 THEN   GOTO  STEP 82
 81   PRIN  "R" I " = " DUM I "%"
 82   NEXT  I
 83   IF  REG 50 = 00 THEN   GOTO  STEP 96
 84   IF  REG 50 = 01 THEN   GOTO  STEP 89
 85   LET  REG 50 = 00
 86   PRIN  "END OF DRIFT TEST, HIT RETURN TO CONTINUE.." STRG 1
 87   READ  TTY:;"_" STRG 1000 %1.0 THEN   QUIT
 88   GOTO  STEP 97
 89   PRIN  "WAITING 2 MINUTES" STRG 3
 90   LET  REG 50 = 02
 91   LET  BIT 8 = 01
 92   FOR  I = 1.00000E+00 TO 3.00000E+05 
 93   NEXT  I
 94   PRIN  STRG 2 "  SHORT TERM DRIFT TEST RESULTS"
 95   GOTO  STEP 42
 96   IF  BIT 4 = 01 THEN   GOTO  STEP 111
 97   IF  REG 2 # 00 THEN   GOTO  STEP 110
 98   PRIN  "GOOD PART"
 99   REM  "** TRIM LOT#, SUB# AND CIRCUIT# ON GOOD PARTS **"
100   MOVE   POS 800  SPD 0
101   LET  J = 02
102   LET  K = 03
103   LET  L = 05
104   LET  DUM 805 = ( ( DUM 799 * 1.00000E+01 ) + DUM 807 ) / 1.00000E+05
105   LET  STRG 1000 = %5.5 DUM 805
106   LET  STRG 12 = J J STRG 333 + K L STRG 1000
107   PRIN  "LOT/SERIAL CODE IS: " STRG 12
108   CGEN  DENS 333 SCAL 1 POS 801 STRG 12
109   IF  REG 1 # 00 THEN   PRIN  "INITIAL REJECT" STRG 3
110   IF  REG 2 # 00 THEN   PRIN  "TRIM REJECT" STRG 3
111   MOVE   POS 899  SPD 0
112   HAND
113   EXIT
114   PRIN  "DRIFT TEST ON" STRG 3
115   LET  REG 50 = 01
116   LET  BIT 8 = 00
117   EXIT
118   LET  NOM 300 = NOM I + ( NOM I * DUM I / 1.00000E+02 )
119   TEST   UNK 300  CODE 15  TOL 1  ACC 0  REJ 0  REG 0
120   PRIN  "    R" I " CHANGE = " %5.3 DUM 300 "%"
121   EXIT
122   IF  DUM 807 = 00 THEN   GOTO  STEP 129
123   PRIN  STRG 3
124   PRIN  "PROGRAM STOPPED AT PART # " DUM 807
125   PRIN  STRG 3
126   PRIN  "ENTER PART # YOU WANT TO START ON >" STRG 1
127   READ  TTY:;DUM 808 %1.0 THEN   QUIT
128   LET  DUM 807 = 00
129   SHOM   REG 30
130   SHOM   REG 0
131   REM  "ALIGN THETA"
132   ALIN   POS 998  REF 999  REG 998
133   REM  "ALIGN X-Y"
134   ALIN   POS 0  REF 0  REG 0
135   LET  DLTA 998 = POS 997 - POS 999
136   GOTO  STEP 138
137   LET  DLTA 998 = DLTA 998 + DLTA 999
138   GOSU  STEP 147
139   IF  DUM 807 < DUM 999 THEN   GOTO  STEP 137
140   LET  DUM 807 = 00
141   LET  DUM 808 = 00
142   LET  DUM 799 = DUM 799 + 01
143   SHOM   REG 30
144   SHOM   REG 0
145   SHOM   REG 32
146   QUIT
147   LET  DUM 807 = DUM 807 + 01
148   IF  DUM 808 > DUM 807 THEN   EXIT
149   SMOV   DLTA 998  SPD 0  REG 0
150   SMOV   DLTA 0  SPD 0  REG 0
151   LET  DLTA 998 = 00
152   PRIN  ""
153   PRIN  "PART # " DUM 807
154   GOSU  STEP 12
155   EXIT
156   LET  M = DUM 811
157   FOR  N = 01 TO M 
158   GOSU  STEP 210
159   IF  DUM I > DUM 810 THEN   IF  DUM I < DUM 809 THEN   GOTO  STEP 162
160   PRIN  "DID NOT LOG"
161   EXIT
162   NEXT  N
163   PRIN  "DATA LOGGING"
164   LET  DUM 800 = DUM 800 + 01
165   FOR  N = 01 TO M 
166   GOSU  STEP 210
167   LET  DUM J = DUM J + DUM I
168   LET  DUM K = DUM K + ( DUM I * DUM I )
169   NEXT  N
170   EXIT
171   GOSU  STEP 184
172   LET  M = DUM 811
173   FOR  N = 01 TO M 
174   GOSU  STEP 210
175   LET  DUM 804 = DUM J / DUM 800
176   LET  DUM 805 = ( DUM K - ( DUM J * DUM J / DUM 800 ) )
177   LET  DUM 805 = SQRT ( DUM 805 * DUM 805 )
178   LET  DUM 805 = SQRT ( DUM 805 / ( DUM 800 - 01 ) )
179   LET  DUM 806 = ( 1.00000E+02 + DUM 804 ) * NOM I / 1.00000E+02
180   PRIN  "R" I "   " %5.3 DUM 804 %8.3 DUM 805 STRG 1
181   PRIN  %15.3 DUM 806 %15.3 NOM I
182   NEXT  N
183   QUIT
184   PRIN  STRG 2 " LOT " STRG 333 STRG 1
185   PRIN  " RESISTOR PRETRIM DATA BASED ON" DUM 800 " PARTS"
186   PRIN  " "
187   PRIN  " DATE: " STRG 340 "     LAST ARRAY # (DUM 799): " STRG 1
188   LET  DUM 805 = DUM 799 - 1.00000E+00
189   PRIN  %5.0 DUM 805
190   PRIN  " "
