
HEADING:SQRX.RT  LINEAR MOTOR EXERCISE ROUTINE (RTRIM)  1/9/80  MA

STEP
  1   PRIN  "          SQRX.RT" STRG 1
  2   PRIN  ""
  3   PRIN  "ENTER THE # OF REVOLUTIONS YOU WANT." STRG 1
  4   PRIN  ""
  5   PRIN  "IF UNLIMITED, TYPE A '0'. " STRG 1
  6   READ  TTY:;REG 1 %1.0 THEN   QUIT
  7   IF  REG 1 = 00 THEN   LET  J = 5.00000E+03
  8   IF  REG 1 = 00 THEN   GOTO  STEP 10
  9   LET  J = REG 1
 10   FOR  I = 1.00000E+00 TO J 
 11   MOVE   POS 1  SPD 1
 12   GOSU  STEP 39
 13   MOVE   POS 2  SPD 1
 14   GOSU  STEP 39
 15   MOVE   POS 3  SPD 2
 16   GOSU  STEP 39
 17   MOVE   POS 1  SPD 1
 18   GOSU  STEP 39
 19   MOVE   POS 3  SPD 1
 20   GOSU  STEP 39
 21   MOVE   POS 4  SPD 2
 22   GOSU  STEP 39
 23   MOVE   POS 1  SPD 1
 24   GOSU  STEP 39
 25   MOVE   POS 4  SPD 1
 26   GOSU  STEP 39
 27   MOVE   POS 5  SPD 2
 28   GOSU  STEP 39
 29   MOVE   POS 1  SPD 1
 30   GOSU  STEP 39
 31   MOVE   POS 5  SPD 1
 32   GOSU  STEP 39
 33   MOVE   POS 2  SPD 2
 34   GOSU  STEP 39
 35   NEXT  I
 36   MOVE   POS 1  SPD 1
 37   HAND
 38   QUIT
 39   FOR  J = 1.00000E+00 TO 6.75000E+02 
 40   NEXT  J
 41   EXIT
REG
  1   00
  2   00
  3   00
  4   00
POS
  1   0, 0
  2   -10000, 10000
  3   -10000, -10000
  4   10000, -10000
  5   10000, 10000
SPD
  1   8.50000E+01, 8.50000E+01
  2   2.25000E+02, 2.25000E+02
STRG
  1   _
