
HEADING:(ZERO.LG) ZERO DUMMIE ROUTINE    7/25/90 GF

STEP
  2   GOTO  STEP 580
580   LET  M = DUM 811
581   FOR  N = 01 TO M 
582   GOSU  STEP 570
583   LET  DUM I = 00
584   LET  DUM J = 00
585   LET  DUM K = 00
586   LET  DUM L = 00
587   NEXT  N
588   FOR  I = 8.00000E+02 TO 8.08000E+02 
589   LET  DUM I = 00
590   NEXT  I
591   PRIN  STRG 3 "ARE YOU SAVING PROGRAM ?" STRG 1
592   READ  TTY:;"_" STRG 1000 %1.0 THEN   QUIT
593   IF  STRG 1000 # "Y" THEN   GOTO  STEP 597
594   PRIN  STRG 3 "SETTING SERIAL # (DUM 799) TO 0, WAS " DUM 799
595   LET  DUM 799 = 00
596   GOTO  STEP 598
597   LET  DUM 801 = 01
608   PRIN  "DUMS ARE ZEROED" STRG 3
609   QUIT
