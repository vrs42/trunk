
HEADING:(SRSTEP.CL) S&R ROUTINE >STEP IN COLUMNS< 2-19-92 GF

STEP
  6   GOTO  STEP 432
  8   IF  DUM 807 = 00 THEN   LET  DUM 807 = 01
 15   GOSU  STEP 400 2.00000E+00 2.00000E+00 1.52400E+04 1.52400E+04
 16   LET  DLTA 900 = POS 900 - POS 899
 17   DISP   DLTA 900
 18   MOVE   POS 899  SPD 0
400   IF  DUM 807 = 00 THEN   GOTO  STEP 407
401   PRIN  STRG 3
402   PRIN  "PROGRAM STOPPED AT CIRCUIT # " DUM 807
403   PRIN  STRG 3
404   PRIN  "WHICH CIRCUIT # DO YOU WANT TO START ON ? " STRG 1
405   READ  TTY:;DUM 808 %1.0 THEN   QUIT
406   LET  DUM 807 = 00
407   MOVE   POS 990  SPD 0
408   SHOM   REG 990
409   SHOM   REG 0
410   LET  DLTA 999 = DLTA 993 * VALU 4
411   LET  DLTA 998 = POS 997
412   IF  BIT 6 = 01 THEN   GOTO  STEP 418
413   PRIN  "ALIGN PART THETA"
414   ALIN   POS 998  REF 999  REG 998
415   PRIN  "ALIGN X-Y"
416   ALIN   POS 0  REF 0  REG 0
417   LET  DLTA 998 = POS 997 - POS 999
418   GOTO  STEP 428
419   LET  J = VALU 2
420   LET  K = VALU 1 * VALU 2
421   FOR  M = J TO K J
422   IF  DUM 807 = M THEN   GOTO  STEP 426
423   NEXT  M
424   LET  DLTA 998 = DLTA 998 + DLTA 999
425   GOTO  STEP 428
426   LET  DLTA 998 = DLTA 998 + ( VALU 3 * DLTA 994 )
427   LET  DLTA 998 = DLTA 998 + ( - DLTA 999 * ( VALU 2 - 1.00000E+00 ) )
428   GOSU  STEP 436
429   IF  DUM 807 < ( VALU 1 * VALU 2 ) THEN   GOTO  STEP 419
430   LET  DUM 807 = 00
431   LET  DUM 808 = 00
432   SHOM   REG 990
433   SHOM   REG 0
434   SHOM   REG 991
435   QUIT
436   LET  DUM 807 = DUM 807 + 01
437   IF  DUM 808 > DUM 807 THEN   EXIT
438   SMOV   DLTA 998  SPD 0  REG 0
439   LET  DLTA 998 = 00
440   PRIN  "CIRCUIT # " DUM 807
441   GOSU  STEP 16
442   EXIT
REG
990   03
991   04
998   -01
POS
990   0, 0
997   0, 0
998   -10000, 1000
999   10000, 1000
REF
999   POS 999
DUM
807   0.00000E+00
808   0.00000E+00
DLTA
993   0, 1
994   -1, 0
998   0, 0
999   0, 0
