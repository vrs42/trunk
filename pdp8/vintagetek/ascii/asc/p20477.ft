100   PRIN  "DATA LOGGING"
101   LET  DUM 800 = DUM 800 + 01
102   FOR  N = 01 TO M 
103   GOSU  STEP 156
104   LET  DUM J = DUM J + DUM I
105   LET  DUM K = DUM K + ( DUM I * DUM I )
106   NEXT  N
107   EXIT
108   GOSU  STEP 123
109   LET  M = DUM 811
110   FOR  N = 01 TO M 
111   GOSU  STEP 156
114   LET  DUM 804 = DUM J / DUM 800
115   LET  DUM 805 = ( DUM K - ( DUM J * DUM J / DUM 800 ) )
116   LET  DUM 805 = SQRT ( DUM 805 * DUM 805 )
117   LET  DUM 805 = SQRT ( DUM 805 / ( DUM 800 - 01 ) )
118   LET  DUM 806 = ( 1.00000E+02 + DUM 804 ) * NOM I / 1.00000E+02
