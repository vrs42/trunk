 497 007420  0233          AND T77
 498 007421  1252          TAD M32
 499 007422  7640          SZA CLA
 500 007423  5215          JMP TRGRD       /NOT YET
 501 007424  4255          JMS TRQD        /SKIP CONTROL WORDS
 502 007425  4255          JMS TRQD
 503 007426  4255          JMS TRQD
 504 007427  6211          CDF 10          /LOAD TO FLD 1
 505 007430  4255  TREAD,  JMS TRQD        /GET DATA WORDS
 506 007431  3645          DCA I PTR
 507 007432  2245          ISZ PTR
 508 007433  0077  T77,    77              /NOP
 509 007434  2244          ISZ TWCT        /FINISHED BLOCK?
 510 007435  5230          JMP TREAD       /NO
 511 007436  2212          ISZ TBLKNO      /YES. DO NEXT BLOCK
 512 007437  2250          ISZ M2          /DONE BOTH BLOCKS?
 513 007440  5200          JMP TBOOT       /NO
 514 007441  6774          SDLC            /DONE STOP TAPE
 515 007442  6213          CIF CDF 10
 516 007443  5647          JMP I K7767     /GO READ MONITOR HEAD
