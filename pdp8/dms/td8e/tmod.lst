 481 007400  1246  TBOOT,  TAD K7600       /128 WORDS/PAGE
 482 007401  3244          DCA TWCT        /WAIT FOR A BLOCK MARK
 483 007402  6771          SDSS
 484 007403  5202          JMP .-1
 485 007404  6776          SDRC
 486 007405  0233          AND T77
 487 007406  1251          TAD M26         /IS IT A BLOCK MARK?
 488 007407  7640          SZA CLA
 489 007410  5202          JMP TBOOT+2     /NO
 490 007411  6777          SDRD            /GET BLOCK NO
 491 007412  1253  TBLKNO, TAD M35         /NEED BLOCKS 35,36
 492 007413  7640          SZA CLA
 493 007414  5202          JMP TBOOT+2     /NO
 494 007415  6771  TRGRD,  SDSS
 495 007416  5215          JMP .-1
