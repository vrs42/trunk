   1               / DECtape IOTs:
   2               DTCA=6762       / Clear Register A
   3               DTXA=6764       / XOR into Register A
   4               DTSF=6771       / Skip if done
   5               DTRB=6772       / Load Register B
   6               DTLB=6774       / Load memory field to controller
   7               
   8               / DECtape Register A:
   9               / 0-2   Unit number
  10               / 3     Reverse
  11               / 4     GO
  12               / 5     Continuous mode
  13               / 6-8   Command
  14               /       000 Move
  15               /       001 Search
  16               /       010 Read
  17               /       100 Write
  18               / 9     Interrupt enable
  19               / 10    Error/Leave error
  20               / 11    Flag/Leave flag
  21               
  22               / DECtape Register B:
  23               / 0     Any Error
  24               / 1     Mark Track Error
  25               / 2     EOT Error
  26               / 3     Select Error
  27               / 4     Parity Error
  28               / 5     Error
  29               / 6-8   Memory Field
  30               / 11    Done
  31               
