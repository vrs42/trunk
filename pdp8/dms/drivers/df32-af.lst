  58 007632* 0006  C6,     0006            / The BOOTSTRAP entry point! A constant?
  59 007633* 0037  C37,    0037            / Constant 0037.
  60 007634* 0040  C40,    0040            / Constant 0040.
  61 007635* 0070  C70,    0070            / Constant 0070.
  62 007636* 3700  C3700,  3700            / Constant 3700.
