+#net PPORT_s<4>    loc=K14; # FLASH_A<1> / PPORT_DOUT<1>
+#net PPORT_s<5>    loc=K13; # FLASH_A<2> / PPORT_DOUT<2>
+#net PPORT_s<6>    loc=T10; #            / PPORT_DOUT<3>
+#
+########################################################
