+#NET VGA_VSYNC_N   LOC=D8;        
+#
+# Flash memory interface
+#
+#net FLASH_A<0>   LOC=N5;
+#net FLASH_A<1>   LOC=K14;
+#net FLASH_A<2>   LOC=K13;
+#net FLASH_A<3>   LOC=K12;
+#net FLASH_A<4>   LOC=L14;
+#net FLASH_A<5>   LOC=M16;
