             # (c2_l & bus_strobe);
ac_load_l.oe = (btp3 & n_t_28x)
             # (c2_l & bus_strobe);
property atmel {open_collector= carry_in_l};
!carry_in_l = (skip1 & ts4fset)
              # (jmsets2 & skip1)
              # (bf_kc & bts1)
              # (bmd11 & op1ts3)
              # (bd & bts2)
              # (rom_l & cpma_dis_l & jmsets3);
carry_in_l.oe = (skip1 & ts4fset)
              # (jmsets2 & skip1)
              # (bf_kc & bts1)
              # (bmd11 & op1ts3)
              # (bd & bts2)
              # (rom_l & cpma_dis_l & jmsets3);
property atmel {open_collector= cpma_load_l};
!cpma_load_l = (pulse_la & keycontrol_l);
cpma_load_l.oe = (pulse_la & keycontrol_l);
!d_l = (n_t_77x & ms_dis_l);
property atmel {open_collector= data_f};
!data_f = (bmd06 & op1ts3);
