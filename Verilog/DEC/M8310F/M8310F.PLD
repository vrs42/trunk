!en1 = (bts4 & d)
       # (bd & bts3 & jmp);
en1.oe = (bts4 & d)
       # (bd & bts3 & jmp);
!f_l = (n_t_78x & ms_dis_l);
property atmel {open_collector= fset_l};
!fset_l = (dset_l & eset_l);
fset_l.oe = (dset_l & eset_l);
