property atmel {open_collector= link_l};
!link_l = link;
link_l.oe = link;
property atmel {open_collector= md_dis};
!md_dis = (bms_dis & bk_dc_l);
md_dis.oe = (bms_dis & bk_dc_l);
property atmel {open_collector= mq2bus_l};
!mq2bus_l = (ind1 & bts1 & n_t_47x)
            # (opets3 & bmd05 & pause_l);
mq2bus_l.oe = (ind1 & bts1 & n_t_47x)
            # (opets3 & bmd05 & pause_l);
property atmel {open_collector= mq_load_l};
!mq_load_l = (ope & bmd07 & btp3);
mq_load_l.oe = (ope & bmd07 & btp3);
!n3v = 'b'0;
!n_t_16x = (n_t_15x & n_t_14x);
!n_t_17x = (n_t_25x & run);
property atmel {open_collector= n_t_30x};
!n_t_30x = (op2ts3 & n_t_43x)
           # (ov & iszets3);
n_t_30x.oe = (op2ts3 & n_t_43x)
           # (ov & iszets3);
property atmel {open_collector= n_t_34x};
!n_t_34x = (bf & tp1)
           # (jmse & btp2);
n_t_34x.oe = (bf & tp1)
           # (jmse & btp2);
!n_t_35x = (aceq0 & bmd06)
           # (ac00 & bmd05)
           # (bmd07 & link);
property atmel {open_collector= n_t_37x};
!n_t_37x = (bts4 & bkc)
           # (fe_fd_l & ts4fset)
           # (n_t_36x & c1_l);
