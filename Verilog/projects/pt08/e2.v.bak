// Eagle Pinout:
//E2       1        in       !INIT
//         2        in       RX_RATE
//         4        io                *** unconnected ***
//         5        io       !IOB8
//         6        io       BIOP4
//         8        io       !IOB7
//         9        io       BIOP2
//         11       io       !IOB5
//         12       io       !IOB6
//         14       io       BIOP1
//         16       io       !IOB4
//         17       io       !IOB3
//         18       io       !IOB11
//         19       io       !IOB2
//         20       io       !IOB1
//         21       io       !IOB10
//         24       io       !IOB0
//         25       io       !IOB9
//         26       io       RX_SEL
//         27       io       RX_DATA
//         28       io       !SKIP
//         29       io       !IRQ
//         31       io       TX_SEL
//         33       io       !INIT
//         34       io       !ACCLR
//         36       io       TXDTTL
//         37       io                *** unconnected ***
//         39       io                *** unconnected ***
//         40       io       DSRTTL
//         41       io                *** unconnected ***
//         43       in       RX_RATE

/* M706 Receiver */
module e2(init_l, rx_rate, biop1, biop2, biop4, iob0_l, iob1_l, iob2_l, iob3_l, iob4_l, iob5_l, iob6_l, iob7_l, iob8_l, iob9_l, iob10_l, iob11_l, rx_sel, rx_data, skip_l, irq_l, tx_sel, init_l, acclr_l, txdttl, dsrttl);
input init_l, rx_rate, biop1, biop2, biop4;
output iob0_l, iob1_l, iob2_l, iob3_l, iob4_l, iob5_l;
output iob6_l, iob7_l, iob8_l, iob9_l, iob10_l, iob11_l;
input rx_sel, rx_data, tx_sel;
output skip_l, irq_l, acclr_l;
output txdttl, dsrttl;

wire tt_[0:7];

// Here we invoke a debugged M706 model, connecting the relevant signals.
m706 m706(
   ad2(rx_sel),		// mb03_
   ae1(rx_sel),		// mb04_
   ae2(kcc_),		// kcc_ (output)
   af1(rx_sel),		// mb05_
   af2(irql),		// keyboard_flag_l
   ah1(rx_sel),		// mb06_
   ah2(rx_sel),		// mb07_
   aj1(rx_sel),		// mb08_
   aj2(tti02),		// tti3_set (input)
   ak1(tti02),		// tti02[2] (output)
   ak2(tt_[0]),		// tt_[0]
   al1(tt_[3]),		// tt_[3]
   al2(biop4),		// iop4
   am1(tt_[4]),		// tt_[4]
   am2(serial),		// ~rx_data (output)
   an1(),		// tti_clk_in
   an2(tt_[7]),		// tt_[7]
   ap2(tt_[5]),		// tt_[5]
   ar1(serial),		// tti0_set (input)
   ar2(tt_[1]),		// tt_[1]
   as2(tt_[2]),		// tt_[2]
   at2(tt_[6]),		// tt_[6]
   au2(),		// ~reader_run
   av2(),		// reader_run_clr_
   bd1(),		// clr_flag
   bd2(biop1),		// iop1
   be2(),		// tt_ac_clr_
   bf2(),		// initialize
   bh2(),		// tti_skip_
   bj2(biop2),		// iop2
   bm2(),		// rx_data
   bn2(),		// ~in_active;
   br1(),		// enable
   br2(),		// in_stop
   bs1(),		// ~clock_scale[2], 
   bt2(),		// clock_scale[2], 
   bu1(),		// clock_scale_in
   bu2(),		// ~in_stop[0]
   bv2()		// ~in_stop[1]
);

assign irq_l = irql? 1'bz : 1'b0;
assign { iob0_l, iob1_l, iob2_l, iob3_l, iob4_l, iob5_l,
         iob6_l, iob7_l, iob8_l, iob9_l, iob10_l, iob11_l } = tt_[0:7];

endmodule
