--operation mode is input

bac1 = INPUT();


--bac10 is bac10 at PIN_21
--operation mode is input

bac10 = INPUT();


--bac0 is bac0 at PIN_24
--operation mode is input

bac0 = INPUT();


--bac9 is bac9 at PIN_25
--operation mode is input

bac9 = INPUT();


--rx_sel is rx_sel at PIN_26
--operation mode is input

rx_sel = INPUT();


--tx_sel is tx_sel at PIN_31
--operation mode is input

tx_sel = INPUT();


--tx_ratei is tx_ratei at PIN_43
--operation mode is input

tx_ratei = INPUT();


--stp_mark is stp_mark at PIN_44
--operation mode is input

stp_mark = INPUT();


--init_l is init_l at PIN_33
--operation mode is output

init_l = OUTPUT(A1L23);


--tx_rateo is tx_rateo at PIN_41
--operation mode is output

tx_rateo = OUTPUT(A1L34Q);


--stop1 is stop1 at PIN_37
--operation mode is output

stop1 = OUTPUT(B1_out_stop[0]);


--foo is foo at PIN_40
--operation mode is output

foo = OUTPUT(B1L1);


--stop2 is stop2 at PIN_39
--operation mode is output

stop2 = OUTPUT(B1_out_stop[2]);


--irq_l is irq_l at PIN_29
--operation mode is output

irq_l_open_drain_out = OPNDRN(B1_teleprinter_flag);
irq_l = OUTPUT(irq_l_open_drain_out);


--txdttl is txdttl at PIN_36
--operation mode is output

txdttl = OUTPUT(B1L23);


--skip_l is skip_l at PIN_28
--operation mode is output

skip_l_open_drain_out = OPNDRN(B1L22);
skip_l = OUTPUT(skip_l_open_drain_out);






