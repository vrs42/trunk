B1_keyboard_flag_p4_out = !B1_keyboard_flag & rx_rate & rx_data & !B1_in_active & !B1_in_last_unit & !B1_tti37[7];
B1_keyboard_flag_or_out = B1_keyboard_flag_p2_out # B1_keyboard_flag_p4_out;
