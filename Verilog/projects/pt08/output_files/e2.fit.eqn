B1_in_active_p4_out = !B1_in_last_unit & rx_rate & rx_data & !B1_in_active;
B1_in_active = DFFE(B1_in_active_reg_input, B1_in_active_p3_out, !B1L1, !B1_in_active_p4_out, );


--B1L1 is m706:m706|active_clear_~0 at SEXP3
B1L1 = EXP(init_l & B1L15);


--B1_clock_scale[0] is m706:m706|clock_scale[0] at LC29
B1_clock_scale[0]_reg_input = VCC;
B1_clock_scale[0]_p2_out = !B1_in_active & !B1_in_last_unit;
B1_clock_scale[0] = TFFE(B1_clock_scale[0]_reg_input, GLOBAL(rx_rate), !B1_clock_scale[0]_p2_out, , );


