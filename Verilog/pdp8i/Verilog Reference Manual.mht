 New Roman,Times"></font>
<p><a name=3D"7.2"></a><b><font face=3D"Times New Roman,Times">7.2 Conditio=
nal
Statements</font></b>
<br><font face=3D"Times New Roman,Times">The most commonly used conditional
statement is the if, if ... else ... conditions. The statement occurs if</f=
ont>
<br><font face=3D"Times New Roman,Times">the expressions controlling the
if statement evaluates to true.</font><font face=3D"Times New Roman,Times">=
</font>
</p><p><i><font face=3D"Times New Roman,Times">if ... else .. conditions ex=
ample</font></i>
<br><font face=3D"Times New Roman,Times"></font>&nbsp;
</p><center><table width=3D"80%" cellspacing=3D"0" cellpadding=3D"0" border=
=3D"1" bgcolor=3D"#ffffff">
<tbody><tr>
<td>
<pre><font face=3D"Times New Roman,Times">always @(rst)&nbsp; // simple if=
 ... else
&nbsp;&nbsp; if (rst)
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; // procedural assignment
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; q =3D 0;
&nbsp;&nbsp; else // remove the above continuous assign
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; deassign q;

always @ (WRITE or READ or STATUS)
&nbsp;&nbsp; begin
&nbsp;&nbsp; // if - else - if
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; if (!WRITE) begin
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; out =3D oldval=
ue;
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; end
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; else if&nbsp; (!STATUS) begin
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; q =3D newstatu=
s;
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; STATUS =3D hold;
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; end
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; else if&nbsp; (!READ) begin
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; out =3D newvalue;
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; end
end</font></pre>
</td>
</tr>
</tbody></table></center>
<font face=3D"Times New Roman,Times"></font>
<p><font face=3D"Times New Roman,Times">case, casex, casez: case statements
are used for switching between multiple sections ( if (case1) ... else</fon=
t>
<br><font face=3D"Times New Roman,Times">if (case2) ... else ...). If there
are multiple matches, only the first is evaluated. Casez treats high</font>
<br><font face=3D"Times New Roman,Times">impedance values as don&#8217;t ca=
re and
casex treats both unknown and high impedance as don&#8217;t care&#8217;s.</=
font><font face=3D"Times New Roman,Times"></font>
</p><p><a name=3D"case"></a><i><font face=3D"Times New Roman,Times">Case st=
atement
example</font></i>
<br><font face=3D"Times New Roman,Times"></font>&nbsp;
</p><center><table width=3D"80%" cellspacing=3D"0" cellpadding=3D"0" border=
=3D"1" bgcolor=3D"#ffffff">
<tbody><tr>
<td>
<pre><font face=3D"Times New Roman,Times">module d2x8 (select, out); // pri=
ority encode
&nbsp;&nbsp; input [0:2] select
&nbsp;&nbsp; output [0:7] out;
&nbsp;&nbsp; reg [0:7] out;

always @ (select) begin
&nbsp;&nbsp; out =3D 0;&nbsp;&nbsp; //default statement
case (select)
&nbsp;&nbsp; 0: begin&nbsp;&nbsp; // can have begin and end statements for<=
/font></pre>

<pre><font face=3D"Times New Roman,Times">&nbsp;&nbsp;&nbsp;&nbsp; out[0]=
 =3D 1;&nbsp; // multiple lines...</font></pre>

<pre><font face=3D"Times New Roman,Times">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; end
&nbsp;&nbsp; 1: out[1] =3D 1;
&nbsp;&nbsp; 2: out[2] =3D 1;
&nbsp;&nbsp; 3: out[3] =3D 1;
&nbsp;&nbsp; 4: out[4] =3D 1;
&nbsp;&nbsp; 5: out[5] =3D 1;
&nbsp;&nbsp; 6: out[6] =3D 1;
&nbsp;&nbsp; 7: out[7] =3D 1;
endcase
end
endmodule</font></pre>
</td>
</tr>
</tbody></table></center>
<font face=3D"Times New Roman,Times"></font><font face=3D"Times New Roman,T=
imes"></font>
<p><a name=3D"casex"></a><i><font face=3D"Times New Roman,Times">casex stat=
ement
example</font></i>
<br><font face=3D"Times New Roman,Times"></font>&nbsp;
</p><center><table width=3D"80%" cellspacing=3D"0" cellpadding=3D"0" border=
=3D"1" bgcolor=3D"#ffffff">
<tbody><tr>
<td>
<pre><font face=3D"Times New Roman,Times">casex (state)
&nbsp;&nbsp; // treats both x and z as don&#8217;t care
&nbsp;&nbsp; // during comparison: 3&#8217;b01z, 3&#8217;b01x, 3&#8217;b011
&nbsp;&nbsp; // ... match case 3&#8217;b01x
&nbsp;&nbsp; 3&#8217;b01x: fsm =3D 0;
&nbsp;&nbsp; 3&#8217;b0xx: fsm =3D 1;
&nbsp;&nbsp; default: begin
&nbsp;&nbsp; // default matches all other occurences
&nbsp;&nbsp; fsm =3D 1;
&nbsp;&nbsp; next_state =3D 3&#8217;b011;
&nbsp;&nbsp; end
endcase</font></pre>
</td>
</tr>
</tbody></table></center>
<font face=3D"Times New Roman,Times"></font>
<p><a name=3D"casez"></a><i><font face=3D"Times New Roman,Times">casez stat=
ement
example</font></i>
<br><font face=3D"Times New Roman,Times"></font>&nbsp;
</p><center><table width=3D"80%" cellspacing=3D"0" cellpadding=3D"0" border=
=3D"1" bgcolor=3D"#ffffff">
<tbody><tr>
<td>
<pre><font face=3D"Times New Roman,Times">casez (state)
&nbsp;&nbsp; //treats z as don&#8217;t care during comparison:
&nbsp;&nbsp; // 3&#8217;b11z, 3&#8217;b1zz, ... match 3&#8217;b1??: fsm =3D=
 0;
&nbsp;&nbsp; 3&#8217;b1?? : fsm =3D 0; // is msb&nbsp;&nbsp; =3D 1, matches=
&nbsp; 3&#8217;b1??
&nbsp;&nbsp; 3&#8217;b01? : fsm =3D 1;
&nbsp;&nbsp; default : $display (&#8220;wrong state&#8221;);
endcase</font></pre>
</td>
</tr>
</tbody></table></center>
<font face=3D"Times New Roman,Times"></font><font face=3D"Times New Roman,T=
imes"></font>
<p><a name=3D"7.3"></a><b><font face=3D"Times New Roman,Times">7.3 Looping
statements</font></b><font face=3D"Times New Roman,Times"></font>
</p><p><font face=3D"Times New Roman,Times">forever, for, while and repeat=
 loops
example</font>
<br><font face=3D"Times New Roman,Times"></font>&nbsp;
</p><center><table width=3D"80%" cellspacing=3D"0" cellpadding=3D"0" border=
=3D"1" bgcolor=3D"#ffffff">
<tbody><tr>
<td>
<pre><font face=3D"Times New Roman,Times">forever
// should be used with disable or timing control
&nbsp;&nbsp; @(posedge clock) {co,sum} =3D a + b + ci;

for (i=3D0; i&lt; 7; i=3Di+1)
&nbsp;&nbsp; memory[i] =3D 0; // initialize&nbsp; to 0

for (i=3D0; i&lt;=3D bit-width; i =3D i+1)
&nbsp;&nbsp; // multiplier using shift left and add
&nbsp;&nbsp; if (a[i]) out =3D out + (b &lt;&lt; (i-1));

repeat (bit-width) begin
&nbsp;&nbsp; if (a[0]) out =3D b + out;
&nbsp;&nbsp; b =3D b &lt;&lt; 1; // multiplier using
&nbsp;&nbsp; a =3D a &lt;&lt; 1 ;// shift left and add
end

while (delay) begin @(posedge clk);
&nbsp;&nbsp; ldlang =3D oldldlang;
&nbsp;&nbsp; delay =3D delay -1;
end</font></pre>
</td>
</tr>
</tbody></table></center>
<font face=3D"Times New Roman,Times"></font>
<br><font face=3D"Times New Roman,Times"></font>&nbsp;<font face=3D"Times=
 New Roman,Times"></font>
<p>
</p><hr width=3D"100%">
<br><a name=3D"8.0"></a><b><font face=3D"Times New Roman,Times">8.0 Named=
 Blocks,
Disabling Blocks</font></b><font face=3D"Times New Roman,Times"></font>
<p><font face=3D"Times New Roman,Times">Named blocks are used to create hie=
rarchy
within modulesand can be used to group a collection of</font>
<br><font face=3D"Times New Roman,Times">assignments or expressions. Disable
statement is used to disable or de-activate any named block, tasks</font>
<br><font face=3D"Times New Roman,Times">or modules. Named blocks, tasks
can be accessed by full or reference hierarchy paths (example</font>
<br><font face=3D"Times New Roman,Times">dff_lab.stimuli). Named blocks can
have local variables.</font><font face=3D"Times New Roman,Times"></font>
</p><p><i><font face=3D"Times New Roman,Times">Named blocks and disbale sta=
tement
example:</font></i>
<br><font face=3D"Times New Roman,Times"></font>&nbsp;
</p><center><table width=3D"80%" cellspacing=3D"0" cellpadding=3D"0" border=
=3D"1" bgcolor=3D"#ffffff">
<tbody><tr>
<td>
<pre><font face=3D"Times New Roman,Times">initial forever @(posedge reset)
&nbsp;&nbsp; disable MAIN;&nbsp;&nbsp; // disable named block
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nb=
sp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; // tasks and modules can also be disabled.

always begin: MAIN&nbsp; // defining named blocks
&nbsp;&nbsp; if (!qfull) begin
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; #30 recv(new,newdata); // call task
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; if (new) begin
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; q[head] =3D newdata;
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; head =3D head + 1;&nbsp;&n=
bsp; // queue
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; end
&nbsp;&nbsp; end
&nbsp;&nbsp; else
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; disable recv;
end&nbsp;&nbsp; // MAIN</font></pre>
</td>
</tr>
</tbody></table></center>
<font face=3D"Times New Roman,Times"></font>
<p>
</p><hr width=3D"100%"><a name=3D"9.0"></a><b><font face=3D"Times New Roman=
,Times">9.0
Tasks and Functions</font></b><font face=3D"Times New Roman,Times"></font>
<p><font face=3D"Times New Roman,Times">Tasks and functions permit the grou=
ping
of common procedures and then executing these procedures</font>
<br><font face=3D"Times New Roman,Times">from different places. Arguments
are passed in the form of input/inout values and all calls to functions</fo=
nt>
<br><font face=3D"Times New Roman,Times">and tasks share variables.</font><=
font face=3D"Times New Roman,Times"></font>
</p><p><i><font face=3D"Times New Roman,Times">The differences between tasks
and functions are:</font></i>
<br><font face=3D"Times New Roman,Times"></font>&nbsp;
</p><center><table width=3D"80%" cellspacing=3D"0" cellpadding=3D"0" border=
=3D"1" bgcolor=3D"#ffffff">
<tbody><tr>
<td><font face=3D"Times New Roman,Times">Tasks</font></td>

<td><font face=3D"Times New Roman,Times">Functions</font></td>
</tr>

<tr>
<td><font face=3D"Times New Roman,Times">Permits time control</font></td>

<td><font face=3D"Times New Roman,Times">Executes in one simulation time</f=
ont></td>
</tr>

<tr>
<td><font face=3D"Times New Roman,Times">Can have zero or more arguments</f=
ont></td>

<td><font face=3D"Times New Roman,Times">requires at least one input</font>=
</td>
</tr>

<tr>
<td><font face=3D"Times New Roman,Times">Does not return value, assigns val=
ue
to outputs</font></td>

<td><font face=3D"Times New Roman,Times">Returns a single value, no special
output&nbsp;</font>
<br><font face=3D"Times New Roman,Times">declarations required</font></td>
</tr>

<tr>
<td><font face=3D"Times New Roman,Times">Can have output arguments, permits
#, @, -&gt;,&nbsp;</font>
<br><font face=3D"Times New Roman,Times">wait, task calls</font></td>

<td><font face=3D"Times New Roman,Times">Does not permit outputs, #, @, -&g=
t;,
wait, task calls</font></td>
</tr>
</tbody></table></center>
<font face=3D"Times New Roman,Times"></font><font face=3D"Times New Roman,T=
imes"></font>
<p><a name=3D"task_eg"></a><i><font face=3D"Times New Roman,Times">task Exa=
mple:</font></i>
<br><font face=3D"Times New Roman,Times"></font>&nbsp;
</p><center><table width=3D"80%" cellspacing=3D"0" cellpadding=3D"0" border=
=3D"1" bgcolor=3D"#ffffff">
<tbody><tr>
<td>
<pre><font face=3D"Times New Roman,Times">task recv;
&nbsp;&nbsp; output valid;
&nbsp;&nbsp; output [9:0] data;
&nbsp;&nbsp; begin
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; valid =3D inreg;
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; if (valid) begin
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; ackin =3D 1;
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; data =3D qin;
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; wait(inreg);
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; ackin =3D 0;
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; end
&nbsp;&nbsp; end

task instantiation
always begin : MAIN&nbsp;&nbsp; // named definition
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; if (!qfull) begin
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; revc(new,newdata);&nbsp; // call=
 task
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; if (new) begin)
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; q[head] =3D ne=
wdata;
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; head =3D head=
 + 1;
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; end
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; end else
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; disable recv;
end //MAIN</font></pre>
</td>
</tr>
</tbody></table></center>
<font face=3D"Times New Roman,Times"></font><font face=3D"Times New Roman,T=
imes"></font>
<p><a name=3D"func_eg"></a><i><font face=3D"Times New Roman,Times">function
Example:</font></i>
<br><font face=3D"Times New Roman,Times"></font>&nbsp;
</p><center><table width=3D"80%" cellspacing=3D"0" cellpadding=3D"0" border=
=3D"1" bgcolor=3D"#ffffff">
<tbody><tr>
<td>
<pre><font face=3D"Times New Roman,Times">module foo2 (cs, in1, in2, ns);
&nbsp;&nbsp; input [1:0] cs;
&nbsp;&nbsp; input in1, in2;
&nbsp;&nbsp; output [1:0] ns;
&nbsp;
&nbsp;&nbsp; function [1:0] generate_next_state
&nbsp;&nbsp; input [1:0] current_state;
&nbsp;&nbsp; input input, input2;
&nbsp;&nbsp; reg [1:0] next_state
&nbsp;&nbsp; // input1 causes 0-&gt;1 transition
&nbsp;&nbsp; // input2 causes 1-&gt;2 transition
&nbsp;&nbsp; // 2-&gt;0 illegal and unknown states go to 0
&nbsp;&nbsp; begin
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; case( current_state)
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 2&#8217;h0: next_state =3D input=
1 ? 2&#8217;h1 : 2&#8217;h0;
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 2&#8217;h1: next_state =3D input=
2 ? 2&#8217;h2 : 2&#8217;h1;
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 2&#8217;h2: next_state =3D 2&#82=
17;h0;
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; default: next_state =3D 2&#8217;=
h0;
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; endcase
&nbsp;&nbsp; generate_next_state =3D next_state;
end
endfunction

assign ns =3D generate_next_state(cs,in1,in2);

endmodule</font></pre>
</td>
</tr>
</tbody></table></center>
<font face=3D"Times New Roman,Times"></font>
<br><font face=3D"Times New Roman,Times"></font>&nbsp;
<br><font face=3D"Times New Roman,Times"></font>&nbsp;<font face=3D"Times=
 New Roman,Times"></font>
<p>
</p><hr width=3D"100%">
<br><a name=3D"10.0"></a><b><font face=3D"Times New Roman,Times">10.0 Conti=
nuous
Assignments</font></b><font face=3D"Times New Roman,Times"></font>
<p><font face=3D"Times New Roman,Times">Continuous assignments imply that
any change on the RHS of the assignment occurs, it is evaluated and assigned
to the LHS. These assignments thus drive both vector and scalar values
onto nets. Continuous assignments alwyas implement combinational logic
(possibly with delays). The driving strengths of a continuous assignment
can be specified by the user on the net types.</font><font face=3D"Times Ne=
w Roman,Times"></font>
</p><p><i><font face=3D"Times New Roman,Times">Continuous assignment on dec=
laration:</font></i>
<br><font face=3D"Times New Roman,Times"></font>&nbsp;
</p><center><table width=3D"80%" cellspacing=3D"0" cellpadding=3D"0" border=
=3D"1" bgcolor=3D"#ffffff">
<tbody><tr>
<td>
<pre><font face=3D"Times New Roman,Times">/* since only one net15 declarati=
on exists in a give module, only one such&nbsp;</font></pre>

<pre><font face=3D"Times New Roman,Times">declarative continuous assignment=
 per signal is allowed */

wire #10 (strong1, pull0) net15 =3D enable;</font></pre>

<pre><font face=3D"Times New Roman,Times">/* delay of 10 for continuous ass=
ignment with strengths&nbsp;</font></pre>

<pre><font face=3D"Times New Roman,Times">of logic 1 as strong1 and lgic 0=
 as pull0 */</font></pre>
</td>
</tr>
</tbody></table></center>
<font face=3D"Times New Roman,Times"></font>
<p><font face=3D"Times New Roman,Times">There are <a tppabs=3D"http://ee.uc=
d.ie/~finbarr/verilog/wires_in_verilog.html" href=3D"wires_in_verilog.html"=
>4
ways of instantiating wires</a>/logic</font>
<br><font face=3D"Times New Roman,Times"></font>&nbsp;<font face=3D"Times=
 New Roman,Times"></font>
</p><p><i><font face=3D"Times New Roman,Times">Continuous assignment on alr=
eady
declared nets.</font></i>
<br><font face=3D"Times New Roman,Times"></font>&nbsp;
</p><center><table width=3D"80%" cellspacing=3D"0" cellpadding=3D"0" border=
=3D"1" bgcolor=3D"#ffffff">
<tbody><tr>
<td>
<pre><font face=3D"Times New Roman,Times">Assign #10 net15 =3D enable;
assign (weak1, strong0) {s,c} =3D a + b;</font></pre>
</td>
</tr>
</tbody></table></center>
<font face=3D"Times New Roman,Times"></font>
<br><font face=3D"Times New Roman,Times"></font>&nbsp;<font face=3D"Times=
 New Roman,Times"></font>
<p>
</p><hr width=3D"100%">
<br><a name=3D"11.0"></a><b><font face=3D"Times New Roman,Times">11.0 Proce=
dural
Assignments</font></b><font face=3D"Times New Roman,Times"></font>
<p><font face=3D"Times New Roman,Times">Assignments to register data types
may occur within always, initial, task and functions. These expressions
are controlled by triggers which cause the assignments to evaluate. The
variables to which the expressions are assigned must be made of bit-select
or part-select or whole element of a reg, integer, real or time. These
triggers can be controlled by loops, if ... else construncts. Assign and
deassign are used for procedural assignments and to remove the continuous
assignments.</font>
<br><font face=3D"Times New Roman,Times"></font>&nbsp;
</p><center><table width=3D"80%" cellspacing=3D"0" cellpadding=3D"0" border=
=3D"1" bgcolor=3D"#ffffff">
<tbody><tr>
<td>
<pre><font face=3D"Times New Roman,Times">module dff (q, qb, clk, d, rst);
&nbsp;&nbsp; output q, qb;
&nbsp;&nbsp; input d, rst, clk;
&nbsp;&nbsp; reg q, qb, temp;
&nbsp;&nbsp; always
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; #1 qb =3D ~q;&nbsp; // procedural assi=
gnment

&nbsp;&nbsp; always @(rst)
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; // procedural assignment with triggers
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; if (rst) assign q =3D temp;
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; else deassign q;

always @ (posedge clk)
&nbsp;&nbsp;&nbsp; temp =3D d;

endmodule</font></pre>
</td>
</tr>
</tbody></table></center>
<font face=3D"Times New Roman,Times"></font>
<br><font face=3D"Times New Roman,Times"></font>&nbsp;
<br><font face=3D"Times New Roman,Times"></font>&nbsp;<font face=3D"Times=
 New Roman,Times"></font>
<p><font face=3D"Times New Roman,Times">force and release are also procedur=
al
assignments. However they can force or release values on net data</font>
<br><font face=3D"Times New Roman,Times">types and registers.</font><font=
 face=3D"Times New Roman,Times"></font>
</p><p><a name=3D"11.1"></a><b><font face=3D"Times New Roman,Times">11.1 Bl=
ocking
Assignment</font></b>
<br><font face=3D"Times New Roman,Times"></font>&nbsp;
</p><center><table width=3D"80%" cellspacing=3D"0" cellpadding=3D"0" border=
=3D"1" bgcolor=3D"#ffffff">
<tbody><tr>
<td>
<pre><font face=3D"Times New Roman,Times">module adder (a,b,ci,co,sum,clk);
&nbsp;&nbsp; input a,b,ci,clk;
&nbsp;&nbsp; output co,sum;
&nbsp;&nbsp; reg co,sum;

always @(posedge clk) // edge control
&nbsp;&nbsp; // assign co, sum with previous value of a,b,ci
&nbsp;&nbsp; {co,sum} =3D #10 a + b + ci;
endmodule</font></pre>
</td>
</tr>
</tbody></table></center>
