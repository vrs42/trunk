@#!/usr/bin/perl

#
# First, walk the directory tree, skipping backups and examples.
# A directory is a project if it has an eagle.epf.
# A project is interesting if it has a DESCRIPTION.
@@TODO = ("projects");
while ($dir = shift @@TODO) {
  opendir(DIR, "$dir/") || die "$dir: $!";
  while ($_ = readdir(DIR)) {
    next if /^\./;
    next if /^backups/;
    next if /^examples/;
    next if / /;
    $d1 = $dir . '/' . $_;
    next unless -d $d1;
    push(@@TODO, $d1);
    next unless -f "$d1/eagle.epf";
    next unless -f "$d1/DESCRIPTION";
    push(@@projects, $d1);
  }
}

#
# Now walk the project list, emitting appropriate text.
print "<HTML><HEAD>\r\n";
print "<STYLE type=\"text/css\">\r\n";
print "BODY { background-color: #000000 }\r\n";
print "BODY { color: #00c000 }\r\n";
print "</STYLE>\r\n";
print "<META http-equiv=Content-Type content=\"text/html; charset=iso-8859-1\">\r\n";
print "<META http-equiv=Expires content=0>\r\n";
print "<TITLE>PDP-8 Stuff</TITLE>\r\n";
print "</HEAD>\r\n";
print "<BODY vLink=#00c000 aLink=#00c000 link=#00ff00 bgColor=#000000>\r\n";

print "<P>($#projects board projects)\r\n";
print "<DL>\r\n";
sub byname {
  $aa = $a;
  $aa =~ s:.*/::;
  $bb = $b;
  $bb =~ s:.*/::;
  return $aa cmp $bb;
}
foreach $proj (sort byname @@projects) {
  $name = $proj;
  $name =~ s:.*/::;
  $desc = `cat $proj/DESCRIPTION`;
  $desc =~ s/\r*\n*$//;
  print " <DT>$name\r\n <DD>$desc\r\n";
  #
  # Walk the directory again, listing .brd and .epf files.
  opendir(DIR, "$proj/") || die "$proj: $!";
  print " <UL><LI>\r\n";
  while ($_ = readdir(DIR)) {
    next unless /\.brd$/ || /\.sch$/;
    print " <A href=\"$proj/$_\">$_</A>\r\n";
  }
  print " </UL>\r\n";
}
print "<DL>\r\n";
@
