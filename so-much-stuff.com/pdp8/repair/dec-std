  print "<TD>$cname{$dec}\n";
  $ocolor = "";
  foreach $color (split(/:/, $rgb{$dec})) {
    next if $color eq $ocolor;
    $ocolor = $color;
    next unless $color =~ /^[0-9]/;
    # $color is an r,g,b triple.
    ($r, $g, $b) = split(/,/, $color);
    $v = 255 - int(($r + $g + $b) / 3);
    $v = 255 unless $v < 64; # For most values of $v, just use white.
    print "<TD style='color:rgb($v,$v,$v); background-color:rgb($color)'>$color\n";
