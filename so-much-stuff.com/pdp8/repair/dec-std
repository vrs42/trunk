#
# Take a stab at approximating MUN colors.
sub mun2hsl {
   local($mun) = @_;
   local($hue, $seg, $l, $s) = ($1, $2, $3, $4) if $mun =~ /([\d.]+)\s*([YRGBP]+)\s*([\d.]+)\s*\/\s*([\d.]+)/;
   ($hue, $seg, $l, $s) = (5, "R", $1, 0) if $mun =~ /N\s*([\d.]+)/;

   die "$mun: $hue $seg $l $s Can't parse MUN color\n" unless defined $s;
   die "$mun: Invalid hue number $hue\n" if $hue > 10; # between 2.5 and 7.5
   die "$mun: Invalid hue number $hue\n" if 2.5*int($hue/2.5) != $hue; # Must be a multiple of 2.5
   # 0 = 360 degrees == red
   # 360 / 5 = 72
   $hue = 0 if $hue == 10;
   $hue = 9*($hue-5) / 2.5;
   $hue += 330 if $seg =~ s/^RP//;
   $hue += 0 if $seg =~ s/^R//;
   $hue += 30 if $seg =~ s/^YR//;
   $hue += 60 if $seg =~ s/^Y//;
   $hue += 90 if $seg =~ s/^GY//;
   $hue += 120 if $seg =~ s/^G//;
   $hue += 180 if $seg =~ s/^BG//;
   $hue += 240 if $seg =~ s/^B//;
   $hue += 270 if $seg =~ s/^PB//;
   $hue += 300 if $seg =~ s/^P//;
   $s /= 10;
   $l /= 10;
   $hue -= 360 if $hue >= 360;
   return($hue, $s, $l);
}

#
# Let's attempt a conversion of an arbitrary CHM color.
sub chm2rgb {
  local($c) = @_;
  local($q, $w, $b, $h, $s, $l);
  local($r, $g);
#warn "chm2rgb $c\n";
  if ($c =~ /Gr[ae]y\s*Scale\s*([A-P])/) {
    $w = $1;
    $w = $wRatio{$w};
    return hsl2rgb(0, 0, $w);
  }
  ($q, $w, $b) = ($1, $2, $3) if $c =~ /([\d.]+)\s*([A-P])([A-P])/;
  ($q, $w, $b) = ($1, "P", "A") if $c =~ /([\d.]+)$/;
  die "$c: color not recognised\n" unless $b =~ /[A-P]/;
  # Convert $q to a hue.
  $h = 75;
  $h -= $q * 15;
  $h += 360 if $h < 0;
  # Look up $w and $b.
#warn "w is $w, b is $b\n";
  $w = $wRatio{$w};
  $b = 15/16-$wRatio{$b};
#warn "w is $w, b is $b\n";
  # toHSL($h, 1, 0.5) is the fully saturated version.
  # This is called either "PA", or just "".
  # Anyway, this suggests that lightness is an offset
  # from L=0.5:
  $l = 0.5*(1+$w);
  # This suggests that saturation is 1-something.
  # From the discussion color+white+black = 1.0.
  # So, if blackness "A" is zero:
  $s = 1.0-($b+$w);
#warn "hsl2rgb($h, $s, $l) $w $b\n";
  return hsl2rgb($h, $s, $l);
}

# Convert RGB to HSL.
sub rgb2hsl {
  local($r, $g, $b) = @_;
  local($max, $cmin, $h, $s, $l);
  $r /= 255;
  $g /= 255;
  $b /= 255;
  $cmax = ($r > $g)? $r : $g;
  $cmax = ($cmax > $b)? $cmax : $b;
  $cmin = ($r < $g)? $r : $g;
  $cmin = ($cmin < $b)? $cmin : $b;
  # Calculate L.
  $l = ($cmax + $cmin) / 2;
  if ($cmax > $cmin) {
    # Now calculate S.
    if ($l < 0.5) {
      $s = ($cmax-$cmin) / ($cmax+$cmin);
    } else {
      $s = ($cmax-$cmin) / (2.0-$cmax-$cmin);
    }
    # Finally, calculate H.
    $h = (60 * (($r - $g) / ($cmax-$cmin)) + 240) if $cmax == $b;
    $h = (60 * (($b - $r) / ($cmax-$cmin)) + 120) if $cmax == $g;
    $h = (60 * (($g - $b) / ($cmax-$cmin)) +   0) if $cmax == $r;
    $h += 360 if $h < 0;
  } else {
    # Shade of grey
    $h = $s = 0;
  }
  return ($h, $s, $l);
}

#
# Convert HSL to RGB.
# Algorithm is from stackoverflow.com:
# https://stackoverflow.com/questions/2353211/hsl-to-rgb-color-conversion
sub hue2rgb {
    local($p, $q, $t) = @_;
#warn "hue2: $p $q $t\n";
    $t += 1 if $t < 0;
    $t -= 1 if $t > 1;
die if $t < 0;
die if $t > 1;
    if ($t < 1/6) {
        $p =  $p + ($q - $p) * 6 * $t;
    } elsif ($t < 1/2) {
        $p =  $q;
    } elsif ($t < 2/3) {
        $p =  $p + ($q - $p) * (2/3 - $t) * 6;
    }
#warn "hue2: $p\n";
    return int($p*255 + 0.5);
}
sub hsl2rgb {
    local($h, $s, $l) = @_;
    local($r, $g, $b);
#warn "hsl2rgb $h, $s, $l\n";
    $h /= 360;
# BUGBUG: Do something better with oversaturated colors.
    $s = 1 if $s > 1;
    if ($s == 0) {
        $r = $g = $b = int($l*255+0.5); # achromatic
    } else {
        local($q) = $l < 0.5 ? $l * (1 + $s) : $l + $s - $l * $s;
        local($p) = 2 * $l - $q;
#warn "p = $p, q = $q\n";
        $r = &hue2rgb($p, $q, $h + 1/3);
#warn "p = $p, q = $q\n";
        $g = &hue2rgb($p, $q, $h);
#warn "p = $p, q = $q\n";
        $b = &hue2rgb($p, $q, $h - 1/3);
#warn "p = $p, q = $q\n";
    }
#warn "return $r,$g,$b\n";
    return($r, $g, $b);
}

sub addrgb {
  local($dec, $rgb) = @_;
  if (defined $rgb{$dec}) {
    $rgb{$dec} .= ":$rgb"; # Add the new color
  } else {
    $rgb{$dec} = $rgb;   # Create a color
  }
}

