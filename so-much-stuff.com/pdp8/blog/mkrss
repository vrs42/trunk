#!/bin/bash

# Define metadata
REPO_NAME="so-much-stuff.com"

# Start RSS structure
cat <<EOF
<?xml version="1.0" encoding="UTF-8" ?>
<rss version="2.0">
<channel>
  <title>$REPO_NAME Commit Log</title>
  <link>https://example.com</link>
  <description>Recent git commits for $REPO_NAME</description>
  <language>en-us</language>
EOF

# Append the latest 20 commits formatted as RSS items
git log --since "1 year ago" --date=rfc2822 --format="<item>
    <title>%s</title>
    <author>%ae (%an)</author>
    <pubDate>%ad</pubDate>
    <guid isPermaLink=\"false\">%H</guid>
    <description><![CDATA[%b]]></description>
  </item>"

# Close RSS tags
cat <<EOF
</channel>
</rss>
EOF
